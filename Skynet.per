                (up-full-reset-search)
                (up-find-local c: villager-class c: 240)
                (up-remove-objects search-local object-data-group-flag > 4)
                (up-remove-objects search-local object-data-action c:== actionid-build)
                (up-remove-objects search-local object-data-language-id c:== lid-villager-farmer)
                (up-remove-objects search-local object-data-action c:== actionid-attack)
                (up-remove-objects search-local object-data-action c:== actionid-explore)
                (up-remove-objects search-local object-data-id g:== gl-chicken-vill-1-id__#000)
                (up-remove-objects search-local object-data-id g:== gl-chicken-vill-2-id__#000)
                (up-remove-objects search-local object-data-id g:== gl-chicken-vill-3-id__#000)
                (up-remove-objects search-local object-data-tasks-count c:> 0)
                (up-remove-objects search-local object-data-distance g:> gl-search-group-max-distance__#012)
                (up-remove-objects search-local object-data-index < 120)
                (up-remove-objects search-local object-data-index >= 60)
                (up-reset-group c: third-60-group)
                (up-create-group 0 0 c: third-60-group)
                (up-modify-goal gl-third-group-size__#012 g:= gl-local-total)
            )

            (defrule 
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 240)
                (up-remove-objects search-local object-data-group-flag > 4)
                (up-remove-objects search-local object-data-action c:== actionid-build)
                (up-remove-objects search-local object-data-language-id c:== lid-villager-farmer)
                (up-remove-objects search-local object-data-action c:== actionid-attack)
                (up-remove-objects search-local object-data-action c:== actionid-explore)
                (up-remove-objects search-local object-data-id g:== gl-chicken-vill-1-id__#000)
                (up-remove-objects search-local object-data-id g:== gl-chicken-vill-2-id__#000)
                (up-remove-objects search-local object-data-id g:== gl-chicken-vill-3-id__#000)
                (up-remove-objects search-local object-data-tasks-count c:> 0)
                (up-remove-objects search-local object-data-distance g:> gl-search-group-max-distance__#012)
                (up-remove-objects search-local object-data-index < 180)
                (up-remove-objects search-local object-data-index >= 60)
                (up-reset-group c: forth-60-group)
                (up-create-group 0 0 c: forth-60-group)
                (up-modify-goal gl-forth-group-size__#012 g:= gl-local-total)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 g: gl-search-group-max-distance__#012)
                (up-reset-search 1 1 1 1)
                ;(up-find-local c: mining-camp c: 200)
                (up-find-local c: lumber-camp c: 200)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: gold c: 40)
                (up-find-resource c: stone c: 40)
                (up-find-resource c: food c: 40)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-id gl-temp)
                (up-add-object-by-id search-local g: gl-temp)
                (up-remove-objects search-remote object-data-index == 0)
                (up-jump-rule -1)
            )

            (defrule
                (true)
                =>
                (up-reset-group c: dropsite-group)
                (up-create-group 0 0 c: dropsite-group)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 g: gl-search-group-max-distance__#012)
                (up-find-local c: building-class c: 240)
                (up-find-local c: farm-class c: 240)
                (up-reset-group c: building-group)
                (up-create-group 0 0 c: building-group)
            )
        ; Set point goals for farming dropsites
            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: town-center c: 10)
                (up-remove-objects search-local object-data-index == 0)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: town-center-foundation c: 10)
                (up-reset-filters)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-extra-tcs__#012 g:= gl-local-total)
                (set-goal gl-current-goal-constant__#011 gl-first-extra-tc-goal-constant__#012)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-indirect-goal g: gl-current-goal-constant__#011 g: gl-temp-x)
                (up-modify-goal gl-current-goal-constant__#011 c:+ 1)
                (up-set-indirect-goal g: gl-current-goal-constant__#011 g: gl-temp-y)
                (up-modify-goal gl-current-goal-constant__#011 c:+ 1)
                (up-remove-objects search-local object-data-index == 0)
                (up-jump-rule -1)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: mill c: 20)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: mill c: 20)
                (up-reset-filters)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-mills__#012 g:= gl-local-total)
                (set-goal gl-current-goal-constant__#011 gl-first-mill-goal-constant__#012)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-indirect-goal g: gl-current-goal-constant__#011 g: gl-temp-x)
                (up-modify-goal gl-current-goal-constant__#011 c:+ 1)
                (up-set-indirect-goal g: gl-current-goal-constant__#011 g: gl-temp-y)
                (up-modify-goal gl-current-goal-constant__#011 c:+ 1)
                (up-remove-objects search-local object-data-index == 0)
                (up-jump-rule -1)
            )

        ; Set goals before loop
            (defrule
                (true)
                =>
                (set-goal gl-skip-tile-nr__#012 1)
                (up-modify-goal gl-max-distance__#012 g:= gl-starting-max-distance__#012)
                (up-modify-goal gl-min-distance__#012 g:= gl-starting-min-distance__#012)
                (up-copy-point gl-start-x__#012 gl-position-self-x)
                (up-modify-goal gl-start-x__#012 g:- gl-max-distance__#012)
                (up-modify-goal gl-start-y__#012 g:- gl-max-distance__#012)
                (up-copy-point gl-end-x__#012 gl-position-self-x)
                (up-modify-goal gl-end-x__#012 g:+ gl-max-distance__#012)
                (up-modify-goal gl-end-y__#012 g:+ gl-max-distance__#012)
                (up-copy-point gl-test-x__#012 gl-start-x__#012)
                (set-goal gl-best-score__#012 -99999)
                (set-goal gl-chosen-point-x__#012 -1)

                (set-goal gl-home-distance-rejections__#012 0)
                (set-goal gl-farming-rejections__#012 0)
                (set-goal gl-bound-rejections__#012 0)
                (set-goal gl-building-rejections__#012 0)
                (set-goal gl-accessability-rejections__#012 0)
                (set-goal gl-dropsite-res-distance-rejections__#012 0)
                (set-goal gl-builder-distance-rejections__#012 0)
                (set-goal gl-score-rejections__#012 0)
                (set-goal gl-wood-and-build-rejections__#012 0)
                (set-goal gl-non-rejections__#012 0)
                (set-goal gl-failed-building-placement__#012 NO)
            )
                

        ; Loop start
            (defrule
                (true)
                =>
                (up-get-rule-id gl-normal-building-loop-first-rule-id__#012)
                (set-goal gl-point-accessable__#012 YES)
            )

            (defrule
                (or(up-compare-goal gl-script-time__#051 > 10)
                (goal gl-failed-building-placement__#012 YES))
                (up-compare-goal gl-build != Chicken-mill)
                (game-time > 5)
                =>
                (generate-random-number 5)
                (up-get-fact random-number 0 gl-temp)
                (up-modify-goal gl-skip-tile-nr__#012 g:= gl-temp)
            )
        ; Try new point if distance to position-self is wrong

            (defrule
            (or(up-point-distance gl-test-x__#012 gl-position-self-x g:< gl-min-distance__#012)
            (up-point-distance gl-test-x__#012 gl-position-self-x g:> gl-max-distance__#012))
            (up-compare-goal gl-test-x__#012 g:< gl-end-x__#012)
            =>
            (up-modify-goal gl-home-distance-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
            (or(up-point-distance gl-test-x__#012 gl-position-self-x g:< gl-min-distance__#012)
            (up-point-distance gl-test-x__#012 gl-position-self-x g:> gl-max-distance__#012))
            (up-compare-goal gl-test-y__#012 g:< gl-end-y__#012)
            =>
            (up-modify-goal gl-home-distance-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:= gl-start-x__#012)
            (up-modify-goal gl-test-y__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

        ; Try new point if point is blocking farming area

            (defrule
                (true)
                =>
                (set-goal gl-current-goal-constant__#011 gl-first-extra-tc-goal-constant__#012)
                (up-modify-goal gl-tcs-left__#012 g:= gl-nr-extra-tcs__#012)
            )

            (defrule
                (up-compare-goal gl-tcs-left__#012 > 0)
                =>
                (up-get-indirect-goal g: gl-current-goal-constant__#011 gl-temp-x)
                (up-modify-goal gl-current-goal-constant__#011 c:+ 1)
                (up-get-indirect-goal g: gl-current-goal-constant__#011 gl-temp-y)
                (up-modify-goal gl-current-goal-constant__#011 c:+ 1)
            )

            (defrule
            (up-compare-goal gl-tcs-left__#012 > 0)
            (up-compare-goal gl-ignore-farming-rules__#012 == NO)
            (up-point-distance gl-test-x__#012 gl-temp-x g:< gl-tc-farming-distance__#012)
            (up-compare-goal gl-test-x__#012 g:< gl-end-x__#012)
            =>
            (up-modify-goal gl-farming-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
            (up-compare-goal gl-tcs-left__#012 > 0)
            (up-compare-goal gl-ignore-farming-rules__#012 == NO)
            (up-point-distance gl-test-x__#012 gl-temp-x g:< gl-tc-farming-distance__#012)
            (up-compare-goal gl-test-y__#012 g:< gl-end-y__#012)
            =>
            (up-modify-goal gl-farming-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:= gl-start-x__#012)
            (up-modify-goal gl-test-y__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
                (up-compare-goal gl-tcs-left__#012 > 1)
                =>
                (up-modify-goal gl-tcs-left__#012 c:- 1)
                (up-jump-rule -4)
            )

            (defrule
                (true)
                =>
                (set-goal gl-current-goal-constant__#011 gl-first-mill-goal-constant__#012)
                (up-modify-goal gl-mills-left__#012 g:= gl-nr-mills__#012)
            )

            (defrule
                (up-compare-goal gl-mills-left__#012 > 0)
                =>
                (up-get-indirect-goal g: gl-current-goal-constant__#011 gl-temp-x)
                (up-modify-goal gl-current-goal-constant__#011 c:+ 1)
                (up-get-indirect-goal g: gl-current-goal-constant__#011 gl-temp-y)
                (up-modify-goal gl-current-goal-constant__#011 c:+ 1)
            )

            (defrule
            (up-compare-goal gl-mills-left__#012 > 0)
            (up-compare-goal gl-ignore-farming-rules__#012 == NO)
            (up-point-distance gl-test-x__#012 gl-temp-x g:< gl-mill-farming-distance__#012)
            (up-compare-goal gl-test-x__#012 g:< gl-end-x__#012)
            =>
            (up-modify-goal gl-farming-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
            (up-compare-goal gl-mills-left__#012 > 0)
            (up-compare-goal gl-ignore-farming-rules__#012 == NO)
            (up-point-distance gl-test-x__#012 gl-temp-x g:< gl-mill-farming-distance__#012)
            (up-compare-goal gl-test-y__#012 g:< gl-end-y__#012)
            =>
            (up-modify-goal gl-farming-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:= gl-start-x__#012)
            (up-modify-goal gl-test-y__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
                (up-compare-goal gl-mills-left__#012 > 1)
                =>
                (up-modify-goal gl-mills-left__#012 c:- 1)
                (up-jump-rule -4)
            )

        ; Try new point if point contains an object that cannot be removed

            (defrule
                (up-point-contains gl-test-x__#012 c: all-units-class)
                (not(up-point-contains gl-test-x__#012 c: terrain-class))
                =>
                (set-goal gl-point-accessable__#012 NO)
            )

            (defrule
            (goal gl-point-accessable__#012 NO)
            (up-compare-goal gl-test-x__#012 g:< gl-end-x__#012)
            =>
            (up-modify-goal gl-accessability-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
            (goal gl-point-accessable__#012 NO)
            (up-compare-goal gl-test-y__#012 g:< gl-end-y__#012)
            =>
            (up-modify-goal gl-accessability-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:= gl-start-x__#012)
            (up-modify-goal gl-test-y__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )
        ; Try new point if point is to close to map edge
            (defrule
                (true)
                =>
                (up-copy-point gl-bound-x gl-test-x__#012)
                (up-bound-precise-point gl-bound-x 0 c: 2)
                (set-goal gl-outside-map NO)
            )

            (defrule
                (or(up-compare-goal gl-bound-x g:!= gl-test-x__#012)
                (up-compare-goal gl-bound-y g:!= gl-test-y__#012))
                =>
                (set-goal gl-outside-map YES)
            )

            (defrule
            (goal gl-outside-map YES)
            (up-compare-goal gl-test-x__#012 g:< gl-end-x__#012)
            =>
            (up-modify-goal gl-bound-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
            (goal gl-outside-map YES)
            (up-compare-goal gl-test-y__#012 g:< gl-end-y__#012)
            =>
            (up-modify-goal gl-bound-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:= gl-start-x__#012)
            (up-modify-goal gl-test-y__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

        ; Try new point if point has no vills close by
            (defrule
            (true)
                =>
                (set-goal gl-available-vills__#012 0)
                (up-full-reset-search)
                (up-set-group search-local c: first-60-group)
                (up-set-target-point gl-test-x__#012)
                (up-remove-objects search-local object-data-distance g:> gl-minimal-accepted-builder-distance__#012)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-available-vills__#012 g:+ gl-local-total)
            )

            (defrule
                (up-compare-goal gl-second-group-size__#012 > 0)
                =>
                (up-full-reset-search)
                (up-set-group search-local c: second-60-group)
                (up-set-target-point gl-test-x__#012)
                (up-remove-objects search-local object-data-distance g:> gl-minimal-accepted-builder-distance__#012)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-available-vills__#012 g:+ gl-local-total)
            )
            (defrule
                (up-compare-goal gl-third-group-size__#012 > 0)
                =>
                (up-full-reset-search)
                (up-set-group search-local c: third-60-group)
                (up-set-target-point gl-test-x__#012)
                (up-remove-objects search-local object-data-distance g:> gl-minimal-accepted-builder-distance__#012)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-available-vills__#012 g:+ gl-local-total)
            )
            (defrule
                (up-compare-goal gl-forth-group-size__#012 > 0)
                =>
                (up-full-reset-search)
                (up-set-group search-local c: forth-60-group)
                (up-set-target-point gl-test-x__#012)
                (up-remove-objects search-local object-data-distance g:> gl-minimal-accepted-builder-distance__#012)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-available-vills__#012 g:+ gl-local-total)
            )

            (defrule
            (up-compare-goal gl-ignore-builder-rules__#012 == NO)
            (up-compare-goal gl-available-vills__#012 == 0)
            (up-compare-goal gl-test-x__#012 g:< gl-end-x__#012)
            =>
            (up-modify-goal gl-builder-distance-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
            (up-compare-goal gl-ignore-builder-rules__#012 == NO)
            (up-compare-goal gl-available-vills__#012 == 0)
            (up-compare-goal gl-test-y__#012 g:< gl-end-y__#012)
            =>
            (up-modify-goal gl-builder-distance-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:= gl-start-x__#012)
            (up-modify-goal gl-test-y__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

        ; Try new point if a building seems to be blocking placement
            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-group search-local c: building-group)
                (up-set-target-point gl-test-x__#012)
                (up-remove-objects search-local object-data-precise-distance > 300)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-local-total == 0)
                =>
                (up-full-reset-search)
                (up-set-group search-local c: building-group)
                (up-set-target-point gl-test-x__#012)
                (up-remove-objects search-local object-data-precise-distance > 400)
            )

            (defrule
                (up-compare-goal gl-local-total == 0)
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-type != house)
                =>
                (set-goal gl-local-total 1)
            )

            (defrule
            (up-compare-goal gl-ignore-building-rules__#012 == NO)
            (up-compare-goal gl-local-total > 0)
            (up-compare-goal gl-test-x__#012 g:< gl-end-x__#012)
            =>
            (up-modify-goal gl-building-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
            (up-compare-goal gl-ignore-building-rules__#012 == NO)
            (up-compare-goal gl-local-total > 0)
            (up-compare-goal gl-test-y__#012 g:< gl-end-y__#012)
            =>
            (up-modify-goal gl-building-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:= gl-start-x__#012)
            (up-modify-goal gl-test-y__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )
        ; Score calculation setup

            (defrule
            (true)
                =>
                (up-full-reset-search)
                (set-goal gl-vill-minimal-distance__#012 99999)
                (up-set-group search-local c: first-60-group)
                (up-set-target-point gl-test-x__#012)
                (up-remove-objects search-local object-data-distance g:> gl-minimal-accepted-builder-distance__#012)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
                (set-goal gl-second-vill-minimum-distance__#012 0)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-precise-distance gl-vill-distance__#012)
                (up-modify-goal gl-vill-minimal-distance__#012 g:min gl-vill-distance__#012)
            )

            (defrule
                (goal gl-build house)
                (game-time < 5)
                (up-set-target-object search-local c: 1)
                =>
                (up-get-object-data object-data-precise-distance gl-second-vill-minimum-distance__#012)
            )

            (defrule
            (true)
                =>
                (up-full-reset-search)
                (up-set-group search-local c: second-60-group)
                (up-set-target-point gl-test-x__#012)
                (up-remove-objects search-local object-data-distance g:> gl-minimal-accepted-builder-distance__#012)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-precise-distance gl-vill-distance__#012)
                (up-modify-goal gl-vill-minimal-distance__#012 g:min gl-vill-distance__#012)
            )

            (defrule
            (true)
                =>
                (up-full-reset-search)
                (up-set-group search-local c: third-60-group)
                (up-set-target-point gl-test-x__#012)
                (up-remove-objects search-local object-data-distance g:> gl-minimal-accepted-builder-distance__#012)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-precise-distance gl-vill-distance__#012)
                (up-modify-goal gl-vill-minimal-distance__#012 g:min gl-vill-distance__#012)
            )

            (defrule
            (true)
                =>
                (up-full-reset-search)
                (up-set-group search-local c: forth-60-group)
                (up-set-target-point gl-test-x__#012)
                (up-remove-objects search-local object-data-distance g:> gl-minimal-accepted-builder-distance__#012)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-precise-distance gl-vill-distance__#012)
                (up-modify-goal gl-vill-minimal-distance__#012 g:min gl-vill-distance__#012)
            )

            (defrule
                (true)
                =>
                (up-get-point-distance gl-test-x__#012 gl-ideal-x__#012 gl-distance-from-ideal-point__#012)
                (set-goal gl-chicken-score__#012 0)
            )

            (defrule
                (goal gl-build Chicken-mill)
                =>
                (up-reset-search 0 0 1 1)
                (up-set-target-point gl-test-x__#012)
                (up-set-group search-remote c: scouted-animal-group)
                (up-remove-objects search-remote object-data-class != prey-animal-class)
                (up-remove-objects search-remote object-data-precise-distance > 150)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-remote-total c:* 50)
                (up-modify-goal gl-chicken-score__#012 g:= gl-remote-total)
                (up-reset-search 0 0 1 1)
                (up-set-group search-remote c: scouted-animal-group)
                (up-remove-objects search-remote object-data-class != prey-animal-class)
                (up-remove-objects search-remote object-data-precise-distance > 350)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-remote-total c:* 20)
                (up-modify-goal gl-chicken-score__#012 g:+ gl-remote-total)
            )

        ; Try another point if score is not better than previous

            (defrule
                (true)
                =>
                (up-modify-goal gl-vill-distance-score__#012 g:= gl-vill-minimal-distance__#012)
                (up-modify-goal gl-vill-distance-score__#012 g:+ gl-second-vill-minimum-distance__#012)
                
                (up-modify-goal gl-vill-distance-score__#012 g:* gl-vill-score-multiplier__#012)
                (up-modify-goal gl-vill-distance-score__#012 c:/ 100)
                (up-modify-goal gl-ideal-point-distance-score__#012 g:= gl-distance-from-ideal-point__#012)
                (up-modify-goal gl-ideal-point-distance-score__#012 g:* gl-ideal-point-distance-score-multiplier__#012)

                (set-goal gl-combined-score__#012 0)
                (up-modify-goal gl-combined-score__#012 g:- gl-vill-distance-score__#012)
                (up-modify-goal gl-combined-score__#012 g:- gl-ideal-point-distance-score__#012)
                (up-modify-goal gl-combined-score__#012 g:+ gl-chicken-score__#012)
                
            )

            (defrule
            (up-compare-goal gl-combined-score__#012 g:<= gl-best-score__#012)
            (up-compare-goal gl-test-x__#012 g:< gl-end-x__#012)
            =>
            (up-modify-goal gl-score-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
            (up-compare-goal gl-combined-score__#012 g:<= gl-best-score__#012)
            (up-compare-goal gl-test-y__#012 g:< gl-end-y__#012)
            =>
            (up-modify-goal gl-score-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:= gl-start-x__#012)
            (up-modify-goal gl-test-y__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

        ; Try new point if point is to close to other res and dropsites

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-test-x__#012)
                (up-set-group search-local c: tc-group)
                (up-remove-objects search-local object-data-distance g:> gl-tc-farming-distance__#012)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-close-dropsite__#012 g:= gl-local-total)
                (up-full-reset-search)
                (up-set-group search-local c: dropsite-group)
                (up-remove-objects search-local object-data-distance g:> gl-dropsite-safe-distance__#012)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-close-dropsite__#012 g:+ gl-local-total)
            )

            (defrule
            (up-compare-goal gl-close-dropsite__#012 > 0)
            (up-compare-goal gl-test-x__#012 g:< gl-end-x__#012)
            (up-compare-goal gl-ignore-dropsite-rules__#012 == NO)
            =>
            (up-modify-goal gl-dropsite-res-distance-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
            (up-compare-goal gl-close-dropsite__#012 > 0)
            (up-compare-goal gl-test-y__#012 g:< gl-end-y__#012)
            (up-compare-goal gl-ignore-dropsite-rules__#012 == NO)
            =>
            (up-modify-goal gl-dropsite-res-distance-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:= gl-start-x__#012)
            (up-modify-goal gl-test-y__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

        ; If new best score is found check for close wood and wether building can be placed. If so best score and point is replaced
            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-get-search-state gl-local-total)
                (up-copy-point gl-test-top-x__#012 gl-test-x__#012)
                (up-modify-goal gl-test-top-x__#012 c:+ 1)
                (up-modify-goal gl-test-top-y__#012 c:- 1)
                (up-copy-point gl-test-right-x__#012 gl-test-x__#012)
                (up-modify-goal gl-test-right-x__#012 c:+ 1)
                (up-modify-goal gl-test-right-y__#012 c:+ 1)
                (up-copy-point gl-test-down-x__#012 gl-test-x__#012)
                (up-modify-goal gl-test-down-x__#012 c:- 1)
                (up-modify-goal gl-test-down-y__#012 c:+ 1)
                (up-copy-point gl-test-left-x__#012 gl-test-x__#012)
                (up-modify-goal gl-test-left-x__#012 c:- 1)
                (up-modify-goal gl-test-left-y__#012 c:- 1)
                (set-goal gl-wood-and-building-succes__#012 NO)
            )
            (defrule
                (up-compare-goal gl-wood-and-build-rejections__#012 < 25)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-test-x__#012)
                (up-filter-distance c: -1 g: gl-dropsite-safe-distance__#012)
                (up-filter-status c: status-ready c: list-active)            
                (up-find-resource c: wood c: 1)
                (up-filter-status c: status-resource c: list-active)            
                (up-find-resource c: wood c: 1)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-combined-score__#012 g:> gl-best-score__#012)
                (up-compare-goal gl-remote-total == 0)
                (up-can-build-line 0 gl-test-x__#012 g: gl-build-game-name__#012)
                (up-can-build-line 0 gl-test-top-x__#012 g: gl-build-game-name__#012)
                (up-can-build-line 0 gl-test-right-x__#012 g: gl-build-game-name__#012)
                (up-can-build-line 0 gl-test-down-x__#012 g: gl-build-game-name__#012)
                (up-can-build-line 0 gl-test-left-x__#012 g: gl-build-game-name__#012)
                =>
                (set-goal gl-wood-and-building-succes__#012 YES)
                (up-copy-point gl-chosen-point-x__#012 gl-test-x__#012)
                (up-modify-goal gl-best-score__#012 g:= gl-combined-score__#012)
            )

        ; Try new point if point does not pass wood and build check
            (defrule
                (goal gl-wood-and-building-succes__#012 NO)
                (up-compare-goal gl-test-x__#012 g:< gl-end-x__#012)
                =>
                (up-modify-goal gl-wood-and-build-rejections__#012 c:+ 1)
                (up-modify-goal gl-test-x__#012 g:+ gl-skip-tile-nr__#012)
                (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
                )

                (defrule
                (goal gl-wood-and-building-succes__#012 NO)
                (up-compare-goal gl-test-y__#012 g:< gl-end-y__#012)
                =>
                (up-modify-goal gl-wood-and-build-rejections__#012 c:+ 1)
                (up-modify-goal gl-test-x__#012 g:= gl-start-x__#012)
                (up-modify-goal gl-test-y__#012 g:+ gl-skip-tile-nr__#012)
                (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
                )
        ; Controll early exit

            (defrule
                (true)
                =>
                (set-goal gl-early-exit__#012 NO)
                (up-get-precise-time gl-script-start-time__#051 gl-script-time__#051)
            )

            (defrule
                (up-compare-goal gl-build != Chicken-mill)
                (up-compare-goal gl-build != siege-workshop)
                (up-compare-goal gl-build != monastery)
                (up-compare-goal gl-build != watch-tower)
                (up-compare-goal gl-build != barracks)
                (or(up-compare-goal gl-vill-minimal-distance__#012 <= 300)
                (and(up-compare-goal gl-vill-minimal-distance__#012 <= 900)
                (up-compare-goal gl-script-time__#051 > 10)))
                (building-count-total > 10)
                =>
                (set-goal gl-early-exit__#012 YES)
            )

            (defrule
                (up-compare-goal gl-failed-building-placement__#012 == YES)
                (up-compare-goal gl-vill-minimal-distance__#012 <= 1200)
                (up-compare-goal gl-script-time__#051 > 10)
                =>
                (set-goal gl-early-exit__#012 YES)
            )

        ; Try new point at the end of loop
            (defrule
            (up-compare-goal gl-test-x__#012 g:< gl-end-x__#012)
            (goal gl-early-exit__#012 NO)
            =>
            (up-modify-goal gl-non-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
            (up-compare-goal gl-test-y__#012 g:< gl-end-y__#012)
            (goal gl-early-exit__#012 NO)
            =>
            (up-modify-goal gl-non-rejections__#012 c:+ 1)
            (up-modify-goal gl-test-x__#012 g:= gl-start-x__#012)
            (up-modify-goal gl-test-y__#012 g:+ gl-skip-tile-nr__#012)
            (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

        ; If point was chosen then build building

            (defrule
                (up-compare-goal gl-chosen-point-x__#012 == -1)
                (up-compare-goal gl-build != -1)
                =>
                (up-modify-goal gl-temp g:= gl-last-time-checkpoint__#051)
                (up-get-precise-time gl-script-start-time__#051 gl-last-time-checkpoint__#051)
                (up-modify-goal gl-temp g:- gl-last-time-checkpoint__#051)
                (up-modify-goal gl-temp1 g:neg gl-temp)
                (up-modify-goal gl-temp g:max gl-temp1)
                ;(up-chat-data-to-all "First try failed: %d" g: gl-failed-building-placement__#012)
                ;(up-chat-data-to-all "gl-min-distance__#012: %d" g: gl-min-distance__#012)
                ;(up-chat-data-to-all "gl-max-distance__#012: %d" g: gl-max-distance__#012)
                ;(up-chat-data-to-all "best score: %d" g: gl-best-score__#012)
                ;(up-chat-data-to-all "Donut rejections: %d" g: gl-home-distance-rejections__#012)
                ;(up-chat-data-to-all "Farming rejections: %d" g: gl-farming-rejections__#012)
                ;(up-chat-data-to-all "Bound rejections: %d" g: gl-bound-rejections__#012)
                ;(up-chat-data-to-all "Object rejections: %d" g: gl-accessability-rejections__#012)
                ;(up-chat-data-to-all "Builder rejections: %d" g: gl-builder-distance-rejections__#012)
                ;(up-chat-data-to-all "Building rejections: %d" g: gl-building-rejections__#012)
                ;(up-chat-data-to-all "Score rejections: %d" g: gl-score-rejections__#012)
                ;(up-chat-data-to-all "Ressource rejections: %d" g: gl-dropsite-res-distance-rejections__#012)
                ;(up-chat-data-to-all "Build line rejections: %d" g: gl-wood-and-build-rejections__#012)
                ;(up-chat-data-to-all "Non rejections: %d" g: gl-non-rejections__#012)
                ;(up-chat-data-to-all "Early exit: %d" g: gl-early-exit__#012)
                (up-chat-data-to-all "trying to build %d" g: gl-build)
                (up-chat-data-to-all "Time to fail building: %d ms" g: gl-temp)
            )

            (defrule
                (up-compare-goal gl-chosen-point-x__#012 == -1)
                (up-compare-goal gl-build != -1)
                (goal gl-failed-building-placement__#012 NO)
                =>
                (set-goal gl-failed-building-placement__#012 YES)
                
                
                (up-modify-goal gl-max-distance__#012 g:= gl-starting-max-distance__#012)
                (up-modify-goal gl-max-distance__#012 c:+ 10)
                (up-modify-goal gl-min-distance__#012 c:= 9)
                (up-copy-point gl-start-x__#012 gl-position-self-x)
                (up-modify-goal gl-start-x__#012 g:- gl-max-distance__#012)
                (up-modify-goal gl-start-y__#012 g:- gl-max-distance__#012)
                (up-copy-point gl-end-x__#012 gl-position-self-x)
                (up-modify-goal gl-end-x__#012 g:+ gl-max-distance__#012)
                (up-modify-goal gl-end-y__#012 g:+ gl-max-distance__#012)
                (up-copy-point gl-test-x__#012 gl-start-x__#012)

                (set-goal gl-home-distance-rejections__#012 0)
                (set-goal gl-farming-rejections__#012 0)
                (set-goal gl-building-rejections__#012 0)
                (set-goal gl-accessability-rejections__#012 0)
                (set-goal gl-dropsite-res-distance-rejections__#012 0)
                (set-goal gl-builder-distance-rejections__#012 0)
                (set-goal gl-score-rejections__#012 0)
                (set-goal gl-wood-and-build-rejections__#012 0)
                (set-goal gl-non-rejections__#012 0)

                ;(set-goal gl-ignore-dropsite-rules__#012 NO)
                ;(set-goal gl-ignore-farming-rules__#012 NO)
                ;(set-goal gl-ignore-building-rules__#012 NO)
                (set-goal gl-ignore-builder-rules__#012 YES)
                ;(set-goal gl-ideal-point-distance-score-multiplier__#012 4)
                (set-goal gl-vill-score-multiplier__#012 2)

                (up-jump-direct g: gl-normal-building-loop-first-rule-id__#012)
            )

            (defrule
                (up-compare-goal gl-chosen-point-x__#012 != -1)
                =>
                (up-build-line gl-chosen-point-x__#012 gl-chosen-point-x__#012 g: gl-build-game-name__#012)
                (up-chat-data-to-all "placing %d" g: gl-build)
                (set-goal gl-build -1)

                (up-modify-goal gl-temp g:= gl-last-time-checkpoint__#051)
                (up-get-precise-time gl-script-start-time__#051 gl-last-time-checkpoint__#051)
                (up-modify-goal gl-temp g:- gl-last-time-checkpoint__#051)
                (up-modify-goal gl-temp1 g:neg gl-temp)
                (up-modify-goal gl-temp g:max gl-temp1)
                ;(up-chat-data-to-all "gl-min-distance__#012: %d" g: gl-min-distance__#012)
                ;(up-chat-data-to-all "gl-max-distance__#012: %d" g: gl-max-distance__#012)
                ;(up-chat-data-to-all "best score: %d" g: gl-best-score__#012)
                ;(up-chat-data-to-all "Donut rejections: %d" g: gl-home-distance-rejections__#012)
                ;(up-chat-data-to-all "Farming rejections: %d" g: gl-farming-rejections__#012)
                ;(up-chat-data-to-all "Object rejections: %d" g: gl-accessability-rejections__#012)
                ;(up-chat-data-to-all "Builder rejections: %d" g: gl-builder-distance-rejections__#012)
                ;(up-chat-data-to-all "Building rejections: %d" g: gl-building-rejections__#012)
                ;(up-chat-data-to-all "Score rejections: %d" g: gl-score-rejections__#012)
                ;(up-chat-data-to-all "Ressource rejections: %d" g: gl-dropsite-res-distance-rejections__#012)
                ;(up-chat-data-to-all "Build line rejections: %d" g: gl-wood-and-build-rejections__#012)
                ;(up-chat-data-to-all "Non rejections: %d" g: gl-non-rejections__#012)
                ;(up-chat-data-to-all "First try failed: %d" g: gl-failed-building-placement__#012)
                ;(up-chat-data-to-all "Early exit: %d" g: gl-early-exit__#012)
                (up-chat-data-to-all "Time to place building: %d ms" g: gl-temp)
            )

        ; Jump to end of building rules
            
            (defrule
                (up-compare-goal gl-post-build-engine-rule-id != -1)
                =>
                (up-jump-direct g: gl-post-build-engine-rule-id)
            )
        


    ; Farms #013 (ss4)
        ; Jump here to build building
            (defrule
                (true)
                =>
                (up-get-rule-id gl-farm-building-first-rule-id)
            )
        ;Save the positions of up to 10 straggler trees
            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 10)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: wood c: 40)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 40)
                (up-remove-objects search-remote object-data-carry < 10)
                (up-clean-search search-remote object-data-distance search-order-asc)
                (up-remove-objects search-remote object-data-index >= 10)
                (set-goal gl-current-goal-constant gl-first-straggler-x)
                (set-goal gl-first-straggler-x -1)
                (set-goal gl-first-straggler-y -1)
                (set-goal gl-second-straggler-x -1)
                (set-goal gl-second-straggler-y -1)
                (set-goal gl-third-straggler-x -1)
                (set-goal gl-third-straggler-y -1)
                (set-goal gl-forth-straggler-x -1)
                (set-goal gl-forth-straggler-y -1)
                (set-goal gl-fifth-straggler-x -1)
                (set-goal gl-fifth-straggler-y -1)
                (set-goal gl-sixth-straggler-x -1)
                (set-goal gl-sixth-straggler-y -1)
                (set-goal gl-seventh-straggler-x -1)
                (set-goal gl-seventh-straggler-y -1)
                (set-goal gl-eighth-straggler-x -1)
                (set-goal gl-eighth-straggler-y -1)
                (set-goal gl-nineth-straggler-x -1)
                (set-goal gl-nineth-straggler-y -1)
                (set-goal gl-tenth-straggler-x -1)
                (set-goal gl-tenth-straggler-y -1)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-point position-object gl-tree-x)
                (up-copy-point gl-testing-1-x gl-tree-x)
                (up-modify-goal gl-testing-1-x c:+ 1)
                (up-copy-point gl-testing-2-x gl-tree-x)
                (up-modify-goal gl-testing-2-x c:+ 1)
                (up-modify-goal gl-testing-2-y c:+ 1)
                (up-copy-point gl-testing-3-x gl-tree-x)
                (up-modify-goal gl-testing-3-y c:+ 1)
                (up-copy-point gl-testing-4-x gl-tree-x)
                (up-modify-goal gl-testing-4-y c:+ 1)
                (up-modify-goal gl-testing-4-x c:- 1)
                (up-copy-point gl-testing-5-x gl-tree-x)
                (up-modify-goal gl-testing-5-x c:- 1)
                (up-copy-point gl-testing-6-x gl-tree-x)
                (up-modify-goal gl-testing-6-x c:- 1)
                (up-modify-goal gl-testing-6-y c:- 1)
                (up-copy-point gl-testing-7-x gl-tree-x)
                (up-modify-goal gl-testing-7-y c:- 1)
                (up-copy-point gl-testing-8-x gl-tree-x)
                (up-modify-goal gl-testing-8-x c:+ 1)
                (up-modify-goal gl-testing-8-y c:- 1)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                (not(or(up-point-contains gl-testing-1-x c: tree-class)
                (or(up-point-contains gl-testing-2-x c: tree-class)
                (or(up-point-contains gl-testing-3-x c: tree-class)
                (or(up-point-contains gl-testing-4-x c: tree-class)
                (or(up-point-contains gl-testing-5-x c: tree-class)
                (or(up-point-contains gl-testing-6-x c: tree-class)
                (or(up-point-contains gl-testing-7-x c: tree-class)
                (up-point-contains gl-testing-8-x c: tree-class)))))))))
                =>
                (up-modify-goal gl-tree-x c:* 100)
                (up-modify-goal gl-tree-y c:* 100)
                (up-set-indirect-goal g: gl-current-goal-constant g: gl-tree-x)
                (up-modify-goal gl-current-goal-constant c:+ 1)
                (up-set-indirect-goal g: gl-current-goal-constant g: gl-tree-y)
                (up-modify-goal gl-current-goal-constant c:+ 1)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-remove-objects search-remote object-data-index == 0)
                (up-jump-rule -3)
            )
        ;Save position of up to 15 tc's and farms in temp-goals gl-drop-site 1-15

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: town-center c: 200)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: town-center-foundation c: 200)
                (up-clean-search search-local -1 search-order-asc)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-number-of-town-centers__#013 g:= gl-local-total)
                (up-modify-goal gl-current-number-dropsite-checked__#013 c:= gl-drop-site-1-x__#013)
            )

            (defrule ;jeg vil have et goal pair ind i det goal der svarer til værdien på gl-current-number-dropsite-checked__#013
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp-x) 
                (up-set-indirect-goal g: gl-current-number-dropsite-checked__#013 g: gl-temp-x)
                (up-modify-goal gl-current-number-dropsite-checked__#013 c:+ 1)
                (up-set-indirect-goal g: gl-current-number-dropsite-checked__#013 g: gl-temp-y)
                (up-modify-goal gl-current-number-dropsite-checked__#013 c:+ 1)
                (up-remove-objects search-local object-data-index == 0)
                (up-jump-rule -1)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: mill c: 200)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: mill c: 200)
                (up-clean-search search-local -1 search-order-asc)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-number-of-mills__#013 g:= gl-local-total)
            )

            (defrule ;jeg vil have et goal pair ind i det goal der svarer til værdien på gl-current-number-dropsite-checked__#013
                (up-compare-goal gl-current-number-dropsite-checked__#013 c:<= gl-drop-site-15-x__#013)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp-x) 
                (up-set-indirect-goal g: gl-current-number-dropsite-checked__#013 g: gl-temp-x)
                (up-modify-goal gl-current-number-dropsite-checked__#013 c:+ 1)
                (up-set-indirect-goal g: gl-current-number-dropsite-checked__#013 g: gl-temp-y)
                (up-modify-goal gl-current-number-dropsite-checked__#013 c:+ 1)
                (up-remove-objects search-local object-data-index == 0)
                (up-jump-rule -1)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-total-number-dropsites__#013 g:= gl-number-of-town-centers__#013)
                (up-modify-goal gl-total-number-dropsites__#013 g:+ gl-number-of-mills__#013)
            )
        
        ;Modify numbers to ajust for lag and placement prefferences
            (defrule
                (true)
                =>
                (set-goal gl-square-size__#013 10)
                (set-goal gl-dropsite-distance-modifier__#013 3)
                (set-goal gl-home-distance-modifier__#013 1)
                (set-goal gl-builder-distance-modifier__#013 3)
                (set-goal gl-lerped-tiles-towards-enemy__#013 -9)
                (set-goal gl-tc-prefference-modifier__#013 50) ;divided by 10
                (set-goal gl-straggler-penalty 75)
            )

        ;Remaining setup before loops

            (defrule
                (up-compare-goal gl-position == Flank)
                =>
                (up-get-point position-flank gl-estimated-enemy-x__#013)
                (up-lerp-tiles gl-estimated-enemy-x__#013 gl-position-center-x c: 10)
            )

            (defrule
                (up-compare-goal gl-position == Pocket)
                =>
                (up-get-point position-center gl-estimated-enemy-x__#013)
            )

            (defrule
                (up-compare-goal gl-lerped-tiles-towards-enemy__#013 != 0)
                =>
                (up-get-point position-self gl-home-x__#013)
                (up-lerp-tiles gl-home-x__#013 gl-estimated-enemy-x__#013 g: gl-lerped-tiles-towards-enemy__#013)
            )

            (defrule
                (true)
                =>
                (set-goal gl-best-found-score__#013 -99999)
                (up-modify-goal gl-x-modifier__#013 g:= gl-square-size__#013)
                (up-modify-goal gl-x-modifier__#013 c:* -1)
                (up-modify-goal gl-y-modifier__#013 g:= gl-square-size__#013)
                (up-modify-goal gl-y-modifier__#013 c:* -1)
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-remove-objects search-local object-data-language-id == lid-villager-builder)
                (up-remove-objects search-local object-data-language-id != lid-villager-lumberjack)
                (up-remove-objects search-local object-data-id g:== gl-chicken-vill-1-id__#000)
                (up-remove-objects search-local object-data-id g:== gl-chicken-vill-2-id__#000)
                (up-remove-objects search-local object-data-id g:== gl-chicken-vill-3-id__#000)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-local-total == 0)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-remove-objects search-local object-data-language-id == lid-villager-builder)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (idle-farm-count == 0)
                =>
                (up-remove-objects search-local object-data-language-id == lid-villager-farmer)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-local-total == 0)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-remove-objects search-local object-data-language-id == lid-villager-builder)
            )

            (defrule
                (up-compare-goal gl-local-total == 0)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-language-id == lid-villager-builder)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-current-number-dropsite-checked__#013 c:= gl-drop-site-1-x__#013)
                (up-modify-goal gl-last-number-dropsite-checked__#013 c:= gl-drop-site-1-x__#013)
                (up-modify-goal gl-last-number-dropsite-checked__#013 g:+ gl-total-number-dropsites__#013)
                (up-modify-goal gl-last-number-dropsite-checked__#013 g:+ gl-total-number-dropsites__#013);do twice due to y goals
                (up-modify-goal gl-last-number-dropsite-checked__#013 c:- 2) ;Dont cont the first one
                (set-goal gl-upper-right-x-modifier__#013 3)  ;town center numbers
                (set-goal gl-upper-right-y-modifier__#013 -1)
                (set-goal gl-lower-right-x-modifier__#013 0)
                (set-goal gl-lower-right-y-modifier__#013 3)
                (set-goal gl-lower-left-x-modifier__#013 -4)
                (set-goal gl-lower-left-y-modifier__#013 0)
                (set-goal gl-upper-left-x-modifier__#013 -1)
                (set-goal gl-upper-left-y-modifier__#013 -4)
                (set-goal gl-dropsite-index-number__#013 1)
            )

        ;Big loop finds point-goals for the dropsites ideal forming grid.

            (defrule ;Reset temp goals each time square loops reset
                (true)
                =>
                (up-get-rule-id gl-big-loop-start__#013) ;guide square loops back to this rule
                (up-get-indirect-goal g: gl-current-number-dropsite-checked__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-current-number-dropsite-checked__#013 c:+ 1)
                (up-get-indirect-goal g: gl-current-number-dropsite-checked__#013 gl-current-dropsite-y__#013)
                (up-modify-goal gl-current-number-dropsite-checked__#013 c:+ 1)
            )

            (defrule
                (up-compare-goal gl-dropsite-index-number__#013 g:> gl-number-of-town-centers__#013) ;checking a mill
                =>
                (set-goal gl-upper-right-x-modifier__#013 2) 
                (set-goal gl-upper-right-y-modifier__#013 0)
                (set-goal gl-lower-right-x-modifier__#013 -1)
                (set-goal gl-lower-right-y-modifier__#013 2)
                (set-goal gl-lower-left-x-modifier__#013 -3)
                (set-goal gl-lower-left-y-modifier__#013 -1)
                (set-goal gl-upper-left-x-modifier__#013 0)
                (set-goal gl-upper-left-y-modifier__#013 -3)
            )

            (defrule ;tier 1
                (true)
                =>
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-upper-right-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-upper-right-y-modifier__#013)
                (up-copy-point gl-farm-grid-1-x__#013 gl-checking-dropsite-x__#013)
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-lower-right-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-lower-right-y-modifier__#013)
                (up-copy-point gl-farm-grid-2-x__#013 gl-checking-dropsite-x__#013)
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-lower-left-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-lower-left-y-modifier__#013)
                (up-copy-point gl-farm-grid-3-x__#013 gl-checking-dropsite-x__#013)
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-upper-left-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-upper-left-y-modifier__#013)
                (up-copy-point gl-farm-grid-4-x__#013 gl-checking-dropsite-x__#013)
            )

            (defrule ;tier 2
                (true)
                =>
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-upper-right-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-upper-right-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 c:+ 3)
                (up-copy-point gl-farm-grid-5-x__#013 gl-checking-dropsite-x__#013)
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-lower-right-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-lower-right-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 c:- 3)
                (up-copy-point gl-farm-grid-6-x__#013 gl-checking-dropsite-x__#013)
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-lower-left-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-lower-left-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 c:- 3)
                (up-copy-point gl-farm-grid-7-x__#013 gl-checking-dropsite-x__#013)
            )

            (defrule
                (true)
                =>
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-upper-left-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-upper-left-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 c:+ 3)
                (up-copy-point gl-farm-grid-8-x__#013 gl-checking-dropsite-x__#013)
                ;tier 3
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-upper-right-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-upper-right-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 c:+ 3)
                (up-copy-point gl-farm-grid-9-x__#013 gl-checking-dropsite-x__#013)
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-lower-right-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-lower-right-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 c:+ 3)
                (up-copy-point gl-farm-grid-10-x__#013 gl-checking-dropsite-x__#013)
            )

            (defrule
                (true)
                =>
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-lower-left-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-lower-left-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 c:- 3)
                (up-copy-point gl-farm-grid-11-x__#013 gl-checking-dropsite-x__#013)
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-upper-left-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-upper-left-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 c:- 3)
                (up-copy-point gl-farm-grid-12-x__#013 gl-checking-dropsite-x__#013)
                ;Tier 4
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-upper-right-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-upper-right-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 c:+ 6)
                (up-copy-point gl-farm-grid-13-x__#013 gl-checking-dropsite-x__#013)
            )

            (defrule
                (true)
                =>
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-lower-right-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-lower-right-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 c:- 6)
                (up-copy-point gl-farm-grid-14-x__#013 gl-checking-dropsite-x__#013)
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-lower-left-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-lower-left-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 c:- 6)
                (up-copy-point gl-farm-grid-15-x__#013 gl-checking-dropsite-x__#013)
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-upper-left-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-upper-left-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 c:+ 6)
                (up-copy-point gl-farm-grid-16-x__#013 gl-checking-dropsite-x__#013)
            )

            (defrule
                (true)
                =>
                ;Tier 5
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-upper-right-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-upper-right-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 c:+ 3)
                (up-modify-goal gl-checking-dropsite-x__#013 c:+ 3)
                (up-copy-point gl-farm-grid-17-x__#013 gl-checking-dropsite-x__#013)
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-lower-right-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-lower-right-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 c:- 3)
                (up-modify-goal gl-checking-dropsite-y__#013 c:+ 3)
                (up-copy-point gl-farm-grid-18-x__#013 gl-checking-dropsite-x__#013)
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-lower-left-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-lower-left-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 c:- 3)
                (up-modify-goal gl-checking-dropsite-x__#013 c:- 3)
                (up-copy-point gl-farm-grid-19-x__#013 gl-checking-dropsite-x__#013)
            )

            (defrule
                (true)
                =>
                (up-copy-point gl-checking-dropsite-x__#013 gl-current-dropsite-x__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 g:+ gl-upper-left-x-modifier__#013)
                (up-modify-goal gl-checking-dropsite-y__#013 g:+ gl-upper-left-y-modifier__#013)
                (up-modify-goal gl-checking-dropsite-x__#013 c:+ 3)
                (up-modify-goal gl-checking-dropsite-y__#013 c:- 3)
                (up-copy-point gl-farm-grid-20-x__#013 gl-checking-dropsite-x__#013)
            )

        ;Small loop checks every tile in a square around each dropsite for wether a building can be build

            (defrule ;Reset temp goals each time square loops reset
                (true)
                =>
                (up-get-rule-id gl-small-loop-start__#013) ;guide square loops back to this rule
                (up-copy-point gl-checked-tile-x__#013 gl-current-dropsite-x__#013) ;square around tc
                (up-modify-goal gl-checked-tile-x__#013 g:+ gl-x-modifier__#013) ;find new checking tile
                (up-modify-goal gl-checked-tile-y__#013 g:+ gl-y-modifier__#013)
                (up-bound-precise-point gl-checked-tile-x__#013 0 c: 0) ;we dont wanna test point outside map
            )

            (defrule
                (not(up-can-build-line 0 gl-checked-tile-x__#013 g: gl-build))
                (up-compare-goal gl-x-modifier__#013 g:< gl-square-size__#013) ;x-coordinate not at maximum yet
                (up-compare-goal gl-build == farm) ;turn off loop when not used to avoid lag
                =>
                (up-modify-goal gl-x-modifier__#013 c:+ 1) ;change x coordinate
                (up-jump-direct g: gl-small-loop-start__#013) ;reset small square loop
            )

            (defrule
                (not(up-can-build-line 0 gl-checked-tile-x__#013 g: gl-build))
                (up-compare-goal gl-x-modifier__#013 g:>= gl-square-size__#013) ;x-coordinate at maximum
                (up-compare-goal gl-y-modifier__#013 g:< gl-square-size__#013) ;y-coordinate not at maximum yet
                (up-compare-goal gl-build == farm) ;turn off loop when not used to avoid lag
                =>
                (up-modify-goal gl-x-modifier__#013 g:= gl-square-size__#013) ;reset x coordinate
                (up-modify-goal gl-x-modifier__#013 c:* -1) ;reset x coordinate
                (up-modify-goal gl-y-modifier__#013 c:+ 1) ;change y coordinate
                (up-jump-direct g: gl-small-loop-start__#013) ;reset small square loop
            )

        ;Finds the combined score based on home-distance, dropsite-distance, builder-distance and farming-grid.

            (defrule
                (true)
                =>
                (set-goal gl-combined-score__#013 0)
                (set-goal gl-grid-score__#013 0)

                (up-get-point-distance gl-checked-tile-x__#013 gl-home-x__#013 gl-home-distance-score__#013)
                (up-modify-goal gl-home-distance-score__#013 g:* gl-home-distance-modifier__#013)
                (up-modify-goal gl-combined-score__#013 g:- gl-home-distance-score__#013)

                (up-get-point-distance gl-checked-tile-x__#013 gl-current-dropsite-x__#013 gl-dropsite-distance-score__#013)
                (up-modify-goal gl-dropsite-distance-score__#013 g:* gl-dropsite-distance-modifier__#013)
                
                
                (up-set-target-point gl-checked-tile-x__#013)
                (up-clean-search search-local object-data-distance search-order-asc)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-distance gl-builder-distance-score__#013)
                (up-modify-goal gl-builder-distance-score__#013 g:* gl-builder-distance-modifier__#013)
                (up-modify-goal gl-combined-score__#013 g:- gl-builder-distance-score__#013)
            )

            (defrule
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-1-x__#013 == 0)
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-2-x__#013 == 0)
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-3-x__#013 == 0)
                (up-point-distance gl-checked-tile-x__#013 gl-farm-grid-4-x__#013 == 0))))
                =>
                (up-modify-goal gl-grid-score__#013 c:+ 20)
            )

            (defrule
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-5-x__#013 == 0)
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-6-x__#013 == 0)
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-7-x__#013 == 0)
                (up-point-distance gl-checked-tile-x__#013 gl-farm-grid-8-x__#013 == 0))))
                =>
                (up-modify-goal gl-grid-score__#013 c:+ 16)
            )

            (defrule
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-9-x__#013 == 0)
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-10-x__#013 == 0)
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-11-x__#013 == 0)
                (up-point-distance gl-checked-tile-x__#013 gl-farm-grid-12-x__#013 == 0))))
                =>
                (up-modify-goal gl-grid-score__#013 c:+ 10)
            )

            (defrule
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-13-x__#013 == 0)
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-14-x__#013 == 0)
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-15-x__#013 == 0)
                (up-point-distance gl-checked-tile-x__#013 gl-farm-grid-16-x__#013 == 0))))
                (up-compare-goal gl-dropsite-index-number__#013 g:<= gl-number-of-town-centers__#013) ;checking a tc
                =>
                (up-modify-goal gl-grid-score__#013 c:+ 7)
            )

            (defrule
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-17-x__#013 == 0)
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-18-x__#013 == 0)
                (or(up-point-distance gl-checked-tile-x__#013 gl-farm-grid-19-x__#013 == 0)
                (up-point-distance gl-checked-tile-x__#013 gl-farm-grid-20-x__#013 == 0))))
                =>
                (up-modify-goal gl-grid-score__#013 c:+ 6)
            )

            (defrule
                (up-compare-goal gl-dropsite-index-number__#013 g:<= gl-number-of-town-centers__#013) ;checking a tc
                =>
                (up-modify-goal gl-grid-score__#013 g:* gl-tc-prefference-modifier__#013)
                (up-modify-goal gl-grid-score__#013 c:/ 10)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-combined-score__#013 g:+ gl-grid-score__#013)
                (up-modify-goal gl-combined-score__#013 g:- gl-dropsite-distance-score__#013)
                (up-copy-point gl-precise-testing-x gl-checked-tile-x__#013)
                (up-modify-goal gl-precise-testing-x c:* 100)
                (up-modify-goal gl-precise-testing-y c:* 100)
            )

            (defrule
                (or(up-point-distance gl-precise-testing-x gl-first-straggler-x < 200)
                (or(up-point-distance gl-precise-testing-x gl-second-straggler-x < 200)
                (or(up-point-distance gl-precise-testing-x gl-third-straggler-x < 200)
                (or(up-point-distance gl-precise-testing-x gl-forth-straggler-x < 200)
                (or(up-point-distance gl-precise-testing-x gl-sixth-straggler-x < 200)
                (or(up-point-distance gl-precise-testing-x gl-seventh-straggler-x < 200)
                (or(up-point-distance gl-precise-testing-x gl-eighth-straggler-x < 200)
                (or(up-point-distance gl-precise-testing-x gl-nineth-straggler-x < 200)
                (up-point-distance gl-precise-testing-x gl-tenth-straggler-x < 200)))))))))
                =>
                (up-modify-goal gl-combined-score__#013 c:- gl-straggler-penalty)
            )

            (defrule
                (up-compare-goal gl-combined-score__#013 g:> gl-best-found-score__#013) ;new found score better than best found score this loop
                (up-can-build-line 0 gl-checked-tile-x__#013 g: gl-build)
                =>
                (up-modify-goal gl-best-found-score__#013 g:= gl-combined-score__#013) ;replace best score
                (up-copy-point gl-best-fount-point-x__#013 gl-checked-tile-x__#013) ;replace best point
            )

        ;Restart loops
            (defrule
                (up-compare-goal gl-x-modifier__#013 g:< gl-square-size__#013) ;x-coordinate not at maximum yet
                (up-compare-goal gl-build == farm) ;turn off loop when not used to avoid lag
                =>
                (up-modify-goal gl-x-modifier__#013 c:+ 1) ;change x coordinate
                (up-jump-direct g: gl-small-loop-start__#013) ;reset small square loop
            )

            (defrule
                (up-compare-goal gl-x-modifier__#013 g:>= gl-square-size__#013) ;x-coordinate at maximum
                (up-compare-goal gl-y-modifier__#013 g:< gl-square-size__#013) ;y-coordinate not at maximum yet
                (up-compare-goal gl-build == farm) ;turn off loop when not used to avoid lag
                =>
                (up-modify-goal gl-x-modifier__#013 g:= gl-square-size__#013) ;reset x coordinate
                (up-modify-goal gl-x-modifier__#013 c:* -1) ;reset x coordinate
                (up-modify-goal gl-y-modifier__#013 c:+ 1) ;change y coordinate
                (up-jump-direct g: gl-small-loop-start__#013) ;reset small square loop
            )

            (defrule
                (up-compare-goal gl-build == farm)
                (up-compare-goal gl-dropsite-index-number__#013 g:< gl-total-number-dropsites__#013) 
                =>
                (up-modify-goal gl-x-modifier__#013 g:= gl-square-size__#013)
                (up-modify-goal gl-x-modifier__#013 c:* -1)
                (up-modify-goal gl-y-modifier__#013 g:= gl-square-size__#013)
                (up-modify-goal gl-y-modifier__#013 c:* -1)
                (up-modify-goal gl-dropsite-index-number__#013 c:+ 1)
                (up-jump-direct g: gl-big-loop-start__#013)
            )
           
        ;Build the farm in the best found point

            (defrule
                (up-compare-goal gl-build == farm) ;turn off loop when not used to avoid lag
                (up-can-build-line 0 gl-best-fount-point-x__#013 g: gl-build)
                =>
                (up-build-line gl-best-fount-point-x__#013 gl-best-fount-point-x__#013 g: gl-build)
            )

            (defrule
                (up-compare-goal gl-build == farm)
                =>
                (set-goal gl-build -1)
            )
        ; Jump to end of building rules
            
            (defrule
                (up-compare-goal gl-post-build-engine-rule-id != -1)
                =>
                (up-jump-direct g: gl-post-build-engine-rule-id)
            )

    ; Lumber camps, Mining camps and berry mills #014 (ss5)
        ; Jump here to build building
            (defrule
                (true)
                =>
                (up-get-rule-id gl-dropsite-building-first-rule-id)
            )
        ; Lag test
            (defrule
                (up-compare-goal gl-build == lumber-camp)
                =>
                (up-modify-goal gl-temp g:= gl-script-time__#051)
                (up-get-precise-time gl-script-start-time__#051 gl-script-time__#051)
                (up-modify-goal gl-temp g:- gl-script-time__#051)
                (up-modify-goal gl-temp1 g:neg gl-temp)
                (up-modify-goal gl-temp g:max gl-temp1)
                (up-chat-data-to-all "Buildings pre lumber camp took: %d ms" g: gl-temp)
            )
        ;Temp goals used
            

        ;Modify these settings to chance building behavior
            
            (defrule
                (true)
                =>
                (set-goal gl-chosen-ressource__#014 -1)
            )

            (defrule ;General guidelines for lumber camp placement
                (up-compare-goal gl-build == lumber-camp)
                =>
                (set-goal gl-home-distance-modifier__#014 150) ;Lower number to prioritise closer lumber camps.
                (set-goal gl-lerped-tiles-towards-enemy__#014 -3) ;Lower number to prioritise back lumber camps
                (set-goal gl-maximal-found-points__#014 4) ;Lower number to reduce lag
                (set-goal gl-square-size__#014 5) ;Lower number to reduce lag
                (set-goal gl-number-of-non-far-side-lumber-camps__#014 3)
                (set-goal gl-enemy-fortification-modifier__#014 500)
                (set-goal gl-reniew-lumbercamp-bonus__#014 60)
                (set-goal gl-chosen-ressource__#014 wood)
            )
            
            (defrule
                (goal gl-chosen-ressource__#014 wood)
                (building-type-count-total lumber-camp < 3)
                =>
                (set-goal gl-home-distance-modifier__#014 50) ;Prioritise close lumber camps in the early game
            )

            (defrule
                (up-compare-goal gl-chosen-ressource__#014 != wood)
                =>
                (set-goal gl-home-distance-modifier__#014 500) ;Lower number to prioritise closer mining camps. ITS A DIVIDER * 100!!
                (set-goal gl-lerped-tiles-towards-enemy__#014 -6) ;Lower number to prioritise back mining camps
                (set-goal gl-maximal-found-points__#014 20)
                (set-goal gl-square-size__#014 6)
                (set-goal gl-enemy-fortification-modifier__#014 30) ; just a one time penalty. Will only chose res close to enemy when all other res has 2 dropsites
                (set-goal gl-close-dropsite-score-modifier__#014 25)
            )

            (defrule
                (up-compare-goal gl-build == Stone-mining-camp)
                =>
                (set-goal gl-chosen-ressource__#014 stone)
                (set-goal gl-build mining-camp)
            )

            (defrule
                (up-compare-goal gl-build == Gold-mining-camp)
                =>
                (set-goal gl-chosen-ressource__#014 gold)
                (set-goal gl-build mining-camp)
            )

            (defrule
                (up-compare-goal gl-build == Berry-mill)
                =>
                (set-goal gl-chosen-ressource__#014 food)
                (set-goal gl-build mill)
            )

            (defrule
                (or(up-compare-goal gl-chosen-ressource__#014 == gold)
                (up-compare-goal gl-chosen-ressource__#014 == stone))
                (building-type-count-total mining-camp < 2) ;Prioritise close mining camps in the early game
                =>
                (set-goal gl-home-distance-modifier__#014 50)
            )

            (defrule
                (up-compare-goal gl-chosen-ressource__#014 == food)
                (building-type-count-total mill < 1)
                =>
                (set-goal gl-home-distance-modifier__#014 50) ;Prioritise the first mill close to tc
            )

        ;Save enemy fortifications to a search group
            (defrule
                (true)
                =>
                (up-full-reset-search)
                (set-strategic-number sn-focus-player-number 1)
            )

            (defrule
                (players-stance focus-player enemy)
                =>
                (up-find-remote c: town-center c: 10)
                (up-find-remote c: castle c: 10)
                (up-find-remote c: watch-tower c: 10)
            )

            (defrule
                (up-compare-sn sn-focus-player-number < 8)
                =>
                (up-modify-sn sn-focus-player-number c:+ 1)
                (up-jump-rule -2)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-id gl-temp)
                (up-add-object-by-id search-local g: gl-temp)
                (up-remove-objects search-remote object-data-index == 0)
                (up-jump-rule -1)
            )

            (defrule
                (true)
                =>
                (up-reset-group c: enemy-fortification-group)
                (up-create-group 0 0 c: enemy-fortification-group)
            )
        ;Find up to 20 promising points to check placement of chosen dropsite

            (defrule
                (true)
                =>
                (set-goal gl-points-found__#014 0)
                (set-goal gl-distance-checked__#014 5)
                (set-goal gl-distance-checked-minus-1__#014 4)
                (up-modify-goal gl-max-distance-checked__#014 g:= gl-position-map-size-x)
                (up-modify-goal gl-max-distance-checked__#014 c:* 14)
                (up-modify-goal gl-max-distance-checked__#014 c:/ 10)
                (up-full-reset-search)
                (up-find-local c: lumber-camp c: 200)
                (up-find-local c: town-center c: 200)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: lumber-camp c: 200)
                (up-reset-filters)
            );flare

            (defrule ;loop start - finding ressources and reseting index goals for promising points.
                (true)
                =>
                (set-goal gl-points-checked__#014 0)
                (up-set-target-point gl-position-self-x)
                (up-reset-search 0 0 1 1)
                (up-filter-distance g: gl-distance-checked-minus-1__#014 g: gl-distance-checked__#014)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
                (set-goal gl-current-number-point-checked__#014 gl-promising-point-1-x__#014)
            )

            (defrule ;Also look for non-chopped trees when building lumber camp
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                =>
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
            ) 

            (defrule ;remove ressources close to already found points
                (up-compare-goal gl-points-checked__#014 g:< gl-points-found__#014)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-indirect-goal g: gl-current-number-point-checked__#014 gl-temp-x)
                (up-modify-goal gl-current-number-point-checked__#014 c:+ 1)
                (up-get-indirect-goal g: gl-current-number-point-checked__#014 gl-temp-y)
                (up-modify-goal gl-current-number-point-checked__#014 c:+ 1)
                (up-set-target-point gl-temp-x)
                (up-remove-objects search-remote object-data-distance < 10)
                (up-modify-goal gl-points-checked__#014 c:+ 1)
                (up-jump-rule -1)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-clean-search search-local object-data-distance search-order-asc)
            )

            (defrule ;Remove trees close to lumber camps
                (goal gl-chosen-ressource__#014 wood)
                (up-set-target-object search-remote c: 0)
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-distance < 5)
                =>
                (up-remove-objects search-remote object-data-index == 0)
                (up-jump-rule -2)
            )

            (defrule ;Create new point at found ressource
                (up-compare-goal gl-points-found__#014 g:< gl-maximal-found-points__#014)
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-get-object-data object-data-id gl-temp)
                
            )
            
            (defrule
                (up-compare-goal gl-points-found__#014 g:< gl-maximal-found-points__#014)
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                (up-set-target-object search-remote c: 0)
                (up-set-target-object search-local c: 0)
                ;(up-object-data object-data-distance < 5)
                =>
                (up-reset-search 0 0 1 1)
                (up-reset-filters)
                (up-filter-distance c: -1 c: 5)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-remove-objects search-remote object-data-distance <= 5)
                (up-get-search-state gl-local-total)
                (up-reset-search 0 0 1 1)
                (up-reset-filters)
                (up-add-object-by-id search-remote g: gl-temp)
            )

            (defrule ;Create new point at found ressource
                (up-compare-goal gl-points-found__#014 g:< gl-maximal-found-points__#014)
                (or(up-compare-goal gl-remote-total >= 15)
                (up-compare-goal gl-chosen-ressource__#014 != wood))
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-indirect-goal g: gl-current-number-point-checked__#014 g: gl-temp-x)
                (up-modify-goal gl-current-number-point-checked__#014 c:+ 1)
                (up-set-indirect-goal g: gl-current-number-point-checked__#014 g: gl-temp-y)
                (up-modify-goal gl-current-number-point-checked__#014 c:- 1)
                (up-modify-goal gl-points-found__#014 c:+ 1)
                (up-send-flare gl-temp-x)
                ;(up-chat-data-to-all "found %d trees at checkpoint" g: gl-remote-total)
                (up-jump-rule -6)
            )

            (defrule ;Do a new search with increased searching radius.
                (up-compare-goal gl-points-found__#014 g:< gl-maximal-found-points__#014)
                (up-compare-goal gl-distance-checked__#014 g:< gl-max-distance-checked__#014)
                (up-compare-goal gl-chosen-ressource__#014 != -1)
                =>
                (up-modify-goal gl-distance-checked__#014 c:+ 1)
                (up-modify-goal gl-distance-checked-minus-1__#014 c:+ 1)
                (up-jump-rule -9)
            )
            
        ;Extra setup before loop starts

            (defrule ;Save buildings for flank should be away from enemy flank
                (up-compare-goal gl-position == Flank)
                =>
                (up-get-point position-flank gl-estimated-enemy-x__#014)
                (up-lerp-tiles gl-estimated-enemy-x__#014 gl-position-center-x c: 10)
                (up-get-point position-self gl-home-x__#014)
            )

            (defrule ;Save buildings for pocket should be away from map center
                (up-compare-goal gl-position == Pocket)
                =>
                (up-get-point position-center gl-estimated-enemy-x__#014)
                (up-get-point position-self gl-home-x__#014)
            )

            (defrule ;Change preffered building spot depending on gl-lerped-tiles-towards-enemy__#014
                (up-compare-goal gl-lerped-tiles-towards-enemy__#014 != 0)
                =>
                (up-lerp-tiles gl-home-x__#014 gl-estimated-enemy-x__#014 g: gl-lerped-tiles-towards-enemy__#014)
            )

            (defrule ;Reset goals before loop
                (true)
                =>
                (set-goal gl-best-found-score__#014 -99999)
                (up-modify-goal gl-x-modifier__#014 g:= gl-square-size__#014)
                (up-modify-goal gl-x-modifier__#014 c:* -1)
                (up-modify-goal gl-y-modifier__#014 g:= gl-square-size__#014)
                (up-modify-goal gl-y-modifier__#014 c:* -1)
                (up-modify-goal gl-current-number-point-checked__#014 c:= gl-promising-point-1-x__#014)
                (set-goal gl-point-index-number__#014 1)
            )

            (defrule
                (up-compare-goal gl-build == lumber-camp)
                =>
                (up-modify-goal gl-temp g:= gl-script-time__#051)
                (up-get-precise-time gl-script-start-time__#051 gl-script-time__#051)
                (up-modify-goal gl-temp g:- gl-script-time__#051)
                (up-modify-goal gl-temp1 g:neg gl-temp)
                (up-modify-goal gl-temp g:max gl-temp1)
                (up-chat-data-to-all "Lumber camp pre loop setup took: %d ms" g: gl-temp)
            )
 
        ;Big loop choses a new area to test for building dropsites

            (defrule ;Reset temp goals each time big loops reset
                (true)
                =>
                (up-get-rule-id gl-big-loop-start__#014) ;guide square loops back to this rule
                (up-get-indirect-goal g: gl-current-number-point-checked__#014 gl-current-point-x__#014)
                (up-modify-goal gl-current-number-point-checked__#014 c:+ 1)
                (up-get-indirect-goal g: gl-current-number-point-checked__#014 gl-current-point-y__#014)
                (up-modify-goal gl-current-number-point-checked__#014 c:+ 1)
            )

            (defrule ;Reset temp goals each time square loops reset
                (true)
                =>
                (up-get-rule-id gl-small-loop-start__#014) ;guide square loops back to this rule
                (up-copy-point gl-checked-tile-x__#014 gl-current-point-x__#014) ;square around tc
                (up-modify-goal gl-checked-tile-x__#014 g:+ gl-x-modifier__#014) ;find new checking tile
                (up-modify-goal gl-checked-tile-y__#014 g:+ gl-y-modifier__#014)
                (up-bound-precise-point gl-checked-tile-x__#014 0 c: 0) ;we dont wanna test point outside map
                (set-goal gl-can-build-in-point__#014 No)
            )

        ;Try another point if current point has a res tile on it
            
            (defrule
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                =>
                (up-copy-point gl-camp-checking-1-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-camp-checking-1-x__#014 c:- 1)
                (up-copy-point gl-camp-checking-2-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-camp-checking-2-x__#014 c:- 1)
                (up-modify-goal gl-camp-checking-2-y__#014 c:- 1)
                (up-copy-point gl-camp-checking-3-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-camp-checking-3-y__#014 c:- 1)
            )

            (defrule
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                (or(up-point-contains gl-checked-tile-x__#014 c: tree-class)
                (or(up-point-contains gl-camp-checking-1-x__#014 c: tree-class)
                (or(up-point-contains gl-camp-checking-2-x__#014 c: tree-class)
                (up-point-contains gl-camp-checking-3-x__#014 c: tree-class))))
                (up-compare-goal gl-x-modifier__#014 g:< gl-square-size__#014) ;x-coordinate not at maximum yet
                (up-compare-goal gl-build != -1) ;turn off loop when not used to avoid lag
                =>
                (up-modify-goal gl-x-modifier__#014 c:+ 1) ;change x coordinate
                (up-jump-direct g: gl-small-loop-start__#014) ;reset small square loop
            )


            (defrule ;Reset small loop if building cannot be build in point changing y coordinate
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                (or(up-point-contains gl-checked-tile-x__#014 c: tree-class)
                (or(up-point-contains gl-camp-checking-1-x__#014 c: tree-class)
                (or(up-point-contains gl-camp-checking-2-x__#014 c: tree-class)
                (up-point-contains gl-camp-checking-3-x__#014 c: tree-class))))
                (up-compare-goal gl-x-modifier__#014 g:>= gl-square-size__#014) ;x-coordinate at maximum
                (up-compare-goal gl-y-modifier__#014 g:< gl-square-size__#014) ;y-coordinate not at maximum yet
                (up-compare-goal gl-build != -1) ;turn off loop when not used to avoid lag
                =>
                (up-modify-goal gl-x-modifier__#014 g:= gl-square-size__#014) ;reset x coordinate
                (up-modify-goal gl-x-modifier__#014 c:* -1) ;reset x coordinate
                (up-modify-goal gl-y-modifier__#014 c:+ 1) ;change y coordinate
                (up-jump-direct g: gl-small-loop-start__#014) ;reset small square loop
            )

        ;Small loop checks for every tile in the area if the dropsite can be build

            (defrule ;Allow lumber camps to be build if building can be placed in point
                ;(or(up-compare-goal gl-chosen-ressource__#014 == wood)
                ;(up-compare-goal gl-chosen-ressource__#014 == food))
                (up-compare-goal gl-chosen-ressource__#014 != -1)
                (up-can-build-line 0 gl-checked-tile-x__#014 g: gl-build)
                =>
                (set-goal gl-can-build-in-point__#014 Yes)
            )

            (defrule
                (up-compare-goal gl-chosen-ressource__#014 != wood)
                (up-compare-goal gl-chosen-ressource__#014 != food)
                =>
                (up-copy-point gl-camp-checking-1-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-camp-checking-1-x__#014 c:+ 1)
                (up-modify-goal gl-camp-checking-1-y__#014 c:+ 1)
                (up-copy-point gl-camp-checking-2-x__#014 gl-camp-checking-1-x__#014)
                (up-modify-goal gl-camp-checking-2-x__#014 c:- 2)
                (up-copy-point gl-camp-checking-3-x__#014 gl-camp-checking-2-x__#014)
                (up-modify-goal gl-camp-checking-3-y__#014 c:- 2)
                (up-copy-point gl-camp-checking-4-x__#014 gl-camp-checking-3-x__#014)
                (up-modify-goal gl-camp-checking-4-x__#014 c:+ 2)
            )

            (defrule ;Allow other drop sites to be build if building can be placed in point and has a 1 tile gap around it
                (up-compare-goal gl-chosen-ressource__#014 != wood)
                (up-compare-goal gl-chosen-ressource__#014 != food)
                (not(true))
                ;(up-can-build-line 0 gl-checked-tile-x__#014 g: gl-build)
                ;(up-can-build-line 0 gl-camp-checking-1-x__#014 g: gl-build)
                ;(up-can-build-line 0 gl-camp-checking-2-x__#014 g: gl-build)
                ;(up-can-build-line 0 gl-camp-checking-3-x__#014 g: gl-build)
                ;(up-can-build-line 0 gl-camp-checking-4-x__#014 g: gl-build)
                =>
                (set-goal gl-can-build-in-point__#014 Yes)
            )

            (defrule ;Reset small loop if building cannot be build in point changing x coordinate
                (goal gl-can-build-in-point__#014 No)
                (up-compare-goal gl-x-modifier__#014 g:< gl-square-size__#014) ;x-coordinate not at maximum yet
                (up-compare-goal gl-build != -1) ;turn off loop when not used to avoid lag
                =>
                (up-modify-goal gl-x-modifier__#014 c:+ 1) ;change x coordinate
                (up-jump-direct g: gl-small-loop-start__#014) ;reset small square loop
            )

            (defrule ;Reset small loop if building cannot be build in point changing y coordinate
                (goal gl-can-build-in-point__#014 No)
                (up-compare-goal gl-x-modifier__#014 g:>= gl-square-size__#014) ;x-coordinate at maximum
                (up-compare-goal gl-y-modifier__#014 g:< gl-square-size__#014) ;y-coordinate not at maximum yet
                (up-compare-goal gl-build != -1) ;turn off loop when not used to avoid lag
                =>
                (up-modify-goal gl-x-modifier__#014 g:= gl-square-size__#014) ;reset x coordinate
                (up-modify-goal gl-x-modifier__#014 c:* -1) ;reset x coordinate
                (up-modify-goal gl-y-modifier__#014 c:+ 1) ;change y coordinate
                (up-jump-direct g: gl-small-loop-start__#014) ;reset small square loop
            )

        ;Dropsite score setup

            (defrule ;Reset different score variables and calculate score based on distance to home tc.
                (true)
                =>
                (set-goal gl-combined-score__#014 0)
                (set-goal gl-ressource-score__#014 0)
                (set-goal gl-close-dropsite-score__#014 0)
                (set-goal gl-close-other-ressource-score__#014 0)
                (set-goal gl-lumber-camp-on-far-side-score__#014 0)
                (up-get-point-distance gl-checked-tile-x__#014 gl-home-x__#014 gl-home-distance-score__#014)
                (up-modify-goal gl-home-distance-score__#014 c:* 100)
                (up-modify-goal gl-home-distance-score__#014 g:/ gl-home-distance-modifier__#014)
            )

        ;Finding lumber camp score variables

            (defrule ;Give 1 point for each close tree
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-filter-distance c: -1 c: 5)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 40)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-ressource-score__#014 g:= gl-remote-total)
            )

            (defrule ;Give 0,28 point for each semi-close tree
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-filter-distance c: 5 c: 7)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 40)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-remote-total c:* 2)
                (up-modify-goal gl-remote-total c:/ 7)
                (up-modify-goal gl-ressource-score__#014 g:+ gl-remote-total)
            )

            
            (defrule ;Make sure lumber camps have at least one tile of seperation to tc's or other lumber camps
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                =>
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 2)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-local c: lumber-camp c: 200)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: lumber-camp c: 200)
                (up-reset-filters)
                (up-filter-distance c: -1 c: 4)
                (up-find-local c: town-center c: 200) ;Also include tc's
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: town-center-foundation c: 200)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-local-total c:* 99999)
                (up-modify-goal gl-close-dropsite-score__#014 g:+ gl-local-total)
            )

            (defrule ;Give a 30 score penalty for lumber camps seperated by 3 tiles or less 
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                =>
                (up-full-reset-search)
                (up-filter-distance c: 2 c: 4)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-local c: lumber-camp c: 200)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: lumber-camp c: 200)
                (up-reset-filters)
                (up-filter-distance c: 4 c: 6)
                (up-find-local c: town-center c: 200) ;Also include tc's
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: town-center-foundation c: 200)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-local-total c:* 30)
                (up-modify-goal gl-close-dropsite-score__#014 g:+ gl-local-total)
            )

            (defrule ;Give a 15 score penalty for lumber camps seperated by 8 tiles or less 
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                =>
                (up-full-reset-search)
                (up-filter-distance c: 4 c: 10)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-local c: lumber-camp c: 200)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: lumber-camp c: 200)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-local-total c:* 5)
                (up-modify-goal gl-close-dropsite-score__#014 g:+ gl-local-total)
            )

            (defrule ;Checks if lumber camp is build on the far side of a forrest
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                (building-type-count-total lumber-camp < 2)
                =>
                (up-full-reset-search)
                (up-copy-point gl-temp-x gl-checked-tile-x__#014)
                (up-lerp-tiles gl-temp-x gl-position-self-x c: -3)
                (up-set-target-point gl-temp-x)
                (up-filter-distance c: -1 c: 4)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 40)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-temp g:= gl-remote-total)
                (up-reset-search 1 1 1 1)
                (up-copy-point gl-temp-x gl-checked-tile-x__#014)
                (up-lerp-tiles gl-temp-x gl-position-self-x c: 3)
                (up-set-target-point gl-temp-x)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 40)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-temp g:- gl-remote-total)
            )

            (defrule ;Give a 50 point penalty for lumber camps on the far side of the forrest for the first
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                (building-type-count-total lumber-camp g:< gl-number-of-non-far-side-lumber-camps__#014)
                (up-compare-goal gl-temp < 2)
                =>
                (up-modify-goal gl-lumber-camp-on-far-side-score__#014 c:+ 50)
            )

            (defrule ;Give a 30 point penalty for lumber camps to close to other ressources. (May not do anything)
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                =>
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 3)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: food c: 40)
                (up-find-resource c: gold c: 40)
                (up-find-resource c: stone c: 40)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-remote-total c:* 30)
                (up-modify-goal gl-close-other-ressource-score__#014 g:+ gl-remote-total)
            )

            (defrule ;Give a 30 point penalty for lumber camps to close to other ressources. (May not do anything)
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                (building-type-count-total lumber-camp >= 3)
                =>
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 4)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-local c: villager-class c: 25)
                (up-remove-objects search-local object-data-group-flag != wood-group)
                (up-modify-sn sn-focus-player-number c:= my-player-number)
                (up-filter-distance c: -1 c: 3)
                (up-find-remote c: lumber-camp c: 1)
                (up-filter-distance c: -1 c: 4)
                (up-find-remote c: town-center c: 1)
                (up-get-search-state gl-local-total)
                (set-goal gl-busy-lumbercamp -1)
            )

            (defrule ;Give a 30 point penalty for lumber camps to close to other ressources. (May not do anything)
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                (up-compare-goal gl-local-total >= 5)
                (up-compare-goal gl-remote-total < 1)
                (building-type-count-total lumber-camp >= 3)
                =>
                (set-goal gl-busy-lumbercamp YES)
            )


        ;Finding score variables for other dropsites

            (defrule ;Awards 10 points of score for each ressource withing 3 tiles. 
                     ;Includes 4 searches to account for the camp being a 4 tile building.
                (up-compare-goal gl-chosen-ressource__#014 != wood)
                =>
                (up-full-reset-search)
                (up-filter-status c: status-resource c: list-active)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-filter-distance c: -1 c: 3)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
                (up-clean-search search-remote object-data-precise-distance search-order-asc)
                (set-goal gl-temp 999)
                (set-goal gl-closest-precise-stone-gold__#014 999)
            )


            (defrule
                (up-set-target-object search-remote c: 0)
                (or(up-compare-goal gl-chosen-ressource__#014 == stone)
                (up-compare-goal gl-chosen-ressource__#014 == gold))
                =>
                (up-get-object-data object-data-precise-x gl-temp-x)
                (up-get-object-data object-data-precise-y gl-temp-y)
                (up-copy-point gl-precise-lerped-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-precise-lerped-x__#014 c:* 100)
                (up-modify-goal gl-precise-lerped-y__#014 c:* 100)
                (up-modify-goal gl-precise-lerped-x__#014 c:+ 25)
                (up-modify-goal gl-precise-lerped-y__#014 c:+ 50)
                (up-get-point-distance gl-precise-lerped-x__#014 gl-temp-x gl-temp)
                ;(up-chat-data-to-all "distance found: %d" g: gl-temp)
                (up-modify-goal gl-closest-precise-stone-gold__#014 g:min gl-temp)
            )
            (defrule ;Awards 10 points of score for each ressource withing 3 tiles. 
                     ;Includes 4 searches to account for the camp being a 4 tile building.
                (up-compare-goal gl-chosen-ressource__#014 != wood)
                =>
                (up-modify-goal gl-checked-tile-x__#014 c:- 1)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
                (up-clean-search search-remote -1 search-order-asc)
                (up-clean-search search-remote object-data-precise-distance search-order-asc)
            )


            (defrule
                (up-set-target-object search-remote c: 0)
                (or(up-compare-goal gl-chosen-ressource__#014 == stone)
                (up-compare-goal gl-chosen-ressource__#014 == gold))
                =>
                (up-get-object-data object-data-precise-x gl-temp-x)
                (up-get-object-data object-data-precise-y gl-temp-y)
                (up-copy-point gl-precise-lerped-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-precise-lerped-x__#014 c:* 100)
                (up-modify-goal gl-precise-lerped-y__#014 c:* 100)
                (up-modify-goal gl-precise-lerped-x__#014 c:+ 25)
                (up-modify-goal gl-precise-lerped-y__#014 c:+ 50)
                (up-get-point-distance gl-precise-lerped-x__#014 gl-temp-x gl-temp)
                (up-modify-goal gl-closest-precise-stone-gold__#014 g:min gl-temp)
            )
            (defrule ;Awards 10 points of score for each ressource withing 3 tiles. 
                     ;Includes 4 searches to account for the camp being a 4 tile building.
                (up-compare-goal gl-chosen-ressource__#014 != wood)
                =>
                (up-modify-goal gl-checked-tile-y__#014 c:- 1)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
                (up-clean-search search-remote -1 search-order-asc)
                (up-clean-search search-remote object-data-precise-distance search-order-asc)
            )


            (defrule
                (up-set-target-object search-remote c: 0)
                (or(up-compare-goal gl-chosen-ressource__#014 == stone)
                (up-compare-goal gl-chosen-ressource__#014 == gold))
                =>
                (up-get-object-data object-data-precise-x gl-temp-x)
                (up-get-object-data object-data-precise-y gl-temp-y)
                (up-copy-point gl-precise-lerped-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-precise-lerped-x__#014 c:* 100)
                (up-modify-goal gl-precise-lerped-y__#014 c:* 100)
                (up-modify-goal gl-precise-lerped-x__#014 c:+ 25)
                (up-modify-goal gl-precise-lerped-y__#014 c:+ 50)
                (up-get-point-distance gl-precise-lerped-x__#014 gl-temp-x gl-temp)
                (up-modify-goal gl-closest-precise-stone-gold__#014 g:min gl-temp)
            )
            (defrule ;Awards 10 points of score for each ressource withing 3 tiles. 
                     ;Includes 4 searches to account for the camp being a 4 tile building.
                (up-compare-goal gl-chosen-ressource__#014 != wood)
                =>
                (up-modify-goal gl-checked-tile-x__#014 c:+ 1)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
                (up-clean-search search-remote -1 search-order-asc)
                (up-clean-search search-remote object-data-precise-distance search-order-asc)
            )


            (defrule
                (up-set-target-object search-remote c: 0)
                (or(up-compare-goal gl-chosen-ressource__#014 == stone)
                (up-compare-goal gl-chosen-ressource__#014 == gold))
                =>
                (up-get-object-data object-data-precise-x gl-temp-x)
                (up-get-object-data object-data-precise-y gl-temp-y)
                (up-copy-point gl-precise-lerped-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-precise-lerped-x__#014 c:* 100)
                (up-modify-goal gl-precise-lerped-y__#014 c:* 100)
                (up-modify-goal gl-precise-lerped-x__#014 c:+ 25)
                (up-modify-goal gl-precise-lerped-y__#014 c:+ 50)
                (up-get-point-distance gl-precise-lerped-x__#014 gl-temp-x gl-temp)
                (up-modify-goal gl-closest-precise-stone-gold__#014 g:min gl-temp)
            )

            (defrule
                (up-compare-goal gl-chosen-ressource__#014 != wood)
                =>
                (up-modify-goal gl-checked-tile-y__#014 c:+ 1)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-remote-total c:* 10)
                (up-modify-goal gl-ressource-score__#014 g:+ gl-remote-total)
                (up-full-reset-search)
                (up-filter-status c: status-resource c: list-active)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-filter-distance c: 3 c: 4)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
                (up-modify-goal gl-checked-tile-x__#014 c:- 1)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
            )

            (defrule ;Awards 4 points of score for each ressource withing 4 tiles. 
                (up-compare-goal gl-chosen-ressource__#014 != wood)
                =>
                (up-modify-goal gl-checked-tile-y__#014 c:- 1)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
                (up-modify-goal gl-checked-tile-x__#014 c:+ 1)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-resource g: gl-chosen-ressource__#014 c: 40)
                (up-modify-goal gl-checked-tile-y__#014 c:+ 1)
                (up-clean-search search-remote -1 search-order-asc)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-remote-total c:* 4)
                (up-modify-goal gl-ressource-score__#014 g:+ gl-remote-total)
            )

            (defrule ;Make sure non-lumber-camp dropsites are seperated by at least 2-3 tiles
                (up-compare-goal gl-chosen-ressource__#014 != wood)
                (up-compare-goal gl-chosen-ressource__#014 != -1)
                =>
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 3)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-local g: gl-build c: 200)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local g: gl-build c: 200)
                (up-reset-filters)
                (up-filter-distance c: -1 c: 5)
                (up-find-local c: town-center c: 200)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: town-center-foundation c: 200)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-local-total c:* 99999)
                (up-modify-goal gl-close-dropsite-score__#014 g:+ gl-local-total)
            )

            (defrule ;Give a 30 point penalty for dropsites build at the same ressource pile.
                (up-compare-goal gl-chosen-ressource__#014 != wood)
                (up-compare-goal gl-chosen-ressource__#014 != -1)
                =>
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 10)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-local g: gl-build c: 200)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local g: gl-build c: 200)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-semi-close-dropsites__#014 g:= gl-local-total)
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 5)
                (up-set-target-point gl-checked-tile-x__#014)
                (up-find-local g: gl-build c: 200)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local g: gl-build c: 200)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-close-dropsites__#014 g:= gl-local-total)
                (up-modify-goal gl-semi-close-dropsites__#014 c:* 3)
                (up-modify-goal gl-semi-close-dropsites__#014 g:+ gl-close-dropsites__#014)
                (up-modify-goal gl-semi-close-dropsites__#014 g:+ gl-close-dropsites__#014)
                (up-modify-goal gl-semi-close-dropsites__#014 g:* gl-close-dropsite-score-modifier__#014)
                (up-modify-goal gl-semi-close-dropsites__#014 c:/ 5)
                (up-modify-goal gl-close-dropsite-score__#014 g:+ gl-semi-close-dropsites__#014)
            )
        
        ;Skip stone/gold mines to close to their res
            (defrule ;Reset small loop changing the x coordinate
                (or(up-compare-goal gl-chosen-ressource__#014 == stone)
                (up-compare-goal gl-chosen-ressource__#014 == gold))
                (up-compare-goal gl-x-modifier__#014 g:< gl-square-size__#014) ;x-coordinate not at maximum yet
                (up-compare-goal gl-build != -1) ;turn off loop when not used to avoid lag
                (up-compare-goal gl-closest-precise-stone-gold__#014 < 200)
                =>
                (up-modify-goal gl-x-modifier__#014 c:+ 1) ;change x coordinate
                (up-jump-direct g: gl-small-loop-start__#014) ;reset small square loop
            )

            (defrule ;Reset small loop changing the y coordinate
                (or(up-compare-goal gl-chosen-ressource__#014 == stone)
                (up-compare-goal gl-chosen-ressource__#014 == gold))
                (up-compare-goal gl-x-modifier__#014 g:>= gl-square-size__#014) ;x-coordinate at maximum
                (up-compare-goal gl-y-modifier__#014 g:< gl-square-size__#014) ;y-coordinate not at maximum yet
                (up-compare-goal gl-build != -1) ;turn off loop when not used to avoid lag
                (up-compare-goal gl-closest-precise-stone-gold__#014 < 200)
                =>
                (up-modify-goal gl-x-modifier__#014 g:= gl-square-size__#014) ;reset x coordinate
                (up-modify-goal gl-x-modifier__#014 c:* -1) ;reset x coordinate
                (up-modify-goal gl-y-modifier__#014 c:+ 1) ;change y coordinate
                (up-jump-direct g: gl-small-loop-start__#014) ;reset small square loop
            )
        ;Check for nearby enemy fortifications
            (defrule
                (true)
                =>
                (up-set-target-point gl-checked-tile-x__#014)
                (up-full-reset-search)
                (set-goal gl-closest-enemy-fortification-distance__#014 100)
                (up-modify-goal gl-enemy-fortification-score__#014 c:= 0)
                (up-set-group search-remote c: enemy-fortification-group)
                (up-clean-search search-remote object-data-distance search-order-asc)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-distance gl-closest-enemy-fortification-distance__#014)
            )

            (defrule
                (up-compare-goal gl-closest-enemy-fortification-distance__#014 >= 15)
                (up-compare-goal gl-closest-enemy-fortification-distance__#014 <= 35)
                =>
                (up-modify-goal gl-enemy-fortification-score__#014 c:= 35)
                (up-modify-goal gl-enemy-fortification-score__#014 g:- gl-closest-enemy-fortification-distance__#014)
                (up-modify-goal gl-enemy-fortification-score__#014 g:+ gl-enemy-fortification-modifier__#014)
            )
        ;Find the tile with the best score

            (defrule ;Add all the different score variables together.
                (true)
                =>
                (up-modify-goal gl-combined-score__#014 g:+ gl-ressource-score__#014)
                (up-modify-goal gl-combined-score__#014 g:- gl-close-dropsite-score__#014)
                (up-modify-goal gl-combined-score__#014 g:- gl-home-distance-score__#014)
                (up-modify-goal gl-combined-score__#014 g:- gl-close-other-ressource-score__#014)
                (up-modify-goal gl-combined-score__#014 g:- gl-lumber-camp-on-far-side-score__#014)
                (up-modify-goal gl-combined-score__#014 g:- gl-enemy-fortification-score__#014)
            )

            (defrule
                (up-compare-goal gl-chosen-ressource__#014 == wood)
                (goal gl-busy-lumbercamp YES)
                (building-type-count-total lumber-camp >= 3)
                =>
                (up-modify-goal gl-combined-score__#014 g:+ gl-reniew-lumbercamp-bonus__#014)
            )

            (defrule
                (up-compare-goal gl-ressource-score__#014 >= 4) ;Require a minimal amount of ressources at the point
                (up-compare-goal gl-combined-score__#014 g:> gl-best-found-score__#014) ;new found score better than best found score this loop
                (goal gl-can-build-in-point__#014 Yes)
                (up-compare-goal gl-closest-enemy-fortification-distance__#014 >= 15)
                =>
                (up-copy-point gl-surround-1-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-1-x__#014 c:+ 1)
                (up-modify-goal gl-surround-1-y__#014 c:+ 1)
                (up-copy-point gl-surround-2-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-2-y__#014 c:+ 1)
                (up-copy-point gl-surround-3-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-3-y__#014 c:+ 1)
                (up-modify-goal gl-surround-3-x__#014 c:- 1)
                (up-copy-point gl-surround-4-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-4-y__#014 c:+ 1)
                (up-modify-goal gl-surround-4-x__#014 c:- 2)
                (up-copy-point gl-surround-5-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-5-x__#014 c:- 2)
                (up-copy-point gl-surround-6-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-6-x__#014 c:- 2)
                (up-modify-goal gl-surround-6-y__#014 c:- 1)
            )
            (defrule
                (up-compare-goal gl-ressource-score__#014 >= 4) ;Require a minimal amount of ressources at the point
                (up-compare-goal gl-combined-score__#014 g:> gl-best-found-score__#014) ;new found score better than best found score this loop
                (goal gl-can-build-in-point__#014 Yes)
                (up-compare-goal gl-closest-enemy-fortification-distance__#014 >= 15)
                =>
                (up-copy-point gl-surround-7-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-7-x__#014 c:- 2)
                (up-modify-goal gl-surround-7-y__#014 c:- 2)
                (up-copy-point gl-surround-8-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-8-y__#014 c:- 2)
                (up-modify-goal gl-surround-8-x__#014 c:- 1)
                (up-copy-point gl-surround-9-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-9-y__#014 c:- 2)
                (up-copy-point gl-surround-10-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-10-y__#014 c:- 2)
                (up-modify-goal gl-surround-10-x__#014 c:+ 1)
                (up-copy-point gl-surround-11-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-11-y__#014 c:- 1)
                (up-modify-goal gl-surround-11-x__#014 c:+ 1)
                (up-copy-point gl-surround-12-x__#014 gl-checked-tile-x__#014)
                (up-modify-goal gl-surround-12-x__#014 c:+ 1)
                (set-goal gl-free-tiles 12)
                (set-goal gl-current-goal-constant gl-surround-1-x__#014)
                (up-modify-goal gl-max-goal-constant c:= gl-surround-1-x__#014)
                (up-modify-goal gl-max-goal-constant c:+ 22)
            )

            (defrule
                (up-compare-goal gl-ressource-score__#014 >= 4) ;Require a minimal amount of ressources at the point
                (up-compare-goal gl-combined-score__#014 g:> gl-best-found-score__#014) ;new found score better than best found score this loop
                (goal gl-can-build-in-point__#014 Yes)
                (up-compare-goal gl-closest-enemy-fortification-distance__#014 >= 15)
                =>
                (up-get-indirect-goal g: gl-current-goal-constant gl-current-suround-x)
                (up-modify-goal gl-current-goal-constant c:+ 1)
                (up-get-indirect-goal g: gl-current-goal-constant gl-current-suround-y)
            )

            (defrule
                (up-compare-goal gl-ressource-score__#014 >= 4) ;Require a minimal amount of ressources at the point
                (up-compare-goal gl-combined-score__#014 g:> gl-best-found-score__#014) ;new found score better than best found score this loop
                (goal gl-can-build-in-point__#014 Yes)
                (up-compare-goal gl-closest-enemy-fortification-distance__#014 >= 15)
                (up-point-contains gl-current-suround-x c: tree-class)
                =>
                (up-modify-goal gl-free-tiles c:- 1)
            )

            (defrule
                (up-compare-goal gl-ressource-score__#014 >= 4) ;Require a minimal amount of ressources at the point
                (up-compare-goal gl-combined-score__#014 g:> gl-best-found-score__#014) ;new found score better than best found score this loop
                (goal gl-can-build-in-point__#014 Yes)
                (up-compare-goal gl-closest-enemy-fortification-distance__#014 >= 15)
                (up-compare-goal gl-current-goal-constant g:< gl-max-goal-constant)
                =>
                (up-modify-goal gl-current-goal-constant c:+ 1)
                (up-jump-rule -3)
            )

            (defrule ;Replace best found point if a better has been found.
                (up-compare-goal gl-ressource-score__#014 >= 4) ;Require a minimal amount of ressources at the point
                (up-compare-goal gl-combined-score__#014 g:> gl-best-found-score__#014) ;new found score better than best found score this loop
                (goal gl-can-build-in-point__#014 Yes)
                (up-compare-goal gl-closest-enemy-fortification-distance__#014 >= 15)
                (up-compare-goal gl-free-tiles >= 4)
                =>
                (up-modify-goal gl-best-found-score__#014 g:= gl-combined-score__#014) ;replace best score
                (up-copy-point gl-best-fount-point-x__#014 gl-checked-tile-x__#014) ;replace best point
                ;(up-chat-data-to-all "gl-free-tiles: %d" g: gl-free-tiles)
                ;(up-chat-data-to-all "gl-closest-precise-stone-gold__#014: %d" g: gl-closest-precise-stone-gold__#014)
                ;(up-chat-data-to-all "gl-ressource-score__#014 %d" g: gl-ressource-score__#014)
