            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-target == building-class)
            )

        ;Reset other goals before loop

            (defrule ;give a low value to make sure a point is chosen later
                (true)
                =>
                (set-goal gl-best-found-score__#016 -99999)
            )

            (defrule ;Reset goals used in the loops.
                (true)
                =>
                (up-modify-goal gl-x-modifier__#016 g:= gl-square-size__#016)
                (up-modify-goal gl-x-modifier__#016 c:* -1)
                (up-modify-goal gl-y-modifier__#016 g:= gl-square-size__#016)
                (up-modify-goal gl-y-modifier__#016 c:* -1)
            )

        ;Reset goals
            (defrule ;Reset temp goals each time square loops reset
                (true)
                =>
                (up-get-rule-id gl-loop-start__#016) ;guide square loops back to this rule
            )

            (defrule ;Reset temp goals each time square loops reset
                (true)
                =>
                (up-copy-point gl-checked-tile-x__#016 gl-building-center-x__#016) ;square around tc
                (up-modify-goal gl-checked-tile-x__#016 g:+ gl-x-modifier__#016) ;find new checking tile
                (up-modify-goal gl-checked-tile-y__#016 g:+ gl-y-modifier__#016)
                (up-bound-precise-point gl-checked-tile-x__#016 0 c: 6) ;we dont wanna test point outside map
                (set-goal gl-temp -1)
                (up-modify-goal gl-loop-modifier-size__#016 g:= gl-inner-square-modifier__#016)
            )

            (defrule
                (true)
                =>
                (generate-random-number 3)
                (up-get-fact random-number 0 gl-temp)
                (up-modify-goal gl-loop-modifier-size__#016 g:= gl-temp)
            )
        ;Check if a building can be be build
            (defrule
                (not(up-can-build-line 0 gl-checked-tile-x__#016 g: gl-build))
