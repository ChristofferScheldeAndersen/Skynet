    ;stage
        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: town-center c: 1)
        )

        (defrule
            (up-research-status c: feudal-age == research-pending)
            (up-set-target-object search-local c: 0)
            (up-object-data object-data-progress-value >= 25)
            =>
            (set-goal gl-stage 1)
            (disable-self)
        )

        (defrule
            (building-type-count-total watch-tower-line > 1)
            =>
            (set-goal gl-stage 2)
            (disable-self)
        )
        (defrule
            (building-type-count-total watch-tower-line > 5)
            =>
            (set-goal gl-stage 3)
            (disable-self)
        )
    ;town center
        (defrule
            (unit-type-count-total villager >= 17)
            =>
            (research ri-loom)
            (research feudal-age)
            (research castle-age)
        )

        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: town-center c: 1)
