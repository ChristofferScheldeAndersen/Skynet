            )
            
            (defrule
                (or(up-point-distance gl-town-center-1-x__#016 gl-checked-tile-x__#016 g:< gl-town-center-farming-radius__#016)
                (or(up-point-distance gl-town-center-2-x__#016 gl-checked-tile-x__#016 g:< gl-town-center-farming-radius__#016)
                (or(up-point-distance gl-town-center-3-x__#016 gl-checked-tile-x__#016 g:< gl-town-center-farming-radius__#016)
                (or(up-point-distance gl-town-center-4-x__#016 gl-checked-tile-x__#016 g:< gl-town-center-farming-radius__#016)
                (up-point-distance gl-town-center-5-x__#016 gl-checked-tile-x__#016 g:< gl-town-center-farming-radius__#016)))))
                =>
                (set-goal gl-temp 1)
            )

            (defrule
                (or(up-point-distance gl-mill-1-x__#016 gl-checked-tile-x__#016 g:< gl-mill-farming-radius__#016)
                (or(up-point-distance gl-mill-2-x__#016 gl-checked-tile-x__#016 g:< gl-mill-farming-radius__#016)
                (or(up-point-distance gl-mill-3-x__#016 gl-checked-tile-x__#016 g:< gl-mill-farming-radius__#016)
