            )

            (defrule
            (up-set-target-by-id g: gl-gaia-id-checker--ss8)
            (or(up-object-data object-data-class == 909)
            (up-object-data object-data-class == 910))
            (up-object-data object-data-carry > 0)
            (up-object-data object-data-hitpoints > 0)
            =>
            (up-get-object-data object-data-id gl-temp)
            )

            (defrule
            (up-compare-goal gl-gaia-id-checker--ss8 < 20000)
