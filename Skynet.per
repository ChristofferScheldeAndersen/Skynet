        ;Setup for counting animals

            (defrule
                (true)
                =>
                (set-goal gl-sheep-counter__#052 0)
                (set-goal gl-cow-counter__#052 0)
                (set-goal gl-boar-counter__#052 0)
                (set-goal gl-deer-counter__#052 0)
                (set-goal gl-chicken-counter__#052 0)
                (disable-self)
            )

        ;Sheep counter

            (defrule
                (true)
                =>
                (set-goal gl-new-sheep-found__#052 -1)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 40)
                (up-find-local c: livestock-class c: 240)
                (up-remove-objects search-local object-data-group-flag > -2)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-local-total > 0)
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-carry <= 100)
                =>
                (up-modify-goal gl-sheep-counter__#052 c:+ 1)
                (up-chat-data-to-all "Found %d sheep (counter)" g: gl-sheep-counter__#052)
            )

            (defrule
                (up-compare-goal gl-local-total > 0)
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-carry > 120)
                =>
                (up-modify-goal gl-cow-counter__#052 c:+ 1)
                (up-chat-data-to-all "Found %d cows (counter)" g: gl-cow-counter__#052)
            )

            (defrule
                (up-compare-goal gl-local-total == 1)
                (up-compare-goal gl-sheep-counter__#052 < 8)
                (up-compare-goal gl-sheep-counter__#052 != 4)
                (up-compare-goal gl-sheep-counter__#052 != 6)
                (game-time > 1)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-id gl-new-sheep-found__#052)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-id gl-temp)
                (up-full-reset-search)
                (up-set-group search-local c: scouted-animal-group)
                (up-add-object-by-id search-local g: gl-temp)
                (up-reset-group c: scouted-animal-group)
                (up-modify-group-flag 0 c: scouted-animal-group)
                (up-create-group 0 0 c: scouted-animal-group)
                (up-modify-group-flag 1 c: scouted-animal-group)
            )

            (defrule
                (up-compare-goal gl-local-total > 0)
                =>
                (up-jump-rule -6)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-group search-local c: scouted-animal-group)
                (up-remove-objects search-local object-data-class != livestock-class)
                (up-get-search-state gl-local-total)
                ;(up-chat-data-to-all "We have %d sheep id's in animal search-group" g: gl-local-total)
            )
            

        ;Boar counter

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 40)
                (set-strategic-number sn-focus-player-number 0)
                (up-find-remote c: 910 c: 40)
                (up-modify-goal gl-gaia-id-checker--ss8 g:= gl-first-gaia-id__#052)
                (set-goal gl-temp-x -1)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-id gl-temp)
                (up-add-object-by-id search-local g: gl-temp)
                (up-remove-objects search-remote object-data-index == 0)
                (up-jump-rule -1)
            )

            (defrule
                (up-set-target-by-id g: gl-gaia-id-checker--ss8)
                (up-object-data object-data-class == 910)
                (up-object-data object-data-carry > 0)
                (up-object-data object-data-hitpoints > 0)
                (up-object-data object-data-distance < 40)
                =>
                (set-goal gl-temp-x -1)
                (up-get-point position-object gl-temp-x)
            )

                (defrule
                    (up-set-target-by-id g: gl-gaia-id-checker--ss8)
                    (up-object-data object-data-class == 910)
                    (up-object-data object-data-carry > 0)
                    (up-object-data object-data-hitpoints > 0)
                    (up-object-data object-data-distance < 40)
                    (up-point-explored gl-temp-x != explored-no)
                    =>
                (up-get-object-data object-data-id gl-temp)
                (up-add-object-by-id search-local g: gl-temp)
            )

            (defrule
                (up-compare-goal gl-gaia-id-checker--ss8 g:< gl-last-gaia-id__#052)
                =>
                (up-modify-goal gl-gaia-id-checker--ss8 c:+ 1)
                (up-jump-rule -3)
            )

            (defrule
                (true)
                =>
                (up-remove-objects search-local object-data-group-flag == scouted-animal-group) ; should maybe be all groups?
                (up-clean-search search-local -1 search-order-asc)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-local-total > 0)
                =>
                (up-modify-goal gl-boar-counter__#052 c:+ 1)
                ;(up-chat-data-to-all "Found %d boar (counter)" g: gl-boar-counter)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-id gl-temp)
                (up-full-reset-search)
                (up-set-group search-local c: scouted-animal-group)
                (up-add-object-by-id search-local g: gl-temp)
                (up-reset-group c: scouted-animal-group)
                (up-modify-group-flag 0 c: scouted-animal-group)
                (up-create-group 0 0 c: scouted-animal-group)
                (up-modify-group-flag 1 c: scouted-animal-group)
            )

            (defrule
                (up-compare-goal gl-local-total > 0)
                =>
                (up-jump-rule -9)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
