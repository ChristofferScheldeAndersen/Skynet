                ;Reset gl-scout-priority__#041 to scouting home base first
                    (defrule
                    (true)
                    =>
                    (set-goal gl-scout-priority__#041 Scouting-base)
                    )

            ;Choosing scouting profile

                    (defrule
                        (true)
                        =>
                        (set-goal gl-scouting-profile__#041 Home-deer-flank-pocket-map)
                    )

                    (defrule
                        (up-compare-goal gl-deer-counter__#052 == 0)
                        (up-compare-goal gl-chicken-counter__#052 > 0)
                        =>
                        (set-goal gl-scouting-profile__#041 Home-flank-deer-pocket-map)
                    )
            ;Scouting profiles:
                ; Home-deer-flank-pocket-map

                    (defrule
                    (up-compare-goal gl-scouting-profile__#041 == Home-deer-flank-pocket-map)
                    (up-compare-flag gl-setup-flags == fl-base-fully-scouted)
                    ;or(up-compare-flag gl-setup-flags == fl-need-deer-soon) ; we won't have to much boar food rotting under tc
                    ;(up-compare-flag gl-setup-flags == fl-found-second-deer-patch)) ; we have far deer to push
                    =>
                    (set-goal gl-scout-priority__#041 Luring-deer)
                    )

                    (defrule
                    (up-compare-goal gl-scouting-profile__#041 == Home-deer-flank-pocket-map)
                    (up-compare-flag gl-setup-flags == fl-base-fully-scouted)
                    (up-compare-flag gl-setup-flags == fl-main-deer-lured)
                    =>
                    (set-goal gl-scout-priority__#041 Scouting-enemy-flank)
                    )

                    (defrule
                    (up-compare-goal gl-scouting-profile__#041 == Home-deer-flank-pocket-map)
                    (up-compare-flag gl-setup-flags == fl-base-fully-scouted)
                    (or(up-compare-flag gl-setup-flags == fl-main-deer-lured)
                    (game-time > 600))
                    (up-compare-flag gl-setup-flags == fl-done-scouting-flank)
                    =>
                    (set-goal gl-scout-priority__#041 Scouting-enemy-pocket)
                    )

                    (defrule
                    (up-compare-goal gl-scouting-profile__#041 == Home-deer-flank-pocket-map)
                    (up-compare-flag gl-setup-flags == fl-base-fully-scouted)
                    (or(up-compare-flag gl-setup-flags == fl-main-deer-lured)
                    (game-time > 600))
                    (or(and(up-players-in-game enemy <= 1)
                    (up-compare-flag gl-setup-flags == fl-done-scouting-flank))
                    (up-compare-flag gl-setup-flags == fl-done-scouting-pocket))
                    =>
                    (set-goal gl-scout-priority__#041 Scouting-map)
                    )

                ; Home-flank-deer-pocket-map

                    (defrule
                    (up-compare-goal gl-scouting-profile__#041 == Home-flank-deer-pocket-map)
                    (up-compare-flag gl-setup-flags == fl-base-fully-scouted)
                    =>
                    (set-goal gl-scout-priority__#041 Scouting-enemy-flank)
                    )

                    (defrule
                    (up-compare-goal gl-scouting-profile__#041 == Home-flank-deer-pocket-map)
                    (up-compare-flag gl-setup-flags == fl-base-fully-scouted)
                    (up-compare-flag gl-setup-flags == fl-done-scouting-flank)
                    (up-compare-goal gl-scout-on-safe-side-of-enemy-tc-for-deer__#041 == Yes)
                    =>
                    (set-goal gl-scout-priority__#041 Luring-deer)
                    )

                    
                    (defrule
                    (up-compare-goal gl-scouting-profile__#041 == Home-flank-deer-pocket-map)
                    (up-compare-flag gl-setup-flags == fl-base-fully-scouted)
                    (up-compare-flag gl-setup-flags == fl-main-deer-lured)
                    (up-compare-flag gl-setup-flags == fl-done-scouting-flank)
                    =>
                    (set-goal gl-scout-priority__#041 Scouting-enemy-pocket)
                    )

                    (defrule
                    (up-compare-goal gl-scouting-profile__#041 == Home-flank-deer-pocket-map)
                    (up-compare-flag gl-setup-flags == fl-base-fully-scouted)
                    (up-compare-flag gl-setup-flags == fl-main-deer-lured)
                    (or(and(up-players-in-game enemy <= 1)
                    (up-compare-flag gl-setup-flags == fl-done-scouting-flank))
                    (up-compare-flag gl-setup-flags == fl-done-scouting-pocket))
                    =>
                    (set-goal gl-scout-priority__#041 Scouting-map)
                    )

            ;Changing scout-priority to convert unscouted sheep           
                ;Find unscouted sheep in base
                    (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-set-target-point gl-position-self-x)
                    (up-filter-distance c: -1 c: 40)
                    (set-strategic-number sn-focus-player-number 0)
                    )

                    (defrule
                    (or(stance-toward focus-player enemy)
                    (up-compare-sn sn-focus-player-number == 0))
                    =>
                    (up-find-remote c: livestock-class c: 40)
                    )

                    (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                    )

                ;Find variables relevant to changing priority to converting sheep

                    (defrule
                        (true)
                        =>
                        (set-goal gl-sheep-distance-to-danger__#041 99999)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        =>
                        (up-get-point position-object gl-temp-x)
                        (up-set-target-point gl-temp-x)
                        (up-clean-search search-remote object-data-distance search-order-asc)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-get-object-data object-data-distance gl-sheep-distance-to-scout__#041)
                        (up-get-point position-object gl-temp-x)
                        (up-get-point-distance gl-closest-enemy-fortification-x__#041 gl-temp-x gl-sheep-distance-to-danger__#041)
                    )

                    (defrule
                        (true)
                        =>
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-potential-sheep-counter__#041 g:= gl-sheep-counter__#052)
                        (up-modify-goal gl-potential-sheep-counter__#041 g:+ gl-remote-total)
                    )

                ;Change priority to convert sheep when scout is in base

                    (defrule
                        (up-compare-goal gl-scout-priority__#041 == Scouting-base)
                        (up-set-target-object search-remote c: 0)
                        (up-compare-goal gl-sheep-counter__#052 < 4)
                        =>
                        (set-goal gl-scout-priority__#041 Converting-sheep)
                    )

                    (defrule
                        (up-compare-goal gl-scout-priority__#041 == Scouting-base)
                        (up-set-target-object search-remote c: 0)
                        (up-compare-goal gl-sheep-counter__#052 <= 6)
                        (up-compare-goal gl-potential-sheep-counter__#041 > 6)
                        =>
                        (set-goal gl-scout-priority__#041 Converting-sheep)
                    )

                    (defrule
                        (up-compare-goal gl-scout-priority__#041 == Scouting-base)
                        (up-set-target-object search-remote c: 0)
                        (up-compare-goal gl-sheep-distance-to-scout__#041 < 15)
                        =>
                        (set-goal gl-scout-priority__#041 Converting-sheep)
                    )

                    (defrule
                        (up-compare-goal gl-scout-priority__#041 == Luring-deer)
                        (up-set-target-object search-remote c: 0)
                        (or(up-object-data object-data-player == 0)
                        (up-compare-goal gl-sheep-distance-to-scout__#041 < 10))
                        (up-compare-goal gl-deer-penalty__#041 > 25)
                        =>
                        (set-goal gl-scout-priority__#041 Converting-sheep)
                    )

                ;Change priority to convert sheep when scout is scouting the map

                    (defrule
                        (up-compare-goal gl-scout-priority__#041 == Scouting-map)
                        (up-set-target-object search-remote c: 0)
                        (up-compare-goal gl-deer-penalty__#041 > 25)
                        (up-compare-goal gl-sheep-distance-to-scout__#041 g:< gl-sheep-distance-to-danger__#041)
                        =>
                        (set-goal gl-scout-priority__#041 Converting-sheep)
                    )
                
                    ;For now only look for sheep close to own base. Later once we include laming we can make rules for 
                    ;stealing enemy sheep.
                ;Change priority to convert sheep when scout just found a single sheep

                    (defrule
                        (up-compare-goal gl-scout-priority__#041 == Scouting-base)
                        (up-set-target-by-id g: gl-new-sheep-found__#052)
                        =>
                        (set-goal gl-scout-priority__#041 Go-to-converted-sheep)
                    )
                    
            ;Changing scout-priority to lame enemy
            ;Changing scout-priority to kill exposed enemy units
            ;Changing scout-priority to retreat scout in danger

                (defrule
                    (or(up-compare-goal gl-scout-distance-to-danger__#041 < 9)
                    (and(up-compare-goal gl-scout-distance-to-danger__#041 < 15)
                    (goal gl-scout-close-to-a-castle__#041 Yes)))
                    =>
                    (set-goal gl-scout-priority__#041 Retreating-scout-from-fortification)
                    (disable-self)
                )

                (defrule 
                (true)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-scout-unit)
                (up-remove-objects search-local object-data-hitpoints >= 45)
                (set-strategic-number sn-focus-player-number 1)
                )

                (defrule
                (players-stance focus-player enemy)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-filter-distance c: -1 c: 2)
                (up-find-remote c: scout-cavalry-line c: 40)
                (up-filter-include cmdid-monk -1 -1 -1)
                (up-find-remote c: monk c: 40)
                (up-filter-include cmdid-military -1 -1 -1)   
                (up-find-remote c: all-units-class c: 240)
                (up-filter-include cmdid-villager -1 -1 -1)
                (up-find-remote c: all-units-class c: 240)
                )

                (defrule
                (up-compare-sn sn-focus-player-number < 8)
                =>
                (up-modify-sn sn-focus-player-number c:+ 1)
                (up-jump-rule -2)
                )

                (defrule
                (up-set-target-object search-remote c: 0)
                =>
                ;(set-goal gl-scout-priority Retreating-scout-from-units)
                (do-nothing)
                )

                (defrule
                (true)
                =>
                (set-strategic-number sn-focus-player-number 1)
                )

                (defrule
                (players-stance focus-player enemy)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-filter-distance c: -1 c: 5)
                (up-find-remote c: scout-cavalry-line c: 40)
                (up-find-remote c: villager-class c: 40)
                (up-filter-include cmdid-monk -1 -1 -1)
                (up-find-remote c: monk c: 40)
                (up-filter-include cmdid-military -1 -1 -1)   
                (up-find-remote c: all-units-class c: 240)
                (up-filter-include cmdid-villager -1 -1 -1)
                (up-find-remote c: all-units-class c: 240)
                (up-remove-objects search-remote object-data-target-id g:!= gl-scout-unit)
                )

                (defrule
                (up-compare-sn sn-focus-player-number < 8)
                =>
                (up-modify-sn sn-focus-player-number c:+ 1)
                (up-jump-rule -2)
                )

                (defrule
                (up-set-target-object search-remote c: 0)
                (up-object-target-data object-data-id g:== gl-scout-unit)
                =>
                ;(set-goal gl-scout-priority Retreating-scout-from-units)
                (do-nothing)
                )

            ;Debug
                
                (defrule
                    (taunt-detected my-player-number 102)
                    =>
                    (up-chat-data-to-all "gl-scout-priority__#041 is %d" g: gl-scout-priority__#041)
                )

    ; Lag test
        (defrule
        (taunt-detected my-player-number 103)
        =>
        (up-modify-goal gl-temp g:= gl-script-time__#051)
        (up-get-precise-time gl-script-start-time__#051 gl-script-time__#051)
        (up-modify-goal gl-temp g:- gl-script-time__#051)
        (up-modify-goal gl-temp1 g:neg gl-temp)
        (up-modify-goal gl-temp g:max gl-temp1)
        ;(up-chat-data-to-all "Scouting post setup: %d ms" g: gl-script-time)
        )
    ; 1-8 Scouting (ss1)
        ; Temp goals used
            
                
        ; 1-4 Scouting unscouted tiles
            ;Skip calculations if scout isn't rdy for a new command

                (defrule
                    (up-set-target-by-id g: gl-scout-unit)
                    =>
                    (up-get-point position-object gl-scout-position-x__#042)
                )

                (defrule
                    (up-point-distance gl-scout-position-x__#042 gl-next-scouting-point-x__#042 > 1) ;scout has not reached planned point
                    (up-compare-goal gl-next-scouting-point-x__#042 != -1) 
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-object-data object-data-idling != 1)
                    (up-compare-goal gl-scout-priority__#041 <= Scouting-enemy-pocket)
                    (up-compare-goal gl-end-of-scout-unit-movement-rule-id__#042 != -1)
                    =>
                    (up-jump-direct g: gl-end-of-scout-unit-movement-rule-id__#042)
                )
            ;Setup 
                ;Calculating gl-crossing-modifier__#042
                    (defrule
                        (up-players-in-game any <= 2)
                        =>
                        (set-goal gl-player-modifier__#042 52)
                    )

                    (defrule
                        (up-players-in-game any == 3)
                        =>
                        (set-goal gl-player-modifier__#042 100)
                    )

                    (defrule
                        (up-players-in-game any == 4)
                        =>
                        (set-goal gl-player-modifier__#042 150)
                    )

                    (defrule
                        (up-players-in-game any == 5)
                        =>
                        (set-goal gl-player-modifier__#042 210)
                    )

                    (defrule
                        (up-players-in-game any == 6)
                        =>
                        (set-goal gl-player-modifier__#042 290)
                    )

                    (defrule
                        (up-players-in-game any == 7)
                        =>
                        (set-goal gl-player-modifier__#042 390)
                    )

                    (defrule
                        (up-players-in-game any == 8)
                        =>
                        (set-goal gl-player-modifier__#042 540)
                    )

                    ;Lav en general model for at finde gl-crossing-modifier__#042 via: 
                    ; map-size * 1000 / gl-player-modifier__#042 / (260-20*players)

                    (defrule
                        (true)
                        =>
                        (up-modify-goal gl-crossing-modifier__#042 g:= gl-position-map-size-x)
                        (up-modify-goal gl-crossing-modifier__#042 c:* 1000)
                        (up-modify-goal gl-crossing-modifier__#042 g:/ gl-player-modifier__#042)
                        (up-get-fact players-in-game any gl-players-in-game__#042)
                        (up-modify-goal gl-players-in-game__#042 c:* 20)
                        (set-goal gl-temp 260)
                        (up-modify-goal gl-temp g:- gl-players-in-game__#042)
                        (up-modify-goal gl-crossing-modifier__#042 g:/ gl-temp)
                    )

                    ;Lav herefter faste regler for de 5 normale setups.

                    #load-if-defined UP-2-PLAYER-GAME
                    #load-if-defined TINY-MAP
                    (defrule
                        (true)
                        =>
                        (set-goal gl-crossing-modifier__#042 12)
                    )
                    #end-if
                    #end-if
                    #load-if-defined UP-3-PLAYER-GAME
                    #load-if-defined SMALL-MAP
                    (defrule
                        (true)
                        =>
                        (set-goal gl-crossing-modifier__#042 7)
                    )
                    #end-if
                    #end-if
                    #load-if-defined UP-4-PLAYER-GAME
                    #load-if-defined MEDIUM-MAP
                    (defrule
                        (true)
                        =>
                        (set-goal gl-crossing-modifier__#042 6)
                    )
                    #end-if
                    #end-if
                    #load-if-defined UP-6-PLAYER-GAME
                    #load-if-defined NORMAL-MAP
                    (defrule
                        (true)
                        =>
                        (set-goal gl-crossing-modifier__#042 5)
                    )
                    #end-if
                    #end-if
                    #load-if-defined UP-8-PLAYER-GAME
                    #load-if-defined LARGE-MAP
                    (defrule
                        (true)
                        =>
                        (set-goal gl-crossing-modifier__#042 4)
                    )
                    #end-if
                    #end-if

                    (defrule
                        (up-compare-goal gl-scouting-direction__#042 == Clockwise)
                        =>
                        (up-modify-goal gl-crossing-modifier__#042 c:* -1)
                    )

                    ;1v1 - 2 player map (120) - 12
                    ;1v1 - 8 player map - 23 (almost 24. seems players are closer to map egde)
                    ;1v1v1 - 3 player map - 7 (a bit unreliable)
                    ;2v2 - 4 player map - 6
                    ;3v3 - 6 player map - 5
                    ;4v4 - 2 player map (120) - 2,2
                    ;4v4 - 8 player map (220) - 4
                    ;4v4 - ludicris mp (480) - 8,8 (seems players are closer to map egde)
                
                ;Calculating gl-estimated-enemy-x__#042
                    ;Plan
                    ;0 Other script gets the correct players into gl-close-flank__#042 and gl-close-pocket__#042. For now we just set 
                    ;them as player 1 and 2.

                    (defrule
                        (true)
                        =>
                        (set-goal gl-close-flank__#042 1)
                        (set-goal gl-close-pocket__#042 2)
                    )

                    ;1 Using these we find the positions of their starting tc's into gl-close-flank-x__#042
                    ;and gl-close-pocket-x__#042

                    (defrule
                        (true)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-close-flank__#042)
                        (up-full-reset-search)
                        (up-find-remote c: town-center c: 1)
                    )

                    (defrule
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-get-point position-object gl-close-flank-x__#042)
                    )

                    (defrule
                        (true)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-close-pocket__#042)
                        (up-full-reset-search)
                        (up-find-remote c: town-center c: 1)
                    )

                    (defrule
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-get-point position-object gl-close-pocket-x__#042)
                    )

                    ;2 gl-temp-x is set to gl-close-flank-x__#042 and then crossed 5 tiles clockwise from gl-position-center-xx. Then the 
                    ;distance to gl-close-pocket-x__#042 is set to gl-temp. 

                    (defrule
                        (true)
                        =>
                        (up-copy-point gl-temp-x gl-close-flank-x__#042)
                        (up-cross-tiles gl-temp-x gl-position-center-x c: -5)
                        (up-get-point-distance gl-temp-x gl-close-pocket-x__#042 gl-temp)
                        (set-goal gl-scouting-direction__#042 Counter-clockwise)
                    )

                    ;3 a condition is set to point distance between gl-close-flank-x__#042 and gl-close-pocket-x__#042 if this number is 
                    ;lower than gl-temp gl-scouting-direction-ss1 is set to clockwise.

                    (defrule
                        (up-point-distance gl-close-flank-x__#042 gl-close-pocket-x__#042 g:< gl-temp)
                        =>
                        (set-goal gl-scouting-direction__#042 Clockwise)
                    )

                    ;4 gl-crossing-point-x__#042 is set to gl-position-center-x. Then lerped towards gl-position-self-x equal to
                    ;1/3 of the distance from position-zero to position-map-size. (gl-average-distance-to-map-center__#042)
                    
                    (defrule
                        (true)
                        =>
                        (up-get-point-distance gl-position-zero-x gl-position-map-size-x gl-average-distance-to-map-center__#042)
                        (up-modify-goal gl-average-distance-to-map-center__#042 c:/ 4)
                        (up-copy-point gl-crossing-point-x__#042 gl-position-center-x)
                        (up-lerp-tiles gl-crossing-point-x__#042 gl-close-flank-x__#042 g: gl-average-distance-to-map-center__#042)
                    )

                    ;5 From here gl-crossing-point-x is crossed in the scouting direction equal to 16x5 (80) tiles in the chosen
                    ;direction 

                    (defrule
                        (true)
                        =>
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                    )

                    ;12 Then gl-estimated-enemy-x__#042 is set to gl-position-center-x and lerped 1/3 of the distance from position-zero to 
                    ; position-map-size towards gl-crossing-point-x. All this is done in the setup section. Lets test with a flare.

                    (defrule
                        (true)
                        =>
                        (up-copy-point gl-estimated-enemy-x__#042 gl-position-center-x)
                        (up-lerp-tiles gl-estimated-enemy-x__#042 gl-crossing-point-x__#042 g: gl-average-distance-to-map-center__#042)
                        (up-copy-point gl-crossing-point-x__#042 gl-estimated-enemy-x__#042)
                    )

                    (defrule
                        (up-compare-goal gl-enemy-flank-x != -1)
                        (goal gl-scout-priority__#041 Scouting-enemy-flank)
                        =>
                        (up-copy-point gl-estimated-enemy-x__#042 gl-enemy-flank-x)
                    )

                    (defrule
                        (true)
                        =>
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                        (up-cross-tiles gl-crossing-point-x__#042 gl-position-center-x g: gl-crossing-modifier__#042)
                    )

                    ;6 Then gl-estimated-enemy-x__#042 is set to gl-position-center-x and lerped 1/3 of the distance from position-zero to 
                    ; position-map-size towards gl-crossing-point-x. All this is done in the setup section. Lets test with a flare.

                    (defrule
                        (up-compare-goal gl-scout-priority__#041 == Scouting-enemy-pocket)
                        =>
                        (up-copy-point gl-estimated-enemy-x__#042 gl-position-center-x)
                        (up-lerp-tiles gl-estimated-enemy-x__#042 gl-crossing-point-x__#042 g: gl-average-distance-to-map-center__#042)
                    )

                    #load-if-defined DE-AVAILABLE
                     (defrule
                        (up-players-in-game enemy == 1)
                        =>
                        (up-get-point position-flank gl-estimated-enemy-x__#042)
                    )
                    #end-if

                    (defrule
                        (up-compare-goal gl-enemy-pocket-x != -1)
                        (goal gl-scout-priority__#041 Scouting-enemy-pocket)
                        =>
                        (up-copy-point gl-estimated-enemy-x__#042 gl-enemy-pocket-x)
                    )

                    (defrule
                        (taunt-detected my-player-number 102)
                        =>
                        ;(up-send-flare gl-estimated-enemy-x__#042)
                        (do-nothing)
                    )

                ;Ajust main goals for each scouting priority (Can be modified to ajust for possible lag)

                    (defrule ;Modify these four rules to ajust for effectiveness vs lag.
                        (goal gl-scout-priority__#041 Scouting-base)
                        =>
                        (set-goal gl-big-square-size__#042 31)
                        (set-goal gl-big-loop-modifier-size__#042 8)
                        (set-goal gl-small-square-size__#042 12)
                        (set-goal gl-small-loop-modifier-size__#042 1)
                        (set-goal gl-tc-distance-modifier__#042 3)
                        (up-get-point position-self gl-scouting-center-x__#042)
                        (up-get-point position-self gl-prefered-scouting-point-x__#042)
                    )

                    (defrule ;Modify these four rules to ajust for effectiveness vs lag.
                        (goal gl-scout-priority__#041 Scouting-map)
                        =>
                        (set-goal gl-big-square-size__#042 60)
                        (set-goal gl-big-loop-modifier-size__#042 6)
                        (set-goal gl-small-square-size__#042 1)
                        (set-goal gl-small-loop-modifier-size__#042 1)
                        (set-goal gl-tc-distance-modifier__#042 20)
                        (up-get-point position-center gl-scouting-center-x__#042)
                        (up-get-point position-self gl-prefered-scouting-point-x__#042)
                    )

                    (defrule ;Modify these four rules to ajust for effectiveness vs lag.
                        (or(goal gl-scout-priority__#041 Scouting-enemy-flank)
                        (goal gl-scout-priority__#041 Scouting-enemy-pocket))
                        =>
                        (set-goal gl-big-square-size__#042 60)
                        (set-goal gl-big-loop-modifier-size__#042 6)
                        (set-goal gl-small-square-size__#042 14)
                        (set-goal gl-small-loop-modifier-size__#042 2)
                        (set-goal gl-tc-distance-modifier__#042 1)
                        (up-get-point position-flank gl-scouting-center-x__#042)
                        (up-copy-point gl-prefered-scouting-point-x__#042 gl-estimated-enemy-x__#042)
                    )

                ;Reset other goals before loop

                    (defrule ;Reset scout after it has had other tasks
                        (up-compare-goal gl-scout-priority__#041 > Scouting-enemy-pocket)
                        =>
                        (set-goal gl-next-scouting-point-x__#042 -1)
                        (set-goal gl-forbidden-point-x__#042 -1)
                    )

                    (defrule ;give a low value to make sure a point is chosen later
                        (true)
                        =>
                        (set-goal gl-best-found-score__#042 -999)
                    )

                    (defrule ;Reset goals used in the loops.
                        (up-set-target-by-id g: gl-scout-unit)
                        =>
                        (up-get-point position-object gl-scout-position-x__#042)
                        (up-modify-goal gl-big-x-modifier__#042 g:= gl-big-square-size__#042)
                        (up-modify-goal gl-big-x-modifier__#042 c:* -1)
                        (up-modify-goal gl-big-y-modifier__#042 g:= gl-big-square-size__#042)
                        (up-modify-goal gl-big-y-modifier__#042 c:* -1)
                        (up-modify-goal gl-small-x-modifier__#042 g:= gl-small-square-size__#042)
                        (up-modify-goal gl-small-x-modifier__#042 c:* -1)
                        (up-modify-goal gl-small-y-modifier__#042 g:= gl-small-square-size__#042)
                        (up-modify-goal gl-small-y-modifier__#042 c:* -1)
                        (set-goal gl-current-square__#042 1) ;small square first
                    )

                    ;These four rules attempt to find the LOS of the scouting unit +1 as this cannot be done with object-data

                    (defrule ;Unknown scouting unit:
                        (up-set-target-by-id g: gl-scout-unit)
                        (up-object-data object-data-class != livestock-class)
                        (up-object-data object-data-type != scout-cavalry)
                        (up-object-data object-data-type != eagle-warrior)
                        (up-object-data object-data-type != camel)
                        =>
                        (set-goal gl-scout-unit-los__#042 5)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        (up-object-data object-data-class == livestock-class)
                        =>
                        (set-goal gl-scout-unit-los__#042 3)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        (or(up-object-data object-data-type == scout-cavalry)
                        (up-object-data object-data-type == camel))
                        =>
                        (set-goal gl-scout-unit-los__#042 5)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        (up-object-data object-data-type == eagle-warrior)
                        =>
                        (set-goal gl-scout-unit-los__#042 7)
                    )

                    #load-if-defined UP-MONGOL-CIV-ALLY
                    (defrule ;ajust for better LOS with mongol ally
                        (up-set-target-by-id g: gl-scout-unit)
                        (up-object-data object-data-type == scout-cavalry)
                        (up-compare-goal gl-scout-unit-los__#042 <= 5)
                        =>
                        (up-modify-goal gl-scout-unit-los__#042 c:+ 3)
                    )
                    #end-if

                    #load-if-defined MONGOL-CIV
                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        (up-object-data object-data-type == scout-cavalry)
                        (up-compare-goal gl-scout-unit-los__#042 <= 5)
                        =>
                        (up-modify-goal gl-scout-unit-los__#042 c:+ 3)
                    )
                    #end-if

                    (defrule
                        (current-age >= feudal-age)
                        (or(up-object-data object-data-type == scout-cavalry)
                        (up-object-data object-data-type == camel))
                        =>
                        (up-modify-goal gl-scout-unit-los__#042 c:+ 2)
                    )

                    (defrule
                        (current-age >= feudal-age)
                        (up-object-data object-data-type == eagle-warrior)
                        =>
                        (up-modify-goal gl-scout-unit-los__#042 c:+ 1)
                    )

                ;Get nearby fortifications into local list before loop

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (set-strategic-number sn-focus-player-number 1)
                    )

                    (defrule
                        (stance-toward focus-player enemy)
                    =>
                        (up-find-remote c: town-center c: 200)
                        (up-find-remote c: castle c: 200)
                    )

                    (defrule
                        (up-compare-sn sn-focus-player-number < 8)
                    =>
                        (up-modify-sn sn-focus-player-number c:+ 1)
                        (up-jump-rule -2)
                    )

            ;Finding best spot to scout (loop)
                ;Reset goals
                    (defrule
                        (up-compare-goal gl-scout-priority__#041 > Scouting-enemy-pocket)
                        =>
                        (set-goal gl-forbidden-point-x__#042 -1)
                        (set-goal gl-next-scouting-point-x__#042 -1)

                    )
                    
                    (defrule ;Reset temp goals each time square loops reset
                        (true)
                        =>
                        (up-get-rule-id gl-big-loop-start__#042) ;guide square loops back to this rule
                        (set-goal gl-explored-tile-counter__#042 0)
                        (set-goal gl-exploration-score__#042 0)
                        (set-goal gl-tc-distance-score__#042 0)
                        (set-goal gl-scout-distance-score__#042 0)
                    )

                    (defrule ;guide tile exploration loop back to this rule (we dont want other temp-goals reset)
                        (true)
                        =>
                        (up-get-rule-id gl-small-loop-start__#042)
                    )

                    (defrule
                        (goal gl-current-square__#042 1) ;small square
                        =>
                        (up-copy-point gl-checked-tile-x__#042 gl-scout-position-x__#042) ;square around scout
                        (up-modify-goal gl-checked-tile-x__#042 g:+ gl-small-x-modifier__#042) ;find new checking tile
                        (up-modify-goal gl-checked-tile-y__#042 g:+ gl-small-y-modifier__#042)
                        (up-bound-precise-point gl-checked-tile-x__#042 0 c: 0) ;we dont wanna test point outside map
                        (up-copy-point gl-exploration-checker-x__#042 gl-checked-tile-x__#042) ;we wanna test exploration without changing gl-checked-tile-x__#042
                    )

                    (defrule
                        (goal gl-current-square__#042 2) ;big square
                        (up-compare-goal gl-scout-priority__#041 <= Scouting-enemy-pocket)
                        =>
                        (up-copy-point gl-checked-tile-x__#042 gl-scouting-center-x__#042) ;square around tc
                        (up-modify-goal gl-checked-tile-x__#042 g:+ gl-big-x-modifier__#042) ;find new checking tile
                        (up-modify-goal gl-checked-tile-y__#042 g:+ gl-big-y-modifier__#042)
                        (up-bound-precise-point gl-checked-tile-x__#042 0 c: 0) ;we dont wanna test point outside map
                        (up-copy-point gl-exploration-checker-x__#042 gl-checked-tile-x__#042) ;we wanna test exploration without changing gl-checked-tile-x__#042
                    )

                    (defrule
                        (up-compare-goal gl-small-x-modifier__#042 g:< gl-small-square-size__#042) ;x-coordinate not at maximum yet
                        (up-compare-goal gl-scout-priority__#041 <= Scouting-enemy-pocket) ;turn off loop when not used to avoid lag
                        (up-set-target-by-id g: gl-scout-unit) ;turn off loop when not used to avoid lag
                        (up-point-contains gl-checked-tile-x__#042 c: 915) ;tree class
                        =>
                        (up-modify-goal gl-small-x-modifier__#042 g:+ gl-small-loop-modifier-size__#042) ;change x coordinate
                        (up-jump-direct g: gl-big-loop-start__#042) ;reset small square loop
                    )

                    (defrule
                        (up-compare-goal gl-small-x-modifier__#042 g:>= gl-small-square-size__#042) ;x-coordinate at maximum
                        (up-compare-goal gl-small-y-modifier__#042 g:< gl-small-square-size__#042) ;y-coordinate not at maximum yet
                        (up-compare-goal gl-scout-priority__#041 <= Scouting-enemy-pocket) ;turn off loop when not used to avoid lag
                        (up-set-target-by-id g: gl-scout-unit) ;turn off loop when not used to avoid lag
                        (up-point-contains gl-checked-tile-x__#042 c: 915)
                        =>
                        (up-modify-goal gl-small-x-modifier__#042 g:= gl-small-square-size__#042) ;reset x coordinate
                        (up-modify-goal gl-small-x-modifier__#042 c:* -1) ;reset x coordinate
                        (up-modify-goal gl-small-y-modifier__#042 g:+ gl-small-loop-modifier-size__#042) ;change y coordinate
                        (up-jump-direct g: gl-big-loop-start__#042) ;reset small square loop
                    )

                ;Check tile exploration
                                
                    (defrule ;test scout LOS in each direction
                        (goal gl-explored-tile-counter__#042 1)
                        =>
                        (up-modify-goal gl-exploration-checker-x__#042 g:- gl-scout-unit-los__#042) 
                    )

                    (defrule
                        (goal gl-explored-tile-counter__#042 2)
                        =>
                        (up-modify-goal gl-exploration-checker-x__#042 g:+ gl-scout-unit-los__#042)
                    )

                    (defrule
                        (goal gl-explored-tile-counter__#042 3)
                        =>
                        (up-modify-goal gl-exploration-checker-y__#042 g:- gl-scout-unit-los__#042)
                    )

                    (defrule
                        (goal gl-explored-tile-counter__#042 4)
                        =>
                        (up-modify-goal gl-exploration-checker-y__#042 g:+ gl-scout-unit-los__#042)
                    )

                    (defrule
                        (true)
                        =>
                        (up-bound-precise-point gl-checked-tile-x__#042 0 c: 0) ;scout LOS may be outside of map
                    )

                    (defrule
                    (up-point-explored gl-exploration-checker-x__#042 == explored-no) ;point is unexplored
                    =>
                    (up-modify-goal gl-exploration-score__#042 c:+ 12) ;each unexplored point gives +12 score
                    )

                    (defrule
                    (up-compare-goal gl-explored-tile-counter__#042 < 4)
                    =>
                    (up-modify-goal gl-explored-tile-counter__#042 c:+ 1)
                    (up-jump-direct g: gl-small-loop-start__#042) ;restart exploration loop untill 5 tiles are checked
                    )

                ;Find and replace score
                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        =>
                        (up-get-point-distance gl-checked-tile-x__#042 gl-scout-position-x__#042 gl-scout-distance-score__#042)
                        (up-get-point-distance gl-checked-tile-x__#042 gl-prefered-scouting-point-x__#042 gl-tc-distance-score__#042)
                        (up-modify-goal gl-combined-score__#042 g:= gl-exploration-score__#042); favor unscouted areas
                        (up-modify-goal gl-combined-score__#042 g:- gl-scout-distance-score__#042) ;punish far points
                        (up-modify-goal gl-tc-distance-score__#042 c:* 2)
                        (up-modify-goal gl-tc-distance-score__#042 g:/ gl-tc-distance-modifier__#042)
                    )

                    (defrule ;extra focus on scouting near tc at first few minutes as most important res will be there
                        (game-time < 210)
                        ;should only run when exploring base.
                        =>
                        (up-modify-goal gl-tc-distance-score__#042 c:* 3)
                    )

                    (defrule
                        (true)
                        =>
                        (up-copy-point gl-temp-x gl-position-map-size-x)
                        (up-modify-goal gl-temp-x g:- gl-checked-tile-x__#042)
                        (up-modify-goal gl-temp-y g:- gl-checked-tile-y__#042)
                        (up-get-point-distance gl-checked-tile-x__#042 gl-prefered-scouting-point-x__#042 gl-temp)
                    )

                    (defrule
                        (up-compare-goal gl-exploration-score__#042 >= 2)
                        (or(up-compare-goal gl-checked-tile-x__#042 <= 3)
                        (or(up-compare-goal gl-checked-tile-y__#042 <= 3)
                        (or(up-compare-goal gl-temp-x <= 3)
                        (up-compare-goal gl-temp-y <= 3))))
                        (up-compare-goal gl-temp <= 23)
                        ;should only run when exploring base.
                        =>
                        (up-modify-goal gl-combined-score__#042 c:+ 30)
                    )

                    (defrule ;down prioritise areas far from tc
                        (true)
                        =>
                        (up-modify-goal gl-combined-score__#042 g:- gl-tc-distance-score__#042)
                        (set-goal gl-closest-enemy-fortification-x__#042 -1)
                        (up-set-target-point gl-scout-position-x__#042)
                        (up-clean-search search-remote object-data-distance search-order-asc)
                    )

                    (defrule
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-get-point position-object gl-closest-enemy-fortification-x__#042)
                        (up-get-point-distance gl-closest-enemy-fortification-x__#042 gl-checked-tile-x__#042 gl-point-distance-to-danger__#042)
                    )

                    (defrule
                        (up-point-distance gl-forbidden-point-x__#042 gl-checked-tile-x__#042 > 7) ;don't go to previously blocked point
                        (up-point-distance gl-next-scouting-point-extra-unit1-x__#043 gl-checked-tile-x__#042 > 9) ;don't go to point planned for being scouted by other scouting units
                        (up-point-distance gl-next-scouting-point-extra-unit2-x__#043 gl-checked-tile-x__#042 > 9)
                        (up-point-distance gl-position-self-x gl-checked-tile-x__#042 >= 12) ;dont scout where tc allready has vision
                        (up-compare-goal gl-combined-score__#042 g:> gl-best-found-score__#042) ;new found score better than best found score this loop
                        (up-compare-goal gl-exploration-score__#042 > 0) ;There are unscouted tiles near checked area
                        (or(up-compare-goal gl-exploration-score__#042 > 12) ;dont go for smaller unscouted areas
                        (game-time < 240))
                        (or(up-compare-goal gl-closest-enemy-fortification-x__#042 == -1)
                        (and(up-point-distance gl-closest-enemy-fortification-x__#042 gl-checked-tile-x__#042 > 13) 
                        (up-compare-goal gl-point-distance-to-danger__#042 g:>= gl-scout-distance-score__#042)));distance from checked point to enemy fortification bigger than distance to scout
                        =>
                        (up-modify-goal gl-best-found-score__#042 g:= gl-combined-score__#042) ;replace best score
                        (up-copy-point gl-best-fount-point-x__#042 gl-checked-tile-x__#042) ;replace best point
                    )

                ;Resetting loops
                    (defrule
                        (up-compare-goal gl-small-x-modifier__#042 g:< gl-small-square-size__#042) ;x-coordinate not at maximum yet
                        (up-compare-goal gl-scout-priority__#041 <= Scouting-enemy-pocket) ;turn off loop when not used to avoid lag
                        (up-set-target-by-id g: gl-scout-unit) ;turn off loop when not used to avoid lag
                        =>
                        (up-modify-goal gl-small-x-modifier__#042 g:+ gl-small-loop-modifier-size__#042) ;change x coordinate
                        (up-jump-direct g: gl-big-loop-start__#042) ;reset small square loop
                    )

                    (defrule
                        (up-compare-goal gl-small-x-modifier__#042 g:>= gl-small-square-size__#042) ;x-coordinate at maximum
                        (up-compare-goal gl-small-y-modifier__#042 g:< gl-small-square-size__#042) ;y-coordinate not at maximum yet
                        (up-compare-goal gl-scout-priority__#041 <= Scouting-enemy-pocket) ;turn off loop when not used to avoid lag
                        (up-set-target-by-id g: gl-scout-unit) ;turn off loop when not used to avoid lag
                        =>
                        (up-modify-goal gl-small-x-modifier__#042 g:= gl-small-square-size__#042) ;reset x coordinate
                        (up-modify-goal gl-small-x-modifier__#042 c:* -1) ;reset x coordinate
                        (up-modify-goal gl-small-y-modifier__#042 g:+ gl-small-loop-modifier-size__#042) ;change y coordinate
                        (up-jump-direct g: gl-big-loop-start__#042) ;reset small square loop
                    )

                    (defrule ;change from small to big loop
                        (goal gl-current-square__#042 1)
                        =>
                        (set-goal gl-current-square__#042 2) ;big
                    )

                    (defrule
                        (up-compare-goal gl-big-x-modifier__#042 g:< gl-big-square-size__#042) ;x-coordinate not at maximum yet
                        (up-compare-goal gl-scout-priority__#041 <= Scouting-enemy-pocket) ;turn off loop when not used to avoid lag
                        (up-set-target-by-id g: gl-scout-unit) ;turn off loop when not used to avoid lag
                        =>
                        (up-modify-goal gl-big-x-modifier__#042 g:+ gl-big-loop-modifier-size__#042) ;change x coordinate
                        (up-jump-direct g: gl-big-loop-start__#042);reset big square loop
                    )

                    (defrule
                        (up-compare-goal gl-big-x-modifier__#042 g:>= gl-big-square-size__#042) ;x-coordinate at maximum
                        (up-compare-goal gl-big-y-modifier__#042 g:< gl-big-square-size__#042) ;y-coordinate not at maximum ye
                        (up-compare-goal gl-scout-priority__#041 <= Scouting-enemy-pocket) ;turn off loop when not used to avoid lag
                        (up-set-target-by-id g: gl-scout-unit) ;turn off loop when not used to avoid lag
                        =>
                        (up-modify-goal gl-big-x-modifier__#042 g:= gl-big-square-size__#042) ;reset x coordinate
                        (up-modify-goal gl-big-x-modifier__#042 c:* -1) ;reset x coordinate
                        (up-modify-goal gl-big-y-modifier__#042 g:+ gl-big-loop-modifier-size__#042) ;change y coordinate
                        (up-jump-direct g: gl-big-loop-start__#042);reset big square loop
                    )
            
                    (defrule
                        (up-compare-goal gl-best-found-score__#042 == -999)
                        (up-resource-amount amount-exploration >= 50)
                        =>
                        (chat-to-all "done scouting")
                        (set-goal gl-done-scouting__#041 YES)
                    )

            ;Reset idle scout
                (defrule
                (up-set-target-by-id g: gl-scout-unit)
                (up-object-data object-data-idling == 1) ;scout is idle
                (up-compare-goal gl-scout-priority__#041 <= Scouting-enemy-pocket)
                =>
                (up-copy-point gl-forbidden-point-x__#042 gl-next-scouting-point-x__#042) ;remember blocked point in the future
                (set-goal gl-next-scouting-point-x__#042 -1) ;allow scout to move to a new point
                ;(up-chat-data-to-all "idle scout, avoid gl-forbidden-point-x of %d" g: gl-forbidden-point-x)
                )

            ;Moving scout

                (defrule
                    (or(up-point-distance gl-scout-position-x__#042 gl-next-scouting-point-x__#042 <= 1) ;scout has reached planned point
                    (up-compare-goal gl-next-scouting-point-x__#042 == -1)) ;scout is idle or has done non-scouting stuff
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-compare-goal gl-scout-priority__#041 <= Scouting-enemy-pocket)
                    =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-scout-unit)
                    (up-bound-precise-point gl-best-fount-point-x__#042 0 c: 3) ;no reason to be to close to the map egde
                    (up-target-point gl-best-fount-point-x__#042 action-default -1 -1) ;order the scout to move
                    (up-copy-point gl-next-scouting-point-x__#042 gl-best-fount-point-x__#042) ;remember the planned destination for the scout for the future.
                    ;(up-chat-data-to-all "moving scout to gl-next-scouting-point-x %d" g: gl-next-scouting-point-x)
                )
            ; End of main scout movement rules
                (defrule
                    (true)
                    =>
                    (up-get-rule-id gl-end-of-scout-unit-movement-rule-id__#042)
                )
        ; 5-6 Converting sheep with scout

            (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-set-target-point gl-position-self-x)
            (up-filter-distance c: -1 c: 40)
            (set-strategic-number sn-focus-player-number 0)
            )

            (defrule
            (or(stance-toward focus-player enemy)
            (up-compare-sn sn-focus-player-number == 0))
            =>
            (up-find-remote c: livestock-class c: 40)
            )

            (defrule
            (up-compare-sn sn-focus-player-number < 8)
            =>
            (up-modify-sn sn-focus-player-number c:+ 1)
            (up-jump-rule -2)
            )

            (defrule
                (up-set-target-by-id g: gl-scout-unit)
                =>
                (up-get-object-data object-data-move-x gl-scout-target-point-x__#042)
                (up-get-object-data object-data-move-y gl-scout-target-point-y__#042)
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-clean-search search-remote object-data-distance search-order-asc)
            )

            (defrule
                (up-set-target-by-id g: gl-scout-unit)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-point position-object gl-closest-sheep-x__#042)
                (up-bound-precise-point gl-closest-sheep-x__#042 0 c: 1)
            )

            (defrule
                (goal gl-scout-priority__#041 Converting-sheep)
                (or(up-point-distance gl-closest-sheep-x__#042 gl-scout-target-point-x__#042 > 2)
                (game-time < 30))
                (up-set-target-object search-remote c: 0)
                =>
                (up-add-object-by-id search-local g: gl-scout-unit)
                (up-target-point gl-closest-sheep-x__#042 action-default -1 -1)
            )

            (defrule
                (goal gl-scout-priority__#041 Go-to-converted-sheep)
                (up-set-target-by-id g: gl-new-sheep-found__#052)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-scout-unit)
                (up-get-point position-object gl-temp-x)
                (up-target-point gl-temp-x action-default -1 -1)
                (set-goal gl-next-scouting-point-x__#042 0)
                ;(chat-to-all "go to newly converted sheep")
            )

        ; 7-8 Scouting enemy-strategy (free)
    ; 9 Deer luring (missing)
    ; 10-11 Retreating (missing)
        ;If scout is near an enemy tc or castle we want it to retreat in an angle somewhat perpendicular to a 
        ;straight angle. The angle should be increasingly perpendicular the further the scout is from the fortification.

        ;The scout should retreat whenever targeted by close enemy units. Ideally it should just retreat to the 
        ;starting tc. If however the enemy unit or closest fortification is between the scout and the home tc
        ;the scout should retreat to a point halfway home crossed the same distance in the opposite direction
        ;(prioritising avoiding fortifications.)

        ;The move commands will be limited by conditions of only firering if new moving point is more than 3-4 tiles
        ;from current moving point. 

        ;Currently this code will override all prior rules for scout priority. In time it can be made more
        ;sophisticated as agressive scout behavior is added.



        ;Retreating scout 5 tiles towards tc

        (defrule
            (goal gl-scout-priority__#041 Retreating-scout-from-fortification)
            (up-set-target-by-id g: gl-scout-unit)
            =>
            (up-get-point position-object gl-temp-x)
            (up-lerp-tiles gl-temp-x gl-enemy-flank-x c: -5)
            (up-full-reset-search)
            (up-add-object-by-id search-local g: gl-scout-unit)
            (up-target-point gl-temp-x action-move -1 -1)
            (disable-self)
        )

    ; 12 Fighting (missing)
    ; 13-14 Laming (missing)
    ; Lag test
        (defrule
        (taunt-detected my-player-number 103)
        =>
        (up-modify-goal gl-temp g:= gl-script-time__#051)
        (up-get-precise-time gl-script-start-time__#051 gl-script-time__#051)
        (up-modify-goal gl-temp g:- gl-script-time__#051)
        (up-modify-goal gl-temp1 g:neg gl-temp)
        (up-modify-goal gl-temp g:max gl-temp1)
        ;(up-chat-data-to-all "Scouting pre sheep: %d ms" g: gl-script-time)
        )
    ; Secondary scouting units (ss10)
        ; Temp goals used
            

        ; Skip late game if no secondary scouting units exists
            (defrule
                (up-compare-goal gl-post-scouting-rule-id__#041 != -1)
                (or(up-resource-amount amount-exploration >= 90)
                (and(not(up-set-target-by-id g: gl-secondary-scout-unit-1))
                (not(up-set-target-by-id g: gl-secondary-scout-unit-2))))
                (game-time > 480)
                =>
                (up-jump-direct g: gl-post-scouting-rule-id__#041)
            )
        ; Choosing Secondary scouting units
        ; Stop secondary unit scouting after a few minutes

            (defrule
                (or(game-time > 480)
            (and(game-time > 240)
            (up-compare-goal gl-overload-food-build == YES)))
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-secondary-scout-unit-1)
                (up-add-object-by-id search-local g: gl-secondary-scout-unit-2)
                (up-target-point gl-position-self-x action-default -1 -1)
                (set-goal gl-secondary-scout-unit-2 -1)
                (set-goal gl-secondary-scout-unit-1 -1)
                (disable-self)
            )

