                (up-modify-goal gl-farm-score__#016 c:+ 8)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-testing-tile-y__#016 c:- 3)
                (up-modify-goal gl-testing-tile-x__#016 c:+ 1)
            )

            (defrule
                (up-can-build-line 0 gl-testing-tile-x__#016 c: farm)
                =>
                (up-modify-goal gl-farm-score__#016 c:+ 10)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-testing-tile-x__#016 c:- 3)
            )

            (defrule
                (up-can-build-line 0 gl-testing-tile-x__#016 c: farm)
                =>
                (up-modify-goal gl-farm-score__#016 c:+ 4)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-testing-tile-y__#016 c:- 3)
            )

            (defrule
                (up-can-build-line 0 gl-testing-tile-x__#016 c: farm)
                =>
                (up-modify-goal gl-farm-score__#016 c:+ 3)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-testing-tile-x__#016 c:+ 3)
            )

            (defrule
                (up-can-build-line 0 gl-testing-tile-x__#016 c: farm)
                =>
                (up-modify-goal gl-farm-score__#016 c:+ 8)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-testing-tile-x__#016 c:+ 3)
                (up-modify-goal gl-testing-tile-y__#016 c:+ 1)
            )

            (defrule
                (up-can-build-line 0 gl-testing-tile-x__#016 c: farm)
                =>
                (up-modify-goal gl-farm-score__#016 c:+ 10)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-testing-tile-y__#016 c:- 3)
            )

            (defrule
                (up-can-build-line 0 gl-testing-tile-x__#016 c: farm)
                =>
                (up-modify-goal gl-farm-score__#016 c:+ 4)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-testing-tile-x__#016 c:+ 3)
            )

            (defrule
                (up-can-build-line 0 gl-testing-tile-x__#016 c: farm)
                =>
                (up-modify-goal gl-farm-score__#016 c:+ 3)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-testing-tile-y__#016 c:+ 3)
            )

            (defrule
                (up-can-build-line 0 gl-testing-tile-x__#016 c: farm)
                =>
                (up-modify-goal gl-farm-score__#016 c:+ 8)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-combined-score__#016 g:+ gl-farm-score__#016)
            )                    

            (defrule
                (up-compare-goal gl-combined-score__#016 g:> gl-best-found-score__#016) ;new found score better than best found score this loop
                =>
                (up-modify-goal gl-best-found-score__#016 g:= gl-combined-score__#016) ;replace best score
                (up-copy-point gl-best-fount-point-x__#016 gl-checked-tile-x__#016) ;replace best point
            )

        ;Resetting loops


            (defrule
                (up-compare-goal gl-x-modifier__#016 g:< gl-square-size__#016) ;x-coordinate not at maximum yet
                (up-compare-goal gl-build == mill) ;turn off loop when not used to avoid lag
                =>
                (up-modify-goal gl-x-modifier__#016 g:+ gl-loop-modifier-size__#016) ;change x coordinate
                (up-jump-direct g: gl-loop-start__#016) ;reset small square loop
            )

            (defrule
                (up-compare-goal gl-x-modifier__#016 g:>= gl-square-size__#016) ;x-coordinate at maximum
                (up-compare-goal gl-y-modifier__#016 g:< gl-square-size__#016) ;y-coordinate not at maximum yet
                (up-compare-goal gl-build == mill) ;turn off loop when not used to avoid lag
                =>
                (up-modify-goal gl-x-modifier__#016 g:= gl-square-size__#016) ;reset x coordinate
                (up-modify-goal gl-x-modifier__#016 c:* -1) ;reset x coordinate
                (up-modify-goal gl-y-modifier__#016 g:+ gl-loop-modifier-size__#016) ;change y coordinate
                (up-jump-direct g: gl-loop-start__#016) ;reset small square loop
            )

        ;Place building
            (defrule
                (up-compare-goal gl-build == mill) ;turn off loop when not used to avoid lag
                (up-can-build-line 0 gl-best-fount-point-x__#016 g: gl-build)
                =>
                (up-build-line gl-best-fount-point-x__#016 gl-best-fount-point-x__#016 g: gl-build)
            )

            (defrule
                (up-compare-goal gl-build == mill)
                =>
                (set-goal gl-build -1)
            )
        ; Jump to end of building rules
            
            (defrule
                (up-compare-goal gl-post-build-engine-rule-id != -1)
                =>
                (up-jump-direct g: gl-post-build-engine-rule-id)
            )
    ; End of building rules
        (defrule
            (true)
            =>
            (up-get-rule-id gl-post-build-engine-rule-id)
        )
    ; Debug
        (defrule
            (taunt-detected my-player-number 107)
            =>
            (up-chat-data-to-all "gl-build: %d" g: gl-build)
            (acknowledge-taunt my-player-number 107)
        )
    ; Lag test
        (defrule
        (taunt-detected my-player-number 103)
        =>
        (up-modify-goal gl-temp g:= gl-script-time__#051)
        (up-get-precise-time gl-script-start-time__#051 gl-script-time__#051)
        (up-modify-goal gl-temp g:- gl-script-time__#051)
        (up-modify-goal gl-temp1 g:neg gl-temp)
        (up-modify-goal gl-temp g:max gl-temp1)
        (up-chat-data-to-all "Buildings: %d ms" g: gl-temp)
        )
    ;
; Scouting module #041 - #043
    ; Description
        ;This section is split into 3 main parts:
        ;1 A setup subscript that chooses gl-scout-priority__#041 and calculates variables relevant to the main scout
        ;2 Several independent subscripts controlling movement patterns of the main scout. Which of these will be
        ;active will depend on gl-scout-priority__#041 which can be set between 1-13, possibly more in the future.
        ;3 A subscript controlling secondary scouting units like sheep.
    ; Setup for main scouting unit (ss9)
        ; Reset flags

            (defrule
                (true)
                =>
                (set-goal gl-setup-flags 0)
                (disable-self)
            )
        ; Temp goals used

            


        ; Skip scouting rules late game

            (defrule
                (up-compare-goal gl-post-scouting-rule-id__#041 != -1)
                (or(goal gl-done-scouting__#041 YES)
                (or(up-resource-amount amount-exploration >= 90)
                (not(up-set-target-by-id g: gl-scout-unit))))
                (not(up-set-target-by-id g: gl-secondary-scout-unit-1))
                (not(up-set-target-by-id g: gl-secondary-scout-unit-2))
                (game-time > 600)
                =>
                (up-jump-direct g: gl-post-scouting-rule-id__#041)
            )
        ; Choosing main scouting unit (gl-scout-unit)
                (defrule
                (true)
                =>

                (set-strategic-number sn-cap-civilian-explorers 0)
                (set-strategic-number sn-total-number-explorers 0)
                (set-strategic-number sn-number-explore-groups 0)
                (up-full-reset-search)
                (up-find-local c: scout-cavalry-line c: 1)
                (up-find-local c: eagle-warrior-line c: 1)
                (up-find-local c: camel-line c: 1)
                )

                (defrule
                (up-set-target-object search-local c: 0)
                (game-time < 5)
                =>
                (up-target-point gl-temp-x action-none -1 stance-no-attack)
                (up-get-object-data object-data-id gl-scout-unit)
                )

                (defrule ;If no standard scout exist, chose another
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: all-units-class c: 200)
                )

                (defrule
                (goal gl-scout-unit -1)
                (game-time < 5)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-id gl-scout-unit)
                (chat-to-all "we have scout")
                )
            
        ; Locating enemy positions
                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (set-strategic-number sn-focus-player-number 1)
                )

                (defrule
                    (stance-toward focus-player enemy)
                =>
                    (up-find-remote c: town-center c: 200)
                )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )

                (defrule
                    (up-compare-goal gl-enemy-flank-x == -1)
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-get-point position-object gl-enemy-flank-x)
                )

                (defrule
                    (true)
                    =>
                    (up-set-target-point gl-enemy-flank-x)
                    (up-remove-objects search-remote object-data-distance < 10)
                )

                (defrule
                    (up-compare-goal gl-enemy-pocket-x == -1)
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-get-point position-object gl-enemy-pocket-x)
                )

            
                
        ; Choosing scout priority
            ;Setup
                ;Find enemy fortification nearest to the scout
                    (defrule
                        (true)
                        =>
                        (set-goal gl-closest-enemy-fortification-x__#041 -9999)
                        (set-goal gl-scout-distance-to-danger__#041 9999)
                        (set-goal gl-scout-close-to-a-castle__#041 No)
                        (up-full-reset-search)
                        (set-strategic-number sn-focus-player-number 1)
                    )

                    (defrule
                        (stance-toward focus-player enemy)
                    =>
                        (up-find-remote c: castle c: 200)
                    )

                    (defrule
                        (up-compare-sn sn-focus-player-number < 8)
                    =>
                        (up-modify-sn sn-focus-player-number c:+ 1)
                        (up-jump-rule -2)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        =>
                        (up-set-target-point gl-scout-position-x__#041)
                        (up-remove-objects search-remote object-data-distance >= 15)
                        (up-get-search-state gl-local-total)
                    )
                    
                    (defrule
                        (up-compare-goal gl-remote-total == 0)
                    =>
                        (set-goal gl-scout-close-to-a-castle__#041 No)
                        (up-full-reset-search)
                        (set-strategic-number sn-focus-player-number 1)
                    )

                    (defrule
                        (up-compare-goal gl-remote-total == 0)
                        (stance-toward focus-player enemy)
                    =>
                        (up-find-remote c: castle c: 200)
                        (up-find-remote c: town-center c: 200)
                    )

                    (defrule
                        (up-compare-goal gl-remote-total == 0)
                        (up-compare-sn sn-focus-player-number < 8)
                    =>
                        (up-modify-sn sn-focus-player-number c:+ 1)
                        (up-jump-rule -2)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        =>
                        (up-get-point position-object gl-scout-position-x__#041)
                        (up-set-target-point gl-scout-position-x__#041)
                        (up-clean-search search-remote object-data-distance search-order-asc)
                    )

                    (defrule
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-get-point position-object gl-closest-enemy-fortification-x__#041)
                        (up-get-point-distance gl-scout-position-x__#041 gl-closest-enemy-fortification-x__#041 gl-scout-distance-to-danger__#041)
                    )

                    (defrule
                        (up-set-target-object search-remote c: 0)
                        (or(up-object-data object-data-type == castle)
                        (up-compare-goal gl-remote-total > 0))
                        =>
                        (set-goal gl-scout-close-to-a-castle__#041 Yes)
                    )
                ;Deer setup
                    (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-set-group search-local c: scouted-animal-group)
                    (up-remove-objects search-local object-data-class != prey-animal-class)
                    (up-remove-objects search-local object-data-carry < 100)
                    (up-remove-objects search-local object-data-hitpoints <= 0)
                    (up-get-search-state gl-local-total)
                    )

                    (defrule
                    (up-compare-goal gl-local-total == 0)
                    (up-compare-flag gl-setup-flags != fl-main-deer-lured)
                    (or(up-compare-goal gl-deer-counter__#052 > 0) 
                    (and(up-compare-goal gl-deer-counter__#052 == 0)
                    (game-time > 420)))
                    =>
                    (up-modify-flag gl-setup-flags c:+ fl-main-deer-lured)
                    (chat-to-all "main deer lured")
                    ;(up-chat-data-to-all "gl-remote-total: %d" g: gl-remote-total)
                    ;(up-chat-data-to-all "gl-deer-counter: %d" g: gl-deer-counter)
                    (disable-self)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        =>
                        (up-get-point position-object gl-temp-x)
                        (up-set-target-point gl-temp-x)
                        (up-clean-search search-remote object-data-distance search-order-asc)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-get-object-data object-data-distance gl-deer-distance-to-scout__#041)
                        (up-get-point position-object gl-temp-x)
                        (up-get-point-distance gl-position-self-x gl-temp-x gl-deer-distance-to-tc__#041)
                        (up-modify-goal gl-deer-distance-to-scout__#041 c:* 2)
                        (up-modify-goal gl-deer-penalty__#041 c:= 0)
                        (up-modify-goal gl-deer-penalty__#041 g:+ gl-deer-distance-to-scout__#041)
                        (up-modify-goal gl-deer-distance-to-scout__#041 c:/ 2)
                        (up-modify-goal gl-deer-penalty__#041 g:+ gl-deer-distance-to-tc__#041)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-scout-on-safe-side-of-enemy-tc-for-deer__#041 No)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
