                    (disable-self)
                    )

                    (defrule
                    (or(and(up-compare-goal gl-sheep-counter__#052 >= 8)
                    (up-compare-goal gl-boar-counter__#052 >= 1))
                    (and(up-compare-goal gl-sheep-counter__#052 >= 6)
                    (up-compare-goal gl-boar-counter__#052 >= 2)))
                    (up-compare-flag gl-setup-flags == fl-found-berries)
                    (resource-found wood)
