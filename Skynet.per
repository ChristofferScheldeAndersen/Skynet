            )

            (defrule
                (goal gl-temp 1)
                (up-compare-goal gl-x-modifier__#016 g:< gl-square-size__#016) ;x-coordinate not at maximum yet
                (up-compare-goal gl-build == mill) ;turn off loop when not used to avoid lag
                =>
                (up-modify-goal gl-x-modifier__#016 g:+ gl-loop-modifier-size__#016) ;change x coordinate
                (up-jump-direct g: gl-loop-start__#016) ;reset small square loop
            )

            (defrule
                (goal gl-temp 1)
