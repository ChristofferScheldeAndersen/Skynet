; Global setup #051 - #052
    ; Lag detection for full script - start <#001>
        ; Initialise values for lag detection
            (defrule
                (true)
            =>
                (set-goal gl-time-since-last-tick__#051 0)
                (set-goal gl-script-start-time__#051 0)
                (set-goal gl-script-end-time__#051 0)
                (set-goal gl-total-tick-counter__#051 0)
                (set-goal gl-25-tick-counter__#051 0)
                (set-goal gl-script-time__#051 0)
                (set-goal gl-script-time-for-tick-group__#051 0)
                (set-goal gl-total-script-time__#051 0)
                (set-goal gl-script-time-avg-for-tick-group__#051 0)
                (set-goal gl-final-avg-script-time__#051 0)
                (set-goal gl-time-between-ticks-for-tick-group__#051 0)
                (set-goal gl-total-time-between-ticks__#051 0)
                (set-goal gl-time-between-ticks-avg-for-group__#051 0)
                (set-goal gl-final-avg-time-between-ticks__#051 0)
                (set-goal gl-time-since-last-full-script-read__#051 666)
                (set-goal gl-lowest-avg-tick-interval__#051 999999)
                (set-goal gl-highest-avg-tick-interval__#051 -999999)
                (set-goal gl-lowest-avg-script-time__#051 999999)
                (set-goal gl-highest-avg-script-time__#051 -999999)
                (disable-self)
            )

            (defrule
                (game-time > 25)
            =>
                (set-goal gl-lowest-avg-tick-interval__#051 999999)
                (set-goal gl-highest-avg-tick-interval__#051 -999999)
                (set-goal gl-lowest-avg-script-time__#051 999999)
                (set-goal gl-highest-avg-script-time__#051 -999999)
                (disable-self)
            )

            (defrule
                (true)
            =>
                (up-set-timer c: lag-timer c: 0)
                (up-get-timer c: lag-timer gl-script-start-time__#051)
                (up-modify-goal gl-time-since-last-tick__#051 g:= gl-script-start-time__#051)
                (up-modify-goal gl-time-since-last-tick__#051 g:- gl-script-end-time__#051)
                (up-modify-goal gl-time-since-last-full-script-read__#051 g:+ gl-time-since-last-tick__#051)
                (up-get-precise-time 0 gl-script-start-time__#051)
            )

            (defrule
                (up-compare-goal gl-time-since-last-full-script-read__#051 < 510)
                (up-compare-goal gl-end-of-script-rule-for-real__#051 != -1)
                =>
                (up-jump-direct g: gl-end-of-script-rule-for-real__#051)
            )

            (defrule
                (up-compare-goal gl-time-since-last-full-script-read__#051 >= 510)
                (up-compare-goal gl-end-of-script-rule-for-real__#051 != -1)
                =>
                (set-goal gl-time-since-last-full-script-read__#051 0)
            )

    ; Set commonly used goals

        (defrule
            (true)
            =>
            (up-get-point position-self gl-position-self-x)
            (up-get-fact unit-type-count-total villager gl-vill-nr)
        )
    ; Set strategic numbers once
        (defrule
		(true)
		=>
		(set-strategic-number sn-maximum-food-drop-distance -2)
        (set-strategic-number sn-maximum-wood-drop-distance -2)
        (set-strategic-number sn-maximum-gold-drop-distance -2)
        (set-strategic-number sn-maximum-stone-drop-distance -2)
        (set-strategic-number sn-maximum-hunt-drop-distance -2)
        (set-strategic-number sn-minimum-boar-hunt-group-size 0)
        ;(set-strategic-number sn-food-gatherer-percentage 0)
        ;(set-strategic-number sn-stone-gatherer-percentage 0)
        ;(set-strategic-number sn-gold-gatherer-percentage 0)
        ;(set-strategic-number sn-wood-gatherer-percentage 0)
        (set-strategic-number sn-cap-civilian-explorers 0)
        (set-strategic-number sn-percent-civilian-explorers 0)
        (set-strategic-number sn-percent-civilian-gatherers 0)
        (set-strategic-number sn-disable-builder-assistance 1)
        (set-strategic-number sn-percent-civilian-builders 0)
        (set-strategic-number sn-cap-civilian-builders 0)


        ;(set-strategic-number sn-allow-civilian-offense 1)
        ;(set-strategic-number sn-allow-civilian-defense 0)
        ;(set-strategic-number sn-number-civilian-militia 0)
        (set-strategic-number sn-disable-villager-garrison 1)
        (set-strategic-number sn-maximum-town-size 35) ; vills attacked outside of maximum town size might still attempt to garrison.
        (up-gather-inside c: battering-ram c: 0)
            (disable-self)
        )

        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: battering-ram-line c: 200)
