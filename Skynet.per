        ; Retask vills on wrong sheep targets

            (defrule
                (true)
                =>
                (set-goal gl-vill-index-new__#000 0)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 240)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-remove-objects search-local object-data-target != livestock-class)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-vill-max-index-new__#000 g:= gl-local-total)
                (up-modify-goal gl-vill-max-index-new__#000 c:- 1)
            )

            (defrule
                (up-set-target-object search-local g: gl-vill-index-new__#000)
                =>
                (up-get-object-target-data object-data-hitpoints gl-temp)
            )

            (defrule ;###
                (up-set-target-object search-local g: gl-vill-index-new__#000)
                (up-object-target-data object-data-id g:!= gl-bonus-sheep)
                (up-compare-goal gl-temp > 0)
                (or(and(up-compare-goal gl-boar-sheep-finishing-time__#000 >= 9)
                (up-compare-goal gl-overload-food-build != YES))
                (and(up-compare-goal gl-sheep-finishing-time__#000 >= 9)
                (up-compare-goal gl-overload-food-build == YES)))
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1)
                =>
                (up-get-object-data object-data-id gl-retask-vill-id__#000)
                (up-get-point position-object gl-retask-vill-x__#000)
                (up-modify-goal gl-retask-target-res__#000 c:= food)
                (up-modify-goal gl-retask-base-res__#000 c:= food) 
                ;(up-target-point gl-temp-x action-stop -1 -1)
                (set-goal gl-retask-from__#000 wrong-sheep-section)
                (set-goal gl-fallback-step__#000 0) 
                ;(fe-break-point 1 == 1 -1)
                (up-jump-direct g: gl-retask-section-first-rule-id__#000)
                (chat-to-all "stop vill from taking wrong sheep")
            )

            (defrule
                (true)
                =>
                (up-get-rule-id gl-post-wrong-sheep-retask-rule-id__#000)
                
            )

            (defrule
                (up-compare-goal gl-vill-index-new__#000 g:< gl-vill-max-index-new__#000)
                (game-time > 1)
                =>
                ;
                (do-nothing)
            )

            (defrule ; rule 914
                (up-compare-goal gl-vill-index-new__#000 g:< gl-vill-max-index-new__#000)
                =>
                (up-modify-goal gl-vill-index-new__#000 c:+ 1)
                (up-jump-rule -6)
            )



    ; Deer luring        
        ; Defconst

            ; temp goals
            (defconst gl-pathing-vill-x 2000)
            (defconst gl-pathing-vill-y 2001)
            (defconst gl-scout-x 2002)
            (defconst gl-scout-y 2003)
            (defconst gl-clockwise-x 2004)
            (defconst gl-clockwise-y 2005)
            (defconst gl-counter-clockwise-x 2006)
            (defconst gl-counter-clockwise-y 2007)
            (defconst gl-target-point-x 2008)
            (defconst gl-target-point-y 2009)
            (defconst gl-straight-distance 2010)
            (defconst gl-clockwise-distance 2011)
            (defconst gl-counter-clockwise-distance 2012)
            (defconst gl-deer-precise-x 3000)
            (defconst gl-deer-precise-y 3001)
            (defconst gl-scout-precise-x 3002)
            (defconst gl-scout-precise-y 3003)
            (defconst gl-stuck-deer-precise-x 3010)
            (defconst gl-stuck-deer-precise-y 3011)

            ;permanent goals
            (defconst gl-deer-trap-precise-x 3012)
            (defconst gl-deer-trap-precise-y 3013)
            (defconst gl-target-deer 3014)
            (defconst gl-pathing-vill-id 3015)
            (defconst gl-stuck-deer 3009)
            (defconst gl-scout-last-precise-x 3004)
            (defconst gl-scout-last-precise-y 3005)
            (defconst gl-deer-last-precise-x 3006)
            (defconst gl-deer-last-precise-y 3007)
            (defconst gl-stuck-ticks 3008)

        ; Detect stuck deer
            (defrule
                (up-set-target-by-id g: gl-scout-unit)
                =>
                (up-get-object-data object-data-precise-x gl-scout-precise-x)
                (up-get-object-data object-data-precise-y gl-scout-precise-y)
            )

            (defrule
                (up-set-target-by-id g: gl-target-deer)
                =>
                (up-get-object-data object-data-precise-x gl-deer-precise-x)
                (up-get-object-data object-data-precise-y gl-deer-precise-y)
            )

            (defrule
                (up-set-target-by-id g: gl-scout-unit)
                (up-set-target-by-id g: gl-target-deer)
                (up-point-distance gl-scout-precise-x gl-scout-last-precise-x < 20)
                (up-point-distance gl-deer-precise-x gl-deer-last-precise-x < 20)
                =>
                (up-modify-goal gl-stuck-ticks c:+ 1)
            )

            (defrule
                (up-set-target-by-id g: gl-scout-unit)
                (up-set-target-by-id g: gl-target-deer)
                (or(up-point-distance gl-scout-precise-x gl-scout-last-precise-x >= 20)
                (up-point-distance gl-deer-precise-x gl-deer-last-precise-x >= 20))
                =>
                (up-modify-goal gl-stuck-ticks c:= 0)
            )

            (defrule
                (true)
                =>
                (up-copy-point gl-scout-last-precise-x gl-scout-precise-x)
                (up-copy-point gl-deer-last-precise-x gl-deer-precise-x)
                ;(up-chat-data-to-all "gl-stuck-ticks %d" g: gl-stuck-ticks)
            )

            (defrule
                (up-compare-goal gl-stuck-ticks >= 10)
                (up-set-target-by-id g: gl-scout-unit)
                (up-compare-goal gl-stuck-deer == -1)
                (up-set-target-by-id g: gl-target-deer)
                =>
                (chat-to-all "deer is stuck. Move scout and choose new deer")
                (set-goal gl-target-deer -1)
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-scout-unit)
                (up-target-point gl-position-self-x action-move -1 -1)
                (up-get-object-data object-data-id gl-stuck-deer)
                (up-get-object-data object-data-precise-x gl-deer-trap-precise-x)
                (up-get-object-data object-data-precise-y gl-deer-trap-precise-y)
            )

            (defrule
                (up-set-target-by-id g: gl-stuck-deer)
                =>
                (up-get-object-data object-data-precise-x gl-stuck-deer-precise-x)
                (up-get-object-data object-data-precise-y gl-stuck-deer-precise-y)
            )

            (defrule
                (up-set-target-by-id g: gl-stuck-deer)
                (or(up-point-distance gl-stuck-deer-precise-x gl-deer-trap-precise-x > 250)
                (up-object-data object-data-hitpoints == 0))
                =>
                (set-goal gl-stuck-deer -1)
                (chat-to-all "stuck deer is free.")
            )
        ; Choose target deer to lure
            (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-set-target-point gl-position-self-x)
            (up-set-group search-remote c: scouted-animal-group)
            (up-remove-objects search-remote object-data-class != prey-animal-class)
            (up-remove-objects search-remote object-data-hitpoints <= 0)
            (up-remove-objects search-remote object-data-id g:== gl-stuck-deer)
            (up-clean-search search-remote object-data-precise-distance search-order-asc)
            )

            (defrule
                (or(up-compare-goal gl-target-deer == -1)
                (and(up-set-target-by-id g: gl-target-deer)
                (up-object-data object-data-hitpoints == 0)))
                (up-set-target-object search-remote c: 0)
                =>
                (chat-to-all "choosing new target deer")
                (up-get-object-data object-data-id gl-target-deer)
            )

        ; Find point the deer should be pushed towards acounting for blocking forrest
            (defrule
                (up-set-target-by-id g: gl-scout-unit)
                =>
                (up-get-object-data object-data-precise-x gl-scout-x)
                (up-get-object-data object-data-precise-y gl-scout-y)
                (up-copy-point gl-pathing-vill-x gl-position-self-x)
                (up-modify-goal gl-pathing-vill-x c:* 100)
                (up-modify-goal gl-pathing-vill-y c:* 100)
                (up-lerp-tiles gl-pathing-vill-x gl-scout-x c: 200)
                (up-copy-point gl-clockwise-x gl-scout-x)
                (up-cross-tiles gl-clockwise-x gl-pathing-vill-x c: -200)
                (up-copy-point gl-counter-clockwise-x gl-scout-x)
                (up-cross-tiles gl-counter-clockwise-x gl-pathing-vill-x c: 200)
                (up-full-reset-search)
                (up-copy-point gl-target-point-x gl-pathing-vill-x)
                (up-modify-goal gl-target-point-x c:/ 100)
                (up-modify-goal gl-target-point-y c:/ 100)
                (up-set-target-point gl-target-point-x)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
            )

            (defrule
                (up-set-target-by-id g: gl-scout-unit)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-id gl-pathing-vill-id)
                (up-modify-goal gl-clockwise-x c:/ 100)
                (up-modify-goal gl-clockwise-y c:/ 100)
                (up-get-path-distance gl-clockwise-x 0 gl-clockwise-distance)
                (up-modify-goal gl-counter-clockwise-x c:/ 100)
                (up-modify-goal gl-counter-clockwise-y c:/ 100)
                (up-get-path-distance gl-counter-clockwise-x 0 gl-counter-clockwise-distance)
            )

            (defrule
                (true)
                =>
                (set-goal gl-pushing-direction__#000 -1)
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 2)
                (up-filter-status c: status-ready c: list-active) 
            )

            (defrule
                (up-set-target-by-id g: gl-target-deer)
                =>
                (up-get-object-data object-data-precise-x gl-deer-precise-x__#000)
                (up-get-object-data object-data-precise-y gl-deer-precise-y__#000)
                (up-copy-point gl-destination-precise-x__#000 gl-position-self-x)
                (up-modify-goal gl-destination-precise-x__#000 c:* 100)
                (up-modify-goal gl-destination-precise-y__#000 c:* 100)
            )

            (defrule
                (up-set-target-by-id g: gl-target-deer)
                =>
                (up-copy-point gl-middle-destination-precise-x__#000 gl-deer-precise-x__#000)
                (up-lerp-tiles gl-middle-destination-precise-x__#000 gl-destination-precise-x__#000 c: 1200)
                (up-copy-point gl-middle-destination-x__#000 gl-middle-destination-precise-x__#000)
                (up-modify-goal gl-middle-destination-x__#000 c:/ 100)
                (up-modify-goal gl-middle-destination-y__#000 c:/ 100)
                (up-set-target-point gl-middle-destination-x__#000)
                (up-find-resource c: wood c: 10)

                (up-copy-point gl-middle-destination-precise-x__#000 gl-deer-precise-x__#000)
                (up-lerp-tiles gl-middle-destination-precise-x__#000 gl-destination-precise-x__#000 c: 1000)
                (up-copy-point gl-middle-destination-x__#000 gl-middle-destination-precise-x__#000)
                (up-modify-goal gl-middle-destination-x__#000 c:/ 100)
                (up-modify-goal gl-middle-destination-y__#000 c:/ 100)
                (up-set-target-point gl-middle-destination-x__#000)
                (up-find-resource c: wood c: 10)
            )

            (defrule
                (up-set-target-by-id g: gl-target-deer)
                =>
                (up-copy-point gl-middle-destination-precise-x__#000 gl-deer-precise-x__#000)
                (up-lerp-tiles gl-middle-destination-precise-x__#000 gl-destination-precise-x__#000 c: 800)
                (up-copy-point gl-middle-destination-x__#000 gl-middle-destination-precise-x__#000)
                (up-modify-goal gl-middle-destination-x__#000 c:/ 100)
                (up-modify-goal gl-middle-destination-y__#000 c:/ 100)
                (up-set-target-point gl-middle-destination-x__#000)
                (up-find-resource c: wood c: 10)

                (up-copy-point gl-middle-destination-precise-x__#000 gl-deer-precise-x__#000)
                (up-lerp-tiles gl-middle-destination-precise-x__#000 gl-destination-precise-x__#000 c: 600)
                (up-copy-point gl-middle-destination-x__#000 gl-middle-destination-precise-x__#000)
                (up-modify-goal gl-middle-destination-x__#000 c:/ 100)
                (up-modify-goal gl-middle-destination-y__#000 c:/ 100)
                (up-set-target-point gl-middle-destination-x__#000)
                (up-find-resource c: wood c: 10)
            )

            (defrule
                (up-set-target-by-id g: gl-target-deer)
                =>
                (up-copy-point gl-middle-destination-precise-x__#000 gl-deer-precise-x__#000)
                (up-lerp-tiles gl-middle-destination-precise-x__#000 gl-destination-precise-x__#000 c: 500)
                (up-copy-point gl-middle-destination-x__#000 gl-middle-destination-precise-x__#000)
                (up-modify-goal gl-middle-destination-x__#000 c:/ 100)
                (up-modify-goal gl-middle-destination-y__#000 c:/ 100)
                (up-set-target-point gl-middle-destination-x__#000)
                (up-find-resource c: wood c: 10)

                (up-get-search-state gl-local-total)
                (up-reset-filters)
                (up-set-target-point gl-middle-destination-x__#000)
            )

            (defrule
                (true)
                =>
                (up-copy-point gl-testing-precise-x__#000 gl-position-self-x)
                (up-modify-goal gl-testing-precise-x__#000 c:* 100)
                (up-modify-goal gl-testing-precise-y__#000 c:* 100)
            )

            (defrule
                (up-set-target-by-id g: gl-pathing-vill-id)
                (up-compare-goal gl-clockwise-distance g:< gl-counter-clockwise-distance)
                =>
                (set-goal gl-pushing-direction__#000 Clockwise)
            )

            (defrule
                (up-set-target-by-id g: gl-pathing-vill-id)
                (up-compare-goal gl-clockwise-distance g:> gl-counter-clockwise-distance)
                =>
                (set-goal gl-pushing-direction__#000 Counter-clockwise)
            )

            (defrule
                (up-set-target-by-id g: gl-pathing-vill-id)
                (up-compare-goal gl-pushing-direction__#000 != -1)
                =>
                (set-goal gl-cross-index__#000 100)
            )

            (defrule
                (up-set-target-by-id g: gl-pathing-vill-id)
                (up-compare-goal gl-pushing-direction__#000 == Clockwise)
                =>
                (up-copy-point gl-testing-precise-x__#000 gl-middle-destination-precise-x__#000)
                (up-modify-goal gl-cross-number__#000 g:neg gl-cross-index__#000)
                (up-cross-tiles gl-testing-precise-x__#000 gl-destination-precise-x__#000 g: gl-cross-number__#000)
                (up-copy-point gl-testing-x__#000 gl-testing-precise-x__#000)
                (up-modify-goal gl-testing-x__#000 c:/ 100)
                (up-modify-goal gl-testing-y__#000 c:/ 100)
                (up-reset-search 0 0 1 1)
                (up-set-target-point gl-testing-x__#000)
                (up-filter-distance c: -1 c: 2)
                (up-filter-status c: status-ready c: list-active)            
                (up-find-resource c: wood c: 10)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-remote-total >= 4) ; higher number means it's push closer to the forrest. lower might overcorrect in chokes
                (up-set-target-by-id g: gl-pathing-vill-id)
                (up-compare-goal gl-pushing-direction__#000 == Clockwise)
                =>
                (up-modify-goal gl-cross-index__#000 c:+ 100)
                (up-jump-rule -2)
            )

            (defrule
                (up-set-target-by-id g: gl-pathing-vill-id)
                (up-compare-goal gl-pushing-direction__#000 == Counter-clockwise)
                =>
                (up-copy-point gl-testing-precise-x__#000 gl-middle-destination-precise-x__#000)
                (up-modify-goal gl-cross-number__#000 g:= gl-cross-index__#000)
                (up-cross-tiles gl-testing-precise-x__#000 gl-destination-precise-x__#000 g: gl-cross-number__#000)
                (up-copy-point gl-testing-x__#000 gl-testing-precise-x__#000)
                (up-modify-goal gl-testing-x__#000 c:/ 100)
                (up-modify-goal gl-testing-y__#000 c:/ 100)
                (up-reset-search 0 0 1 1)
                (up-set-target-point gl-testing-x__#000)
                (up-filter-distance c: -1 c: 2)
                (up-filter-status c: status-ready c: list-active)            
                (up-find-resource c: wood c: 10)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-remote-total >= 4)
                (up-set-target-by-id g: gl-pathing-vill-id)
                (up-compare-goal gl-pushing-direction__#000 == Counter-clockwise)
                =>
                (up-modify-goal gl-cross-index__#000 c:+ 100)
                (up-jump-rule -2)
            )


        ; Push the deer
            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-remote g: gl-target-deer)
                (up-add-object-by-id search-local g: gl-scout-unit)
            )

            (defrule
                (goal gl-scout-priority__#041 Luring-deer)
                (up-set-target-by-id g: gl-scout-unit)
                (up-set-target-by-id g: gl-target-deer)
                ;(up-compare-goal gl-buffer-time-for-next-deer-push__#000 < 100) ; needs a much higher value if we don't have a boar reserve
                =>
                (up-get-object-data object-data-precise-x gl-precise-deer-location-x__#000)
                (up-get-object-data object-data-precise-y gl-precise-deer-location-y__#000)
                (up-get-point position-self gl-temp-x)
                (up-modify-goal gl-temp-x c:* 100)
                (up-modify-goal gl-temp-y c:* 100)
                (up-lerp-tiles gl-precise-deer-location-x__#000 gl-testing-precise-x__#000 c: -75)
                (up-bound-precise-point gl-precise-deer-location-x__#000 1 c: 0) 
                (up-set-precise-target-point gl-precise-deer-location-x__#000)
                (set-strategic-number sn-target-point-adjustment 6)
                (up-target-point 0 action-move -1 -1)
                (set-strategic-number sn-target-point-adjustment 1)
            )

            (defrule
                (goal gl-scout-priority__#041 Luring-deer)
                (up-set-target-object search-local c: 0)
                (up-set-target-by-id g: gl-target-deer)
                (up-compare-goal gl-buffer-time-for-next-deer-push__#000 >= 1025) ; needs a much higher value if we don't have a boar reserve'
                =>
                (up-get-object-data object-data-precise-x gl-precise-deer-location-x__#000)
                (up-get-object-data object-data-precise-y gl-precise-deer-location-y__#000)
                (up-get-point position-self gl-temp-x)
                (up-modify-goal gl-temp-x c:* 100)
                (up-modify-goal gl-temp-y c:* 100)
                (up-lerp-tiles gl-precise-deer-location-x__#000 gl-testing-precise-x__#000 c: -400)
                (up-bound-precise-point gl-precise-deer-location-x__#000 1 c: 0) 
                (up-set-precise-target-point gl-precise-deer-location-x__#000)
                (set-strategic-number sn-target-point-adjustment 6)
                (up-target-point 0 action-move -1 -1)
                (set-strategic-number sn-target-point-adjustment 1)
            )

        ; Kill the deer
            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-group search-remote c: scouted-animal-group)
                (up-remove-objects search-remote object-data-class != prey-animal-class)
                (up-remove-objects search-remote object-data-hitpoints <= 0)
                (up-clean-search search-remote object-data-precise-distance search-order-asc)
                (up-set-target-point gl-position-self-x)
                (up-remove-objects search-remote object-data-distance > 2)
                (set-goal gl-local-total 0)
            )

            (defrule
                (goal gl-scout-priority__#041 Luring-deer)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-set-group search-local c: retask-food-vills-group)
                (up-remove-objects search-local object-data-distance > 3)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
                (up-remove-objects search-local object-data-index >= 2)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-local-total >= 2)
                =>
                (up-target-objects 0 action-default -1 -1)
                (set-goal gl-last-pushing-direction__#000 -1)
                ;(chat-to-all "kill deer")
            )

        ; Retask vills on wrong deer targets

            (defrule
                (true)
                =>
                (set-goal gl-vill-index-new__#000 0)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 240)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-remove-objects search-local object-data-target != prey-animal-class)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-vill-max-index-new__#000 g:= gl-local-total)
                (up-modify-goal gl-vill-max-index-new__#000 c:- 1)
            )

            (defrule
                (up-set-target-object search-local g: gl-vill-index-new__#000)
                =>
                (up-get-object-target-data object-data-hitpoints gl-temp)
                (up-get-object-target-data object-data-point-x gl-temp-x)
                (up-get-object-target-data object-data-point-y gl-temp-y)
            )

            (defrule ;###
                (up-set-target-object search-local g: gl-vill-index-new__#000)
                (up-object-target-data object-data-carry >= 100) ; don't retask chicken vills
                (up-compare-goal gl-temp > 0)
                (up-point-distance gl-temp-x gl-position-self-x > 2)
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1)
                =>
                (up-get-object-data object-data-id gl-retask-vill-id__#000)
                (up-get-point position-object gl-retask-vill-x__#000)
                (up-modify-goal gl-retask-target-res__#000 c:= food)
                (up-modify-goal gl-retask-base-res__#000 c:= food) 
                (set-goal gl-retask-from__#000 wrong-deer-section)
                (set-goal gl-fallback-step__#000 0) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000)
                (chat-to-all "stop vill from taking wrong deer")
            )

            (defrule
                (true)
                =>
                (up-get-rule-id gl-post-wrong-deer-retask-rule-id__#000)
                
            )

            (defrule
                (up-compare-goal gl-vill-index-new__#000 g:< gl-vill-max-index-new__#000)
                =>
                (up-modify-goal gl-vill-index-new__#000 c:+ 1)
                (up-jump-rule -5)
            )



    
    ; Food-to-food retasking

        

        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-set-target-point gl-position-self-x)
            (up-filter-distance c: -1 c: 8)
            (up-find-local c: villager-class c: 200)
            (up-remove-objects search-local object-data-group-flag != food-group)
            (up-reset-group c: temp-group1)
            (up-create-group 0 0 c: temp-group1)
            (up-filter-status c: status-gather c: list-active)
            (up-find-resource c: predator-animal-class c: 20)
            (up-find-resource c: prey-animal-class c: 20)
            (up-find-resource c: livestock-class c: 20)
            (up-filter-status c: status-down c: list-active)
            (up-find-resource c: predator-animal-class c: 20)
            (up-find-resource c: prey-animal-class c: 20)
            (up-find-resource c: livestock-class c: 20)
            (up-remove-objects search-remote object-data-carry < 15)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-animal-max-index__#000 g:= gl-remote-total)
            (up-modify-goal gl-animal-max-index__#000 c:- 1)
            (set-goal gl-animal-index__#000 0)
            (set-goal gl-forbidden-index__#000 -1)
        )

        (defrule
            (up-set-target-object search-remote g: gl-animal-index__#000)
            (up-compare-goal gl-animal-max-index__#000 > 0)
            =>
            (up-get-object-data object-data-tasks-count gl-animal-task-count__#000)
            (up-modify-goal gl-current-goal-constant__#000 c:= gl-first-task-count-goal-constant__#000)
            (up-modify-goal gl-current-goal-constant__#000 g:+ gl-animal-index__#000)
            (up-set-indirect-goal g: gl-current-goal-constant__#000 g: gl-animal-task-count__#000)
            (up-modify-goal gl-animal-index__#000 c:+ 1)
            
            (up-jump-rule -1)
        )

        (defrule
            (true)
            =>
            (up-get-rule-id gl-reset-score-first-rule-id__#000)
            (set-goal gl-from-animal-index__#000 0)
            (set-goal gl-to-animal-index__#000 0)
            (set-goal gl-best-score__#000 -99999)
            (set-goal gl-best-from-id__#000 -1)
            (set-goal gl-best-from-index__#000 -1)
            (set-goal gl-best-to-id__#000 -1)
            (set-goal gl-best-to-index__#000 -1)
            (set-goal gl-transfer-vill-id__#000 -1)
        )

        (defrule
            (true)
            =>
            (up-get-rule-id gl-retask-animal-first-rule-id__#000)
        )

        (defrule
            (up-set-target-object search-remote g: gl-from-animal-index__#000)
            =>
            (up-get-object-data object-data-id gl-from-animal-id__#000)
            (up-get-object-data object-data-carry gl-from-animal-carry__#000)
            (up-get-object-data object-data-precise-x gl-from-animal-precise-x__#000)
            (up-get-object-data object-data-precise-y gl-from-animal-precise-y__#000)

            (up-modify-goal gl-current-goal-constant__#000 c:= gl-first-task-count-goal-constant__#000)
            (up-modify-goal gl-current-goal-constant__#000 g:+ gl-from-animal-index__#000)
            (up-get-indirect-goal g: gl-current-goal-constant__#000 gl-from-animal-task-count__#000)
            (up-modify-goal gl-from-animal-task-count__#000 c:- 1)
        )

        (defrule
            (up-set-target-object search-remote g: gl-to-animal-index__#000)
            =>
            (up-get-object-data object-data-id gl-to-animal-id__#000)
            (up-get-object-data object-data-carry gl-to-animal-carry__#000)
            (up-get-object-data object-data-precise-x gl-to-animal-precise-x__#000)
            (up-get-object-data object-data-precise-y gl-to-animal-precise-y__#000)

            (up-modify-goal gl-current-goal-constant__#000 c:= gl-first-task-count-goal-constant__#000)
            (up-modify-goal gl-current-goal-constant__#000 g:+ gl-to-animal-index__#000)
            (up-get-indirect-goal g: gl-current-goal-constant__#000 gl-to-animal-task-count__#000)
        )
        
        (defrule
            (true)
            =>
            (up-modify-goal gl-from-score__#000 g:= gl-from-animal-carry__#000)
            (up-modify-goal gl-from-score__#000 g:* gl-from-animal-task-count__#000)

            (up-modify-goal gl-to-score__#000 g:= gl-to-animal-carry__#000) ; jo mindre jo bedre
            (up-modify-goal gl-to-vills-missing__#000 g:= gl-from-animal-task-count__#000)
            (up-modify-goal gl-to-vills-missing__#000 g:- gl-to-animal-task-count__#000) ; jo mindre jo bedre
            (up-modify-goal gl-to-score__#000 g:* gl-to-vills-missing__#000)
        )

        (defrule
            (up-set-target-object search-remote g: gl-to-animal-index__#000)
            (up-object-data object-data-class == prey-animal-class)
            =>
            (up-modify-goal gl-to-score__#000 c:* 50)
            (up-modify-goal gl-to-score__#000 c:/ 100)
        )

        (defrule
            (up-set-target-object search-remote g: gl-from-animal-index__#000)
            (up-object-data object-data-class == prey-animal-class)
            =>
            (up-modify-goal gl-from-score__#000 c:* 115)
            (up-modify-goal gl-from-score__#000 c:/ 100)
        )

        (defrule
            (up-set-target-object search-remote g: gl-to-animal-index__#000)
            (up-object-data object-data-class == predator-animal-class)
            =>
            (up-modify-goal gl-to-score__#000 c:* 150)
            (up-modify-goal gl-to-score__#000 c:/ 100)
        )

        (defrule
            (up-set-target-object search-remote g: gl-from-animal-index__#000)
            (up-object-data object-data-class == predator-animal-class)
            =>
            (up-modify-goal gl-from-score__#000 c:* 150)
            (up-modify-goal gl-from-score__#000 c:/ 100)
        )

        (defrule
            (true)
            =>
            (up-modify-goal gl-from-vill-excess__#000 g:= gl-from-animal-task-count__#000)
            (up-modify-goal gl-from-vill-excess__#000 g:- gl-to-animal-task-count__#000)
        )

        (defrule
            (up-compare-goal gl-overload-food-build == YES)
            (up-set-target-object search-remote g: gl-to-animal-index__#000)
            (up-object-data object-data-class == livestock-class)
            =>
            (up-modify-goal gl-to-score__#000 c:= 2500)
        )

        (defrule
            (up-compare-goal gl-overload-food-build == YES)
            (up-set-target-object search-remote g: gl-from-animal-index__#000)
            (up-object-data object-data-class == livestock-class)
            (up-compare-goal gl-from-animal-task-count__#000 >= 6)
            =>
            (up-modify-goal gl-from-score__#000 c:+ 3000)
        )

        (defrule
            (true)
            =>
            (up-modify-goal gl-combined-score__#000 g:= gl-from-score__#000)
            (up-modify-goal gl-combined-score__#000 g:- gl-to-score__#000)
            
        )

            
        (defrule ; denne regel skal splittes i 2 så best scores for from og to gemmes for sig. Til sidst skal der så laves tjek af om transfer er legal.
            (up-compare-goal gl-combined-score__#000 g:> gl-best-score__#000)
            (up-compare-goal gl-combined-score__#000 > 20) ; måske vi også bør kunne håndtere flere forbidden id's
            (up-compare-goal gl-from-animal-index__#000 g:!= gl-to-animal-index__#000)
            (up-compare-goal gl-to-animal-index__#000 g:!= gl-forbidden-index__#000)
            (up-compare-goal gl-from-vill-excess__#000 >= 1)
            (up-set-target-object search-remote g: gl-from-animal-index__#000)
            (up-set-target-object search-remote g: gl-to-animal-index__#000)
            =>
            (up-modify-goal gl-best-score__#000 g:= gl-combined-score__#000)
            (up-modify-goal gl-best-to-id__#000 g:= gl-to-animal-id__#000)
            (up-modify-goal gl-best-to-index__#000 g:= gl-to-animal-index__#000)
            (up-modify-goal gl-best-to-task-count__#000 g:= gl-to-animal-task-count__#000)
            (up-modify-goal gl-best-from-id__#000 g:= gl-from-animal-id__#000)
            (up-modify-goal gl-best-from-index__#000 g:= gl-from-animal-index__#000)
            (up-modify-goal gl-best-from-task-count__#000 g:= gl-from-animal-task-count__#000)
        )

        (defrule
            (up-compare-goal gl-from-animal-index__#000 g:< gl-animal-max-index__#000)
            (up-compare-goal gl-retask-animal-first-rule-id__#000 != -1)
            =>
            (up-modify-goal gl-from-animal-index__#000 c:+ 1)
            
            (up-jump-direct g: gl-retask-animal-first-rule-id__#000)
        )

        (defrule
            (up-compare-goal gl-from-animal-index__#000 g:>= gl-animal-max-index__#000)
            (up-compare-goal gl-to-animal-index__#000 g:< gl-animal-max-index__#000)
            (up-compare-goal gl-retask-animal-first-rule-id__#000 != -1)
            =>
            (up-modify-goal gl-to-animal-index__#000 c:+ 1)
            (up-modify-goal gl-from-animal-index__#000 c:= 0)
            
            (up-jump-direct g: gl-retask-animal-first-rule-id__#000)
        )

        (defrule
            (up-set-target-by-id g: gl-best-from-id__#000)
            (up-set-target-by-id g: gl-best-to-id__#000)
            =>
            (up-remove-objects search-local object-data-target-id g:!= gl-best-from-id__#000)
            (up-get-object-data object-data-precise-x gl-temp-x)
            (up-get-object-data object-data-precise-y gl-temp-y)
            (up-set-precise-target-point gl-temp-x)
            (up-clean-search search-local object-data-to-precise search-order-asc)
        )

        (defrule
            (up-set-target-by-id g: gl-best-from-id__#000)
            (up-set-target-by-id g: gl-best-to-id__#000)
            (up-set-target-object search-local c: 0)
            =>
            (up-get-object-data object-data-id gl-transfer-vill-id__#000)
        )

        (defrule
            (up-set-target-by-id g: gl-best-from-id__#000)
            (up-set-target-object search-local c: 0)
            (up-set-target-by-id g: gl-best-to-id__#000)
            (up-compare-goal gl-reset-score-first-rule-id__#000 != -1)
            =>
            (up-remove-objects search-local object-data-index != 0)
            (up-target-objects 1 action-default -1 -1)
            (up-modify-goal gl-forbidden-index__#000 g:= gl-best-from-index__#000)

            (up-modify-goal gl-current-goal-constant__#000 c:= gl-first-task-count-goal-constant__#000)
            (up-modify-goal gl-current-goal-constant__#000 g:+ gl-best-from-index__#000)
            (up-modify-goal gl-best-from-task-count__#000 c:- 1)
            (up-set-indirect-goal g: gl-current-goal-constant__#000 g: gl-best-from-task-count__#000)
            (up-modify-goal gl-current-goal-constant__#000 c:= gl-first-task-count-goal-constant__#000)
            (up-modify-goal gl-current-goal-constant__#000 g:+ gl-best-to-index__#000)
            (up-modify-goal gl-best-to-task-count__#000 c:+ 1)
            (up-set-indirect-goal g: gl-current-goal-constant__#000 g: gl-best-to-task-count__#000)

            (up-reset-search 1 1 0 0)
            (up-set-group search-local c: temp-group1)
            (up-remove-objects search-local object-data-id g:== gl-transfer-vill-id__#000)
            (up-reset-group c: temp-group1)
            (up-create-group 0 0 c: temp-group1)
            ;(up-chat-data-to-all "gl-best-score: %d" g: gl-best-score)
            (up-jump-direct g: gl-reset-score-first-rule-id__#000)
        )

    ; chicken micro
        

        (defrule
            (true)
            =>
            (set-goal gl-chicken-dropsite-index__#000 0)
        )

        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: town-center c: 240)
            (up-find-local c: mill c: 240)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-chicken-dropsite-max-index__#000 g:= gl-local-total)
            (up-modify-goal gl-chicken-dropsite-max-index__#000 c:- 1)
        )

        (defrule
            (up-set-target-object search-local g: gl-chicken-dropsite-index__#000)
            =>
            (up-get-point position-object gl-temp-x)
            (up-set-target-point gl-temp-x)
            (up-set-group search-remote c: scouted-animal-group)
            (up-remove-objects search-remote object-data-class != prey-animal-class)
            (up-remove-objects search-remote object-data-status == status-ready)
            (up-remove-objects search-remote object-data-carry > 100)
            (up-remove-objects search-remote object-data-carry < 10)
            (up-remove-objects search-remote object-data-distance > 5)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-dead-chicken-count__#000 g:= gl-remote-total)
            (up-reset-search 0 0 1 1)
            (up-set-group search-remote c: scouted-animal-group)
            (up-remove-objects search-remote object-data-class != prey-animal-class)
            (up-remove-objects search-remote object-data-hitpoints == 0)
            (up-remove-objects search-remote object-data-carry > 100)
            (up-remove-objects search-remote object-data-distance > 5)
            (up-remove-objects search-remote object-data-tasks-count > 0)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-live-chicken-count__#000 g:= gl-remote-total)
            ;(up-set-target-point gl-position-self-x)
            (up-reset-search 1 1 0 0)
            (up-find-local c: villager-class c: 240)
            (up-remove-objects search-local object-data-group-flag != food-group)
            (up-remove-objects search-local object-data-target == building-class)
            (up-clean-search search-remote object-data-precise-distance search-order-asc)
        )

        (defrule
            (true)
            =>
            ;(up-chat-data-to-all "found %d live chickens around dropsite" g: gl-live-chicken-count)
            ;(up-chat-data-to-all "found %d dead chickens around dropsite" g: gl-dead-chicken-count)
            ;(up-chat-data-to-all "gl-chicken-dropsite-index: %d" g: gl-chicken-dropsite-index)
            ;(up-chat-data-to-all "gl-chicken-dropsite-max-index: %d" g: gl-chicken-dropsite-max-index)
            (do-nothing)
        )

        (defrule
            (up-compare-goal gl-live-chicken-count__#000 > 0)
            (up-compare-goal gl-dead-chicken-count__#000 == 0)
            (up-set-target-object search-local c: 0)
            (up-set-target-object search-remote c: 0)
            =>
            (up-get-object-data object-data-id gl-target-chicken-id__#000)
            (up-get-point position-object gl-temp-x)
            (up-set-target-point gl-temp-x)
            (up-clean-search search-local object-data-precise-distance search-order-asc)
            (up-remove-objects search-local object-data-index != 0)
            (up-add-object-by-id search-remote g: gl-target-chicken-id__#000)
        )

        (defrule
            (up-compare-goal gl-live-chicken-count__#000 > 0)
            (up-compare-goal gl-dead-chicken-count__#000 == 0)
            (up-set-target-object search-remote c: 0)
            (up-set-target-object search-local c: 0)
            =>
            (up-get-object-data object-data-target-id gl-vill-target-id__#000)
        )

        (defrule
            (up-compare-goal gl-live-chicken-count__#000 > 0)
            (up-compare-goal gl-dead-chicken-count__#000 == 0)
            (up-set-target-object search-remote c: 0)
            (up-set-target-object search-local c: 0)
            (up-set-target-by-id g: gl-vill-target-id__#000)
            (or(up-object-data object-data-status == status-ready)
            (or(up-object-data object-data-status == status-down)
            (up-object-data object-data-carry > 20)))
            =>
            ;(chat-to-all "target is dying, dont attack again")
            (up-jump-rule 2)
        )

        (defrule
            
            (up-compare-goal gl-live-chicken-count__#000 > 0)
            (up-compare-goal gl-dead-chicken-count__#000 == 0)
            (up-set-target-object search-local c: 0)
            (not(and(up-set-target-by-id g: gl-chicken-killer-id__#000)
            (up-object-target-data object-data-carry > 20)))
            (up-set-target-object search-remote c: 0)
            =>
            (up-target-objects 0 action-default -1 -1)
            (chat-to-all "kill chicken")
            (up-get-object-data object-data-id gl-chicken-killer-id__#000)
            (up-jump-rule 1)
        )

        (defrule
            (up-compare-goal gl-chicken-dropsite-index__#000 g:< gl-chicken-dropsite-max-index__#000)
            =>
            (up-modify-goal gl-chicken-dropsite-index__#000 c:+ 1)
            (up-jump-rule -8)
        )

        (defrule
            (true)
            =>
            (set-goal gl-chicken-vill-index__#000 0)
        )


        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 240)
            (up-remove-objects search-local object-data-group-flag != food-group)
            (up-remove-objects search-local object-data-language-id == lid-villager-builder)
            (up-remove-objects search-local object-data-target != prey-animal-class)
            ;(up-remove-objects search-local object-data-carry == 0)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-chicken-vill-max-index__#000 g:= gl-local-total)
            (up-modify-goal gl-chicken-vill-max-index__#000 c:- 1)
            (up-set-group search-remote c: scouted-animal-group)
            (up-remove-objects search-remote object-data-class != prey-animal-class)
            (up-remove-objects search-remote object-data-carry < 10)
            (up-remove-objects search-remote object-data-hitpoints > 0)
        )

        (defrule
            (up-set-target-object search-local g: gl-chicken-vill-index__#000)
            =>
            (up-get-object-target-data object-data-carry gl-temp)
        )

        (defrule
            (up-set-target-object search-local g: gl-chicken-vill-index__#000)
            (up-compare-goal gl-temp < 10)
            =>
            (up-get-point position-object gl-temp-x)
            (up-set-target-point gl-temp-x)
            (up-clean-search search-remote object-data-precise-distance search-order-asc)
        )

        (defrule
            (up-set-target-object search-local g: gl-chicken-vill-index__#000)
            (up-set-target-object search-remote c: 0)
            (up-compare-goal gl-temp < 10)
            =>
            (up-remove-objects search-local object-data-index g:!= gl-chicken-vill-index__#000)
            (up-modify-sn sn-keystates c:= 1)
            (up-target-objects 0 action-default -1 -1)
            (up-modify-sn sn-keystates c:= 0)
            ;(up-chat-data-to-all "trying to target next chicken with vill index %d" g: gl-chicken-vill-index)
        )

        (defrule
            (up-compare-goal gl-chicken-vill-index__#000 g:< gl-chicken-vill-max-index__#000)
            =>
            (up-modify-goal gl-chicken-vill-index__#000 c:+ 1)
            (up-jump-rule -5)
        )

    ; Detect vills on sub-optimal res tiles on non-wood res
        (defrule
            (true)
            =>
            (set-goal gl-res food)
            (set-goal gl-current-vill-group food-group)
        )

        (defrule
            (true)
            =>
            (up-get-rule-id gl-new-res-first-rule-id)
        )

        (defrule
            (up-compare-goal gl-res == wood)
            =>
            (up-modify-goal gl-res c:+ 1)
            (up-modify-goal gl-current-vill-group c:+ 1)
            (up-jump-rule -2)
        )

        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 200)
            (up-remove-objects search-local object-data-group-flag g:!= gl-current-vill-group)
            (up-remove-objects search-local object-data-carry > 0)
            (up-remove-objects search-local object-data-tasks-count > 0)
            (up-remove-objects search-local object-data-language-id == lid-villager-builder)
        )

        (defrule
            (up-compare-goal gl-res == food)
            =>
            (up-remove-objects search-local object-data-language-id != lid-villager-forager)
            (up-remove-objects search-local object-data-target != forage-class)
        )

        (defrule
            (up-compare-goal gl-res == gold)
            =>
            (up-remove-objects search-local object-data-language-id != lid-villager-gold-miner)
            (up-remove-objects search-local object-data-target != gold-mine-class)
        )

        (defrule
            (up-compare-goal gl-res == stone)
            =>
            (up-remove-objects search-local object-data-language-id != lid-villager-stone-miner)
            (up-remove-objects search-local object-data-target != stone-mine-class)
        )

        (defrule
            (true)
            =>
            (up-reset-group g: gl-current-vill-group)
            (up-create-group 0 0 g: gl-current-vill-group)
            (up-full-reset-search)
            (up-find-local c: town-center c: 10)
        )

        (defrule
            (up-compare-goal gl-res == food)
            =>
            (up-find-local c: mill c: 200)
        )
        (defrule
            (or(up-compare-goal gl-res == gold)
            (up-compare-goal gl-res == stone))
            =>
            (up-find-local c: mining-camp c: 200)
        )

        (defrule
            (true)
            =>
            (up-reset-group c: dropsite-group)
            (up-create-group 0 0 c: dropsite-group)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-dropsite-max-index g:= gl-local-total)
            (up-modify-goal gl-dropsite-max-index c:- 1)
            (set-goal gl-dropsite-index 0)
            (up-full-reset-search)
            (up-set-target-point gl-position-self-x)
            (up-filter-distance c: -1 c: 40)
            (up-filter-status c: status-resource c: list-active)
            (up-find-resource g: gl-res c: 40) 
            (up-remove-objects search-remote object-data-tasks-count >= 3)
            (up-filter-distance c: 40 c: 60)
            (up-find-resource g: gl-res c: 40) 
            (up-remove-objects search-remote object-data-tasks-count >= 3)
            (up-filter-distance c: 60 c: 300)
            (up-find-resource g: gl-res c: 40) 
            (up-remove-objects search-remote object-data-tasks-count >= 3)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            =>
            (up-get-object-data object-data-id gl-temp)
            (up-add-object-by-id search-local g: gl-temp)
            (up-remove-objects search-remote object-data-index == 0)
            (up-jump-rule -1)
        )

        (defrule
            (true)
            =>
            (up-reset-group c: current-res-group)
            (up-create-group 0 0 c: current-res-group)
        )

        (defrule
            (true)
            =>
            (up-get-rule-id gl-new-dropsite-first-rule-id)
            (up-full-reset-search)
            (up-set-group search-local c: dropsite-group)
        )

        (defrule
            (up-set-target-object search-local g: gl-dropsite-index)
            =>
            (up-get-point position-object gl-current-dropsite-x)
            (up-set-target-point gl-current-dropsite-x)
            (up-set-group search-remote c: current-res-group)
            (up-remove-objects search-remote object-data-precise-distance >= 500)
            (up-clean-search search-remote object-data-precise-distance search-order-asc)
            (set-goal gl-best-res-tile-id -1)
            (set-goal gl-closest-res-tile-precise-distance 99999)
        )

        (defrule
            (up-set-target-object search-local g: gl-dropsite-index)
            (up-set-target-object search-remote c: 0)
            =>
            (up-get-point position-object gl-res-x)
            (up-copy-point gl-top-right-x gl-res-x)
            (up-modify-goal gl-top-right-x c:+ 1)
            (up-copy-point gl-bot-right-x gl-res-x)
            (up-modify-goal gl-bot-right-y c:+ 1)
            (up-copy-point gl-bot-left-x gl-res-x)
            (up-modify-goal gl-bot-left-x c:- 1)
            (up-copy-point gl-top-left-x gl-res-x)
            (up-modify-goal gl-top-left-y c:- 1)
        )

        (defrule
            (or(up-can-build-line 0 gl-top-right-x c: palisade-wall)
            (or(up-can-build-line 0 gl-bot-right-x c: palisade-wall)
            (or(up-can-build-line 0 gl-bot-left-x c: palisade-wall)
            (up-can-build-line 0 gl-top-left-x c: palisade-wall))))
            (up-set-target-object search-local g: gl-dropsite-index)
            (up-set-target-object search-remote c: 0)
            =>
            (up-get-object-data object-data-id gl-best-res-tile-id)
            (up-get-point position-object gl-best-res-tile-x)
            (up-copy-point gl-current-dropsite-precise-x gl-current-dropsite-x)
            (up-modify-goal gl-current-dropsite-precise-x c:* 100)
            (up-modify-goal gl-current-dropsite-precise-y c:* 100)
            (up-modify-goal gl-current-dropsite-precise-x c:+ 25)
            (up-modify-goal gl-current-dropsite-precise-y c:+ 50)
            (up-copy-point gl-best-res-tile-precise-x gl-best-res-tile-x)
            (up-modify-goal gl-best-res-tile-precise-x c:* 100)
            (up-modify-goal gl-best-res-tile-precise-y c:* 100)
            (up-get-point-distance gl-current-dropsite-precise-x gl-best-res-tile-precise-x gl-closest-res-tile-precise-distance)
            (up-jump-rule 1)
        )

        (defrule
            (up-set-target-object search-local g: gl-dropsite-index)
            (up-set-target-object search-remote c: 0)
            =>
            (up-remove-objects search-remote object-data-index == 0)
            (up-jump-rule -3)
        )

        (defrule
            (true)
            =>
            (set-goal gl-vill-index 0)
        )

        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-set-group search-local g: gl-current-vill-group)
            (up-remove-objects search-local object-data-target-id g:== gl-best-res-tile-id)
            (up-set-target-point gl-best-res-tile-x)
            (up-remove-objects search-local object-data-distance >= 15)
            (up-remove-objects search-local object-data-distance <= 5)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-vill-max-index g:= gl-local-total)
            (up-modify-goal gl-vill-max-index c:- 1)
        )

        (defrule
            (up-set-target-object search-local g: gl-vill-index)
            =>
            (up-get-object-data object-data-target-id gl-temp)
            (up-get-object-data object-data-precise-x gl-vill-precise-x)
            (up-get-object-data object-data-precise-y gl-vill-precise-y)
            (up-get-object-target-data object-data-precise-x gl-vill-target-precise-x)
            (up-get-object-target-data object-data-precise-y gl-vill-target-precise-y)
            (up-get-point-distance gl-vill-target-precise-x gl-current-dropsite-precise-x gl-vill-res-tile-precise-distance)
        )

        (defrule
            (up-set-target-object search-local g: gl-vill-index)
            (up-point-distance gl-vill-target-precise-x gl-best-res-tile-precise-x < 300)
            (up-compare-goal gl-vill-res-tile-precise-distance g:> gl-closest-res-tile-precise-distance)
            (up-set-target-by-id g: gl-best-res-tile-id)
            =>
            (up-get-search-state gl-local-total)
            (up-chat-data-to-all "we have %d local unit to retarget before" g: gl-local-total)
            (up-remove-objects search-local object-data-index g:!= gl-vill-index)
            (up-get-search-state gl-local-total)
            (up-chat-data-to-all "we have %d local unit to retarget after" g: gl-local-total)
            (up-target-objects 1 action-default -1 -1)
            (up-chat-data-to-all "sending vill to closer res with dist: %d" g: gl-closest-res-tile-precise-distance)
            (up-chat-data-to-all "indstead of: %d" g: gl-vill-res-tile-precise-distance)
            (up-chat-data-to-all "current-target id: %d" g: gl-temp)
            (up-chat-data-to-all "new target id: %d" g: gl-best-res-tile-id)
            (up-chat-data-to-all "target res is: %d" g: gl-res)

            (up-jump-rule 1)
        )

        (defrule
            (up-compare-goal gl-vill-index g:< gl-vill-max-index)
            =>
            (up-modify-goal gl-vill-index c:+ 1)
            (up-jump-rule -4)
        )

        (defrule
            (up-compare-goal gl-new-dropsite-first-rule-id != -1)
            (up-compare-goal gl-dropsite-index g:< gl-dropsite-max-index)
            =>
            (up-modify-goal gl-dropsite-index c:+ 1)
            (up-jump-direct g: gl-new-dropsite-first-rule-id)
        )

        (defrule
            (up-compare-goal gl-res < gold)
            =>
            (up-modify-goal gl-res c:+ 1)
            (up-modify-goal gl-current-vill-group c:+ 1)
            (up-jump-direct g: gl-new-res-first-rule-id)
        )

    ; Detect long distant dropff at pending dropsites to send vills as builders.

        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-filter-status c: status-pending c: list-active)
            (up-modify-sn sn-focus-player-number c:= my-player-number)
            (up-find-status-remote c: mill c: 200)
            (up-find-status-remote c: lumber-camp c: 200)
            (up-find-status-remote c: mining-camp c: 200)
            ;(up-find-status-remote c: town-center-foundation c: 200)
            (up-remove-objects search-remote object-data-index != 0)
            (set-goal gl-vill-index 0)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            =>
            (up-reset-search 1 1 0 0)
            (up-reset-filters)
            (up-get-point position-object gl-temp-x)
            (up-set-target-point gl-temp-x)
            (up-filter-distance c: -1 c: 3)
            (up-find-local c: villager-class c: 200)
            (up-remove-objects search-local object-data-carry < 9)
            (up-remove-objects search-local object-data-language-id == lid-villager-builder)
            (up-remove-objects search-local object-data-tasks-count > 0)
            (up-remove-objects search-local object-data-id g:== gl-luring-vill-id__#000)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-vill-max-index g:= gl-local-total)
            (up-modify-goal gl-vill-max-index c:- 1)
            (set-goal gl-vill-target -1)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            (up-set-target-object search-local g: gl-vill-index)
            =>
            (up-get-object-data object-data-target-id gl-vill-target)
            (up-remove-objects search-local object-data-index g:!= gl-vill-index)
            (up-target-objects 0 action-default -1 -1)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            (up-set-target-object search-local c: 0)
            (up-set-target-by-id g: gl-vill-target)
            =>
            (up-modify-sn sn-keystates c:= 1)
            (up-get-point position-object gl-temp-x)
            (up-target-point gl-temp-x action-default -1 -1)
            (up-target-objects 1 action-default -1 -1)
            (up-modify-sn sn-keystates c:= 0)
        )

        (defrule
            (up-compare-goal gl-vill-index g:< gl-max-vill-index)
            =>
            (up-modify-goal gl-vill-index c:+ 1)
            (up-jump-rule -4)
        )



    

; DUC building engine module #011 - #016
    ; Description
        ;This entire module is controlled by gl-build. When this goal is set the subscript responsable for placing
        ;the chosen building will do so. Only one building can be placed each tick. When setting gl-build 3
        ;conditions must be true: 
        ;1 (can-afford-building)
        ;2 (building-available)
        ;3 (goal gl-build -1)
        ;For most buildings gl-build should just be set to the building name. However some buildings has custom
        ;constants like Gold-mines and Farming-mills.
        ;Each building pplacement subscript has a section where the most relevant variables controlling placement can
        ;be changed making it very easy to modify behavior and reducing lag if nessesary.
        
        
    ; Sending builders to build #011
        ; Prepare data for sending tc builders

            (defrule
                (true)
                =>
                (set-goal gl-pending-tc -1)
                (up-full-reset-search)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: town-center-foundation c: 10)
                (up-remove-objects search-local object-data-tasks-count >= 4)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (set-goal gl-pending-tc YES)
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-filter-distance c: -1 c: 7)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: gold c: 20)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-gold-found g:= gl-remote-total)
                (up-reset-search 0 0 1 1)
                (up-find-resource c: stone c: 20)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-stone-found g:= gl-remote-total)
                (up-find-resource c: food c: 20)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-food-found g:= gl-remote-total)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 20)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-wood-found g:= gl-remote-total)
            )

        ; Prepare data to make sure wolves won't send builders back

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (set-strategic-number sn-focus-player-number 0)
                (up-find-remote c: predator-animal-class c: 40)
                ;(up-remove-objects search-remote object-data-target != villager-class)
                (set-goal gl-first-wolf-vill-id__#011 -1)
                (set-goal gl-second-wolf-vill-id__#011 -1)
                (set-goal gl-third-wolf-vill-id__#011 -1)
                (set-goal gl-first-wolf-building-constant__#011 -1)
                (set-goal gl-second-wolf-building-constant__#011 -1)
                (set-goal gl-third-wolf-building-constant__#011 -1)
                (set-goal gl-forth-wolf-building-constant__#011 -1)
                (set-goal gl-fifth-wolf-building-constant__#011 -1)
                (set-goal gl-sixth-wolf-building-constant__#011 -1)
                (set-goal gl-seventh-wolf-building-constant__#011 -1)
                (set-goal gl-eigth-wolf-building-constant__#011 -1)
                (set-goal gl-nineth-wolf-building-constant__#011 -1)
                (set-goal gl-last-wolf-building-constant__#011 -1)
                (up-get-search-state gl-local-total)
            )   

            (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-modify-goal gl-index__#011 g:= gl-first-wolf-id__#052)
            )

            (defrule
            (up-set-target-by-id g: gl-index__#011)
            (up-object-data object-data-class == predator-animal-class)
            (up-object-data object-data-carry == 0)
            (up-object-data object-data-hitpoints > 0)
            =>
            (up-get-point position-object gl-temp-x)
            )

            (defrule
            (up-set-target-by-id g: gl-index__#011)
            (up-object-data object-data-class == predator-animal-class)
            (up-object-data object-data-carry == 0)
            (up-object-data object-data-hitpoints > 0)
            (up-point-explored gl-temp-x != explored-no)
            =>
            (up-get-object-data object-data-id gl-temp)
            (up-add-object-by-id search-remote g: gl-temp)
            )

            (defrule
                (up-compare-goal gl-index__#011 g:< gl-last-wolf-id__#052)
                =>
                (up-modify-goal gl-index__#011 c:+ 1)
                (up-jump-rule -3)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-target-id gl-first-wolf-vill-id__#011)
                (up-remove-objects search-remote object-data-index == 0)
            )
            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-target-id gl-second-wolf-vill-id__#011)
                (up-remove-objects search-remote object-data-index == 0)
            )
            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-target-id gl-third-wolf-vill-id__#011)
            )

            ; hvis en bygning har en wolf vill som closest vill fjernes den fra listen senere.

            (defrule
                (true)
                =>
                (set-goal gl-building-index__#011 0)
                (set-goal gl-current-goal-constant__#011 gl-first-wolf-building-constant__#011)
            )
            (defrule
                (up-compare-goal gl-first-wolf-vill-id__#011 != -1)
                =>
                (up-full-reset-search)
                (up-modify-sn sn-focus-player-number c:= my-player-number)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-remote c: building-class c: 40)
                ;(up-find-status-remote c: tower-class c: 40)
                (up-find-status-remote c: farm c: 40)
                (up-remove-objects search-remote object-data-tasks-count > 0)
                (up-get-search-state gl-local-total)
                (up-reset-filters)
                (up-find-local c: villager-class c: 200)
            )   

            (defrule
                (up-set-target-object search-remote g: gl-building-index__#011)
                (up-compare-goal gl-first-wolf-vill-id__#011 != -1)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                (or(up-object-data object-data-id g:== gl-first-wolf-vill-id__#011)
                (or(up-object-data object-data-id g:== gl-second-wolf-vill-id__#011)
                (up-object-data object-data-id g:== gl-third-wolf-vill-id__#011)))
                (up-compare-goal gl-current-goal-constant__#011 < gl-last-wolf-building-constant__#011)
                (up-set-target-object search-remote g: gl-building-index__#011)
                =>
                (up-get-object-data object-data-id gl-temp)
                (up-set-indirect-goal g: gl-current-goal-constant__#011 g: gl-temp)
                (up-modify-goal gl-building-index__#011 c:+ 1)
                (up-modify-goal gl-current-goal-constant__#011 c:+ 1)
                (up-jump-rule -3)
            )

            (defrule
                (up-set-target-object search-remote g: gl-building-index__#011)
                =>
                (up-modify-goal gl-building-index__#011 c:+ 1)
                (up-jump-rule -4)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-first-wolf-vill-id__#011)
                (up-add-object-by-id search-local g: gl-second-wolf-vill-id__#011)
                (up-add-object-by-id search-local g: gl-third-wolf-vill-id__#011)
                (up-add-object-by-id search-remote g: gl-first-wolf-building-constant__#011)
                (up-add-object-by-id search-remote g: gl-second-wolf-building-constant__#011)
                (up-add-object-by-id search-remote g: gl-third-wolf-building-constant__#011)
                (up-add-object-by-id search-remote g: gl-forth-wolf-building-constant__#011)
                (up-add-object-by-id search-remote g: gl-fifth-wolf-building-constant__#011)
                (up-add-object-by-id search-remote g: gl-sixth-wolf-building-constant__#011)
                (up-add-object-by-id search-remote g: gl-seventh-wolf-building-constant__#011)
                (up-add-object-by-id search-remote g: gl-eigth-wolf-building-constant__#011)
                (up-add-object-by-id search-remote g: gl-nineth-wolf-building-constant__#011)
                (up-add-object-by-id search-remote g: gl-last-wolf-building-constant__#011)
                (up-remove-objects search-local object-data-target != predator-animal-class)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-clean-search search-remote object-data-precise-distance search-order-asc)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                (up-set-target-object search-remote c: 0)
                =>
                (up-remove-objects search-local object-data-index != 0)
                (up-remove-objects search-remote object-data-index != 0)
                (up-modify-sn sn-keystates c:= 1)
                (up-target-objects 0 action-default -1 -1)
                (up-modify-sn sn-keystates c:= 0)
            )

        ; Find pending buildings that need vills
            
            (defrule
                (goal gl-pending-tc YES)
                =>
                (up-full-reset-search)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: town-center-foundation c: 40)
                ;(up-find-status-local c: tower-class c: 40)
                (up-remove-objects search-local object-data-tasks-count > 4)
                (up-get-search-state gl-local-total)
                ;(up-chat-data-to-all "found %d pending buildings" g: gl-local-total)
                (set-goal gl-current-goal-constant__#011 gl-first-wolf-building-constant__#011)
                (up-jump-rule 1)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: building-class c: 40)
                ;(up-find-status-local c: tower-class c: 40)
                (up-find-status-local c: farm c: 40)
                (up-remove-objects search-local object-data-tasks-count > 0)
                (up-get-search-state gl-local-total)
                ;(up-chat-data-to-all "found %d pending buildings" g: gl-local-total)
                (set-goal gl-current-goal-constant__#011 gl-first-wolf-building-constant__#011)
            )   

            (defrule
                (up-compare-goal gl-current-goal-constant__#011 < gl-last-wolf-building-constant__#011)
                (up-compare-goal gl-first-wolf-building-constant__#011 != -1)
                =>
                (up-get-indirect-goal g: gl-current-goal-constant__#011 gl-temp)
                (up-remove-objects search-local object-data-id g:== gl-temp)
                (up-modify-goal gl-current-goal-constant__#011 c:+ 1)
                (up-jump-rule -1)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (chat-to-all "looking for stone")
                (up-get-object-data object-data-id gl-pending-building-id__#011)
                (up-get-object-data object-data-type gl-pending-building-type__#011)
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-filter-distance c: -1 c: 4)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: gold c: 20)
                (up-find-resource c: stone c: 20)
                (up-clean-search search-remote object-data-precise-distance search-order-asc)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-type == mining-camp)
                (up-set-target-object search-remote c: 0)
                (up-object-data object-data-class == gold-mine-class)
                =>
                (set-goal gl-pending-building-type__#011 Gold-mining-camp)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-type == mining-camp)
                (up-set-target-object search-remote c: 0)
                (up-object-data object-data-class == stone-mine-class)
                =>
                (set-goal gl-pending-building-type__#011 Stone-mining-camp)
            )

        ; Find builders

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-language-id == lid-villager-builder)
                (up-remove-objects search-local object-data-language-id == lid-villager-farmer)
                (up-remove-objects search-local object-data-group-flag > 4)
                (up-remove-objects search-local object-data-tasks-count > 0) ; need to find a clever solution to do this while excluding vills attacked by wolves.
                ;(up-remove-objects search-local object-data-id g:== gl-chicken-vill-1-id__#000)
                ;(up-remove-objects search-local object-data-id g:== gl-chicken-vill-2-id__#000)
                ;(up-remove-objects search-local object-data-id g:== gl-chicken-vill-3-id__#000)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (goal gl-pending-tc YES)
                (up-compare-goal gl-nr-gold-found == 0)
                =>
                (up-remove-objects search-local object-data-group-flag == gold-group)
                (up-get-search-state gl-local-total)
            )
            (defrule
                (goal gl-pending-tc YES)
                (up-compare-goal gl-nr-stone-found == 0)
                =>
                (up-remove-objects search-local object-data-group-flag == stone-group)
                (up-get-search-state gl-local-total)
            )
            (defrule
                (goal gl-pending-tc YES)
                (up-compare-goal gl-nr-food-found == 0)
                =>
                (up-remove-objects search-local object-data-group-flag == food-group)
                (up-get-search-state gl-local-total)
            )
            (defrule
                (goal gl-pending-tc YES)
                (up-compare-goal gl-nr-wood-found < 3)
                =>
                (up-remove-objects search-local object-data-group-flag == wood-group)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-pending-building-type__#011 != farm)
                =>
                (up-remove-objects search-local object-data-hitpoints < 25) ; need to find a clever solution to do this while excluding vills attacked by wolves.
                (do-nothing)
            )

            (defrule
                (up-compare-goal gl-pending-building-type__#011 == lumber-camp)
                =>
                (up-remove-objects search-local object-data-group-flag != wood-group)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-pending-building-type__#011 == Gold-mining-camp)
                =>
                (up-remove-objects search-local object-data-group-flag != gold-group)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-pending-building-type__#011 == Stone-mining-camp)
                =>
                (up-remove-objects search-local object-data-group-flag != stone-group)
                (up-get-search-state gl-local-total)
                ;(chat-to-all "rule running")
            )

            (defrule
                (or(up-compare-goal gl-pending-building-type__#011 == mill)
                (up-compare-goal gl-pending-building-type__#011 == farm))
                =>
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-pending-building-type__#011 == farm)
                (idle-farm-count == 0)
                =>
                (up-remove-objects search-local object-data-language-id == lid-villager-farmer)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-local-total == 0)
                =>
                ;(chat-to-all "didn't find normal builders")
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-language-id == lid-villager-builder)
                (up-remove-objects search-local object-data-tasks-count > 0)
            )

            
            (defrule
                (true)
                =>
                (up-get-search-state gl-local-total)
                ;(up-chat-data-to-all "we have %d builders before removing" g: gl-local-total)
                (up-modify-goal gl-villager-index-number__#011 g:= gl-local-total)
                (up-modify-goal gl-villager-index-number__#011 c:- 1)
            )

            (defrule
                (up-compare-goal gl-villager-index-number__#011 > -1)
                (up-set-target-object search-local g: gl-villager-index-number__#011)
                =>
                (up-get-object-data object-data-target-id gl-villager-target-id__#011)
            )

            (defrule
                (up-compare-goal gl-villager-index-number__#011 > -1)
                (up-set-target-object search-local g: gl-villager-index-number__#011)
                (up-set-target-by-id g: gl-villager-target-id__#011)
                (or(up-object-data object-data-status == status-pending)
                (up-object-data object-data-type == town-center))
                =>
                ;(up-chat-data-to-all "remove index %d builder from list" g: gl-villager-index-number__#011)
                (up-remove-objects search-local object-data-index g:== gl-villager-index-number__#011)
                (up-modify-goal gl-villager-index-number__#011 c:- 1)
                (up-jump-rule -2)
            )

            (defrule
                (up-compare-goal gl-villager-index-number__#011 > -1)
                =>
                (up-modify-goal gl-villager-index-number__#011 c:- 1)
                (up-jump-rule -3)
            )

            (defrule
                (true)
                =>
                (up-clean-search search-local object-data-precise-distance search-order-asc)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                (up-compare-goal gl-pending-tc != YES)
                =>
                (set-strategic-number sn-focus-player-number my-player-number)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-remote c: building-class c: 40)
                ;(up-find-status-remote c: tower-class c: 40)
                (up-find-status-remote c: farm c: 40)
                (up-remove-objects search-remote object-data-tasks-count > 0)
            (set-goal gl-current-goal-constant__#011 gl-first-wolf-building-constant__#011)
            )

            (defrule
                (up-compare-goal gl-pending-tc == YES)
                (up-set-target-object search-local c: 0)
                =>
                (set-strategic-number sn-focus-player-number my-player-number)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-remote c: town-center-foundation c: 40)
                (up-remove-objects search-remote object-data-tasks-count >= 4)
            (set-goal gl-current-goal-constant__#011 gl-first-wolf-building-constant__#011)
            )


            (defrule
                (up-compare-goal gl-current-goal-constant__#011 < gl-last-wolf-building-constant__#011)
                (up-compare-goal gl-first-wolf-building-constant__#011 != -1)
                =>
                (up-get-indirect-goal g: gl-current-goal-constant__#011 gl-temp)
                (up-remove-objects search-remote object-data-id g:== gl-temp)
                (up-modify-goal gl-current-goal-constant__#011 c:+ 1)
                ;(up-chat-data-to-all "remove building id %d from remote list nr 2" g: gl-temp)
                (up-jump-rule -1)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-clean-search search-remote object-data-precise-distance search-order-asc)
            )

        ; Target building

            (defrule
                (up-set-target-object search-local c: 0)
                (up-set-target-object search-remote c: 0)
                (up-object-data object-data-type != town-center-foundation)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                
                (up-clean-search search-local object-data-precise-distance search-order-asc)
                (up-get-search-state gl-local-total)
                ;(up-chat-data-to-all "send one of %d builders" g: gl-local-total)
                (up-remove-objects search-local object-data-index != 0)
                (up-target-objects 0 action-default -1 -1)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                (up-set-target-object search-remote c: 0)
                (up-object-data object-data-type == town-center-foundation)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                
                (up-clean-search search-local object-data-precise-distance search-order-asc)
                (up-get-object-data object-data-tasks-count gl-temp)
                (up-modify-goal gl-temp1 c:= 4)
                (up-modify-goal gl-temp1 g:- gl-temp)
                (up-remove-objects search-local object-data-index g:>= gl-temp1)
                (chat-to-all "found tc")
            )
            (defrule
                (up-set-target-object search-local c: 0)
                (up-set-target-object search-remote c: 0)
                (up-object-data object-data-type == town-center-foundation)
                =>
                (up-chat-data-to-all "trying to send %d extra builders to tc" g: gl-temp1)
                (up-target-objects 0 action-default -1 -1)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                (not(or(up-object-data object-data-type == mining-camp)
                (or(up-object-data object-data-type == lumber-camp)
                (or(up-object-data object-data-type == mill)
                (or(up-object-data object-data-type == farm)
                (up-object-data object-data-type == town-center-foundation))))))
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-target-data object-data-id gl-temp)
            )
            (defrule
                (up-set-target-object search-remote c: 0)
                (not(or(up-object-data object-data-type == mining-camp)
                (or(up-object-data object-data-type == lumber-camp)
                (or(up-object-data object-data-type == mill)
                (or(up-object-data object-data-type == farm)
                (up-object-data object-data-type == town-center-foundation))))))
                (up-set-target-object search-local c: 0)
                (up-set-target-by-id g: gl-temp)
                =>
                ;(chat-to-all "shift que vill")
                (up-modify-sn sn-keystates c:= 1)
                (up-target-point gl-temp-x action-default -1 -1)
                (up-target-objects 1 action-default -1 -1)
                (up-modify-sn sn-keystates c:= 0)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                (up-set-target-object search-remote c: 0)
                (up-object-data object-data-class == farm-class)
                =>
                (up-modify-sn sn-keystates c:= 1)
                (up-target-point gl-temp-x action-default -1 -1)
                (up-target-objects 0 action-default -1 -1)
                (up-modify-sn sn-keystates c:= 0)
                ;(chat-to-all "rule running")
            )

        ; Sending 1 additional vill to first house
            (defrule
                (game-time < 5)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-target == building-class)
                (up-modify-sn sn-focus-player-number c:= my-player-number)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-remote c: house c: 1)
                (up-remove-objects search-remote object-data-tasks-count > 1)
            )

            (defrule
                (game-time < 5)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-clean-search search-local object-data-distance search-order-asc)
                (up-remove-objects search-local object-data-index != 0)
            )

            (defrule
                (game-time < 5)
                (up-set-target-object search-local c: 0)
                =>
                (up-target-objects 0 action-default -1 -1)
            )
        ; Debug

            (defrule
                (taunt-detected my-player-number 102)
                =>
                (up-chat-data-to-all "gl-build is %d" g: gl-build)
            )  

    ; Skip building engine if gl-build is not set or cannot be afforded
            (defrule
                (true)
            =>
                (up-setup-cost-data 1 gl-cost-food)
                (up-add-object-cost g: gl-build c: 1)
                (up-get-cost-delta gl-delta-food)
                ;(up-chat-data-to-all "need %d for building" g: gl-delta-wood)
            )
            
            (defrule
                (or(up-compare-goal gl-build == Forward-watch-tower)
                (or(up-compare-goal gl-build == -1)
                (up-compare-goal gl-delta-wood < 0)))
                (up-compare-goal gl-post-build-engine-rule-id != -1)
                =>
                (up-jump-direct g: gl-post-build-engine-rule-id)
            )
    ; Jump to relevant building module
        (defrule
            (up-compare-goal gl-build != -1)
            (up-compare-goal gl-build != lumber-camp)
            (up-compare-goal gl-build != Stone-mining-camp)
            (up-compare-goal gl-build != Gold-mining-camp)
            (up-compare-goal gl-build != Berry-mill)
            (up-compare-goal gl-build != Farming-mill)
            (up-compare-goal gl-build != farm)
            (up-compare-goal gl-build != town-center)
            (up-compare-goal gl-normal-building-first-rule-id != -1)
            =>
            (up-jump-direct g: gl-normal-building-first-rule-id)
        )

        (defrule
            (up-compare-goal gl-build == farm)
            (up-compare-goal gl-normal-building-first-rule-id != -1)
            =>
            (up-jump-direct g: gl-farm-building-first-rule-id)
        )

        (defrule
            (or(up-compare-goal gl-build == lumber-camp)
            (or(up-compare-goal gl-build == Berry-mill)
            (or(up-compare-goal gl-build == Gold-mining-camp)
            (up-compare-goal gl-build == Stone-mining-camp))))
            (up-compare-goal gl-normal-building-first-rule-id != -1)
            =>
            (up-jump-direct g: gl-dropsite-building-first-rule-id)
        )
        (defrule
            (up-compare-goal gl-build == town-center)
            (up-compare-goal gl-normal-building-first-rule-id != -1)
            =>
            (up-jump-direct g: gl-town-center-building-first-rule-id)
        )
        (defrule
            (up-compare-goal gl-build == Farming-mill)
            (up-compare-goal gl-normal-building-first-rule-id != -1)
            =>
            (up-jump-direct g: gl-farming-mill-building-first-rule-id)
        )
    ; New normal building engine #012
        ; Jump here to build building
            (defrule
                (true)
                =>
                (up-get-rule-id gl-normal-building-first-rule-id)
            )
        ; Lag test

            (defrule
            (true)
            =>
            (up-modify-goal gl-temp g:= gl-last-time-checkpoint__#051)
            (up-get-precise-time gl-script-start-time__#051 gl-last-time-checkpoint__#051)
            (up-modify-goal gl-temp g:- gl-last-time-checkpoint__#051)
            (up-modify-goal gl-temp1 g:neg gl-temp)
            (up-modify-goal gl-temp g:max gl-temp1)
            )
        

        ; Controll center (Ajust numbers for lag and behavior)
            (defrule
                (true)
                =>
                (set-goal gl-starting-max-distance__#012 18)
                (set-goal gl-starting-min-distance__#012 9)
                (set-goal gl-ideal-point-forward-tiles__#012 0)
                (set-goal gl-tc-farming-distance__#012 9)
                (set-goal gl-mill-farming-distance__#012 6)
                (set-goal gl-dropsite-safe-distance__#012 3)
                (set-goal gl-minimal-accepted-builder-distance__#012 12)
                (set-goal gl-ideal-point-distance-score-multiplier__#012 4)
                (set-goal gl-vill-score-multiplier__#012 10)
                (set-goal gl-ignore-dropsite-rules__#012 NO)
                (set-goal gl-ignore-farming-rules__#012 NO)
                (set-goal gl-ignore-building-rules__#012 NO)
                (set-goal gl-ignore-builder-rules__#012 NO)
                (up-copy-point gl-ideal-x__#012 gl-position-self-x)
            )

            (defrule
                (up-compare-goal gl-position == Flank)
                =>
                (up-copy-point gl-enemy-x__#012 gl-position-flank-x)
                (up-lerp-tiles gl-enemy-x__#012 gl-position-center-x c: 10)
            )

            (defrule
                (up-compare-goal gl-position == Pocket)
                =>
                (up-copy-point gl-enemy-x__#012 gl-position-center-x)
            )

            (defrule
                (building-count > 10)
                =>
                (set-goal gl-minimal-accepted-builder-distance__#012 9)
            )

        ; Controll for specific buildings
            (defrule
                (up-compare-goal gl-build == watch-tower)
                =>
                (set-goal gl-ideal-point-distance-score-multiplier__#012 100)
                (set-goal gl-vill-score-multiplier__#012 0)
                (set-goal gl-ignore-dropsite-rules__#012 YES)
                (set-goal gl-ignore-farming-rules__#012 YES)
                (set-goal gl-ignore-building-rules__#012 YES)

                (up-full-reset-search)
                (up-find-local c: mill c: 200)
                (up-find-local c: lumber-camp c: 200)
                (up-find-local c: mining-camp c: 200)
                (up-get-point position-self gl-temp-x)
                (up-lerp-tiles gl-temp-x gl-enemy-flank-x c: 7)
                (up-set-target-point gl-temp-x)
                (up-clean-search search-local object-data-distance search-order-asc)
            )

            (defrule
                (up-compare-goal gl-build == watch-tower)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-ideal-x__#012)
                (up-lerp-tiles gl-ideal-x__#012 gl-temp-x c: 2)
                (up-lerp-tiles gl-ideal-x__#012 gl-position-flank-x c: 3)
            )

            (defrule
                (up-compare-goal gl-build == Chicken-mill)
                =>
                (set-goal gl-vill-score-multiplier__#012 0)
                (set-goal gl-ideal-point-distance-score-multiplier__#012 1)
                (set-goal gl-ignore-dropsite-rules__#012 YES)
                (set-goal gl-ignore-farming-rules__#012 YES)
                (set-goal gl-ignore-building-rules__#012 YES)
                (set-goal gl-ignore-builder-rules__#012 YES)
            )

            (defrule
                (up-compare-goal gl-build == siege-workshop)
                =>
                (up-modify-goal gl-ideal-point-distance-score-multiplier__#012 c:* 4)
                (up-modify-goal gl-ideal-point-forward-tiles__#012 c:+ 20)
                (set-goal gl-vill-score-multiplier__#012 2)
            )

            (defrule
                (or(up-compare-goal gl-build == barracks)
                (or(up-compare-goal gl-build == stable)
                (up-compare-goal gl-build == archery-range)))
                =>
                (up-modify-goal gl-ideal-point-forward-tiles__#012 c:+ 15)
                (up-modify-goal gl-ideal-point-distance-score-multiplier__#012 c:* 2)

            )
            (defrule
                (up-compare-goal gl-build == house)
                =>
                (up-modify-goal gl-ideal-point-forward-tiles__#012 c:+ 5)
            )

            (defrule
                (up-compare-goal gl-build == monastery)
                (building-type-count-total monastery == 0)
                =>
                (up-modify-goal gl-ideal-point-forward-tiles__#012 c:+ 15)
                (up-modify-goal gl-ideal-point-distance-score-multiplier__#012 c:* 3)
                (set-goal gl-vill-score-multiplier__#012 4)
            )
        ; Lerp ideal point
            (defrule
                (up-compare-goal gl-build != watch-tower)
                =>
                (up-lerp-tiles gl-ideal-x__#012 gl-enemy-x__#012 g: gl-ideal-point-forward-tiles__#012)
            )

        ; Ajust max distance over the game
            (defrule
                (true)
                =>
                (up-get-fact building-count 0 gl-extra-max-distance__#012)
                (up-modify-goal gl-extra-max-distance__#012 c:/ 5)
                (up-get-fact building-type-count town-center gl-temp)
                (up-modify-goal gl-temp c:- 1)
                (up-modify-goal gl-temp c:* 2)
                (up-modify-goal gl-extra-max-distance__#012 g:+ gl-temp)
            )

            (defrule
                (research-completed feudal-age)
                =>
                (up-modify-goal gl-extra-max-distance__#012 c:+ 1)
            )
            (defrule
                (research-completed castle-age)
                =>
                (up-modify-goal gl-extra-max-distance__#012 c:+ 1)
            )
            (defrule
                (research-completed imperial-age)
                =>
                (up-modify-goal gl-extra-max-distance__#012 c:+ 1)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-starting-max-distance__#012 g:+ gl-extra-max-distance__#012)
                (up-modify-goal gl-starting-max-distance__#012 c:min 40)
            )

        ; Ajust min distance over the game

            (defrule
                (up-compare-goal gl-extra-max-distance__#012 > 10)
                =>
                (up-modify-goal gl-extra-max-distance__#012 c:/ 2)
                (up-modify-goal gl-starting-min-distance__#012 g:+ gl-extra-max-distance__#012)
            )

            (defrule
                (game-time < 10)
                =>
                (up-modify-goal gl-starting-min-distance__#012 c:= 7)
            )


        ; Set game building name for custom building names

            (defrule
                (true)
                =>
                (up-modify-goal gl-build-game-name__#012 g:= gl-build)
            )
            (defrule
                (up-compare-goal gl-build == Chicken-mill)
                =>
                (set-goal gl-build-game-name__#012 mill)
            )
        ; List vill id's for exclusion
            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: mill c: 10)
                (set-goal gl-chicken-vill-1-id__#000 -1)
                (set-goal gl-chicken-vill-2-id__#000 -1)
                (set-goal gl-chicken-vill-3-id__#000 -1)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-set-group search-remote c: scouted-animal-group)
                (up-remove-objects search-remote object-data-class != prey-animal-class)
                (up-remove-objects search-remote object-data-carry > 80)
                (up-remove-objects search-remote object-data-distance > 7)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 8)
                (up-find-local c: villager-class c: 20)
                (up-clean-search search-local object-data-distance search-order-asc)
                (up-jump-rule 1)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-remove-objects search-local object-data-index == 0)
                (up-jump-rule -3)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-id gl-chicken-vill-1-id__#000)
            )
            (defrule
                (up-set-target-object search-local c: 1)
                =>
                (up-get-object-data object-data-id gl-chicken-vill-2-id__#000)
            )
            (defrule
                (up-set-target-object search-local c: 2)
                =>
                (up-get-object-data object-data-id gl-chicken-vill-3-id__#000)
                ;(chat-to-all "setting vill 3 id")
            )
                
        ; Setup search groups before loop.

            (defrule 
                (true)
                =>
                (up-modify-goal gl-search-group-max-distance__#012 g:= gl-starting-max-distance__#012)
