                    (up-modify-goal gl-testing-x g:+ gl-x-modifier)
                    (up-modify-goal gl-testing-y g:+ gl-y-modifier)
                    (up-set-target-point gl-testing-x)
                    (up-clean-search search-local object-data-distance search-order-asc)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    (set-goal gl-temp -1)
                    (set-goal gl-home-distance-score 10000)
                    (set-goal gl-enemy-distance-score 10000)
                    (set-goal gl-vill-distance-score 10000)
                )
            ;testing if point is accaptable
                (defrule
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-get-object-data object-data-distance gl-closest-tower-distance)
                )

                (defrule
                    (up-can-build-line 0 gl-testing-x c: watch-tower)
                    (up-point-distance gl-testing-x gl-enemy-x > 10)
                    (up-point-distance gl-testing-x gl-enemy-x < 30)
                    (or(and(up-compare-goal gl-closest-tower-distance >= 4)
                    (up-compare-goal gl-closest-tower-distance <= 7))
                    (building-type-count-total watch-tower-line == 0))
                    (building-type-count-total watch-tower-line < 5)
                    =>
                    (set-goal gl-temp 1)
                )

                (defrule
                    (up-can-build-line 0 gl-testing-x c: watch-tower)
                    (up-point-distance gl-testing-x gl-enemy-x > 10)
                    (up-point-distance gl-testing-x gl-enemy-x < 30)
                    (or(and(up-compare-goal gl-closest-tower-distance >= 5)
                    (up-compare-goal gl-closest-tower-distance <= 7))
                    (building-type-count-total watch-tower-line == 0))
                    (building-type-count-total watch-tower-line < 8)
                    =>
                    (set-goal gl-temp 1)
                )

                (defrule
                    (up-can-build-line 0 gl-testing-x c: watch-tower)
                    (up-point-distance gl-testing-x gl-enemy-x > 10)
                    (up-point-distance gl-testing-x gl-enemy-x < 30)
                    (or(and(up-compare-goal gl-closest-tower-distance >= 6)
                    (up-compare-goal gl-closest-tower-distance <= 7))
                    (building-type-count-total watch-tower-line == 0))
                    =>
                    (set-goal gl-temp 1)
                )
                
            ;if not then restart loop
                (defrule
                    (goal gl-temp -1)
                    (up-compare-goal gl-x-modifier < 30)
                    (up-compare-goal gl-build == Forward-watch-tower)
                    =>
                    (up-modify-goal gl-x-modifier c:+ 1)
                    (up-jump-direct g: gl-first-tower-loop-rule)
                )

                (defrule
                    (goal gl-temp -1)
                    (up-compare-goal gl-y-modifier < 30)
                    (up-compare-goal gl-x-modifier >= 30)
                    (up-compare-goal gl-build == Forward-watch-tower)
                    =>
                    (up-modify-goal gl-y-modifier c:+ 1)
                    (up-modify-goal gl-x-modifier c:= -30)
                    (up-jump-direct g: gl-first-tower-loop-rule)
                )
            ;calculate score
                (defrule
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-object-data object-data-distance gl-vill-distance-score)
                    (up-modify-goal gl-vill-distance-score g:* gl-vill-distance-modifier)

                    (up-get-point-distance gl-position-self-x gl-testing-x gl-home-distance-score)
                    (up-modify-goal gl-home-distance-score g:* gl-home-distance-modifier)

                    (up-get-point-distance gl-enemy-x gl-testing-x gl-enemy-distance-score)
                    (up-modify-goal gl-enemy-distance-score g:* gl-enemy-distance-modifier)
                )

                (defrule
                    (building-type-count-total watch-tower-line > 0)
                    =>
                    (set-goal gl-home-distance-score 0)
                )

                (defrule
                    (true)
                    =>
                    (set-goal gl-combined-score 10000)
                    (up-modify-goal gl-combined-score g:- gl-vill-distance-score)
                    (up-modify-goal gl-combined-score g:- gl-home-distance-score)
                    (up-modify-goal gl-combined-score g:- gl-enemy-distance-score)
                )
            ;replace best score
                (defrule
                    (up-compare-goal gl-combined-score g:> gl-best-score)
                    (up-can-build-line 0 gl-testing-x c: watch-tower)
                    =>
                    (up-modify-goal gl-best-score g:= gl-combined-score)
                    (up-copy-point gl-best-point-x gl-testing-x)
                )

                
            ;restart loop
                (defrule
                    (up-compare-goal gl-x-modifier < 30)
                    (up-compare-goal gl-build == Forward-watch-tower)
                    =>
                    (up-modify-goal gl-x-modifier c:+ 1)
                    (up-jump-direct g: gl-first-tower-loop-rule)
                )

                (defrule
                    (up-compare-goal gl-y-modifier < 30)
                    (up-compare-goal gl-x-modifier >= 30)
                    (up-compare-goal gl-build == Forward-watch-tower)
                    =>
                    (up-modify-goal gl-y-modifier c:+ 1)
                    (up-modify-goal gl-x-modifier c:= -30)
                    (up-jump-direct g: gl-first-tower-loop-rule)
                )
            ;build building
                (defrule
                    (goal gl-build Forward-watch-tower)
                    (up-compare-goal gl-best-point-x != -1)
                    =>
                    (up-build-line gl-best-point-x gl-best-point-x c: watch-tower)
                    (set-goal gl-build -1)
                )

                (defrule
                    (goal gl-build Forward-watch-tower)
                    =>
                    (set-goal gl-build -1)
                )
        
    ;chat
        

        (defrule
            (up-compare-goal gl-stage >= 2)
            =>
            (chat-to-all "I <3 the smell of laming in the mooning")
            (disable-self)
        )
        
        (defrule
            (up-compare-goal gl-stage >= 3)
            =>
            (chat-to-all "U can resijn again")
            (disable-self)
        )

        (defrule
            (up-research-status c: castle-age >= research-pending)
            =>
            (chat-to-all "I'm so sory...")
            (disable-self)
        )
;
    ;#end-if
;

; DUC eco engine #000
    ; Initial vill grouping at game start (for empire wars and scenarios)
        (defrule
            (true)
            =>
            (set-goal gl-vill-index__#000 0)
        )

        (defrule
            (true)
            =>
            (up-get-rule-id gl-retask-first-vills-start-rule-id__#000)
        )

        (defrule
            (true)
            =>
            (set-goal gl-retask-vill-id__#000 -1)
            (up-full-reset-search)
            (up-find-local c: villager-class c: 240)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-vill-index-max__#000 g:= gl-local-total)
            (up-modify-goal gl-vill-index-max__#000 c:- 1)
        )

        (defrule
            (up-set-target-object search-local g: gl-vill-index__#000)
            (game-time < 2)
            =>
            (up-get-point position-object gl-temp-x)
            (up-set-target-point gl-temp-x)
            (up-filter-distance c: -1 c: 4)
            (up-modify-sn sn-focus-player-number c:= my-player-number)
            (up-filter-status c: status-resource c: list-active)
            (up-find-resource c: stone c: 5)
            (up-filter-status c: status-resource c: list-active)
            (up-find-resource c: gold c: 5)
            (up-filter-status c: status-resource c: list-active)
            (up-find-resource c: food c: 5)
            (up-find-remote c: farm c: 5)
            (up-filter-status c: status-gather c: list-active)
            (up-find-resource c: shore-fish-class c: 10)
            (up-filter-status c: status-ready c: list-active)
            (up-find-resource c: prey-animal-class c: 10)
            (up-filter-status c: status-gather c: list-active)
            (up-find-resource c: prey-animal-class c: 10)
            (up-filter-status c: status-gather c: list-active)
            (up-find-resource c: livestock-class c: 10)
            (up-filter-status c: status-ready c: list-active)
            (up-find-resource c: livestock-class c: 10)
            (up-filter-status c: status-gather c: list-active)
            (up-find-resource c: predator-animal-class c: 10)
            (up-filter-status c: status-ready c: list-active)
            (up-find-resource c: predator-animal-class c: 10)
            (up-filter-status c: status-ready c: list-active)
            (up-find-resource c: wood c: 25)
            (up-get-search-state gl-local-total)
            (up-clean-search search-remote object-data-distance search-order-asc)
        )

        (defrule
            (up-set-target-object search-local g: gl-vill-index__#000)
            (up-set-target-object search-remote c: 0)
            =>
            (up-get-object-data object-data-class gl-current-building-type__#000)
        )

        (defrule
            (up-compare-goal gl-current-building-type__#000 == tree-class) ; 915
            (up-set-target-object search-remote c: 0)
            (up-set-target-object search-local g: gl-vill-index__#000)
            (game-time < 2)
            =>
            (up-get-object-data object-data-id gl-vill-id__#000)
            (up-full-reset-search)
            (up-add-object-by-id search-local g: gl-vill-id__#000)
            (up-reset-group c: wood-group)
            (up-modify-group-flag 0 c: wood-group)
            (up-create-group 0 0 c: wood-group)
            (up-modify-group-flag 1 c: wood-group)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            (up-compare-goal gl-current-building-type__#000 == gold-mine-class) ; 932
            (up-set-target-object search-local g: gl-vill-index__#000)
            (game-time < 2)
            =>
            (up-get-object-data object-data-id gl-vill-id__#000)
            (up-full-reset-search)
            (up-add-object-by-id search-local g: gl-vill-id__#000)
            (up-reset-group c: gold-group)
            (up-modify-group-flag 0 c: gold-group)
            (up-create-group 0 0 c: gold-group)
            (up-modify-group-flag 1 c: gold-group)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            (up-compare-goal gl-current-building-type__#000 == stone-mine-class) ; 908
            (up-set-target-object search-local g: gl-vill-index__#000)
            (game-time < 2)
            =>
            (up-get-object-data object-data-id gl-vill-id__#000)
            (up-full-reset-search)
            (up-add-object-by-id search-local g: gl-vill-id__#000)
            (up-reset-group c: gold-group)
            (up-modify-group-flag 0 c: gold-group)
            (up-create-group 0 0 c: gold-group)
            (up-modify-group-flag 1 c: gold-group)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            (or(up-compare-goal gl-current-building-type__#000 == forage-class) ; 907
            (or(up-compare-goal gl-current-building-type__#000 == farm-class)
            (or(up-compare-goal gl-current-building-type__#000 == shore-fish-class)
            (or(up-compare-goal gl-current-building-type__#000 == livestock-class) 
            (or(up-compare-goal gl-current-building-type__#000 == prey-animal-class) ; 909
            (up-compare-goal gl-current-building-type__#000 == predator-animal-class)))))) ; 910
            (up-set-target-object search-local g: gl-vill-index__#000)
            (game-time < 2)
            =>
            (up-get-object-data object-data-id gl-vill-id__#000)
            (up-full-reset-search)
            (up-add-object-by-id search-local g: gl-vill-id__#000)
            (up-reset-group c: food-group)
            (up-modify-group-flag 0 c: food-group)
            (up-create-group 0 0 c: food-group)
            (up-modify-group-flag 1 c: food-group)
        )

        (defrule
            (up-compare-goal gl-vill-index__#000 g:< gl-vill-index-max__#000)
            (up-compare-goal gl-retask-first-vills-start-rule-id__#000 != -1)
            (game-time < 2)
            =>
            (up-modify-goal gl-vill-index__#000 c:+ 1)
            (up-jump-direct g: gl-retask-first-vills-start-rule-id__#000)
        )

    ; Initialise loop running DUC eco module multiple times if we need to test lag
            (defrule
                (true)
                =>
                (set-goal gl-loop-counter__#000 1)
            )
            (defrule
                (true)
                =>
                (up-get-rule-id gl-pre-duc-eco-rule-id__#000)
            )
    ; Temporary solutions to make game run.
        (defrule
            (building-type-count lumber-camp > 0)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 200)
            (up-remove-objects search-local object-data-group-flag != wood-group)
            (up-remove-objects search-local object-data-language-id == lid-villager-builder)
            (up-modify-sn sn-focus-player-number c:= my-player-number)
            (up-find-remote c: town-center c: 1)
            ;(up-target-objects 0 action-default -1 -1)
            (disable-self)
        )

        (defrule
            (true)
            =>
            (set-strategic-number sn-livestock-to-town-center 1)
        )


    ;
    ; Set values controlling retasking behavior (Controll center)
        (defrule
            (true)
            =>
            (set-goal gl-food-score-weight-vill-dist__#000 500) ;100
            (set-goal gl-food-score-weight-crowding__#000 25)
            (set-goal gl-food-score-weight-res-count__#000 25)
            (set-goal gl-food-score-weight-res-dist__#000 25)

            (set-goal gl-food-fall-back-search-penalty__#000 5000)
            (set-goal gl-food-saturated-chicken-mill-penalty__#000 15000)
            (set-goal gl-food-undersaturated-chicken-mill-bonus__#000 15000)

            ;(up-modify-goal gl-food-pct__#000  c:= 30)
            ;(up-modify-goal gl-wood-pct__#000  c:= 30)
            ;(up-modify-goal gl-gold-pct__#000  c:= 20)
            ;(up-modify-goal gl-stone-pct__#000 c:= 20)
        )
        (defrule
            (true)
            =>
            (set-goal gl-non-food-score-weight-vill-dist__#000 25) ;100
            (set-goal gl-non-food-score-weight-crowding__#000 200)
            (set-goal gl-non-food-score-weight-res-count__#000 500)
            (set-goal gl-non-food-score-weight-res-dist__#000 25)

            (set-goal gl-non-food-fall-back-search-penalty__#000 5000)

            ;(up-modify-goal gl-food-pct__#000  c:= 30)
            ;(up-modify-goal gl-wood-pct__#000  c:= 30)
            ;(up-modify-goal gl-gold-pct__#000  c:= 20)
            ;(up-modify-goal gl-stone-pct__#000 c:= 20)
        )
    ; Save animals for future retasking to search group

        ; if chicken counter is > 0 and we have 3 or more food vills close to a chicken-mill we remove all prey-animals around that mill from the search

        (defrule
            (up-compare-goal gl-chicken-counter__#052 > 0)
            =>
            (up-full-reset-search)
            (up-find-local c: mill c: 10)
            (set-goal gl-chicken-mill-x -10)
            (set-goal gl-chicken-mill-y -10)
        )

        (defrule
            (up-compare-goal gl-chicken-counter__#052 > 0)
            (up-set-target-object search-local c: 0)
            =>
            (up-get-point position-object gl-temp-x)
            (up-set-target-point gl-temp-x)
            (up-filter-distance c: -1 c: 7)
            (up-filter-status c: status-gather c: list-active)
            (up-find-resource c: prey-animal-class c: 25)
        )

        (defrule
            (up-compare-goal gl-chicken-counter__#052 > 0)
            (up-set-target-object search-remote c: 0)
            (up-set-target-object search-local c: 0)
            =>
            (up-get-point position-object gl-chicken-mill-x)
            (up-jump-rule 1)
        )

        (defrule
            (up-set-target-object search-local c: 0)
            =>
            (up-remove-objects search-local object-data-index == 0)
            (up-jump-rule -3)
        )

        (defrule
            (up-compare-goal gl-chicken-counter__#052 > 0)
            =>
            (up-full-reset-search)
            (up-set-target-point gl-chicken-mill-x)
            (up-filter-distance c: -1 c: 5)
            (up-find-local c: villager-class c: 200)
            (up-remove-objects search-local object-data-group-flag != food-group)
            (up-remove-objects search-local object-data-idling == 1)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-chicken-vills-nr g:= gl-local-total)
        )

        (defrule
            (true)
            =>
            (up-reset-group c: target-animal-group)
            (up-full-reset-search)
            (up-set-target-point gl-position-self-x)
            (up-filter-distance c: 8 c: 30)
            (up-filter-status c: status-gather c: list-active)
            (up-find-resource c: prey-animal-class c: 25)
            (up-remove-objects search-remote object-data-tasks-count > 2)
            (up-filter-distance c: -1 c: 8)
            (up-filter-status c: status-gather c: list-active)
            (up-find-resource c: prey-animal-class c: 10)
            (up-remove-objects search-remote object-data-tasks-count > 3)
            (up-filter-distance c: -1 c: 30)
            (up-filter-status c: status-gather c: list-active)
            (up-find-resource c: livestock-class c: 10)
            (up-remove-objects search-remote object-data-tasks-count > 6)
            (up-filter-status c: status-gather c: list-active)
            (up-find-resource c: predator-animal-class c: 10)
            (up-remove-objects search-remote object-data-tasks-count > 7)

            (up-remove-objects search-remote object-data-carry <= 10)
        )

        (defrule
            (up-compare-goal gl-chicken-vills-nr >= 3)
            =>
            (up-set-target-point gl-chicken-mill-x)
            (up-remove-objects search-remote object-data-distance <= 7)
        )
        

        (defrule
            (up-set-target-object search-remote c: 0)
            =>
            (up-get-object-data object-data-id gl-temp)
            (up-add-object-by-id search-local g: gl-temp)
            (up-remove-objects search-remote object-data-index == 0)
            (up-jump-rule -1)
        )

        (defrule
            (up-set-target-object search-local c: 0)
            =>
            (up-create-group 0 0 c: target-animal-group)
        )

    ; Convert gather sn's to goals.
        (defrule
            (or(up-compare-goal gl-food-vills-specified__#000 != -1)
            (or(up-compare-goal gl-wood-vills-specified__#000 != -1)
            (or(up-compare-goal gl-gold-vills-specified__#000 != -1)
            (up-compare-goal gl-stone-vills-specified__#000 != -1))))
            (up-compare-goal gl-post-gather-percentage-rule-id__#000 != -1)
            =>
            (up-modify-goal gl-food-vill-nr__#000 g:= gl-food-vills-specified__#000)
            (up-modify-goal gl-wood-vill-nr__#000 g:= gl-wood-vills-specified__#000)
            (up-modify-goal gl-gold-vill-nr__#000 g:= gl-gold-vills-specified__#000)
            (up-modify-goal gl-stone-vill-nr__#000 g:= gl-stone-vills-specified__#000)
            (up-jump-direct g: gl-post-gather-percentage-rule-id__#000)
        )

        (defrule
            (up-compare-sn sn-food-gatherer-percentage == 0)
            (up-compare-sn sn-wood-gatherer-percentage == 0)
            (up-compare-sn sn-gold-gatherer-percentage == 0)
            (up-compare-sn sn-stone-gatherer-percentage == 0)
            =>
            (set-strategic-number sn-food-gatherer-percentage 100)
        )
        (defrule
            (true)
            =>
            (up-modify-goal gl-food-pct__#000  s:= sn-food-gatherer-percentage)
            (up-modify-goal gl-wood-pct__#000  s:= sn-wood-gatherer-percentage)
            (up-modify-goal gl-gold-pct__#000  s:= sn-gold-gatherer-percentage)
            (up-modify-goal gl-stone-pct__#000 s:= sn-stone-gatherer-percentage)
            (set-strategic-number sn-food-gatherer-percentage 0)
            (set-strategic-number sn-wood-gatherer-percentage 0)
            (set-strategic-number sn-gold-gatherer-percentage 0)
            (set-strategic-number sn-stone-gatherer-percentage 0)
        )

        (defrule ; ajust if gather sn's do not sum to 100
            (true)
            =>
            (up-modify-goal gl-total-pct__#000 c:= 0)
            (up-modify-goal gl-total-pct__#000 g:+ gl-food-pct__#000)
            (up-modify-goal gl-total-pct__#000 g:+ gl-wood-pct__#000)
            (up-modify-goal gl-total-pct__#000 g:+ gl-gold-pct__#000)
            (up-modify-goal gl-total-pct__#000 g:+ gl-stone-pct__#000)
        )

        (defrule ; missing percent
            (up-compare-goal gl-total-pct__#000 < 100)
            =>
            (up-modify-goal gl-missing-pct__#000 c:= 100)
            (up-modify-goal gl-missing-pct__#000 g:- gl-total-pct__#000)
            (up-modify-goal gl-food-pct__#000 g:+ gl-missing-pct__#000)
            (up-chat-data-to-all "Bug: total gather percentage to low: %d" g: gl-total-pct__#000)
        )

        (defrule ; over 100 %
            (up-compare-goal gl-total-pct__#000 > 100)
            =>
            (up-modify-goal gl-abundant-pct__#000 g:= gl-total-pct__#000)
            (up-modify-goal gl-abundant-pct__#000 c:- 100)
            (up-chat-data-to-all "Bug: total gather percentage to high: %d" g: gl-total-pct__#000)
        )

        (defrule
            (up-compare-goal gl-total-pct__#000 > 100)
            (up-compare-goal gl-abundant-pct__#000 g:>= gl-stone-pct__#000)
            =>
            (up-modify-goal gl-abundant-pct__#000 g:- gl-stone-pct__#000)
            (up-modify-goal gl-total-pct__#000 g:- gl-stone-pct__#000)
            (set-goal gl-stone-pct__#000 0)
        )

        (defrule
            (up-compare-goal gl-total-pct__#000 > 100)
            (up-compare-goal gl-abundant-pct__#000 g:< gl-stone-pct__#000)
            =>
            (up-modify-goal gl-stone-pct__#000 g:- gl-abundant-pct__#000)
            (up-modify-goal gl-total-pct__#000 g:- gl-abundant-pct__#000)
            (set-goal gl-abundant-pct__#000 0)
        )

        (defrule
            (up-compare-goal gl-total-pct__#000 > 100)
            (up-compare-goal gl-abundant-pct__#000 g:>= gl-gold-pct__#000)
            =>
            (up-modify-goal gl-abundant-pct__#000 g:- gl-gold-pct__#000)
            (up-modify-goal gl-total-pct__#000 g:- gl-gold-pct__#000)
            (set-goal gl-gold-pct__#000 0)
        )

        (defrule
            (up-compare-goal gl-total-pct__#000 > 100)
            (up-compare-goal gl-abundant-pct__#000 g:< gl-gold-pct__#000)
            =>
            (up-modify-goal gl-gold-pct__#000 g:- gl-abundant-pct__#000)
            (up-modify-goal gl-total-pct__#000 g:- gl-abundant-pct__#000)
            (set-goal gl-abundant-pct__#000 0)
        )
        (defrule
            (up-compare-goal gl-total-pct__#000 > 100)
            (up-compare-goal gl-abundant-pct__#000 g:>= gl-wood-pct__#000)
            =>
            (up-modify-goal gl-abundant-pct__#000 g:- gl-wood-pct__#000)
            (up-modify-goal gl-total-pct__#000 g:- gl-wood-pct__#000)
            (set-goal gl-wood-pct__#000 0)
        )

        (defrule
            (up-compare-goal gl-total-pct__#000 > 100)
            (up-compare-goal gl-abundant-pct__#000 g:< gl-wood-pct__#000)
            =>
            (up-modify-goal gl-wood-pct__#000 g:- gl-abundant-pct__#000)
            (up-modify-goal gl-total-pct__#000 g:- gl-abundant-pct__#000)
            (set-goal gl-abundant-pct__#000 0)
        )
        (defrule
            (up-compare-goal gl-total-pct__#000 > 100)
            (up-compare-goal gl-abundant-pct__#000 g:>= gl-food-pct__#000)
            =>
            (up-modify-goal gl-abundant-pct__#000 g:- gl-food-pct__#000)
            (up-modify-goal gl-total-pct__#000 g:- gl-food-pct__#000)
            (set-goal gl-food-pct__#000 0)
        )

        (defrule
            (up-compare-goal gl-total-pct__#000 > 100)
            (up-compare-goal gl-abundant-pct__#000 g:< gl-food-pct__#000)
            =>
            (up-modify-goal gl-food-pct__#000 g:- gl-abundant-pct__#000)
            (up-modify-goal gl-total-pct__#000 g:- gl-abundant-pct__#000)
            (set-goal gl-abundant-pct__#000 0)
        )

    ; Convert SN gather percentages to intended nr of vills on each res


        (defrule
            (true)
        =>
            ; hent aktuelt antal villagers
            (up-get-fact unit-type-count villager gl-vill-nr)

            ; bound_food = round(total * food / 100)
            (up-modify-goal gl-food-band-end__#000 g:= gl-vill-nr)
            (up-modify-goal gl-food-band-end__#000 g:* gl-food-pct__#000)
            (up-modify-goal gl-food-band-end__#000 c:/ 100)

            ; bound_foodwood = round(total * (food + wood) / 100)
            (up-modify-goal gl-wood-band-end__#000 g:= gl-food-pct__#000)
            (up-modify-goal gl-wood-band-end__#000 g:+ gl-wood-pct__#000)
            (up-modify-goal gl-wood-band-end__#000 g:* gl-vill-nr)
            (up-modify-goal gl-wood-band-end__#000 c:/ 100)

            ; bound_foodwoodgold = round(total * (food + wood + gold) / 100)
            (up-modify-goal gl-gold-band-end__#000 g:= gl-food-pct__#000)
            (up-modify-goal gl-gold-band-end__#000 g:+ gl-wood-pct__#000)
            (up-modify-goal gl-gold-band-end__#000 g:+ gl-gold-pct__#000)
            (up-modify-goal gl-gold-band-end__#000 g:* gl-vill-nr)
            (up-modify-goal gl-gold-band-end__#000 c:/ 100)
        )

        (defrule
            (true)
            =>
            ; endelige mål
            (up-modify-goal gl-food-vill-nr__#000 g:= gl-food-band-end__#000)

            (up-modify-goal gl-wood-vill-nr__#000 g:= gl-wood-band-end__#000)
            (up-modify-goal gl-wood-vill-nr__#000 g:- gl-food-band-end__#000)

            (up-modify-goal gl-gold-vill-nr__#000 g:= gl-gold-band-end__#000)
            (up-modify-goal gl-gold-vill-nr__#000 g:- gl-wood-band-end__#000)

            (up-modify-goal gl-stone-vill-nr__#000 g:= gl-vill-nr)
            (up-modify-goal gl-stone-vill-nr__#000 g:- gl-gold-band-end__#000)
            ;(up-chat-data-to-all "wanted nr food: %d" g: gl-food-vill-nr)
            ;(up-chat-data-to-all "wanted nr wood: %d" g: gl-wood-vill-nr)
            ;(up-chat-data-to-all "wanted nr gold: %d" g: gl-gold-vill-nr)
            ;(up-chat-data-to-all "wanted nr stone: %d" g: gl-stone-vill-nr)
        )

        (defrule
            (true)
            =>
            (up-get-rule-id gl-post-gather-percentage-rule-id__#000)
        )
    ; Modify grouping if we have a mismatach between wanted and actual grouping
        ; Set accepted nr of misassigned vills

            (defrule ; for each tc able to produce vills imbalances can be balanced faster by ungrouped vills thus decreasing total retasking.
                (true)
                =>
                (set-goal gl-accepted-misassigned-vills__#000 0)
                (up-get-fact building-type-count town-center gl-town-center-bonus__#000)
                (up-modify-goal gl-town-center-bonus__#000 c:- 1)
            )

            (defrule
                (unit-type-count villager >= 20)
                (up-research-status c: ri-loom != research-pending)
                (up-research-status c: ri-wheel-barrow != research-pending)
                (up-research-status c: ri-hand-cart != research-pending)
                (up-research-status c: ri-town-watch != research-pending)
                (up-research-status c: ri-town-patrol != research-pending)
                (up-research-status c: feudal-age != research-pending)
                (up-research-status c: castle-age != research-pending)
                (up-research-status c: imperial-age != research-pending)
                =>
                (up-modify-goal gl-accepted-misassigned-vills__#000 c:+ 1)
            )

            (defrule
                (building-type-count town-center > 1)
                =>
                (up-modify-goal gl-accepted-misassigned-vills__#000 g:+ gl-town-center-bonus__#000)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-vills-from-max__#000 c:= max-vills__#000) ; 140
                (up-modify-goal gl-vills-from-max__#000 g:- gl-vill-nr)
            )

            (defrule
                (up-compare-goal gl-vills-from-max__#000 g:<= gl-accepted-misassigned-vills__#000)
                =>
                (up-modify-goal gl-accepted-misassigned-vills__#000 g:= gl-vills-from-max__#000)
                (up-modify-goal gl-accepted-misassigned-vills__#000 c:max 0)
            )

            
        ; Calculating res-groups for flag tranfers

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (fe-filter-garrisoned c: 1)
                (up-find-local c: villager-class g: gl-vill-nr)
                (up-remove-objects search-local object-data-group-flag != wood-group)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-wood-vills-with-flag__#000 g:= gl-local-total)
                (up-full-reset-search)
                (fe-filter-garrisoned c: 1)
                (up-find-local c: villager-class g: gl-vill-nr)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-food-vills-with-flag__#000 g:= gl-local-total)
                (up-full-reset-search)
                (fe-filter-garrisoned c: 1)
                (up-find-local c: villager-class g: gl-vill-nr)
                (up-remove-objects search-local object-data-group-flag != gold-group)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-gold-vills-with-flag__#000 g:= gl-local-total)
                (up-full-reset-search)
                (fe-filter-garrisoned c: 1)
                (up-find-local c: villager-class g: gl-vill-nr)
                (up-remove-objects search-local object-data-group-flag != stone-group)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-stone-vills-with-flag__#000 g:= gl-local-total)

                
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (fe-filter-garrisoned c: 1)
                (up-find-local c: villager-class c: 240)
                (up-remove-objects search-local object-data-group-flag == food-group)
                (up-remove-objects search-local object-data-group-flag == gold-group)
                (up-remove-objects search-local object-data-group-flag == wood-group)
                (up-remove-objects search-local object-data-group-flag == stone-group)
                (up-remove-objects search-local object-data-group-flag >= 5)
                (up-reset-group c: ungrouped-vills-group)
                (up-create-group 0 0 c: ungrouped-vills-group)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-group search-local c: ungrouped-vills-group)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-ungrouped-vills__#000 g:= gl-local-total)

                (up-modify-goal gl-food-vill-surplus__#000 g:= gl-nr-food-vills-with-flag__#000)
                (up-modify-goal gl-food-vill-surplus__#000 g:- gl-food-vill-nr__#000)
                (up-modify-goal gl-wood-vill-surplus__#000 g:= gl-nr-wood-vills-with-flag__#000)
                (up-modify-goal gl-wood-vill-surplus__#000 g:- gl-wood-vill-nr__#000)
                (up-modify-goal gl-gold-vill-surplus__#000 g:= gl-nr-gold-vills-with-flag__#000)
                (up-modify-goal gl-gold-vill-surplus__#000 g:- gl-gold-vill-nr__#000)
                (up-modify-goal gl-stone-vill-surplus__#000 g:= gl-nr-stone-vills-with-flag__#000)
                (up-modify-goal gl-stone-vill-surplus__#000 g:- gl-stone-vill-nr__#000)

                (up-modify-goal gl-misasigned-beyond-accepted__#000 c:= 0)
                (set-goal gl-temp 0)
                (up-modify-goal gl-temp g:min gl-food-vill-surplus__#000)
                (up-modify-goal gl-misasigned-beyond-accepted__#000 g:+ gl-temp)
                (set-goal gl-temp 0)
                (up-modify-goal gl-temp g:min gl-wood-vill-surplus__#000)
                (up-modify-goal gl-misasigned-beyond-accepted__#000 g:+ gl-temp)
                (set-goal gl-temp 0)
                (up-modify-goal gl-temp g:min gl-stone-vill-surplus__#000)
                (up-modify-goal gl-misasigned-beyond-accepted__#000 g:+ gl-temp)
                (set-goal gl-temp 0)
                (up-modify-goal gl-temp g:min gl-gold-vill-surplus__#000)
                (up-modify-goal gl-misasigned-beyond-accepted__#000 g:+ gl-temp)
                (up-modify-goal gl-misasigned-beyond-accepted__#000 g:neg gl-misasigned-beyond-accepted__#000)
                (up-modify-goal gl-misasigned-beyond-accepted__#000 g:- gl-accepted-misassigned-vills__#000)
                

                
            )

            (defrule
                (true)
                =>
                (do-nothing)
                ;(up-chat-data-to-all "gl-ungrouped-vills: %d" g: gl-ungrouped-vills)
                ;(up-chat-data-to-all "gl-food-vill-surplus: %d" g: gl-food-vill-surplus)
                ;(up-chat-data-to-all "gl-wood-vill-surplus: %d" g: gl-wood-vill-surplus)
                ;(up-chat-data-to-all "gl-gold-vill-surplus: %d" g: gl-gold-vill-surplus)
                ;(up-chat-data-to-all "gl-stone-vill-surplus: %d" g: gl-stone-vill-surplus)
                ;(up-chat-data-to-all "gl-accepted-misassigned-vills: %d" g: gl-accepted-misassigned-vills)
                ;(up-chat-data-to-all "gl-misasigned-beyond-accepted: %d" g: gl-misasigned-beyond-accepted)
            )

            (defrule
                (or(up-compare-goal gl-food-vill-surplus__#000 != 0)
                (or(up-compare-goal gl-wood-vill-surplus__#000 != 0)
                (or(up-compare-goal gl-stone-vill-surplus__#000 != 0)
                (up-compare-goal gl-gold-vill-surplus__#000 != 0))))
                (up-compare-goal gl-ungrouped-vills__#000 == 0)
                ;(game-time > 10)
                (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                =>
                ;(up-chat-data-to-all "gl-ungrouped-vills: %d" g: gl-ungrouped-vills)
                ;(up-chat-data-to-all "gl-food-vill-surplus: %d" g: gl-food-vill-surplus)
                ;(up-chat-data-to-all "gl-wood-vill-surplus: %d" g: gl-wood-vill-surplus)
                ;(up-chat-data-to-all "gl-gold-vill-surplus: %d" g: gl-gold-vill-surplus)
                ;(up-chat-data-to-all "gl-stone-vill-surplus: %d" g: gl-stone-vill-surplus)
                ;(up-chat-data-to-all "gl-accepted-misassigned-vills: %d" g: gl-accepted-misassigned-vills)
                ;(up-chat-data-to-all "gl-misasigned-beyond-accepted: %d" g: gl-misasigned-beyond-accepted)
                (do-nothing)
            )

        
        ; Prep 4 seach groups if needed.

            (defrule 
                (or(up-compare-goal gl-food-vill-surplus__#000 != 0)
                (or(up-compare-goal gl-wood-vill-surplus__#000 != 0)
                (or(up-compare-goal gl-stone-vill-surplus__#000 != 0)
                (or(up-compare-goal gl-gold-vill-surplus__#000 != 0)
                (up-compare-goal gl-ungrouped-vills__#000 != 0)))))
                (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                =>
                (up-full-reset-search)
                (fe-filter-garrisoned c: 1)
                (up-find-local c: villager-class c: 240)
                (up-remove-objects search-local object-data-action c:== actionid-build)
                (up-remove-objects search-local object-data-action c:== actionid-attack)
                (up-remove-objects search-local object-data-action c:== actionid-explore)
                (up-remove-objects search-local object-data-tasks-count c:> 0)
                (up-remove-objects search-local object-data-index >= 60)
                (up-reset-group c: first-60-group)
                (up-create-group 0 0 c: first-60-group)
                (up-full-reset-search)
                (fe-filter-garrisoned c: 1)
                (up-find-local c: villager-class c: 240)
                (up-remove-objects search-local object-data-action c:== actionid-build)
                (up-remove-objects search-local object-data-action c:== actionid-attack)
                (up-remove-objects search-local object-data-action c:== actionid-explore)
                (up-remove-objects search-local object-data-tasks-count c:> 0)
                (up-remove-objects search-local object-data-index < 60)
                (up-remove-objects search-local object-data-index >= 60)
                (up-reset-group c: second-60-group)
                (up-create-group 0 0 c: second-60-group)
            )

            (defrule
                (or(up-compare-goal gl-food-vill-surplus__#000 != 0)
                (or(up-compare-goal gl-wood-vill-surplus__#000 != 0)
                (or(up-compare-goal gl-stone-vill-surplus__#000 != 0)
                (or(up-compare-goal gl-gold-vill-surplus__#000 != 0)
                (up-compare-goal gl-ungrouped-vills__#000 != 0)))))
                (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                =>
                (up-full-reset-search)
                (fe-filter-garrisoned c: 1)
                (up-find-local c: villager-class c: 240)
                (up-remove-objects search-local object-data-action c:== actionid-build)
                (up-remove-objects search-local object-data-action c:== actionid-attack)
                (up-remove-objects search-local object-data-action c:== actionid-explore)
                (up-remove-objects search-local object-data-tasks-count c:> 0)
                (up-remove-objects search-local object-data-index < 120)
                (up-remove-objects search-local object-data-index >= 60)
                (up-reset-group c: third-60-group)
                (up-create-group 0 0 c: third-60-group)
                (up-full-reset-search)
                (fe-filter-garrisoned c: 1)
                (up-find-local c: villager-class c: 240)
                (up-remove-objects search-local object-data-action c:== actionid-build)
                (up-remove-objects search-local object-data-action c:== actionid-attack)
                (up-remove-objects search-local object-data-action c:== actionid-explore)
                (up-remove-objects search-local object-data-tasks-count c:> 0)
                (up-remove-objects search-local object-data-index < 180)
                (up-remove-objects search-local object-data-index >= 60)
                (up-reset-group c: forth-60-group)
                (up-create-group 0 0 c: forth-60-group)
            )
        
        ; Ungrouped vills

            (defrule
                (true)
                =>
                (set-goal gl-current-group__#000 food-group) ; er i tvivl om de her to
                (set-goal gl-current-surplus-goal-constant__#000 gl-food-vill-surplus__#000) ; er i tvivl om de her to
            )

            (defrule
                (true)
                =>
                (up-get-rule-id gl-change-vill-group-first-rule-id__#000)
            )

            (defrule ; Only fill local list if criteria are met
                (or(up-compare-goal gl-food-vill-surplus__#000 < 0)
                (or(up-compare-goal gl-wood-vill-surplus__#000 < 0)
                (or(up-compare-goal gl-stone-vill-surplus__#000 < 0)
                (up-compare-goal gl-gold-vill-surplus__#000 < 0))))
                (up-compare-goal gl-ungrouped-vills__#000 > 0)
                =>
                (up-full-reset-search)
                (up-set-group search-local c: ungrouped-vills-group)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (true)
                =>
                (up-get-indirect-goal g: gl-current-surplus-goal-constant__#000 gl-res-vill-surplus__#000)
            )

            (defrule ; convert ungrouped vills and redo loop
                (up-compare-goal gl-res-vill-surplus__#000 < 0)
                (up-compare-goal gl-ungrouped-vills__#000 > 0)
                (up-set-target-object search-local c: 0)
                ;(game-time > 10)
                =>
                (up-get-object-data object-data-id gl-ungrouped-vill-id__#000)
                (up-remove-objects search-local object-data-id g:== gl-ungrouped-vill-id__#000)
                (up-reset-group c: ungrouped-vills-group)
                (up-create-group 0 0 c: ungrouped-vills-group)
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-ungrouped-vill-id__#000)
                (up-reset-group g: gl-current-group__#000)
                (up-modify-group-flag 0 g: gl-current-group__#000)
                (up-create-group 0 0 g: gl-current-group__#000)
                (up-modify-group-flag 1 g: gl-current-group__#000)
                (up-modify-goal gl-ungrouped-vills__#000 c:- 1)
                (up-modify-goal gl-res-vill-surplus__#000 c:+ 1)
                (up-set-indirect-goal g: gl-current-surplus-goal-constant__#000 g: gl-res-vill-surplus__#000)
                (up-jump-direct g: gl-change-vill-group-first-rule-id__#000)
            )

            (defrule
                (up-compare-goal gl-current-group__#000 < gold-group)
                =>
                (up-modify-goal gl-current-group__#000 c:+ 1)
                (up-modify-goal gl-current-surplus-goal-constant__#000 c:+ 1)
                (up-jump-rule -3)
            )
        ; Find which group flags need to be switched and jump to switching code

            (defrule
                (true)
                =>
                (set-goal gl-vill-surplus-group__#000 food-group)
                (set-goal gl-vill-deficit-group__#000 food-group)
                (set-goal gl-current-surplus-goal-constant__#000 gl-food-vill-surplus__#000) 
                (set-goal gl-current-deficit-goal-constant__#000 gl-food-vill-surplus__#000)
            )

            (defrule
                (true)
                =>
                (up-get-indirect-goal g: gl-current-surplus-goal-constant__#000 gl-res-vill-surplus__#000)
                (up-get-indirect-goal g: gl-current-deficit-goal-constant__#000 gl-res-vill-deficit__#000)
                (set-goal gl-nr-vills-to-switch__#000 0)
                (set-goal gl-trying-to-switch-vills__#000 NO)
            )

            (defrule ; convert misgrouped vills and redo loop
                (up-compare-goal gl-res-vill-deficit__#000 < 0)
                (up-compare-goal gl-res-vill-surplus__#000 > 0)
                (up-compare-goal gl-vill-surplus-group__#000 g:!= gl-vill-deficit-group__#000)
                (up-compare-goal gl-group-switch-first-rule-id__#000 != -1)
                (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                ;(game-time > 10)
                =>
                (up-modify-goal gl-from-res__#000 g:= gl-vill-surplus-group__#000) ; nok unødvendig
                (up-modify-goal gl-to-res__#000 g:= gl-vill-deficit-group__#000) ; nok unødvendig
                (up-modify-goal gl-nr-vills-to-switch__#000 g:neg gl-res-vill-deficit__#000)
                (up-modify-goal gl-nr-vills-to-switch__#000 g:min gl-res-vill-surplus__#000)
                ;(up-chat-data-to-all "switch %d vills" g: gl-nr-vills-to-switch)
                ;(up-chat-data-to-all "from %d" g: gl-vill-surplus-group)
                ;(up-chat-data-to-all "to %d" g: gl-vill-deficit-group)
                (set-goal gl-trying-to-switch-vills__#000 YES)
                (up-jump-direct g: gl-group-switch-first-rule-id__#000)
            )

            (defrule ; jump back here after misgroup handler
                (true)
                =>
                (up-get-rule-id gl-post-group-switch-rule-id__#000)
            )

            (defrule
                (up-compare-goal gl-vill-surplus-group__#000 < gold-group)
                =>
                (up-modify-goal gl-vill-surplus-group__#000 c:+ 1)
                (up-modify-goal gl-current-surplus-goal-constant__#000 c:+ 1)
                (up-jump-rule -4)
            )

            (defrule
                (up-compare-goal gl-vill-deficit-group__#000 < gold-group)
                =>
                (up-modify-goal gl-vill-deficit-group__#000 c:+ 1)
                (up-modify-goal gl-current-deficit-goal-constant__#000 c:+ 1)
                (up-modify-goal gl-vill-surplus-group__#000 c:= food-group)
                (up-modify-goal gl-current-surplus-goal-constant__#000 c:= gl-food-vill-surplus__#000)
                (up-jump-rule -5)
            )
        ; Switch group flag between 2 types.
            ; Pre loop

                (defrule
                    (true)
                    =>
                    (up-get-rule-id gl-group-switch-first-rule-id__#000)
                    (up-full-reset-search)
                    (up-find-local c: town-center c: 1)
                )
                (defrule
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-object-data object-data-id gl-starting-tc-id__#000)
                )

                (defrule
                    (true)
                    =>
                    (set-goal gl-instant-dropoff__#000 YES)
                    (up-full-reset-search)
                    (up-find-local c: town-center c: 40)
                )

                (defrule
                    (up-compare-goal gl-vill-surplus-group__#000 == food-group)
                    =>
                    (set-goal gl-res-dropsite__#000 mill)
                )

                (defrule
                    (or(up-compare-goal gl-vill-surplus-group__#000 == gold-group)
                    (up-compare-goal gl-vill-surplus-group__#000 == stone-group))
                    =>
                    (set-goal gl-res-dropsite__#000 mining-camp)
                )

                (defrule
                    (up-compare-goal gl-vill-surplus-group__#000 == wood-group)
                    =>
                    (set-goal gl-res-dropsite__#000 lumber-camp)
                )

                (defrule
                    (or(up-compare-goal gl-vill-deficit-group__#000 == gold-group)
                    (up-compare-goal gl-vill-deficit-group__#000 == stone-group))
                    =>
                    (up-find-local c: mining-camp c: 40)
                    (up-filter-status c: status-pending c: list-active)
                    (up-find-status-local c: mining-camp c: 40)
                    (up-filter-status c: status-ready c: list-active)
                )

                (defrule
                    (up-compare-goal gl-vill-deficit-group__#000 == food-group)
                    =>
                    (up-find-local c: mill c: 40)
                    (up-filter-status c: status-pending c: list-active)
                    (up-find-status-local c: mill c: 40)
                    (up-filter-status c: status-ready c: list-active)
                )

                (defrule
                    (up-compare-goal gl-vill-deficit-group__#000 == wood-group)
                    =>
                    (up-find-local c: lumber-camp c: 40)
                    (up-filter-status c: status-pending c: list-active)
                    (up-find-status-local c: lumber-camp c: 40)
                    (up-filter-status c: status-ready c: list-active)
                )

                (defrule
                    (true)
                    =>
                    (up-set-target-point gl-position-self-x)
                    (up-clean-search search-local object-data-distance search-order-asc)
                    (up-reset-group c: to-dropsite-group)
                    (up-create-group 0 0 c: to-dropsite-group)
                    (set-goal gl-dropsite-index__#000 0)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-dropsite-max-index__#000 g:= gl-local-total)
                    (up-modify-goal gl-dropsite-max-index__#000 c:- 1)
                    (set-goal gl-dropsite-search-dist__#000 3)
                    (set-goal gl-dropsite-max-search-dist__#000 200)
                    (set-goal gl-current-60-group__#000 first-60-group)
                )

            ; Main loop

                (defrule
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    =>
                    (up-get-rule-id gl-main-group-switch-loop-start-rule-id__#000)
                    (up-full-reset-search)
                    (up-set-group search-local c: to-dropsite-group)
                    (set-goal gl-vills-rdy-to-be-switched-nr__#000 0)
                    (set-goal gl-dropsite-id__#000 -1)
                    (set-goal gl-switched-vills__#000 NO)
                    (set-goal gl-valid-res-targets__#000 0)
                )

                (defrule
                    (up-set-target-object search-local g: gl-dropsite-index__#000)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    =>
                    (up-get-object-data object-data-id gl-dropsite-id__#000)
                    (up-get-point position-object gl-dropsite-x__#000)
                    (up-set-target-point gl-dropsite-x__#000)
                )

                (defrule
                    (up-set-target-by-id g: gl-dropsite-id__#000)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    =>
                    (up-full-reset-search)
                    (up-set-group search-local g: gl-current-60-group__#000)
                    (up-remove-objects search-local object-data-group-flag g:!= gl-vill-surplus-group__#000)
                    (up-remove-objects search-local object-data-distance g:> gl-dropsite-search-dist__#000)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-vills-rdy-to-be-switched-nr__#000 g:= gl-local-total)
                    (up-modify-goal gl-vills-rdy-to-be-switched-nr__#000 g:min gl-nr-vills-to-switch__#000)
                )

                (defrule ; if no vills found (which should be the most common) we redo search early with new search group
                    (up-set-target-by-id g: gl-dropsite-id__#000)
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 <= 0)
                    (up-compare-goal gl-current-60-group__#000 < forth-60-group)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    =>
                    (up-modify-goal gl-current-60-group__#000 c:+ 1)
                    (up-jump-rule -2)
                )

                (defrule
                    (up-set-target-by-id g: gl-dropsite-id__#000) 
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 > 0)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    =>
                    (do-nothing)
                    ;(up-chat-data-to-all "found %d vills rdy for switch" g: gl-vills-rdy-to-be-switched-nr)
                )

                (defrule ; if no vills found (which should be the most common) we redo search early with new dropsite
                    (up-set-target-by-id g: gl-dropsite-id__#000) 
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 <= 0)
                    (up-compare-goal gl-main-group-switch-loop-start-rule-id__#000 != -1)
                    (up-compare-goal gl-dropsite-index__#000 g:< gl-dropsite-max-index__#000)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    =>
                    (do-nothing)
                    ;(up-chat-data-to-all "failed at dropsite index %d" g: gl-dropsite-index)
                )

                (defrule ; if no vills found (which should be the most common) we redo search early with new dropsite
                    (up-set-target-by-id g: gl-dropsite-id__#000) 
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 <= 0)
                    (up-compare-goal gl-main-group-switch-loop-start-rule-id__#000 != -1)
                    (up-compare-goal gl-dropsite-index__#000 g:< gl-dropsite-max-index__#000)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    =>
                    (set-goal gl-current-60-group__#000 first-60-group)
                    (up-modify-goal gl-dropsite-index__#000 c:+ 1)
                    (up-jump-direct g: gl-main-group-switch-loop-start-rule-id__#000)
                )

                (defrule ; ; if still no vills found (which should be the most common) we redo search early with increased distance
                    (up-set-target-by-id g: gl-dropsite-id__#000) 
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 <= 0)
                    (up-compare-goal gl-main-group-switch-loop-start-rule-id__#000 != -1)
                    (up-compare-goal gl-dropsite-index__#000 g:>= gl-dropsite-max-index__#000)
                    (up-compare-goal gl-dropsite-search-dist__#000 g:< gl-dropsite-max-search-dist__#000)
                    (up-compare-goal gl-dropsite-search-dist__#000 < 30)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    =>
                    (set-goal gl-current-60-group__#000 first-60-group)
                    (up-modify-goal gl-dropsite-index__#000 c:= 0)
                    ;(up-chat-data-to-all "failed at distance %d" g: gl-dropsite-search-dist)
                    (up-modify-goal gl-dropsite-search-dist__#000 c:+ 3)
                    (up-jump-direct g: gl-main-group-switch-loop-start-rule-id__#000)
                )

                (defrule ; if we have to search far we can do a broader search
                    (up-set-target-by-id g: gl-dropsite-id__#000) 
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 <= 0)
                    (up-compare-goal gl-main-group-switch-loop-start-rule-id__#000 != -1)
                    (up-compare-goal gl-dropsite-index__#000 g:>= gl-dropsite-max-index__#000)
                    (up-compare-goal gl-dropsite-search-dist__#000 g:< gl-dropsite-max-search-dist__#000)
                    (up-compare-goal gl-dropsite-search-dist__#000 >= 30)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    =>
                    (set-goal gl-current-60-group__#000 first-60-group)
                    (up-modify-goal gl-dropsite-index__#000 c:= 0)
                    (up-modify-goal gl-dropsite-search-dist__#000 c:+ 15)
                    (up-jump-direct g: gl-main-group-switch-loop-start-rule-id__#000)
                )

                (defrule
                    (up-set-target-by-id g: gl-dropsite-id__#000) 
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 > 0)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    =>
                    (do-nothing)
                    ;(up-chat-data-to-all "we still have %d vills rdy for switch" g: gl-vills-rdy-to-be-switched-nr)
                )

                (defrule ; if vills are found - make sure dropsite is valid (has res and maybe not to crowded)
                    (up-set-target-by-id g: gl-dropsite-id__#000)
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 > 0)
                    (up-compare-goal gl-vill-deficit-group__#000 == gold-group)
                    =>
                    (up-filter-distance c: -1 c: 6)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: gold c: 10)
                    (up-get-search-state gl-local-total)
                    ;(up-chat-data-to-all "found %d gold tiles before" g: gl-remote-total)
                    (up-remove-objects search-remote object-data-tasks-count > 2)
                    (up-get-search-state gl-local-total)
                    ;(up-chat-data-to-all "found %d gold tiles after" g: gl-remote-total)
                    (up-modify-goal gl-valid-res-targets__#000 g:= gl-remote-total)
                    (up-modify-goal gl-valid-res-targets__#000 c:* 2)
                )

                (defrule ; if vills are found - make sure dropsite is valid (has res and maybe not to crowded)
                    (up-set-target-by-id g: gl-dropsite-id__#000)
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 > 0)
                    (up-compare-goal gl-vill-deficit-group__#000 == stone-group)
                    =>
                    (up-filter-distance c: -1 c: 6)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: stone c: 10)
                    (up-get-search-state gl-local-total)
                    ;(up-chat-data-to-all "found %d gold tiles before" g: gl-remote-total)
                    (up-remove-objects search-remote object-data-tasks-count > 2)
                    (up-get-search-state gl-local-total)
                    ;(up-chat-data-to-all "found %d gold tiles after" g: gl-remote-total)
                    (up-modify-goal gl-valid-res-targets__#000 g:= gl-remote-total)
                    (up-modify-goal gl-valid-res-targets__#000 c:* 2)
                )

                (defrule ; if vills are found - make sure dropsite is valid (has res and maybe not to crowded)
                    (up-set-target-by-id g: gl-dropsite-id__#000)
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 > 0)
                    (up-compare-goal gl-vill-deficit-group__#000 == wood-group)
                    =>
                    (up-filter-distance c: -1 c: 7)
                    (up-filter-status c: status-ready c: list-active)
                    (up-find-resource c: wood c: 10)
                    (up-remove-objects search-remote object-data-tasks-count > 1)
                    (up-get-search-state gl-local-total)
                    ;(up-chat-data-to-all "found %d gold tiles before" g: gl-remote-total)
                    (up-get-search-state gl-local-total)
                    ;(up-chat-data-to-all "found %d gold tiles after" g: gl-remote-total)
                    (up-modify-goal gl-valid-res-targets__#000 g:= gl-remote-total)
                    (up-modify-goal gl-valid-res-targets__#000 c:* 2)
                )

                (defrule ; if vills are found - make sure dropsite is valid (has res and maybe not to crowded)
                    (up-set-target-by-id g: gl-dropsite-id__#000)
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 > 0)
                    (up-compare-goal gl-vill-deficit-group__#000 == food-group)
                    =>
                    (up-filter-distance c: -1 c: 10)
                    (up-modify-sn sn-focus-player-number c:= my-player-number)
                    (up-find-remote c: farm-class c: 30)
                    (up-remove-objects search-remote object-data-tasks-count > 0)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-valid-res-targets__#000 g:= gl-remote-total)
                    (up-reset-search 0 0 1 1)
                    (up-filter-distance c: -1 c: 6)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: food c: 10)
                    (up-remove-objects search-remote object-data-tasks-count > 2)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp g:= gl-remote-total)
                    (up-modify-goal gl-temp c:* 2)
                    (up-modify-goal gl-valid-res-targets__#000 g:+ gl-temp)
                )

                (defrule
                    (up-set-target-by-id g: gl-dropsite-id__#000)
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 > 0)
                    (up-compare-goal gl-vill-deficit-group__#000 == food-group)
                    =>
                    (up-reset-search 0 0 1 1)
                    (up-filter-distance c: -1 c: 5)
                    (up-filter-status c: status-gather c: list-active)
                    (up-find-resource c: shore-fish-class c: 10)
                    (up-remove-objects search-remote object-data-tasks-count > 2)
                    (up-remove-objects search-remote object-data-carry <= 10)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp g:= gl-remote-total)
                    (up-modify-goal gl-temp c:* 2)
                    (up-modify-goal gl-valid-res-targets__#000 g:+ gl-temp)
                    (up-reset-search 0 0 1 1)
                    (up-filter-status c: status-gather c: list-active)
                    (up-find-resource c: prey-animal-class c: 10)
                    (up-remove-objects search-remote object-data-tasks-count > 3)
                    (up-remove-objects search-remote object-data-carry <= 10)
                    
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp g:= gl-remote-total)
                    (up-modify-goal gl-temp c:* 2)
                    (up-modify-goal gl-valid-res-targets__#000 g:+ gl-temp)
                )

                (defrule
                    (up-set-target-by-id g: gl-dropsite-id__#000)
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 > 0)
                    (up-compare-goal gl-vill-deficit-group__#000 == food-group)
                    =>
                    (up-reset-search 0 0 1 1)
                    (up-filter-status c: status-gather c: list-active)
                    (up-find-resource c: livestock-class c: 10)
                    (up-filter-status c: status-ready c: list-active)
                    (up-find-resource c: livestock-class c: 10)
                    (up-remove-objects search-remote object-data-tasks-count > 6)
                    (up-remove-objects search-remote object-data-carry <= 10)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp g:= gl-remote-total)
                    (up-modify-goal gl-temp c:* 3)
                    (up-modify-goal gl-valid-res-targets__#000 g:+ gl-temp)
                    (up-reset-search 0 0 1 1)
                    (up-filter-status c: status-gather c: list-active)
                    (up-find-resource c: predator-animal-class c: 10)
                    (up-remove-objects search-remote object-data-tasks-count > 7)
                    (up-remove-objects search-remote object-data-carry <= 10)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp g:= gl-remote-total)
                    (up-modify-goal gl-temp c:* 4)
                    (up-modify-goal gl-valid-res-targets__#000 g:+ gl-temp)
                )

                (defrule ; if dropsite is invalid - try next dropsite
                    (up-set-target-by-id g: gl-dropsite-id__#000) 
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 > 0)
                    (up-compare-goal gl-main-group-switch-loop-start-rule-id__#000 != -1)
                    (up-compare-goal gl-dropsite-index__#000 g:< gl-dropsite-max-index__#000)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    (up-compare-goal gl-valid-res-targets__#000 <= 0)
                    =>
                    (set-goal gl-current-60-group__#000 first-60-group)
                    (up-modify-goal gl-dropsite-index__#000 c:+ 1)
                    (up-jump-direct g: gl-main-group-switch-loop-start-rule-id__#000)
                )

                (defrule ; if all dropsites are invalid - chose starting tc as dropsite
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 > 0)
                    (up-compare-goal gl-main-group-switch-loop-start-rule-id__#000 != -1)
                    (up-compare-goal gl-dropsite-index__#000 g:>= gl-dropsite-max-index__#000)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    (up-compare-goal gl-valid-res-targets__#000 <= 0)
                    =>
                    (up-modify-goal gl-dropsite-id__#000 g:= gl-starting-tc-id__#000)
                    (set-goal gl-valid-res-targets__#000 1)
                )

                (defrule ; if dropsite is valid we switch vills and update values controlling future switches
                    (up-compare-goal gl-valid-res-targets__#000 > 0)
                    (up-set-target-by-id g: gl-dropsite-id__#000)
                    (up-compare-goal gl-vills-rdy-to-be-switched-nr__#000 > 0)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    =>
                    (up-modify-goal gl-vills-rdy-to-be-switched-nr__#000 g:min gl-valid-res-targets__#000)
                    (up-modify-goal gl-vills-rdy-to-be-switched-nr__#000 g:min gl-misasigned-beyond-accepted__#000)
                    (up-clean-search search-local object-data-distance search-order-asc)
                    (up-remove-objects search-local object-data-index g:>= gl-vills-rdy-to-be-switched-nr__#000)
                    (up-reset-group g: gl-vill-deficit-group__#000)
                    (up-modify-group-flag 0 g: gl-vill-deficit-group__#000)
                    (up-create-group 0 0 g: gl-vill-deficit-group__#000)
                    (up-modify-group-flag 1 g: gl-vill-deficit-group__#000)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-nr-vills-switched__#000 g:= gl-local-total)
                    (up-modify-goal gl-misasigned-beyond-accepted__#000 g:- gl-nr-vills-switched__#000)
                    
                    (up-modify-goal gl-res-vill-surplus__#000 g:- gl-nr-vills-switched__#000)
                    (up-set-indirect-goal g: gl-current-surplus-goal-constant__#000 g: gl-res-vill-surplus__#000)
                    (up-modify-goal gl-res-vill-deficit__#000 g:+ gl-nr-vills-switched__#000)
                    (up-set-indirect-goal g: gl-current-deficit-goal-constant__#000 g: gl-res-vill-deficit__#000)
                    (up-modify-goal gl-nr-vills-to-switch__#000 g:- gl-nr-vills-switched__#000)
                    (set-goal gl-switched-vills__#000 YES)

                    ;(up-chat-data-to-all "switched %d vills" g: gl-nr-vills-switched)
                    ;(up-chat-data-to-all "from %d " g: gl-vill-surplus-group)
                    ;(up-chat-data-to-all "to %d" g: gl-vill-deficit-group)
                    ;(up-chat-data-to-all "new surplus: %d" g: gl-res-vill-surplus)
                    ;(up-chat-data-to-all "new deficit: %d" g: gl-res-vill-deficit)
                )

                (defrule ; if we switched vills and instant dropoff is active we make the vills dropoff
                    (goal gl-switched-vills__#000 YES)
                    (up-compare-goal gl-instant-dropoff__#000 == YES)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-remove-objects search-local object-data-carry == 0)
                    (up-reset-search 0 0 1 1)
                )

                (defrule ; if we switched vills and instant dropoff is active we make the vills dropoff
                    (goal gl-switched-vills__#000 YES)
                    (up-compare-goal gl-instant-dropoff__#000 == YES)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-point position-object gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-filter-distance c: -1 c: 10)
                    (up-modify-sn sn-focus-player-number c:= my-player-number)
                    (up-find-remote c: town-center c: 3)
                    (up-find-remote g: gl-res-dropsite__#000 c: 5)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    (up-remove-objects search-remote object-data-index != 0)
                )

                (defrule ; if we switched vills and instant dropoff is active we make the vills dropoff
                    (goal gl-switched-vills__#000 YES)
                    (up-compare-goal gl-instant-dropoff__#000 == YES)
                    (up-set-target-object search-local c: 0)
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-target-objects 0 action-default -1 -1)
                    (up-remove-objects search-local object-data-index == 0)
                    (up-jump-rule -3)
                )

                (defrule ; if no more vills need switching we break loop
                    (or(up-compare-goal gl-nr-vills-to-switch__#000 <= 0)
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 < 0))
                    (goal gl-trying-to-switch-vills__#000 YES)
                    (up-compare-goal gl-post-group-switch-rule-id__#000 != -1)
                    =>
                    (up-jump-direct g: gl-post-group-switch-rule-id__#000)
                )

                (defrule ; if more vills need switching and we just switched vills we redo loop 
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    (goal gl-trying-to-switch-vills__#000 YES)
                    (goal gl-switched-vills__#000 YES)
                    (up-compare-goal gl-main-group-switch-loop-start-rule-id__#000 != -1)
                    =>
                    (up-jump-direct g: gl-main-group-switch-loop-start-rule-id__#000)
                )

                (defrule ; if more vills need switching and we just switched vills we redo loop 
                    (up-compare-goal gl-misasigned-beyond-accepted__#000 > 0)
                    (goal gl-trying-to-switch-vills__#000 YES)
                    (goal gl-switched-vills__#000 NO)
                    (up-compare-goal gl-post-group-switch-rule-id__#000 != -1)
                    =>
                    ;(up-chat-data-to-all "Failed to switch %d vills" g: gl-nr-vills-to-switch)
                    ;(up-chat-data-to-all "from %d" g: gl-vill-surplus-group)
                    ;(up-chat-data-to-all "to %d" g: gl-vill-deficit-group)
                    (up-jump-direct g: gl-post-group-switch-rule-id__#000)
                )

    ; Prepare res search groups for crowding calculations (cant be used for main loop due to 60 unit limit).
        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class g: gl-vill-nr)
            (up-remove-objects search-local object-data-group-flag != wood-group)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-nr-wood-vills-with-flag__#000 g:= gl-local-total)
            (up-reset-group c: wood-group)
            (up-create-group 0 0 c: wood-group)
            (up-full-reset-search)
            (up-find-local c: villager-class g: gl-vill-nr)
            (up-remove-objects search-local object-data-group-flag != food-group)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-nr-food-vills-with-flag__#000 g:= gl-local-total)
            (up-reset-group c: food-group)
            (up-create-group 0 0 c: food-group)
            (up-full-reset-search)
            (up-find-local c: villager-class g: gl-vill-nr)
            (up-remove-objects search-local object-data-group-flag != gold-group)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-nr-gold-vills-with-flag__#000 g:= gl-local-total)
            (up-reset-group c: gold-group)
            (up-create-group 0 0 c: gold-group)
            (up-full-reset-search)
            (up-find-local c: villager-class g: gl-vill-nr)
            (up-remove-objects search-local object-data-group-flag != stone-group)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-nr-stone-vills-with-flag__#000 g:= gl-local-total)
            (up-reset-group c: stone-group)
            (up-create-group 0 0 c: stone-group)
        )

        (defrule
            (true)
            =>
            (do-nothing)
            ;(up-chat-data-to-all "food flag vills: %d" g: gl-nr-food-vills-with-flag)
            ;(up-chat-data-to-all "wood flag vills: %d" g: gl-nr-wood-vills-with-flag)
            ;(up-chat-data-to-all "stone flag vills: %d" g: gl-nr-stone-vills-with-flag)
            ;(up-chat-data-to-all "gold flag vills: %d" g: gl-nr-gold-vills-with-flag)
        )
        
        
    ; Update vill search groups if vills died
        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-set-group search-local c: wood-group)
            (up-remove-objects search-local object-data-id <= 0)
            (up-reset-group c: wood-group)
            (up-create-group 0 0 c: wood-group)
            (up-full-reset-search)
            (up-set-group search-local c: food-group)
            (up-remove-objects search-local object-data-id <= 0)
            (up-reset-group c: food-group)
            (up-create-group 0 0 c: food-group)
            (up-full-reset-search)
            (up-set-group search-local c: gold-group)
            (up-remove-objects search-local object-data-id <= 0)
            (up-reset-group c: gold-group)
            (up-create-group 0 0 c: gold-group)
            (up-full-reset-search)
            (up-set-group search-local c: stone-group)
            (up-remove-objects search-local object-data-id <= 0)
            (up-reset-group c: stone-group)
            (up-create-group 0 0 c: stone-group)
            (up-full-reset-search)
            (up-set-group search-local c: temp-group1)
            (up-remove-objects search-local object-data-id <= 0)
            (up-reset-group c: temp-group1)
            (up-create-group 0 0 c: temp-group1)
            (up-full-reset-search)
            (up-set-group search-local c: temp-group2)
            (up-remove-objects search-local object-data-id <= 0)
            (up-reset-group c: temp-group2)
            (up-create-group 0 0 c: temp-group2)
        )
    

    ; Set up 4 search groups of up to 60 vills to be used for the big loop to run faster.

        (defrule 
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 240)
            (up-remove-objects search-local object-data-action c:== actionid-build)
            (up-remove-objects search-local object-data-action c:== actionid-attack)
            (up-remove-objects search-local object-data-action c:== actionid-explore)
            (up-remove-objects search-local object-data-tasks-count c:> 0)
            ;(up-remove-objects search-local object-data-carry > 0)
            (set-goal gl-vill-index__#000 0)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-vill-max-index__#000 g:= gl-local-total)
            (up-modify-goal gl-vill-max-index__#000 c:- 1)
        )

        (defrule
            (up-set-target-object search-local g: gl-vill-index__#000)
            (up-object-data object-data-carry > 0)
            (up-object-data object-data-idling != 1)
            =>
            (up-remove-objects search-local object-data-index g:== gl-vill-index__#000)
            (up-jump-rule -1)
        )

        (defrule
            (up-compare-goal gl-vill-index__#000 g:< gl-vill-max-index__#000)
            =>
            (up-modify-goal gl-vill-index__#000 c:+ 1)
            (up-jump-rule -2)
        )

        (defrule
            (true)
            =>
            (up-remove-objects search-local object-data-index >= 60)
            (up-reset-group c: first-60-group)
            (up-create-group 0 0 c: first-60-group)
        )


        (defrule 
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 240)
            (up-remove-objects search-local object-data-action c:== actionid-build)
            (up-remove-objects search-local object-data-action c:== actionid-attack)
            (up-remove-objects search-local object-data-action c:== actionid-explore)
            (up-remove-objects search-local object-data-tasks-count c:> 0)
            ;(up-remove-objects search-local object-data-carry > 0)
            (set-goal gl-vill-index__#000 0)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-vill-max-index__#000 g:= gl-local-total)
            (up-modify-goal gl-vill-max-index__#000 c:- 1)
        )

        (defrule
            (up-set-target-object search-local g: gl-vill-index__#000)
            (up-object-data object-data-carry > 0)
            (up-object-data object-data-idling != 1)
            =>
            (up-remove-objects search-local object-data-index g:== gl-vill-index__#000)
            (up-jump-rule -1)
        )

        (defrule
            (up-compare-goal gl-vill-index__#000 g:< gl-vill-max-index__#000)
            =>
            (up-modify-goal gl-vill-index__#000 c:+ 1)
            (up-jump-rule -2)
        )

        (defrule
            (true)
            =>
            (up-remove-objects search-local object-data-index < 60)
            (up-remove-objects search-local object-data-index >= 60)
            (up-reset-group c: second-60-group)
            (up-create-group 0 0 c: second-60-group)
        )


        (defrule 
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 240)
            (up-remove-objects search-local object-data-action c:== actionid-build)
            (up-remove-objects search-local object-data-action c:== actionid-attack)
            (up-remove-objects search-local object-data-action c:== actionid-explore)
            (up-remove-objects search-local object-data-tasks-count c:> 0)
            ;(up-remove-objects search-local object-data-carry > 0)
            (set-goal gl-vill-index__#000 0)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-vill-max-index__#000 g:= gl-local-total)
            (up-modify-goal gl-vill-max-index__#000 c:- 1)
        )

        (defrule
            (up-set-target-object search-local g: gl-vill-index__#000)
            (up-object-data object-data-carry > 0)
            (up-object-data object-data-idling != 1)
            =>
            (up-remove-objects search-local object-data-index g:== gl-vill-index__#000)
            (up-jump-rule -1)
        )

        (defrule
            (up-compare-goal gl-vill-index__#000 g:< gl-vill-max-index__#000)
            =>
            (up-modify-goal gl-vill-index__#000 c:+ 1)
            (up-jump-rule -2)
        )

        (defrule
            (true)
            =>
            (up-remove-objects search-local object-data-index < 120)
            (up-remove-objects search-local object-data-index >= 60)
            (up-reset-group c: third-60-group)
            (up-create-group 0 0 c: third-60-group)
        )


        (defrule 
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 240)
            (up-remove-objects search-local object-data-action c:== actionid-build)
            (up-remove-objects search-local object-data-action c:== actionid-attack)
            (up-remove-objects search-local object-data-action c:== actionid-explore)
            (up-remove-objects search-local object-data-tasks-count c:> 0)
            ;(up-remove-objects search-local object-data-carry > 0)
            (set-goal gl-vill-index__#000 0)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-vill-max-index__#000 g:= gl-local-total)
            (up-modify-goal gl-vill-max-index__#000 c:- 1)
        )

        (defrule
            (up-set-target-object search-local g: gl-vill-index__#000)
            (up-object-data object-data-carry > 0)
            (up-object-data object-data-idling != 1)
            =>
            (up-remove-objects search-local object-data-index g:== gl-vill-index__#000)
            (up-jump-rule -1)
        )

        (defrule
            (up-compare-goal gl-vill-index__#000 g:< gl-vill-max-index__#000)
            =>
            (up-modify-goal gl-vill-index__#000 c:+ 1)
            (up-jump-rule -2)
        )

        (defrule
            (true)
            =>
            (up-remove-objects search-local object-data-index < 180)
            (up-remove-objects search-local object-data-index >= 60)
            (up-reset-group c: forth-60-group)
            (up-create-group 0 0 c: forth-60-group)
        )

    
    ; Loop through vills in each vill group. If a vill has a wrong target jump to retasking code. (find dropsites) 
        

        ; Initialise values and prep temp group for loops

            

            (defrule ; Set values once before loops
                (true)
                =>
                (set-goal gl-scan-group__#000 gold-group) ; 4
                (set-goal gl-intended-target-res__#000 gold) ; 3
                (set-goal gl-pass-target-count__#000 0)
                (set-goal gl-pass-target-slot__#000 gl-pass-target-slot-first__#000)
                (set-goal gl-pass-target-slot-end__#000 gl-pass-target-slot-first__#000)
                (set-goal gl-fallback-food-1__#000 wood) 
                (set-goal gl-fallback-food-2__#000 gold) 
                (set-goal gl-fallback-food-3__#000 stone) 
                (set-goal gl-fallback-wood-1__#000 gold) 
                (set-goal gl-fallback-wood-2__#000 stone) 
                (set-goal gl-fallback-wood-3__#000 food) 
                (set-goal gl-fallback-gold-1__#000 wood) 
                (set-goal gl-fallback-gold-2__#000 stone) 
                (set-goal gl-fallback-gold-3__#000 food) 
                (set-goal gl-fallback-stone-1__#000 gold) 
                (set-goal gl-fallback-stone-2__#000 wood) 
                (set-goal gl-fallback-stone-3__#000 food) 
                (set-goal gl-current-60-group__#000 first-60-group)
            )

            (defrule ; jump to this rule when changing group and set values and local list once for that group
                (true)
                =>
                (up-get-rule-id gl-next-vill-group-rule-id__#000)
                (up-full-reset-search)
                (up-set-group search-local g: gl-current-60-group__#000)
                (up-remove-objects search-local object-data-group-flag g:!= gl-scan-group__#000)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-vill-index-max__#000 g:= gl-local-total)
                (up-modify-goal gl-vill-index-max__#000 c:- 1)
                (set-goal gl-vill-index__#000 0)
                (set-goal gl-group-backup-res__#000 -1) 
            )

        ; Choose vill and find target and intended target
            (defrule ; jump to this rule for each new vill
                (true)
                =>
                (up-get-rule-id gl-find-misassigned-vill-rule-id__#000)
                (up-full-reset-search)
                (up-set-group search-local g: gl-current-60-group__#000)
                (up-remove-objects search-local object-data-group-flag g:!= gl-scan-group__#000)
                (set-goal gl-vill-target-res__#000 -1)
            )

            (defrule ; set values for vill
                (up-set-target-object search-local g: gl-vill-index__#000) 
                =>
                (up-get-object-data object-data-id gl-vill-id__#000)
                (up-get-object-data object-data-language-id gl-vill-lang-id__#000)
                (up-get-point position-object gl-vill-x__#000)
            )

            (defrule ; find actual target res
                (or (or (or (or (up-compare-goal gl-vill-lang-id__#000 c:== lid-villager-farmer)
                                (up-compare-goal gl-vill-lang-id__#000 c:== lid-villager-forager))
                            (up-compare-goal gl-vill-lang-id__#000 c:== lid-villager-shepherd))
                        (up-compare-goal gl-vill-lang-id__#000 c:== lid-villager-hunter))
                    (up-compare-goal gl-vill-lang-id__#000 c:== lid-villager-fisherman))
                =>
                (up-modify-goal gl-vill-target-res__#000 c:= food))

            (defrule
                (up-compare-goal gl-vill-lang-id__#000 c:== lid-villager-lumberjack)
                =>
                (up-modify-goal gl-vill-target-res__#000 c:= wood))

            (defrule
                (up-compare-goal gl-vill-lang-id__#000 c:== lid-villager-stone-miner)
                =>
                (up-modify-goal gl-vill-target-res__#000 c:= stone))

            (defrule
                (up-compare-goal gl-vill-lang-id__#000 c:== lid-villager-gold-miner)
                =>
                (up-modify-goal gl-vill-target-res__#000 c:= gold))

        ; If intended and actual target don't match or vill is idle: save vill info and jump to retask rules

            (defrule
                (true)
                =>
                (set-goal gl-retask-needed__#000 NO)
            )

            (defrule
                (taunt-detected my-player-number debug-taunt__#001)
                =>
                (up-chat-data-to-all "gl-vill-index__#000: %d" g: gl-vill-index__#000)
            )

            (defrule
                (taunt-detected my-player-number debug-taunt__#001)
                (up-set-target-object search-local g: gl-vill-index__#000)
                (up-object-data object-data-idling == 1)
                =>
                (chat-to-all "vill is idle")
            )

            (defrule
                (taunt-detected my-player-number debug-taunt__#001)
                (up-set-target-object search-local g: gl-vill-index__#000)
                =>
                (up-chat-data-to-all "gl-vill-target-res__#000: %d" g: gl-vill-target-res__#000)
                (up-chat-data-to-all "gl-intended-target-res__#000: %d" g: gl-intended-target-res__#000)
            )

            (defrule
                (up-set-target-object search-local g: gl-vill-index__#000)
                (or(up-compare-goal gl-vill-target-res__#000 g:!= gl-intended-target-res__#000)
                (up-object-data object-data-idling == 1))
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1)
                =>
                (set-goal gl-retask-needed__#000 YES)
            )

            (defrule
                (taunt-detected my-player-number debug-taunt__#001)
                (goal gl-retask-needed__#000 YES)
                =>
                (chat-to-all "retask needed")
            )

            (defrule
                (up-set-target-object search-local g: gl-vill-index__#000) 
                (up-compare-goal gl-vill-target-res__#000 g:!= gl-intended-target-res__#000)
                ;(game-time > 10)
                =>
                ;(up-chat-data-to-all "res group nr: %d" g: gl-scan-group__#000)
                ;(up-chat-data-to-all "nr 60 group: %d" g: gl-current-60-group)
                ;(up-full-reset-search)
                ;(up-add-object-by-id search-local g: gl-vill-id__#000)
                ;(up-target-point gl-temp-x action-delete -1 -1)
                (do-nothing)
            )

            (defrule 
                (goal gl-retask-needed__#000 YES)
                (or(up-compare-goal gl-group-backup-res__#000 == -1) ; No backup res chosen
                (and(up-compare-goal gl-group-backup-res__#000 != -1) ; Backup res chosen and condition wan't cause back and forth retask
                (or(up-object-data object-data-idling == 1)
                (up-compare-goal gl-vill-target-res__#000 g:!= gl-group-backup-res__#000))))
                =>
                (up-modify-goal gl-retask-vill-id__#000 g:= gl-vill-id__#000)
                (up-modify-goal gl-retask-target-res__#000 g:= gl-intended-target-res__#000)
                (up-modify-goal gl-retask-base-res__#000 g:= gl-intended-target-res__#000) 
                (set-goal gl-fallback-step__#000 0) 
                (up-copy-point gl-retask-vill-x__#000 gl-vill-x__#000)
                (up-jump-direct g: gl-retask-section-first-rule-id__#000)
            )
        
        ; If retask was unsuccessfull we try another fallback res.

            (defrule ; rule to jump to after retasking
                (true)
                =>
                (up-get-rule-id gl-post-retask-rule-id__#000)
            )
            
            (defrule 
                (up-compare-goal gl-retask-failed__#000 == YES)  
                (up-compare-goal gl-group-backup-res__#000 != -1) ; a backup has been locked for this group in this pass 
                (up-compare-goal gl-retask-target-res__#000 g:== gl-retask-base-res__#000) ; only trigger right after the primary attempt failed
                (up-compare-goal gl-fallback-step__#000 == 0) ; ensures we only swap to the locked backup once
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1)
                =>
                (set-goal gl-fallback-step__#000 10) ;  mark that this villager has already consumed the one allowed locked-backup retry
                (up-modify-goal gl-retask-target-res__#000 g:= gl-group-backup-res__#000) ; retry with the backup resource already locked for the group
                (up-jump-direct g: gl-retask-section-first-rule-id__#000)
            )


            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == food) ; use the villager's original resource as the fallback anchor
                (up-compare-goal gl-fallback-step__#000 == 0) ; first fallback attempt for food villagers
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 1) ; advance to food fallback slot 1
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-food-1__#000) ; food fallback 1 target
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) ; retry same villager with fallback resource
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == food) 
                (up-compare-goal gl-fallback-step__#000 == 1) 
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 2) 
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-food-2__#000) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) 
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == food) 
                (up-compare-goal gl-fallback-step__#000 == 2) 
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 3) 
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-food-3__#000) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) 
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == wood) 
                (up-compare-goal gl-fallback-step__#000 == 0) 
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 1) 
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-wood-1__#000) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) 
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == wood) 
                (up-compare-goal gl-fallback-step__#000 == 1) 
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 2) 
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-wood-2__#000) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) 
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == wood) 
                (up-compare-goal gl-fallback-step__#000 == 2) 
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 3) 
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-wood-3__#000) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) 
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == gold) 
                (up-compare-goal gl-fallback-step__#000 == 0) 
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 1) 
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-gold-1__#000) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) 
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == gold) 
                (up-compare-goal gl-fallback-step__#000 == 1) 
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 2) 
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-gold-2__#000) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) 
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == gold) 
                (up-compare-goal gl-fallback-step__#000 == 2) 
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 3) 
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-gold-3__#000) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) 
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == stone) 
                (up-compare-goal gl-fallback-step__#000 == 0) 
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 1) 
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-stone-1__#000) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) 
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == stone) 
                (up-compare-goal gl-fallback-step__#000 == 1) 
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 2) 
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-stone-2__#000) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) 
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == YES)
                (up-compare-goal gl-retask-base-res__#000 == stone) 
                (up-compare-goal gl-fallback-step__#000 == 2) 
                (up-compare-goal gl-retask-section-first-rule-id__#000 != -1) 
                =>
                (set-goal gl-fallback-step__#000 3) 
                (up-modify-goal gl-retask-target-res__#000 g:= gl-fallback-stone-3__#000) 
                (up-jump-direct g: gl-retask-section-first-rule-id__#000) 
            )

        ; Once vill is retasked we check for remaining vills and jump back
            
            (defrule ; jump to next vill in group.
                (up-compare-goal gl-vill-index__#000 g:< gl-vill-index-max__#000)
                (up-compare-goal gl-find-misassigned-vill-rule-id__#000 != -1)
                =>
                (up-modify-goal gl-vill-index__#000 c:+ 1)
                (up-jump-direct g: gl-find-misassigned-vill-rule-id__#000)
            )

        ; Once vill-group is done we jump to check remaining groups

            (defrule
                (up-compare-goal gl-current-60-group__#000 < forth-60-group)
                (up-compare-goal gl-next-vill-group-rule-id__#000 != -1)
                =>
                (up-modify-goal gl-current-60-group__#000 c:+ 1)
                (up-jump-direct g: gl-next-vill-group-rule-id__#000)
            )

            (defrule ; jump to next group
                (up-compare-goal gl-scan-group__#000 > 1)
                (up-compare-goal gl-next-vill-group-rule-id__#000 != -1)
                =>
                (up-modify-goal gl-scan-group__#000 c:- 1)
                (up-modify-goal gl-intended-target-res__#000 g:= gl-scan-group__#000)
                (up-modify-goal gl-intended-target-res__#000 c:- 1)
                (set-goal gl-current-60-group__#000 first-60-group)
                (up-jump-direct g: gl-next-vill-group-rule-id__#000)
            )

        ; When no more groups to check: jump to end of DUC eco.
            (defrule 
                (up-compare-goal gl-duc-eco-end-rule-id__#000 != -1)
                =>
                (up-jump-direct g: gl-duc-eco-end-rule-id__#000)
            )

    ; Find best dropsite for villager to be retasked
        ; Prepare dropsite score loop
            (defrule ; jump to this rule when a vill is to be retasked and find dropsite candidates
                (true) ;###
                =>
                (up-get-rule-id gl-retask-section-first-rule-id__#000)
                (up-full-reset-search)
                ; evt. filter distance på 40
                (up-find-local c: town-center c: 240)
            )

            (defrule
                (goal gl-retask-from__#000 wrong-sheep-section)
                =>
                ;(fe-break-point 1 == 1 -1)
                (do-nothing)
            )
            

            (defrule
                (taunt-detected my-player-number debug-taunt__#001)
                =>
                (up-chat-data-to-all "vill chosen for retasking to %d" g: gl-retask-target-res__#000)
            )

            (defrule
                (up-set-target-by-id g: gl-retask-vill-id__#000) 
                (up-compare-goal gl-vill-target-res__#000 g:== gl-retask-target-res__#000) 
                (up-object-data object-data-idling == 0) 
                (up-compare-goal gl-post-retask-rule-id__#000 != -1)
                (up-compare-goal gl-retask-from__#000 == -1)
                =>
                (set-goal gl-retask-failed__#000 NO) 
                (up-jump-direct g: gl-post-retask-rule-id__#000) 
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == wood)
                =>
                (up-find-local c: lumber-camp c: 240)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: lumber-camp c: 240)
                (up-filter-status c: status-ready c: list-active)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == food)
                =>
                (up-find-local c: mill c: 240)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: mill c: 240)
                (up-filter-status c: status-ready c: list-active)
            )

            (defrule
                (or(up-compare-goal gl-retask-target-res__#000 == gold)
                (up-compare-goal gl-retask-target-res__#000 == stone))
                =>
                (up-find-local c: mining-camp c: 240)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: mining-camp c: 240)
                (up-filter-status c: status-ready c: list-active)
            )

            (defrule ; save dropsite candidates and initialise values for dropsite loop
                (true)
                =>
                (up-set-target-point gl-vill-x__#000)
                (up-clean-search search-local object-data-distance search-order-asc)
                (up-reset-group c: dropsite-candidate-group__#000)
                (up-create-group 0 0 c: dropsite-candidate-group__#000)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-dropsite-max-index__#000 g:= gl-local-total)
                (up-modify-goal gl-dropsite-max-index__#000 c:- 1)
                (set-goal gl-best-dropsite-score__#000 -99999)
                (set-goal gl-dropsite-index__#000 0)
                (set-goal gl-best-dropsite-id__#000 -1)
            )

        ; Dropsite loop start - Collect dropsite info

            (defrule ; jump to this rule for each new dropsite
                (true)
                =>
                (up-get-rule-id gl-score-dropsite-first-rule-id__#000)
                (up-full-reset-search)
                (up-set-group search-local c: dropsite-candidate-group__#000)
                (set-goal gl-fall-back-search-activated__#000 NO)
            )

            (defrule ; get info not specific to target res
                (up-set-target-object search-local g: gl-dropsite-index__#000)
                =>
                (up-get-object-data object-data-id gl-dropsite-id__#000)
                (up-get-point position-object gl-dropsite-x__#000)
                (up-get-point-distance gl-retask-vill-x__#000 gl-dropsite-x__#000 gl-vill-dropsite-dist__#000)
                (up-set-target-point gl-dropsite-x__#000)

                (set-goal gl-dropsite-crowding__#000 0)
                (up-full-reset-search)
                (up-set-group search-local g: gl-scan-group__#000) 
                (up-remove-objects search-local object-data-group-flag g:!= gl-scan-group__#000)
                (up-remove-objects search-local object-data-distance > 7)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-dropsite-crowding__#000 g:+ gl-local-total)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == wood)
                =>
                (up-filter-distance c: -1 c: 4)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: wood c: 25)
                (up-remove-objects search-remote object-data-tasks-count > 1)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == wood)
                (up-compare-goal gl-remote-total < 5)
                =>
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 25)
                (up-remove-objects search-remote object-data-tasks-count > 1)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == wood)
                (up-compare-goal gl-remote-total < 5)
                (up-point-distance gl-dropsite-x__#000 gl-position-self-x > 3)
                ; this rule should not include starting tc
                =>
                (up-filter-distance c: -1 c: 7)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: wood c: 25)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 25)
                (up-remove-objects search-remote object-data-tasks-count > 1)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == wood)
                (up-compare-goal gl-remote-total <= 0)
                ; skal kun gælde for tc?
                =>
                (up-filter-distance c: -1 c: 8)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 40)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: wood c: 40)
                (up-remove-objects search-remote object-data-tasks-count > 3)
                (set-goal gl-fall-back-search-activated__#000 YES)
            )






            (defrule
                (up-compare-goal gl-retask-target-res__#000 == food)
                =>
                (up-filter-distance c: -1 c: 10)
                (up-modify-sn sn-focus-player-number c:= my-player-number)
                (up-find-remote c: farm-class c: 40)
                (up-remove-objects search-remote object-data-tasks-count > 0)
                (up-filter-distance c: -1 c: 6)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: food c: 40)
                (up-remove-objects search-remote object-data-tasks-count > 1)
                (up-filter-distance c: -1 c: 5)
                (up-filter-status c: status-gather c: list-active)
                (up-find-resource c: shore-fish-class c: 10)
                (up-remove-objects search-remote object-data-tasks-count > 1)
                (up-remove-objects search-remote object-data-carry <= 10)
                (up-set-group search-local c: target-animal-group)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == food)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-id gl-temp)
                (up-add-object-by-id search-remote g: gl-temp)
                (up-remove-objects search-local object-data-index == 0)
                (up-jump-rule -1)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == gold)
                =>
                (up-filter-distance c: -1 c: 6)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: gold c: 40)
                (up-remove-objects search-remote object-data-tasks-count > 2)
            )
            
            (defrule
                (up-compare-goal gl-retask-target-res__#000 == stone)
                =>
                (up-filter-distance c: -1 c: 6)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: stone c: 40)
                (up-remove-objects search-remote object-data-tasks-count > 2)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == stone)
                =>
                (up-filter-distance c: -1 c: 6)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: stone c: 40)
            )

            (defrule ; get info specific to target res
                (true)
                =>
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-dropsite-res-count__#000 g:= gl-remote-total)
                (up-clean-search search-remote object-data-full-distance search-order-asc)
            )

            (defrule
                (up-set-target-by-id g: gl-dropsite-id__#000)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-precise-distance gl-dropsite-res-precise-dist__#000)
            )

        ; Calculate dropsite score and chose best dropsite
            (defrule ; calculate score
                (up-compare-goal gl-retask-target-res__#000 == food)
                =>
                (up-modify-goal gl-score-vill-dist__#000 g:= gl-vill-dropsite-dist__#000)
                (up-modify-goal gl-score-vill-dist__#000 g:* gl-food-score-weight-vill-dist__#000)

                (up-modify-goal gl-score-crowding__#000 g:= gl-dropsite-crowding__#000)
                (up-modify-goal gl-score-crowding__#000 g:* gl-food-score-weight-crowding__#000)

                (up-modify-goal gl-score-res-count__#000 g:= gl-dropsite-res-count__#000)
                (up-modify-goal gl-score-res-count__#000 g:* gl-food-score-weight-res-count__#000)

                (up-modify-goal gl-score-res-dist__#000 g:= gl-dropsite-res-precise-dist__#000)
                (up-modify-goal gl-score-res-dist__#000 g:* gl-food-score-weight-res-dist__#000)
                (up-modify-goal gl-score-res-dist__#000 c:/ 100)
                
                (set-goal gl-dropsite-score__#000 0)
                (up-modify-goal gl-dropsite-score__#000 g:- gl-score-vill-dist__#000)
                (up-modify-goal gl-dropsite-score__#000 g:- gl-score-crowding__#000)
                (up-modify-goal gl-dropsite-score__#000 g:+ gl-score-res-count__#000)
                (up-modify-goal gl-dropsite-score__#000 g:- gl-score-res-dist__#000)
            )
            
            (defrule
                (true)
                =>
                (set-goal gl-mill-chosen__#000 NO)
                ;(chat-to-all "start of check")
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == food)
                (up-set-target-by-id g: gl-dropsite-id__#000)
                (up-object-data object-data-type == mill)
                =>
                (up-full-reset-search)
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-set-group search-remote c: scouted-animal-group)
                (up-remove-objects search-remote object-data-class != prey-animal-class)
                (up-remove-objects search-remote object-data-distance > 7)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-remove-objects search-local object-data-distance > 7)
                (up-remove-objects search-local object-data-idling == 1)
                (up-remove-objects search-local object-data-language-id == lid-villager-farmer)
                (up-remove-objects search-local object-data-language-id == lid-villager-forager)
                (up-remove-objects search-local object-data-language-id == lid-villager-shepherd)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-chickens-around-mill__#000 g:= gl-remote-total)
                (up-modify-goal gl-nr-foodies-around-mill__#000 g:= gl-local-total)
                (set-goal gl-mill-chosen__#000 YES)
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-remove-objects search-local object-data-distance > 7)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-nr-foodies-around-tc__#000 g:= gl-local-total)
                ;(up-chat-data-to-all "found %d chickens" g: gl-nr-chickens-around-mill)
                ;(up-chat-data-to-all "found %d foodies around mill" g: gl-nr-foodies-around-mill)
                ;(up-chat-data-to-all "found %d foodies around tc" g: gl-nr-foodies-around-tc)
            )
            
            (defrule
                (up-compare-goal gl-retask-target-res__#000 == food)
                (up-compare-goal gl-nr-foodies-around-mill__#000 >= 3)
                (up-compare-goal gl-nr-chickens-around-mill__#000 > 0)
                (goal gl-mill-chosen__#000 YES)
                =>
                ;(chat-to-all "found oversaturated chicken mill")
                (up-modify-goal gl-dropsite-score__#000 g:- gl-food-saturated-chicken-mill-penalty__#000)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == food)
                (up-compare-goal gl-nr-foodies-around-mill__#000 < 3)
                (up-compare-goal gl-nr-chickens-around-mill__#000 > 3)
                (up-compare-goal gl-nr-foodies-around-tc__#000 >= 6)
                (goal gl-mill-chosen__#000 YES)
                =>
                ;(chat-to-all "found undersaturated chicken mill")
                ;(up-chat-data-to-all "gl-score-res-count__#000: %d" g: gl-score-res-count__#000)
                (up-modify-goal gl-dropsite-score__#000 g:+ gl-food-undersaturated-chicken-mill-bonus__#000)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == food)
                (up-compare-goal gl-fall-back-search-activated__#000 == YES)
                =>
                (up-modify-goal gl-dropsite-score__#000 g:- gl-food-fall-back-search-penalty__#000)
            )

            (defrule
                (true)
                =>
                (set-goal gl-straggler-priority NO)
                ;(up-chat-data-to-all "gl-retask-target-res__#000: %d" g: gl-retask-target-res__#000)
                ;(up-chat-data-to-all "gl-group-backup-res__#000: %d" g: gl-group-backup-res__#000)
                ;(up-chat-data-to-all "gl-dropsite-index__#000: %d" g: gl-dropsite-index__#000)
                ;(up-chat-data-to-all "gl-dropsite-id__#000: %d" g: gl-dropsite-id__#000)
                ;(up-chat-data-to-all "gl-score-res-count__#000: %d" g: gl-score-res-count__#000)
            )

            (defrule
                (up-set-target-by-id g: gl-dropsite-id__#000)
                (up-compare-goal gl-retask-target-res__#000 == wood)
                (up-object-data object-data-type == town-center)
                =>
                ;(chat-to-all "building is a tc")
                (do-nothing)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == wood)
                (up-compare-goal gl-fallback-step__#000 > 0)
                ;(up-compare-goal gl-dropsite-index__#000 == 0)
                (up-set-target-by-id g: gl-dropsite-id__#000)
                (up-object-data object-data-type == town-center)
                (up-compare-goal gl-score-res-count__#000 > 0)
                =>
                (set-goal gl-straggler-priority YES)
            )

            (defrule ; calculate score
                (up-compare-goal gl-retask-target-res__#000 != food)
                =>
                (up-modify-goal gl-score-vill-dist__#000 g:= gl-vill-dropsite-dist__#000)
                (up-modify-goal gl-score-vill-dist__#000 g:* gl-non-food-score-weight-vill-dist__#000)

                (up-modify-goal gl-score-crowding__#000 g:= gl-dropsite-crowding__#000)
                (up-modify-goal gl-score-crowding__#000 g:* gl-non-food-score-weight-crowding__#000)

                (up-modify-goal gl-score-res-count__#000 g:= gl-dropsite-res-count__#000)
                (up-modify-goal gl-score-res-count__#000 g:* gl-non-food-score-weight-res-count__#000)

                (up-modify-goal gl-score-res-dist__#000 g:= gl-dropsite-res-precise-dist__#000)
                (up-modify-goal gl-score-res-dist__#000 g:* gl-non-food-score-weight-res-dist__#000)
                (up-modify-goal gl-score-res-dist__#000 c:/ 100)
                
                (set-goal gl-dropsite-score__#000 0)
                (up-modify-goal gl-dropsite-score__#000 g:- gl-score-vill-dist__#000)
                (up-modify-goal gl-dropsite-score__#000 g:- gl-score-crowding__#000)
                (up-modify-goal gl-dropsite-score__#000 g:+ gl-score-res-count__#000)
                (up-modify-goal gl-dropsite-score__#000 g:- gl-score-res-dist__#000)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 != food)
                (up-compare-goal gl-fall-back-search-activated__#000 == YES)
                =>
                (up-modify-goal gl-dropsite-score__#000 g:- gl-non-food-fall-back-search-penalty__#000)
            )

            (defrule
                (true)
                =>
                ;(up-chat-data-to-all "gl-score-res-count__#000: %d" g: gl-score-res-count__#000)
                ;(up-chat-data-to-all "gl-score-crowding__#000: %d" g: gl-score-crowding__#000)
                ;(up-chat-data-to-all "gl-score-vill-dist__#000: %d" g: gl-score-vill-dist__#000)
                ;(up-chat-data-to-all "gl-score-res-dist__#000: %d" g: gl-score-res-dist__#000)
                ;(up-chat-data-to-all "gl-dropsite-score__#000: %d" g: gl-dropsite-score__#000)
                (do-nothing)
            )

            (defrule ; chose best dropsite score and save its info
                (or(goal gl-straggler-priority YES)
                (and(up-compare-goal gl-best-dropsite-score__#000 g:< gl-dropsite-score__#000)
                (up-compare-goal gl-score-res-count__#000 > 0)))
                =>
                (up-modify-goal gl-best-dropsite-id__#000 g:= gl-dropsite-id__#000)
                (up-modify-goal gl-best-dropsite-x__#000 g:= gl-dropsite-x__#000)
                (up-modify-goal gl-best-dropsite-y__#000 g:= gl-dropsite-y__#000)
                (up-modify-goal gl-best-dropsite-score__#000 g:= gl-dropsite-score__#000)
                (up-modify-goal gl-best-score-vill-dist__#000 g:= gl-score-vill-dist__#000)
                (up-modify-goal gl-best-score-crowding__#000 g:= gl-score-crowding__#000)
                (up-modify-goal gl-best-score-res-count__#000 g:= gl-score-res-count__#000)
                (up-modify-goal gl-best-score-res-dist__#000 g:= gl-score-res-dist__#000)
            )

            (defrule
                (true)
                =>
                (set-goal gl-early-exit YES)
            )

            (defrule
                (or(up-compare-goal gl-dropsite-res-count__#000 <= 8)
                (or(up-compare-goal gl-dropsite-crowding__#000 >= 6)
                (up-compare-goal gl-dropsite-res-precise-dist__#000 >= 500)))
                =>
                (set-goal gl-early-exit NO) ;dropsite not good enough to skip remaining candidates
            )
            (defrule ;jump to next dropsite
                (up-compare-goal gl-dropsite-index__#000 g:< gl-dropsite-max-index__#000)
                (up-compare-goal gl-score-dropsite-first-rule-id__#000 != -1)
                (goal gl-early-exit NO)
                (up-compare-goal gl-straggler-priority != YES)
                (not(and(up-compare-goal gl-fallback-step__#000 > 0)
                (and(up-compare-goal gl-retask-target-res__#000 == wood)
                (up-compare-goal gl-dropsite-index__#000 < 5)))) ; when doing wood as fallback we don't want to skip the starting tc.
                =>
                (up-modify-goal gl-dropsite-index__#000 c:+ 1)
                (up-jump-direct g: gl-score-dropsite-first-rule-id__#000)
                ;(chat-to-all "checking other dropsite")
            )

        ; Dropsite score debug

            (defrule
                (up-set-target-by-id g: gl-best-dropsite-id__#000)
                (up-set-target-by-id g: gl-retask-vill-id__#000)
                (up-compare-goal gl-post-retask-rule-id__#000 != -1)
                =>
                ;(up-full-reset-search)
                ;(up-add-object-by-id search-local g: gl-retask-vill-id__#000)
                ;(up-add-object-by-id search-remote g: gl-best-dropsite-id__#000)
                ;(up-target-objects 0 action-default -1 -1)
                ;(up-chat-data-to-all "best score: %d" g: gl-best-dropsite-score__#000)
                ;(up-chat-data-to-all "villager-dropsite distance score: %d" g: gl-best-score-vill-dist__#000)
                ;(up-chat-data-to-all "crowding score: %d" g: gl-best-score-crowding__#000)
                ;(up-chat-data-to-all "dropsite-res count score: %d" g: gl-best-score-res-count__#000)
                ;(up-chat-data-to-all "dropsite-res distance score: %d" g: gl-best-score-res-dist__#000)
                ;(up-jump-direct g: gl-post-retask-rule-id)
                ;(chat-to-all "found best dropsite")
                ;(up-send-flare gl-best-dropsite-x__#000)
                (do-nothing)
            )

    ; Find the closest valid res target and order the villager there.
        ; Add potential targets to remote list
            (defrule ; initialise loop values
                (true)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-best-dropsite-x__#000)
                (set-goal gl-pass-target-slot__#000 gl-pass-target-slot-first__#000)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == wood)
                =>
                (up-filter-distance c: -1 c: 4)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: wood c: 25)
                (up-remove-objects search-remote object-data-tasks-count > 1)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == wood)
                (up-compare-goal gl-remote-total < 5)
                =>
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 25)
                (up-remove-objects search-remote object-data-tasks-count > 1)
                (up-get-search-state gl-local-total)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == wood)
                (up-compare-goal gl-remote-total <= 0)
                =>
                (up-filter-distance c: -1 c: 8)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: wood c: 40)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 40)
                (up-remove-objects search-remote object-data-tasks-count > 3)
            )
            
            (defrule
                (up-compare-goal gl-retask-target-res__#000 == gold)
                =>
                (up-filter-distance c: -1 c: 6)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: gold c: 40)
                (up-remove-objects search-remote object-data-tasks-count > 2)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == stone)
                =>
                (up-filter-distance c: -1 c: 6)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: stone c: 40)
                (up-remove-objects search-remote object-data-tasks-count > 2)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == food)
                =>
                (up-modify-sn sn-target-player-number c:= my-player-number)
                (up-filter-distance c: -1 c: 10)
                (up-find-remote c: farm-class c: 30)
                (up-remove-objects search-remote object-data-tasks-count > 0)
                (up-filter-distance c: -1 c: 6)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: food c: 40)
                (up-remove-objects search-remote object-data-tasks-count > 1)
                (up-filter-distance c: -1 c: 5)
                (up-filter-status c: status-gather c: list-active)
                (up-find-resource c: shore-fish-class c: 10)
                (up-set-group search-local c: target-animal-group)
            )

            (defrule
                (up-compare-goal gl-retask-target-res__#000 == food)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-id gl-temp)
                (up-add-object-by-id search-remote g: gl-temp)
                (up-remove-objects search-local object-data-index == 0)
                (up-jump-rule -1)
            )

        ; If vill is far from target or target is a farm we remove it from the remote list
            (defrule
                (up-set-target-by-id g: gl-best-dropsite-id__#000)
                (up-compare-goal gl-pass-target-slot__#000 g:< gl-pass-target-slot-end__#000)
                =>
                (up-get-indirect-goal g: gl-pass-target-slot__#000 gl-pass-target-id__#000)
            )

            (defrule
                (up-set-target-by-id g: gl-best-dropsite-id__#000)
                (up-compare-goal gl-pass-target-slot__#000 g:< gl-pass-target-slot-end__#000)
                (up-set-target-by-id g: gl-pass-target-id__#000)
                (or(up-point-distance gl-best-dropsite-x__#000 gl-retask-vill-x__#000 > 3)
                (up-object-data object-data-class == farm-class))
                =>
                (up-remove-objects search-remote object-data-id g:== gl-pass-target-id__#000)
                (up-modify-goal gl-pass-target-slot__#000 c:+ 1)
                (up-jump-rule -2)
            )

            (defrule
                (up-set-target-by-id g: gl-best-dropsite-id__#000)
                (up-compare-goal gl-pass-target-slot__#000 g:< gl-pass-target-slot-end__#000)
                (up-set-target-by-id g: gl-pass-target-id__#000)
                =>
                (up-modify-goal gl-pass-target-slot__#000 c:+ 1)
                (up-jump-rule -3)
            )

        ; Filter remaining targets so best targets are first in local list

            (defrule ; move targets to local list so we can save it in a temp group later
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-id gl-temp)
                (up-add-object-by-id search-local g: gl-temp)
                (up-remove-objects search-remote object-data-index == 0)
                (up-jump-rule -1)
            )

            (defrule
                (up-set-target-by-id g: gl-best-dropsite-id__#000)
                =>
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-target-max__#000 g:= gl-local-total)
                (up-modify-goal gl-target-max__#000 c:- 1)
                (up-set-target-point gl-best-dropsite-x__#000)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
            )

            (defrule
                (up-point-distance gl-best-dropsite-x__#000 gl-retask-vill-x__#000 <= 3)
                =>
                (up-set-target-point gl-retask-vill-x__#000)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
            )

            (defrule
                (true)
                =>
                (up-reset-group c: target-candidate-group__#000)
                (up-create-group 0 0 c: target-candidate-group__#000)
                (set-goal gl-target-index__#000 0)
            )

        ; Target loop start: initialise remote list with potential targets
            (defrule
                (true)
                =>
                (up-get-rule-id gl-res-target-loop-first-rule-id__#000)
                (up-full-reset-search)
                (up-set-group search-remote c: target-candidate-group__#000)
                (set-goal gl-retask-failed__#000 YES)
                (set-goal gl-target-id__#000 -1)
            )

        ; If target can be accesed we stop the loop and order the vill to the target

            (defrule
                (up-set-target-by-id g: gl-best-dropsite-id__#000)
                (up-set-target-object search-remote g: gl-target-index__#000)
                =>
                (up-get-object-data object-data-id gl-target-id__#000)
                (up-get-point position-object gl-target-x__#000)
                (up-copy-point gl-top-right-x__#000 gl-target-x__#000)
                (up-modify-goal gl-top-right-x__#000 c:+ 1)
                (up-copy-point gl-bottom-right-x__#000 gl-target-x__#000)
                (up-modify-goal gl-bottom-right-y__#000 c:+ 1)
                (up-copy-point gl-bottom-left-x__#000 gl-target-x__#000)
                (up-modify-goal gl-bottom-left-x__#000 c:- 1)
                (up-copy-point gl-top-left-x__#000 gl-target-x__#000)
                (up-modify-goal gl-top-left-y__#000 c:- 1)
                (set-goal gl-can-build-on-point__#000 NO)
            )

            (defrule
                (up-set-target-by-id g: gl-best-dropsite-id__#000)
                (up-set-target-object search-remote g: gl-target-index__#000)
                (can-afford-building palisade-wall)
                (or(up-object-data object-data-class == farm-class)
                (or(up-object-data object-data-class == livestock-class) 
                (or(up-object-data object-data-class == prey-animal-class) 
                (or(up-object-data object-data-class == predator-animal-class) 
                (or(up-object-data object-data-class == shore-fish-class) 
                (or(up-can-build-line 0 gl-top-right-x__#000 c: palisade-wall)
                (or(up-can-build-line 0 gl-bottom-right-x__#000 c: palisade-wall)
                (or(up-can-build-line 0 gl-bottom-left-x__#000 c: palisade-wall)
                (up-can-build-line 0 gl-top-left-x__#000 c: palisade-wall)))))))))
                =>
                (set-goal gl-can-build-on-point__#000 YES)
            )

            (defrule
                (up-set-target-by-id g: gl-best-dropsite-id__#000)
                (up-set-target-object search-remote g: gl-target-index__#000)
                (or(goal gl-can-build-on-point__#000 YES)
                (not(can-afford-building palisade-wall))) ; We still want retasking to work when we don't have wood to do pathing check
                (taunt-detected my-player-number debug-taunt__#001)
                =>
                (chat-to-all "retask order was given")
            )

            

            (defrule ; order vill and save the target id for future retasking
                (up-set-target-by-id g: gl-best-dropsite-id__#000)
                (up-set-target-object search-remote g: gl-target-index__#000)
                (or(goal gl-can-build-on-point__#000 YES)
                (not(can-afford-building palisade-wall))) ; We still want retasking to work when we don't have wood to do pathing check
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-retask-vill-id__#000)
                (up-add-object-by-id search-remote g: gl-target-id__#000)
                (up-target-objects 0 action-default -1 -1)
                (set-goal gl-pass-target-slot__#000 gl-pass-target-slot-first__#000)
                (up-modify-goal gl-pass-target-slot__#000 g:+ gl-pass-target-count__#000)
                (up-set-indirect-goal g: gl-pass-target-slot__#000 g: gl-target-id__#000)
                (up-modify-goal gl-pass-target-slot-end__#000 c:+ 1)
                (up-modify-goal gl-pass-target-count__#000 c:+ 1)
                (set-goal gl-retask-failed__#000 NO) 
                (up-jump-rule 1)
            )

        ; Jump to next target if target cannot be accesed
            (defrule
                (up-compare-goal gl-target-index__#000 g:< gl-target-max__#000)
                (up-compare-goal gl-res-target-loop-first-rule-id__#000 != -1)
                (up-set-target-by-id g: gl-best-dropsite-id__#000)
                (up-set-target-by-id g: gl-retask-vill-id__#000)
                =>
                (up-modify-goal gl-target-index__#000 c:+ 1)
                (up-jump-direct g: gl-res-target-loop-first-rule-id__#000)
            )
        
        ; Jump back to finding new vills to retask once this vill has been attempted retasked.

            (defrule
                (up-compare-goal gl-post-wrong-sheep-retask-rule-id__#000 != -1)
                (up-compare-goal gl-retask-from__#000 == wrong-sheep-section)
                =>
                (set-goal gl-retask-from__#000 -1)
                (up-jump-direct g: gl-post-wrong-sheep-retask-rule-id__#000)
            )

            (defrule
                (up-compare-goal gl-post-wrong-deer-retask-rule-id__#000 != -1)
                (up-compare-goal gl-retask-from__#000 == wrong-deer-section)
                =>
                (set-goal gl-retask-from__#000 -1)
                (up-jump-direct g: gl-post-wrong-deer-retask-rule-id__#000)
            )

            (defrule
                (up-compare-goal gl-retask-failed__#000 == NO) 
                (up-compare-goal gl-group-backup-res__#000 == -1) 
                (up-compare-goal gl-retask-target-res__#000 g:!= gl-retask-base-res__#000) 
                =>
                (up-modify-goal gl-group-backup-res__#000 g:= gl-retask-target-res__#000) 
            )

            (defrule
                (up-compare-goal gl-post-retask-rule-id__#000 != -1)
                ;(up-set-target-by-id g: gl-best-dropsite-id__#000)
                (up-set-target-by-id g: gl-retask-vill-id__#000)
                =>
                (up-jump-direct g: gl-post-retask-rule-id__#000)
            )

    ; End of DUC eco
        (defrule
            (up-compare-goal gl-loop-counter__#000 < 10)
            =>
            (up-modify-goal gl-loop-counter__#000 c:+ 1)
            ;(up-jump-direct g: gl-pre-duc-eco-rule-id)
        )
        (defrule
            (true)
            =>
            (up-get-rule-id gl-duc-eco-end-rule-id__#000)
        )

    ; Lag test
        (defrule
        (taunt-detected my-player-number 103)
        =>
        (up-modify-goal gl-temp g:= gl-script-time__#051)
        (up-get-precise-time gl-script-start-time__#051 gl-script-time__#051)
        (up-modify-goal gl-temp g:- gl-script-time__#051)
        (up-modify-goal gl-temp1 g:neg gl-temp)
        (up-modify-goal gl-temp g:max gl-temp1)
        (up-chat-data-to-all "DUC ECO: %d ms" g: gl-script-time__#051)
        )

; Extra DUC eco #000
    
    ; Decide wether to prioritise rotting or food overloading.
        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 200)
            (up-remove-objects search-local object-data-group-flag != food-group)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-boar-sheep-vill-nr g:= gl-local-total)
            (up-set-group search-remote c: target-animal-group)
            (up-remove-objects search-remote object-data-class != prey-animal-class)
            (up-remove-objects search-remote object-data-hitpoints != 0)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-dead-chicken-deer-nr g:= gl-remote-total)
            (up-full-reset-search)
            (up-set-group search-remote c: scouted-animal-group)
            (up-remove-objects search-remote object-data-class != prey-animal-class)
            (up-remove-objects search-remote object-data-hitpoints != 0)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-dead-chicken-deer-nr g:+ gl-remote-total)
            (up-full-reset-search)
            (up-set-target-point gl-position-self-x)
            (up-filter-distance c: -1 c: 14)
            (up-filter-status c: status-resource c: list-active)
            (up-find-resource c: food c: 10)
            (set-goal gl-berry-access -1)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            =>
            (up-get-point position-object gl-temp-x)
            (up-set-target-point gl-temp-x)
            (up-filter-distance c: -1 c: 5)
            (up-find-local c: mill c: 1)
            (up-remove-objects search-local object-data-status == status-pending)
        )

        (defrule
            (up-set-target-object search-local c: 0)
            =>
            (set-goal gl-berry-access YES)
        )

        (defrule
            (up-compare-goal gl-berry-access != YES)
            (or(up-compare-goal gl-boar-sheep-vill-nr > 12)
            (and(up-compare-goal gl-boar-sheep-vill-nr > 8)
            (up-compare-goal gl-dead-chicken-deer-nr == 0)))
            =>
            (set-goal gl-overload-food-build YES)
        )

        (defrule
            (up-compare-goal gl-berry-access != YES)
            (up-compare-goal gl-boar-sheep-vill-nr <= 12)
            (or(up-compare-goal gl-boar-sheep-vill-nr <= 8)
            (up-compare-goal gl-dead-chicken-deer-nr > 0))
            =>
            (set-goal gl-overload-food-build -1)
        )

        (defrule
            (true)
            =>
            ;(up-chat-data-to-all "gl-boar-sheep-vill-nr: %d" g: gl-boar-sheep-vill-nr)
            ;(up-chat-data-to-all "gl-dead-chicken-deer-nr: %d" g: gl-dead-chicken-deer-nr)
            ;(up-chat-data-to-all "gl-berry-access: %d" g: gl-berry-access)
            ;(up-chat-data-to-all "gl-overload-food-build: %d" g: gl-overload-food-build)
            (do-nothing)
        )
    ; Set group of villagers that are allowed to be retasked to food under tc
        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-set-target-point gl-position-self-x)
            (up-find-local c: villager-class c: 200)
            (up-remove-objects search-local object-data-group-flag != food-group)
            (up-remove-objects search-local object-data-language-id == lid-villager-builder)
            ;(up-remove-objects search-local object-data-language-id == lid-villager-farmer)
        )


        (defrule
            (true)
            =>
            (up-get-search-state gl-local-total)
        )

        (defrule
            (up-compare-goal gl-local-total < 5)
            =>
            (up-full-reset-search)
            (up-set-target-point gl-position-self-x)
            (up-find-local c: villager-class c: 200)
            (up-remove-objects search-local object-data-group-flag != food-group)
            (up-remove-objects search-local object-data-language-id == lid-villager-builder)
        )

        (defrule
            (true)
            =>
            (up-reset-group c: retask-food-vills-group)
            (up-create-group 0 0 c: retask-food-vills-group)
        )
    ; Boar lure
        
        ; Saving id for new boar in a goal

            (defrule
            (true)
            =>
            (up-full-reset-search)
            (set-strategic-number sn-focus-player-number 0)
            (up-set-target-point gl-position-self-x)
            (up-filter-distance c: -1 c: 35)
            (up-modify-sn sn-focus-player-number c:= 0)
            (up-find-remote c: 910 c: 5)
            (up-remove-objects search-remote object-data-carry == 0)
            (up-modify-goal gl-temp1 g:= gl-first-gaia-id__#052)
            (set-goal gl-temp-x -1)
            )

            (defrule
            (up-set-target-by-id g: gl-temp1)
            (up-object-data object-data-class == 910)
            ;(up-object-data object-data-carry > 0)
            (up-object-data object-data-hitpoints > 0)
            (up-object-data object-data-distance < 35)
            =>
            (set-goal gl-temp-x -1)
            (up-get-point position-object gl-temp-x)
            )

            (defrule
            (up-set-target-by-id g: gl-temp1)
            (up-object-data object-data-class == 910)
            ;(up-object-data object-data-carry > 0)
            (up-object-data object-data-hitpoints > 0)
            (up-object-data object-data-distance < 35)
            (up-point-explored gl-temp-x != explored-no)
            =>
            (up-get-object-data object-data-id gl-temp)
            (up-add-object-by-id search-remote g: gl-temp)
            )

            (defrule
            (up-compare-goal gl-temp1 g:< gl-last-gaia-id__#052)
            =>
            (up-modify-goal gl-temp1 c:+ 1)
            (up-jump-rule -3)
            )

            (defrule
                (up-compare-goal gl-boar-id__#000 == -1)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-id gl-boar-id__#000)
            )

        ; Calculating when to lure next boar
                
            

            (defrule
                (true)
                =>
                (set-goal gl-lure-next-boar__#000 NO)
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 35)
                (up-modify-sn sn-focus-player-number c:= 0)
                (up-find-remote c: predator-animal-class c: 40)
                (up-remove-objects search-remote object-data-carry == 0)
                (up-remove-objects search-remote object-data-hitpoints == 0)
                (up-clean-search search-remote object-data-distance search-order-asc)
            )


            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-point position-object gl-next-boar-x__#000)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 10)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-get-search-state gl-local-total)
                (set-goal gl-percent-next-vill__#000 0)
                (up-full-reset-search)
                (up-find-local c: town-center c: 200)
                (set-goal gl-percent-next-vill__#000 0)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-train-count > 0)
                =>
                (up-get-object-data object-data-progress-value gl-percent-next-vill__#000)
            )


            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 5)
                (up-find-local c: villager-class c: 240)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-remove-objects search-local object-data-language-id == lid-villager-builder)
                (up-remove-objects search-local object-data-index >= 8)
                (up-filter-status c: status-gather c: list-active)
                (up-find-resource c: predator-animal-class c: 40)
                (up-filter-status c: status-down c: list-active)
                (up-find-resource c: predator-animal-class c: 40)
                (up-clean-search search-remote object-data-carry search-order-desc)
                (up-set-target-point gl-next-boar-x__#000)
                (up-get-point-distance gl-next-boar-x__#000 gl-position-self-x gl-boar-tc-distance__#000)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
                (set-goal gl-work-rate__#000 40)
                (set-goal gl-extra-sheep-buffer-time__#000 0)
                (up-get-search-state gl-local-total)
                (set-goal gl-taking-boar NO)
                (set-goal gl-boar-highest-carry -1)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (set-goal gl-taking-boar YES)
                (up-get-object-data object-data-carry gl-boar-highest-carry)
            )

            (defrule
                ;(up-compare-goal gl-remote-total == 0)
                (true)
                =>
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 5)
                (up-filter-status c: status-gather c: list-active)
                (up-find-resource c: livestock-class c: 40)
                (up-filter-status c: status-down c: list-active)
                (up-find-resource c: livestock-class c: 40)
                (up-remove-objects search-remote object-data-id g:== gl-bonus-sheep)
                (up-remove-objects search-remote object-data-id g:== gl-last-bonus-sheep)
                (up-set-target-point gl-next-boar-x__#000)
                (up-clean-search search-remote object-data-carry search-order-desc)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                (up-object-data object-data-id g:== gl-next-sheep)
                =>
                (do-nothing)
                ;(up-remove-objects search-remote object-data-index == 0)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                (up-object-data object-data-class == livestock-class)
                =>
                (set-goal gl-work-rate__#000 33)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-id gl-highest-food-id)
                (up-get-object-data object-data-carry gl-boar-sheep-highest-food__#000)
                (up-modify-goal gl-percent-next-vill__#000 g:* gl-work-rate__#000)
                (up-modify-goal gl-percent-next-vill__#000 c:/ 100)
                (up-modify-goal gl-work-rate__#000 g:* gl-local-total)
                (up-modify-goal gl-work-rate__#000 g:+ gl-percent-next-vill__#000)
                ;(up-chat-data-to-all "gl-work-rate: %d" g: gl-work-rate)
                (up-modify-goal gl-boar-sheep-finishing-time__#000 g:= gl-boar-sheep-highest-food__#000)
                (up-modify-goal gl-boar-sheep-finishing-time__#000 c:* 100)
                (up-modify-goal gl-boar-sheep-finishing-time__#000 g:/ gl-work-rate__#000)
                ;(up-chat-data-to-all "gl-boar-sheep-highest-food: %d" g: gl-boar-sheep-highest-food)
                ;(up-chat-data-to-all "gl-work-rate: %d" g: gl-work-rate)
                ;(up-chat-data-to-all "gl-boar-sheep-finishing-time: %d" g: gl-boar-sheep-finishing-time)
                
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-distance gl-boar-vill-distance__#000)
                (up-modify-goal gl-next-boar-lure-time__#000 g:= gl-boar-vill-distance__#000)
                (up-modify-goal gl-next-boar-lure-time__#000 g:+ gl-boar-tc-distance__#000)
                (up-modify-goal gl-next-boar-lure-time__#000 c:* 100)
                (up-modify-goal gl-next-boar-lure-time__#000 c:/ 80)
                (up-modify-goal gl-next-lure-buffer-time__#000 g:= gl-boar-sheep-finishing-time__#000)
                (up-modify-goal gl-next-lure-buffer-time__#000 g:- gl-next-boar-lure-time__#000)

            )

            (defrule
                (up-set-target-object search-remote c: 0)
                (up-object-data object-data-class == livestock-class)
                (up-set-target-by-id g: gl-next-sheep) ; -30-35 er nok det rigtige tidspunkt
                =>
                (up-get-object-data object-data-carry gl-next-sheep-finishing-time__#000)
                (up-modify-goal gl-next-sheep-finishing-time__#000 c:* 100)
                (up-modify-goal gl-next-sheep-finishing-time__#000 g:/ gl-work-rate__#000)
                ;(up-modify-goal gl-next-sheep-finishing-time c:* 80)
                ;(up-modify-goal gl-next-sheep-finishing-time c:/ 100)
                ;(up-modify-goal gl-next-sheep-finishing-time c:- 20)
                (up-modify-goal gl-extra-sheep-buffer-time__#000 g:= gl-boar-sheep-finishing-time__#000)
                (up-modify-goal gl-extra-sheep-buffer-time__#000 g:+ gl-next-sheep-finishing-time__#000) ;-45 til -55
                (up-modify-goal gl-extra-sheep-buffer-time__#000 g:- gl-next-boar-lure-time__#000) ;-45 til -55
            )

            (defrule
                (up-compare-goal gl-overload-food-build == YES)
                =>
                (up-remove-objects search-remote object-data-class != livestock-class)
                (set-goal gl-sheep-work-rate__#000 33)
            )

            (defrule
                (up-compare-goal gl-overload-food-build == YES)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-carry gl-sheep-highest-food__#000)
                (up-modify-goal gl-sheep-work-rate__#000 g:* gl-local-total)
                (up-modify-goal gl-sheep-work-rate__#000 g:+ gl-percent-next-vill__#000)
                ;(up-chat-data-to-all "gl-work-rate: %d" g: gl-work-rate)
                (up-modify-goal gl-sheep-finishing-time__#000 g:= gl-sheep-highest-food__#000)
                (up-modify-goal gl-sheep-finishing-time__#000 c:* 100)
                (up-modify-goal gl-sheep-finishing-time__#000 g:/ gl-sheep-work-rate__#000)
                ;(up-chat-data-to-all "gl-boar-sheep-highest-food: %d" g: gl-boar-sheep-highest-food)
                ;(up-chat-data-to-all "gl-work-rate: %d" g: gl-work-rate)
                ;(up-chat-data-to-all "gl-boar-sheep-finishing-time: %d" g: gl-boar-sheep-finishing-time)
            )

            (defrule
                (true)
                =>
                ;(up-chat-data-to-all "gl-boar-sheep-finishing-time: %d" g: gl-boar-sheep-finishing-time)
                ;(up-chat-data-to-all "gl-next-boar-lure-time: %d" g: gl-next-boar-lure-time)
                ;(up-chat-data-to-all "gl-next-lure-buffer-time__#000: %d" g: gl-next-lure-buffer-time__#000)
                ;(up-chat-data-to-all "næste: %d" g: gl-extra-sheep-buffer-time__#000)
                (do-nothing)
                (set-goal gl-boar-timing-optimal__#000 NO)
            )

            (defrule
                (up-set-target-by-id g: gl-highest-food-id)
                (or(and(up-compare-goal gl-next-lure-buffer-time__#000 >= 2)
                (up-compare-goal gl-next-lure-buffer-time__#000 <= 11))
                (or(and(up-object-data object-data-class == predator-animal-class)
                (and(up-compare-goal gl-next-lure-buffer-time__#000 >= 2)
                (up-compare-goal gl-next-lure-buffer-time__#000 <= 14)))
                (and(up-object-data object-data-class == livestock-class)
                (and(up-compare-goal gl-extra-sheep-buffer-time__#000 <= 7)
                (up-compare-goal gl-extra-sheep-buffer-time__#000 >= 1)))))
                =>
                (set-goal gl-boar-timing-optimal__#000 YES)
            )

            (defrule
                (goal gl-taking-boar YES)

                (up-set-target-by-id g: gl-highest-food-id)
                (up-object-data object-data-class == predator-animal-class)
                (up-compare-goal gl-next-lure-buffer-time__#000 <= 14)
                =>
                (set-goal gl-boar-timing-optimal__#000 YES)
            )

            (defrule
                (up-compare-goal gl-time-between-ticks-avg-for-group__#051 > 750)
                (or(and(up-compare-goal gl-next-lure-buffer-time__#000 >= 2)
                (up-compare-goal gl-next-lure-buffer-time__#000 <= 12))
                (or(and(up-object-data object-data-class == predator-animal-class)
                (and(up-compare-goal gl-next-lure-buffer-time__#000 >= 2)
                (up-compare-goal gl-next-lure-buffer-time__#000 <= 15)))
                (and(up-object-data object-data-class == livestock-class)
                (and(up-compare-goal gl-extra-sheep-buffer-time__#000 <= 8)
                (up-compare-goal gl-extra-sheep-buffer-time__#000 >= 0)))))
                =>
                (set-goal gl-boar-timing-optimal__#000 YES)
            )

            (defrule
                (goal gl-boar-timing-optimal__#000 YES)
                (up-set-target-object search-local c: 0)
                (up-set-target-object search-remote c: 0)
                
                (up-compare-goal gl-boar-id__#000 != -1)
                ; Bør nok også aktiveres alene hvis reserve sheep count er 0
                =>
                (set-goal gl-lure-next-boar__#000 YES)

            )

        ; Saving id for new boar luring villager in a goal
            
            (defrule
                (up-compare-goal gl-luring-vill-id__#000 == -1)
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-object-data object-data-hitpoints > 0)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 35)
                (up-set-group search-local c: retask-food-vills-group)
                ;(up-remove-objects search-local object-data-carry > 0)
                (up-remove-objects search-local object-data-target == 915) ;tree
                (up-remove-objects search-local object-data-hitpoints < 25)
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-clean-search search-local object-data-distance search-order-asc)
            )

            (defrule
                (unit-type-count villager >= 5)
                (goal gl-lure-next-boar__#000 YES)
                (up-compare-goal gl-luring-vill-id__#000 == -1)
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-object-data object-data-hitpoints > 0)
                (up-set-target-object search-local c: 0)
                =>
                ;(up-chat-data-to-all "gl-next-lure-buffer-time: %d" g: gl-next-lure-buffer-time)
                ;(up-chat-data-to-all "næste: %d" g: gl-extra-sheep-buffer-time)
                (up-get-object-data object-data-id gl-luring-vill-id__#000)
            )

        ; Lure the boar

            (defrule
                (up-set-target-by-id g: gl-boar-id__#000)
                =>
                (up-full-reset-search)
                (up-get-object-target-data object-data-id gl-boar-target-id__#000)
            )

            (defrule
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-object-data object-data-hitpoints > 0)
                (up-set-target-by-id g: gl-luring-vill-id__#000)
                (up-object-data object-data-target-id g:!= gl-boar-id__#000)
                (up-compare-goal gl-boar-target-id__#000 g:!= gl-luring-vill-id__#000)
                =>
                (up-add-object-by-id search-local g: gl-luring-vill-id__#000)
                (up-add-object-by-id search-remote g: gl-boar-id__#000)
                (up-target-objects 0 action-default -1 -1)
                (set-goal gl-boar-on-the-way__#000 YES)
                ;(chat-to-all "send vill to boar")
            )

        ; Detecting tricky boar lure
            


            (defrule
                (true)
                =>
                (set-goal gl-tricky-boar-lure__#000 NO)
            )
            (defrule
                (up-set-target-by-id g: gl-boar-id__#000)
                =>
                (up-get-point position-object gl-temp-x)
                (up-get-point-distance gl-temp-x gl-position-self-x gl-boar-distance__#000)
            )

            (defrule
                (up-set-target-by-id g: gl-luring-vill-id__#000)
                =>
                (up-get-object-data object-data-hitpoints gl-vill-hp__#000)
                (up-get-point position-object gl-temp-x)
                (up-get-point-distance gl-temp-x gl-position-self-x gl-vill-distance__#000)
            )

            (defrule
                (up-set-target-by-id g: gl-luring-vill-id__#000)
                (or(and(up-compare-goal gl-vill-hp__#000 < 15)
                (up-compare-goal gl-boar-distance__#000 > 5))
                (and(up-compare-goal gl-vill-hp__#000 < 8)
                (up-compare-goal gl-boar-distance__#000 > 2)))
                =>
                (set-goal gl-tricky-boar-lure__#000 YES)
                ;(chat-to-all "tricky boar lure detected")
            )

            (defrule
                (goal gl-tricky-boar-lure__#000 YES)
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-object-data object-data-tasks-count == 0)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-remove-objects search-local object-data-language-id == lid-villager-builder)
                (up-remove-objects search-local object-data-id g:== gl-luring-vill-id__#000)
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
            )

            (defrule
                (goal gl-tricky-boar-lure__#000 YES)
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-object-data object-data-tasks-count == 0)
                (up-set-target-object search-local c: 0)
                =>
                (up-remove-objects search-local object-data-index != 0)
                (up-add-object-by-id search-remote g: gl-boar-id__#000)
                (up-target-objects 0 action-default -1 -1)
                ;(chat-to-all "attack tricky boar with new vill")
            )



            (defrule
                (goal gl-tricky-boar-lure__#000 YES)
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-set-target-by-id g: gl-luring-vill-id__#000)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-remove-objects search-local object-data-language-id == lid-villager-builder)
                (up-remove-objects search-local object-data-hitpoints < 25)
                (up-remove-objects search-local object-data-id g:== gl-luring-vill-id__#000)
                (up-remove-objects search-local object-data-target-id g:!= gl-boar-id__#000)
                (set-goal gl-extra-boar-vill-id__#000 -1)
                (up-get-search-state gl-local-total)
                ;(chat-to-all "looking for reserve vill")
            )

            (defrule
                (goal gl-tricky-boar-lure__#000 YES)
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-set-target-by-id g: gl-luring-vill-id__#000)
                (up-compare-goal gl-local-total == 0)
                =>
                (up-full-reset-search)
                (fe-filter-garrisoned c: 1)
                (up-find-local c: villager-class c: 200)
                (fe-filter-garrisoned c: 0)
                (up-remove-objects search-local object-data-group-flag != food-group)
                (up-remove-objects search-local object-data-language-id == lid-villager-builder)
                (up-remove-objects search-local object-data-hitpoints < 25)
                (up-remove-objects search-local object-data-id g:== gl-luring-vill-id__#000)
                (set-goal gl-extra-boar-vill-id__#000 -1)
                ;(chat-to-all "looking for garrisoned reserve vill")
            )

            (defrule
                (goal gl-tricky-boar-lure__#000 YES)
                (up-set-target-by-id g: gl-luring-vill-id__#000)
                (up-compare-goal gl-local-total == 0)
                (up-set-target-object search-local c: 0)
                (up-set-target-by-id g: gl-boar-id__#000)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-remove-objects search-local object-data-index != 0)
                ;(up-gather-inside c: town-center c: )
                (up-target-point 1 action-ungarrison -1 -1)
                ;(chat-to-all "ungarrison vill to aid tricky lure")
            )

            (defrule
                (goal gl-tricky-boar-lure__#000 YES)
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-set-target-by-id g: gl-luring-vill-id__#000)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-id gl-extra-boar-vill-id__#000)
            )

            (defrule
                (goal gl-tricky-boar-lure__#000 YES)
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-object-target-data object-data-id g:== gl-extra-boar-vill-id__#000)
                (up-set-target-by-id g: gl-luring-vill-id__#000)
                (up-set-target-object search-local c: 0)
                =>
                (up-modify-goal gl-luring-vill-id__#000 g:= gl-extra-boar-vill-id__#000)
                (up-modify-goal gl-extra-boar-vill-id__#000 c:= -1)
                (chat-to-all "change luring vill to extra vill")
            )





        ; Run back vill

            (defrule
                (up-set-target-by-id g: gl-boar-id__#000)
                =>
                (up-copy-point gl-left-spot-x__#000 gl-position-self-x)
                (up-modify-goal gl-left-spot-x__#000 c:- 1)
                (up-modify-goal gl-left-spot-y__#000 c:- 1)
                (up-set-target-point gl-left-spot-x__#000)
                (up-get-object-data object-data-precise-distance gl-left-spot-precise-distance__#000)
                (up-copy-point gl-right-spot-x__#000 gl-position-self-x)
                (up-modify-goal gl-right-spot-x__#000 c:+ 1)
                (up-modify-goal gl-right-spot-y__#000 c:+ 1)
                (up-set-target-point gl-right-spot-x__#000)
                (up-get-object-data object-data-precise-distance gl-right-spot-precise-distance__#000)
                (up-copy-point gl-luring-spot-x__#000 gl-left-spot-x__#000)
            )

            (defrule
                (up-compare-goal gl-right-spot-precise-distance__#000 g:< gl-left-spot-precise-distance__#000)
                =>
                (up-copy-point gl-luring-spot-x__#000 gl-right-spot-x__#000)
            )

            (defrule
                (up-set-target-by-id g: gl-boar-id__#000)
                =>
                (up-get-point position-object gl-boar-x__#000)
            )

            (defrule
                (up-compare-goal gl-right-spot-precise-distance__#000 g:< gl-left-spot-precise-distance__#000)
                (up-point-distance gl-boar-x__#000 gl-position-self-x <= 5)
                (up-compare-goal gl-time-between-ticks-avg-for-group__#051 > 750)
                =>
                (up-copy-point gl-luring-spot-x__#000 gl-left-spot-x__#000)
            )

            (defrule
                (up-compare-goal gl-right-spot-precise-distance__#000 g:>= gl-left-spot-precise-distance__#000)
                (up-point-distance gl-boar-x__#000 gl-position-self-x <= 5)
                (up-compare-goal gl-time-between-ticks-avg-for-group__#051 > 750)
                =>
                (up-copy-point gl-luring-spot-x__#000 gl-right-spot-x__#000)
            )

            (defrule
                (up-set-target-by-id g: gl-boar-id__#000)
                =>
                (up-get-object-data object-data-precise-x gl-boar-precise-x__#000)
                (up-get-object-data object-data-precise-y gl-boar-precise-y__#000)
                (up-modify-goal gl-precise-luring-spot-x__#000 g:= gl-luring-spot-x__#000)
                (up-modify-goal gl-precise-luring-spot-y__#000 g:= gl-luring-spot-y__#000)
                (up-modify-goal gl-precise-luring-spot-x__#000 c:* 100)
                (up-modify-goal gl-precise-luring-spot-y__#000 c:* 100)
                (up-lerp-tiles gl-precise-luring-spot-x__#000 gl-boar-precise-x__#000 c: -90)

            )

            (defrule
                (up-set-target-by-id g: gl-luring-vill-id__#000)
                =>
                (up-get-object-data object-data-move-x gl-vill-move-x__#000)
                (up-get-object-data object-data-move-y gl-vill-move-y__#000)
            )

            (defrule
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-object-data object-data-hitpoints > 0)
                (up-set-target-by-id g: gl-luring-vill-id__#000)
                (up-compare-goal gl-boar-target-id__#000 g:== gl-luring-vill-id__#000)
                (up-point-distance gl-vill-move-x__#000 gl-luring-spot-x__#000 > 0)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-luring-vill-id__#000)
                (set-strategic-number sn-target-point-adjustment 6)
                (up-target-point gl-precise-luring-spot-x__#000 action-default -1 -1)
                (set-strategic-number sn-target-point-adjustment 1)
                ;(chat-to-all "move boar vill to spot")
            )

        ; Kill the boar

            (defrule
                (true)
                =>
                (up-modify-goal gl-precise-luring-spot-x__#000 g:= gl-luring-spot-x__#000)
                (up-modify-goal gl-precise-luring-spot-y__#000 g:= gl-luring-spot-y__#000)
                (up-modify-goal gl-precise-luring-spot-x__#000 c:* 100)
                (up-modify-goal gl-precise-luring-spot-y__#000 c:* 100)
            )
            (defrule
            (or(up-point-distance gl-boar-precise-x__#000 gl-precise-luring-spot-x__#000 < 200)
            (and(up-point-distance gl-boar-precise-x__#000 gl-precise-luring-spot-x__#000 < 550)
            (up-compare-goal gl-time-between-ticks-avg-for-group__#051 > 750)))
            (up-set-target-by-id g: gl-boar-id__#000)
            =>
            (up-full-reset-search)
            (up-set-group search-local c: retask-food-vills-group)
            (up-remove-objects search-local object-data-id g:== gl-luring-vill-id__#000)
            (up-remove-objects search-local object-data-index >= 5)
            (up-modify-sn sn-focus-player-number c:= my-player-number)
            (up-find-remote c: town-center c: 1)
            )

            (defrule
            (or(up-point-distance gl-boar-precise-x__#000 gl-precise-luring-spot-x__#000 < 300)
            (and(up-point-distance gl-boar-precise-x__#000 gl-precise-luring-spot-x__#000 < 550)
            (up-compare-goal gl-time-between-ticks-avg-for-group__#051 > 750)))
            (up-set-target-by-id g: gl-boar-id__#000)
            (up-object-data object-data-hitpoints > 18)
            (up-set-target-object search-local c: 0)
            (up-set-target-object search-remote c: 0)
            (up-object-data object-data-garrison-count < 5)
            =>
            (up-full-reset-search)
            (up-set-group search-local c: retask-food-vills-group)
            (up-remove-objects search-local object-data-id g:== gl-luring-vill-id__#000)
            (up-set-target-point gl-position-self-x)
            (up-remove-objects search-local object-data-distance >= 5)
            (up-remove-objects search-local object-data-id g:== gl-extra-boar-vill-id__#000)
            (up-remove-objects search-local object-data-index >= 5)
            (up-add-object-by-id search-remote g: gl-boar-id__#000)
            (up-target-objects 0 action-default -1 -1)
            (up-reset-search 0 0 1 1)
            (up-modify-sn sn-focus-player-number c:= my-player-number)
            (up-find-remote c: town-center c: 1)
            (up-gather-inside c: town-center c: -1)
            (up-target-objects 0 action-garrison -1 -1)
            ;(chat-to-all "garrison vills")
            )

            (defrule
            (or(up-point-distance gl-boar-precise-x__#000 gl-precise-luring-spot-x__#000 < 250)
            (and(up-point-distance gl-boar-precise-x__#000 gl-precise-luring-spot-x__#000 < 550)
            (up-compare-goal gl-time-between-ticks-avg-for-group__#051 > 750)))
            (up-set-target-by-id g: gl-boar-id__#000)
            =>
            (up-full-reset-search)
            (up-find-local c: town-center c: 1)
            )

            (defrule
            (or(up-point-distance gl-boar-precise-x__#000 gl-precise-luring-spot-x__#000 < 250)
            (and(up-point-distance gl-boar-precise-x__#000 gl-precise-luring-spot-x__#000 < 550)
            (up-compare-goal gl-time-between-ticks-avg-for-group__#051 > 750)))
            (up-set-target-by-id g: gl-boar-id__#000)
            (up-object-data object-data-hitpoints > 18)
            (up-set-target-object search-local c: 0)
            (up-object-data object-data-garrison-count > 0)
            (up-object-data object-data-target-id g:!= gl-boar-id__#000)
            =>
            (up-add-object-by-id search-remote g: gl-boar-id__#000)
            (up-target-objects 0 action-default -1 -1)
            (up-target-objects 0 action-gather -1 -1)
            ;(chat-to-all "shoot boar with tc")
            )

            (defrule
            (up-point-distance gl-boar-precise-x__#000 gl-precise-luring-spot-x__#000 < 70)
            (up-set-target-by-id g: gl-boar-id__#000)
            (up-object-target-data object-data-id g:== gl-luring-vill-id__#000)
            =>
            (up-full-reset-search)
            (up-add-object-by-id search-local g: gl-luring-vill-id__#000)
            (up-add-object-by-id search-remote g: gl-boar-id__#000)
            (up-target-objects 0 action-default -1 -1)
            (up-reset-search 0 0 1 1)
            (up-modify-sn sn-focus-player-number c:= my-player-number)
            (up-find-remote c: town-center c: 1)
            (up-target-objects 0 action-garrison -1 -1)
            (up-gather-inside c: town-center c: -1)
            ;(chat-to-all "garrison luring vill")
            )

            (defrule
            (up-set-target-by-id g: gl-boar-id__#000)
            (up-object-data object-data-hitpoints <= 18)
            =>
            (up-full-reset-search)
            (up-find-local c: town-center c: 200)
            )

            (defrule
            (up-set-target-object search-local c: 0)
            (up-object-data object-data-garrison-count > 0)
            (up-set-target-by-id g: gl-boar-id__#000)
            (up-object-data object-data-hitpoints <= 18)
            =>
            (up-full-reset-search)
            (up-find-local c: town-center c: 200)
            (up-add-object-by-id search-remote g: gl-boar-id__#000)
            ;(up-gather-inside c: town-center c: 1)
            ;(up-target-objects 0 action-gather -1 -1)
            (up-target-point 0 action-work -1 -1)
            ;(up-gather-inside c: town-center c: 0)
            ;(chat-to-all "ungarrison tc")
            )

            


        ; Save vill from dying
            (defrule
                (up-set-target-by-id g: gl-luring-vill-id__#000)
                (up-object-data object-data-hitpoints <= 7)
                (up-object-data object-data-tasks-count > 0)
                =>
                (up-full-reset-search)
                (up-modify-sn sn-focus-player-number c:= my-player-number)
                (up-find-remote c: town-center c: 1)
                (up-add-object-by-id search-local g: gl-luring-vill-id__#000)
                (up-target-objects 0 action-garrison -1 -1)
                ;(chat-to-all "saving hurt vill")
            )
        ; Reset boar luring id goals for the next boar

            (defrule
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-object-data object-data-hitpoints == 0)
                (up-object-data object-data-carry < 290)
                =>
                (set-goal gl-luring-vill-id__#000 -1)
                (set-goal gl-boar-id__#000 -1)
            )

            (defrule
                (up-set-target-by-id g: gl-boar-id__#000)
                (up-object-data object-data-hitpoints == 0)
                (up-object-data object-data-carry < 300)
                =>
                (set-goal gl-boar-on-the-way__#000 NO)
            )


    ; Sheep controll
        ; Remove any sheep ID's of sheep you dont controll

            (defrule
                (up-set-target-by-id g: gl-current-sheep)
                (up-object-data object-data-player > 0)
                (up-object-data object-data-player != my-player-number)
                (up-object-data object-data-hitpoints > 0)
                =>
                (set-goal gl-current-sheep -1)
            )

            (defrule
                (up-set-target-by-id g: gl-next-sheep)
                (up-object-data object-data-player != my-player-number)
                (up-object-data object-data-hitpoints > 0)
                =>
                (set-goal gl-next-sheep -1)
            )

            (defrule
                (up-set-target-by-id g: gl-secondary-scout-unit-1)
                (up-object-data object-data-player != my-player-number)
                (up-object-data object-data-hitpoints > 0)
                =>
                (set-goal gl-secondary-scout-unit-1 -1)
            )

            (defrule
                (up-set-target-by-id g: gl-secondary-scout-unit-2)
                (up-object-data object-data-player != my-player-number)
                (up-object-data object-data-hitpoints > 0 )
                =>
                (set-goal gl-secondary-scout-unit-2 -1)
            )

            (defrule
                (up-set-target-by-id g: gl-bonus-sheep)
                (up-object-data object-data-player != my-player-number)
                (up-object-data object-data-hitpoints > 0 )
                =>
                (set-goal gl-bonus-sheep -1)
            )


        ; Make sure current sheep != next sheep
            (defrule
                (up-set-target-by-id g: gl-current-sheep)
                (up-set-target-by-id g: gl-next-sheep)
                (up-compare-goal gl-current-sheep g:== gl-next-sheep)
                =>
                (set-goal gl-next-sheep -1)
            )
        ; Make sure next sheep is alive
            (defrule
                (up-set-target-by-id g: gl-next-sheep)
                (up-object-data object-data-hitpoints <= 0)
                =>
                (set-goal gl-next-sheep -1)
            )
        ; Asign current, next and 2 scouting id's
        
            (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-set-target-point gl-position-self-x)
            (up-find-local c: livestock-class c: 240)
            (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-1)
            (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-2)
            (up-remove-objects search-local object-data-id g:== gl-current-sheep)
            (up-remove-objects search-local object-data-id g:== gl-next-sheep)
            (up-remove-objects search-local object-data-id g:== gl-bonus-sheep)
            (up-clean-search search-local object-data-precise-distance search-order-asc)
            (up-get-search-state gl-local-total)
            ;(up-chat-data-to-all "gl-current-sheep: %d" g: gl-current-sheep)
            ;(up-chat-data-to-all "gl-next-sheep: %d" g: gl-next-sheep)
            ;(up-chat-data-to-all "gl-secondary-scout-unit-1: %d" g: gl-secondary-scout-unit-1)
            ;(up-chat-data-to-all "gl-secondary-scout-unit-2: %d" g: gl-secondary-scout-unit-2)
            )

            (defrule 
                (goal gl-current-sheep -1)
                (up-set-target-object search-local c: 0)
                (or(up-object-data object-data-distance < 5)
                (and(up-object-data object-data-distance < 10)
                (game-time < 60)))
            =>
                (up-get-object-data object-data-id gl-current-sheep)
                (up-remove-objects search-local object-data-id g:== gl-current-sheep)
            )

            (defrule
                (up-compare-goal gl-current-sheep != -1)
                (goal gl-next-sheep -1)
                (up-set-target-object search-local c: 0)
            =>
                (up-get-object-data object-data-id gl-next-sheep)
                (up-remove-objects search-local object-data-id g:== gl-next-sheep)
            )

            (defrule
                (true)
                =>
                (up-clean-search search-local object-data-distance search-order-desc)
            )

            (defrule
            (or(game-time > 480)
            (and(game-time > 240)
            (up-compare-goal gl-overload-food-build == YES)))
                =>
                (set-goal gl-stop-sheep-scouting YES)
                (disable-self)
            )

            (defrule
            (up-compare-goal gl-stop-sheep-scouting != YES)
            (up-compare-goal gl-current-sheep != -1)
            (up-compare-goal gl-next-sheep != -1)
            (goal gl-secondary-scout-unit-1 -1)
            (up-set-target-object search-local c: 0)
            =>
            (up-get-object-data object-data-id gl-secondary-scout-unit-1)
            (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-1)
            )
            (defrule
            (up-compare-goal gl-stop-sheep-scouting != YES)
            (up-compare-goal gl-current-sheep != -1)
            (up-compare-goal gl-next-sheep != -1)
            (up-compare-goal gl-secondary-scout-unit-1 != -1)
            (goal gl-secondary-scout-unit-2 -1)
            (up-set-target-object search-local c: 0)
            =>
            (up-get-object-data object-data-id gl-secondary-scout-unit-2)
            (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-2)
            )

        ; Change ID's between sheep that have already been asigned ID's.

            (defrule
                (or(not(up-set-target-by-id g: gl-current-sheep))
                (and(up-set-target-by-id g: gl-current-sheep)
                (up-object-data object-data-carry <= 0)))
                (up-compare-goal gl-current-sheep != -1)
            =>
                (set-goal gl-current-sheep -1)
                ;(chat-to-all "removing current sheep")
            )

            (defrule
                (up-compare-goal gl-current-sheep == -1)
                (up-compare-goal gl-next-sheep != -1)
            =>
                (up-modify-goal gl-current-sheep g:= gl-next-sheep)
                (set-goal gl-next-sheep -1)
                ;(chat-to-all "replacing current sheep with next")
            )

            (defrule
            (up-compare-goal gl-secondary-scout-unit-2 != -1)
            (up-compare-goal gl-secondary-scout-unit-1 != -1)
            (or(and(up-compare-goal gl-local-total == 0)
            (goal gl-next-sheep -1))
            (up-compare-goal gl-stop-sheep-scouting == YES))
            =>
            (set-goal gl-secondary-scout-unit-2 -1)
            (chat-to-all "removing second scouting sheep")
            (up-jump-rule 1)
            )

            (defrule
            (goal gl-secondary-scout-unit-2 -1)
            (up-compare-goal gl-secondary-scout-unit-1 != -1)
            (or(and(up-compare-goal gl-local-total == 0)
            (goal gl-next-sheep -1))
            (up-compare-goal gl-stop-sheep-scouting == YES))
            =>
            (chat-to-all "removing first scouting sheep")
            (set-goal gl-secondary-scout-unit-1 -1)
            )

            (defrule
                (up-compare-goal gl-stop-sheep-scouting == YES)
                (or(up-compare-goal gl-secondary-scout-unit-2 != -1)
                (up-compare-goal gl-secondary-scout-unit-1 != -1))
                =>
            (chat-to-all "removing both scouting sheep")
                (set-goal gl-secondary-scout-unit-2 -1)
                (set-goal gl-secondary-scout-unit-1 -1)
            )


            (defrule
                (true)
                =>
                (up-copy-point gl-sheep-eating-spot-x__#000 gl-position-self-x)
                (up-modify-goal gl-sheep-eating-spot-x__#000 c:- 1)
                (up-modify-goal gl-sheep-eating-spot-y__#000 c:+ 1)
                (up-set-target-point gl-sheep-eating-spot-x__#000)
                (up-full-reset-search)
                (up-find-local c: livestock-class c: 40)
                (up-remove-objects search-local object-data-hitpoints == 0)
                (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-1)
                (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-2)
                (up-remove-objects search-local object-data-id g:== gl-bonus-sheep)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
            )

            (defrule
                (up-set-target-by-id g: gl-current-sheep)
                (up-object-data object-data-hitpoints > 0)
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-id g:!= gl-current-sheep)
                =>
                ; current sheep er i live, men er ikke tættest -> gør tætteste til current.
                (up-get-object-data object-data-id gl-current-sheep)
            )

            (defrule
                (up-set-target-by-id g: gl-current-sheep)
                (up-object-data object-data-hitpoints == 0)
                (up-set-target-by-id g: gl-next-sheep)
                (up-object-data object-data-hitpoints > 0)
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-id g:!= gl-next-sheep)
                =>
                ; current sheep er i live, men er ikke tættest -> gør tætteste til current.
                (up-get-object-data object-data-id gl-next-sheep)
            )

            (defrule
                (up-set-target-by-id g: gl-current-sheep)
                =>
                (up-get-point position-object gl-temp-x)
                (up-modify-goal gl-temp-x g:- gl-position-self-x)
                (up-modify-goal gl-temp-y g:- gl-position-self-y)
                ;(up-chat-data-to-all "current sheep x at: %d" g: gl-temp-x)
                ;(up-chat-data-to-all "current sheep y at: %d" g: gl-temp-y)
            )
        
            (defrule
                (up-set-target-by-id g: gl-next-sheep)
                =>
                (up-get-point position-object gl-temp-x)
                (up-modify-goal gl-temp-x g:- gl-position-self-x)
                (up-modify-goal gl-temp-y g:- gl-position-self-y)
                ;(up-chat-data-to-all "next sheep x at: %d" g: gl-temp-x)
                ;(up-chat-data-to-all "next sheep y at: %d" g: gl-temp-y)
            )

        ; add or remove bonus sheep id
            (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-set-target-point gl-position-self-x)
            (up-find-local c: livestock-class c: 240)
            (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-1)
            (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-2)
            (up-remove-objects search-local object-data-id g:== gl-current-sheep)
            (up-remove-objects search-local object-data-id g:== gl-next-sheep)
            (up-remove-objects search-local object-data-id g:== gl-bonus-sheep)
            (up-clean-search search-local object-data-precise-distance search-order-asc)
            (up-get-search-state gl-local-total)
            )

            (defrule
            (up-compare-goal gl-current-sheep != -1)
            (up-compare-goal gl-next-sheep != -1)
            (up-compare-goal gl-overload-food-build == YES)
            (up-compare-goal gl-boar-highest-carry < 65)
            (up-compare-goal gl-bonus-sheep == -1)
            (up-set-target-object search-local c: 0)
            =>
            (chat-to-all "set bonus sheep id")
            (up-get-object-data object-data-id gl-bonus-sheep)
            (up-remove-objects search-local object-data-id g:== gl-bonus-sheep)
            )


            (defrule
                (or(up-compare-goal gl-overload-food-build != YES)
                (or(up-compare-goal gl-bonus-sheep g:== gl-current-sheep)
                (or(up-compare-goal gl-bonus-sheep g:== gl-next-sheep)
                (or(up-compare-goal gl-bonus-sheep g:== gl-secondary-scout-unit-1)
                (or(up-compare-goal gl-bonus-sheep g:== gl-secondary-scout-unit-2)
                (and(up-set-target-by-id g: gl-bonus-sheep)
                (up-object-data object-data-carry < 65)))))))
                =>
                ;(up-chat-data-to-all "gl-bonus-sheep id: %d" g: gl-bonus-sheep)
                ;(up-chat-data-to-all "gl-current-sheep id: %d" g: gl-current-sheep)
                ;(up-chat-data-to-all "gl-next-sheep id: %d" g: gl-next-sheep)
                ;(up-chat-data-to-all "gl-secondary-scout-unit-1 id: %d" g: gl-secondary-scout-unit-1)
                ;(up-chat-data-to-all "gl-secondary-scout-unit-2 id: %d" g: gl-secondary-scout-unit-2)
                ;(chat-to-all "remove bonus sheep id")
                (up-modify-goal gl-last-bonus-sheep g:= gl-bonus-sheep)
                (set-goal gl-bonus-sheep -1)
            )

            (defrule
                (true)
                =>
                (up-copy-point gl-temp-x gl-position-self-x)
                (up-modify-goal gl-temp-x c:- 1)
                (up-modify-goal gl-temp-y c:+ 1)
                (up-set-target-point gl-temp-x)
                (up-full-reset-search)
                (up-find-local c: livestock-class c: 40)
                (up-remove-objects search-local object-data-hitpoints == 0)
                (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-1)
                (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-2)
                (up-remove-objects search-local object-data-id g:== gl-current-sheep)
                (up-remove-objects search-local object-data-id g:== gl-next-sheep)
                (up-clean-search search-local object-data-precise-distance search-order-asc)
            )

            (defrule
                (up-set-target-by-id g: gl-bonus-sheep)
                (up-object-data object-data-hitpoints > 0)
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-id g:!= gl-bonus-sheep)
                =>
                ; current sheep er i live, men er ikke tættest -> gør tætteste til current.
                (chat-to-all "force bonus sheep to be the closest")
                (up-get-object-data object-data-id gl-bonus-sheep)
            )
        
        ; Move sheep to correct locations

            (defrule
                (true)
                =>
                (set-goal gl-boar-sheep-highest-food__#000 0)
            )

            (defrule
                (up-set-target-by-id g: gl-current-sheep)
                (up-object-data object-data-hitpoints == 0)
                =>
                (up-get-object-data object-data-carry gl-boar-sheep-highest-food__#000)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 8)
                (up-filter-status c: status-gather c: list-active)
                (up-find-resource c: predator-animal-class c: 40)
                (up-clean-search search-remote object-data-carry search-order-desc)
            )

            (defrule
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-carry gl-temp)
                (up-modify-goal gl-boar-sheep-highest-food__#000 g:max gl-temp)
            )

            
            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 5)
                (up-filter-status c: status-down c: list-active)
                (up-find-resource c: livestock-class c: 1)
                (up-filter-status c: status-gather c: list-active)
                (up-find-resource c: livestock-class c: 1)
                (up-get-search-state gl-local-total)
                ;(up-chat-data-to-all "current-sheep id: %d" g: gl-current-sheep)
                ;(up-chat-data-to-all "next-sheep id: %d" g: gl-next-sheep)
            )

            (defrule
                (true)
                =>
                ;(up-chat-data-to-all "gl-boar-sheep-finishing-time: %d" g: gl-boar-sheep-finishing-time)
                (up-full-reset-search)
                (up-copy-point gl-sheep-eating-spot-x__#000 gl-position-self-x)
                (up-modify-goal gl-sheep-eating-spot-x__#000 c:- 1)
                (up-modify-goal gl-sheep-eating-spot-y__#000 c:+ 1)
                (up-set-target-point gl-sheep-eating-spot-x__#000)
            )

            (defrule
                (or(up-compare-goal gl-boar-sheep-finishing-time__#000 < 17)
                (and(up-compare-goal gl-overload-food-build == YES)
                (up-compare-goal gl-sheep-finishing-time__#000 < 17)))
                (up-set-target-by-id g: gl-current-sheep)
                (up-object-data object-data-distance > 1)
                (up-object-data object-data-hitpoints > 0)
            =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-current-sheep)
                (up-target-point gl-sheep-eating-spot-x__#000 action-move -1 -1)
                ;(up-chat-data-to-all "gl-boar-sheep-finishing-time: %d" g: gl-boar-sheep-finishing-time)
                (chat-to-all "moving current sheep to be taken now")
            )

            (defrule
                (up-set-target-by-id g: gl-next-sheep)
                (up-object-data object-data-distance > 1)
                (up-set-target-by-id g: gl-current-sheep)
                (up-object-data object-data-hitpoints == 0)
                (or(and(up-compare-goal gl-boar-sheep-finishing-time__#000 < 17)
                (up-compare-goal gl-boar-sheep-finishing-time__#000 != -1))
                (and(up-compare-goal gl-overload-food-build == YES)
                (and(up-compare-goal gl-sheep-finishing-time__#000 < 17)
                (up-compare-goal gl-sheep-finishing-time__#000 != -1)))) ; er -1 i starten
            =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-next-sheep)
                (up-target-point gl-sheep-eating-spot-x__#000 action-move -1 -1)
                ;(up-chat-data-to-all "gl-boar-sheep-finishing-time: %d" g: gl-boar-sheep-finishing-time)
                (chat-to-all "moving next sheep to be taken soon")
            )

            (defrule
                (up-set-target-by-id g: gl-bonus-sheep)
                (up-object-data object-data-hitpoints > 0)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-bonus-sheep)
                (up-copy-point gl-temp-x gl-position-self-x)
                (up-modify-goal gl-temp-x c:+ 1)
                (up-modify-goal gl-temp-y c:+ 1)
                (up-target-point gl-temp-x action-move -1 -1)
                (chat-to-all "moving bonus sheep to location")
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: livestock-class c: 40)
                (up-remove-objects search-local object-data-id g:== gl-current-sheep)
                (up-remove-objects search-local object-data-id g:== gl-next-sheep)
                (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-1)
                (up-remove-objects search-local object-data-id g:== gl-secondary-scout-unit-2)
                (up-remove-objects search-local object-data-id g:== gl-bonus-sheep)
                (up-copy-point gl-sheep-reserve-x__#000 gl-position-self-x)
                (up-modify-goal gl-sheep-reserve-x__#000 c:- 3)
                (up-modify-goal gl-sheep-reserve-y__#000 c:+ 3)
                (up-set-target-point gl-sheep-reserve-x__#000)
