                        (up-modify-goal gl-percent-explored__#041 c:* 100)
                        (up-modify-goal gl-percent-explored__#041 g:/ gl-checked-tiles__#041)
                    )

                    (defrule
                        (up-compare-flag gl-setup-flags != fl-done-scouting-pocket)
                        (or(up-compare-flag gl-setup-flags == fl-cannot-scout-enemy-pocket-tc)
                        (and(up-compare-goal gl-enemy-pocket-x != -1)
                        (up-compare-goal gl-percent-explored__#041 > 65)))
                        =>
