            (defrule
                (up-set-target-object search-local c: 0)
            =>
                ;(chat-to-all "moving reserve sheep")
                (up-target-point gl-sheep-reserve-x__#000 action-move -1 -1)
            )
        
            (defrule
                (up-set-target-by-id g: gl-next-sheep)
                (up-object-data object-data-distance > 0)
                (up-set-target-by-id g: gl-current-sheep)
                (or(and(up-compare-goal gl-boar-sheep-finishing-time__#000 >= 17)
                (up-compare-goal gl-overload-food-build != YES))
                (or(and(up-object-data object-data-hitpoints > 0)
                (up-compare-goal gl-overload-food-build != YES))
                (or(and(up-compare-goal gl-overload-food-build == YES)
                (up-compare-goal gl-sheep-finishing-time__#000 >= 17))
                (and(up-compare-goal gl-overload-food-build == YES)
                (up-object-data object-data-hitpoints > 0)))))
            =>
