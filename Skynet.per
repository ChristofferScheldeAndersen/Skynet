                (up-modify-goal gl-combined-score__#016 g:- gl-tc-distance-score__#016)
                (up-set-target-point gl-checked-tile-x__#016)
                ;(up-clean-search search-local object-data-distance search-order-asc)
                (set-goal gl-farm-score__#016 0)
            )

            (defrule
