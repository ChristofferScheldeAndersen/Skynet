        )
;
; End of script #051
    ; Lag detection for full script - end
        (defrule
            (true)
        =>
            (up-get-rule-id gl-end-of-script-rule-for-real__#051)
            (up-set-timer c: lag-timer c: 0)
            (up-get-timer c: lag-timer gl-script-end-time__#051)
            (up-get-precise-time gl-script-start-time__#051 gl-script-time__#051)
            ;(up-chat-data-to-all "script time: %d ms" g: gl-script-time)
            ;(up-chat-data-to-all "gl-time-since-last-tick: %d ms" g: gl-time-since-last-tick)

            (up-modify-goal gl-total-tick-counter__#051 c:+ 1)
            (up-modify-goal gl-25-tick-counter__#051 c:+ 1)

            (up-modify-goal gl-script-time-for-tick-group__#051 g:+ gl-script-time__#051)
            (up-modify-goal gl-total-script-time__#051 g:+ gl-script-time__#051)

            (up-modify-goal gl-time-between-ticks-for-tick-group__#051 g:+ gl-time-since-last-tick__#051)
            (up-modify-goal gl-total-time-between-ticks__#051 g:+ gl-time-since-last-tick__#051)
        )

        (defrule
            (up-compare-goal gl-25-tick-counter__#051 >= tick-refresh-rate)
        =>
            (up-modify-goal gl-script-time-avg-for-tick-group__#051 g:= gl-script-time-for-tick-group__#051)
            (up-modify-goal gl-script-time-avg-for-tick-group__#051 c:/ tick-refresh-rate)

            (up-modify-goal gl-time-between-ticks-avg-for-group__#051 g:= gl-time-between-ticks-for-tick-group__#051)
            (up-modify-goal gl-time-between-ticks-avg-for-group__#051 c:/ tick-refresh-rate)
        )

        (defrule
            (game-time > 10)
            (up-compare-goal gl-25-tick-counter__#051 >= tick-refresh-rate)
            (up-compare-goal gl-script-time-avg-for-tick-group__#051 g:< gl-lowest-avg-script-time__#051)
            =>
            (up-modify-goal gl-lowest-avg-script-time__#051 g:= gl-script-time-avg-for-tick-group__#051)
            (up-get-fact game-time 0 gl-lowest-avg-script-time-stamp__#051)
        )

        (defrule
            (game-time > 10)
            (up-compare-goal gl-25-tick-counter__#051 >= tick-refresh-rate)
            (up-compare-goal gl-script-time-avg-for-tick-group__#051 g:> gl-highest-avg-script-time__#051)
            =>
            (up-modify-goal gl-highest-avg-script-time__#051 g:= gl-script-time-avg-for-tick-group__#051)
            (up-get-fact game-time 0 gl-highest-avg-script-time-stamp__#051)
        )

        (defrule
            (game-time > 10)
            (up-compare-goal gl-25-tick-counter__#051 >= tick-refresh-rate)
            (up-compare-goal gl-time-between-ticks-avg-for-group__#051 g:< gl-lowest-avg-tick-interval__#051)
            =>
            (up-modify-goal gl-lowest-avg-tick-interval__#051 g:= gl-time-between-ticks-avg-for-group__#051)
            (up-get-fact game-time 0 gl-lowest-avg-tick-interval-stamp__#051)
        )

        (defrule
            (game-time > 10)
            (up-compare-goal gl-25-tick-counter__#051 >= tick-refresh-rate)
            (up-compare-goal gl-time-between-ticks-avg-for-group__#051 g:> gl-highest-avg-tick-interval__#051)
            =>
            (up-modify-goal gl-highest-avg-tick-interval__#051 g:= gl-time-between-ticks-avg-for-group__#051)
            (up-get-fact game-time 0 gl-highest-avg-tick-interval-stamp__#051)
        )

        (defrule
            (up-compare-goal gl-25-tick-counter__#051 >= tick-refresh-rate)
            =>
            (up-modify-goal gl-final-avg-script-time__#051 g:= gl-total-script-time__#051)
            (up-modify-goal gl-final-avg-script-time__#051 g:/ gl-total-tick-counter__#051)

            (up-modify-goal gl-final-avg-time-between-ticks__#051 g:= gl-total-time-between-ticks__#051)
            (up-modify-goal gl-final-avg-time-between-ticks__#051 g:/ gl-total-tick-counter__#051)

            ; Output
            ;(up-chat-data-to-all "Script time this tick: %d." g: gl-script-time)
            (up-chat-data-to-all "Avg script time for last few ticks: %d ms" g: gl-script-time-avg-for-tick-group__#051)
            ;(up-chat-data-to-all "Time since last tick: %d." g: gl-time-since-last-tick)
            ;(up-chat-data-to-all "Avg time between ticks for last fewticks: %d." g: gl-time-between-ticks-avg-for-group)
            ;(up-chat-data-to-all "Overall avg script time: %d." g: gl-final-avg-script-time)
            ;(up-chat-data-to-all "Overall avg time between ticks: %d." g: gl-final-avg-time-between-ticks)

            ;(up-chat-data-to-all "LTI: %d ms." g: gl-lowest-avg-tick-interval)
            ;(up-chat-data-to-all "at: %d s." g: gl-lowest-avg-tick-interval-stamp)
            ;(up-chat-data-to-all "HTI: %d ms." g: gl-highest-avg-tick-interval)
            ;(up-chat-data-to-all "at: %d s" g: gl-highest-avg-tick-interval-stamp)
            ;(up-chat-data-to-all "LST: %d ms." g: gl-lowest-avg-script-time)
            ;(up-chat-data-to-all "at: %d s." g: gl-lowest-avg-script-time-stamp)
            ;(up-chat-data-to-all "HST: %d ms." g: gl-highest-avg-script-time)
            ;(up-chat-data-to-all "at: %d." g: gl-highest-avg-script-time-stamp)

            (set-goal gl-25-tick-counter__#051 0)
            (set-goal gl-script-time-for-tick-group__#051 0)
            (set-goal gl-time-between-ticks-for-tick-group__#051 0)
        )
    ; Debugging
        ;Acknowlegde debugging taunts
            (defrule
                (true)
                =>
                (acknowledge-taunt my-player-number 102)
            )
        ;Lag testing 
            (defrule
            (true)
            =>

            (up-get-precise-time gl-time-stamp-at-tic-start gl-script-time-in-milli-seconds) ;Find the time in miliseconds from start to end of the script
            )

            (defrule
            (or(up-compare-goal gl-script-time__#051 > 10) ;Over 10 ms can cause noticable lag
            (taunt-detected my-player-number 103))
            =>
            (up-chat-data-to-all "Total script time: %d ms" g: gl-script-time__#051)
            )

            (defrule
            (taunt-detected my-player-number 104)
                =>
            (acknowledge-taunt my-player-number 103)
            (acknowledge-taunt my-player-number 104)
            )

;

