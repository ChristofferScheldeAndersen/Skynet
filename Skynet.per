                        (up-compare-goal gl-enemy-pocket-x != -1)
                        (up-point-explored gl-testing-point-x__#041 != explored-no)
                        =>
                        (up-modify-goal gl-explored-tiles__#041 c:+ 1)
                    )

                    (defrule
                        (up-compare-flag gl-setup-flags != fl-done-scouting-pocket)
