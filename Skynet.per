                (up-modify-goal gl-minimal-builder-distance__#016 c:* 100)
                (up-modify-goal gl-minimal-builder-distance__#016 g:/ gl-builder-distance-modifier__#016)
                ;(up-modify-goal gl-combined-score__#016 g:- gl-minimal-builder-distance__#016)
            )

            (defrule
                (true)
                =>
                (up-copy-point gl-testing-tile-x__#016 gl-checked-tile-x__#016)
                (up-modify-goal gl-testing-tile-x__#016 c:+ 2)
