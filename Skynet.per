        (defrule
            (can-train villager)
            (unit-type-count-total villager < 130)
            (or(unit-type-count-total villager < 17)
            (up-research-status c: feudal-age >= research-pending))
            (current-age == dark-age)
            =>
            (train villager)
        )

        (defrule
            (can-train villager)
            (unit-type-count-total villager < 130)
            (not(and(up-research-status c: castle-age < research-pending)
            (and(food-amount > 500)
            (up-pending-objects c: villager > 0))))
            (current-age == feudal-age)
            =>
            (train villager)
        )

        (defrule
            (can-train villager)
