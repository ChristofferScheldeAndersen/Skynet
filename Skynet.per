                ;Check how much of main base is scouted

                    (defrule
                    (or(up-compare-goal gl-sheep-counter__#052 >= 8)
                    (or(up-compare-goal gl-cow-counter__#052 >= 6)
                    (and(up-compare-goal gl-sheep-counter__#052 >= 4)
                    (up-compare-goal gl-cow-counter__#052 >= 3))))
                    (up-compare-goal gl-boar-counter__#052 >= 2)
                    (or(up-compare-goal gl-deer-counter__#052 >= 1)
                    (up-compare-goal gl-chicken-counter__#052 >= 1))
                    (up-compare-flag gl-setup-flags == fl-found-berries)
                    (resource-found wood)
                    (resource-found stone)
                    (resource-found gold)
                    (up-compare-flag gl-setup-flags != fl-base-fully-scouted)
                    =>
                    (up-modify-flag gl-setup-flags c:+ fl-base-fully-scouted)
                    (disable-self)
                    )

                    (defrule
