                        (up-chat-data-to-all "Future villager cost is %d." g: gl-temp2)
                        (up-chat-data-to-all "Future food from livestock is %d." g: gl-temp3)
                        (up-chat-data-to-all "Future food from deer is %d." g: gl-temp5)
                        (up-chat-data-to-all "Future food from farms and berries is %d." g: gl-temp8)
