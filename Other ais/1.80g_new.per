                    )

                    (defrule
                        (goal gl-my-position flank)
                        (players-stance focus-player ally)
                        (not(up-compare-sn sn-focus-player-number g:== gl-temp33))
                        (not(up-compare-sn sn-focus-player-number g:== gl-temp34))
                        =>
                        (up-full-reset-search)
                        (up-find-remote c: town-center c: 5)
                        (up-clean-search search-remote object-data-id search-order-asc)
                        (up-remove-objects search-remote object-data-index != 0)
                    )

                    (defrule
                    (goal gl-my-position flank)
                        (players-stance focus-player ally)
                        (not(up-compare-sn sn-focus-player-number g:== gl-temp33))
                        (not(up-compare-sn sn-focus-player-number g:== gl-temp34))
                        (up-compare-goal gl-temp36 == -1)
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-get-object-data object-data-id gl-temp36)
                        (up-remove-objects search-remote object-data-index == 0)
                    )

                    (defrule
                    (goal gl-my-position flank)
                        (players-stance focus-player ally)
                        (not(up-compare-sn sn-focus-player-number g:== gl-temp33))
                        (not(up-compare-sn sn-focus-player-number g:== gl-temp34))
                        (up-compare-goal gl-temp37 == -1)
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-get-object-data object-data-id gl-temp37)
                        (up-remove-objects search-remote object-data-index == 0)
                    )

                    (defrule
                    (goal gl-my-position flank)
                        (up-compare-goal gl-temp35 < 8)
                        =>
                        (up-modify-goal gl-temp35 c:+ 1)
                        (up-jump-rule -5)
                    )

                    (defrule
                        (goal gl-my-position flank)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-temp36)
                        (up-add-object-by-id search-remote g: gl-temp37)
                        (up-get-point position-self gl-temp1-x)
                        (up-set-target-point gl-temp1-x)
                        (up-clean-search search-remote object-data-distance search-order-asc)
                    )

                    (defrule
                        (goal gl-my-position flank)
                        (current-age == dark-age)
                        (up-set-target-object search-remote c: 0)
                        =>
                        ;(up-get-point position-object gl-temp1-x)
                        ;(up-send-flare gl-temp1-x)
                        ;(up-chat-data-to-all "gl-closest-ally is %d." g: gl-closest-ally)
                        (up-get-object-data object-data-player gl-closest-ally)
                        ;(up-chat-data-to-all "gl-my-position is %d." g: gl-my-position)
                        ;(up-chat-data-to-all "gl-closest-ally is %d." g: gl-closest-ally)
                        ;(up-reset-search 0 0 1 1)
                        ;(up-find-local c: eagle-warrior-line c: 1)
                        ;(up-target-objects 1 action-move -1 -1)
                    )

                    (defrule
                        (or(taunt-detected my-player-number 7)
                        (taunt-detected any-ally 7))
                        (goal gl-my-position flank)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                        (up-get-player-color focus-player gl-temp1-x)
                        ;(up-chat-data-to-all "player color of closest ally is %d." g: gl-temp1-x)
                    )

                ;Find closest (flank) ally som pocket
                

                    ;find alle team tc's der ikke er eget af pocket player numbers. 
                    
                    (defrule
                        (goal gl-my-position pocket)
                        =>
                        (set-goal gl-temp35 1)
                        (set-goal gl-temp36 -1)
                        (set-goal gl-temp37 -1)
                    )

                    (defrule
                        (goal gl-my-position pocket)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-temp35)
                    )

                    (defrule
                        (goal gl-my-position pocket)
                        (players-stance focus-player ally)
                        (or(up-compare-sn sn-focus-player-number g:== gl-temp33)
                        (up-compare-sn sn-focus-player-number g:== gl-temp34))
