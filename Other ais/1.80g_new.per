                =>
                (set-strategic-number sn-percent-civilian-explorers 0)
                (set-strategic-number sn-minimum-civilian-explorers 0)
                (set-strategic-number sn-cap-civilian-explorers 0)
                (set-strategic-number sn-total-number-explorers 1)
                (set-strategic-number sn-number-explore-groups 1)
                (set-strategic-number sn-enable-boar-hunting 0)
                (set-strategic-number sn-boar-lure-destination 0)
                (disable-self)
                )

                (defrule
                (true)
                =>
                (set-strategic-number sn-maximum-town-size 12)
                (set-strategic-number sn-minimum-town-size 4)
                (set-strategic-number sn-placement-zone-size 0)
                (set-strategic-number sn-allow-adjacent-dropsites 0)
                (set-strategic-number sn-cap-civilian-gatherers 0);
                (set-strategic-number sn-disable-villager-garrison 3);
                (set-strategic-number sn-mining-camp-max-distance 23);
                (set-strategic-number sn-disable-builder-assistance 1);
                (set-strategic-number sn-allow-civilian-defense 1);
                (set-strategic-number sn-percent-building-cancellation 0)
                (disable-self)
                )

                (defrule
                    (current-age == feudal-age)
                    (up-pending-objects c: watch-tower-line > 0)
                    =>
                    (set-strategic-number sn-percent-building-cancellation 3)
                    (disable-self)
                )

                (defrule
                    (current-age == feudal-age)
                    (building-type-count watch-tower-line > 0)
                    =>
                    (set-strategic-number sn-percent-building-cancellation 95)
                    (disable-self)
                )
                
            (defrule
            (true)
            =>
            (set-strategic-number sn-maximum-food-drop-distance -2)
            (set-strategic-number sn-maximum-wood-drop-distance -2)
            (set-strategic-number sn-maximum-gold-drop-distance -2)
            (set-strategic-number sn-maximum-stone-drop-distance -2)
            (set-strategic-number sn-maximum-hunt-drop-distance -2)
            (disable-self)
            )

            (defrule
            (true)
            =>
            (set-strategic-number sn-food-gatherer-percentage 0)
            (set-strategic-number sn-stone-gatherer-percentage 0)
            (set-strategic-number sn-gold-gatherer-percentage 0)
            (set-strategic-number sn-wood-gatherer-percentage 0)
            (set-strategic-number sn-cap-civilian-explorers 0)
            (set-strategic-number sn-percent-civilian-explorers 0)
            (set-strategic-number sn-percent-civilian-gatherers 0)
            (set-strategic-number sn-percent-civilian-builders 0)
            (set-strategic-number sn-cap-civilian-builders 0)
            (set-strategic-number sn-minimum-boar-hunt-group-size 0)
            (disable-self)
            )

                ; kun 1 vill i Que når du nærmer dig 800 food
            (defrule
                (current-age == feudal-age)
                (food-amount > 600)
                =>
                ;(set-strategic-number sn-enable-training-queue 0) ;midlertidigt slukket
                (do-nothing)
            )     

                (defrule
                (current-age == dark-age)
                =>
                (set-strategic-number sn-food-gatherer-percentage 0)
                (set-strategic-number sn-wood-gatherer-percentage 0)
                (set-strategic-number sn-gold-gatherer-percentage 0)
                (set-strategic-number sn-stone-gatherer-percentage 0)
                ; (set-strategic-number sn-retask-gather-amount 99999)
                (disable-self)
                )

                (defrule
                (true)
                =>
                (set-strategic-number sn-home-exploration-time 600)
                (enable-timer sheep-debug-timer 5)
                (set-goal gl-sheep-taken 0)
                (disable-self)
                )

                (defrule
                    (true)
                    =>
                    (set-strategic-number sn-enable-new-building-system 1)
                    ;(set-strategic-number sn-percent-civilian-builders 0)
                    (up-assign-builders c: house c: 0)
                    (set-strategic-number sn-enable-training-queue 1)
                    (disable-self)
                    )
                (defrule
                    (true)
                    =>
                    (set-goal gl-building-system build-line-system)
                    (set-goal gl-reset-builders NO)
                    (set-goal gl-need-mill NO)
                    (set-goal gl-need-house NO)
                    (disable-self)
                )
        ;
            (defrule
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 362 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration 1: %d" g: 181)
                )
        ; Selecting fase (safe)*
            ; Starting fase 1
                (defrule
                    (true)
                    =>
                    (set-goal gl-fase 1)
                    ;(chat-to-all "starting fase 1")
                    (disable-self)
                )
            
            ; Starting fase 2 when Rehoboam has enough food to click up at 22 pop:

                    (defrule
                        (true)
                        =>
                        (up-get-fact resource-amount amount-food gl-future-food)
                        (set-goal gl-loop-counter 0)
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-resource == wood)
                        (up-remove-objects search-local object-data-resource == stone)
                        (up-remove-objects search-local object-data-resource == gold)
                        (up-remove-objects search-local object-data-carry <= 0)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-data object-data-carry gl-villager-food)
                        (up-modify-goal gl-future-food g:+ gl-villager-food)
                        (up-remove-objects search-local object-data-index == 0)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-compare-goal gl-local-total > 0)
                        (up-compare-goal gl-loop-counter < 50)
                        =>
                        (up-modify-goal gl-loop-counter c:+ 1)
                        (up-jump-rule -2)
                    )

                    (defrule
                        (true)
                        =>
                        (up-modify-goal gl-21-villager-progress c:= 21)
                        (up-get-fact civilian-population 0 gl-temp)
                        (up-modify-goal gl-21-villager-progress g:- gl-temp)
                        (up-full-reset-search)
                        (up-find-local c: town-center c: 1)
                    )

                    (defrule
                        (up-set-target-object search-local c: 0)
                    =>
                        (up-get-object-data object-data-train-count gl-temp)
                        (up-modify-goal gl-21-villager-progress g:- gl-temp)
                        (up-modify-goal gl-21-villager-progress c:* 50)
                        (up-modify-goal gl-future-food g:- gl-21-villager-progress)
                    )
                    
                    (defrule
                        (or(taunt-detected any-ally 3)
                        (taunt-detected my-player-number 3))
                        =>
                        (up-chat-data-to-all "Future food is %d." g: gl-future-food)
                        (up-chat-data-to-all "TC has %d units queued." g: gl-temp)
                        (up-chat-data-to-all "gl-21-villager-progress is %d." g: gl-21-villager-progress)
                        (acknowledge-taunt any-ally 3)
                        (acknowledge-taunt my-player-number 3)
                    )

                    (defrule
                        (up-compare-goal gl-future-food >= 500)
                        (up-compare-goal gl-fase != 3)
                        =>
                        ;(chat-to-all "Enough food to click up. Entering fase 2")
                        (set-goal gl-fase 2)
                        (disable-self)
                    )

            
                
            ; Starting fase 4 when reaching castle age in 3v3 and 4v4
                #load-if-not-defined DIFFICULTY-EASIEST
                #load-if-not-defined DIFFICULTY-EASY
                #load-if-not-defined DIFFICULTY-STANDARD
                #load-if-not-defined DIFFICULTY-MODERATE
                #load-if-not-defined DIFFICULTY-HARD
                (defrule
                    (current-age >= castle-age)
                    (up-compare-goal gl-fase != 4)
                    (up-compare-goal gl-my-position != solo)
                    =>
                    (set-goal gl-fase 4)
                    ;(chat-to-all "Rehoboam is castle age. Entering fase 4")
                )
                #end-if
                #end-if
                #end-if
                #end-if
                #end-if

                #load-if-not-defined DIFFICULTY-EASIEST
                #load-if-not-defined DIFFICULTY-EASY
                #load-if-not-defined DIFFICULTY-STANDARD
                #load-if-not-defined DIFFICULTY-MODERATE
