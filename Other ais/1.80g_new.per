                ;train knights
                    ;setup
                        (defrule
                            (true)
                            =>
                            (up-full-reset-search)
                            (up-find-local c: town-center c: 3)
                            (up-clean-search search-local object-data-id search-order-asc)
                            (up-remove-objects search-local object-data-index <= 1)
                            (set-goal gl-temp1 0)
                        )

                        (defrule
                            (up-research-status c: imperial-age == research-pending)
                            ;(up-timer-status tech-checking-timer == timer-disabled)
                            =>
                            (enable-timer tech-checking-timer 120)
                            (disable-self)
                        )

                        (defrule
                            (current-age == imperial-age)
                            =>
                            (disable-timer tech-checking-timer)
                            (disable-self)
                        )

                        (defrule
                            (up-research-status c: ri-cavalier == research-pending)
                            (up-timer-status tech-checking-timer == timer-disabled)
                            =>
                            (enable-timer tech-checking-timer 0)
                            (disable-self)
                        )

                        (defrule
                            (research-completed ri-cavalier)
                            =>
                            (disable-timer tech-checking-timer)
                            (disable-self)
                        )

                        (defrule
                            (true)
                            =>
                            (set-goal gl-temp1 1)
                        )

                        (defrule
                        (up-research-status c: imperial-age == research-pending)
                        (timer-triggered tech-checking-timer)
                        (or(food-amount < 745)
                        (gold-amount < 605))
                            =>
                            (set-goal gl-temp1 0)
                            ;(chat-to-all "rule 1")
                        )

                        (defrule
                        (up-research-status c: ri-cavalier == research-pending)
                        (timer-triggered tech-checking-timer)
                        (or(food-amount < 1300)
                        (gold-amount < 750))
                        (goal gl-early-imp-strat early-paladin)
                            =>
                            (set-goal gl-temp1 0)
                            ;(chat-to-all "rule 2")
                        )

                        
                        (defrule
                            (true)
                            =>
                            (up-get-fact building-type-count stable gl-temp5)
                            (up-modify-goal gl-temp5 c:- 1)
                        )

                        (defrule
                            (timer-triggered tech-checking-timer)
                            (up-research-status  c: imperial-age > research-pending)
                            (up-pending-objects c: knight-line g:>= gl-temp5)
                            (up-research-status c: ri-cavalier < research-pending)
                            =>
                            (set-goal gl-temp1 0)
                            ;(chat-to-all "rule 3")
                        )

                        (defrule
                            (up-research-status  c: imperial-age > research-pending)
                            (up-pending-objects c: knight-line >= 7)
                            (up-research-status c: ri-paladin < research-pending)
                            (up-research-status c: ri-savar < research-pending)
                            =>
                            (set-goal gl-temp1 0)
                            ;(chat-to-all "rule 4")
                        )

                        (defrule
                            (true)
                            =>
                            (up-get-fact food-amount 0 gl-temp2)
                            (up-modify-goal gl-temp2 g:- gl-saving-food-needed)
                            (up-get-fact gold-amount 0 gl-temp3)
                            (up-modify-goal gl-temp3 g:- gl-saving-gold-needed)
                        )



                        (defrule
                    (current-age == castle-age)
                    =>
                    (up-modify-goal gl-temp6 s:= sn-maximum-town-size)
                    (up-modify-sn sn-maximum-town-size c:= 40)
                    (set-goal gl-temp4 0)
                )
        
                (defrule
                    ;(up-compare-goal gl-MILITARY-SUPERIORITY < Agressiveness)
                    (current-age == castle-age)
                    (up-enemy-units-in-town >= 3)
                    (town-under-attack)
                    (unit-type-count-total knight-line < 10)
                    =>
                    (set-goal gl-temp4 1)
                    
                )

                (defrule
                    (current-age == castle-age)
                    =>
                    (up-modify-sn sn-maximum-town-size g:= gl-temp6)
                )

                    ;training rule

                    

                        (defrule
                            (goal gl-temp4 1) ;dont produce if you soon will need to save for upgrades   
                            (can-train knight-line)
                            (current-age == castle-age)
                            =>
                            (train knight-line)
                            ;(chat-to-all "training extra knights to defend in castle age")
                        )

                        (defrule
                            (goal gl-temp1 1) ;many conditions combined  
                            (can-train knight-line)
                            (up-compare-goal gl-temp2 >= 60)
                            (up-compare-goal gl-temp3 >= 75)
                            (or(goal gl-early-imp-strat early-paladin)
                            (up-research-status c: imperial-age < research-pending))
                            
                            =>
                            (train knight-line)
                        )

                        (defrule
                            (goal gl-temp1 1) ;dont produce if you soon will need to save for upgrades   
                            

                            (not(and(up-research-status c: imperial-age > research-pending)
                            (and(up-pending-objects c: knight-line >= 7)
                            (and(up-research-status c: ri-paladin < research-pending)
                            (up-research-status c: ri-savar < research-pending)))))

                            (not(and(up-research-status  c: imperial-age > research-pending)
                            (and(up-pending-objects c: knight-line >= 5)
                            (up-research-status c: ri-cavalier < research-pending))))
                            =>
                            (set-goal gl-split-rule 720)
                        )

                        (defrule
                            (goal gl-split-rule 720)
                            (can-train knight-line)
                            (up-compare-goal gl-temp2 >= 60)
                            (up-compare-goal gl-temp3 >= 75)
                            (or(goal gl-early-imp-strat early-paladin)
                            (up-research-status c: imperial-age < research-pending))
                            (or(up-research-status c: ri-paladin >= research-pending)
                            (up-research-status c: ri-savar >= research-pending))
                            
                            =>
                            (train knight-line)
                        )

                            

                        (defrule
                            (goal gl-temp1 1) ;dont produce if you soon will need to save for upgrades   
                            (can-train knight-line)
                            (up-compare-goal gl-temp2 >= 60)
                            (up-compare-goal gl-temp3 >= 75)

                            (not(and(up-research-status c: imperial-age > research-pending)
                            (and(up-pending-objects c: knight-line >= 7)
                            (and(up-research-status c: ri-paladin < research-pending)
                            (up-research-status c: ri-savar < research-pending)))))
                            =>
                            (set-goal gl-split-rule 721)
                        )

                        (defrule
                            (goal gl-split-rule 721)
                            (not(and(up-research-status  c: imperial-age > research-pending)
                            (and(up-pending-objects c: knight-line >= 5)
                            (up-research-status c: ri-cavalier < research-pending))))

                            (or(goal gl-early-imp-strat early-paladin)
                            (up-research-status c: imperial-age < research-pending))
                            (or(up-research-status c: ri-paladin >= research-pending)
                            (up-research-status c: ri-savar >= research-pending))
                            
                            =>
                            (train knight-line)
                        )
                            

                        (defrule
                            (goal gl-temp1 1) ;dont produce if you soon will need to save for upgrades   
                            (can-train knight-line)
                            (goal gl-saving-for-upgrade -1)
                            (or(goal gl-early-imp-strat delayed-paladin)
                            (up-research-status c: imperial-age < research-pending))
                            (not(and(up-research-status c: imperial-age > research-pending)
                            (and(up-pending-objects c: knight-line >= 5)
                            (up-research-status c: ri-cavalier < research-pending))))
                            
                            =>
                            (train knight-line)
                        )
                
            ; train monks
                (defrule
