; Fase 1: 

    ; Info
        ; Runs from the start of the game until Rehoboam has enough food to click up at 22 pop dark-age.
        ; Fase 1 is fixed and will not change with strategy choice.
        ; Fase 1 has primarily DUC-controlled eco.
        ; Rules in Fase 1 will continue to run through Fase 2.
            (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 412 g:= 181)
                
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 6 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                )
    ; Skipping fase 1
        ; Jump to first rule of fase 3 if chosen

            (defrule
                (up-compare-goal gl-fase > 2)
                (up-compare-goal gl-fase-three-first-rule != -1)
                =>
                (up-jump-direct g: gl-fase-three-first-rule)
            )

    ;
    ;testing
        (defrule
            (current-age < castle-age)
            =>
            (set-strategic-number sn-maximum-town-size 20)
        )

        (defrule
            (true)
            =>
            (set-strategic-number sn-minimum-town-size 15)
        )

        
    ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 413 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 61 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                )
    ;0 Build-line engine
        ;Jump to end of build-line engine to prevent crashes due to missing wood for palisade check
            (defrule
            (up-compare-goal gl-end-of-build-line-engine-rule != -1)
            (wood-amount < 2)
            =>
            (up-jump-direct g: gl-end-of-build-line-engine-rule) ; end the pass here
            )
        ;
        ;Buildings
            ; Building loop
                    (defrule
                    (up-compare-goal gl-building-tiles >= 1)
                    =>
                    (up-modify-goal gl-tiles-checker c:= 1)
                    (up-copy-point gl-building-testing-spot-x gl-new-building-spot-x)
                    (up-modify-goal gl-stuff-in-the-way c:= 0) ; skal aktiveres
                    (up-modify-goal gl-danger-counter c:= 0)
                )

                #load-if-not-defined DE-AVAILABLE
                (defrule
                    (true)
                    =>
                    (up-lerp-tiles gl-new-building-spot-x gl-true-position-self-x c: -3)
                )
                #end-if

                #load-if-defined DE-AVAILABLE
                (defrule
                    (true)
                    =>
                    (do-nothing)
                )
                #end-if

                (defrule
                    (up-compare-goal gl-tiles-checker == 2)
                    (up-compare-goal gl-building-tiles >= 2)
                    =>
                    (up-modify-goal gl-building-testing-spot-y c:- 1)
