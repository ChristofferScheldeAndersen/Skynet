                    (true)
                    =>
                    (up-modify-sn sn-maximum-town-size g:= gl-temp2)
                )


                (defrule ;dont attack at stupid times in imp
                    (up-research-status c: ri-cavalier <= research-pending)
                    (current-age == imperial-age)
                    (up-compare-goal gl-MILITARY-SUPERIORITY >= 25)
                    =>
                    (up-modify-goal gl-MILITARY-SUPERIORITY c:- 24)
                )

                (defrule
                    (current-age == imperial-age)
                    =>
                    (disable-timer enemy-has-imp-tech-timer)
                    (disable-timer imp-commit-timer)
                    (disable-self)
                )

                (defrule
                    (players-current-age target-player == imperial-age)
                    =>
                    (enable-timer enemy-has-imp-tech-timer 45)
                    (disable-self)
                )

                (defrule
                    (up-timer-status imp-commit-timer != timer-running)
                    (up-timer-status enemy-has-imp-tech-timer <= timer-running)
                    (research-completed ri-cavalier)
                    (unit-type-count-total knight-line >= 25)
                    (military-population >= 30)
                    (players-military-population target-player < 55)
                    =>
                    (enable-timer imp-commit-timer 150)
                    (disable-self)
                )

                (defrule
                    (up-timer-status imp-commit-timer != timer-running)
                    (up-timer-status enemy-has-imp-tech-timer <= timer-running)
                    (research-completed ri-cavalier)
                    (unit-type-count-total knight-line >= 25)
                    (military-population >= 30)
                    (players-military-population target-player < 75)
                    =>
                    (enable-timer imp-commit-timer 150)
                    (disable-self)
                )

                (defrule
                    (up-timer-status enemy-has-imp-tech-timer > timer-running)
                    (population < 170)
                    =>
                    (disable-timer imp-commit-timer)
                    (disable-self)
                )

                (defrule
                    (up-timer-status enemy-has-imp-tech-timer > timer-running)
                    (population < 150)
                    =>
                    (disable-timer imp-commit-timer)
                )

                (defrule
                    (up-timer-status imp-commit-timer != timer-running)
                    (population >= 190)
                    =>
                    (enable-timer imp-commit-timer 150)
                )

                (defrule ;keep attacking in when you get cavalier if you have a good timing
                    (research-completed ri-cavalier)
                    (up-compare-goal gl-MILITARY-SUPERIORITY < 25)
                    (or(unit-type-count-total knight-line > 15)
                    (unit-type-count-total spearman-line > 35))
                    (military-population > 20)
                    (up-timer-status imp-commit-timer == timer-running)
                    =>
                    (up-modify-goal gl-MILITARY-SUPERIORITY c:= 25)
                    (up-modify-goal gl-MILITARY-SUPERIORITY c:+ 20)
                    ;(chat-to-all "commiting to imp attack")
                )

                (defrule
                    (up-timer-status imp-commit-timer == timer-running)
                    =>
                    ;(chat-to-all "commiting timer is running")
                    (do-nothing)
                )
















                

                #load-if-not-defined UP-POCKET-POSITION

                (defrule
                    (or(not(players-unit-type-count every-ally paladin < 1))
                    (not(players-unit-type-count every-ally cavalier < 8)))
                    (current-age == imperial-age)
                    =>
                    (up-modify-goal gl-MILITARY-SUPERIORITY c:+ 10)
                    ;(chat-to-all "ally is rdy to attack + 10")
                )

            ;******************************************************************************
            ;
        ;
        ; Retreating-mode
                ;
                ;******************************************************************************
                (defrule
                (true)
                =>
                (enable-timer gather-army-timer 30)
                (disable-self)
                )

                (defrule 
                (up-compare-goal gl-MILITARY-SUPERIORITY < Agressiveness) ;-3
                (not(goal gl-agression-mode retreating))
                        =>
                        (set-goal gl-agression-mode retreating)
                        (enable-timer retreat-timer 20)
                        (enable-timer no-fighting-timer 0)
                        (enable-timer full-retreat-timer 10)
                        
                )

                (defrule
                    (true)
                    =>
                    (up-get-point position-self gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-full-reset-search)
                    (up-get-search-state gl-local-total)
                    (up-filter-distance c: -1 c: 25)
                    (set-strategic-number sn-focus-player-number 1)
                )

                (defrule
                    (players-stance focus-player enemy)
                    =>
                    (up-find-remote c: all-units-class c: 40)
                    (up-get-search-state gl-local-total)
                )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )

                (defrule
                    (up-compare-goal gl-remote-total >= 3)
                    =>
                    ;(chat-to-all "enemy in town. Dont retreat")
                    (do-nothing)
                )


                (defrule
                (goal gl-agression-mode retreating)
                (up-timer-status full-retreat-timer == timer-running)
                (game-time > 840)
                (or(up-compare-goal gl-remote-total < 3)
                    (current-age < castle-age))
                =>
                (set-goal gl-split-rule 28)
                )

                (defrule
                    (goal gl-split-rule 28)
                    =>
                    (up-reset-search 1 1 1 1)
                    (up-reset-filters)
                    (up-filter-distance c: 0 c: 200)
                    (up-find-local c: 900 c: 100)
                (up-find-local c: -287 c: 100)
                (up-find-local c: 280 c: 100)
                    (up-find-local c: -295 c: 100)
                (up-get-point position-self gl-point-tc-x)
                    (up-target-point gl-point-tc-x action-default -1 -1)

                (set-strategic-number sn-disable-defend-groups 1)
                (set-strategic-number sn-number-attack-groups 0)

                ;(up-set-attack-stance archery-class c: stance-no-attack)
                    ;(up-set-attack-stance knight-line c: stance-no-attack)
                ;(up-set-attack-stance spearman-line c: stance-no-attack)
                    ;(up-gather-inside c: stable c: 1)
                    ;(up-gather-inside c: archery-range c: 1)
                (up-gather-inside c: siege-workshop c: 1)
                (up-gather-inside c: barracks c: 1)
                ;;(chat-to-all "full retreat")
                )
                

                (defrule
                (goal gl-agression-mode retreating)
                (or(up-timer-status full-retreat-timer == timer-running)
                (timer-triggered no-fighting-timer))
                (game-time > 900)
                (or(up-compare-goal gl-remote-total < 3)
                    (current-age < castle-age))
                =>
                (set-goal gl-split-rule 29)
                )

                (defrule
                    (goal gl-split-rule 29)
                    =>
                    (up-reset-search 1 1 1 1)
                    (up-reset-filters)
                    (up-filter-distance c: 0 c: 200)
                    (up-find-local c: 913 c: 100) ; siege
                    (up-get-point position-self gl-point-tc-x)
                    (up-target-point gl-point-tc-x action-default -1 -1)
                )
            
                

                (defrule
                    (goal gl-agression-mode retreating)
                    (timer-triggered no-fighting-timer)
                    (game-time > 840)
                    (or(up-compare-goal gl-remote-total < 3)
                    (current-age < castle-age))
                    =>
                    (set-goal gl-split-rule 30)
                )

                (defrule
                    (goal gl-split-rule 30)
                    =>
                    (disable-timer no-fighting-timer)


                (up-reset-search 1 1 1 1)
                    (up-reset-filters)
                    (up-filter-distance c: 0 c: 200)
                    (up-find-local c: 900 c: 100)
                (up-find-local c: -287 c: 100)
                ;(up-find-local c: 280 c: 100)
                    (up-find-local c: -295 c: 100)
                (up-filter-exclude -1 -1 -1 448)
                    (up-get-point position-self gl-point-tc-x)
                    (up-target-point gl-point-tc-x action-default -1 -1)

                (set-strategic-number sn-disable-defend-groups 1)
                (set-strategic-number sn-number-attack-groups 0)

                    ) ; full-retreat når military superiority er under -3

                    (defrule
                    (goal gl-split-rule 30)
                    =>
                
                ;(up-set-attack-stance archery-class c: stance-aggressive)
                    ;(up-set-attack-stance knight-line c: stance-aggressive)
                ;(up-set-attack-stance spearman-line c: stance-aggressive)
                    ;(up-gather-inside c: stable c: 1)
