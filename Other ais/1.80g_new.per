                (up-add-object-by-id search-remote g: gl-first-boar-id)
                (up-remove-objects search-remote object-data-hitpoints > 72)
                ;;(chat-to-all "rule is running")
                )

        ;9 send first vill back from upper right quadrant v (esty rules used)

            (defrule
            (or(goal BOAR-STATUS Send-vill-to-tc)
            (goal BOAR-STATUS Killing-Boar))
            (up-set-target-object search-remote c: 0)
            (not(up-compare-goal gl-taking-second-boar == 1))
            (up-compare-goal gl-luring-step == -1)
            (up-compare-goal gl-boar-point-relation-to-tc == upper-right-quadrant)
            (up-compare-goal gl-second-boar-luring-villager == -1)
                =>
                (set-goal gl-split-rule 66))
            (defrule
                (goal gl-split-rule 66)
            =>              (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-first-boar-luring-villager )
                (up-get-point position-self gl-position-self-x)
                (up-modify-goal gl-position-self-x c:+ 2)
                (up-modify-goal gl-position-self-y c:+ 2)
                (up-set-target-point gl-position-self-x)
                (up-target-point gl-position-self-x action-move -1 -1) 
                (up-full-reset-search)
                (set-goal gl-luring-step 1)
            )

            (defrule
            (or(goal BOAR-STATUS Send-vill-to-tc)
            (goal BOAR-STATUS Killing-Boar))
            (up-set-target-object search-remote c: 0)
            (up-compare-goal gl-taking-second-boar == 1)
            (up-compare-goal gl-luring-step == -1)
            (up-compare-goal gl-boar-point-relation-to-tc == upper-right-quadrant)
            (up-compare-goal gl-second-boar-luring-villager == -1)
                =>
            (set-goal gl-split-rule 67))
