                    (up-compare-goal gl-second-boar-id == -1)
                        (up-point-explored gl-temp-x != explored-no)
                        ;(up-set-target-by-id g: gl-deer-id-checker)
                        (unit-type-count villager >= 9)
                        (up-object-data object-data-class == 910)
                        =>
                (up-get-object-data object-data-id gl-first-boar-id)
                (up-add-object-by-id search-remote g: gl-first-boar-id)
                (up-get-search-state gl-local-total)
                (up-get-point position-object gl-point-x) 
                ;(chat-to-all "NEW found first boar")
                ;(up-send-flare gl-point-x)
                ;;(up-chat-data-to-player my-player-number "gl-remote-total is %d." g: gl-local-total)
                )

                (defrule
                (up-compare-goal gl-first-boar-id == -1)
                    (up-compare-goal gl-second-boar-id == -1)
                    (up-compare-goal gl-deer-id-checker g:< gl-last-gaia-id)
                    (unit-type-count villager >= 9)
                    =>
                    (up-modify-goal gl-deer-id-checker c:+ 1)
                    (up-jump-rule -3)
                )


            ; Making sure first boar is not closer to an ally
                (defrule
                    (true)
                    =>
                    (set-goal gl-temp1 -1)
                    (set-goal gl-temp1-x -1)
                    (set-goal gl-temp1-y -1)
                    (set-goal gl-position-self-x -1)
                    (set-goal gl-position-self-y -1)
                )
                
                (defrule
                    (up-set-target-by-id g: gl-first-boar-id)
                    (up-compare-goal gl-second-boar-id == -1)
                        =>
                    (up-get-point position-object gl-temp1-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-get-point-distance gl-temp1-x gl-position-self-x gl-temp1)
                )

                (defrule
                    (or(and(up-point-distance gl-temp1-x gl-first-ally-position-self-x g:< gl-temp1)
                    (up-compare-goal gl-first-ally-position-self-x != -1));not closest to ally
                    (or(and(up-point-distance gl-temp1-x gl-second-ally-position-self-x g:< gl-temp1)
                    (up-compare-goal gl-second-ally-position-self-x != -1));not closest to ally
                    (and(up-point-distance gl-temp1-x gl-second-ally-position-self-x g:< gl-temp1)
                    (up-compare-goal gl-third-ally-position-self-x != -1))));not closest to ally
                    =>
                    (set-goal gl-first-boar-id -1)
                    (chat-to-all "first boar is closer to ally. Resetting goal")
                )

                

            ; First boar - Find lokation of gl-point-x in relation to starting tc
                
                (defrule ;starting lokation program
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (up-modify-goal gl-point-numeric-x c:= 0)
                (up-modify-goal gl-point-numeric-y c:= 0)
                (up-get-point position-self gl-position-self-x)
                (up-modify-goal gl-position-self-x c:+ 5)  ; bedre til boars
                (up-modify-goal gl-position-self-y c:- 5)  ; bedre til boars
                )

                (defrule
                    (up-compare-goal gl-point-x != -1) 
                    =>
                    (up-modify-goal gl-point-numeric-x g:+ gl-position-self-x)
                    (up-modify-goal gl-point-numeric-x g:- gl-point-x)
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-numeric-x < 0)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (up-modify-goal gl-point-numeric-x g:neg gl-point-numeric-x)
                    ;(disable-self)
                )


                (defrule
                    (up-compare-goal gl-point-y != -1)
                    =>
                    (up-modify-goal gl-point-numeric-y g:+ gl-position-self-y)
                    (up-modify-goal gl-point-numeric-y g:- gl-point-y)
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-numeric-y < 0)
                    (up-compare-goal gl-point-y != -1)
                    =>
                    (up-modify-goal gl-point-numeric-y g:neg gl-point-numeric-y)
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-y g:< gl-position-self-y)
                    (up-compare-goal gl-point-numeric-y g:>= gl-point-numeric-x)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (set-goal gl-point-relation-to-tc upper-left-quadrant)
                    ;;(chat-to-all "point is in upper left quadrant")
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-y g:>= gl-position-self-y)
                    (up-compare-goal gl-point-numeric-y g:>= gl-point-numeric-x)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (set-goal gl-point-relation-to-tc lower-right-quadrant)
                    ;;(chat-to-all "point is in lower right quadrant")
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-x g:>= gl-position-self-x)
                    (up-compare-goal gl-point-numeric-x g:>= gl-point-numeric-y)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (set-goal gl-point-relation-to-tc upper-right-quadrant)
                    ;;(chat-to-all "point is in upper right quadrant")
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-x g:< gl-position-self-x)
                    (up-compare-goal gl-point-numeric-x g:>= gl-point-numeric-y)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (set-goal gl-point-relation-to-tc lower-left-quadrant)
                    ;;(chat-to-all "point is in lower left quadrant")
                    ;(disable-self)
                )
                
                    (defrule ;needs to be reset in the main script
                    (up-compare-goal gl-point-relation-to-tc != -1)
                    (up-compare-goal gl-point-x != -1)
                    (unit-type-count villager == 9)
                    (up-compare-goal gl-first-boar-id != -1)
                    (up-compare-goal gl-second-boar-id == -1)
                                    =>
                    (up-modify-goal gl-boar-point-relation-to-tc g:=  gl-point-relation-to-tc)
                    ;;(chat-to-all "rule is running 1")
                    (disable-self)
                    )

                    (defrule ;needs to be reset in the main script
                    (up-compare-goal gl-point-relation-to-tc != -1)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (set-goal gl-point-x -1)
                    ;(disable-self) ; ellers larmer den
                    )


            ; Second boar ID:

                (defrule
                    (true)
                    =>
                (up-full-reset-search)
                )

                (defrule
                    (up-compare-goal gl-first-boar-id != -1)
                    (up-compare-goal gl-second-boar-id == -1)
                    =>
                    (up-full-reset-search)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-filter-distance c: 0 c: 32)
                    (set-strategic-number sn-focus-player-number 0)
                    )
                (defrule
                    (up-compare-goal gl-first-boar-id != -1)
                    (up-compare-goal gl-second-boar-id == -1)
                            =>
                    (up-find-remote c: 910 c: 2)
                    (up-remove-objects search-remote object-data-carry == 0)
                    (up-remove-objects search-remote object-data-id g:== gl-first-boar-id)
                    (up-remove-objects search-remote object-data-hitpoints c:< 1)
                    (up-remove-objects search-remote object-data-distance c:> 42)
                    (up-clean-search search-remote object-data-index search-order-asc)
                    )

                    (defrule
                    (up-compare-goal gl-first-boar-id != -1)
                    (up-compare-goal gl-second-boar-id == -1)
                    (up-set-target-object search-remote c: 0)
                    (up-compare-goal gl-first-boar-status != -1) ; 
                                =>
                                
                    (up-get-object-data object-data-id gl-second-boar-id)
                    (up-get-point position-object gl-point-x)
                    ;(up-send-flare gl-point-x)
                    ;(chat-to-player my-player-number "asserting ID to second boar")
                    )

                    ; alternativ regel hvis boar går ind i line of sight

                    (defrule
                    (up-compare-goal gl-first-boar-id != -1)
                    (up-compare-goal gl-second-boar-id == -1)
                    (up-compare-goal gl-first-boar-status >= first-boar-is-dead)
                    =>
                    (up-full-reset-search)
                    (up-get-search-state gl-local-total)
                    
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-modify-goal gl-deer-id-checker g:= gl-first-gaia-id)
                    (set-goal gl-temp-x -1)
                    )

                    (defrule
                    (up-compare-goal gl-first-boar-id != -1)
                        (up-compare-goal gl-second-boar-id == -1)
                        (up-set-target-by-id g: gl-deer-id-checker)
                        (up-object-data object-data-class == 910)
                        (up-object-data object-data-carry > 0)
                        (up-object-data object-data-hitpoints > 0)
                        (up-object-data object-data-distance < 42)
                        (up-object-data object-data-id g:!= gl-first-boar-id)
                        (up-compare-goal gl-deer-id-checker g:!= gl-first-boar-id)
                        (up-compare-goal gl-first-boar-status >= first-boar-is-dead)
                        =>
                        (set-goal gl-temp-x -1)
                        (up-get-point position-object gl-temp-x)
                    )

                        (defrule
                        (up-compare-goal gl-first-boar-id != -1)
                        (up-compare-goal gl-second-boar-id == -1)
                            (up-point-explored gl-temp-x != explored-no)
                            (up-compare-goal gl-first-boar-status >= first-boar-is-dead)
                            (up-object-data object-data-id g:!= gl-first-boar-id)
                            (up-object-data object-data-class == 910)
                            =>
                    (up-get-object-data object-data-id gl-second-boar-id)
                    (up-add-object-by-id search-remote g: gl-second-boar-id)
                    (up-get-search-state gl-local-total)
                    (up-get-point position-object gl-point-x) 
                    ;(chat-to-all "NEW found second boar")
                    ;(up-send-flare gl-point-x)
                    ;;(up-chat-data-to-player my-player-number "gl-remote-total is %d." g: gl-local-total)
                    )

                    (defrule
                    (up-compare-goal gl-first-boar-id != -1)
                        (up-compare-goal gl-second-boar-id == -1)
                        (up-compare-goal gl-deer-id-checker g:< gl-last-gaia-id)
                        (up-compare-goal gl-first-boar-status >= first-boar-is-dead)
                        =>
                        (up-modify-goal gl-deer-id-checker c:+ 1)
                        (up-jump-rule -3)
                    )
            
                    (defrule
                        (taunt-detected my-player-number 10)
                        =>
                        (up-chat-data-to-all "gl-first-boar-id is %d." g: gl-first-boar-id)
                        (up-chat-data-to-all "gl-second-boar-id is %d." g: gl-second-boar-id)
                        (acknowledge-taunt my-player-number 10)
                    )
            ; Making sure second boar isn't closer to an ally
                (defrule
                    (true)
                    =>
                    (set-goal gl-temp1 -1)
                    (set-goal gl-temp1-x -1)
                    (set-goal gl-temp1-y -1)
                    (set-goal gl-position-self-x -1)
                    (set-goal gl-position-self-y -1)
                )
                
                (defrule
                    (up-set-target-by-id g: gl-second-boar-id)
                        =>
                    (up-get-point position-object gl-temp1-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-get-point-distance gl-temp1-x gl-position-self-x gl-temp1)
                )
                #load-if-defined DE-AVAILABLE
                (defrule
                    (or(up-point-distance gl-temp1-x gl-first-ally-position-self-x g:< gl-temp1);not closest to ally
                    (or(up-point-distance gl-temp1-x gl-second-ally-position-self-x g:< gl-temp1);not closest to ally
                    (up-point-distance gl-temp1-x gl-second-ally-position-self-x g:< gl-temp1)));not closest to ally
                    =>
                    (set-goal gl-second-boar-id -1)
                    ;(chat-to-all "second boar is closer to ally. Resetting goal")
                )
                #end-if
            ; Second boar - Find lokation of gl-point-x in relation to starting tc
                
                (defrule ;starting lokation program
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (up-modify-goal gl-point-numeric-x c:= 0)
                (up-modify-goal gl-point-numeric-y c:= 0)
                (up-get-point position-self gl-position-self-x)
                (up-modify-goal gl-position-self-x c:+ 5)  ; bedre til boars
                (up-modify-goal gl-position-self-y c:- 5)  ; bedre til boars
                )

                (defrule
                    (up-compare-goal gl-point-x != -1) 
                    =>
                    (up-modify-goal gl-point-numeric-x g:+ gl-position-self-x)
                    (up-modify-goal gl-point-numeric-x g:- gl-point-x)
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-numeric-x < 0)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (up-modify-goal gl-point-numeric-x g:neg gl-point-numeric-x)
                    ;(disable-self)
                )


                (defrule
                    (up-compare-goal gl-point-y != -1)
                    =>
                    (up-modify-goal gl-point-numeric-y g:+ gl-position-self-y)
                    (up-modify-goal gl-point-numeric-y g:- gl-point-y)
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-numeric-y < 0)
                    (up-compare-goal gl-point-y != -1)
                    =>
                    (up-modify-goal gl-point-numeric-y g:neg gl-point-numeric-y)
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-y g:< gl-position-self-y)
                    (up-compare-goal gl-point-numeric-y g:>= gl-point-numeric-x)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (set-goal gl-point-relation-to-tc upper-left-quadrant)
                    ;;(chat-to-all "point is in upper left quadrant")
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-y g:>= gl-position-self-y)
                    (up-compare-goal gl-point-numeric-y g:>= gl-point-numeric-x)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (set-goal gl-point-relation-to-tc lower-right-quadrant)
                    ;;(chat-to-all "point is in lower right quadrant")
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-x g:>= gl-position-self-x)
                    (up-compare-goal gl-point-numeric-x g:>= gl-point-numeric-y)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (set-goal gl-point-relation-to-tc upper-right-quadrant)
                    ;;(chat-to-all "point is in upper right quadrant")
                    ;(disable-self)
                )

                (defrule
                    (up-compare-goal gl-point-x g:< gl-position-self-x)
                    (up-compare-goal gl-point-numeric-x g:>= gl-point-numeric-y)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (set-goal gl-point-relation-to-tc lower-left-quadrant)
                    ;;(chat-to-all "point is in lower left quadrant")
                    ;(disable-self)
                )

                    (defrule ;needs to be reset in the main script
                    (up-compare-goal gl-point-relation-to-tc != -1)
                    (up-compare-goal gl-point-x != -1)
                    ;(unit-type-count villager == 14)
                    (up-compare-goal gl-second-boar-id != -1)
                    ;(up-remaining-boar-amount < 400);test fra
                    ;(up-remaining-boar-amount > 0)
                                    =>
                    (up-modify-goal gl-boar-point-relation-to-tc g:=  gl-point-relation-to-tc)
                    ;;(chat-to-all "rule is running 2")
                    ;;(up-chat-data-to-all "second boar gl-boar-point-relation-to-tc is %d." g: gl-boar-point-relation-to-tc)
                    (disable-self)
                    )

                    (defrule ;needs to be reset in the main script
                    (up-compare-goal gl-point-relation-to-tc != -1)
                    (up-compare-goal gl-point-x != -1)
                    =>
                    (set-goal gl-point-x -1)
                    ;(disable-self) ; ellers larmer den
                    )


        ;3 set gather points (virker ikke optimalt længere men er ikke vigtig)

            (defrule
            (unit-type-count villager == 9)
            (up-compare-goal gl-first-boar-id != -1)


            =>
            (up-full-reset-search)
            (up-find-local c: town-center c: 1)
            (up-add-object-by-id search-remote g: gl-first-boar-id)
            (up-set-target-object search-remote c: 0)
            (up-set-target-object search-local c: 0)
            ;(up-target-objects 0 action-gather -1 -1) ; efter ny boar vill regel
            ;;(chat-to-all "attempting to set gather point at first boar")
            (disable-self)
            )

            
            

        ;4 Initiate boar lure

            (defrule
                (true)
                =>
                (set-goal gl-temp -1)
            )

            (defrule ; DUC instead of up-remaining-boar-amount 
                (up-set-target-by-id g: gl-first-boar-id)
                =>
                (up-get-object-data object-data-carry gl-temp)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: town-center c: 1)
                (set-goal gl-temp1 0)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-progress-type == 103) ;research
                =>
                (up-get-object-data object-data-progress-value gl-temp1)
                ;;;(up-chat-data-to-all "town center job is %d. % complete" g: gl-temp)
            )


            (defrule ;starter "loopet" de 2 gange det skal ske
            (or(and(unit-type-count villager >= 9) ; første boar initiation
                (up-compare-goal BOAR-STATUS != Eating-Boar)) ; for at den ikke genstarter ved tidl boar
                
                
            (and(up-compare-goal gl-second-boar-id != -1) ; fast del af anden boar +
            (and(goal BOAR-STATUS Eating-Boar)
            (or      
            (and(up-compare-goal gl-temp < 250) ; (remaining food) enten normal initiation af 2. boar
                (and(up-compare-goal gl-temp > 0)
                (up-compare-goal gl-first-boar-status == first-boar-is-dead)))

                (up-compare-goal gl-first-boar-status == first-boar-is-gone))))) ; eller sen initiation af 2. boar
                =>
                (set-goal gl-split-rule 65)
            )

            (defrule
                (goal gl-split-rule 65)
                (up-compare-goal BOAR-STATUS != Starting-Boar-Lure)
            (up-compare-goal BOAR-STATUS != Send-vill-to-tc)
            (up-compare-goal BOAR-STATUS != Killing-Boar)
            (up-compare-goal gl-second-boar-status == -1); bliv ved eating boar efter anden boar er dræbt
            
                
                (or(up-compare-goal gl-boar-score < 47)
                (or(research-completed ri-loom)
                (up-compare-goal gl-temp1 > 20)))
                (not(up-compare-goal gl-boar-score == -1))
                =>
            (set-goal BOAR-STATUS Starting-Boar-Lure)
            ;(chat-to-all "starting boar lure")
                )
                
                
        ;5 Chose luring villagers 
            ;(mangler en failsafe hvis vill er low på hp!!!)

            ; Villager ID's:

            (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-remote g: gl-current-sheep)
                )

                (defrule
                    (or(unit-type-count villager == 10)
                    (and(unit-type-count villager == 9)
                    (and(up-set-target-object search-remote c: 0)
                    (up-object-data object-data-carry <= 35))))
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != shepard-group)
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-id gl-first-boar-luring-villager)
                    (disable-self)
                )

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                )

                (defrule
                (unit-type-count villager >= 13)
                (not(research-completed ri-loom))
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != shepard-group)
                (up-remove-objects search-local object-data-hitpoints < 25)
                (up-remove-objects search-local object-data-id g:== gl-first-boar-luring-villager)
                )

                (defrule
                (unit-type-count villager >= 13)
                (research-completed ri-loom)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != shepard-group)
                (up-remove-objects search-local object-data-hitpoints < 40)
                (up-remove-objects search-local object-data-id g:== gl-first-boar-luring-villager)
                )

                (defrule
                (up-compare-goal gl-first-boar-luring-villager != -1)
                (up-compare-goal gl-second-boar-luring-villager == -1)
                (unit-type-count villager >= 13)
                (up-compare-goal gl-first-boar-status != -1)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-id gl-second-boar-luring-villager)
                ;(up-chat-data-to-all "second boar luring vill id is %d" g: gl-second-boar-luring-villager)
                (disable-self)
                )


            ; First boar vill.

                (defrule ;first boar vill
                    (true)
                    =>
                    (up-full-reset-search)
                )

                (defrule
                    (up-compare-goal gl-first-boar-luring-villager != -1)
                    (up-compare-goal gl-second-boar-luring-villager == -1)
                    (up-compare-goal gl-first-boar-id != -1)
                    =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-remote g: gl-first-boar-id)
                )

                (defrule
                    (up-compare-goal gl-first-boar-luring-villager != -1)
                    (up-compare-goal gl-second-boar-luring-villager == -1)
                    (up-compare-goal gl-first-boar-id != -1)

                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-get-object-target-data object-data-id gl-boar-target)
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-first-boar-luring-villager)
                )

                (defrule
                    (up-compare-goal gl-first-boar-luring-villager != -1)
                    (up-compare-goal gl-second-boar-luring-villager == -1)
                    (up-compare-goal gl-first-boar-id != -1)

                    (up-set-target-object search-local c: 0)
                    (up-compare-goal gl-boar-target g:!= gl-first-boar-luring-villager)
                    (up-object-data object-data-hitpoints < 25)
                    =>
                    ;(chat-to-all "First boar luring villager is hurt. Chosing new") ;change vill kode:
                    (up-modify-goal gl-temp g:= gl-first-boar-luring-villager) ;1 vi copierer den tidl luring vill i et nyt ID-goal
                    (up-full-reset-search) ;2 vi laver en liste med 6+1 vills og fjerner alle med under 25 hp.
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != shepard-group)
                    (up-add-object-by-id search-local g: gl-first-boar-luring-villager)
                    (up-remove-objects search-local object-data-hitpoints < 25)
                )

                    (defrule ;3 vi vælger en ny luring vill og gemmer ID
                        (up-compare-goal gl-first-boar-luring-villager != -1)
                        (up-compare-goal gl-second-boar-luring-villager == -1)
                        (up-compare-goal gl-first-boar-id != -1)
                        (up-set-target-object search-local c: 0) ;mangler evt noget sikring så den ikke vælger en anden
                        (up-object-data object-data-hitpoints >= 25)
                        =>
                        (up-get-object-data object-data-id gl-first-boar-luring-villager)
                        ;(up-full-reset-search) ;4 vi laver en liste med shepards, tilføjer den gamle luring vill og fjerner den nye
                        ;(up-find-local c: villager-class c: 200)
                        ;(up-remove-objects search-local object-data-group-flag != shepard-group)
                        ;(up-add-object-by-id search-local g: gl-temp)
                        ;(up-remove-objects search-local object-data-id == gl-first-boar-luring-villager)
                    )
            
            ; Second boar vill.

                (defrule ;second boar vill
                    (true)
                    =>
                    (up-full-reset-search)
                )

                (defrule
                    (up-compare-goal gl-second-boar-luring-villager != -1)
                    (up-compare-goal gl-second-boar-id != -1)
                    (up-compare-goal gl-second-boar-status == -1)
                    =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-remote g: gl-second-boar-id)
                )

                (defrule
                    (up-compare-goal gl-second-boar-luring-villager != -1)
                    (up-compare-goal gl-second-boar-id != -1)
                    (up-compare-goal gl-second-boar-status == -1)
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-get-object-target-data object-data-id gl-boar-target)
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-second-boar-luring-villager)
                )

                (defrule
                    (up-compare-goal gl-second-boar-luring-villager != -1)
                    (up-compare-goal gl-second-boar-id != -1)
                    (up-compare-goal gl-second-boar-status == -1)

                    (up-set-target-object search-local c: 0)
                    (up-compare-goal gl-boar-target g:!= gl-second-boar-luring-villager)
                    (up-object-data object-data-hitpoints < 25)
                    =>
                    ;(chat-to-all "second boar luring villager is hurt. Chosing new") ;change vill kode:
                    (up-modify-goal gl-temp g:= gl-second-boar-luring-villager) ;1 vi copierer den tidl luring vill i et nyt ID-goal
                    (up-full-reset-search) ;2 vi laver en liste med 6+1 vills og fjerner alle med under 25 hp.
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != shepard-group)
                    (up-add-object-by-id search-local g: gl-first-boar-luring-villager)
                    (up-add-object-by-id search-local g: gl-second-boar-luring-villager)
                    (up-remove-objects search-local object-data-hitpoints < 25)
                )

                    (defrule ;3 vi vælger en ny luring vill og gemmer ID
                        (up-compare-goal gl-second-boar-luring-villager != -1)
                        (up-compare-goal gl-second-boar-id != -1)
                        (up-set-target-object search-local c: 0) ;mangler evt noget sikring så den ikke vælger en anden
                        (up-object-data object-data-hitpoints >= 25)
                        (up-compare-goal gl-second-boar-status == -1)
                        =>
                        (up-get-object-data object-data-id gl-second-boar-luring-villager)
                        ;(up-full-reset-search) ;4 vi laver en liste med shepards, tilføjer den gamle luring vill og fjerner den nye
                        ;(up-find-local c: villager-class c: 200)
                        ;(up-remove-objects search-local object-data-group-flag != shepard-group)
                        ;(up-add-object-by-id search-local g: gl-temp)
                        ;(up-add-object-by-id search-local g: gl-first-boar-luring-villager)
                        ;(up-remove-objects search-local object-data-id == gl-second-boar-luring-villager)
                        ;(up-remove-objects search-local object-data-group-flag == deer-group)
                    )        
        
        ;6 target boar

            (defrule ; første boar
            (goal BOAR-STATUS Starting-Boar-Lure)
                
            (up-set-target-by-id g: gl-first-boar-luring-villager)
            (up-object-data object-data-carry == 0)

            (up-compare-goal gl-second-boar-luring-villager == -1)
            (up-compare-goal gl-first-boar-id != -1)
            =>
            (set-strategic-number sn-focus-player-number 0)
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-first-boar-luring-villager)
                (up-remove-objects search-local object-data-carry > 0) ;test
                (up-add-object-by-id search-remote g: gl-first-boar-id)
                (up-set-target-object search-remote c: 0)
                ;(up-set-target-object search-local c: 0)
                (up-target-objects 0 action-default -1 -1) ;right-click the boar with the villager
            (set-goal BOAR-STATUS Send-vill-to-tc)
            ;(chat-to-all "waiting for vill to attack first boar")
            )

            (defrule ; anden boar
            (goal BOAR-STATUS Starting-Boar-Lure)
            (up-compare-goal gl-second-boar-luring-villager != -1)
            (up-compare-goal gl-second-boar-id != -1)
            (unit-type-count villager < 25) ; spam
            =>
            (set-strategic-number sn-focus-player-number 0)
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-second-boar-luring-villager)
                (up-remove-objects search-local object-data-carry > 0) ;test
                (up-add-object-by-id search-remote g: gl-second-boar-id)
                (up-target-objects 0 action-default -1 -1) ;right-click the boar with the villager
            (set-goal BOAR-STATUS Send-vill-to-tc)
            ;(chat-to-all "waiting for vill to attack second boar")
            )

        ;7 Retarget boar if its running back 
            
            ;første boar

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                )
                #load-if-not-defined DE-AVAILABLE

                (defrule
                    (up-compare-goal BOAR-STATUS != Eating-Boar)
