                (defrule
                (goal gl-split-rule 195)
                (not(and(enemy-buildings-in-town)
                (unit-type-count archer-line > 2)))
                (not(and(game-time < 1200)
                (and(up-compare-goal gl-MILITARY-SUPERIORITY <= -2)
                (and(players-unit-type-count target-player archer-line >= 4)
                (and(can-train skirmisher-line)
                (unit-type-count archer-line < 9))))))
                =>
                (train archer-line)
                )

        (defrule
        (players-unit-type-count target-player archer-line < 1)
        (players-unit-type-count target-player skirmisher-line < 1)
        =>	(up-jump-rule 1))

            (defrule
                (goal gl-age-status feudal)
