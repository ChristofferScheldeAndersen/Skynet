                    (up-get-object-data object-data-distance gl-temp7) ;gl-temp7 is checked units distance to knight
                    (up-modify-goal gl-temp7 c:* 30)
                    (up-modify-goal gl-temp8 g:- gl-temp7) ;gl-temp8 is checked units score
                    ;(up-chat-data-to-all "checked unit score is %d" g: gl-temp8)
