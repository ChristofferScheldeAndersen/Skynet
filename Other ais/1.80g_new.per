                (defrule
                    (goal gl-split-rule 257)
                    (current-age == imperial-age)
                            (or(and(up-compare-goal gl-remote-total < 10)
                            (gold-amount < 1000))
                            (up-compare-goal gl-temp4 < 75))
                            (not(and(gold-amount > 400)
                            (and(unit-type-count-total knight-line < 25)
