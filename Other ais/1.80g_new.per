                    =>
                    (up-modify-goal gl-building-testing-spot-y c:+ 1)
                )

                (defrule ;regel der sikrer stragglers godt må være tæt på 3 tile bygninger.
                    (not(or(up-point-contains gl-building-testing-spot-x c: 10)
                    (or(up-point-contains gl-building-testing-spot-x c: 18)
                    (or(up-point-contains gl-building-testing-spot-x c: 17)
                    (up-point-contains gl-building-testing-spot-x c: 20)))))

                    =>
                    (set-goal gl-split-rule 36)
                )

                (defrule ;regel der sikrer stragglers godt må være tæt på 3 tile bygninger.
                    (goal gl-split-rule 36)

                    (not(or(up-point-contains gl-building-testing-spot-x c: 13)
                    (or(up-point-contains gl-building-testing-spot-x c: 19)
                    (or(up-point-contains gl-building-testing-spot-x c: 21)
                    (up-point-contains gl-building-testing-spot-x c: 88)))))
                    =>
                    (set-goal gl-split-rule 37)
                )


                (defrule
                    (goal gl-split-rule 37)
                    
                    (up-compare-goal gl-building-tiles == 5)
                    (up-compare-goal gl-tiles-checker <= 36)
                    (up-compare-goal gl-tiles-checker >= 10)
                    (up-point-contains gl-building-testing-spot-x c: 915) ; tree-class = 915
                    ; tree i yderkandt som ikke er forrest terrain.
                    (up-point-distance gl-building-testing-spot-x gl-true-position-self-x < 11)
                    =>
                    (set-goal gl-split-rule 0)
                    (set-goal gl-dont-count-tile YES)
                    ;;(chat-to-all "rule is running")
                )
                    
                    

                (defrule
                    (up-compare-goal gl-tiles-checker <= 36)
                    (up-compare-goal gl-tiles-checker != -1)
                    (not(and(up-can-build-line 0 gl-building-testing-spot-x c: palisade-wall) 
                    (can-afford-building palisade-wall)))
                    (up-compare-goal gl-building-tiles != -1)
                    (goal gl-dont-count-tile -1)
                    
                    =>
                    (up-modify-goal gl-stuff-in-the-way c:+ 1)
                )

                (defrule
                    (up-compare-goal gl-tiles-checker <= 36) ; bør nok være mindre end 36
                    (up-compare-goal gl-tiles-checker != -1)
                    (up-compare-goal gl-building-tiles != -1)
                    =>
                    (up-modify-goal gl-tiles-checker c:+ 1)
                    ;(up-build-line gl-building-testing-spot-x gl-building-testing-spot-x c: palisade-wall) ; bør fjernes
                    (set-goal gl-dont-count-tile -1)
                    (up-jump-rule -41)
                )
                
                #load-if-defined DE-AVAILABLE
                (defrule
                    (up-compare-goal gl-building-tiles != -1)
                    (or(up-compare-goal gl-stuff-in-the-way > 0)
                    (up-point-distance gl-new-building-spot-x gl-true-position-self-x < 6))
                    (up-compare-goal gl-tiles-checker != -1)
                    (up-compare-goal gl-danger-counter < 40)
                    =>
                    ;;;(up-chat-data-to-all "Placement blocked or to close to tc. Number of unfit tiles for placing building is %d." g: gl-stuff-in-the-way)
                    ;(up-build-line gl-building-testing-spot-x gl-building-testing-spot-x c: palisade-wall)
                    (up-modify-goal gl-tiles-checker c:= 1)
                    (up-modify-goal gl-stuff-in-the-way c:= 0) ; skal aktiveres
                    (up-modify-goal gl-danger-counter c:+ 1)
                    (up-cross-tiles gl-new-building-spot-x gl-true-position-self-x c:- 1)
                    (up-copy-point gl-building-testing-spot-x gl-new-building-spot-x)
                    (up-jump-rule -42)
                )
                #end-if

                #load-if-not-defined DE-AVAILABLE
                (defrule
                    (up-compare-goal gl-building-tiles != -1)
                    (or(up-compare-goal gl-stuff-in-the-way > 0)
                    (up-point-distance gl-new-building-spot-x gl-true-position-self-x < 9))
                    (up-compare-goal gl-tiles-checker != -1)
                    (up-compare-goal gl-danger-counter < 40)
                    =>
                    ;;;(up-chat-data-to-all "Placement blocked or to close to tc. Number of unfit tiles for placing building is %d." g: gl-stuff-in-the-way)
                    ;(up-build-line gl-building-testing-spot-x gl-building-testing-spot-x c: palisade-wall)
                    (up-modify-goal gl-tiles-checker c:= 1)
                    (up-modify-goal gl-stuff-in-the-way c:= 0) ; skal aktiveres
                    (up-modify-goal gl-danger-counter c:+ 1)
                    (up-cross-tiles gl-new-building-spot-x gl-true-position-self-x c:- 1)
                    (up-copy-point gl-building-testing-spot-x gl-new-building-spot-x)
                    (up-jump-rule -42)
                )
                #end-if

                
            
            ; Place down building

                    ;house code is placed in fase 1.

                    (defrule
                        (goal gl-build-market YES)
                        (up-compare-goal gl-stuff-in-the-way == 0)
                        (up-compare-goal gl-building-tiles != -1)
                        =>
                        (up-build-line gl-new-building-spot-x gl-new-building-spot-x c: market)
                        (set-goal gl-build-market -1)
                        (up-modify-goal gl-building-tiles c:= -1)
                        ;(disable-self)
                    )

                    (defrule
                            (goal gl-build-house YES)
