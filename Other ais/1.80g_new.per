        ; E Grade the first lumber-camp

                (defrule
                ;(up-compare-goal gl-current-deer-id != -1)
                (building-type-count lumber-camp > 0)
                    =>
                    (up-full-reset-search)
                    (up-get-point position-self gl-position-self-x)
                    (up-get-point position-center gl-center-x)
                    (up-lerp-tiles gl-position-self-x gl-center-x c: -3)
                    (up-set-target-point gl-position-self-x)
                    (up-find-local c: lumber-camp c: 1)
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-distance gl-lumber-camp-distance)
                )

               

                (defrule   ; first attempt
                        (building-type-count lumber-camp > 0)
                            =>
                            (set-strategic-number sn-target-point-adjustment 1)
                            (up-full-reset-search)
                            (up-find-local c: lumber-camp c: 1)
                            (up-set-target-object search-local c: 0)
                            (up-get-point position-object gl-position-self-x)
                            (up-set-target-point gl-position-self-x)
