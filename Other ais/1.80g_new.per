                    (up-get-object-target-data object-data-id gl-boar-target)
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-first-boar-luring-villager)
                    (up-set-target-object search-local c: 0)
                    (up-get-object-target-data object-data-id gl-first-vill-target)
                )
                #end-if
