                    (up-lerp-tiles gl-position-self-x gl-temp-x c: -3)
                    (up-set-target-point gl-position-self-x)
                    (up-filter-distance c: 0 c: 28)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: gold c: 20)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                ) 

                (defrule
                    (goal gl-build-first-mining-camp YES)
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-get-object-data object-data-distance gl-temp50)
                    (up-modify-goal gl-temp50 c:+ 4)
                    (up-remove-objects search-remote object-data-distance g:> gl-temp50)
                )

                (defrule
                    (goal gl-build-first-mining-camp YES)
                    (up-set-target-object search-remote c: 0)
