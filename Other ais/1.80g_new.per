                         (up-find-remote c: monk c: 40)(up-filter-include cmdid-military -1 -1 -1)   (up-find-remote c: all-units-class c: 240)
                    )

                    (defrule
                        (up-compare-sn sn-focus-player-number < 8)
                        =>
                        (up-modify-sn sn-focus-player-number c:+ 1)
                        (up-jump-rule -2)
                    )

                    (defrule
                        (true)
                        =>
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (food-amount < 260)
                        (gold-amount >= 75)
                        (up-compare-goal gl-remote-total g:> gl-local-total)
                        (up-pending-objects c: knight-line < 5)
                        (game-time >= 1100)
                        =>
                        (set-goal gl-temp 1)
