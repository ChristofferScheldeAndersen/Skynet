    ; Sheep
            

            (defrule
                (game-time > 5)
                (game-time > 5) =>
                (set-goal sheeps 0)
                (disable-self)
            )
            

            (defrule
                (true)
                (game-time > 5) =>
            (enable-timer sheep-timer 15)
            (disable-self)
            )


            (defrule
                (game-time > 5)
                (goal sheeps 0)
                (unit-type-count 958 > 0)
            (game-time > 5) =>
                (up-reset-search 1 1 1 1)
                (up-reset-filters)
                (up-find-local c: 958 c: 10); Find all sheep
                (up-set-target-object search-local c: 0)
                (up-get-point position-self point-x)
                ;(up-modify-goal point-x c:+ 6)
                ;(up-modify-goal point-y c:- 6)
                (up-target-point point-x action-default -1 -1); set target tile to send them to
                (set-goal sheeps 2))
            ;====================================================
            ; Find one sheep and send to TC

            (defrule
                (goal sheeps 2)
                (unit-type-count 958 > 0)
            (game-time > 5) =>
                (up-reset-search 1 1 1 1)
                (up-reset-filters)
                (up-find-local c: 958 c: 1); Select one sheep
            (up-get-object-data object-data-id dead-sheep-id); store its unique ID
            (up-set-target-by-id g: dead-sheep-id)
                (up-get-point position-self point-x)
                (up-modify-goal point-x c:- 1)
                (up-modify-goal point-y c:+ 1)
                (up-target-point point-x action-default -1 -1)
                (set-goal sheeps 3))
            
            ;====================================================
            ; Check if sheep is half eaten and reset loop

            (defrule
                (goal sheeps 3)
                (unit-type-count 958 > 0)
            (up-set-target-by-id g: dead-sheep-id); Set the unique ID as the target
                (or(up-object-data object-data-carry < 40); Check it for food amount
                (and(game-time > 60)
                (and(unit-type-count MALE-SHEPHERD == 0)
                (and(unit-type-count FEMALE-SHEPHERD == 0)
                (and(unit-type-count MALE-HUNTER < 4)
                (unit-type-count FEMALE-HUNTER < 4))))))
            (game-time > 5) =>
                (set-goal sheeps 0); Reset
                )

            (defrule
                (timer-triggered sheep-timer)
                (goal sheeps 3)
                (game-time < 420)
                    (game-time > 5) =>
                (disable-timer sheep-timer)
                ;(set-goal sheeps 0)
                (enable-timer sheep-timer 15)
                (up-reset-search 1 1 1 1)
                (up-reset-filters)
                (up-filter-distance c: 7 c: 35)
                (up-find-local c: 958 c: 10); Find all sheep
                (up-set-target-object search-local c: 0)
                (up-get-point position-self point-x)
                ;(up-modify-goal point-x c:+ 6)
                ;(up-modify-goal point-y c:- 6)
                (up-target-point point-x action-default -1 -1); set target tile to send them to
            ;	;(chat-to-all "sheep-timer")
            )

            (defrule
                    (game-time < 9) ; lavet som fors�g p� at stoppe at deer kommer t�t p� tc til at starte med
                    (game-time > 5)
                    (game-time > 5) =>
                
                (up-reset-search 1 1 1 1)
                (up-reset-filters)
                (up-filter-distance c: 0 c: 35)
                (up-find-local c: 958 c: 10); Find all sheep
                (up-set-target-object search-local c: 0)
                (up-get-point position-self point-x)
                ;(up-modify-goal point-x c:+ 6)
                ;(up-modify-goal point-y c:- 6)
                (up-target-point point-x action-default -1 -1); set target tile to send them to
            )



            (defrule
                (dropsite-min-distance live-boar < 6)
                (not(and(up-remaining-boar-amount >= 100)
