        (defrule
            (food-amount >= 400)
            (current-age == dark-age)
            (up-research-status c: feudal-age != research-pending)
            =>
            (set-strategic-number sn-enable-training-queue 0)
        )

        (defrule
            (food-amount >= 625)
            (gold-amount >= 175)
            (can-afford-research castle-age)
            (current-age == feudal-age)
            (up-research-status c: castle-age != research-pending)
            =>
            (set-strategic-number sn-enable-training-queue 0)
        )

        (defrule
            (food-amount >= 750)
            (gold-amount >= 700)
            (can-afford-research imperial-age)
            (current-age == castle-age)
            (up-research-status c: imperial-age != research-pending)
            =>
            (set-strategic-number sn-enable-training-queue 0)
        )

        #end-if
        
        (defrule
            (true)
            =>
            (set-strategic-number sn-number-tasked-units 60)
            (disable-self)
        )
        #load-if-not-defined DE-AVAILABLE
        (defrule
            (true)
            =>
            (set-strategic-number sn-mill-max-distance 35)
            (disable-self)
        )
        #end-if
        (defrule
            (taunt-detected my-player-number 147)
            =>
            (set-strategic-number sn-number-tasked-units 0)
        )
        
    ;
        (defrule
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 351 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration 1: %d" g: 181)
                )
    ; split rule goal reset
        (defrule
            (true)
            =>
            (set-goal gl-split-rule 0)
        )
    ;
        (defrule
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 352 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration 1: %d" g: 181)
                )
    ; Agresiv retasking det første af fase 4 forhindres. (safe)

            (defrule
                (unit-type-count villager g:== gl-local-total)
                =>
                (disable-self);stop resten
            )
            ; 3 Hvis nej tjekkes alle vills igennem for om de har ændret target. Hvis nej sker der ikke noget. Hvis ja undersøges
            ; om deres tidligere target stadig kan targetes. Hvis ja sendes de tilbage til dette target.

            (defrule
                (current-age == castle-age)
                =>
                (disable-timer stop-retasking-timer)
                (disable-self)
            )

            (defrule ;kører én gang
            ;(game-time < 60)
            (game-time > 5)
            (up-compare-goal gl-fase >= 3)
            (up-timer-status stop-retasking-timer == timer-running)
                =>
                (set-goal gl-vill-index-number 0)
            )

            (defrule ;loopes
            (true)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-idling c:== 1)
                (up-remove-objects search-local object-data-index g:>= gl-castle-age-vill-count)
                (up-clean-search search-local object-data-id search-order-asc)
                (up-remove-objects search-local object-data-index g:!= gl-vill-index-number)
            )

            (defrule
                (up-compare-goal gl-vill-index-number == 0)
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-carry == 0)
                (up-object-target-data object-data-base-type != house)
                (up-object-target-data object-data-status != status-pending)
                (up-object-target-data object-data-id g:!= gl-temp1)
                (up-set-target-by-id g: gl-temp1)
                
                =>
                (up-add-object-by-id search-remote g: gl-temp1)
                (up-target-objects 0 action-default -1 -1)
                ;(up-chat-data-to-all "vill with %d. forced back to its original target" g: gl-vill-index-number)
                (disable-self)
            )

