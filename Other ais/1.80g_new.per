                            ;;(chat-to-all "Attempting to place first DUC lumber-camp")
                            (up-copy-point gl-first-mining-camp-location-x gl-mining-camp-location-x)
                            (up-modify-goal gl-mining-camp-location-x c:= -1)
                            ;(chat-to-all "trying to place mining camp")
