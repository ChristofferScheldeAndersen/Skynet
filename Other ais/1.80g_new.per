                    (players-unit-type-count target-player archer-line  >= 10)
                    (players-unit-type-count target-player knight-line  < 3)
                        =>
                (up-modify-goal gl-MILITARY-SUPERIORITY c:+ 10)
                )

                (defrule
                (timer-triggered Military-Superiority-timer)
                (unit-type-count skirmisher-line >= 10)
                    (players-unit-type-count target-player archer-line  >= 10)
                    (players-unit-type-count target-player knight-line  < 3)
                        =>
                ;(chat-to-all "Countering opponent with skirmishers +10")
                (do-nothing)
                )

                (defrule
                (unit-type-count knight-line >= 2)
                    (players-unit-type-count target-player skirmisher-line  >= 5)
                    (players-unit-type-count target-player skirmisher-line  < 15)
                    (players-unit-type-count target-player spearman-line  < 2)
                        =>
                (up-modify-goal gl-MILITARY-SUPERIORITY c:+ 5)
                )

                (defrule
                (timer-triggered Military-Superiority-timer)
                (unit-type-count knight-line >= 3)
                    (players-unit-type-count target-player skirmisher-line  >= 5)
                    (players-unit-type-count target-player skirmisher-line  < 15)
                    (players-unit-type-count target-player spearman-line  < 2)
                    =>
                ;(chat-to-all "Countering opponent with knights +5")
                (do-nothing)
                )

                (defrule
                (timer-triggered Military-Superiority-timer)
                (unit-type-count spearman-line == 1)
                    (players-unit-type-count target-player scout-cavalry-line > 1)
                        =>
                ;(chat-to-all "Countering scoutrush with spearmen +1")
