                    (up-set-target-point gl-temp2-x)
                    (up-remove-objects search-remote object-data-distance <= 10)
                    (up-set-target-point gl-temp3-x)
                    (up-remove-objects search-remote object-data-distance <= 10)
                    (up-set-target-point gl-temp4-x)
