        ;E Wood (safe)
            ;Decide when to build second lumber camp
                (defrule
                    (true)
                    =>
                    (set-goal gl-build-lc -1)
                )
                
                (defrule
                        (unit-type-count villager >= 19)
                        (building-type-count-total lumber-camp == 1)
                        (wood-amount >= 100)
                        ;(up-compare-goal gl-building-system == build-line-system)
                        =>
                        (set-goal gl-build-lc YES)
                        ;(chat-to-all "initiate building of second lc")
                        ;(disable-self)
                    )
 
            ;Send builders to second lumber camp
                (defrule
                    (up-compare-goal gl-second-lumber-camp-location-x != -1)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != second-tree-group)
                    (up-set-target-point gl-second-lumber-camp-location-x)
                    (up-clean-search search-local object-data-distance search-order-asc)
                )

                (defrule
                    (up-compare-goal gl-second-lumber-camp-location-x != -1)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-object-data object-data-id gl-second-lc-vill)
                    (disable-self)
                )

                (defrule
                (up-compare-goal gl-second-lc-vill != -1)
                    (building-type-count lumber-camp == 1)
                    (up-pending-objects c: lumber-camp == 1)
                    ;(unit-type-count villager >= 21)
                =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-second-lc-vill)
                    (set-strategic-number sn-focus-player-number my-player-number)
                    (up-filter-status c: status-pending c: list-active)
                    (up-find-status-remote c: lumber-camp c: 1)
                    (up-remove-objects search-remote object-data-tasks-count > 0)
                    (up-target-objects 0 action-default -1 -1)
                    ;;(chat-to-player my-player-number "send builder to second lc")
                    ;(disable-self)
                )

                (defrule
                (up-compare-goal gl-second-lc-vill != -1)
                    (building-type-count lumber-camp == 1)
                    (up-pending-objects c: lumber-camp == 1)
                    ;(unit-type-count villager >= 21)
                =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != second-tree-group)
                    (up-remove-objects search-local object-data-carry != 10)
                    (set-strategic-number sn-focus-player-number my-player-number)
                    (up-filter-status c: status-pending c: list-active)
                    (up-find-status-remote c: lumber-camp c: 1)
                )

                (defrule
                (up-compare-goal gl-second-lc-vill != -1)
                    (building-type-count lumber-camp == 1)
                    (up-pending-objects c: lumber-camp == 1)
                    ;(unit-type-count villager >= 21)
                    (up-set-target-object search-local c: 0)
                    (up-set-target-object search-remote c: 0)
                =>
                (up-target-objects 0 action-default -1 -1)
                ;;(chat-to-player my-player-number "send loaded ekstra builder to second lc")
                    ;(disable-self)
                )
        ;F Farms (safe)
            ; Calculating spare wood for farms
                    (defrule
                        (true)
                        =>
                        (up-get-fact wood-amount 0 gl-wood-saved)
                    )
                    
                    (defrule
                        (building-type-count-total barracks > 0)
                        =>
                        (up-modify-goal gl-wood-saved c:+ 175)
                    )

                    (defrule
                        (building-type-count-total archery-range > 1)
                        =>
                        (up-modify-goal gl-wood-saved c:+ 350)
                    )

                    (defrule
                        (or(building-type-count-total blacksmith > 0)
                        (and(goal gl-full-skirm-mode 1)
                        (building-type-count-total farm < 9)))
                        (or(research-completed ri-horse-collar)
                        (wood-amount >= 95))
                        =>
                        (up-modify-goal gl-wood-saved c:+ 150)
                    )

                    (defrule ;build early farms for debugging
                        (true)
                        =>
                        ;(up-modify-goal gl-wood-saved c:+ 200)
                        (do-nothing)
                    )

            ; Count the number of unfinished farms (not build with a working villager)
                    
                    ; på samme måde kan antallet af unfinished farms uafhænigt af attending findes
                    
                    (defrule
                        (true)
                        =>
                        (set-goal gl-unfinished-farms 0)
                    )

                    (defrule
                        (up-compare-goal gl-first-unfinished-farm != -1)
                        =>
                        (up-modify-goal gl-unfinished-farms c:+ 1)
                    ) 

                    (defrule
                        (up-compare-goal gl-second-unfinished-farm != -1)
                        =>
                        (up-modify-goal gl-unfinished-farms c:+ 1)
                    ) 

                    (defrule
                        (up-compare-goal gl-third-unfinished-farm != -1)
                        =>
                        (up-modify-goal gl-unfinished-farms c:+ 1)
                    ) 

                    (defrule
                        (up-compare-goal gl-forth-unfinished-farm != -1)
                        =>
                        (up-modify-goal gl-unfinished-farms c:+ 1)
                    ) 

                    (defrule
                        (up-compare-goal gl-fifth-unfinished-farm != -1)
                        =>
                        (up-modify-goal gl-unfinished-farms c:+ 1)
                    ) 
                
            ; Calculating number available villagers for farming
                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != pre-farming-straggler-group)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-stragglers-and-farmers g:= gl-local-total)
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != farming-group)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-stragglers-and-farmers g:+ gl-local-total)
                    )
            ; Chosing to build the farm
                    
                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp -1)
                    )

                    (defrule
                        
                        (goal gl-full-skirm-mode 1)
                        (or(building-type-count-total farm >= 20)
                        (and(building-type-count-total farm >= 17)
                        (building-type-count-total market < 1)))
                        (goal gl-my-position 5)
                        =>
                        (set-goal gl-temp 1)
                    )

                    (defrule
                        
                        (goal gl-full-skirm-mode 1)
                        (or(building-type-count-total farm >= 17)
                        (and(building-type-count-total farm >= 15)
                        (building-type-count-total market < 1)))
                        (goal gl-my-position 3)
                        =>
                        (set-goal gl-temp 1)
                    )

                    (defrule
                        (building-type-count mill > 0)
                        (up-compare-goal gl-wood-saved >= 735) ;675+60 for en farm ; depends on strategy
                        (up-compare-goal gl-unfinished-farms < 5)
                        (or(building-type-count-total farm g:< gl-stragglers-and-farmers)
                        (and(up-group-size c: pre-farming-straggler-group > 0)
                        (and(game-time > 1500)
                        (building-type-count-total farm < 11))))
                        (goal gl-farm-was-placed-this-pass -1) ; så der ikke bygges en farm for meget 
                        (up-compare-goal gl-building-system == build-line-system)
                        (goal gl-temp -1)
                        =>
                        (set-goal gl-split-rule 112)
                    )

                    (defrule
                        (goal gl-split-rule 112)
                        (not(and(up-research-status c: castle-age < research-pending)
                        (and(building-type-count-total farm >= 11)
                        (goal gl-full-skirm-mode -1))))
                        
                        
                        =>
                        (set-goal gl-build-farm YES)
                        (set-goal gl-farm-check 1) 
                        (up-modify-goal gl-danger-counter c:= 0)
                        
                    )

                    (defrule
                        (taunt-detected my-player-number 78)
                        =>
                        (up-chat-data-to-all "gl-wood-saved is %d" g: gl-wood-saved)
                        (up-chat-data-to-all "gl-unfinished-farms is %d" g: gl-unfinished-farms)
                        (up-chat-data-to-all "gl-stragglers-and-farmers is %d" g: gl-stragglers-and-farmers)
                        (up-chat-data-to-all "gl-farm-was-placed-this-pass is %d" g: gl-farm-was-placed-this-pass)
                        (up-chat-data-to-all "gl-building-system is %d" g: gl-building-system)
                        (up-chat-data-to-all "gl-full-skirm-mode is %d" g: gl-full-skirm-mode)
                        (up-chat-data-to-all "gl-split-rule is %d" g: gl-split-rule)
                        (up-chat-data-to-all "gl-build-farm is %d" g: gl-build-farm)
                        (up-chat-data-to-all "gl-farm-check is %d" g: gl-farm-check)
                        (acknowledge-taunt my-player-number 78)
                    )
                        
                        
            
        ;H Stone (safe)
            ;få vill til at samle 30 stone i feudal

            (defrule
                (up-compare-goal gl-feudal-stone-vill != -1)
                (stone-amount >= 100)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-feudal-stone-vill)
                (up-target-point gl-temp1-x action-stop -1 -1)
                ;(chat-to-all "no more stone is needed for 2. tc. Force stone vill back to wood")
                (set-goal gl-feudal-stone-vill -1)
            )

            (defrule
                (building-type-count-total farm >= 10)
                (up-compare-goal gl-feudal-stone-vill == -1) ;0 vills in stone group
                (stone-amount < 100)
                =>
                (up-full-reset-search)
                (up-get-point position-self gl-temp1-x)
                (up-get-point position-flank gl-temp2-x)
                (up-lerp-tiles gl-temp1 gl-temp2 c: -5)
                (up-set-target-point gl-temp1-x)
                (up-filter-distance c: -1 c: 28) 
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: stone c: 40)
                (up-clean-search search-remote object-data-distance search-order-asc)
            )

            (defrule
                (building-type-count-total farm >= 10)
                (up-compare-goal gl-feudal-stone-vill == -1) ;0 vills in stone group
                (stone-amount < 100)
                (up-set-target-object search-remote c: 0)
                =>
                (set-goal gl-split-rule 113)
            )

            (defrule
                (goal gl-split-rule 113)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-temp1-x)
                (up-find-local c: villager-class c: 200)
                ;fase 1
                (up-remove-objects search-local object-data-group-flag == shepard-group) ;1
                ;(up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
                (up-remove-objects search-local object-data-group-flag == berry-group) ;3
                (up-remove-objects search-local object-data-group-flag == deer-group) ;4
                (up-remove-objects search-local object-data-group-flag == dark-age-straggler-group) ;5 - bliver til gold-mining-group
                        
                ;fase 2
                ;(up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
                (up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
                (up-remove-objects search-local object-data-group-flag == farming-group) ;8
                (up-remove-objects search-local object-data-type == 212) ;builder
                (up-remove-objects search-local object-data-type == 118) ;builder

                (up-remove-objects search-local object-data-carry > 3)
                (up-clean-search search-remote object-data-distance search-order-asc)
            )
                

            (defrule
                (building-type-count-total farm >= 10)
                (up-compare-goal gl-feudal-stone-vill == -1) ;0 vills in stone group
                (stone-amount < 100)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-id gl-feudal-stone-vill)
                ;(chat-to-all "found a vill to mine 30 stone in feudal")
            )

            (defrule
                (up-set-target-by-id g: gl-feudal-stone-vill)
                (up-object-data object-data-type != 220)
                (up-object-data object-data-type != 124)
                =>
                (up-full-reset-search)
                (up-get-point position-self gl-temp1-x)
                (up-get-point position-flank gl-temp2-x)
                (up-lerp-tiles gl-temp1 gl-temp2 c: -5)
                (up-set-target-point gl-temp1-x)
                (up-filter-distance c: -1 c: 28) 
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: stone c: 40)
                (up-clean-search search-remote object-data-distance search-order-asc)
            )

            (defrule
                (up-set-target-by-id g: gl-feudal-stone-vill)
                (up-object-data object-data-type != 220)
                (up-object-data object-data-type != 124)
                (not(up-set-target-object search-remote c: 0))
                =>
                (set-goal gl-feudal-stone-vill -1)
            )

            (defrule
                (not(up-set-target-by-id g: gl-feudal-stone-vill))
                =>
                (set-goal gl-feudal-stone-vill -1)
            )

            (defrule
                (up-set-target-by-id g: gl-feudal-stone-vill)
                (up-object-data object-data-type != 220) ;stone miners
                (up-object-data object-data-type != 124)
                (up-object-data object-data-type != 118) ;builders
                (up-object-data object-data-type != 212)
                =>
                (up-add-object-by-id search-local g: gl-feudal-stone-vill)
                (up-target-objects 0 action-default -1 -1)
                ;(chat-to-all "forcing feudal stone vill on stone")
            )

        
        ;K Upgrades (safe)
            (defrule
                (building-type-count-total archery-range >= 2)
                (can-research ri-horse-collar)
                =>
                (research ri-horse-collar)
            )

            (defrule
                (up-compare-goal gl-age-status >= advancing-to-castle)
            (not(research-available castle-age))
            (not(research-available ri-horse-collar))
                =>
                (research ri-gold-mining)
            )

            (defrule
                (up-compare-goal gl-age-status >= advancing-to-castle)
            (not(research-available castle-age))
            (not(research-available ri-gold-mining))
            (up-players-in-game ally <= 1)
            (game-time > 9999) ;midlertidigt fjernet
                =>
                ;(research ri-scale-barding)
                (do-nothing)
            )
        ;I Millitary production (safe)
            ;sæt range gather points
                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: archery-range c: 200)
                    (up-get-point position-self gl-temp-x)
                    (up-target-point gl-temp-x action-gather -1 -1)
                )
            ;køb wood-upgrade, archers og archer up-grades
                (defrule
                    (building-type-count-total archery-range >= 2)
                    =>
                    (research ri-double-bit-axe)
                )

                (defrule
                    (or(unit-type-count-total archer-line >= 3)
                    (unit-type-count-total skirmisher-line >= 3))
                    (not(and(gold-amount < 250)
                    (food-amount >= 800)))
                    (can-research ri-fletching)

                    =>
                    (research ri-fletching)
                )

                (defrule
                    (can-research ri-padded-archer-armor)
                    (or(and(goal gl-age-status advancing-to-castle)
                    (unit-type-count-total archer-line > 8))
                    (and(goal gl-age-status feudal)
                    (unit-type-count-total skirmisher-line >= 3)))
                    (or(goal gl-age-status advancing-to-castle)
                    (up-compare-goal gl-full-skirm-mode != 1))

                    =>
                    (research ri-padded-archer-armor)
                )

                

                (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: town-center c: 1)
                (set-goal gl-temp 0)
                )

                (defrule
                    (up-set-target-object search-local c: 0)
                    (up-object-data object-data-progress-type == 103) ;research
                    =>
                    (up-get-object-data object-data-progress-value gl-temp)
                )
                (defrule
                (current-age == feudal-age)
                    =>
                    (set-goal gl-temp1 0)
                    (set-goal gl-temp2 0)
                    (set-goal gl-temp3 0)
                    (set-goal gl-temp4 0)
                    (set-goal gl-temp5 0)
                    (up-get-player-fact target-player unit-type-count archer-line gl-temp1)
                    (up-get-player-fact target-player unit-type-count skirmisher-line gl-temp2)
                    (up-get-fact unit-type-count-total archer-line gl-temp3)
                    (up-get-fact unit-type-count-total skirmisher-line gl-temp4)
                    (up-modify-goal gl-temp2 c:* 2)
                    (up-modify-goal gl-temp4 c:* 2)
                    (up-modify-goal gl-temp5 g:= gl-temp1)
                    (up-modify-goal gl-temp5 g:+ gl-temp2)
                    (up-modify-goal gl-temp5 g:- gl-temp3)
                    (up-modify-goal gl-temp5 g:- gl-temp4)
                )

                (defrule ; defend with archer armor early if needed
                (not(and(gold-amount < 245)
                    (food-amount >= 600)))
                    (not(food-amount >= 600))
                (current-age == feudal-age)
                    ;(up-compare-goal gl-temp5 > 8)
                    (can-research ri-padded-archer-armor)
                    (unit-type-count-total archer-line >= 4)
                    (research-completed ri-fletching)
                    (or(goal gl-age-status advancing-to-castle)
                    (up-compare-goal gl-full-skirm-mode != 1))
                    =>
                    (research ri-padded-archer-armor)
                )

                (defrule
                    (true)
                    =>
                    (set-goal gl-temp20 -1)
                    (set-goal gl-temp21 -1)
                )

            ;skirm building rules



                (defrule
                    (or(and(up-pending-objects c: skirmisher-line < 2)
                    (up-pending-objects c: archer-line < 1))
                    (and(up-pending-objects c: skirmisher-line < 1)
                    (up-pending-objects c: archer-line < 2)))
                    ;(or(food-amount < 25)
                    ;(wood-amount < 35))
                    (not(and(gold-amount < 95)
                    (and(up-research-status c: ri-fletching != research-pending)
                    (up-research-status c: ri-fletching != research-complete))))
                    =>
                    (set-goal gl-temp20 1)
                )

                (defrule
                    (not(and(building-type-count blacksmith > 0)
                    (and(research-available ri-fletching)
                    (and(food-amount < 125)
                    (unit-type-count-total skirmisher-line >= 4)))))
                    (or(unit-type-count-total skirmisher-line < 15)
                    (up-compare-goal gl-my-position != 4))
                    =>
                    (set-goal gl-split-rule 114)
                )

                (defrule
                    (goal gl-split-rule 114)
                    (not(and(up-research-status c: castle-age == research-pending)
                    (up-compare-goal gl-temp > 50))); stop skirmisher produktion når du er halvejs til castle age
                    (or(building-type-count-total archery-range > 1)
                    (up-pending-objects c: skirmisher-line == 0))
                    (goal gl-full-skirm-mode 1)
                    (or(up-research-status c: ri-wheel-barrow == research-pending)
                    (or(up-pending-objects c: villager >= 2)
                    (food-amount > 75)))
                    (unit-type-count-total skirmisher-line < 30)
                    =>
                    (set-goal gl-temp21 1)
                )

                (defrule
                            (true)
                            =>
                            (set-goal gl-temp14 0)
                        )
                        
                        (defrule
                            (true)
                            =>
                            (up-copy-point gl-temp-x gl-ranged-army-x)
                            (up-modify-goal gl-temp-x c:/ 100)
                            (up-modify-goal gl-temp-y c:/ 100)
                            (up-full-reset-search)
                            (up-find-local c: archer-line c: 200)
                            (up-remove-objects search-local object-data-group-flag != archer-group)
                            (up-get-search-state gl-local-total)
                            (up-modify-goal gl-temp45 g:= gl-local-total)
                            (up-full-reset-search)
                            (up-find-local c: skirmisher-line c: 200)
                            (up-remove-objects search-local object-data-group-flag != archer-group)
                            (up-get-search-state gl-local-total)
                            (up-modify-goal gl-local-total g:+ gl-temp45)
                        )

                        (defrule
                            (up-compare-goal gl-found-enemy == 1)
                            (up-point-distance gl-temp-x gl-enemy-x < 35)
                            (players-military-population target-player <= 1)
                            (players-unit-type-count target-player mangonel-line == 0)
                            (players-unit-type-count target-player scorpion-line <= 1)
                            (or(players-unit-type-count target-player knight-line == 0)
                            (and(players-unit-type-count target-player knight-line <= 1)
                            (or(up-compare-goal gl-temp45 > 8)
                            (up-compare-goal gl-temp45 > 15))))
                            =>
                            (set-goal gl-temp14 15)
                        )
                    

                (defrule
                    (not(and(gold-amount < 245)
                    (food-amount >= 600)))
                    (not(food-amount >= 600))
                    (can-train skirmisher-line)
                    (up-pending-objects c: skirmisher-line < 4)
                    (or(up-research-status c: ri-fletching >= research-pending)
                    (or(up-pending-objects c: skirmisher-line < 2)
                    (or(building-type-count-total blacksmith < 1)
                    (food-amount >= 125))))
                    =>
                    (set-goal gl-split-rule 115)
                )

                (defrule
                    (goal gl-split-rule 115)
                    (goal gl-temp21 1)
                    (or(building-type-count-total farm < 19)
                    (unit-type-count-total villager-gold < 5))
                    (not(and(up-compare-goal gl-group-superiority > 10)
                    (and(up-research-status c: castle-age != research-pending)
                    (building-type-count market > 0))))
                    
                    
                    =>
                    (set-goal gl-split-rule 1014)
                )

                (defrule
                    (gold-amount > 300)
                    (food-amount < 500)
                    (current-age == feudal-age)
                    (up-research-status c: castle-age != research-pending)
                    (building-type-count-total market == 0)
                    (or(research-completed ri-fletching)
                    (up-research-status c: ri-fletching == research-pending))
                    =>
                    (set-goal gl-split-rule  -1)
                )

                (defrule
                    (goal gl-split-rule 1014)
                    
                    (not(or(and(up-compare-goal gl-group-superiority > 19)
                    (up-compare-goal gl-temp14 == 0))
                    (up-compare-goal gl-group-superiority > 34)))
                    
                    =>
                    (train skirmisher-line)
                    (up-jump-rule 4)
                )





                (defrule
                    (true)
                    =>
                    (up-get-fact unit-type-count-total skirmisher-line gl-temp1)
                    (up-get-player-fact target-player unit-type-count-total skirmisher-line gl-temp2)
                    (up-modify-goal gl-temp3 g:= gl-temp1)
                    (up-modify-goal gl-temp3 g:- gl-temp2)
                    
                    (set-goal gl-temp4 160) ;seconds to castle age
                    (set-goal gl-temp5 100)
                    (up-modify-goal gl-temp5 g:- gl-temp) ;percent needed before castle age
                    (up-modify-goal gl-temp4 g:* gl-temp5)
                    (up-modify-goal gl-temp4 c:/ 100) ;gl-temp4 is seconds to castle age.
                )

                (defrule
                    (true)
                    =>
                    (up-modify-goal gl-temp8 g:= gl-temp4)
                    (up-get-fact unit-type-count-total villager-food gl-temp9)
                    (up-modify-goal gl-temp8 g:* gl-temp9)
                    (up-modify-goal gl-temp8 c:/ 3) ;gl-temp8 is the expected gathered food from now untill castle age
                    (up-get-fact food-amount 0 gl-temp5)
                    (up-modify-goal gl-temp5 g:+ gl-temp8) ;total expected food upon reaching castle age.

                    (up-modify-goal gl-temp8 g:= gl-temp4)
                    (up-get-fact unit-type-count-total villager-wood gl-temp9)
                    (up-modify-goal gl-temp8 g:* gl-temp9)
                    (up-modify-goal gl-temp8 c:/ 3) ;gl-temp8 is the expected gathered wood from now untill castle age
                    (up-get-fact wood-amount 0 gl-temp6)
                    (up-modify-goal gl-temp6 g:+ gl-temp8) ;total expected wood upon reaching castle age.

                    (up-modify-goal gl-temp8 g:= gl-temp4)
                    (up-get-fact unit-type-count-total villager-gold gl-temp9)
                    (up-modify-goal gl-temp8 g:* gl-temp9)
                    (up-modify-goal gl-temp8 c:/ 3) ;gl-temp8 is the expected gathered gold from now untill castle age
                    (up-get-fact gold-amount 0 gl-temp7)
                    (up-modify-goal gl-temp7 g:+ gl-temp8) ;total expected gold upon reaching castle age.
                )

                (defrule
                    (taunt-detected my-player-number 233)
                    =>
                    (up-chat-data-to-all "expecting %d food upon reaching castle age" g: gl-temp5)
                    (up-chat-data-to-all "expecting %d wood upon reaching castle age" g: gl-temp6)
                    (up-chat-data-to-all "expecting %d gold upon reaching castle age" g: gl-temp7)
                    (up-chat-data-to-all "we have %d skirms" g: gl-temp1)
                    (up-chat-data-to-all "enemy has %d skirms" g: gl-temp2)
                    (up-chat-data-to-all "we have %d skirms more than enemy" g: gl-temp3)
                    (acknowledge-taunt my-player-number 233)
                )

                (defrule
                    (up-compare-goal gl-full-skirm-mode == 1)
                    (up-compare-goal gl-number-of-players-on-my-team <= 2)
                    (up-research-status c: castle-age >= research-pending)
                    (players-current-age target-player < castle-age)
                    (players-building-type-count target-player stable == 0)
                    (players-unit-type-count target-player scout-cavalry-line <= 1)
                    (players-unit-type-count target-player eagle-warrior-line <= 1)
                    (players-unit-type-count target-player camel-line <= 1)
                    (up-pending-objects c: skirmisher-line < 2)
                    (up-compare-goal gl-temp1 > 0) ;Rehoboam har skirms allerede.
                    (up-compare-goal gl-temp2 > 5) ;Modstanderen har over 5 skirms.
                    (up-compare-goal gl-temp3 < 10) ;vi har mindre end 10 skirms flere end modstanderen.
                    (up-compare-goal gl-temp5 > 500) ;total expected food
                    (up-compare-goal gl-temp6 > 500) ;total expected wood
                    (not(and(up-compare-goal gl-temp > 85)
                    (up-pending-objects c: skirmisher-line > 0)))
                    (can-train skirmisher-line)
                    =>
                    (train skirmisher-line)
                )

                    
            ;archer building rules
                (defrule
                    (not(and(gold-amount < 245)
                    (food-amount >= 600)))
                    (not(food-amount >= 600))
                    (can-train archer-line)
                    
                    =>
                    (set-goal gl-split-rule 11600)
                )

                (defrule
                (goal gl-split-rule 11600)
                    
                    (up-pending-objects c: archer-line < 4)
                    (or(up-research-status c: ri-fletching >= research-pending)
                    (or(and(up-pending-objects c: archer-line < 4)
                    (players-unit-type-count target-player militiaman-line > 1))
                    (or(building-type-count-total blacksmith < 1)
                    (gold-amount >= 95))))
                    =>
                    (set-goal gl-split-rule 116)
                )

                (defrule
                    (goal gl-split-rule 116)
                    (not(and(research-available ri-fletching)
                    (and(gold-amount < 95)
                    (unit-type-count-total archer-line >= 4))))
                    (not(and(up-compare-goal gl-age-status == advancing-to-castle)
                    (up-compare-goal gl-temp > 50))); stop archer produktion når du er halvejs til castle age
                    (or(building-type-count-total archery-range > 1)
                    (up-pending-objects c: archer-line == 0))
                    
                    =>
                    (set-goal gl-split-rule 117)
                )

                (defrule
                    (goal gl-split-rule 117)
                    (or(goal gl-full-skirm-mode -1)
                    (or(goal gl-temp20 1)
                    (building-type-count-total farm >= 19)))
                    (not(and(up-compare-goal gl-group-superiority > 10)
                    (and(up-research-status c: castle-age != research-pending)
                    (building-type-count market > 0))))
                    =>
                    (set-goal gl-split-rule 1015)
                )

                (defrule
                    (goal gl-split-rule 1015)
                    (not(and(up-research-status c: castle-age != research-pending)
                    (or(and(up-compare-goal gl-group-superiority > 12)
                    (and(up-compare-goal gl-group-superiority < 900)
                    (up-compare-goal gl-temp14 == 0)))
                    (and(up-compare-goal gl-group-superiority < 900)
                    (up-compare-goal gl-group-superiority > 27)))))
                    =>
                    (train archer-line)
                )

                (defrule
                    (true)
                    =>
                    ;(up-chat-data-to-all "gl-group-superiority is %d" g: gl-group-superiority)
                    ;(up-chat-data-to-all "gl-temp14 is %d" g: gl-temp14)
                    ;(up-chat-data-to-all "gl-temp20 is %d" g: gl-temp20)
                    ;(up-chat-data-to-all "gl-full-skirm-mode is %d" g: gl-full-skirm-mode)
                    ;(up-chat-data-to-all "gl-age-status is %d" g: gl-age-status)
                    ;(up-chat-data-to-all "gl-temp is %d" g: gl-temp)
                    (do-nothing)
                )

            ;train spearmen        
                (defrule
                    (true)
                    =>
                    (set-strategic-number sn-focus-player-number 1)
                    (set-goal gl-temp40 -1)
                )

                (defrule
                    (player-human focus-player)
                    (players-stance focus-player enemy)
                    =>
                    (set-goal gl-temp40 1)
                )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )



                (defrule
                (true)
                (game-time > 5) =>
                (up-full-reset-search)
                (up-get-point position-self gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-filter-distance c: -1 c: 27)
                (set-strategic-number sn-focus-player-number 1)
                (set-goal gl-remote-total 0)
                )

                (defrule
                (players-stance focus-player enemy)
                    (game-time > 5) =>
                    (up-find-remote c: scout-cavalry-line c: 10)
                    (up-get-search-state gl-local-total)
                    )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    (up-compare-goal gl-remote-total < 2)
                    (game-time > 5) =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )

                (defrule
                    (true)
                    =>
                    (set-goal gl-temp -1)
                )

                (defrule
                    (players-building-type-count target-player stable > 0)
                    (players-building-type-count target-player archery-range == 0)
                    (game-time < 900)
                    =>
                    (set-goal gl-temp 1)
                )

                (defrule
                    (or(and(players-building-type-count target-player stable > 0)
                    (game-time < 900))
                    (players-unit-type-count target-player scout-cavalry-line > 1))
                    =>
                    (set-strategic-number sn-target-player-is-going-scouts 1)
                )

                (defrule
                (can-train spearman-line)
                    (or(food-amount >= 85)
                    (and(goal gl-temp40 1)
                    (food-amount >= 35)))
                    (unit-type-count-total spearman-line < 3)
                    (strategic-number sn-target-player-is-going-scouts == 1)
                    (game-time < 870) ;Before 14,5 minuts
                    (game-time > 5) =>
                    (train spearman-line)
                    )

                (defrule
                (can-train spearman-line)
                    (or(food-amount >= 85)
                    (and(goal gl-temp40 1)
                    (food-amount >= 35)))
                    (up-compare-goal gl-remote-total > 2)
                    (unit-type-count-total spearman-line < 1)
                    
                    (current-age < castle-age)
                    (game-time > 5) =>
                    (train spearman-line)
                    ;(chat-to-all "training 1 spear")
                    )

                (defrule
                    (can-train spearman-line)
                    (or(food-amount >= 85)
                    (and(goal gl-temp40 1)
                    (food-amount >= 35)))
                    (or(up-compare-goal gl-remote-total > 3)
                    (goal gl-temp 1))
                    (unit-type-count-total spearman-line < 2)
                    
                (current-age < castle-age)
                    (game-time > 5) =>
                    (train spearman-line)
                    ;(chat-to-all "training 2 spear")
                )

                (defrule
                (can-train spearman-line)
                    (or(food-amount >= 85)
                    (and(goal gl-temp40 1)
                    (food-amount >= 35)))
                    (up-compare-goal gl-remote-total > 5)
                    (unit-type-count-total spearman-line < 3)
                (current-age < castle-age)
                    (game-time > 5) =>
                    (train spearman-line)
                    ;(chat-to-all "training 3 spear")
                )

        ;J Millitary upgrades (safe)
        ;
        ; debug
            (defrule
                (game-time > 5)
                =>
                ;(chat-to-all "balanced archer-skirm rush is active")
                (disable-self)
            )
        ;
        ; Skipping other strategies and fase 3
            (defrule
            (up-compare-goal gl-strategy == balanced-archer-skirm-rush)
            (up-compare-goal gl-end-of-script-rule != -1)
            =>
            (up-jump-direct g: gl-end-of-script-rule)
            )
        ;


; Fase 3: (Mostly used for anti trush)
    ; Info
        ; Runs from the start of castle age until the end of the game.
        ; Can also be triggered by gamebreaking errors or events that fase 1+2 cannot deal with.
        ; Fase 3 will differ based on strategy, team position and number of players on the team.
        ; Economy in Fase 3 is controlled by the game's automatic engine with little or no DUC.
        ; Rules in fase 3 only runs if gl-fase is eQual to 3.
            (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 429 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 8 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                )
    ; Skipping fase 3
        (defrule
            (true)
            =>
            (up-get-rule-id gl-fase-three-first-rule)
        )
        
        (defrule
            (up-compare-goal gl-fase != 3)
            (up-compare-goal gl-fase-four-first-rule != -1)
            =>
            (up-jump-direct g: gl-fase-four-first-rule) ; end the pass here
        )

    ;
    
    ; Goals and starting setup
            ; Find player positions to direct and coordinate flank/pocket play (safe)

                ; 1 hver spiller finder ud af om de er flank eller pocket og laver et goal med det
                ; 2 pocket finder ud af hvem der er dens flank ved at søge mellem de to flanks for
                ; den tætteste via player-distance og sætter flankens playernummer som goal.
                ; 3 flanks laver goal for tc-position
                ; 4 pocket laver goal for sin flanks tc-position
                ; 5 pocket bruger det nye goal pair til at retreate når der ikke er units i basen
                
                ; find flank
