                    =>
                    (set-goal gl-fase 4)
                    ;(chat-to-all "Rehoboam is castle age. Entering fase 4")
                )
                #end-if
                #end-if
                #end-if
                #end-if
                #end-if
            ; Starting fase 4 when not under to much preassure in 1v1 and 2v2
                #load-if-not-defined DIFFICULTY-EASIEST
                #load-if-not-defined DIFFICULTY-EASY
                #load-if-not-defined DIFFICULTY-STANDARD
                #load-if-not-defined DIFFICULTY-MODERATE
                #load-if-not-defined DIFFICULTY-HARD
                
                (defrule
                    (current-age >= castle-age)
                    (up-compare-goal gl-fase != 4)
                    (up-compare-goal gl-my-position == solo)
                    ;(or(and(population >= 60)
                    ;(up-compare-goal gl-MILITARY-SUPERIORITY >= 10))
                    ;(or(and(population >= 75)
