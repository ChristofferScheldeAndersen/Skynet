                        (unit-type-count-total villager < 140)
                        (civilian-population < 150)
                        (not(and(goal gl-saving-for-upgrade saving-for-wheel-barrow)
                        (food-amount > 100)))
                        
                        =>
                        (set-goal gl-split-rule 719)
                    )

                    #load-if-defined DE-AVAILABLE
                    (defrule
                        (goal gl-split-rule 719)
