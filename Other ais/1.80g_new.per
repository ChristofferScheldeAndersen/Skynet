                        (up-modify-goal gl-temp6 g:- gl-temp10)
                        (up-get-focus-fact resource-amount wood gl-temp10)
                        (up-modify-goal gl-temp7 c:= 1000)
                        (up-modify-goal gl-temp7 g:- gl-temp10)
                        (up-get-focus-fact resource-amount gold gl-temp10)
                        (up-modify-goal gl-temp8 c:= 1000)
                        (up-modify-goal gl-temp8 g:- gl-temp10)
                        (up-get-focus-fact resource-amount stone gl-temp10)
                        (up-modify-goal gl-temp9 c:= 1000)
                        (up-modify-goal gl-temp9 g:- gl-temp10)
                    )

                    (defrule
                        (up-compare-goal gl-temp2 g:> gl-temp6)
                        (up-compare-goal gl-temp6 > 0)
                        =>
                        (up-modify-goal gl-temp2 g:= gl-temp6)
                    )

                    (defrule
                        (up-compare-goal gl-temp3 g:> gl-temp7)
                        (up-compare-goal gl-temp7 > 0)
                        =>
                        (up-modify-goal gl-temp3 g:= gl-temp7)
                    )

                    (defrule
                        (up-compare-goal gl-temp4 g:> gl-temp8)
                        (up-compare-goal gl-temp8 > 0)
                        =>
                        (up-modify-goal gl-temp4 g:= gl-temp8)
                    )

                    (defrule
                        (up-compare-goal gl-temp5 g:> gl-temp9)
                        (up-compare-goal gl-temp9 > 0)
                        =>
                        (up-modify-goal gl-temp5 g:= gl-temp9)
                    )

                    (defrule
                    (or(and(up-allied-goal focus-player gl-need-food-sling == 1)
                    (players-current-age focus-player == imperial-age))
                    (or(up-allied-resource-amount focus-player food < 400)
                    (and(players-current-age focus-player < imperial-age)
                    (up-allied-resource-amount focus-player food < 1000))))
                    (up-compare-goal gl-temp2 > 0)
                    (or(population > 190)
                    (or(up-research-status c: ri-savar >= research-pending)
                    (or(up-research-status c: ri-paladin >= research-pending)
                    (food-amount > 2000))))
                    =>
                    (set-goal gl-split-rule 710)
                    )

                    (defrule
                        (goal gl-split-rule 710)
                        (or(research-completed ri-banking)
                    (and(food-amount > 1500)
                    (up-research-status c: ri-banking != research-pending)))
                    
                    

                    (players-population focus-player > 20)
                    (players-population focus-player < 175)
                    (not(player-resigned focus-player))
                        =>
                        (up-tribute-to-player focus-player food g: gl-temp2)
                        ;(up-chat-data-to-all "slinging %d food " g: gl-temp2)
                        ;(up-chat-data-to-all "to player %d" s: sn-focus-player-number)
                        (set-goal gl-temp2 0)
                        (set-goal gl-temp1 1)
                    )
                    


                    (defrule
                    (up-compare-goal gl-temp3 > 0)
                    (or(population > 190)
                    (or(up-research-status c: ri-paladin >= research-pending)
                    (or(up-research-status c: ri-savar >= research-pending)
                    (wood-amount > 2000))))
                    (or(research-completed ri-banking)
                    (and(wood-amount > 1500)
                    (up-research-status c: ri-banking != research-pending)))
                    =>
