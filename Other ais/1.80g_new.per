                    (set-goal gl-building-placed-this-pass YES)
                    (up-copy-point gl-final-target-point-x gl-first-lumber-camp-location-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-lerp-tiles gl-final-target-point-x gl-position-self-x c: 3)
                    ;(chat-to-all "build special house2")
                    )
