                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-second-house-builder)
                    (up-set-target-object search-local c: 0)
                    (up-get-point position-object gl-looking-for-sheep2-x)

                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-third-house-builder)
                    (up-set-target-object search-local c: 0)
                    (up-get-point position-object gl-looking-for-sheep3-x)

                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-third-house-builder)
                    (up-lerp-tiles gl-looking-for-sheep3-x gl-looking-for-sheep2-x c: -4)
                    (up-target-point gl-looking-for-sheep3-x action-move -1 -1)
                    (disable-self)
                )

                (defrule
                    (goal gl-sheep-found -1)
                    (game-time >= 2)
                    =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-second-house-builder)
                    (up-set-target-object search-local c: 0)
                    (up-get-point position-object gl-looking-for-sheep2-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-cross-tiles gl-looking-for-sheep2-x gl-position-self-x c: -8)
                    (up-target-point gl-looking-for-sheep2-x action-move -1 -1)

                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-third-house-builder)
                    (up-set-target-object search-local c: 0)
                    (up-get-point position-object gl-looking-for-sheep3-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-cross-tiles gl-looking-for-sheep3-x gl-position-self-x c: -8)
                    (up-target-point gl-looking-for-sheep3-x action-move -1 -1)
                    ;(disable-self)
                )

            ;Starting loop after sheep are found
                (defrule
                (game-time > 0)
                (up-find-local c: livestock-class c: 4)
                =>
                (up-full-reset-search)
                    (up-find-local c: scout-unit c: 1)
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-id gl-scout-id)
                    (up-get-point position-object gl-next-position-scout-x)
                    (up-get-point position-self gl-position-self-x)
                        (up-lerp-tiles gl-next-position-scout-x gl-position-self-x c: -8)
                        ;(up-cross-tiles gl-next-position-scout-x gl-position-self-x c: 5)
                        (up-target-point gl-next-position-scout-x action-move -1 -1)
                    (set-goal gl-scouting-direction clockwise)
                    (set-goal gl-scout-checking-state running)
                    ;;(chat-to-all "found sheep. Starting scouting own base")
                    (disable-self)
                )
            ;Stop base scouting after ressources are found
                (defrule
                    (or(and(up-compare-goal gl-sheep-counter == 8)
                    (and(up-compare-goal gl-boar-counter == 2)
                    (game-time > 240)))
                    (and(game-time > 360)
                    (up-compare-goal gl-boar-counter == 2)))
                    =>
                    (set-goal gl-scout-checking-state stop-scouting-home-base)
                        (disable-self)
                )
        
