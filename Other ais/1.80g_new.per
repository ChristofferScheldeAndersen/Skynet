            (defrule
                (goal gl-temp34 -1)
                (goal gl-dont-ungarrison 1)
                =>
                (set-goal gl-dont-ungarrison -1)
                (up-gather-inside c: town-center c: 0) 
            )







    
    ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 417 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 65 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                )
    ;3 Houses 
        ;A First 2 houses
            ; house villagers ID's og house locations
                

                (defrule
                    (unit-type-count villager >= 3)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-remove-objects search-local object-data-distance <= 3)
                    (up-remove-objects search-local object-data-index != 0)
                )

                (defrule
                (unit-type-count villager >= 3)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-object-data object-data-id gl-first-house-builder)  ; få ID på første house vill
                    (up-get-point position-object gl-first-house-x)             ; læg 1. house position i goal
                    (up-get-point position-self gl-position-self-x)
                    (up-lerp-tiles gl-first-house-x gl-position-self-x c: -1)
                    (disable-self)
                )

                (defrule
                    (unit-type-count villager >= 3)
                    (up-compare-goal gl-first-house-x != -1)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-remove-objects search-local object-data-distance <= 3)
                    (up-set-target-point gl-first-house-x)
                    (up-clean-search search-local object-data-distance search-order-desc)
                    (up-remove-objects search-local object-data-index != 0)
                )

                (defrule
                (unit-type-count villager >= 3)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-object-data object-data-id gl-second-house-builder)  ; få ID på første house vill
                    (up-get-point position-object gl-second-house-x)             ; læg 1. house position i goal
                    (up-get-point position-self gl-position-self-x)
                    (up-lerp-tiles gl-second-house-x gl-position-self-x c: -1)
                    (disable-self)
                )

                

            ; Build first and second house



                ; 2e when prior 5 points have been tested move testing point 1 tile closer to tc.

                    ; Here either x or y koordinate will be changed depending on the quadrant. Each change of the point would add to a 
                    ; temp counter resetting at 4 (starting at 0). When resetting the other koordinate would be moved 1 towards the tc 
                    ; again depending on the quadrant.

                    

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp1 -1)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-danger-counter 0)
                    )

                    (defrule
                        (up-compare-goal gl-first-house-actual-location-x == -1)
                        =>
                        (set-goal gl-cross-testing-counter 0)
                        (disable-self)
                    )

                    (defrule
                        ;(up-pending-objects c: house == 1)
                        ;(goal gl-sheep-found 1)
                        (up-compare-goal gl-first-house-actual-location-x != -1)
                        (up-compare-goal gl-second-house-actual-location-x == -1)
                        =>
                        (set-goal gl-cross-testing-counter 0)
                        (disable-self)
                    )

                    (defrule
                        ;(up-pending-objects c: house == 1)
                        ;(goal gl-sheep-found 1)
                        (up-compare-goal gl-first-house-actual-location-x != -1)
                        (up-compare-goal gl-second-house-actual-location-x == -1)
                        =>
                        (up-copy-point gl-house-testing-spot-x gl-second-house-x)
                        
                    )

                    (defrule
                        (up-compare-goal gl-first-house-actual-location-x == -1)
                        =>
                        (up-copy-point gl-house-testing-spot-x gl-first-house-x)
                    )

                    (defrule ;move down/left
                    (up-compare-goal gl-cross-testing-counter > 0)
                            =>
                    (up-cross-tiles gl-house-testing-spot-x gl-position-self-x g: gl-cross-testing-counter)
                    )


                    (defrule
                        (true)
                        =>
                        (up-modify-goal gl-tiles-checker c:= 1)
                        (up-modify-goal gl-trees-in-the-way c:= 0)
                    )


                    (defrule
                        (up-compare-goal gl-tiles-checker == 2)
                        =>
                        (up-modify-goal gl-house-testing-spot-x c:- 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 3)
                        =>
                        (up-modify-goal gl-house-testing-spot-y c:- 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 4)
                        =>
                        (up-modify-goal gl-house-testing-spot-x c:+ 1)
                    )

                ; 2f each point for trees

                    (defrule
                        ;(up-compare-goal gl-tiles-checker <= 4)
                        ;(up-compare-goal gl-tiles-checker >= 1)
                        (or(up-point-contains gl-house-testing-spot-x c: 915) ; tree
                        (or(up-point-contains gl-house-testing-spot-x c: 66) ; gold
                        (or(up-point-contains gl-house-testing-spot-x c: 907) ; bush
                        (up-point-contains gl-house-testing-spot-x c: 908)))) ; stone
                        (game-time < 5)
                        
                        =>
                        (up-modify-goal gl-trees-in-the-way c:+ 1)
                        ;(up-chat-data-to-all "Tile checker is %d." g: gl-tiles-checker)
                    )

                ; 2g reset to the original tile after checking 4 lumbercamp tiles

                    (defrule        ; reset to staring point
                        (up-compare-goal gl-tiles-checker == 4)
                        =>
                        (up-modify-goal gl-house-testing-spot-y c:+ 1)
                        )

                ; 2h reset loop checking the 4 lumbercamp tiles of the testing tile

                    (defrule
                        (up-compare-goal gl-tiles-checker < 4)
                        (up-compare-goal gl-tiles-checker != -1)
                        =>
                        (up-modify-goal gl-tiles-checker c:+ 1)
                        (up-jump-rule -6)
                        
                    )

                ; 2i add to the counters controlling changing of original testing tile

                    (defrule
                        (up-compare-goal gl-first-house-x != -1)
                        (or(up-compare-goal gl-first-house-actual-location-x == -1)
                        (and(up-compare-goal gl-first-house-actual-location-x != -1)
                        (up-compare-goal gl-second-house-actual-location-x == -1)))
                        (up-compare-goal gl-cross-testing-counter < 10) ; evt 4
                        =>
                        (up-modify-goal gl-cross-testing-counter c:+ 1)
                    )

                    (defrule
                    (game-time < 5)
                        (up-compare-goal gl-trees-in-the-way > 0)
                        (up-compare-goal gl-danger-counter < 200)     ; det virker tilsyneladende så længe det ikke er et loop.
                        =>
                        (up-modify-goal gl-danger-counter c:+ 1)
                        ;(up-chat-data-to-all "gl-trees-in-the-way is %d." g: gl-trees-in-the-way)
                        (up-jump-rule -12)
                    )

                ; 2k save point when no trees are in the way
                    ; when the square checker reaches 4 the loop will stop and the point will be saved


                    (defrule
                        (up-compare-goal gl-trees-in-the-way == 0)
                        (up-compare-goal gl-first-house-actual-location-x == -1) 
                                            =>
                        (up-copy-point gl-first-house-actual-location-x gl-house-testing-spot-x)
                        ;(up-chat-data-to-all "Number of building checks for first house were %d." g: gl-cross-testing-counter)
                        (disable-self)
                    )

                    (defrule
                        (up-compare-goal gl-trees-in-the-way == 0)
                        (up-compare-goal gl-second-house-actual-location-x == -1) 
                        (goal gl-temp1 1)
                        ;(up-pending-objects c: house == 1)
                        ;(goal gl-sheep-found 1)
                            =>
                        (up-copy-point gl-second-house-actual-location-x gl-house-testing-spot-x)
                        ;(up-chat-data-to-all "Number of building checks for second house were %d." g: gl-cross-testing-counter)
                        (disable-self)
                    )

                (defrule ; placer første hus
                    (can-afford-building house)
                    (up-compare-goal gl-first-house-actual-location-x != -1)
                    =>
                    (up-build-line gl-first-house-actual-location-x gl-first-house-actual-location-x c: house)
                )

                (defrule ; placer første hus
                    (can-afford-building house)
                    (up-compare-goal gl-second-house-actual-location-x != -1)
                    =>
                    (up-build-line gl-second-house-actual-location-x gl-second-house-actual-location-x c: house)
                )

                (defrule
                        (up-compare-goal gl-first-house-actual-location-x != -1) 
                        =>
                        (up-jump-rule -20)
                        (set-goal gl-temp1 1)
                        (disable-self)
                    )


                    (defrule
                        (true)
                        =>
                        (up-get-point position-self gl-temp-x)
                        (up-modify-goal gl-temp-x c:- 3)
                        (up-modify-goal gl-temp-y c:- 4)
                        
                    )

                    (defrule
                        (or(up-point-contains gl-temp-x c: 915) ; tree
                        (or(up-point-contains gl-temp-x c: 66) ; gold
                        (or(up-point-contains gl-temp-x c: 907) ; bush
                        (up-point-contains gl-temp-x c: 908)))) ; stone
                        (not(and(up-can-build-line 0 gl-temp-x c: palisade-wall) 
                        (can-afford-building palisade-wall)))
                        =>
                        ;(chat-to-all "found object")
                        (do-nothing)
                    )

                    

            ; build second house



                (defrule 
                    (population-headroom > 0)
                    (housing-headroom < 3)
                    (building-type-count house == 0) ;;;;; total
                    (building-type-count-total house == 1) ;;;;; total
                    (can-build house)
                    (up-compare-goal gl-second-house-actual-location-x != -1)
                    (up-pending-objects c: house == 1)
                =>
                (up-build-line gl-second-house-actual-location-x gl-second-house-actual-location-x c: house)
                ;(chat-to-all "trying to build 2. house 7")
