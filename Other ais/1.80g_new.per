                        (research-completed ri-banking)
                        (players-population focus-player > 40)
                        =>
                        (up-get-fact resource-amount stone gl-temp)
                        (up-tribute-to-player focus-player stone g: gl-temp)
                    )

                    #load-if-defined UP-4-PLAYER-TEAM
                    (defrule
                        (true)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-other-pocket)
                    )
                    #end-if

                    #load-if-defined UP-3-PLAYER-TEAM
                    (defrule
                        (true)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                    )
                    #end-if

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp1 -1)
                        (up-get-fact resource-amount food gl-temp2)
                        (up-modify-goal gl-temp2 c:- 500)
                        (up-get-fact resource-amount wood gl-temp3)
                        (up-modify-goal gl-temp3 c:- 500)
                        (up-get-fact resource-amount gold gl-temp4)
                        (up-modify-goal gl-temp4 c:- 500)
                        (up-get-fact resource-amount stone gl-temp5)
                        (up-modify-goal gl-temp5 c:- 500)
                        
                    )

                    (defrule
                        (true)
                        =>
                        
                        (up-get-focus-fact resource-amount food gl-temp10)
