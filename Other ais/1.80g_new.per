                    (up-research-status c: ri-savar < research-pending)
                    (or(research-available ri-paladin)
                    (research-available ri-savar))
                    (gold-amount < 750)
                    (current-age == imperial-age)
                    =>
                    (set-goal gl-need-gold-sling 1)
                )

            ;Imperial sling

                    (defrule
                        (true)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                    )

                    (defrule
                        (building-type-count-total castle >= 1)
                        (building-type-count-total town-center >= 3)
