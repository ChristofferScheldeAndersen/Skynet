                    (up-find-remote c: town-center c: 1)
                    (up-set-target-object search-remote c: 0)
                    (up-get-point position-object gl-temp-x)
                    (up-get-point-distance gl-temp-x gl-non-changing-position-self-x gl-pocket-ally1-distance)
                    (up-modify-goal gl-ally1-player-number s:= sn-focus-player-number)
                    ;;(up-send-flare gl-temp-x)
                    ;search for ally TCs
                    ;store distance in gl-flank-ally1-distance
                    )

                    ;(defrule
                    ;  (up-set-target-object search-remote c: 0)
                    ;  =>
                    ;;(chat-to-all "found something")
                    ;)

                    (defrule
                    (goal gl-mypocket 0)
                    (strategic-number sn-focus-player-number < 8)
                    (true)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -4)
                    )


                    (defrule
                    (up-compare-goal gl-pocket-ally1-distance != -1)
                    (up-compare-goal gl-pocket-ally2-distance != -1)
                    (not(and(up-compare-goal gl-mypocket <= 8)
                    (up-compare-goal gl-mypocket >= 1)))
                        (up-compare-goal gl-pocket-ally1-distance g:> gl-pocket-ally2-distance)
                        (true)
                        =>
                        (up-modify-goal gl-mypocket g:= gl-ally2-player-number) 
                    )

                    (defrule
                    (up-compare-goal gl-pocket-ally1-distance != -1)
                    (up-compare-goal gl-pocket-ally2-distance != -1)
                    (not(and(up-compare-goal gl-mypocket <= 8)
                    (up-compare-goal gl-mypocket >= 1)))
                    (up-compare-goal gl-pocket-ally2-distance g:> gl-pocket-ally1-distance)
                    (true)
                    =>
                        (up-modify-goal gl-mypocket g:= gl-ally1-player-number) 
                    )

                    (defrule
                    (true)
                    =>
                    (enable-timer ally-info-timer 60)
                            (disable-self)
                    )

                    (defrule
                    (timer-triggered ally-info-timer)
                    (true)
                            =>
                    (disable-timer ally-info-timer)
                    (enable-timer ally-info-timer 60)
                    ;;(up-chat-data-to-all "Ally 1 is player %d." g: gl-ally1-player-number)
                    ;;(up-chat-data-to-all "Ally 1 position is %d." g: gl-ally1-position)
                    ;;(up-chat-data-to-all "Ally 2 is player %d." g: gl-ally2-player-number)
                    ;;(up-chat-data-to-all "Ally 2 position is %d." g: gl-ally2-position)
                    ;;(up-chat-data-to-all "Ally 3 is player %d." g: gl-ally3-player-number)
                    ;  ;(up-chat-data-to-all "Ally 3 position is %d." g: gl-ally3-position)
                        ;;(up-chat-data-to-all "Distance to first pocket is %d." g: gl-pocket-ally1-distance)
                        ;;(up-chat-data-to-all "Distance to second pocket is %d." g: gl-pocket-ally2-distance)
                    ;;(up-chat-data-to-all "My position is %d." g: gl-position)
                    ;;(up-chat-data-to-all "My pocket is player %d." g: gl-mypocket)
                    (disable-self)
                    )

                    #end-if



                ; flanks finder koordinater på deres pockets
                    #load-if-not-defined UP-POCKET-POSITION

                    (defrule
                        (game-time > 10)
                    =>
                    (up-modify-sn sn-focus-player-number g:= gl-mypocket)
                    (up-reset-search 1 1 1 1)
                        (up-reset-filters)
                        ;(up-filter-distance c: 0 c: 200)
                    (up-find-remote c: town-center c: 1)
                    (up-set-target-object search-remote c: 0)
                    (up-get-point position-object gl-position-mypocket-x)
                    ; ;(up-send-flare gl-position-mypocket-x)
                        (disable-self)
                    )

                    #end-if
        
        
        ; Setting fase 3 strategic numbers and more fase 3 stuff

                ;******************************************************************************
                ;
                ; Assignments of villagers and scout
                ;
                ;******************************************************************************

                (defrule ;gather point reset
                    (game-time > 5)
                    =>
                    (up-full-reset-search)
                    (up-gather-inside c: town-center c: 0)
                )

                (defrule
                    (game-time > 5)
                    =>
                    (set-strategic-number sn-cap-civilian-gatherers -1); these are reset after starting fase 3
                    (set-strategic-number sn-disable-villager-garrison 0);
                    (set-strategic-number sn-mining-camp-max-distance 0);
                    (set-strategic-number sn-disable-builder-assistance 0);
                    (set-strategic-number sn-allow-civilian-defense 1);
                    (disable-self)
                )

                (defrule
                    (game-time > 5)
                    =>
                    
                (set-strategic-number sn-gold-dropsite-distance 1)
                ;(set-strategic-number sn-stone-dropsite-distance 30)
                    (set-strategic-number sn-food-dropsite-distance 1)
                (set-strategic-number sn-town-center-placement lumber-camp)
                (set-strategic-number sn-initial-exploration-required 0)
                )

                (defrule
                    (game-time > 480)
                    =>
                    (set-strategic-number sn-food-dropsite-distance 5)
                )

                (defrule
                (not(sheep-and-forage-too-far))
                (game-time > 5)
                =>
                (set-strategic-number sn-percent-civilian-explorers 0)
                (set-strategic-number sn-minimum-civilian-explorers 0)
                (set-strategic-number sn-cap-civilian-explorers 0)
                (set-strategic-number sn-total-number-explorers 1)
                (set-strategic-number sn-number-explore-groups 1)
                (set-strategic-number sn-percent-civilian-gatherers 0)
                (set-strategic-number sn-percent-civilian-builders 100)
                (set-strategic-number sn-food-dropsite-distance -1)
                (set-strategic-number sn-wood-dropsite-distance -1)
                    (set-strategic-number sn-gold-dropsite-distance -1)
                (set-strategic-number sn-stone-dropsite-distance -1)
                ; To allow re-exploring
                    (set-strategic-number sn-blot-exploration-map 0)
                (disable-self)
                )

                (defrule
                (resource-found food)
                (game-time > 5)
                =>
                (set-strategic-number sn-percent-civilian-explorers 0)
                (set-strategic-number sn-minimum-civilian-explorers 0)
                (set-strategic-number sn-cap-civilian-explorers 0)
                (set-strategic-number sn-total-number-explorers 1)
                (set-strategic-number sn-number-explore-groups 1)
                (set-strategic-number sn-percent-civilian-gatherers 0)
                (set-strategic-number sn-percent-civilian-builders 100)
                (set-strategic-number sn-food-dropsite-distance -1)
                (set-strategic-number sn-wood-dropsite-distance -1)
                    (set-strategic-number sn-gold-dropsite-distance -1)
                (set-strategic-number sn-stone-dropsite-distance -1)
                ; To allow re-exploring
                    (set-strategic-number sn-blot-exploration-map 0)
                (disable-self)
                )




                (defrule
                (game-time > 5)
                =>
                    (set-strategic-number sn-maximum-wood-drop-distance 15)
                (set-strategic-number sn-maximum-stone-drop-distance 15)
                (set-strategic-number sn-maximum-gold-drop-distance 25)
                ; (set-strategic-number sn-maximum-fish-boat-drop-distance 15)
                    (set-strategic-number sn-mill-max-distance 30)
                    (set-strategic-number sn-cap-civilian-builders 100)
                    (set-strategic-number sn-allow-adjacent-dropsites 0)
                (disable-self)
                )

                (defrule
                (game-time > 5)
                =>
                (set-strategic-number sn-percent-civilian-gatherers 70)
                (set-strategic-number sn-percent-civilian-builders 30)
                (disable-self)
                )

                ; Next are real sns which you can't use as goals withut modify the AI behavior without undesired results
                ; You can consult their function in the CPSB file, but it's obsolete information, so I recommend you to do it in the Resources Forum from aiscripters
                (defrule
                    (game-time > 5)
                =>
                    (set-strategic-number sn-food-dropsite-distance -1)
                    (set-strategic-number sn-stone-dropsite-distance 3)
                    (set-strategic-number sn-gold-dropsite-distance 15)
                (set-strategic-number sn-wood-dropsite-distance 3)
                    (disable-self)
                )

                (defrule
                    (game-time > 5)
                =>
                    (set-strategic-number sn-maximum-food-drop-distance 25)
                    (set-strategic-number sn-maximum-wood-drop-distance 255)
                    (set-strategic-number sn-maximum-stone-drop-distance 15)
                    (set-strategic-number sn-maximum-gold-drop-distance 25)
                (set-strategic-number sn-percent-building-cancellation 50)
                (set-strategic-number sn-do-not-scale-for-difficulty-level 1)
                    (set-strategic-number sn-minimum-town-size 1)
                    (set-strategic-number sn-percent-building-cancellation 15)
                (set-strategic-number sn-blot-exploration-map 0)
                (set-strategic-number sn-placement-fail-delta 2)
                    (set-strategic-number sn-livestock-to-town-center 1)
                    (set-strategic-number sn-blot-size 15)
                    (disable-self)
                )

                (defrule
                (game-time > 5)
                =>
                    (set-strategic-number sn-number-civilian-militia 200)
                    (set-strategic-number sn-allow-civilian-offense 2)
                    (set-strategic-number sn-allow-civilian-defense 1) ; fjern igen
                )

                (defrule
                    (current-age >= dark-age)
                (players-current-age target-player > dark-age)
                    (strategic-number sn-maximum-town-size < 25)
                    (game-time > 5)
                =>
                    (set-strategic-number sn-maximum-town-size 17)
                )

                (defrule
                    (current-age >= feudal-age)
                    (strategic-number sn-maximum-town-size < 25)
                    (game-time > 5)
                =>
                    (set-strategic-number sn-maximum-town-size 17)
                )

                (defrule
                    (current-age >= castle-age)
                    (strategic-number sn-maximum-town-size < 27)
                =>
                    (set-strategic-number sn-maximum-town-size 27)
                )

                (defrule
                    (current-age == imperial-age)
                    (strategic-number sn-maximum-town-size < 43)
                =>
                    (set-strategic-number sn-maximum-town-size 43)
                )

                #load-if-not-defined UP-POCKET-POSITION

                (defrule
                    (up-players-in-game enemy > 2)
                (current-age == castle-age)
                    =>
                    (set-strategic-number sn-maximum-town-size 20)
                )

                (defrule
                    (up-players-in-game enemy > 2)
                (current-age == castle-age)
                (building-type-count town-center > 2)
                    =>
                    (set-strategic-number sn-maximum-town-size 27)
                )
                (defrule
                (current-age > feudal-age)
                =>
                (set-strategic-number sn-placement-fail-delta 1)
                )

                #end-if
                

                

    ; Advancing
            ;******************************************************************************
            ;
            ; Advancing
            ;
            ;******************************************************************************

            (defrule
            (true)
            =>
            (set-goal gl-age-status dark)
            (disable-self)
            )

            #load-if-not-defined UP-POCKET-POSITION

            (defrule
            (unit-type-count-total villager > 22) ; svt 24 pop
            (can-research feudal-age)
            (game-time > 5)
            =>
            (research feudal-age)
            (set-goal gl-age-status advancing-to-feudal)
            )

            #end-if

            #load-if-defined UP-POCKET-POSITION

            (defrule
            (unit-type-count-total villager > 26) ; svt 28 pop
            (can-research feudal-age)
            (game-time > 5)
            =>
            (research feudal-age)
            (set-goal gl-age-status advancing-to-feudal)
            )

            #end-if

            (defrule                        ;New in Training2
            (current-age == feudal-age)
            (game-time > 5)
            =>
            (set-goal gl-age-status feudal)
            (disable-self)
            )

            (defrule
            (can-research castle-age)
            (game-time > 5)
            =>
            (research castle-age)
            (set-goal gl-age-status advancing-to-castle) ;New in Training2
            ;-chat-to-allies "Researching Castle Age")      ;New in Training2
            )

            (defrule                       ;New in Training2
            (current-age == castle-age)
            (game-time > 5)
            =>
            (set-goal gl-age-status Castle)
            (disable-self)
            )

            ;(defrule
            ;  (can-research imperial-age)
            ; =>
            ; (research imperial-age)
            ;(set-goal gl-age-status advancing-to-imperial) ;New in Training2
            ; ;(chat-to-allies "Researching Imperial Age")      ;New in Training2
            ;)

            (defrule                         ;New in Training2
            (current-age == imperial-age)
            =>
            (set-goal gl-age-status imperial)
            ; (disable-self)
            )

            ; Escrow
            ;(defconst SAVING-FOR-IMP 7)
            ;(set-goal SAVING-FOR-IMP 1)

            ;pocket
            (defrule
            (goal gl-age-status Castle)
            (building-type-count-total town-center > 1)
            (unit-type-count-total villager > 70)
            (military-population > 5)
            (or(not(players-military-population every-enemy > 25))
            (military-population > 15))
            (goal gl-position Pocket)
            (game-time > 5)
            
            ;(or(and(building-type-count-total siege-workshop > 0)
            ;(building-type-count-total monastery > 0))
            ;(and(building-type-count-total university > 0)
            ;(building-type-count-total monastery > 0)))
            =>
            (set-escrow-percentage food 100)
            (set-escrow-percentage gold 100)
            ;-chat-local-to-self "Escrowing 100% food, 0% gold collection for Imperial.")
            (up-modify-escrow food c:= 1000)
            (up-modify-escrow gold c:= 1000)
            
            (disable-self)
            )

            ;flank i tg
            (defrule
            (goal gl-age-status Castle)
            (building-type-count-total town-center > 1)
            (unit-type-count-total villager > 70)
            (military-population > 15)
            (or(players-military-population every-enemy < 35)
            (up-compare-goal gl-MILITARY-SUPERIORITY > 30))
            (goal gl-position Flank)
            (up-players-in-game enemy > 2)
            ;(or(and(building-type-count-total siege-workshop > 0)
            ;(building-type-count-total monastery > 0))
            ;(and(building-type-count-total university > 0)
            ;(building-type-count-total monastery > 0)))
            (game-time > 5)
            =>
            (set-escrow-percentage food 100)
            (set-escrow-percentage gold 100)
            ;-chat-local-to-self "Escrowing 100% food, 0% gold collection for Imperial.")
            (up-modify-escrow food c:= 1000)
            (up-modify-escrow gold c:= 1000)
            ;(set-goal SAVING-FOR-IMP 1)
            (disable-self)
            )

            (defrule
                (taunt-detected my-player-number 14)
                =>
                (up-chat-data-to-all "gl-position is %d." g: gl-position)
                (acknowledge-taunt my-player-number 14)
            )

            ;1v1
            (defrule
            (goal gl-age-status Castle)
            (building-type-count-total town-center > 2)
            (unit-type-count-total villager > 70)
            (military-population > 15)
            (or(players-military-population every-enemy < 20)
            (up-compare-goal gl-MILITARY-SUPERIORITY > 10))
            (goal gl-position Flank)
            (up-players-in-game enemy <= 2)
            ;(or(and(building-type-count-total siege-workshop > 0)
            ;(building-type-count-total monastery > 0))
            ;(and(building-type-count-total university > 0)
            ;(building-type-count-total monastery > 0)))
            (game-time > 5)
            =>
            (set-escrow-percentage food 100)
            (set-escrow-percentage gold 100)
            ;(chat-local-to-self "Escrowing 100% food, 0% gold collection for Imperial.")
            (up-modify-escrow food c:= 1000)
            (up-modify-escrow gold c:= 1000)
            (set-goal gl-saving-for-imp 1)
            (disable-self)
            )

            (defrule
            (can-research-with-escrow imperial-age) 
            (game-time > 5)
            ;(unit-type-count-total villager > 65)
            =>
            (release-escrow food) 
            (release-escrow gold) 
            (research imperial-age)
            ;-chat-to-player every-ally "Releasing esrow food+gold")
            (set-escrow-percentage food 0)
            (set-escrow-percentage gold 0)
            (set-goal gl-age-status advancing-to-imperial)
            ;(set-goal SAVING-FOR-IMP 0)
            (set-goal gl-saving-for-imp -1)
            )
    ; Market
            ; It's difficult to balance our stock resources for AIs. You often get excess of a resource while a lack of other one.
            ; Market tries to compensate it. I'ts not very efficient because the interests pais in every transaction, but it's still better than
            ; have much more wood (for example) than needed and can't train villagers and infantry because lack of food.


            ;******************************************************************************
            ;
            ; Buying and selling
            ;
            ;******************************************************************************

            (defrule
                (current-age >= feudal-age)
                (wood-amount > 500)
                (gold-amount < 500)
                (or	(gold-amount < 200)
                    (food-amount < 800)
                    
                )
                (building-type-count-total barracks >= 1)
                (building-type-count-total archery-range >= 1)
                (building-type-count-total blacksmith >= 1)
                (can-sell-commodity wood)
                (not(goal gl-age-status advancing-to-castle))
                (game-time > 5)
            =>
                (sell-commodity wood)
                ;;(chat-to-player my-player-number "Selling wood")   
            )


            (defrule
                (current-age == feudal-age)
                (food-amount < 800)
                (gold-amount > 150)
                (or 	(food-amount < 200)
                    (gold-amount > 350)
                )
                (can-buy-commodity food)
                (game-time > 5)
            =>
                (buy-commodity food)
                ;;(chat-to-player my-player-number "Buying food") 
            )
            (defrule
                (current-age == feudal-age)
                (food-amount < 100)
                (gold-amount > 500)
                (can-buy-commodity food)
            =>
                (buy-commodity food)
                ;;(chat-to-player my-player-number "Buying food") 
            )

            (defrule
                (current-age == feudal-age)
                (goal gl-age-status feudal)
                ;(up-compare-goal gl-MILITARY-SUPERIORITY < -3)
                ;(food-amount > 400)
                (gold-amount < 200)
                (food-amount > 900)
                    ;(gold-amount < 130)
                
                (can-sell-commodity food)
                (game-time > 5)
            =>
                (sell-commodity food)
                ;;(chat-to-player my-player-number "Selling food") 
            )

            ;anti trush
            (defrule
                (current-age == feudal-age)
                ;(food-amount < 100)
                (gold-amount > 400)
                (can-buy-commodity food)
                (goal gl-age-status feudal)
                (game-time > 5)
            =>
                (buy-commodity food)
                ;;(chat-to-player my-player-number "Buying food") 
            )

            (defrule
                (goal gl-age-status feudal)
                (food-amount >= 800)
                (gold-amount < 200)
                (building-type-count market == 1)
                (game-time > 5)
                =>
                (sell-commodity wood)
                ;;(chat-to-player my-player-number "Selling wood") 
            )

            (defrule
                (current-age == castle-age)
                (food-amount < 200)
                    (gold-amount > 250)
                (can-buy-commodity food)
                (or(commodity-buying-price food < 145)
                (and(commodity-buying-price food < 155)
                (and(food-amount < 200)
                    (gold-amount > 400))))
                (game-time > 5)
            =>
                (buy-commodity food)
                ;(chat-to-player my-player-number "Buying food for exces gold") 
            )

            (defrule
                (current-age == castle-age)
                (building-type-count-total barracks >= 1)
                (building-type-count-total archery-range >= 3)
                (building-type-count-total stable >= 2)
                (building-type-count-total monastery >= 1)
                (building-type-count-total siege-workshop >= 1)
                (building-type-count-total university >= 1)
                (wood-amount > 500)
                (or	(food-amount < 1000)
                    (gold-amount < 800)
                )
                (can-sell-commodity wood)
                (game-time > 5)
            =>
                (sell-commodity wood)
                ;;(chat-to-player my-player-number "Selling wood") 
            )

            ;Buy food if you have surplus gold.
            (defrule
                (current-age == castle-age)
                (food-amount < 1000)
                (gold-amount > 900)
                (can-buy-commodity food)
                (game-time > 5)
            =>
                (buy-commodity food)
                ;;(chat-to-player my-player-number "Buying food") 
            )

            ;Sell food if you have surplus food.
            (defrule
                (current-age == castle-age)
                (or(and(food-amount > 1100)
                (gold-amount < 800))
                (and(food-amount > 500)
                (gold-amount < 75)))

                ;(can-sell-commodity food)
                (game-time > 5)
                =>
                (sell-commodity food)
                ;;(chat-to-player my-player-number "Selling food")
            )


            ; Stone excess
            (defrule
                (or	(current-age >= castle-age)
                    (building-type-count-total watch-tower >= 10)
                )
                (building-type-count-total castle >= 10)
                (building-type-count-total town-center >= 3)
                (research-completed ri-murder-holes)
                (can-sell-commodity stone)
                (game-time > 5)
            =>
                (sell-commodity stone)
                ;;(chat-to-player my-player-number "Selling stone")
            )

            (defrule
                (current-age == imperial-age)
                (food-amount > 1500)
                (gold-amount < 1000)
                

                (can-sell-commodity food)
                (game-time > 5)
            =>
                (sell-commodity food)
                ;;(chat-to-player my-player-number "Selling food")
            )

            (defrule
                (current-age == imperial-age)
                (food-amount < 300)
                (gold-amount > 1000)
                (game-time > 5)
                

                
            =>
                (buy-commodity food)
                ;;(chat-to-player my-player-number "Buying food")
            )

            (defrule
                (current-age == imperial-age)
                (wood-amount > 1000)
                (gold-amount < 1000)
                

                (can-sell-commodity wood)
                (game-time > 5)
            =>
                (sell-commodity wood)
                ;;(chat-to-player my-player-number "Selling wood")
            )

            #load-if-defined UP-POCKET-POSITION

            (defrule
                (goal gl-age-status feudal)
                    (gold-amount > 345)
                        (food-amount < 800)
                        (building-type-count stable > 0)
                            (building-type-count market > 0)
                                =>
                (buy-commodity food)
            )

            (defrule
                (goal gl-age-status feudal)
                    (wood-amount > 250)
                        (food-amount < 800)
                        (building-type-count stable > 0)
                            (building-type-count market > 0)
                                =>
                (sell-commodity wood)
            )

            (defrule
                (current-age == castle-age)
                (or(unit-type-count knight-line > 3)
                (gold-amount > 300))
                (food-amount < 100)
                (gold-amount > 200)
                =>
                (buy-commodity food)
            )

            (defrule
                (commodity-selling-price food >= 55)
                (current-age == imperial-age)
                (or(research-completed ri-paladin)
                (research-completed ri-savar))
                (food-amount > 400)
                (gold-amount < 100)
                =>
                (sell-commodity food)
            )

            (defrule
                (commodity-selling-price wood >= 45)
                (current-age == imperial-age)
                (wood-amount > 300)
                (or(gold-amount < 300)
                (and(gold-amount < 750)
                (not(or(research-completed ri-paladin)
                (research-completed ri-savar)))))
                (building-type-count stable > 7)
                =>
                (sell-commodity wood)
            )


            #end-if

            #load-if-not-defined UP-POCKET-POSITION

            (defrule
            (current-age > feudal-age)
            (wood-amount < 300)
            (or(gold-amount > 500)
            (and(commodity-buying-price wood < 130)
            (gold-amount > 1000)))
            (or(current-age == imperial-age)
            (gold-amount > 1000))
            (or(research-completed ri-ring-archer-armor)
            (current-age == castle-age))
                =>
                (buy-commodity wood)
            )

            (defrule
                (research-available ri-halberdier)
                (unit-type-count spearman-line > 15)
                (gold-amount < 600)

                (food-amount > 400)
                (commodity-selling-price food > 50)
                =>
            (sell-commodity food)
            )

