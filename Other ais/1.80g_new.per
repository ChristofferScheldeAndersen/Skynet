                        ;fase 1
                        (up-remove-objects search-local object-data-group-flag != deer-group) ;4
                        (up-add-object-by-id search-local g: gl-temp)
                        (up-reset-group c: deer-group)
                        (up-modify-group-flag 0 c: deer-group)
                        (up-create-group 0 0 c: deer-group)
                        (up-modify-group-flag 1 c: deer-group)
                        ;(chat-to-player my-player-number "No more berries1. Converting 1 berry vills to shepards")
