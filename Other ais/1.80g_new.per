                                (up-modify-goal gl-temp2-x c:+ 1)
                    ) 

                    (defrule
                    (goal gl-build-first-mill YES)
                        (or(up-point-contains gl-temp2-x c: 907)
                        (or(up-point-contains gl-temp2-x c: 1059)
                        (up-point-contains gl-temp2-x c: 59)))
                        (up-compare-goal gl-surrounding-tiles-checked >= 1)
                        (up-compare-goal gl-surrounding-tiles-checked <= 16)
                        =>
                        (up-modify-goal gl-temp c:+ 5)
                        )

                    (defrule
                    (goal gl-build-first-mill YES)
                        (or(up-point-contains gl-temp2-x c: 907)
                        (or(up-point-contains gl-temp2-x c: 1059)
                        (up-point-contains gl-temp2-x c: 59)))
                        (up-compare-goal gl-surrounding-tiles-checked >= 17)
                        (up-compare-goal gl-surrounding-tiles-checked <= 28)
                        =>
                        (up-modify-goal gl-temp c:+ 3)
                        )

                    (defrule
                    (goal gl-build-first-mill YES)
                        (or(up-point-contains gl-temp2-x c: 907)
                        (or(up-point-contains gl-temp2-x c: 1059)
                        (up-point-contains gl-temp2-x c: 59)))
                        (up-compare-goal gl-surrounding-tiles-checked >= 29)
                        (up-compare-goal gl-surrounding-tiles-checked <= 36)
                        =>
                        (up-modify-goal gl-temp c:+ 2)
                        )

                    (defrule
                    (goal gl-build-first-mill YES)
                        (or(up-point-contains gl-temp2-x c: 907)
                        (or(up-point-contains gl-temp2-x c: 1059)
                        (up-point-contains gl-temp2-x c: 59)))
                        (up-compare-goal gl-surrounding-tiles-checked >= 37)
                        (up-compare-goal gl-surrounding-tiles-checked <= 60)
                        =>
                        (up-modify-goal gl-temp c:+ 1)
                        )

                    (defrule
                                (goal gl-build-first-mill YES)
                                (up-compare-goal gl-surrounding-tiles-checked < 60)
                                =>
                                (up-modify-goal gl-surrounding-tiles-checked c:+ 1)
                                (up-jump-rule -65) ;5+60
                    ) 

                    (defrule
                        (goal gl-build-first-mill YES); checks distance
                            =>
                            (up-get-point position-self gl-position-self-x)
                            (up-get-point position-center gl-center-x)
                            (up-lerp-tiles gl-position-self-x gl-center-x c: -2)
                            (up-set-target-point gl-position-self-x)
                            (up-get-point-distance gl-position-self-x gl-lumber-camp-testing-spot-x gl-lumber-camp-distance)
                            (up-modify-goal gl-temp c:* 4)
                            (up-modify-goal gl-lumber-camp-distance c:* 30)
                            (up-modify-goal gl-temp g:- gl-lumber-camp-distance)
                            (up-modify-goal gl-temp c:+ 300)
                        )

                    (defrule
                                (goal gl-build-first-mill YES)
                                (up-compare-goal gl-surrounding-tiles-checked == 60)
                                (up-compare-goal gl-temp29 g:< gl-temp) ; top mining camp score less than current score
                                =>
                                (up-modify-goal gl-temp29 g:= gl-temp);replace topscore with new one
                                (up-modify-goal gl-temp3-x g:= gl-lumber-camp-testing-spot-x);replace best current spot with new one
                                (up-modify-goal gl-temp3-y g:= gl-lumber-camp-testing-spot-y)
                                ;;(up-chat-data-to-all "New best mill score is %d." g: gl-temp29)
                                ;(up-build-line gl-lumber-camp-testing-spot-x gl-lumber-camp-testing-spot-x c: mining-camp)
                                ;(up-send-flare gl-temp3-x)
                    ) 

                
                ; 2l Hvis der ikke er tjekket 5 træer eller alle fundne træer ikke er tjekket genstartes det store loop.

                    (defrule
                        (goal gl-build-first-mill YES)
                        =>
                        (up-modify-goal gl-new-danger-counter c:+ 1)
                    )

                    (defrule ;6 regler inkl denne
                            (goal gl-build-first-mill YES)
                            (up-compare-goal gl-new-danger-counter < 20)
                            (up-compare-goal gl-mill-location-x == -1)
                            ;(up-compare-goal gl-checked-trees < 10)
                            =>
                            ;;;(up-chat-data-to-all "Number of building checks were %d." g: gl-danger-counter)
                            ;;;(up-chat-data-to-all "times big loop has run is %d." g: gl-new-danger-counter)
                            (up-jump-rule -147) ; har lagt 10 til for de 10 nye regler. skal justeres for scoreregler
                            ;;(chat-to-all "loop rule is running")
                            (up-modify-goal gl-checked-trees c:+ 1)
                        ) ; +67 for scoreregler -4 for tidl fjernede scoreregler +12 for afstand til camp

                ; 2m Ellers bygges lumbercampen i det bedst fundne punkt.

                

                    (defrule
                        (up-compare-goal gl-new-danger-counter >= 20)
                        (goal gl-build-first-mill YES)
                        (up-compare-goal gl-mill-location-x == -1)
                            =>
                        (up-copy-point gl-mill-location-x gl-temp3-x)
                        ;;;(up-chat-data-to-all "best lumber camp score is %d." g: gl-best-found-lc-score)
                        ;;;(up-chat-data-to-all "times big loop has run is %d. and a spot is chosen" g: gl-new-danger-counter)
                        ;(disable-self)
                        
                    )


                ; 2n Place down first 2 lumber camps
                    ; when a lumbercamp can be build and you have at least 125 wood use up-build-line to build the lumbercamp at the point

                    (defrule
                        (up-compare-goal gl-mill-location-x != -1)
                        (goal gl-build-first-mill YES)
                        =>
                        (up-build-line gl-mill-location-x gl-mill-location-x c: mill)
                        ;;(chat-to-all "Attempting to place first DUC lumber-camp")
                        ;(up-copy-point gl-first-mill-location-x gl-mill-location-x)
                        ;(up-modify-goal gl-mill-location-x c:= -1)
                        ;;(chat-to-all "trying to place new mining camp")
                        ;;(up-send-flare gl-mill-location-x)
                        (set-goal gl-build-first-mill NO)
                    );
        
            ;
        ;Gold mining camp
            ;mining camps
            ; Find up to 20 gold mines and save them into temp goals (10-29):
                
                    
                    (defrule
