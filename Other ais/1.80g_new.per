            ; Place building
                ;
                    (defrule
                    (true)
                    =>
                    
                    (up-get-precise-time 16 181)
                    (up-modify-sn 387 g:= 181);388
                    ;(up-chat-data-to-all "Second loop-duration 1: %d" g: 181)
                    )
                ; House
                    
                    (defrule
                        
                        (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-house)
                        (can-build house)
                        =>
                        (up-full-reset-search)
                        (up-get-search-state gl-local-total)
                        (up-find-local c: mining-camp c: 1)
                    )

                    (defrule
                        (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-house)
                        (can-build house)
                        (up-set-target-object search-local c: 0)
                        (up-compare-goal gl-my-position != pocket)
                        =>
                        (up-get-point position-object gl-temp1-x) ;gammel
                        (up-get-point position-flank gl-temp1-x)
                        (up-set-target-point gl-temp1-x)
                        (up-full-reset-search)
                        (up-find-local c: lumber-camp c: 200)
                        (up-set-target-point gl-last-deleted-building-x)
                        (up-remove-objects search-local object-data-distance < 12)
                        (up-set-target-point gl-temp1-x)
                        (up-clean-search search-local object-data-distance search-order-desc)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-house)
                        (can-build house)
                        (up-set-target-object search-local c: 0)
                        (up-compare-goal gl-my-position == pocket)
                        =>
                        (up-get-point position-object gl-temp1-x) ;gammel
                        (up-set-target-point gl-temp1-x)
                        (up-full-reset-search)
                        (up-find-local c: lumber-camp c: 200)
                        (up-set-target-point gl-last-deleted-building-x)
                        (up-remove-objects search-local object-data-distance < 12)
                        (up-set-target-point gl-temp1-x)
                        (up-clean-search search-local object-data-distance search-order-desc)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-house)
                        (can-build house)
                        (up-compare-goal gl-local-total == 0)
                        =>
                        (up-set-target-point gl-temp1-x)
                        (up-full-reset-search)
                        (up-find-local c: lumber-camp c: 200)
                        (up-clean-search search-local object-data-distance search-order-desc)
                    )

                    (defrule
                        (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-house)
                        (can-build house)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-point position-object gl-temp2-x)
                    )
                    
                    #load-if-defined DE-AVAILABLE
                    (defrule
                    (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-house)
                        (can-build house)
                        ;(not(and(up-pending-objects c: house > 1)
                        ;(and(population < 65)
                        ;(up-compare-goal gl-my-position != solo))))
                        =>
                        (up-set-target-point gl-temp2-x)
                        (up-build place-point 0 c: house)
                    )
                    #end-if

                    #load-if-not-defined DE-AVAILABLE
                    (defrule
                    (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-house)
                        (can-build house)
                        (wood-amount < 400)
                        (population < 100)
                        ;(not(and(up-pending-objects c: house > 1)
                        ;(and(population < 65)
                        ;(up-compare-goal gl-my-position != solo))))
                        =>
                        (up-set-target-point gl-temp2-x)
                        (up-build place-point 0 c: house)
                        ;(chat-to-all "trying to build house1")
                        (up-copy-point gl-final-target-point-x gl-temp2-x)
                        (set-goal gl-building-placed-this-pass YES)
                    )

                    (defrule
                    (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-house)
                        (can-build house)
                        (or(wood-amount >= 400)
                        (population >= 100))
                        ;(not(and(up-pending-objects c: house > 1)
                        ;(and(population < 65)
                        ;(up-compare-goal gl-my-position != solo))))
                        =>
                        (build house)
                        ;(chat-to-all "trying to build house2")
                        (set-goal gl-building-placed-this-pass YES)
                    )
                    #end-if

                ; Farms
                    ; Ekstra - stop ai engine fra at sende forkerte vills på færdige farms
                        ;når gl-new-farm-missing-a-vill er 1 skal reglen der styrer om auto retasking systemet er slået til slå dette fra.
                        
                        (defrule
                        (game-time >= 3)
                        =>
                        (up-get-fact building-type-count farm gl-temp1)
                        (set-goal gl-new-farm-missing-a-vill -1)
                        )

                        (defrule
                        (game-time >= 3)
                            (up-compare-goal gl-number-of-farms-last-pass g:> gl-temp1)
                            =>
                            (up-full-reset-search)
                            (up-find-local c: farm c: 200)
                            (up-remove-objects search-local object-data-tasks-count > 0)
                        )

                        (defrule
                        (game-time >= 3)
                            (up-compare-goal gl-number-of-farms-last-pass g:> gl-temp1)
                            (up-set-target-object search-local c: 0)
                            =>
                            (set-goal gl-new-farm-missing-a-vill 1)
                            ;(chat-to-all "found new farm missing a vill")
                        )

                        (defrule
                            (game-time >= 3)
                            =>
                            (up-get-fact building-type-count farm gl-number-of-farms-last-pass)
                        )
                        
