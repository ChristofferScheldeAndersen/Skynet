                (up-target-point gl-position-self-x action-move -1 -1) 
                (up-full-reset-search)
                ;;(chat-to-all "waiting for boar to come to tc1")
                (set-goal gl-luring-step 1)
            )

        
            (defrule ; k�rer konstant fra starten
                (up-compare-goal gl-luring-step == 1)
                (up-compare-goal gl-boar-point-relation-to-tc == upper-left-quadrant)
                (up-compare-goal gl-second-boar-luring-villager != -1)
                =>
                    (set-goal gl-split-rule 90))
                (defrule
                    (goal gl-split-rule 90)
                => 
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-second-boar-luring-villager)
                (up-get-point position-self gl-position-self-x)
                (up-modify-goal gl-position-self-x c:- 2)
                (up-modify-goal gl-position-self-y c:- 2)
                (up-set-target-point gl-position-self-x)
                ;(up-set-target-object search-local c: 0)
                )

                (defrule
                    (up-set-target-by-id g: gl-second-boar-luring-villager)
                    =>
                    (up-get-object-data object-data-move-x gl-temp-x)
                    (up-get-object-data object-data-move-y gl-temp-y)
                    ;(up-point-distance gl-temp-x gl-position-self-x > 1)
                )

                (defrule
                    (goal gl-split-rule 90)
                    (up-point-distance gl-temp-x gl-position-self-x > 1)
                => 
                (up-target-point 0 action-stop -1 -1)
                (up-target-point 0 action-default -1 -1)
                )

                (defrule
                    (goal gl-split-rule 90)
                => 
                (up-full-reset-search)
                (up-get-point position-self gl-position-self-x)
                (up-modify-goal gl-position-self-x c:- 2)
                (up-modify-goal gl-position-self-y c:- 2)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 0)
                ;;(chat-to-all "waiting for boar to come to tc2")
                )

