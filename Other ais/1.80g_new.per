                        (up-bound-precise-point gl-temp2-x 0 c: 1)
                        (up-target-point gl-temp2-x action-default formation-line -1)
                        (set-strategic-number sn-target-point-adjustment 6)
                        (enable-timer 6 10)
                        ;(chat-to-all "moving around enemy base 2")
                        )
                    
                ;Raid-enemy
                    ;Moving to enemy
                        
                        (defrule
                            (true)
                            =>
                            (up-reset-filters)
                            (up-find-local c: knight-line c: 200)
                            (up-remove-objects search-local object-data-group-flag != knight-group)
                            (up-copy-point gl-temp-x gl-enemy-x)
                            (up-get-point position-self gl-temp1-x)
                            (up-lerp-tiles gl-temp-x gl-temp1-x c: 7)
                            (up-modify-goal gl-temp6-y c:* 100)
                            (up-copy-point gl-temp1-x gl-enemy-x)
                            (up-modify-goal gl-temp1-x c:* 100)
                            (up-modify-goal gl-temp1-y c:* 100)
                        )

                        (defrule
                            (up-compare-goal gl-knight-micro-priority == -1)
                            (up-point-distance gl-temp9-x gl-temp1-x > 900)
                            (goal gl-melee-army-mode raid-enemy)
                            (up-set-target-object search-local c: 0)
                            =>
                            (up-remove-objects search-local object-data-group-flag != knight-group)
                            (up-modify-goal gl-temp-x c:* 100)
                            (up-modify-goal gl-temp-y c:* 100)
                            (up-target-point gl-temp-x action-default formation-line -1)
                            ;(chat-to-all "Run to enemy tc")
                        )

                ;Resetting sn-target-point-adjustment
                    (defrule
                        (true)
                        =>
                        (set-strategic-number sn-target-point-adjustment 5)
                    )
        
            
        ; Ungrouped units
            



            ; Moving spears to exposed locations


    
        
    ;  
        (defrule
            ;(true)
            (true)
            =>
            
            (up-get-precise-time 16 181)
            (up-modify-sn 408 g:= 181)
            ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
            )

            (defrule
                (or(taunt-detected my-player-number 234)
                (or(taunt-detected any-ally 234)
                (taunt-detected any-enemy 234)))
            =>
            (up-chat-data-to-all "script loop-duration 41 is: %d." g: 181)
            ;(up-jump-direct g: gl-end-of-script-rule)
            ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
            ;(up-chat-data-to-all "superiority goal is %d" g: 11)
            (do-nothing)
            )
    ; skip old military rules when lagging

        (defrule
            (up-compare-goal gl-post-old-mili-rules-id != -1)
            (up-compare-goal gl-skip-old-mili-counter < 6)
            (up-compare-goal gl-time-between-ticks-avg-for-group > 950)
            =>
            (up-jump-direct g: gl-post-old-mili-rules-id)
            (up-modify-goal gl-skip-old-mili-counter c:+ 1)
        )


        (defrule
            (true)
            =>
            (set-goal gl-skip-lumberjacks-counter 1)
        )
    
    ; Altered Old rules for military control (1-2 player team)
        #load-if-not-defined UP-3-PLAYER-TEAM
        #load-if-not-defined UP-4-PLAYER-TEAM
        #load-if-not-defined UP-5-PLAYER-TEAM
        #load-if-not-defined UP-6-PLAYER-TEAM
        #load-if-not-defined UP-7-PLAYER-TEAM
        #load-if-not-defined UP-8-PLAYER-TEAM
        ; Making sure knights won't suacide - flyttet fra micro rules
                ;Defensive-mode
                        (defrule
                            (true)
                            =>
                            (up-full-reset-search)
                            (up-find-local c: knight-line c: 200)
                            (up-remove-objects search-local object-data-attack-stance == stance-no-attack)
                            (up-get-point position-self gl-temp-x)
                            (up-set-target-point gl-temp-x)
                            (up-modify-goal gl-temp s:= sn-maximum-town-size)
                            (up-modify-goal gl-temp c:+ 8)
                            (up-remove-objects search-local object-data-distance g:<= gl-temp)
                        )

                        (defrule
                            (true)
                            (goal gl-change-to-old-military-rules -1)
                            (up-set-target-object search-local c: 0)
                            =>
                            ;(up-target-point gl-temp-x action-move -1 stance-no-attack)
                            ;(chat-to-all "moving units into town and changing to no attack stance")
                            (do-nothing)
                        )

                        (defrule
                            (true)
                            =>
                            (up-full-reset-search)
                            (up-find-local c: knight-line c: 200)
                            (up-get-point position-self gl-temp-x)
                            (up-set-target-point gl-temp-x)
                            (up-remove-objects search-local object-data-distance s:> sn-maximum-town-size)
                            (up-remove-objects search-local object-data-attack-stance == stance-aggressive)
                        )

                        (defrule
                            (true)
                            (up-set-target-object search-local c: 0)
                            =>
                            (up-target-point gl-temp-x action-none -1 stance-aggressive)
                            ;(chat-to-all "changing units to agressive stance")
                        )




                        (defrule
                            (true)
                            =>
                            (up-full-reset-search)
                            (up-find-local c: knight-line c: 200)
                            (up-remove-objects search-local object-data-idling c:!= 1)
                            (up-get-point position-self gl-temp-x)
                            (up-set-target-point gl-temp-x)
                            (up-remove-objects search-local object-data-distance <= 10)
                        )

                        (defrule
                            (goal gl-agression-mode retreating)
                            (up-set-target-object search-local c: 0)
                            =>
                            (up-target-point gl-temp-x action-move -1 stance-no-attack)
                            ;(chat-to-all "bringing home idle far units")
                        )
            
    
        
        
        ; Skipping rules in the early game
            (defrule
            (true)
            =>
            (up-get-rule-id gl-old-military-control-first-rule)
            )
            
            (defrule
            (goal gl-change-to-old-military-rules -1)
            (up-compare-goal gl-old-military-control-last-rule != -1)
            =>
            (up-jump-direct g: gl-old-military-control-last-rule)
            )
            ;
        ;Update gl-enemy-x to the location of the current target enemy efter der skiftes til gamle regler
            ;1 Detect whenever the ai changes target player.

                (defrule
                    (true)
                    =>
                    (set-goal gl-temp1 -1)
                )

                (defrule
                    (up-compare-sn sn-target-player-number s:!= sn-last-target-player-number)
                    =>
                    (set-goal gl-temp1 1)
                )

                (defrule
                    (true)
                    =>
                    (up-modify-sn sn-last-target-player-number s:= sn-target-player-number)
                    (set-goal gl-temp2 1)
                    (set-goal gl-temp-x -1)
                    (set-goal gl-temp1-x 0)
                    (set-goal gl-temp1-y 0)
                    (set-goal gl-temp3 0)
                )

            ;2 When it does then an id loop will run checking all buildings of the target player at locations that have been explored

                (defrule
                    (up-set-target-by-id g: gl-temp2)
                    =>
                    (up-get-point position-object gl-temp-x)
                )

                (defrule
                    (up-set-target-by-id g: gl-temp2)
                    (up-point-explored gl-temp-x != explored-no)
                    (up-object-data object-data-player s:== sn-target-player-number)
                    (up-object-data object-data-class == building-class)
                    (up-object-data object-data-type != mining-camp)
                    (up-object-data object-data-type != lumber-camp)
                    =>
                    (up-add-point gl-temp1-x gl-temp-x c: 1)
                    (up-modify-goal gl-temp3 c:+ 1)
                )

                (defrule
                    (goal gl-temp1 1)
                    (up-compare-goal gl-temp2 < 200000)
                    =>
                    (up-modify-goal gl-temp2 c:+ 1)
                    (up-jump-rule -3)
                )

            ;3 Find the center of gravity for all these buildings and update gl-enemy-x to use this point
            ;that should make sure there is no cheating and no lag

                (defrule
                    (goal gl-temp1 1)
                    (game-time > 5)
                    =>
                    (up-modify-goal gl-temp1-x g:/ gl-temp3)
                    (up-modify-goal gl-temp1-y g:/ gl-temp3)
                    (up-copy-point gl-enemy-x gl-temp1-x)
                    (up-send-flare gl-enemy-x)
                    ;(up-chat-data-to-all "new target player is player %d" s: sn-target-player-number)
                )
        ; Changing stance of all units once old rules are activated
            (defrule
                (game-time > 60)
                =>
                (up-set-attack-stance archery-class c: stance-aggressive)
                (disable-self)
            )
        ; Military Priorities
            ;
            ;******************************************************************************

            (defrule
            (true)
            =>
            (up-set-offense-priority c: watch-tower c: -1)
            (up-set-offense-priority c: town-center c: 11)
            (up-set-offense-priority c: castle c: -1)
            (up-set-offense-priority c: villager c: -1)
                (up-set-offense-priority c: lumber-camp c: 4)
            (up-set-offense-priority c: mining-camp c: 4)
            (up-set-offense-priority c: mill c: 4)
                (up-set-offense-priority c: archer-line c: 5)
            (up-set-offense-priority c: knight-line c: 5)
            (disable-self)
            )

