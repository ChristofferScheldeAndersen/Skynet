                    (up-compare-goal gl-need-market == NO)
                    (up-compare-goal gl-need-tower == NO)
                    (up-compare-goal gl-need-house == NO)
                    (up-compare-goal gl-need-mill == NO)
                        =>
                        (set-goal gl-building-system build-line-system)
                        (set-strategic-number sn-cap-civilian-builders 0)
                        (set-goal gl-reset-builders YES)
                    )

                ; Reset builders after standard-system -> build-line-system (safe)

                    (defrule
