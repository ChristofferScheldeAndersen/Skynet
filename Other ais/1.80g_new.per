                        (up-compare-goal gl-temp != -1)
                        (goal gl-no-more-berries -1)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        
                        ;fase 1
                        (up-remove-objects search-local object-data-group-flag != pre-farming-straggler-group) ;7
                        (up-add-object-by-id search-local g: gl-temp)
                        (up-reset-group c: pre-farming-straggler-group)
                        (up-modify-group-flag 0 c: pre-farming-straggler-group)
                        (up-create-group 0 0 c: pre-farming-straggler-group)
                        (up-modify-group-flag 1 c: pre-farming-straggler-group)
                        ;(chat-to-player my-player-number "skirm mode on. Converting 1 gold vill to stragglers")
                        (up-jump-rule -14)
                        (disable-self)
                    )
            
            
            
        
        ;J Market - buying and selling (safe)

                (defrule
                    (stone-amount >= 200)
                    (can-sell-commodity stone)
                    (up-research-status c: castle-age >= research-pending)
                    (up-compare-goal gl-my-position == 3)
                    =>
                    (sell-commodity stone)
                )

                (defrule
                    (true)
                    =>
                    (up-get-fact resource-amount amount-gold gl-spare-gold)
                    (up-modify-goal gl-spare-gold c:- 200)
                )

                (defrule
                    (commodity-buying-price food g:<= gl-spare-gold)
                    (food-amount < 800)
                    (goal gl-age-status feudal)
                    (building-type-count market >= 1)
                    =>
                    (buy-commodity food)
                    ;(chat-to-all "buying food for castle age")
                )

                (defrule
                    (true)
                    =>
                    (up-get-fact resource-amount amount-gold gl-temp)
                    (up-modify-goal gl-temp c:- 200)
                )

                (defrule
                    (food-amount > 900)
                    (gold-amount < 200)
                    (up-compare-goal gl-age-status == feudal)
                    (building-type-count market >= 1)
                    =>
                    (sell-commodity food)
                    ;(chat-to-all "selling food for castle age")
                )

                (defrule
                    (wood-amount >= 100)
                    (or(and(food-amount > 675)
                    (gold-amount < 200))
                    (and(food-amount < 800)
                    (wood-amount > 300)))
                    (up-compare-goal gl-age-status == feudal)
                    (building-type-count blacksmith >= 1)
                    (building-type-count market >= 1)
                    =>
                    (sell-commodity wood)
                    ;(chat-to-all "selling wood for castle age")
                )

                (defrule
                    (current-age == feudal-age)
                    =>
                    (up-full-reset-search)
                    (set-goal gl-temp1 0)
                    (up-find-local c: town-center c: 1)
                )

                (defrule
                    (current-age == feudal-age)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-object-data object-data-progress-value gl-temp1)
                )

                (defrule
                    (up-compare-goal gl-temp1 >= 75)
                    (up-compare-goal gl-age-status == advancing-to-castle)
                    (stone-amount < 100)
                    (not(can-buy-commodity stone))
                    (can-sell-commodity wood)
                    =>
                    (sell-commodity wood)
                    ;(chat-to-all "selling wood for buying stone")
                )

                (defrule
                (up-compare-goal gl-age-status == advancing-to-castle)
                    (stone-amount < 100)
                    (can-buy-commodity stone)
                    =>
                    (buy-commodity stone)
                    ;(chat-to-all "buying stone for town center 1")
                )

        ;B Town-center (safe)
            ;A Advancing
                (defrule
                    (current-age == dark-age)
                    =>
                    (set-goal gl-age-status dark)
                    (disable-self)
                )
                
                (defrule
                (not(research-available ri-loom))
                (or(unit-type-count-total villager >= 22)
                (and(civ-selected mayan)
                (unit-type-count-total villager >= 23)))
                (can-research feudal-age)
                =>
                (research feudal-age)
                (set-goal gl-age-status advancing-to-feudal)
                )

                (defrule
                    (current-age == feudal-age)
                    =>
                    (set-goal gl-age-status feudal)
                    (disable-self)
                )
                
                (defrule
                (can-research castle-age)
                =>
                (research castle-age)
                (set-goal gl-age-status advancing-to-castle)
                )
                
            ;B Villager creation, wheelbarrow and loom
                #load-if-defined DE-AVAILABLE
                (defrule 
                (can-train villager)
                (or(unit-type-count-total villager < 22)
                (and(civ-selected mayan)
                (unit-type-count-total villager < 23)))
                    =>
                (train villager)
                )

                (defrule 
                (unit-type-count-total villager >= 22)
                (can-research ri-loom)
                    =>
                (research ri-loom)
                )
                #end-if

                #load-if-not-defined DE-AVAILABLE
                (defrule 
                (can-train villager)
                (or(unit-type-count-total villager < 23)
                (and(civ-selected mayan)
                (unit-type-count-total villager < 24)))
                    =>
                (train villager)
                )

                (defrule 
                (unit-type-count-total villager >= 23)
                (can-research ri-loom)
                    =>
                (research ri-loom)
                )
                #end-if


                (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: town-center c: 1)
                (set-goal gl-temp 0)
                )

                (defrule
                    (up-set-target-object search-local c: 0)
                    (or(up-object-data object-data-progress-type == 102) ;vill
                    (up-object-data object-data-progress-type == 103)) ;research
                    =>
                    (up-get-object-data object-data-progress-value gl-temp)
                )

                (defrule
                    (can-research ri-wheel-barrow)
                    (or(and(up-compare-goal gl-full-skirm-mode == -1)
                    (building-type-count-total farm >= 9))
                    (and(up-compare-goal gl-full-skirm-mode == 1)
                    (and(building-type-count-total farm >= 14)
                    (food-amount >= 100))))
                    (food-amount < 400)
                    (game-time < 1240)
                    =>
                    (research ri-wheel-barrow)
                )

                (defrule
                    (taunt-detected my-player-number 123)
                    =>
                    (chat-to-all "rule running")
                    (disable-self)
                )

                (defrule
                    (true)
                    =>
                    (set-goal gl-temp 1)
                )

                (defrule
                    (can-research ri-wheel-barrow)
                    (or(and(up-compare-goal gl-full-skirm-mode == -1)
                    (building-type-count-total farm >= 9))
                    (and(up-compare-goal gl-full-skirm-mode == 1)
                    (and(building-type-count-total farm >= 14)
                    (food-amount >= 100))))
                    (food-amount < 400)
                    (game-time < 1240)
                    =>
                    (set-goal gl-temp -1)
                )

                (defrule
                    (up-research-status c: ri-wheel-barrow < research-pending)
                    (or(and(up-compare-goal gl-full-skirm-mode == -1)
                    (building-type-count-total farm >= 9))
                    (and(up-compare-goal gl-full-skirm-mode == 1)
                    (and(building-type-count-total farm >= 14)
                    (food-amount >= 100))))
                    (food-amount < 400)
                    (food-amount >= 175)
                    (up-pending-objects c: villager > 0)
                    =>
                    (set-goal gl-temp -1)
                )

                    (defrule 
                    (goal gl-temp 1)
                    ;(up-compare-goal gl-temp >= 88)
                    (current-age == feudal-age) ; skal også gælde mens der advances
                    (can-train villager)
                    (not(and(food-amount > 675)
                    (gold-amount > 50)))
                        =>
                        (set-goal gl-split-rule 1013)
                    
                    )

                    (defrule
                        (not(and(or(food-amount > 475)
                    (up-pending-objects c: market > 0))
                    (up-pending-objects c: villager > 0)))
                    (not(and(up-research-status c: ri-wheel-barrow == research-pending)
                    (building-type-count town-center == 1)))
                    (goal gl-split-rule 1013)
                        =>
                        (train villager)
                    )

            ;C Forcedropping
                
                (defrule
                        (true)
