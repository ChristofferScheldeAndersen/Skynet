                    (and(up-set-target-by-id g: gl-temp3)
                    (up-object-data object-data-hitpoints <= 0)))
                    =>
                    (set-goal gl-temp11 1)
                    ;(chat-to-all "allowing target to change based on not having a valid target")
                )

                ;b - den valgte knights target har en score der er over 15 lavere end et andet muligt target.

                (defrule
