                ; Need buildings

                    ; kræver at der er råd til alle bygninger samtidigt.
                        (defrule
                            (research-completed ri-loom)
                            =>
                            (enable-timer barracks-timer 55)
                            ;;(chat-to-all "barracks-timer started")
                            (disable-self)
                        )

                        (defrule
                            (building-type-count-total barracks > 0)
                            =>
                            (disable-timer barracks-timer)
                        )
                        
                        (defrule
                            (timer-triggered barracks-timer)
                            (can-afford-building barracks)
                            (up-compare-goal gl-building-system == build-line-system)
                            =>
                            (set-goal gl-need-barracks YES)
                        )
                    (defrule
                        (can-afford-building house)
                            (housing-headroom < 10)
                            (or(building-type-count house == 4)
                            (and(building-type-count house == 5)
                            (building-type-count-total stable > 0)))
                            (up-pending-objects c: house == 0)
                            (up-compare-goal gl-building-system == build-line-system)
                        =>
                        ;(set-goal gl-need-house YES)
                        (do-nothing)
                    )

                    #load-if-not-defined ARENA-MAP

                    (defrule
                        (current-age >= feudal-age)
                        (building-type-count-total stable < 1)
                        (can-afford-building stable)
                        =>
                        (set-goal gl-build-stable YES)
                    ) ; * alle bygninger

                    #end-if

                    #load-if-defined ARENA-MAP

                    (defrule
                        (current-age >= feudal-age)
                        (building-type-count-total archery-range < 1)
                        (can-afford-building archery-range)
                        (nor(civ-selected frankish)
                        (civ-selected persian))
                        =>
                        (set-goal gl-build-archery-range YES)
                    ) ; * alle bygninger

                    (defrule
                        (current-age >= feudal-age)
                        (building-type-count-total stable < 1)
                        (can-afford-building stable)
                        (or(civ-selected frankish)
                        (civ-selected persian))
                        =>
                        (set-goal gl-build-stable YES)
                        
                    ) ; * alle bygninger

                    (defrule
                        (up-pending-objects c: archery-range > 0)
                        =>
                        (up-full-reset-search)
                        (set-strategic-number sn-focus-player-number my-player-number)
                        (up-filter-status c: status-pending c: list-active)
                        (up-find-status-remote c: archery-range c: 1)
                    )

                    (defrule
                        (up-pending-objects c: archery-range > 0)
                        (up-set-target-object search-remote c: 0)
                        (up-object-data object-data-tasks-count < 5)
                        =>
                        (up-find-local c: villager-class c: 1)
                        (up-target-objects 0 action-default -1 -1)
                    )

                    #end-if

                    (defrule
                        (current-age >= feudal-age)
                        (building-type-count-total blacksmith < 1)
                        (can-afford-building blacksmith)
                        =>
                        (set-goal gl-build-blacksmith YES)
                    ) ; * alle bygninger

                    (defrule
                        (unit-type-count villager >= 24)
                            (wood-amount >= 400)
                            (building-type-count-total lumber-camp >= 2)
                            (building-type-count-total mining-camp < 1)
                            (up-compare-goal gl-building-system == build-line-system)
                        =>
                        (set-goal gl-need-mining-camp YES)
                    )
                    

