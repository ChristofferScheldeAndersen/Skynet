                        (defrule
                            (up-research-status c: imperial-age == research-pending)
                            (up-timer-status tech-checking-timer == timer-disabled)
                            =>
                            (enable-timer tech-checking-timer 100)
                            (disable-self)
                        )

                        (defrule
                            (current-age == imperial-age)
                            =>
