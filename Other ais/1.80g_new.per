            ;******************************************************************************
            ;
            ; Corner markets
            ;
            ;******************************************************************************

            ;6 huske at kigge p� can-build i fremtiden s� du ikke er n�dt til at placere vigtige 
            ;ting f�rst. Husk ogs� at target point kan bugge hvis den ikke st�r sidst.


            (defrule
            (can-build market)
            (or(unit-type-count trade-cart > 0)
            (players-unit-type-count any-ally trade-cart > 0))
            (building-type-count market < 2)
            (up-pending-objects c: market == 0)
            (game-time > 5)
                =>
            ;;(up-send-flare g-market-point-x)
                (set-strategic-number sn-placement-zone-size 30)
            (up-set-target-point g-market-point-x)
            (up-assign-builders c: market c: 1)
            (up-build place-point 1 c: market)
            (set-strategic-number sn-preferred-trade-distance 999)
                ; (disable-self)
            )

            (defrule
            (game-time > 5)
            =>
            (up-get-point position-center gl-center-x)
            (up-get-point position-self gl-non-changing-position-self-x)
            (up-get-point position-map-size gl-full-map-size-x)
            (up-get-point position-map-size gl-full-map-size-y)
            (set-strategic-number sn-cap-civilian-builders 50)
            (disable-self)
            )

            (defrule
            (up-compare-goal gl-non-changing-position-self-x g:>= gl-center-x)
            (game-time > 5)
            =>
            (up-modify-goal g-market-point-x g:= gl-full-map-size-x)
            (disable-self)
            )

            (defrule
            (up-compare-goal gl-non-changing-position-self-y g:>= gl-center-y)
            (game-time > 5)
            =>
            (up-modify-goal g-market-point-y g:= gl-full-map-size-y)
            (disable-self)
            )

            (defrule
            (up-compare-goal gl-non-changing-position-self-x g:< gl-center-x)
            (game-time > 5)
            =>
            (set-goal g-market-point-x 0)
            (disable-self)
            )

            (defrule
            (up-compare-goal gl-non-changing-position-self-y g:< gl-center-y)
            (game-time > 5)
            =>
            (set-goal g-market-point-y 0)
            (disable-self)
            )



            (defrule
            (up-compare-goal gl-non-changing-position-self-x g:>= gl-center-x)
            (up-compare-goal gl-non-changing-position-self-y g:< gl-center-y)
            (game-time > 5)
            ;(can-build market)
            ;(game-time > 150)
            =>
            (up-modify-goal g-market-point-x c:- 1)
            (up-modify-goal g-market-point-y c:+ 1)
            (disable-self)
            ;   ;;(up-send-flare g-market-point-x)
            ;   (set-strategic-number sn-enable-new-building-system 1)
            ; (set-strategic-number sn-placement-zone-size 30)
            ;  (up-set-target-point g-market-point-x)
            ;   (up-build place-point 1 c: market)
            ;    (disable-self)
            )

            (defrule
            (up-compare-goal gl-non-changing-position-self-x g:< gl-center-x)
            (up-compare-goal gl-non-changing-position-self-y g:>= gl-center-y)
            (game-time > 5)
            =>
            (up-modify-goal g-market-point-x c:+ 1)
            (up-modify-goal g-market-point-y c:- 1)
            (disable-self)
            ; ;;(up-send-flare g-market-point-x)
            ;  (up-set-target-point g-market-point-x)
            ; (up-build place-point 0 c: market)
                ;  (disable-self)
            )

            (defrule
            (up-compare-goal gl-non-changing-position-self-x g:>= gl-center-x)
            (up-compare-goal gl-non-changing-position-self-y g:>= gl-center-y)
            (game-time > 5)
            =>
            (up-modify-goal g-market-point-x c:- 1)
            (up-modify-goal g-market-point-y c:- 1)
            (disable-self)
            ; ;;(up-send-flare g-market-point-y)
            ;  (up-set-target-point g-market-point-x)
            ; (up-build place-point 0 c: market)
                ;   (disable-self)
            )

            (defrule
            (up-compare-goal gl-non-changing-position-self-x g:< gl-center-x)
            (up-compare-goal gl-non-changing-position-self-y g:< gl-center-y)
            (game-time > 5)
            ; (game-time > 150)
            ; (can-build market)
            =>
            ; (set-strategic-number sn-enable-new-building-system 1)
            ; (set-strategic-number sn-placement-zone-size 30)
            (up-modify-goal g-market-point-x c:+ 1)
            (up-modify-goal g-market-point-y c:+ 1)
            (disable-self)
            ;  ;;(up-send-flare g-market-point-x)
            ;  (up-set-target-point g-market-point-x)
            ; (up-build place-point 0 c: market)
                ;  (disable-self)
            )


            ;(defrule
            ; (game-time > 10)
            ; =>
            ;  ;;(up-send-flare g-market-point-x)
            ; (disable-self)
            ;)

            (defrule ; fordi up-get-focus-fact ikke virker med goals
            (game-time > 5)
            =>
            (up-modify-sn sn-market-point-x g:= g-market-point-x)
            (up-modify-sn sn-market-point-y g:= g-market-point-y)
            (disable-self)
            )

            (defrule
            (goal gl-position Flank)
            (game-time > 5)
            =>
            (up-get-point-distance gl-non-changing-position-self-x g-market-point-x gl-corner-distance)
            ;;;(up-chat-data-to-all "Distance to corner %d." g: gl-corner-distance)
            (up-modify-sn sn-corner-distance g:= gl-corner-distance)
            ;;;(up-chat-data-to-all "s Distance to corner %d." s: sn-corner-distance)
            (disable-self)
            )

            (defrule
            (game-time > 5)
            =>
            (set-strategic-number sn-focus-player-number 1)
            )

            (defrule
            (game-time > 5)
            =>
                (up-get-focus-fact allied-sn sn-corner-distance gl-opposite-corner-distance)
            )

            (defrule
            (up-allied-goal focus-player gl-position == Flank)
                (goal gl-position Flank)
            (up-compare-const my-player-number s:!= sn-focus-player-number)
            (up-compare-sn sn-corner-distance g:> gl-opposite-corner-distance)
            (game-time > 5)
                        =>
            ;;;(up-chat-data-to-all "Focus player is %d." s: sn-focus-player-number)
            ;;;(up-chat-data-to-all "Changing market corner. I have largest. Corner distance is %d." s: sn-corner-distance)
            ;(set-goal gl-far-market 0)
            (up-get-focus-fact allied-sn sn-market-point-x g-market-point-x)
            (up-get-focus-fact allied-sn sn-market-point-y g-market-point-y)
                )

            (defrule
            (up-allied-goal focus-player gl-position == Flank)
                (goal gl-position Flank)
            (up-compare-const my-player-number s:!= sn-focus-player-number)
            (up-compare-sn sn-corner-distance g:< gl-opposite-corner-distance)
            (game-time > 5)
                        =>
            ; ;;(up-chat-data-to-all "Focus player is %d." s: sn-focus-player-number)
            ; ;;(up-chat-data-to-all "I have smallest. Corner distance is %d." s: sn-corner-distance)
            (do-nothing)
            )

            (defrule
            (up-allied-goal focus-player gl-position == Flank)
                (goal gl-position Flank)
            (up-compare-const my-player-number s:!= sn-focus-player-number)
            (not(up-compare-sn sn-corner-distance g:< gl-opposite-corner-distance))
            (not(up-compare-sn sn-corner-distance g:> gl-opposite-corner-distance))
            (game-time > 5)
                        =>
            ;;(chat-to-all "Me and the other flank have same corner-distanse. Taking his market corner")
            (up-get-focus-fact allied-sn sn-market-point-x g-market-point-x)
            (up-get-focus-fact allied-sn sn-market-point-y g-market-point-y)
            (set-strategic-number sn-focus-player-number 8)
            )

            (defrule
            (strategic-number sn-focus-player-number < 8)
            (game-time > 5)
            =>
            (up-modify-sn sn-focus-player-number c:+ 1)
            (up-jump-rule -5)
            )


    ; Hunting
            ;******************************************************************************
            ;
            ; Boar lure
            ;
            ;******************************************************************************


                ;(defconst gl-position-self 110)
            ;(defconst gl-non-changing-position-self-x 110)
            ;(defconst gl-non-changing-position-self-y 111)
            ;(defconst boar-id 200)
            ;(defconst wild-boar 48)


            ;------------------------------
            ; Get Home Position
            ;------------------------------
            (defrule
                (game-time > 5)
            =>
                (up-get-point position-self gl-non-changing-position-self-x)
                ;(set-strategic-number sn-use-by-type-max-gathering 1)
                ;(disable-self)
            )



            ;******************************************************************************
            ;
            ; Boar lure
            ;
            ;******************************************************************************

            (defrule(game-time > 5)
            =>
            (set-strategic-number sn-boar-lure-destination 0)
            )


            ; Defining BOAR-STATUS as a goal with 4 fases
            ;(defconst BOAR-STATUS 5) 

            ;(defconst Starting-Boar-Lure 1)
            ;(defconst Planning-Boar-Attack 2)
            ;(defconst Killing-Boar 3)
            ;(defconst Eating-Boar 4)



            (defrule
                (game-time > 5)
                =>
                (enable-timer boar-timer 2)
                (disable-self)
            )

            ; 1 Starting-Boar-Lure 
            (defrule
            (dropsite-min-distance   live-boar < 35)
            (dropsite-min-distance   live-boar > 6)
                (unit-type-count villager > 7)
                (dropsite-min-distance boar-hunting < 35)
            (not(and(unit-type-count villager-hunter == 1)
            (game-time < 420)))
            (up-remaining-boar-amount == 65535)
            (not(up-remaining-boar-amount < 90))
            (not(goal BOAR-STATUS Starting-Boar-Lure))
            (timer-triggered boar-timer)
        =>	(set-goal gl-split-rule 150))


                (defrule
                (dropsite-min-distance   live-boar < 35)
                (dropsite-min-distance   live-boar > 6)
                    (unit-type-count villager > 7)
                    (dropsite-min-distance boar-hunting < 35)
                (not(and(unit-type-count villager-hunter == 1)
                (game-time < 420)))
                (up-remaining-boar-amount < 200)
                (not(up-remaining-boar-amount < 90))
                (not(goal BOAR-STATUS Starting-Boar-Lure))
                (timer-triggered boar-timer)
        =>	(set-goal gl-split-rule 150))

                (defrule
                (dropsite-min-distance   live-boar < 35)
                (dropsite-min-distance   live-boar > 6)
                (unit-type-count villager > 7)
                (dropsite-min-distance boar-hunting < 35)
                (not(and(unit-type-count villager-hunter == 1)
                (game-time < 420)))
                (goal gl-lure 2)
                (up-remaining-boar-amount < 220)
                (not(up-remaining-boar-amount < 90))
                (not(goal BOAR-STATUS Starting-Boar-Lure))
                (timer-triggered boar-timer)
        =>	(set-goal gl-split-rule 150))

        (defrule
	       (goal gl-split-rule 150)
                =>
                (set-strategic-number sn-maximum-hunt-drop-distance 35)
                (set-strategic-number sn-maximum-food-drop-distance 35)
                (set-strategic-number sn-food-dropsite-distance 0)
                (set-strategic-number sn-enable-boar-hunting 1)
                (set-strategic-number sn-minimum-number-hunters 1)
                    (set-strategic-number sn-minimum-boar-lure-group-size 0)
                (set-strategic-number sn-minimum-boar-hunt-group-size 0) 
            (set-goal BOAR-STATUS Starting-Boar-Lure))

            (defrule
                (timer-triggered boar-timer)
                (game-time > 5)
                =>
                (disable-timer boar-timer)
                (enable-timer boar-timer 5)
            )

            (defrule
            (goal BOAR-STATUS Starting-Boar-Lure)
            (game-time > 5)
            =>
            (set-strategic-number sn-focus-player-number 0)
                (up-reset-search 1 1 1 1)
                (up-reset-filters)
                (up-set-target-point gl-non-changing-position-self-x)
                (up-filter-distance c: 6 c: 35) ;min and max distance around the target-point
                (up-find-remote c: 910 c: 1)
                (up-set-target-object search-remote c: 0) ;set the boar as the target-object
                (up-reset-search 1 1 1 1)
                (up-reset-filters)
                (up-find-local c: villager-class c: 4)
                (up-remove-objects search-local object-data-hitpoints < 40)
                (up-remove-objects search-local object-data-index > 0)
                (up-target-objects 1 action-default -1 -1) ;right-click the boar with the villager
            (enable-timer boar-killing-timer 20)
            )
            (defrule
            (goal BOAR-STATUS Starting-Boar-Lure)
            (game-time > 5)
            =>
            (set-goal BOAR-STATUS Planning-Boar-Attack)
            )

            ;(up-get-object-data object-data-id boar-id)

            ; 2 Planning-Boar-Attack
            (defrule
                (goal BOAR-STATUS Planning-Boar-Attack)
                (game-time > 5)
                            =>
                                    (set-strategic-number sn-minimum-number-hunters 6)
                    (set-strategic-number sn-maximum-hunt-drop-distance 6)
                (set-goal BOAR-STATUS Killing-Boar)
                        )




            (defrule
                (timer-triggered boar-killing-timer)
                (dropsite-min-distance   live-boar < 35)
            (dropsite-min-distance   live-boar > 6)
            (game-time > 5)
                =>
                (enable-timer boar-killing-timer 90)
            )

            (defrule
                (timer-triggered boar-killing-timer)
            (game-time > 5)
                =>
                (enable-timer boar-killing-timer 9999)
            )

            ; 4 Eating-Boar (stop force dropping)
            (defrule
            (goal BOAR-STATUS Killing-Boar)
            (unit-type-count villager-hunter > 9)
            ;(not(up-remaining-boar-amount > 150))
            (game-time > 5)
            =>
            (set-goal BOAR-STATUS Eating-Boar)
            ;-chat-local-to-self "eating boar")
            )



            (defrule
                (current-age > dark-age)
                (game-time > 5)
                =>
                (set-strategic-number sn-maximum-food-drop-distance 8)
            )


    ; Economy
            ;******************************************************************************
            ;
            ; Houses
            ;
            ;******************************************************************************

            (defrule
                (game-time > 5)
                =>
                (set-strategic-number sn-enable-new-building-system 1)
                
            )


            ; First house

            (defrule
                (population-headroom > 0)
                (housing-headroom < 3)
                (building-type-count-total house == 0)
                (can-build house)
                (game-time > 5)
            =>
                (up-assign-builders c: house c: 2)
                (up-set-placement-data my-player-number villager c: 1)
                (up-build 2 0 c: house)
                )
                

            (defrule
                (up-pending-objects c: house == 1)
                (game-time > 5)
                    =>
                    (up-set-placement-data my-player-number villager c: 1)
                (up-build 2 0 c: house)
                (disable-self)
            )


            (defrule
                (building-type-count house > 0)
                (game-time > 5)
            =>
                (up-assign-builders c: house c: 1)
                (disable-self)
            )

            ; Houses in dark age

            (defrule
            (housing-headroom < 4)
            (population-headroom > 3)
            (up-pending-objects c: house < 1)
            (building-type-count house > 1)
            (game-time > 5)
            =>
            (build house)
            )



            ; Houses in feudal age and onwards

            ; Building houses if less than 4 pop space for units in dark age, less than 15 in feudal or less than 25 in castle or imperial age.
            ; When the game advances our economy becomes stronger and we've got more buildings training units
            (defrule
                (up-pending-objects c: house < 1)
                
                    (or	(and	(current-age >= feudal-age)
                            (housing-headroom < 15)
                        )
                        (current-age >= castle-age)
                    )
                
                (housing-headroom < 25)
                (population-headroom > 3) ; To avoid more houses if our pop space reaches the pop limit
                (game-time > 5)
                =>
                (build house)
            )

            ;******************************************************************************
            ;
            ; Researches der skal prioriteres over villagers
            ;
            ;******************************************************************************

            #load-if-defined MAYAN-CIV

            (defrule
                (game-time > 5)
                (can-research ri-loom)
                =>
                (research ri-loom)
            )

            #end-if


            (defrule
            ;(goal gl-anti-trush 1)
            (or(enemy-buildings-in-town)
            (or(up-enemy-villagers-in-town > 1)
            (players-unit-type-count sn-target-player-number lid-villager-stone-miner > 0)))
            (game-time > 5)
                =>
                (research ri-town-watch)
                )

            (defrule
                ;(current-age >= feudal-age)
                (unit-type-count-total villager > 7)
                ;(unit-type-count-total villager > 24)
                (game-time > 5)
                =>
                (research ri-loom)
            )

            #load-if-defined UP-POCKET-POSITION

            (defrule
                (building-type-count-total farm > 13)
                (research-available ri-wheel-barrow)
                (food-amount < 175)
                (wood-amount < 50)
                (game-time > 5)
                =>
                ;(set-escrow-percentage food 100)
                ;(set-escrow-percentage wood 50)
                ;(up-modify-escrow c:= food 175)
                ;(up-modify-escrow c:= wood 50)
                (do-nothing)
            )

            #end-if

            (defrule
                (building-type-count-total farm > 13)
                (food-amount >= 175)
                (wood-amount >= 50)
                (can-research-with-escrow ri-wheel-barrow)
                (game-time > 5)
            =>
            (release-escrow food)
                (release-escrow wood)
                (set-escrow-percentage food 0)
                (set-escrow-percentage wood 0)
            (research ri-wheel-barrow)
            )

            #load-if-defined UP-POCKET-POSITION

            (defrule
                (research-completed ri-wheel-barrow)
                (game-time > 5)
                =>
                (set-escrow-percentage food 0)
                (disable-self)
            )

            #end-if


            (defrule
                (building-type-count-total farm > 20)
                (game-time > 5)
            =>
                (research ri-hand-cart)
            )

            ;******************************************************************************
            ;
            ; Villager production, forcedrops and Loom
            ;
            ;******************************************************************************

            (defrule
            (goal gl-difficulty -1)
            (game-time > 5)
            =>
            (disable-timer difficulty-timer)
            )

            ;(defrule
            ; (food-amount > 420)
            ;   =>
            ; (research ri-loom)
            ; (enable-timer force-dropping-timer 23)
            ;)

            #load-if-not-defined UP-POCKET-POSITION

            (defrule
            (or(up-timer-status difficulty-timer == timer-disabled)
            (goal gl-difficulty 1))
            (current-age == dark-age)
            ;(unit-type-count-total villager < max-num-dark-villagers)
            ; (food-amount < 500)
            (can-train villager)
            (unit-type-count villager < 26)
            (game-time > 5)
            =>
            (train villager)
            (enable-timer force-dropping-timer 21)
            )

            #end-if

            #load-if-defined UP-POCKET-POSITION

            (defrule
            (or(up-timer-status difficulty-timer == timer-disabled)
            (goal gl-difficulty 1))
            (current-age == dark-age)
            ;(unit-type-count-total villager < max-num-dark-villagers)
            ; (food-amount < 500)
            (can-train villager)
            ;(unit-type-count villager < 26)
            (game-time > 5)
            =>
            (train villager)
            (enable-timer force-dropping-timer 21)
            )

            #end-if

            (defrule
                (timer-triggered force-dropping-timer)
                (current-age == dark-age)
                (and(unit-type-count-total villager < 19)
                (food-amount < 50))
            
            (not (goal BOAR-STATUS Planning-Boar-Attack))
                ;Check that I will be unable to train villagers to prevent wasted force-drop (Don�t use can-train because with busy TC will never be true)
                (game-time > 5)=>

                (up-drop-resources food c: 3) ;A relatively low amount is good here to ensure you get every last bit to ensure you have enough
            )

            (defrule
                (timer-triggered force-dropping-timer)
                    (food-amount > 300)
                        (food-amount < 500)
                        (unit-type-count-total villager > 23)
                (not (goal BOAR-STATUS Planning-Boar-Attack))
                ;Check that I will be unable to train villagers to prevent wasted force-drop (Don�t use can-train because with busy TC will never be true)
                (game-time > 5)
                =>
                (up-drop-resources food c: 15) ;A relatively low amount is good here to ensure you get every last bit to ensure you have enough
            )

            (defrule
                (timer-triggered force-dropping-timer)
                    (food-amount > 400)
                            (food-amount < 500)
                            (unit-type-count-total villager > 23)
                (not (goal BOAR-STATUS Planning-Boar-Attack))
                ;Check that I will be unable to train villagers to prevent wasted force-drop (Don�t use can-train because with busy TC will never be true)
                (game-time > 5)
                =>
                (up-drop-resources food c: 10) ;A relatively low amount is good here to ensure you get every last bit to ensure you have enough
            )

            (defrule
                (timer-triggered force-dropping-timer)
                    (food-amount > 450)
                            (food-amount < 500)
                            (unit-type-count-total villager > 23)
                (not (goal BOAR-STATUS Planning-Boar-Attack))
                ;Check that I will be unable to train villagers to prevent wasted force-drop (Don�t use can-train because with busy TC will never be true)
                (game-time > 5)
                =>
                (up-drop-resources food c: 3) ;A relatively low amount is good here to ensure you get every last bit to ensure you have enough
            )

            (defrule
            (or(up-timer-status difficulty-timer == timer-disabled)(goal gl-difficulty 1))
            (current-age == dark-age)
            ;(unit-type-count-total villager < max-num-dark-villagers)
            (food-amount >= 500)
            (wood-amount < 125 )
            (building-type-count-total mill == 1) 
            (unit-type-count villager < 26)
            (game-time > 5)
            =>
            (train villager)
            )

            (defrule
                (true)
                =>
                (set-goal gl-priority-knights NO)
            )

            (defrule
                (gold-amount > 100)
            (unit-type-count-total knight-line < 10)
            (up-pending-objects c: villager > 0)
            (up-pending-objects c: knight-line == 0)
            (unit-type-count-total villager < 50)
                =>
                (set-goal gl-priority-knights YES)
                ;;(chat-to-all "prioritysing knights over villagers")
            )
 
        (defrule
        (or	(current-age == dark-age)
            (or	(game-time < 5)
                (or	(unit-type-count-total villager >= 130)
                    (or	(civilian-population >= 130)
                        (up-compare-goal gl-priority-knights != NO)))))
        =>	(up-jump-rule 5))

        (defrule     
                (up-timer-status difficulty-timer != timer-disabled)
            (up-compare-goal gl-difficulty != 1)
        =>	(up-jump-rule 4))
           
        (defrule     
                (not(and(unit-type-count-total villager > 80)
                (unit-type-count-total trade-cart > 25)))
                (not(and(unit-type-count-total villager > 70)
                (and(military-population > 15)
                (and(research-available imperial-age)
                (goal gl-position Flank)))))
        =>	    (set-goal gl-split-rule 151))
        (defrule
            (goal gl-split-rule 151)
                (not(and(unit-type-count farm > 20)
                (research-available ri-wheel-barrow)))
                (not(and(goal gl-position Flank)
                (unit-type-count villager > 55)))
                (not(and(goal gl-saving-for-imp 1)
                (food-amount > 700)))
                
        =>          
        (set-goal gl-split-rule 2235)
            )

            (defrule
                (goal gl-split-rule 2235)
                (not(and(food-amount > 600)
                    (and(gold-amount > 150)
                    (and(unit-type-count-total villager >= 29)
                    (current-age == feudal-age)))))
                =>
                (up-train 101 c: villager)
            )


        (defrule         
                (not(and(unit-type-count-total villager > 80)
                (unit-type-count-total trade-cart > 25)))
                (goal gl-position Flank)
                (not(and(unit-type-count farm > 20)
                (research-available ri-wheel-barrow)))
                (up-players-in-game enemy <= 2)
                (up-compare-goal gl-MILITARY-SUPERIORITY > -10)
                (not(and(goal gl-saving-for-imp 1)
                (food-amount > 700)))
        =>          (up-train 101 c: villager))

                (defrule       
                    (or (goal gl-position Pocket)
                    (up-compare-goal gl-MILITARY-SUPERIORITY > -25))
                (not(and(unit-type-count-total villager > 80)
                (unit-type-count-total trade-cart > 25)))
                (not(and(unit-type-count farm > 20)
                (research-available ri-wheel-barrow)))
                (not(and(goal gl-position Flank)
                (unit-type-count villager > 65)))
       =>          
        (set-goal gl-split-rule 2236)
            )

            (defrule
                (goal gl-split-rule 2236)
                (not(and(food-amount > 600)
                    (and(gold-amount > 150)
                    (and(unit-type-count-total villager >= 29)
                    (current-age == feudal-age)))))
                =>
                (train villager)
            )      


                (defrule              
                (or(up-timer-status difficulty-timer == timer-disabled)(goal gl-difficulty 1))     
                (current-age == castle-age) 
                (unit-type-count-total villager < 130)
                (civilian-population < 130)
                (not(and(unit-type-count-total villager > 80)
                (unit-type-count-total trade-cart > 25)))
                (not(and(unit-type-count farm > 20)
                (research-available ri-wheel-barrow)))
        =>	(set-goal gl-split-rule 152))
        (defrule
        (goal gl-split-rule 152)
                (goal gl-position Flank)
                (not(and(goal gl-saving-for-imp 1)
                (and(food-amount > 700)
                (up-compare-goal gl-age-status == Castle))))
                (up-compare-goal gl-MILITARY-SUPERIORITY > 0)
                =>
                (up-train 101 c: villager))

                (defrule              
                (or(up-timer-status difficulty-timer == timer-disabled)(goal gl-difficulty 1))     
                (up-compare-goal gl-age-status >= advancing-to-imperial) 
                (unit-type-count-total villager < 120)
                (civilian-population < 120)
                (not(and(unit-type-count-total villager > 80)
                (unit-type-count-total trade-cart > 25)))
                (not(and(unit-type-count farm > 20)
                (research-available ri-wheel-barrow)))
        =>	(set-goal gl-split-rule 153))
        (defrule    
        (goal gl-split-rule 153)
            (goal gl-position Flank)
            (not(and(research-available ri-arbalest)
            (and(food-amount < 400)
            (gold-amount > 300))))
            (up-compare-goal gl-MILITARY-SUPERIORITY > -25)
            =>
                (up-train 101 c: villager))

            (defrule
            (or(up-timer-status difficulty-timer == timer-disabled)(goal gl-difficulty 1))
            (food-amount < 50)
            (can-research ri-loom)
            ;(timer-triggered force-dropping-timer)
            (game-time > 5)
                =>
            (research ri-loom)
            (enable-timer force-dropping-timer 22)
            )

            (defrule
            (current-age == feudal-age)
            (game-time > 5)
            =>
            (research ri-loom)
            (enable-timer force-dropping-timer 22)
            )

            (defrule
            (current-age > feudal-age)
            (players-population any-ally > 10)
                (civilian-population > 65)
                    (not(and(current-age == imperial-age)
                (research-available ri-cavalier)))

                (unit-type-count trade-cart >= 7)
                (game-time > 5)
                =>
                (research ri-caravan)
            )

            (defrule
            (current-age > feudal-age)
            (players-population any-ally > 10)
                (civilian-population > 75)
                (unit-type-count trade-cart < 50)
                (civilian-population < 150)
                (not(and(current-age == imperial-age)
                (research-available ri-cavalier)))
                (not(research-available ri-chain-barding))
                (not(research-available ri-bloodlines))
                =>
                (set-strategic-number sn-preferred-trade-distance 9999)
                (set-strategic-number sn-coop-share-information 1)
                (train trade-cart)
            )

            ;******************************************************************************
            ;
            ; Researches der prioriteres under villagers
            ;
            ;******************************************************************************

            #load-if-not-defined UP-POCKET-POSITION

            (defrule
            (current-age > dark-age)
            (not(and(current-age == imperial-age)
            (and(not(research-completed ri-plate-barding))
            (not(research-completed ri-cavalier)))))
            (food-amount >= 150)
            (game-time > 5)
            =>
            (research ri-double-bit-axe)
                (research ri-bow-saw)
                (research ri-two-man-saw)
            )


            (defrule
                    (or(and(current-age >= castle-age)
                    (building-type-count town-center > 1))
                    (goal gl-age-status Castle))
                    (food-amount > 125)
                        (not(research-available ri-crossbow))
                    (not(research-available ri-bodkin-arrow))
                    (game-time > 5)
                =>
                (research ri-horse-collar)
            )

            #end-if

            #load-if-defined UP-POCKET-POSITION

            (defrule
            (or(goal gl-age-status advancing-to-castle)
                (current-age >= castle-age))
            (not(and(current-age == imperial-age)
            (and(not(research-completed ri-plate-barding))
            (not(research-completed ri-cavalier)))))
            (food-amount >= 150)
            (game-time > 5)
            =>
            (research ri-double-bit-axe)
                (research ri-bow-saw)
                (research ri-two-man-saw)
            )

            (defrule
                (can-research ri-heavy-plow)
                (building-type-count-total town-center > 1)
                (or(unit-type-count knight-line > 1)
                (unit-type-count villager > 45))
                (food-amount >= 175)
                (game-time > 5)
                =>
                (research ri-heavy-plow)
            )

            (defrule
                    (or(goal gl-age-status advancing-to-castle)
                (current-age >= castle-age))
                ;(food-amount > 125)
                (game-time > 5)
                    =>
                (research ri-horse-collar)
            )

            #end-if

            (defrule
                (building-type-count-total barracks >= 1)
                (or(building-type-count-total archery-range >= 1)
                (building-type-count-total stable >= 1))
            (not(research-available ri-double-bit-axe))
            (not(research-available ri-bow-saw))
            (current-age == imperial-age)
            (not(research-available ri-cavalier) )
            (not(research-available ri-plate-barding))
            (game-time > 5)
            =>
                (research ri-heavy-plow)
                )

            (defrule
            (not(research-available ri-two-man-saw))
                (building-type-count-total barracks >= 1)
                (building-type-count-total archery-range >= 1)
                (building-type-count-total stable >= 1)
                (game-time > 5)
            =>
            (research ri-crop-rotation)
            )

            (defrule
                (current-age >= castle-age)
                (not(research-available ri-double-bit-axe))
            (not(research-available ri-bow-saw))
                (not(research-available ri-cavalier) )
            (not(research-available ri-plate-barding))
            (building-type-count town-center > 1)
            (game-time > 5)
            (unit-type-count-total villager > 50)
            (unit-type-count-total villager-gold > 10)
            =>
                (research ri-gold-mining)
            )

            (defrule
                (nor	(research-available ri-bow-saw)
                    (research-available ri-heavy-plow)
                    
                )
                (not(research-available ri-cavalier) )
            (not(research-available ri-plate-barding) )
            =>
                (research ri-gold-shaft-mining)
            )

            (defrule
                (current-age >= castle-age)
                (unit-type-count-total villager >= TOP-VILLAGERS)
                (building-type-count-total barracks >= 1)
                (building-type-count-total archery-range >= 1)
                (building-type-count-total stable >= 1)
                (building-type-count-total monastery >= 1)
                (building-type-count-total university >= 1)
                (building-type-count-total market >= 1)
                (not(research-available ri-gold-mining))
                (nor	(research-available ri-bow-saw)
                    (research-available ri-heavy-plow)
                )
            =>
                (research ri-stone-mining)
                (research ri-stone-shaft-mining)
            )

            ; We research town watch when we needn't more villagers or enemy is forward building, to make our AI more resistant to tower rushes (trushes)


            (defrule
                (current-age == imperial-age)
                (or	(unit-type-count-total villager >= TOP-VILLAGERS)
                    (enemy-buildings-in-town)
                )
                (can-research ri-town-patrol)
                (not(research-available ri-cavalier) )
            (not(research-available ri-plate-barding) )
            (game-time > 5)
            =>
                (research ri-town-patrol)
            )


    ; Mills and farms
            ;******************************************************************************
            ;
            ; Mills (exept deer mills)
            ;
            ;******************************************************************************

            (defrule
            (building-type-count-total house > 1) 
            (building-type-count-total mill == 0) 
            (resource-found food) 
            (not(up-pending-objects c: house > 0))
            (game-time > 10)
            (can-build mill)
            ;(unit-type-count villager > 11)
            ;(unit-type-count LIVESTOCK-GROUP < 1)
            (game-time > 5)
            =>
            ;(up-build 2 2 c: mill)
            (set-strategic-number sn-allow-adjacent-dropsites 0)
            (build mill)
            )

            (defrule
            (building-type-count mill > 0)
            (game-time > 5)
            =>
            (set-strategic-number sn-allow-adjacent-dropsites 1)
            (disable-self)
            )

            #load-if-not-defined UP-POCKET-POSITION

            (defrule
            (current-age > dark-age)
                (building-type-count farm > 24)
            (building-type-count-total mill < 2)
            (can-build mill)
            (game-time > 5)
            =>
                (set-strategic-number sn-mill-max-distance 14)
                (build mill)
            )

            #end-if

            (defrule
        (or	(and	(building-type-count farm > 41)
                (building-type-count-total mill < 3))
            (or	(and	(building-type-count farm > 52)
                    (building-type-count-total mill < 4))
                (and	(building-type-count farm > 60)
                    (building-type-count-total mill < 5))))
        (can-build mill)
        (game-time > 5)
                =>
        (build mill))

            (defrule
            (building-type-count farm > 30)
            (building-type-count-total mill < 2)
            (can-build mill)
            (game-time > 5)
            =>
            (build mill))



            ;******************************************************************************
            ;
            ; Farms
            ;
            ;******************************************************************************

            #load-if-not-defined UP-POCKET-POSITION

            (defrule
            (goal gl-age-status dark)
            (wood-amount > 400)
            (can-build farm)
            ;(not(up-pending-objects c: farm > 0))
            (game-time > 5)
            =>
            (build farm)
            ) ; for at kompenserer hvis buggen med 1 food forcedrop s�tter ind

            (defrule
            (current-age == dark-age)
            (idle-farm-count < 6)
            (up-pending-objects c: farm < 4)
            (wood-amount > 100)
            (not(up-pending-objects c: farm > 0))
            (building-type-count lumber-camp > 1)
            (or(building-type-count farm < 0)
            (and(building-type-count farm < 1)
            (unit-type-count-total villager > 24)))
        =>	    (set-goal gl-split-rule 154))

            (defrule
	    (goal gl-split-rule 154)
            (not(and(building-type-count-total farm > 5)
            (building-type-count-total barracks == 0)))
            =>
                (build farm))

            (defrule
            (current-age == feudal-age)
            (idle-farm-count < 6)
            (up-pending-objects c: farm < 4)
            (wood-amount > 125)
            (building-type-count-total archery-range > 1)
            (not(and(building-type-count farm > 13)
            (goal g-enemy-is-walled 1)))
            (not(and(building-type-count market == 0)
            (and(building-type-count farm > 15)
            (up-pending-objects c: market == 0))))
        =>	    (set-goal gl-split-rule 155))

            (defrule
	    (goal gl-split-rule 155)
            (building-type-count lumber-camp > 0)
            (building-type-count-total mining-camp > 0)
                (not(and(building-type-count-total farm > 3)
            (building-type-count-total barracks == 0)))
                (not (goal gl-age-status advancing-to-castle))
                (not(and(building-type-count blacksmith == 0)
            (and(building-type-count farm > 1)
            (up-pending-objects c: blacksmith == 0))))
                =>
                (build farm))

            (defrule ;trush farms
            (current-age == feudal-age)
            (or(idle-farm-count < 4)
            (and(idle-farm-count < 16)
            (enemy-buildings-in-town)))
            (up-pending-objects c: farm < 4)
            (wood-amount > 125)
            (enemy-buildings-in-town)
            (or(building-type-count farm < 14)
            (building-type-count market > 0))
        =>	    (set-goal gl-split-rule 156))

            (defrule
	    (goal gl-split-rule 156)
            (building-type-count-total archery-range > 0)
            (building-type-count lumber-camp > 0)
            (building-type-count-total mining-camp > 0)
                (not(and(building-type-count-total farm > 3)
            (building-type-count-total barracks == 0)))
                (not (and(goal gl-age-status advancing-to-castle)
                (wood-amount < 400)))
                (game-time > 5)
                    =>
                (build farm))

            ; disse to regler er til henholdsvis ikke towerrush feudal og tower rush feudal

        (defrule
        (current-age == castle-age)
        (idle-farm-count < 10)
        (up-pending-objects c: farm < 4)
        (wood-amount > 200)
        (building-type-count-total town-center > 1)
        (goal g-enemy-is-walled 1)
        (not	(and	(building-type-count farm > 33)
            (wood-amount < 300)))
        =>	    (set-goal gl-split-rule 157))

        (defrule    
        (current-age == castle-age)
        (idle-farm-count < 10)
        (up-pending-objects c: farm < 4)
        (wood-amount > 200)
        (building-type-count-total town-center > 1)
        (goal g-enemy-is-walled 0)
        (or	(building-type-count stable > 1)
            (or	(building-type-count-total town-center > 1)
                (wood-amount > 350)))
        (not	(and	(building-type-count farm > 33)
            (wood-amount < 300)))
        =>	    (set-goal gl-split-rule 157))


        (defrule    
        (goal gl-split-rule 157)
        (nor	(and	(building-type-count-total town-center < 2)
                (or	(building-type-count-total farm > 17)
                    (and	(building-type-count-total farm > 13)
                        (goal g-enemy-is-walled 1))))
            (and	(building-type-count-total town-center < 3)
                (building-type-count-total farm > 20)))
        =>	(build farm))

           

            (defrule
            (current-age == castle-age)
            (idle-farm-count < 10)
            (up-pending-objects c: farm < 4)
            (wood-amount > 125)
            (building-type-count-total town-center > 1)
            (building-type-count farm < 32)
            ;(set-goal SAVING-FOR-IMP 0)
            (or(and(building-type-count-total siege-workshop > 0)
            (building-type-count-total monastery > 0))
            (and(building-type-count-total university > 0)
            (building-type-count-total monastery > 0)))
            (game-time > 5)
            =>
                (build farm)
                )



            (defrule
                (current-age == imperial-age)
            (idle-farm-count < 15)
            (up-pending-objects c: farm < 4)
            (wood-amount > 125)

            (nor
            (and(building-type-count-total town-center < 2)
            (building-type-count-total farm > 20))
            (and(building-type-count-total town-center < 3)
            (building-type-count-total farm > 25)))

            ; (building-type-count stable > 1)
                (game-time > 5)
            =>
                (build farm)
                )
            
            #end-if



            #load-if-defined UP-POCKET-POSITION

            (defrule
            (current-age <= feudal-age)
            (or(building-type-count farm < 6)
            (and(goal gl-age-status advancing-to-castle)
            (and(building-type-count farm < 10)
            (research-completed ri-horse-collar))))
            (building-type-count mining-camp > 0)
            (up-pending-objects c: farm < 4)
            (wood-amount > 100)
            (or(up-pending-objects c: farm == 0)
            (goal gl-age-status advancing-to-castle))
            (game-time > 5)
                =>
            (build farm)
            ) 

            (defrule
            (or(goal gl-age-status advancing-to-castle)
            (and(current-age == castle-age)
            (building-type-count-total town-center > 1)))
            (research-completed ri-horse-collar)
            (up-pending-objects c: farm == 0)
            (wood-amount >= 90)
            (can-build farm)
            =>
            (set-goal gl-split-rule 158))

            (defrule
            (goal gl-split-rule 158)
            (or(building-type-count farm < 11)
            (and(building-type-count farm <= 15)
            (or(building-type-count-total town-center > 1)
            (or(up-pending-objects c: town-center == 1)
            (up-pending-objects c: town-center-foundation == 1)))))
            (not(and(research-available ri-double-bit-axe)
            (wood-amount < 110)))
            (game-time > 5)
                =>
            (build farm)
            ) 

            (defrule
            (current-age == castle-age)
            (up-pending-objects c: farm < 5)
            (wood-amount > 90)
            (idle-farm-count < 9)
            (game-time > 5)
            =>
            (set-goal gl-split-rule 159))

            (defrule
            (goal gl-split-rule 159)
            (or(building-type-count-total town-center > 1)
            (or(up-pending-objects c: town-center-foundation > 0)
            (up-pending-objects c: town-center > 0)))
            (not(and(building-type-count-total town-center < 3)
            (building-type-count-total farm > 25)))
            (not(and(building-type-count farm > 38)
            (wood-amount < 300)))
                =>
                (up-build place-normal 1 c: farm)
                )

            (defrule
                (current-age == imperial-age)
            (idle-farm-count < 15)
            (up-pending-objects c: farm < 4)
            (wood-amount > 125)
            (game-time > 5)
            =>
                (build farm)
                )
            
            #end-if
    ; Lumber and mining camps
            ;******************************************************************************
            ;
            ; Lumber camps
            ;
            ;******************************************************************************


            (defrule
                (building-type-count-total town-center >= 1)
                (not(resource-found wood))
                (strategic-number sn-camp-max-distance == 10)
                (game-time < 2)
                (game-time > 5)
            =>
                (set-strategic-number sn-camp-max-distance 10)
                (chat-local-to-self "Camp distance 10.")
                (disable-self)
            )

            (defrule
                (building-type-count-total town-center >= 1)
                (not(resource-found wood))
                (strategic-number sn-camp-max-distance == 10)
                (game-time < 4)
                (game-time > 5)
                =>
                (set-strategic-number sn-camp-max-distance 12)
                (chat-local-to-self "Camp distance 12.")
                (disable-self)
            )

            ;(defrule
                ;(building-type-count-total town-center >= 1)
                ;(not(resource-found wood))
                ;(strategic-number sn-camp-max-distance == 8)
                ;(game-time < 12)
                ;=>
                ;(set-strategic-number sn-camp-max-distance 15)
                ;(chat-local-to-self "Camp distance 15.")
                ;(disable-self)
            ;)

            (defrule
            (building-type-count-total mill > 0)
            (building-type-count-total lumber-camp == 0)
            (resource-found wood)
            (wood-amount > 125)
            (can-build lumber-camp)
            (game-time > 5)
            =>
            (build lumber-camp)
            )

            ;(defrule
            ;(building-type-count-total lumber-camp == 1)
            ;(dropsite-min-distance wood > 0)
            ;=>
            ;(delete-building lumber-camp)
            ;(set-strategic-number sn-camp-max-distance 12)
            ;) 
            ; virker ikke fordi spillet ikke kan genkende foundation som en lumbercamp.

            (defrule
            (game-time < 10)
            (building-type-count-total lumber-camp > 0)
            (game-time > 5)
            =>
            (set-strategic-number sn-camp-max-distance 13)
            (disable-self)
            )

            (defrule
            (building-type-count-total lumber-camp > 0)
            (building-type-count-total lumber-camp < 2)
            (or(current-age >= feudal-age)
                (goal gl-age-status advancing-to-feudal))
            (dropsite-min-distance wood > 3)
                (can-build lumber-camp)
                (game-time > 5)
            =>
                (build lumber-camp)
            )

            (defrule
            (building-type-count-total lumber-camp == 1)
            (up-pending-objects c: lumber-camp == 0)
            (unit-type-count-total villager-wood > 4)
            (game-time > 5)
            =>
            (set-strategic-number sn-camp-max-distance 13)
            (build lumber-camp)
            )

            (defrule
            (building-type-count-total lumber-camp == 1)
            (game-time > 5)
            =>
                (set-strategic-number sn-wood-dropsite-distance 2)
            )

            (defrule
            (building-type-count-total lumber-camp > 1)
            (game-time > 5)
            =>
                (set-strategic-number sn-wood-dropsite-distance 5)
            )

            (defrule
            (or(and(building-type-count-total lumber-camp < 3)
            (unit-type-count villager-wood > 28))
            (and(unit-type-count villager-wood > 35)
            (building-type-count-total lumber-camp < 4)))
            (game-time > 5)
                    =>
            (build lumber-camp)
            )

            (defrule
                (building-type-count-total lumber-camp >= 2)
                (current-age >= feudal-age)
                (strategic-number sn-camp-max-distance < 16)
                (game-time > 5)
            =>
                (set-strategic-number sn-camp-max-distance 28)
                (chat-local-to-self "Camp distance 28.")
            )

            (defrule
            (or(and(building-type-count-total lumber-camp < 5)
            (unit-type-count villager-wood > 42))
            (and(unit-type-count villager-wood > 49)
            (building-type-count-total lumber-camp < 6)))
            (game-time > 5)
                    =>
            (build lumber-camp)
            )

            (defrule
                (building-type-count-total lumber-camp >= 4)
                (current-age >= castle-age)
                (strategic-number sn-camp-max-distance < 26)
                (or(up-players-in-game enemy <= 2)
                (building-type-count town-center > 2))
                (game-time > 5)
            =>
                (set-strategic-number sn-camp-max-distance 35)
                (chat-local-to-self "Camp distance 35.")
                )

            (defrule
            (or(and(building-type-count-total lumber-camp < 7)
            (unit-type-count villager-wood > 55))
            (and(unit-type-count villager-wood > 60)
            (building-type-count-total lumber-camp < 8)))
            (game-time > 5)
                    =>
            (build lumber-camp)
            )

            (defrule
                (building-type-count-total lumber-camp >= 6)
                (current-age >= castle-age)
                (strategic-number sn-camp-max-distance < 33)
                (or(up-players-in-game enemy <= 2)
                (building-type-count town-center > 2))
                (game-time > 5)
            =>
                (set-strategic-number sn-camp-max-distance 45)
                (chat-local-to-self "Camp distance 45.")
                )

            ; ekstra - ved ikke hvilke jeg vil bruge endnu

            (defrule ;Copied from The Horde, by Archon/Zergs
                (resource-found wood)
                (or	(and	(unit-type-count villager >= 70)
                        (building-type-count-total lumber-camp < 3)
                    )
                    (and	(unit-type-count villager >= 95)
                        (building-type-count-total lumber-camp < 5)
                    )
                )
                (can-build lumber-camp)
            (game-time > 5) =>
                (build lumber-camp)
            )

            ; Rule taken from Echidna, to avoid woocutters killed by enemy units which are attack a single luber camp
            

            (defrule
                (dropsite-min-distance wood > 9)
                (can-build lumber-camp)
            (game-time > 5) =>
                (build lumber-camp)
            )

            ;******************************************************************************
            ;
            ; Mining camps
            ;
            ;******************************************************************************

            (defrule
                (unit-type-count villager > 18)
                (game-time > 5) =>
                (set-strategic-number sn-camp-max-distance 15)
                (disable-self)
            )

            (defrule
                (unit-type-count villager > 23)
                (building-type-count-total mining-camp < 1)
                (game-time > 5) =>
                (set-strategic-number sn-camp-max-distance 19)
                (disable-self)
            )

            (defrule
                (or(current-age == feudal-age)
                (goal gl-age-status advancing-to-feudal))
                (building-type-count-total mining-camp < 1)
                (building-type-count lumber-camp >= 4)
                (game-time > 5) =>
                (set-strategic-number sn-camp-max-distance 22)
            )

            (defrule
            (building-type-count-total lumber-camp > 0)
                        (resource-found gold)
                            ;(building-type-count-total farm > 0)
                    ;	 (building-type-count-total barracks > 0)
                            (building-type-count-total mining-camp < 1)
            (game-time > 5) =>
            (set-strategic-number sn-allow-adjacent-dropsites 0)
            (build mining-camp)
            )

            (defrule
            (building-type-count-total mining-camp > 3)
            (or(up-players-in-game enemy <= 2)
                (building-type-count town-center > 2))
            (game-time > 5) =>
            (set-strategic-number sn-allow-adjacent-dropsites 1)
            (set-strategic-number sn-camp-max-distance 27)
            )

            (defrule
            (building-type-count-total barracks > 0)
            (or(and(building-type-count-total mining-camp < 2)
            (unit-type-count villager-gold > 10))
            (and(unit-type-count villager-gold > 17)
            (building-type-count-total mining-camp < 3)))
            (building-type-count-total town-center > 1)
                    (game-time > 5) =>
                    (set-strategic-number sn-allow-adjacent-dropsites 0)
            (build mining-camp)
            )

            
            (defrule
            (or(and(building-type-count-total mining-camp < 4)
            (unit-type-count villager-gold > 23))
            (and(unit-type-count villager-gold > 28)
            (building-type-count-total mining-camp < 5)))
            (building-type-count-total town-center > 1)
                    (game-time > 5) =>
                    (set-strategic-number sn-allow-adjacent-dropsites 0)
            (build mining-camp)
            )

            (defrule
                (building-type-count-total mining-camp < 5)
                ;(building-type-count-total mining-camp < 20)
                (game-time > 2300)
                (unit-type-count-total villager-gold < 20)
                (game-time > 5) =>
                (build mining-camp)
                (disable-self)
            )

            (defrule
                (building-type-count-total mining-camp < 9)
                ;(building-type-count-total mining-camp > 20)
                (game-time > 3001)
                (unit-type-count-total villager-gold < 20)
                (game-time > 5) =>
                (build mining-camp)
                (disable-self)
            )

            (defrule
                (building-type-count-total mining-camp < 3)
                (unit-type-count villager-stone > 2)
                (game-time > 5) =>
                (build mining-camp)
                (disable-self)
            )

            (defrule
                (strategic-number sn-camp-max-distance < HALF-MAP-SIZE)
                (game-time > 1500)
                (or	(game-time > 2500)
                    (building-type-count-total mining-camp >= 4)
                )
            (game-time > 5) =>
                (set-strategic-number sn-camp-max-distance HALF-MAP-SIZE)
                (disable-self)
            )

            (defrule
                (strategic-number sn-camp-max-distance < FULL-MAP-SIZE)
                (game-time > 2500)
                (or	(game-time > 3600)
                    (population >= 130)
                )
            (game-time > 5) =>
                (set-strategic-number sn-camp-max-distance FULL-MAP-SIZE)
            )

