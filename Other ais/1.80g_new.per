            #load-if-not-defined UP-POCKET-POSITION

            (defrule
                (game-time > 600)
                (game-time > 5) =>
                (up-send-scout group-type-land-explore position-flank)
                (disable-self)
            )

            (defrule
                (game-time > 610)
                (game-time > 5) =>
                (up-send-scout group-type-land-explore position-flank)
                (disable-self)
            )

            (defrule
                (goal gl-TC-FOUND 1)
                (game-time > 5)
                (game-time > 5) =>
                (up-send-scout group-type-land-explore position-self)
                (enable-timer t-tc-found 15)
                (disable-self)
            )


            (defrule
                (or(timer-triggered t-tc-found)
                (game-time == 595))
                (game-time > 5)
