            ;;;(up-chat-data-to-all "waiting points for mill deletion %d." g: g-mill-deleter)
            )

            (defrule
                (up-compare-goal g-mill-deleter > 4)
                (current-age > dark-age)
                (game-time > 5) =>
                ;  (up-delete-objects c: mill c: 799) ; 

                (delete-building mill) ; issue the move command.
            (set-goal g-mill-deleter 0)
            )


            ;******************************************************************************
            ;
            ; Building up for a timing push against trush
            ;
            ;******************************************************************************

            (defrule
                (current-age >= feudal-age)
                (building-type-count-total archery-range < 1)
                (can-build archery-range)
                (enemy-buildings-in-town)
            (game-time > 5) =>
                ;(build archery-range)
                (set-strategic-number sn-placement-zone-size 3)
            (up-set-placement-data my-player-number -1 c: -7) ;build watch tower 20 tiles in front of home TC
            (up-build place-control 0 c: archery-range)
            )

            (defrule
                (current-age == castle-age)
                (building-type-count siege-workshop < 1)
            (up-pending-objects c: siege-workshop == 0)
                (enemy-buildings-in-town)
                (players-building-type-count target-player watch-tower-line > 3)
                (game-time > 5) =>
                (set-escrow-percentage wood 100)
            ;-chat-local-to-self "saving wood for seige")
            (up-modify-escrow wood c:= 200)
            ;(set-goal SAVING-FOR-IMP 1)
            (disable-self)
            )

            (defrule
                (can-build-with-escrow siege-workshop)
                (up-pending-objects c: siege-workshop == 0)
                (or(enemy-buildings-in-town)
                (or(players-building-type-count target-player watch-tower-line > 3)
                (wood-amount > 800)))
                (building-type-count siege-workshop < 1)
                (players-building-type-count target-player watch-tower-line > 2)
                (game-time > 5) =>
                (release-escrow wood)
                    (set-escrow-percentage wood 0)
                (up-assign-builders c: siege-workshop c: 3)
            (set-strategic-number sn-placement-zone-size 12)
            (up-set-placement-data my-player-number -1 c: -10) ;build watch tower 20 tiles in front of home TC
            (up-build place-control 0 c: siege-workshop)
            )

            (defrule
            
                (wood-amount > 400)
                
                (game-time > 5) =>
                (release-escrow wood)
                (set-escrow-percentage wood 0)
            )

            (defrule
                (enemy-buildings-in-town)
                (unit-type-count battering-ram-line < 3)
                (game-time > 5) =>
                (train battering-ram-line)
            )

            (defrule
                (unit-type-count battering-ram-line < 2)
                (enemy-buildings-in-town)
                (game-time > 5) =>
            (up-gather-inside c: siege-workshop c: 1)  
            )

            (defrule
            (or  (unit-type-count battering-ram-line > 1)
            (game-time > 2100))
                (game-time > 5) =>
            (up-gather-inside c: siege-workshop c: 0)
                )


            ;******************************************************************************
            ;
            ; Regulating military tower avoidans
            ;
            ;******************************************************************************

            

            (defrule
                (true)
                (game-time > 5) =>
                (enable-timer trush-defense-timer 5)
                (disable-self)

            )

                (defrule
                ; (game-time > 800)
                (timer-triggered trush-defense-timer)
                    (game-time > 5) =>
                (up-set-attack-stance knight-line c: stance-aggressive)
                    ;(up-set-attack-stance skirmisher-line c: stance-aggressive)
                    ;(up-set-attack-stance archer-line c: stance-aggressive)
                    (up-set-attack-stance battering-ram-line c: stance-aggressive)
                        )

                        (defrule
                            (timer-triggered trush-defense-timer)
                            (game-time > 5) =>
                            (disable-timer trush-defense-timer)
                            (enable-timer trush-defense-timer 10)
                        )

