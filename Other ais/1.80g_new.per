                    (up-remove-objects search-local object-data-index != 0)
                    (up-remove-objects search-local object-data-target == building-class)
                )

                (defrule
                    (up-set-target-object search-local c: 0)
                    (building-type-count-total house >= 1)
                    (building-type-count house == 0)
                    =>
                    (up-target-objects 0 action-default -1 -1)

                )

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-filter-status c: status-pending c: list-active)
                    (set-strategic-number sn-focus-player-number my-player-number)
                    (up-find-status-remote c: building-class c: 2)
                    (up-remove-objects search-remote object-data-index == 0)
                )

                (defrule
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-find-local c: villager-class c: 4)
                    (up-get-point position-object gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-clean-search search-local object-data-distance search-order-asc)
                    (up-remove-objects search-local object-data-index != 0)
                    (up-remove-objects search-local object-data-target == building-class)
                )

                (defrule
                    (up-set-target-object search-local c: 0)
                    (building-type-count-total house >= 1)
                    (building-type-count house == 0)
                    =>
                    (up-target-objects 0 action-default -1 -1)

                )

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-filter-status c: status-pending c: list-active)
                    (set-strategic-number sn-focus-player-number my-player-number)
                    (up-find-status-remote c: building-class c: 2)
                )

                (defrule
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-find-local c: villager-class c: 4)
                    (up-remove-objects search-local object-data-target == building-class)
                    (up-clean-search search-local -1 search-order-asc)
                    (up-remove-objects search-local object-data-index != 0)
                )

                (defrule
                    (up-set-target-object search-local c: 0)
                    (building-type-count-total house >= 1)
                    (building-type-count house == 0)
                    =>
                    (up-get-point position-object gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    (up-remove-objects search-remote object-data-index != 0)
                    (up-target-objects 0 action-default -1 -1)
                )

                

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-filter-status c: status-pending c: list-active)
                    (set-strategic-number sn-focus-player-number my-player-number)
                    (up-find-status-remote c: building-class c: 2)
                    (up-remove-objects search-remote object-data-tasks-count > 0)
                )

                (defrule
                (game-time > 5)
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-find-local c: villager-class c: 4)
                    (up-remove-objects search-local object-data-index != 0)
                )

                (defrule
                    (up-set-target-object search-local c: 0)
                    (building-type-count-total house >= 2)
                    ;(building-type-count house == 1)
                    =>
                    (up-target-objects 0 action-default -1 -1)
                    ;(chat-to-all "running")
                    (disable-self)
                )









                (defrule ;for mayans
                    (up-pending-objects c: house == 2)
                    (unit-type-count villager == 4)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-id g:== gl-first-house-builder)
                    (up-remove-objects search-local object-data-id g:== gl-second-house-builder)
                    (up-remove-objects search-local object-data-id g:== gl-third-house-builder)
                    (up-get-search-state gl-local-total)
                )

                (defrule 
                    (up-pending-objects c: house == 2)
                    (unit-type-count villager == 4)
                    (up-compare-goal gl-local-total > 0)
                    =>
                    (up-filter-status c: status-pending c: list-active)
                    (set-strategic-number sn-focus-player-number my-player-number)
                    (up-find-status-remote c: building-class c: 2)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    (up-target-objects 0 action-default -1 -1)
                    ;(chat-to-all "sending forth vill to build house")
                    ;(chat-to-all "sending vill to house 5")
                    (disable-self)
                )
            

                (defrule ;backup
                    (true)
                    =>
                    (up-full-reset-search)
                )

                (defrule
                    (up-pending-objects c: house < 2) ; ikke færdig
                    (game-time > 10)
                    (game-time < 12)
                    =>
                    (up-full-reset-search)
                    (up-get-point position-self gl-position-self-x)
                    (up-lerp-tiles gl-position-self-x gl-second-house-x  c: 6)
                    (up-build-line gl-position-self-x gl-position-self-x c: house)
                    (chat-to-all "making backup house 8")
                    (disable-self)
                )

                
            
            ; retasking first 3 house builders

                (defrule
                    (game-time > 16)
                    (game-time < 100)
                    (up-compare-goal gl-current-sheep != -1)
                    =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-current-sheep)
                    (up-set-target-object search-local c: 0)
                    (up-get-point position-object gl-temp-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-modify-goal gl-position-self-x c:- 1)
                    (up-modify-goal gl-position-self-y c:- 1)
                    (up-get-point-distance gl-position-self-x gl-temp-x gl-distance)
                    )




                (defrule
                    (game-time > 16)
                    (game-time < 100)
                    (up-compare-goal gl-current-sheep != -1)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 10)
                    (up-remove-objects search-local object-data-idling c:!= 1)
                    )

                (defrule
                    (game-time > 16)
                    (game-time < 100)
                    (up-set-target-object search-local c: 0)
                    (up-compare-goal gl-current-sheep != -1)
                    (up-compare-goal gl-distance <= 2)
                    =>
                    (up-add-object-by-id search-remote g: gl-current-sheep)
                    (up-set-target-object search-remote c: 0)
                    (up-target-objects 0 action-default -1 -1)
                    ;(disable-self)
                )




                (defrule
                    (game-time > 16)
                    (game-time < 100)
                    (up-set-target-object search-local c: 0)
                    (up-compare-goal gl-current-sheep != -1)
                    (up-compare-goal gl-distance > 2)
                    =>
                    (up-target-point gl-position-self-x action-default -1 -1)
                    ;(disable-self)
                )

                




                (defrule
                    (building-type-count house == 99) ;1
                    =>
                    (up-full-reset-search)
                    (set-strategic-number sn-focus-player-number my-player-number)
                    (up-find-remote c: town-center c: 1)
                    (up-set-target-object search-remote c: 0)
                    (up-find-local c: villager-class c: 2)
                    (up-remove-objects search-local object-data-action c:== actionid-build)
                    (up-remove-objects search-local object-data-action c:== actionid-gather)
                    (up-remove-objects search-local object-data-action c:== actionid-move)
                    (up-target-objects 0 action-garrison -1 -1)
                    (disable-self)
                )



                (defrule
                    (building-type-count house == 99) ; 2
                    ;(unit-type-count villager == 4)
                    
                    =>
                    (up-full-reset-search)
                    
                    (up-find-local c: villager-class c: 4)
                    (up-remove-objects search-local object-data-tasks-count != 0)
                    (set-strategic-number sn-focus-player-number my-player-number)
                    (up-find-remote c: town-center c: 1)
                    (up-set-target-object search-remote c: 0)
                    (up-set-target-object search-local c: 0)
                    (up-target-objects 0 action-garrison -1 -1
                    )
                    (disable-self)
                )
    
        
        ;C Chosing when to place remaining dark age houses
            

            (defrule ; 3. house in dark age
                            (wood-amount >= 30)
                            (building-type-count house == 2)
                            (unit-type-count villager >= 8)
                            (up-pending-objects c: house == 0)
                            (up-compare-goal gl-first-lumber-camp-location-x != -1)
                            (up-compare-goal gl-building-system == build-line-system)
                            =>
                            (up-full-reset-search)
                            (up-get-point position-self gl-true-position-self-x)
                            (up-copy-point gl-position-self-x gl-first-lumber-camp-location-x)

                            (up-lerp-tiles gl-position-self-x gl-true-position-self-x c: 4) 
                            (set-goal gl-building-tiles 4)
                            ;;(up-send-flare gl-position-self-x)
                            (set-goal gl-build-house YES)
                            (up-copy-point gl-new-building-spot-x gl-position-self-x)
                            ;(chat-to-all "building 3. house")
                            (disable-self)
                        )

                        (defrule ; 4. and 5. house in dark age
                            (wood-amount >= 30)
                            (building-type-count house == 3)
                            (unit-type-count villager >= 15)
                            (up-pending-objects c: house == 0)
                            (up-compare-goal gl-building-system == build-line-system)
                            =>
                            (up-full-reset-search)
                            (up-get-point position-self gl-true-position-self-x)
                            (up-copy-point gl-position-self-x gl-first-lumber-camp-location-x)

                            (up-lerp-tiles gl-position-self-x gl-true-position-self-x c: 3) 
                            (set-goal gl-building-tiles 4)
                            ;;(up-send-flare gl-position-self-x)
                            (set-goal gl-build-house YES) ;test
                            (up-copy-point gl-new-building-spot-x gl-position-self-x)
                            (disable-self)
                        )

                        (defrule ; 4. and 5. house in dark age
                            (wood-amount >= 30)
                            (building-type-count house == 4)
                            (up-pending-objects c: house == 0)
                            (up-compare-goal gl-building-system == build-line-system)
                            =>
                            (up-full-reset-search)
                            (up-get-point position-self gl-true-position-self-x)
                            (up-copy-point gl-position-self-x gl-first-lumber-camp-location-x)

                            (up-lerp-tiles gl-position-self-x gl-true-position-self-x c: 3) 
                            (set-goal gl-building-tiles 4)
                            ;;(up-send-flare gl-position-self-x)
                            ;(set-goal gl-build-house YES) ;test
                            (up-copy-point gl-new-building-spot-x gl-position-self-x)
                            (disable-self)
                        )
        ;D Send builders to Fase 1+2 houses
            

                (defrule ; look for house
                (up-pending-objects c: house == 1)
                (building-type-count house >= 2)
                =>
                (up-full-reset-search)
                (set-strategic-number sn-focus-player-number my-player-number)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-remote c: house c: 1)
                (up-remove-objects search-remote object-data-tasks-count > 0)
                )

                (defrule ; if found, find male lumberjacks
                (up-pending-objects c: house == 1)
                (building-type-count house >= 2)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-point position-object gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-reset-search 0 1 0 0)
                (up-find-local c: 218 c: 50); male lumberjack
                (up-find-local c: 123 c: 50); female lumberjack
                (up-remove-objects search-local object-data-group-flag == deer-group)
                (up-remove-objects search-local object-data-group-flag == dark-age-straggler-group)
                (up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group)
                )

                (defrule ; send closest lumberjack to house
                (up-pending-objects c: house == 1)
                (building-type-count house >= 2)
                (up-set-target-object search-local c: 0)
                =>
                (up-clean-search search-local object-data-distance search-order-asc)
                (up-remove-objects search-local object-data-index != 0)
                (up-target-objects 0 action-default -1 -1)
                ;;(chat-to-all "sending builder to house")
                )

    
    ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 418 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 66 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                )
    ;4 Scouting
        ;Extra: Make a backup scout if scout dies before scouting the enemy

            (defrule
                (true)
                =>
                (set-goal gl-temp1 1)
            )
            (defrule
                (up-set-target-by-id g: gl-scout-unit)
                =>
                (set-goal gl-temp1 -1)
            )

            (defrule
                (goal gl-temp1 1) ;no scout
                (goal gl-enemy-x -1)
                (game-time > 10)
                (unit-type-count-total eagle-warrior-line == 0)
                (can-train eagle-warrior-line)
                (civ-selected mayan)
                =>
                (train eagle-warrior-line)
            )

            (defrule
                (goal gl-temp1 1) ;no scout
                (goal gl-enemy-x -1)
                (game-time > 10)
                (unit-type-count-total militiaman-line == 0)
                (can-train militiaman-line)
                (not(civ-selected mayan))
                =>
                (train militiaman-line)
            )

        ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 418 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 001 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                )
                ;0 Find the unscouted area closest to the town center
            ; Scriptet startes på et givent tidspunkt.
                (defrule
                    (game-time > 5)
                    ;(goal gl-deer-found -1)
                    =>
                    (set-goal gl-closest-unscouted-area-x -2)
                    (set-goal gl-max-search-radius 5)
                )
            ; Search radius sættes ud fra tidspunkt hvor et område burde være scouted
                (defrule
                    (game-time > 120) ; 2 min
                    =>
                    (set-goal gl-max-search-radius 13)
                    (disable-self)
                )

                (defrule
                    (game-time > 240) ; 4 min
                    =>
                    (set-goal gl-max-search-radius 16)
                    (disable-self)
                )

                (defrule
                    (game-time > 330)
                    =>
                    (set-goal gl-max-search-radius 18)
                    (disable-self)
                )

                (defrule
                    (game-time > 330)
                    (goal gl-deer-found -1)
                    =>
                    (set-goal gl-max-search-radius 30)
                )

            ; Hvis der er fundet et unscouted area der nu er scouted genstartes scriptet.
                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x > -1)
                    (up-point-explored gl-closest-unscouted-area-x != explored-no)
                    (game-time < 750)
                    =>
                    (set-goal gl-closest-unscouted-area-x -2)
                )

            ; Først nulstilles alle værdier i det store loop.
                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x == -2)
                    =>
                    (set-goal gl-search-radius 5) ;temp1
                    (set-goal gl-x-value-added-to-big-loop 0) ;temp2
                    (set-goal gl-y-value-added-to-big-loop 0) ;temp3
                    (set-goal gl-doubble-search-radius 10) ;temp7
                )

            ; -Start på det store og de to mellemstore loops. 
            ; Der findes ny tile for de mellemstore loops. Alle værdier nulstilles for de to små loops.
                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x == -2)
                    =>
                    (up-full-reset-search)
                    (up-get-point position-self gl-area-center-tile-x) ;temp1-x
                    (up-modify-goal gl-area-center-tile-x g:- gl-search-radius)
                    (up-modify-goal gl-area-center-tile-y g:- gl-search-radius) ;udgangspunktet.
                    (up-modify-goal gl-area-center-tile-x g:+ gl-x-value-added-to-big-loop)
                    (up-modify-goal gl-area-center-tile-y g:+ gl-y-value-added-to-big-loop) ;punktet er fundet
                    (set-goal gl-unscouted-tiles-in-area 0)
                    (up-modify-goal gl-x-value-added-to-small-loop c:= 0) ;temp4
                    (up-modify-goal gl-y-value-added-to-small-loop c:= 0) ;temp5
                )

            ; -Start for de to små loops.
            ; Der sættes den tile i området omkring center tile der skal undersøges.
                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x == -2)
                    =>
                    (up-copy-point gl-area-checking-tile-x gl-area-center-tile-x) ;temp2-x
                    (up-modify-goal gl-area-checking-tile-x c:- 3)
                    (up-modify-goal gl-area-checking-tile-y c:- 3) ;udgangspunktet.
                    (up-modify-goal gl-area-checking-tile-x g:+ gl-x-value-added-to-small-loop) 
                    (up-modify-goal gl-area-checking-tile-y g:+ gl-y-value-added-to-small-loop) ;punktet er fundet
                )

            ; Checkingtile undersøges for om den er inden for banen og om den er unscouted. Hvis ja tilføjes en til
            ; gl-unscouted-tiles-in-area.
                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x == -2)
                    (up-compare-goal gl-area-checking-tile-x g:<= gl-full-map-size-x)
                    (up-compare-goal gl-area-checking-tile-y g:<= gl-full-map-size-y)
                    (up-compare-goal gl-area-checking-tile-x g:>= gl-zero-x)
                    (up-compare-goal gl-area-checking-tile-y g:>= gl-zero-y)
                    (up-point-explored gl-area-checking-tile-x == explored-no)
                    =>
                    (up-modify-goal gl-unscouted-tiles-in-area c:+ 1) ;number of unscouted tiles i område 
                )

            ; Hvis der er tilføjet under 6 til x i small loop tilføjes 1 og loopet genstartes.
                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x == -2)
                    (up-compare-goal gl-x-value-added-to-small-loop < 6)
                    =>
                    (up-modify-goal gl-x-value-added-to-small-loop c:+ 1)
                    (up-jump-rule -3)
                )

            ; Hvis der er tilføjet under 6 til y i small loop tilføjes 1, x nulstilles og loopet genstartes.
                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x == -2)
                    (up-compare-goal gl-y-value-added-to-small-loop < 6)
                    =>
                    (up-modify-goal gl-y-value-added-to-small-loop c:+ 1) 
                    (up-modify-goal gl-x-value-added-to-small-loop c:= 0)
                    (up-jump-rule -4)
                )

            ; Efter de to små loops har tjekket alle 49 tiles undersøges om 35 eller flere er unscouted inden for banen.
            ; Hvis de er sættes gl-closest-unscouted-area-x til den fundne centertile
                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x == -2)
                    (up-compare-goal gl-unscouted-tiles-in-area >= 35) ;temp6
                    =>
                    (up-copy-point gl-closest-unscouted-area-x gl-area-center-tile-x)
                )

            ; De to mellemstore loops x og y goals tilføjes én hvis ikke de har nået search-radius. Mellemstore loops 
            ; genstartes
                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x == -2)
                    (up-compare-goal gl-x-value-added-to-big-loop g:< gl-doubble-search-radius)
                    (game-time < 0)
                    =>
                    (up-modify-goal gl-x-value-added-to-big-loop c:+ 1)
                    (up-jump-rule -7)
                )

                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x == -2)
                    (up-compare-goal gl-y-value-added-to-big-loop g:< gl-doubble-search-radius) 
                    (game-time < 0)
                    =>
                    (up-modify-goal gl-y-value-added-to-big-loop c:+ 1)
                    (up-modify-goal gl-x-value-added-to-big-loop c:= 0)
                    (up-jump-rule -8)
                )

            ; Hvis der ikke er fundet et unscouted område inden for search-radius og denne er under 35 sættes den 1 op.
                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x == -2)
                    (up-compare-goal gl-search-radius g:< gl-max-search-radius) ;temp8
                    (game-time < 0)
                    =>
                    (up-modify-goal gl-search-radius c:+ 1)
                    (up-modify-goal gl-doubble-search-radius g:= gl-search-radius) 
                    (up-modify-goal gl-doubble-search-radius c:* 2) 
                    (up-jump-rule -9)
                )

            ; Debug - Når der er fundet et område sendes en flare og der fortælles hvor mange unscouted tiles den fandt.
                (defrule
                    (up-compare-goal gl-closest-unscouted-area-x > -1)
                    =>
                    ;(up-send-flare gl-closest-unscouted-area-x)
                    ;(up-chat-data-to-all "gl-unscouted-tiles-in-area is %d." g: gl-unscouted-tiles-in-area)
                    (do-nothing)
                )
        ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 418 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 002 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                );1 Controlling scout priorities (will be overruled in fase 2) (+setup)
            ; extra
                #load-if-not-defined MAYAN-CIV

                (defconst scout-unit scout-cavalry-line)

                

                #end-if

                #load-if-defined MAYAN-CIV

                (defconst scout-unit eagle-warrior-line)

                
                #end-if

                (defrule
                    (game-time < 1800)
                    =>
                    (up-set-attack-stance scout-cavalry-line c: stance-no-attack)
                    (up-set-attack-stance eagle-warrior-line c: stance-no-attack)
                    (set-strategic-number sn-home-exploration-time 600)
                    (disable-self)
                )

                (defrule
                    (unit-type-count-total scout-cavalry-line == 0)
                    (unit-type-count-total eagle-warrior-line == 0)
                    (game-time > 300)
                    (game-time < 1500)
                    =>
                    (set-strategic-number sn-total-number-explorers 0)
                (set-strategic-number sn-number-explore-groups 0)
                )

                (defrule
                    (or(unit-type-count-total scout-cavalry-line > 0)
                    (unit-type-count-total eagle-warrior-line > 0))
                    (game-time < 2100)
                    =>
                    (set-strategic-number sn-total-number-explorers 1)
                (set-strategic-number sn-number-explore-groups 1)
                )

                (defrule
                    (game-time > 1800)
                    =>
                        (up-set-attack-stance scout-cavalry-line c: stance-aggressive)
                        (up-set-attack-stance eagle-warrior-line c: stance-aggressive)
                )

            ;first scout move

                (defrule
                    (game-time > 840)
                    =>
                    (up-send-scout group-type-land-explore position-corner)
                    (disable-self)
                )

                (defrule
                    (true)
                =>
                    (up-reset-search 1 1 1 1)
                    (up-filter-include -1 -1 -1 -1)
                    (up-filter-exclude -1 -1 -1 -1)
                    (up-filter-range -1 -1 -1 -1)
                    (up-find-local c: town-center c: 1)
                    (up-set-target-object search-local c: 0)
                    (up-get-point position-object gl-s-point-x)
                    (up-get-point position-object gl-saved-point-x)
                    (up-reset-search 1 1 1 1)
                    (up-find-local c: scout-unit c: 1)
                    (up-set-target-object search-local c: 0)
                    (up-get-point position-object gl-object-point-x)
                    (up-cross-tiles gl-object-point-x gl-s-point-x c: -5)
                    (disable-self)
                    )

                (defrule
                    (true)
                =>
                    (up-modify-goal gl-saved-point-x g:- gl-object-point-x)
                    (up-modify-goal gl-saved-point-y g:- gl-object-point-y)
                    (up-modify-goal gl-saved-point-x g:* gl-first-scouting-spiral-radius); Radius
                    (up-modify-goal gl-saved-point-y g:* gl-first-scouting-spiral-radius); Radius
                    (up-get-point-distance gl-s-point-x gl-object-point-x gl-point-distance)
                    (up-modify-goal gl-saved-point-x g:/ gl-point-distance)
                    (up-modify-goal gl-saved-point-y g:/ gl-point-distance)
                    (up-modify-goal gl-s-point-x g:- gl-saved-point-x)
                    (up-modify-goal gl-s-point-y g:- gl-saved-point-y)
                    (up-target-point gl-s-point-x action-move -1 -1)
                    (disable-self)
                )

