                        (current-age >= feudal-age)
                            (wood-amount >= 100)
                            (unit-type-count villager-gold >= 99) ;7 but i need DUC here
                            (building-type-count-total mining-camp == 1)
                            (up-compare-goal gl-building-system == build-line-system)
                            (up-pending-objects c: mining-camp == 0)
                        =>
                        (set-goal gl-need-mining-camp YES)
                    )

                    (defrule
                        (current-age >= feudal-age)
                        (building-type-count-total archery-range == 1)
                        (up-pending-objects c: archery-range == 0)
                        (up-compare-goal gl-need-archery-range == NO)
                        (unit-type-count villager > 26)
                        (unit-type-count archer-line > 3)
                        (wood-amount >= 250)
                        =>
                        (set-goal gl-need-archery-range YES)
                    ) ; * alle bygninger

                    (defrule
                        (current-age >= feudal-age)
                        (building-type-count-total blacksmith < 1)
                        (up-compare-goal gl-need-blacksmith == NO)
                        (can-afford-building blacksmith)
                        (building-type-count-total archery-range == 2)
                        (current-age == feudal-age)
                        (up-compare-goal gl-building-system == build-line-system)
                        (or(goal gl-full-skirm-mode -1)
                        (building-type-count-total farm >= 9))
                        =>
                        (set-goal gl-build-blacksmith YES)
                    ) ; * alle bygninger

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp -1)
                    )

                    (defrule
                        (or(and(building-type-count-total farm >= 11)
                        (goal gl-full-skirm-mode -1))
                        (and(or(building-type-count-total farm >= 15)
                        (and(building-type-count-total farm >= 11)
                        (wood-amount > 350)))
                        (goal gl-full-skirm-mode 1)))
                        =>
                        (set-goal gl-temp 1)
                    ) ; * alle bygninger

                    (defrule
                        (current-age >= feudal-age)
                        (goal gl-temp 1)
                        (building-type-count-total market < 1)
                        (building-type-count-total blacksmith == 1)
                        (up-compare-goal gl-need-market == NO)
                        (wood-amount >= 175)
                        =>
                        (set-goal gl-need-market YES)
                    ) ; * alle bygninger

                    (defrule
                        (up-compare-goal gl-need-stable == NO)
                        (can-afford-building stable)
                            (up-research-status c: castle-age >= research-pending)
                            (building-type-count-total stable < 1)
                            (up-compare-goal gl-building-system == build-line-system)
                        =>
                        ;(set-goal gl-need-stable YES)
                        (do-nothing)
                    )


                    

                    #load-if-not-defined UP-1-PLAYER-TEAM
                    #load-if-not-defined UP-2-PLAYER-TEAM
                    (defrule
                        (up-compare-goal gl-age-status >= advancing-to-castle)
                        (building-type-count-total archery-range < 3)
                        (up-pending-objects c: archery-range == 0)
                        (up-compare-goal gl-need-archery-range == NO)
                        (wood-amount >= 175)
                        ;(up-players-in-game ally >= 2)
                        =>
                        ;(set-goal gl-need-archery-range YES)
                        (do-nothing)
                    ) ; * alle bygninger
                    #end-if
                    #end-if

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: town-center c: 1)
                        (set-goal gl-temp 0)
                    )

                    (defrule
                        (up-set-target-object search-local c: 0)
                        (up-object-data object-data-progress-type == 103) ;research
                        =>
                        (up-get-object-data object-data-progress-value gl-temp)
                        ;;;(up-chat-data-to-all "town center job is %d. % complete" g: gl-temp)
                    )

                    (defrule
                        (true)
                        =>
                        (up-get-player-fact target-player military-population 0 gl-temp)
                        (up-get-fact military-population 0 gl-temp1)
                        (up-modify-goal gl-temp1 g:- gl-temp)
                    )

                    (defrule
                    (game-time < 990)
                    (game-time > 600)
                        (current-age == feudal-age)
                        (or(and(up-compare-goal gl-my-position == 3)
                        (up-compare-goal gl-temp1 < 0))
                        (or(up-compare-goal gl-temp1 <= -4)
                        (up-compare-goal gl-group-superiority < -7)))
                        (or(players-building-type-count target-player archery-range > 0)
                        (players-unit-type-count target-player skirmisher-line > 0))
                        =>
                        (set-goal gl-split-rule 2006)
                        )

                        (defrule
                            (game-time < 990)
                            (players-current-age target-player == feudal-age)
                            =>
                            (set-goal gl-enemy-early-feudal 1)
                        )

                        (defrule
                        (game-time < 990)
                        (game-time > 600)
                            (current-age == feudal-age)
                            (up-compare-goal gl-my-position == 3)
                            (or(and(up-compare-goal gl-temp > 2)
                            (and(up-compare-goal gl-temp1 < 0)
                            (up-compare-goal gl-group-superiority < 0)))
                            (goal gl-enemy-early-feudal 1))
                            
                            =>
                            (set-goal gl-split-rule 2006)
                            )

                        (defrule
                            (goal gl-split-rule 2006)
                            
                        (players-building-type-count target-player stable == 0)
