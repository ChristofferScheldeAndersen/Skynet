                    )

                ;-Tjek om der er fundet et alternativt træ

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-remote-tree-1)
                        (up-add-object-by-id search-remote g: gl-remote-tree-2)
                        (up-add-object-by-id search-remote g: gl-remote-tree-3)
                        (up-add-object-by-id search-remote g: gl-remote-tree-4)
                        (up-add-object-by-id search-remote g: gl-remote-tree-5)
                        (up-add-object-by-id search-remote g: gl-remote-tree-6)
                        (up-add-object-by-id search-remote g: gl-remote-tree-7)
                        (up-add-object-by-id search-remote g: gl-remote-tree-8)
                        (up-add-object-by-id search-remote g: gl-remote-tree-9)
                        (up-add-object-by-id search-remote g: gl-remote-tree-10)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-number-of-backup-trees g:= gl-remote-total)
                    )

                ;-Inden loop sættes goals

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-target != 915) ; tree class
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-max-local-index g:= gl-local-total)
                        (set-goal gl-current-local-index 0)
                    )

                ;-Loop startes med at finde alle vills der har et træ som target, uanset hvilken controll group de tilhører
                    
                    (defrule
                        (true)
                        =>
                        (up-get-rule-id gl-local-loop-first-rule)
                        (up-full-reset-search)
                        (up-get-search-state gl-local-total)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-target != 915); tree class
                        (set-goal gl-current-vill -1)
                    )

                ;-Genstart loop hvis vill allerede har target tæt på tc eller er tæt på sit target

                    ;-For hver villager tjekkes lokation for deres target. Herefter laves en søgning på nearby local tc's. Hvis der er et inden for 5-6
                    ;tiles eller afstanden fra vill til target træ er 6 tiles eller mindre genstartes loopet

                    (defrule
                        (up-set-target-object search-local g: gl-current-local-index)
                        =>
                        (up-get-object-data object-data-id gl-current-vill)
                        (up-get-point position-object gl-vill-x)
                        (up-get-object-target-data object-data-point-x gl-current-tree-x)
                        (up-get-object-target-data object-data-point-y gl-current-tree-y)
                        (up-get-point-distance gl-vill-x gl-current-tree-x gl-distance-to-current-tree)
                        (up-set-target-point gl-current-tree-x)
                        (up-full-reset-search)
                        (up-filter-distance c: -1 c: 8)
                        (up-find-local c: town-center c: 200)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-compare-sn sn-strong-enemy-units-in-base > 0)
                        (up-compare-goal gl-current-local-index g:< gl-max-local-index)
                        ;(or(up-compare-goal gl-distance-to-current-tree <= 6)
                        (up-compare-goal gl-local-total > 0);)
                        ;(not(true))
                        =>
                        (up-modify-goal gl-current-local-index c:+ 1)
                        (up-jump-direct g: gl-local-loop-first-rule)
                        ;(chat-to-all "this rule better not be running")
                    )

                ;-Herefter laves en række søgninger efter strong enemy units omkring træet og mellem træ og vill

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-copy-point gl-testing-x gl-current-tree-x)
                        (up-filter-distance c: -1 c: 30)
                        (up-filter-include cmdid-military -1 -1 -1)
                        (set-goal gl-lerp-counter 0)
                    )

                    (defrule
                        (true)
                        =>
                        (up-set-target-point gl-testing-x)
                        (set-strategic-number sn-focus-player-number 1)
                    )

                    (defrule
                        (players-stance focus-player enemy)
                        =>
                        (up-find-remote c: all-units-class c: 40)
                    )

                    (defrule
                        (up-compare-sn sn-focus-player-number < 8)
                        =>
                        (up-modify-sn sn-focus-player-number c:+ 1)
                        (up-jump-rule -2)
                    )

                    (defrule
                        (up-point-distance gl-testing-x gl-vill-x > 15)
                        (up-compare-goal gl-lerp-counter < 10)
                        =>
                        (up-lerp-tiles gl-testing-x gl-vill-x c: 8)
                        (up-modify-goal gl-lerp-counter c:+ 1)
                        (up-jump-rule -4)
                    )

                    (defrule
                        (true)
                        =>
                        (up-remove-objects search-remote object-data-type == scout-cavalry)
                        (up-remove-objects search-remote object-data-type == spearman)
                        (up-remove-objects search-remote object-data-type == eagle-warrior)
                        (up-remove-objects search-remote object-data-type == battering-ram)
                        (up-remove-objects search-remote object-data-type == skirmisher)
                        (up-get-search-state gl-local-total)
                    )

