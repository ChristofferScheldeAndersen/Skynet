                            (up-get-point position-map-size gl-temp1-x)
                            (up-modify-goal gl-temp3 g:= gl-temp1-x) 
                            (up-modify-goal gl-temp3 c:/ 4) ;maximum tiles to move
                            (up-modify-goal gl-temp1-x c:= 0)
                            (up-modify-goal gl-temp1-y c:= 0)
                            (up-modify-goal gl-temp1-x c:+ 2) ;starting tile for placement
                            (up-modify-goal gl-temp1-y c:+ 2)
                            (up-modify-goal gl-temp1-x g:+ gl-temp1) ;move starting tile one extra every loop
                            (up-modify-goal gl-temp1-y g:+ gl-temp2)
                        )

                        (defrule
                            (up-compare-goal gl-closest-trading-corner == top)
                            (up-compare-goal gl-opposite-trading-corner == left)
                            =>
                            (up-get-point position-map-size gl-temp1-x)
                            (up-modify-goal gl-temp3 g:= gl-temp1-x) 
                            (up-modify-goal gl-temp3 c:/ 4) ;maximum tiles to move
                            (up-modify-goal gl-temp1-y c:= 0)
                            (up-modify-goal gl-temp1-x c:- 2) ;starting tile for placement
                            (up-modify-goal gl-temp1-y c:+ 2)
                            (up-modify-goal gl-temp1-y g:+ gl-temp1) ;move starting tile one extra every loop
                            (up-modify-goal gl-temp1-x g:- gl-temp2)
                        )

                        (defrule
                            (up-compare-goal gl-closest-trading-corner == left)
                            (up-compare-goal gl-opposite-trading-corner == top)
                            =>
                            (up-get-point position-map-size gl-temp1-x)
                            (up-modify-goal gl-temp3 g:= gl-temp1-x) 
                            (up-modify-goal gl-temp3 c:/ 4) ;maximum tiles to move
                            (up-modify-goal gl-temp1-x c:= 0)
                            (up-modify-goal gl-temp1-y c:= 0)
                            (up-modify-goal gl-temp1-x c:+ 2) ;starting tile for placement
                            (up-modify-goal gl-temp1-y c:+ 2)
                            (up-modify-goal gl-temp1-y g:+ gl-temp1) ;move starting tile one extra every loop
                            (up-modify-goal gl-temp1-x g:+ gl-temp2)
                        )

                        (defrule
                            (up-compare-goal gl-top-building-priority >= 100)
                            (up-compare-goal gl-next-building == priority-market)
                            (building-type-count-total market > 0)
                            (building-type-count-total market < 4)
                            =>
                            (up-copy-point gl-temp2-x gl-temp1-x)
                            (up-modify-goal gl-temp2-y c:- 3)
                            (up-modify-goal gl-temp2-x c:+ 2) ;toppen af urskiven er start
                            (set-goal gl-temp5 1)
                            (set-goal gl-temp6 -1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 2)
                            =>
                            (up-modify-goal gl-temp2-y c:+ 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 3)
                            =>
                            (up-modify-goal gl-temp2-y c:+ 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 4)
                            =>
                            (up-modify-goal gl-temp2-y c:+ 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 5)
                            =>
                            (up-modify-goal gl-temp2-y c:+ 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 6)
                            =>
                            (up-modify-goal gl-temp2-y c:+ 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 7)
                            =>
                            (up-modify-goal gl-temp2-x c:- 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 8)
                            =>
                            (up-modify-goal gl-temp2-x c:- 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 9)
                            =>
                            (up-modify-goal gl-temp2-x c:- 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 10)
                            =>
                            (up-modify-goal gl-temp2-x c:- 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 11)
                            =>
                            (up-modify-goal gl-temp2-x c:- 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 12)
                            =>
                            (up-modify-goal gl-temp2-y c:- 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 13)
                            =>
                            (up-modify-goal gl-temp2-y c:- 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 14)
                            =>
                            (up-modify-goal gl-temp2-y c:- 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 15)
                            =>
                            (up-modify-goal gl-temp2-y c:- 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 16)
                            =>
                            (up-modify-goal gl-temp2-y c:- 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 17)
                            =>
                            (up-modify-goal gl-temp2-x c:+ 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 18)
                            =>
                            (up-modify-goal gl-temp2-x c:+ 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 19)
                            =>
                            (up-modify-goal gl-temp2-x c:+ 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 == 20)
                            =>
                            (up-modify-goal gl-temp2-x c:+ 1)
                        )
                        
                        (defrule
                            (up-compare-goal gl-top-building-priority >= 100)
                            (up-compare-goal gl-next-building == priority-market)
                            (building-type-count-total market > 0)
                            (building-type-count-total market < 4)
                            (or(up-point-contains gl-temp2-x c: 59)
                            (or(up-point-contains gl-temp2-x c: 908)
                            (or(up-point-contains gl-temp2-x c: 903)
                            (or(up-point-contains gl-temp2-x c: 907)
                            (or(up-point-contains gl-temp2-x c: 915)
                            (up-point-contains gl-temp2-x c: 66))))))
                            =>
                            (set-goal gl-temp6 1)
                        )

                        (defrule
                            (up-compare-goal gl-temp5 < 20)
                            (can-afford-building market)
                            =>
                            (up-modify-goal gl-temp5 c:+ 1)
                            (up-jump-rule -21)
                        )
                        
                        (defrule
                            (up-compare-goal gl-top-building-priority >= 100)
                            (up-compare-goal gl-next-building == priority-market)
                            (building-type-count-total market > 0)
                            (building-type-count-total market < 4)
                            (up-can-build-line 0 gl-temp1-x c: market)
                            (up-point-distance gl-temp1-x gl-last-deleted-building-x > 12)
                            (goal gl-temp4 -1)
                            (goal gl-temp6 -1)
                            =>
                            (up-build-line gl-temp1-x gl-temp1-x c: market)
                            ;(chat-to-all "trying to place market")
                            (set-goal gl-temp4 1)
                        )

                        (defrule ;loop untill positions has been tried for 25% of the map length
                            (up-compare-goal gl-closest-trading-corner != -1)
                            (up-compare-goal gl-opposite-trading-corner != -1)
                            (up-compare-goal gl-temp1 g:< gl-temp3)
                            (can-afford-building market)
                            =>
                            (up-modify-goal gl-temp1 c:+ 1)
                            (up-jump-rule -32) ;10
                        )

                        (defrule ;loop untill positions has been tried for 25% of the map length
                            (up-compare-goal gl-closest-trading-corner != -1)
                            (up-compare-goal gl-opposite-trading-corner != -1)
                            (up-compare-goal gl-temp2 g:< gl-temp3)
                            (can-afford-building market)
                            =>
                            (up-modify-goal gl-temp2 c:+ 1)
                            (up-modify-goal gl-temp1 c:= 0)
                            (up-jump-rule -33) ;11
                        )

                        (defrule ;debug
                            (taunt-detected my-player-number 8)
                            =>
                            (up-chat-data-to-all "gl-temp1 is %d." g: gl-temp1)
                            (up-chat-data-to-all "gl-temp2 is %d." g: gl-temp2)
                            (up-chat-data-to-all "gl-temp1-x is %d." g: gl-temp1-x)
                            (up-chat-data-to-all "gl-temp1-y is %d." g: gl-temp1-y)
                            (acknowledge-taunt my-player-number 8)
                        )

                            

                ; Blacksmith
                    (defrule
                        (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-blacksmith)
                        (can-build blacksmith)
                        (building-type-count-total blacksmith == 0)
                        =>
                        (build blacksmith)
                    )
                ; Castle (bruger ikke gl-last-deleted-building-x)
                    
                    ;Place first castle

                        (defrule
                            (can-build castle)
                            (building-type-count-total castle == 0)
                            =>
                            (up-set-placement-data my-player-number -1 c: 12)
                            (up-build place-control 0 c: castle) 
                        )                      
                    

                    ;Find ideal spot for extra castles
                        ;define temp-goals
                            (defconst gl-backup-x 80) ;gl-temp1-x
                            (defconst gl-backup-y 81)
                            (defconst gl-ambitious-x 82)
                            (defconst gl-ambitious-y 83)
                            (defconst gl-home-distance-modifier 84)
                            (defconst gl-elevation-bonus 85)
                            (defconst gl-elevation-modifier 86)
                            (defconst gl-x-modifier 87)
                            (defconst gl-y-modifier 88)
                            (defconst gl-best-score 89)
                            (defconst gl-best-point-x 90)
                            (defconst gl-best-point-y 91)
                            (defconst gl-first-castle-loop-rule 92)
                            (defconst gl-testing-x 93)
                            (defconst gl-testing-y 94)
                            (defconst gl-elevation-score 95)
                            (defconst gl-home-distance-score 96)
                            (defconst gl-combined-score 97)
                            (defconst gl-build-castle 98)
                            (defconst gl-map-center-x 99)
                            (defconst gl-map-center-y 100)
                            (defconst gl-center-score 101)
                            (defconst gl-center-score-modifier 102)
                            (defconst gl-center-distance 102)

                            
                        ;Først findes back up stedet ved at gå 10 tiles mod target player fra mest forward castle
                            
                            (defrule
                                (true)
                                =>
                                (up-full-reset-search)
                                (up-find-local c: castle c: 200)
                                (up-set-target-point gl-enemy-x)
                                (up-clean-search search-local object-data-distance search-order-asc)
                            )
                            
                            (defrule
                                (up-set-target-object search-local c: 0)
                                =>
                                (up-get-point position-object gl-backup-x)
                                (up-lerp-tiles gl-backup-x gl-enemy-x c: 10)
                            )

                            (defrule
                                (or(taunt-detected my-player-number 236)
                                (or(taunt-detected any-ally 236)
                                (taunt-detected any-enemy 236)))
                                =>
                                (up-chat-data-to-all "gl-backup-x is %d" g: gl-backup-x)
                                (up-chat-data-to-all "gl-backup-y is %d" g: gl-backup-y)
                            )
                        ;Herefter findes det ambitiøse sted ved at gå 10 tiles mod mest forward castle fra army center

                            (defrule
                                (true)
                                =>
                                (up-full-reset-search)
                                (up-find-local c: castle c: 200)
                                (up-set-target-point gl-enemy-x)
                                (up-clean-search search-local object-data-distance search-order-asc)
                            )
                            
                            (defrule
                                (up-set-target-object search-local c: 0)
                                =>
                                (up-get-point position-object gl-temp-x)
                                (up-copy-point gl-ambitious-x gl-ranged-army-x)
                                (up-lerp-tiles gl-ambitious-x gl-temp-x c: 10)
                                (up-get-point-distance gl-enemy-x gl-backup-x gl-temp1)
                                (up-get-point-distance gl-enemy-x gl-ambitious-x gl-temp2)
                            )

                            (defrule
                                (or(taunt-detected my-player-number 236)
                                (or(taunt-detected any-ally 236)
                                (taunt-detected any-enemy 236)))
                                =>
                                (up-chat-data-to-all "gl-ambitious-x is %d" g: gl-ambitious-x)
                                (up-chat-data-to-all "gl-ambitious-y is %d" g: gl-ambitious-y)
                            )

                        ;Hvis vi angriber vælges det mest ambitiøse af disse 2 punkter eller vælges back-up

                            (defrule
                                (or(up-compare-sn sn-tsa == 0)
                                (up-compare-goal gl-temp1 g:< gl-temp2))
                                =>
                                (up-copy-point gl-ambitious-x gl-backup-x)
                            )

                            (defrule
                                (or(taunt-detected my-player-number 236)
                                (or(taunt-detected any-ally 236)
                                (taunt-detected any-enemy 236)))
                                =>
                                (up-chat-data-to-all "gl-ambitious-x 2 is %d" g: gl-ambitious-x)
                                (up-chat-data-to-all "gl-ambitious-y 2 is %d" g: gl-ambitious-y)
                            )

                        ;Hvis det fundne punkt er langt fra map center ift banens størrelse flyttes det tættere på, f.eks. 10 tiles

                            (defrule
                                (true)
                                =>
                                (up-get-point position-map-size gl-temp) ;200
                                (up-get-point position-center gl-temp11)
                                (up-copy-point gl-temp13 gl-ambitious-x)
                                (up-get-point-distance gl-temp13 gl-temp11 gl-temp1) ;80
                                (up-modify-goal gl-temp1 c:* 200) ;16000
                                (up-modify-goal gl-temp1 g:/ gl-temp) ;80
                            )

                            (defrule
                                (up-compare-goal gl-temp1 > 70) ;preffered point is more than 60% of the way from center to egde
                                =>
                                (set-goal gl-temp2 70)
                                (up-modify-goal gl-temp1 g:- gl-temp2)
                                (up-lerp-tiles gl-ambitious-x gl-temp11 g: gl-temp1)
                            )

                            (defrule
                                (or(taunt-detected my-player-number 236)
                                (or(taunt-detected any-ally 236)
                                (taunt-detected any-enemy 236)))
                                =>
                                (up-chat-data-to-all "gl-ambitious-x 3 is %d" g: gl-ambitious-x)
                                (up-chat-data-to-all "gl-ambitious-y 3 is %d" g: gl-ambitious-y)
                            )

                            (defrule
                                (or(taunt-detected my-player-number 236)
                                (or(taunt-detected any-ally 236)
                                (taunt-detected any-enemy 236)))
                                =>
                                (up-chat-data-to-all "gl-ambitious-x 4 is %d" g: gl-ambitious-x)
                                (up-chat-data-to-all "gl-ambitious-y 4 is %d" g: gl-ambitious-y)
                            )
                    ;Build extra castles

                        ;lav et score loop hvor eneste prioriteringer lige nu er at være tæt på ideelt punkt og højere elevation .   
                            ;Deciding to build castle

                                (defrule
                                    (true)
                                    =>
                                    (set-goal gl-build-castle -1)
                                )

                                (defrule
                                    (can-afford-building castle)
                                (building-type-count-total castle >= 1)
                                (up-compare-goal gl-my-position != 4)
                                    =>
                                    (set-goal gl-build-castle castle)
                                )

                            ;parameter ajustment
                                (defrule
                                    (true)
                                    =>
                                    (set-goal gl-home-distance-modifier 1)
                                    (set-goal gl-elevation-bonus 4)
                                    (set-goal gl-elevation-modifier 1)
                                    (set-goal gl-center-score-modifier 75) ;the amount of points added for being in center
                                )

                                (defrule
                                    (up-compare-sn sn-number-attack-groups > 0)
                                    =>
                                    (set-goal gl-elevation-bonus 8)
                                    (set-goal gl-elevation-modifier 2)
                                )

                            ;reset goals
                                (defrule
                                    (true)
                                    =>
                                    (set-goal gl-x-modifier -30)
                                    (set-goal gl-y-modifier -30)
                                    (set-goal gl-best-score -10000)
                                    (set-goal gl-best-point-x -1)
                                )
                                
                                (defrule
                                    (true)
                                    =>
                                    (up-get-rule-id gl-first-castle-loop-rule)
                                    (up-copy-point gl-testing-x gl-ambitious-x)
                                    (up-modify-goal gl-testing-x g:+ gl-x-modifier)
                                    (up-modify-goal gl-testing-y g:+ gl-y-modifier)
                                    (up-set-target-point gl-testing-x)
                                    (set-goal gl-temp -1)
                                    (set-goal gl-home-distance-score 10000)
                                    (set-goal gl-elevation-score 0)
                                )

                            ;testing if point is accaptable

                                (defrule
                                    (up-can-build-line 0 gl-testing-x c: castle)
                                    =>
                                    (set-goal gl-temp 1)
                                )

                            ;if not then restart loop
                                (defrule
                                    (goal gl-temp -1)
                                    (up-compare-goal gl-x-modifier < 30)
                                    (up-compare-goal gl-build-castle == castle)
                                    =>
                                    (up-modify-goal gl-x-modifier c:+ 1)
                                    (up-jump-direct g: gl-first-castle-loop-rule)
                                )

                                (defrule
                                    (goal gl-temp -1)
                                    (up-compare-goal gl-y-modifier < 30)
                                    (up-compare-goal gl-x-modifier >= 30)
                                    (up-compare-goal gl-build-castle == castle)
                                    =>
                                    (up-modify-goal gl-y-modifier c:+ 1)
                                    (up-modify-goal gl-x-modifier c:= -30)
                                    (up-jump-direct g: gl-first-castle-loop-rule)
                                )
                            ;calculate score
                                (defrule
                                    (up-point-elevation gl-testing-x > 0)
                                    =>
                                    (up-modify-goal gl-elevation-score g:= gl-elevation-bonus)
                                )

                                (defrule
                                    (true)
                                    =>
                                    (up-get-point position-center gl-map-center-x)
                                    (up-get-point-distance gl-map-center-x gl-testing-x gl-center-distance)
                                    (up-modify-goal gl-center-score g:= gl-center-score-modifier)
                                )
                                #load-if-defined GOLD-RUSH-MAP
                                #load-if-defined UP-4-PLAYER-GAME
                                (defrule
                                    (up-compare-goal gl-center-distance > 13)
                                    =>
                                    (set-goal gl-center-score 0)
                                )
                                #end-if
                                #end-if

                                #load-if-defined GOLD-RUSH-MAP
                                #load-if-defined UP-8-PLAYER-GAME
                                (defrule
                                    (up-compare-goal gl-center-distance > 18)
                                    =>
                                    (set-goal gl-center-score 0)
                                )
                                #end-if
                                #end-if

                                #load-if-defined GOLD-RUSH-MAP
                                #load-if-not-defined UP-8-PLAYER-GAME
                                #load-if-not-defined UP-4-PLAYER-GAME
                                (defrule
                                    (up-compare-goal gl-center-distance > 10)
                                    =>
                                    (set-goal gl-center-score 0)
                                )
                                #end-if
                                #end-if
                                #end-if

                                #load-if-not-defined GOLD-RUSH-MAP
                                (defrule
                                    (true)
                                    =>
                                    (set-goal gl-center-score 0)
                                )
                                #end-if
                                
                                
                                (defrule
                                    (true)
                                    =>
                                    (up-get-point-distance gl-ambitious-x gl-testing-x gl-home-distance-score)
                                    (up-modify-goal gl-home-distance-score g:* gl-home-distance-modifier)

                                    (up-get-point-elevation gl-testing-x gl-temp)
                                    (up-modify-goal gl-temp g:* gl-elevation-modifier)
                                    (up-modify-goal gl-elevation-score g:+ gl-temp)

                                    (set-goal gl-combined-score 10000)
                                    (up-modify-goal gl-combined-score g:+ gl-elevation-score)
                                    (up-modify-goal gl-combined-score g:- gl-home-distance-score)
                                    (up-modify-goal gl-combined-score g:+ gl-center-score)
                                )

                                
                            ;replace best score
                                (defrule
                                    (up-compare-goal gl-combined-score g:> gl-best-score)
                                    (up-can-build-line 0 gl-testing-x c: castle)
                                    =>
                                    (up-modify-goal gl-best-score g:= gl-combined-score)
                                    (up-copy-point gl-best-point-x gl-testing-x)
                                )

                                
                            ;restart loop
                                (defrule
                                    (up-compare-goal gl-x-modifier < 30)
                                    (up-compare-goal gl-build-castle == castle)
                                    =>
                                    (up-modify-goal gl-x-modifier c:+ 1)
                                    (up-jump-direct g: gl-first-castle-loop-rule)
                                )

                                (defrule
                                    (up-compare-goal gl-y-modifier < 30)
                                    (up-compare-goal gl-x-modifier >= 30)
                                    (up-compare-goal gl-build-castle == castle)
                                    =>
                                    (up-modify-goal gl-y-modifier c:+ 1)
                                    (up-modify-goal gl-x-modifier c:= -30)
                                    (up-jump-direct g: gl-first-castle-loop-rule)
                                )
                            ;build building
                                (defrule
                                    (goal gl-build-castle castle)
                                    (up-compare-goal gl-best-point-x != -1)
                                    =>
                                    (up-build-line gl-best-point-x gl-best-point-x c: castle)
                                )
    

                ; Lumber camp
                            ; Debug
                                (defrule
                                    (not(can-build lumber-camp))
                                    (goal gl-build-lc YES)
                                    =>
                                    (set-goal gl-build-lc NO)
                                )

                                (defrule
                                    (goal gl-build-lc YES)
                                    =>
                                    ;(chat-to-all "trying to build lumber camp")
                                    (do-nothing)
                                )
                            ; A NEW* Finding a part of a forrest suitable for a lumber camp.
                                ; 1a Searching for trees - Start of big loop

                                        ; general search for wood starting at a point behind the tc sortet by distance to that point.

                                        (defrule
                                            (goal gl-build-lc YES)
                                            (building-type-count-total lumber-camp == 2)
                                            (building-type-count-total town-center < 2)
                                            (current-age >= castle-age)
                                            (stone-amount >= 100)
                                            =>
                                            
                                            (set-goal gl-build-lc NO)
                                            
                                        )

                                        (defrule
                                            (goal gl-build-lc YES)
                                            =>
                                            ;(up-modify-goal gl-surrounding-trees c:== -1)
                                            (up-modify-goal gl-checked-trees c:= 0)
                                            (up-modify-goal gl-suitable-trees-found c:= 0)
                                            (up-modify-goal gl-minimum-tree-distance c:= 5)
                                            (up-modify-goal gl-maximum-tree-distance c:= 6)
                                            (up-modify-goal gl-first-suitable-tree c:= -1)
                                            (up-modify-goal gl-second-suitable-tree c:= -1)
                                            (up-modify-goal gl-third-suitable-tree c:= -1)
                                            (up-modify-goal gl-forth-suitable-tree c:= -1)
                                            (up-modify-goal gl-fifth-suitable-tree c:= -1)
                                            (up-modify-goal gl-sixth-suitable-tree c:= -1)
                                            (up-modify-goal gl-seventh-suitable-tree c:= -1)
                                            (up-modify-goal gl-eighth-suitable-tree c:= -1)
                                            (up-modify-goal gl-nineth-suitable-tree c:= -1)
                                            (up-modify-goal gl-tenth-suitable-tree c:= -1)
                                            
                                        )

                                        (defrule
                                            (goal gl-build-lc YES)
                                            =>
                                            
                                            (up-modify-goal gl-eleventh-suitable-tree c:= -1)
                                            (up-modify-goal gl-twelfth-suitable-tree c:= -1)
                                            (up-modify-goal gl-thirteenth-suitable-tree c:= -1)
                                            (up-modify-goal gl-forteenth-suitable-tree c:= -1)
                                            (up-modify-goal gl-fifteenth-suitable-tree c:= -1)
                                            (up-modify-goal gl-sixteenth-suitable-tree c:= -1)
                                            (up-modify-goal gl-seventeenth-suitable-tree c:= -1)
                                            (up-modify-goal gl-nineteenth-suitable-tree c:= -1)
                                            (up-modify-goal gl-twentyth-suitable-tree c:= -1)
                                            (up-modify-goal gl-remote-total c:= -1)
                                            (up-modify-goal gl-tree-checking-tile-x c:= -1)
                                            (up-modify-goal gl-tree-checking-tile-y c:= -1)
                                            (up-modify-goal gl-first-lumber-camp-tree-x c:= -1)
                                            (up-modify-goal gl-first-lumber-camp-tree-y c:= -1)
                                            (up-modify-goal gl-chosen-tree-point-x c:= -1)
                                        )

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;0                      gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0                      gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0                      gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0                      gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15                     gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;-1                     gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;0                      gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                                    ;;; efter big-loop-reset ;;;

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;0    netop reset       gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0 derfor reset         gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0-8?!                  gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;7?!                    gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                                        (defrule 
                                        (goal gl-build-lc YES) ; find trees
                                            =>
                                            (set-strategic-number sn-target-point-adjustment 5)
                                            (up-full-reset-search)
                                            (up-get-point position-self gl-position-self-x)
                                            (up-get-point position-center gl-center-x)
                                            (up-lerp-tiles gl-position-self-x gl-center-x c: -3) 
                                            (up-set-target-point gl-position-self-x)
                                            ;;;(up-chat-data-to-all "gl-maximum-tree-distance is %d." g: gl-maximum-tree-distance)
                                            (up-filter-distance g: gl-minimum-tree-distance g: gl-maximum-tree-distance)
                                            (up-filter-status c: status-ready c: list-active)
                                            (up-find-resource c: wood c: 40)
                                            (up-filter-status c: status-resource c: list-active)
                                            (up-find-resource c: wood c: 40)
                                            (up-set-target-point gl-last-deleted-building-x)
                                            (up-remove-objects search-remote object-data-distance < 20)
                                            (up-set-target-point gl-position-self-x)
                                        )

                                        (defrule
                                            (goal gl-build-lc YES)
                                            =>
                                            (set-goal gl-temp33 0)
                                            (set-goal gl-temp4-x 0)
                                            (set-goal gl-temp4-y 0)
                                        )
                                        
                                        (defrule
                                            (goal gl-build-lc YES)
                                            =>
                                            (up-reset-search 1 1 0 0)
                                            (up-reset-filters)
                                            (up-find-local c: lumber-camp c: 200)
                                            (up-filter-status c: status-pending c: list-active)
                                            (up-find-status-local c: lumber-camp c: 200)
                                            (up-clean-search search-local object-data-id search-order-asc)
                                        )

                                        (defrule
                                        (goal gl-build-lc YES)
                                            (up-set-target-object search-local g: gl-temp33)
                                            =>
                                            (up-reset-search 1 1 0 0)
                                            (up-reset-filters)
                                            (up-get-point position-object gl-temp4-x)
                                            (up-set-target-point gl-temp4-x)
                                            (up-remove-objects search-remote object-data-distance <= 4)
                                        )

                                        (defrule
                                        (goal gl-build-lc YES)
                                            (up-compare-goal gl-temp33 < 200)
                                            =>
                                            (up-modify-goal gl-temp33 c:+ 1)
                                            (up-jump-rule -3)
                                        )

                                        (defrule
                                            (goal gl-build-lc YES)
                                            =>
                                            (set-goal gl-temp33 0)
                                            (set-goal gl-temp4-x 0)
                                            (set-goal gl-temp4-y 0)
                                        )
                                        
                                        (defrule
                                            (goal gl-build-lc YES)
                                            =>
                                            (up-reset-search 1 1 0 0)
                                            (up-reset-filters)
                                            (up-find-local c: town-center c: 200)
                                            (up-filter-status c: status-pending c: list-active)
                                            (up-find-status-local c: town-center-foundation c: 200)
                                            (up-clean-search search-local object-data-id search-order-asc)
                                        )

                                        (defrule
                                        (goal gl-build-lc YES)
                                            (up-set-target-object search-local g: gl-temp33)
                                            =>
                                            (up-reset-search 1 1 0 0)
                                            (up-reset-filters)
                                            (up-get-point position-object gl-temp4-x)
                                            (up-set-target-point gl-temp4-x)
                                            (up-remove-objects search-remote object-data-distance <= 5)
                                        )

                                        (defrule
                                        (goal gl-build-lc YES)
                                            (up-compare-goal gl-temp33 < 200)
                                            =>
                                            (up-modify-goal gl-temp33 c:+ 1)
                                            (up-jump-rule -3)
                                        )

                                        (defrule
                                            (goal gl-build-lc YES) ;chose target tree for first check
                                            =>
                                            (up-set-target-object search-remote c: 0)
                                            (up-get-point position-object gl-first-lumber-camp-tree-x)
                                            (up-get-search-state gl-local-total)
                                            ;;;(up-chat-data-to-all "number of trees found is %d." g: gl-remote-total)
                                        )
                                            

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;0                      gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0-8?!                  gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;7?!                    gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;x,y    ny              gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                                    ;;; efter lille loop reset ;;;

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;0-40 1 efter li-loop   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;7                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                
                                
                                
                                ; 1b resetting loop variables (once per loop) - Start of small loop

                                    ; then a rule resetting gl-surrounding-trees to 0 and adding one to gl-checked-trees so it will become 0 for the 
                                    ; first run (starting at -1)

                                    (defrule        ; runs once per tree
                                        (goal gl-chosen-tree-point-x -1)
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-modify-goal gl-surrounding-trees c:= 0)
                                        (up-modify-goal gl-surrounding-tiles-checked c:= 0)
                                        ;;(chat-to-all "other rule is running")
                                    )

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0                      gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                                    ; then a rule subtracting one tree from the search if gl-checked trees are more than 0.

                                    (defrule        ; runs conce per tree. Not first time
                                        (up-compare-goal gl-checked-trees > 0)
                                        (goal gl-chosen-tree-point-x -1)
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-remove-objects search-remote object-data-index == 0)
                                        (up-set-target-object search-remote c: 0)
                                        (up-get-point position-object gl-first-lumber-camp-tree-x)
                                        (up-get-search-state gl-local-total)
                                        ;;(chat-to-all "remove tree from the search that isnt the first one")
                                    )

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0-40  -1               gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0                      gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;x,y    ny              gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;



                                ; 1c Loop counting number of surrounding trees for the current first tree on the list
                                        ; there also needs to be a reset of the original tree-tile. idealy with a new temp goal used in the lines below this


                                    (defrule        ; runs 8 times per tree
                                        (goal gl-chosen-tree-point-x -1)
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-copy-point gl-tree-checking-tile-x gl-first-lumber-camp-tree-x)
                                    )

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0                      gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;x,y    reset           gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                                    ; each tree will then enter a looping evaluation mode in the following fasion

                                    (defrule ;up
                                        (goal gl-chosen-tree-point-x -1)
                                        (up-compare-goal gl-surrounding-tiles-checked == 0)
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-modify-goal gl-tree-checking-tile-x c:+ 1)
                                        (up-modify-goal gl-tree-checking-tile-y c:- 1)
                                    )

                                    (defrule ;up-right
                                        (goal gl-chosen-tree-point-x -1)
                                        (up-compare-goal gl-surrounding-tiles-checked == 1)
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-modify-goal gl-tree-checking-tile-x c:+ 1)
                                        )

                                    (defrule ;right
                                        (goal gl-chosen-tree-point-x -1)
                                        (up-compare-goal gl-surrounding-tiles-checked == 2)
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-modify-goal gl-tree-checking-tile-x c:+ 1)
                                        (up-modify-goal gl-tree-checking-tile-y c:+ 1)
                                    )

                                    (defrule ;low-right
                                        (goal gl-chosen-tree-point-x -1)
                                        (up-compare-goal gl-surrounding-tiles-checked == 3)
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-modify-goal gl-tree-checking-tile-y c:+ 1)
                                    )

                                    (defrule ;low
                                        (goal gl-chosen-tree-point-x -1)
                                        (up-compare-goal gl-surrounding-tiles-checked == 4)
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-modify-goal gl-tree-checking-tile-x c:- 1)
                                        (up-modify-goal gl-tree-checking-tile-y c:+ 1)
                                    )

                                    (defrule ;low-left
                                        (goal gl-chosen-tree-point-x -1)
                                        (up-compare-goal gl-surrounding-tiles-checked == 5)
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-modify-goal gl-tree-checking-tile-x c:- 1)
                                    )

                                    (defrule ;left
                                        (goal gl-chosen-tree-point-x -1)
                                        (up-compare-goal gl-surrounding-tiles-checked == 6)
                                        (goal gl-build-lc YES)
                                                        =>
                                        (up-modify-goal gl-tree-checking-tile-x c:- 1)
                                        (up-modify-goal gl-tree-checking-tile-y c:- 1)
                                    )

                                    (defrule ;upper-left
                                        (goal gl-chosen-tree-point-x -1)
                                        (up-compare-goal gl-surrounding-tiles-checked == 7)
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-modify-goal gl-tree-checking-tile-y c:- 1)
                                    )

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0                      gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;x,y    ændret          gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                                    ;checking tile and resetting loop


                                    (defrule
                                    (or(up-point-contains gl-tree-checking-tile-x c: 915) ; tree-class = 915
                                    (up-point-contains gl-tree-checking-tile-x c: 66))
                                    (goal gl-build-lc YES)
                                    =>
                                    (up-modify-goal gl-surrounding-trees c:+ 1)
                                    )

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                                    (defrule
                                        (up-compare-goal gl-surrounding-tiles-checked < 7)
                                        (up-compare-goal gl-surrounding-tiles-checked != -1)
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-modify-goal gl-surrounding-tiles-checked c:+ 1)
                                        (up-jump-rule -11)
                                    )

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;7                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                                ; 1d When all surrounding tiles are tjecked the loop will reset, now with a new tree chosen unless the chosen tree
                                    ; is surrounded by exactly 7 trees.
                                    ; modify the point before the upper rule, then repeat 8 times in total clockwise. You should only need to paste the 
                                    ; upper rule once.
                                    ; if at the end of the loop gl-surrounding trees is above 5 the loop will stop and a tree is found

                                
                                    (defrule
                                        (up-compare-goal gl-surrounding-tiles-checked == 7)
                                        (nor(up-compare-goal gl-surrounding-trees == 6)
                                        (and(up-compare-goal gl-suitable-trees-found < 10)
                                        (up-compare-goal gl-surrounding-trees == 5)))
                                        ;(up-compare-goal gl-surrounding-trees != 7) ; forsøg på at undgå camps på forkert sidde af weird lines
                                        (goal gl-build-lc YES)
                                        (up-compare-goal gl-checked-trees < 40)                
                                        =>
                                        (up-modify-goal gl-checked-trees c:+ 1) ; 0 on first run
                                        (up-jump-rule -14)
                                    )

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;1-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;7                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                                ; 1x Når det originale loop gemmer et træ kræves det at der ikke er fundet de træer der skal (startende på 5)
                                    ;Samtidig laves der multiple regler (først 5) for at gemme ID'et på hver af de fundne træer. Hver regel
                                    ;lægger 1 til en counter der bruges til at åbne næste regel. Første regel må nødvendigvis være nederst osv.
                                    ;I stedet er det nok bedre bare at have en regel tidligere der lægger en til counteren når et træ rent
                                    ; faktisk er fundet. Så slipper man for omvendt rækkefølge

                                    (defrule
                                        (or(up-compare-goal gl-surrounding-trees == 6)
                                        (and(up-compare-goal gl-suitable-trees-found < 10)
                                        (up-compare-goal gl-surrounding-trees == 5)))
                                        (goal gl-build-lc YES)
                                        =>
                                        (up-modify-goal gl-suitable-trees-found c:+ 1)
                                    )

                                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                                    ;1-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                                    ;7                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                                    ;0-5 måske ændret       gl-suitable-trees-found, antal træer med goal ID,                0-5
                                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
