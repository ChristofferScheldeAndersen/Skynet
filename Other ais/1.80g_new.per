                    =>
                    (up-remove-objects search-remote object-data-index == 0)
                    (up-get-search-state gl-local-total)
                    (up-jump-rule -2)
                    )

                    (defrule
                    (goal gl-build-lc YES)
                    (up-compare-goal gl-temp48 > 0)
                    =>
                    ;(up-chat-data-to-all "gl-temp6-x is %d" g: gl-temp6-x)
                    ;(up-chat-data-to-all "gl-temp6-y is %d" g: gl-temp6-y)
                    ;(up-chat-data-to-all "gl-temp1 is %d" g: gl-temp1)
                    (up-modify-goal gl-temp6-x g:/ gl-temp48) ; finder gennemsnitskoordinaten
                    (up-modify-goal gl-temp6-y g:/ gl-temp48)
                    (up-modify-goal gl-temp6-x c:/ 100)
                    (up-modify-goal gl-temp6-y c:/ 100)
                    (up-get-point position-self gl-temp-x)
                    (up-get-point-distance gl-lumber-camp-testing-spot-x gl-temp-x gl-temp49) ;testing point distance
                    ;(up-chat-data-to-all "gl-temp49 is %d" g: gl-temp49)
                    (up-get-point-distance gl-temp6-x gl-temp-x gl-temp50) ;forrest distance
                    ;(up-chat-data-to-all "gl-temp50 is %d" g: gl-temp50)
                    (up-modify-goal gl-temp49 g:- gl-temp50) ;extra distance to testing point from tc compared to forrest
                    ;(chat-to-all "rule running")
                    )

                    ;Herefter kører det lille loop som normalt indtil før reglen hvor det endelige punkt vælges. Her indsættes
                    ;i stedet et tjeck af punktets lc-score og hvis det er større end den tidligere score indsættes den nye score
                    ;i målets score og punktet gemmes i et mål der bliver det endelige når det store loop slutter. Endvidere
                    ;øges en counter der siger hvor mange træer der er tjekket.

                    (defrule
                        (goal gl-build-lc YES); checks distance
                            =>
                            (up-full-reset-search)
                            (up-get-point position-self gl-position-self-x)
                            (up-get-point position-center gl-center-x)
                            (up-lerp-tiles gl-position-self-x gl-center-x c: -20)
                            (up-set-target-point gl-position-self-x)
                            (up-get-point-distance gl-position-self-x gl-lumber-camp-testing-spot-x gl-lumber-camp-distance)
                        )

                    (defrule ;tilføj ekstra træer der kun tæller under halvt
                        (goal gl-build-lc YES)
