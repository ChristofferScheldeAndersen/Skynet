                    ;training rule
                        (defrule
                            (goal gl-temp1 1) ;dont produce if you soon will need to save for upgrades   
                            
                            (building-type-count-total town-center >= 2)
                            (not(and(up-compare-goal gl-next-building == priority-university)
                            (wood-amount < 245)))
                            (not(and(up-compare-goal gl-next-building == priority-monastery)
                            (wood-amount < 220)))
                            (unit-type-count-total archer-line <= 55)
                            (not(and(up-compare-goal gl-saving-gold-needed == 600)
                            (gold-amount < 645)))
                            =>
                            (set-goal gl-split-rule 295)
                        )

                        (defrule
                            (goal gl-split-rule 295)
                            (not(and(up-pending-objects c: archer-line >= 3)
                            (and(gold-amount > 400)
                            (up-research-status c: imperial-age < research-pending))))
                            (can-train archer-line)
                            (not(up-compare-goal gl-saving-wood-needed >= 200))
                            (not(and(up-research-status c: imperial-age == research-pending)
                            (up-research-status c: ri-thumb-ring < research-pending)))
                            (up-compare-goal gl-delay-imp == -1)
                            =>
                            (set-goal gl-split-rule 296)
                            
                        )

                        (defrule
