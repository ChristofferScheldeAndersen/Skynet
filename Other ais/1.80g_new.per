    ;
; Fase 4: 
    ; Info
        ; Runs from the start of castle age until the end of the game.
        ; Fase 4 will differ based on strategy, team position and number of players on the team.
        ; Economy in Fase 4 is controlled by a mix of the game's automatic engine and DUC.
        ; Rules in fase 4 only runs if gl-fase is eQual to 4.

        
    ; Skipping fase 4
        (defrule
            (true)
            =>
            (up-get-rule-id gl-fase-four-first-rule)
        )

        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 430 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 9 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                ) 
        
        (defrule
            (up-compare-goal gl-fase != 4)
            (up-compare-goal gl-end-of-script-rule != -1)
            =>
            (up-jump-direct g: gl-end-of-script-rule) ; end the pass here
        )
    ;   
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 431 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (up-compare-goal 181 > 20)
                    (up-compare-goal gl-end-of-script-rule != -1)
                    (true)
                =>
                ;(up-chat-data-to-all "Start fase 4 loop-duration: %d. Skipping remaining script" g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                )

                (defrule
                    (up-compare-goal 181 > 20)
                    (up-compare-goal gl-end-of-script-rule != -1)
                =>
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                )
    ; Non-strategy-dependent fase 4 code
        ; Settings
            (defrule
                (up-compare-goal gl-fase == 4)
                =>
                (set-strategic-number sn-enable-research-queue 1)
                (set-strategic-number sn-number-civilian-militia 0)
                (up-assign-builders c: castle c: 20)
                (up-assign-builders c: house c: 1)
                (up-assign-builders c: lumber-camp c: 1)
                (up-assign-builders c: mining-camp c: 1)
                (up-assign-builders c: farm c: 1)
            )

            (defrule
                (up-compare-goal gl-my-position == 4)
                =>
                (up-assign-builders c: castle c: 5)
            )
            
            (defrule
                (up-compare-goal gl-my-position == 5)
                =>
                (up-assign-builders c: castle c: 10)
            )
           
            (defrule
                (up-compare-goal gl-fase == 4)
                =>
                (up-modify-goal gl-temp1 s:= sn-maximum-town-size)
                (up-modify-sn sn-maximum-town-size c:= 50) ;for at vills kan garrison
            )

            (defrule
                (town-under-attack)
                (up-enemy-units-in-town > 1)
                (up-compare-goal gl-fase == 4)
                =>
                (up-modify-sn sn-maximum-town-size c:= 50)
            )

            (defrule
                (not(and(town-under-attack)
                (up-enemy-units-in-town > 1)))
                (up-compare-goal gl-fase == 4)
                =>
                (up-modify-sn sn-maximum-town-size g:= gl-temp1)
            )



            (defrule
                (up-research-status c: imperial-age >= research-pending)
                =>
                (set-goal gl-early-imp-strat early-paladin);delayed-paladin
            )

            (defrule
                (up-research-status c: ri-chemistry >= research-pending)
                =>
                (set-goal gl-early-imp-strat deffensive-spear-line)
            )

        ; Controlling eco groups
                ; Alle villagers indeles i 3 grupper og nye vills kommer i wood gruppen
                    (defrule
                        (game-time >= 3)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-target != 932) ;gold mine
                        (up-reset-group c: gold-group)
                        (up-modify-group-flag 0 c: gold-group)
                        (up-create-group 0 0 c: gold-group)
                        (up-modify-group-flag 1 c: gold-group)
                        (disable-self)
                    )

                    (defrule
                        (game-time >= 3)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-target != farm-class)
                        (up-reset-group c: farm-group)
                        (up-modify-group-flag 0 c: farm-group)
                        (up-create-group 0 0 c: farm-group)
                        (up-modify-group-flag 1 c: farm-group)
                        (disable-self)
                    )

                    (defrule
                        (game-time >= 3)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-target != 915) ;tree
                        (up-reset-group c: wood-group)
                        (up-modify-group-flag 0 c: wood-group)
                        (up-create-group 0 0 c: wood-group)
                        (up-modify-group-flag 1 c: wood-group)
                        (disable-self)
                    )

                    (defrule
                        (game-time >= 3)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag == farm-group)
                        (up-remove-objects search-local object-data-group-flag == farm-group2)
                        (up-remove-objects search-local object-data-group-flag == gold-group)
                        (up-remove-objects search-local object-data-group-flag == stone-group)
                        ;(up-remove-objects search-local object-data-group-flag == wood-group)
                        (up-reset-group c: wood-group)
                        (up-modify-group-flag 0 c: wood-group)
                        (up-create-group 0 0 c: wood-group)
                        (up-modify-group-flag 1 c: wood-group)
                    )

                ; Change group for farm vills to 2. farm group when there are more than 30 farmers.
                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != farm-group)
                        (up-remove-objects search-local object-data-id g:== gl-first-assigned-farming-vill)
                        (up-remove-objects search-local object-data-id g:== gl-second-assigned-farming-vill)
                        (up-remove-objects search-local object-data-id g:== gl-third-assigned-farming-vill)
                        (up-remove-objects search-local object-data-id g:== gl-forth-assigned-farming-vill)
                        (up-remove-objects search-local object-data-id g:== gl-fifth-assigned-farming-vill)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-compare-goal gl-local-total > 30)
                        =>
                        ;(up-remove-objects search-local object-data-target == farm-class)
                        (up-clean-search search-remote -1 search-order-asc)
                        (up-remove-objects search-local object-data-index != 0)
                    )

                    (defrule
                        (up-compare-goal gl-local-total > 30)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-data object-data-id gl-temp)
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != farm-group2)
                        (up-add-object-by-id search-local g: gl-temp)
                        (up-reset-group c: farm-group2)
                        (up-modify-group-flag 0 c: farm-group2)
                        (up-create-group 0 0 c: farm-group2)
                        (up-modify-group-flag 1 c: farm-group2)
                        ;(chat-to-all "over 30 farmers. Moving one to second farm gorup")
                    )
                ; Change group for expiriring farm vills to wood-group 1

                    (defrule
                        (game-time > 5)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != farm-group)
