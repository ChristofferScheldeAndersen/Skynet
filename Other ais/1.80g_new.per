        ;18 Garrison and ungarrison hurt vills (meget rodet men det virker)
            ;Garrisoning
                ; Extra regel hvis boar angriber en vill der ikke er luring villager


                ;;
            
                (defrule ;first boar
                    (goal BOAR-STATUS Killing-Boar)
                    (up-set-target-by-id g: gl-first-boar-id)
                    =>
                    (up-get-object-data object-data-target-id gl-temp1)
                )
            
                (defrule
                    (goal BOAR-STATUS Killing-Boar)
                    (up-set-target-by-id g: gl-first-boar-id)
                    (up-set-target-by-id g: gl-temp1)
                    (up-object-data object-data-hitpoints <= 14)
                    (up-object-data object-data-id g:!= gl-first-boar-luring-villager)
                    (up-object-data object-data-class c:== villager-class)
                    =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-temp1)
                    (set-strategic-number sn-focus-player-number my-player-number)
                    (up-find-remote c: town-center c: 1)
                    (up-gather-inside c: town-center c: -1)
                    (up-target-objects 0 action-garrison -1 -1)
                    ;non-luring vill 1")
                )

                

                (defrule ;second boar
                    (goal BOAR-STATUS Killing-Boar)
                    (up-set-target-by-id g: gl-second-boar-id)
                    =>
                    (up-get-object-data object-data-target-id gl-temp1)
                )

                (defrule
                    (goal BOAR-STATUS Killing-Boar)
