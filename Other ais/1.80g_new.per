                        ;(up-chat-data-to-all "gl-my-position is %d." g: gl-my-position)
                        ;(up-chat-data-to-all "gl-closest-ally is %d." g: gl-closest-ally)
                    )

                    (defrule
                        (or(taunt-detected my-player-number 7)
                        (taunt-detected any-ally 7))
                        (goal gl-my-position pocket)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                        (up-get-player-color focus-player gl-temp1-x)
                        ;(up-chat-data-to-all "player color of closest ally is %d." g: gl-temp1-x)
                    )

                ;Find gl-other-flank
                    (defrule ;hvis man er pocket
                        (up-compare-goal gl-closest-ally g:== gl-temp33)
                        (current-age == dark-age)
                        =>
                        (up-modify-goal gl-other-flank g:= gl-temp34)
                    )

                    (defrule
                        (up-compare-goal gl-closest-ally g:== gl-temp34)
                        (current-age == dark-age)
                        =>
                        (up-modify-goal gl-other-flank g:= gl-temp33)
                    )

                    (defrule ;hvis man er flank
                        (up-compare-goal gl-temp33 == my-player-number)
                        (current-age == dark-age)
                        =>
                        (up-modify-goal gl-other-flank g:= gl-temp34)
                    )

                    (defrule
                        (up-compare-goal gl-temp34 == my-player-number)
                        (current-age == dark-age)
                        =>
                        (up-modify-goal gl-other-flank g:= gl-temp33)
                    )

                    (defrule
                        (or(taunt-detected my-player-number 7)
                        (taunt-detected any-ally 7))
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-other-flank)
                        (up-get-player-color focus-player gl-temp1-x)
                        ;(up-chat-data-to-all "player color of other flank is %d." g: gl-temp1-x)
                    )


                
                ;Find gl-other-pocket (with lowest player number)
                    #load-if-not-defined UP-2-PLAYER-TEAM
                    #load-if-not-defined UP-3-PLAYER-TEAM
                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp35 1)
                    )

                    (defrule
                        (true)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-temp35)
                    )

                    (defrule
                        (players-stance focus-player ally)
                        (current-age == dark-age)
                        (up-compare-sn sn-focus-player-number g:!= gl-temp33)
                        (up-compare-sn sn-focus-player-number g:!= gl-temp34)
                        (up-compare-sn sn-focus-player-number g:!= gl-closest-ally)
                        (up-compare-sn sn-focus-player-number != my-player-number)
                        =>
                        (up-modify-goal gl-other-pocket s:= sn-focus-player-number)
                    )
                    
                    (defrule
                        (up-compare-goal gl-temp35 < 8)
                        =>
                        (up-modify-goal gl-temp35 c:+ 1)
                        (up-jump-rule -3)
                    )
                    #end-if
                    #end-if
                
                    (defrule
                        (or(taunt-detected my-player-number 7)
                        (taunt-detected any-ally 7))
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-other-pocket)
                        (up-get-player-color focus-player gl-temp1-x)
                        ;(up-chat-data-to-all "player color of other pocket is %d." g: gl-temp1-x)
                    )

                ;

            ; Find market positions for trade
                ;find alle 4 hjørner og den samlede afstand for holdet til disse:
                    (defrule
                        (true)
                        =>
                        (up-get-point position-zero gl-temp1-x)
                        (up-get-point position-map-size gl-temp2-x)
                        (up-modify-goal gl-temp2-y c:= 0)
                        (up-get-point position-map-size gl-temp3-x)
                        (up-get-point position-map-size gl-temp4-x)
                        (up-modify-goal gl-temp4-x c:= 0)
                        (set-goal gl-temp1 0)
                        (set-goal gl-temp2 0)
                        (set-goal gl-temp3 0)
                        (set-goal gl-temp4 0)
                        (set-goal gl-temp5 1)
                        (set-goal gl-temp6 0)
                        (set-goal gl-temp6-x -1)
                        (set-goal gl-temp7-x -1)
                    )

                    ;lav loop hvor der tjekkes position for alle allies og afstanden til alle hjørner lægges
                    ;sammen

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-modify-sn sn-focus-player-number g:= gl-temp5)
                        (up-find-remote c: town-center c: 10)
                        (up-clean-search search-remote object-data-id search-order-asc)
                    )

                    (defrule
                        (or(up-compare-sn sn-focus-player-number == my-player-number)
                        (players-stance focus-player ally))
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-get-point position-object gl-temp5-x)
                        (up-get-point-distance gl-temp1-x gl-temp5-x gl-temp6)
                        (up-modify-goal gl-temp1 g:+ gl-temp6)
                        (up-get-point-distance gl-temp2-x gl-temp5-x gl-temp6)
                        (up-modify-goal gl-temp2 g:+ gl-temp6)
                        (up-get-point-distance gl-temp3-x gl-temp5-x gl-temp6)
                        (up-modify-goal gl-temp3 g:+ gl-temp6)
                        (up-get-point-distance gl-temp4-x gl-temp5-x gl-temp6)
                        (up-modify-goal gl-temp4 g:+ gl-temp6)
                    )

                    (defrule
                        (up-compare-goal gl-temp5 < 8)
                        =>
                        (up-modify-goal gl-temp5 c:+ 1)
                        (up-jump-rule -3)
                    )

                    ;find det tætteste hjørne og afstand hertil - gl-temp6-x og gl-temp7

                    (defrule 
                        (up-compare-goal gl-temp6-x == -1)
                        (up-compare-goal gl-temp1 g:<= gl-temp2)
                        (up-compare-goal gl-temp1 g:<= gl-temp3)
                        (up-compare-goal gl-temp1 g:<= gl-temp4)
                        =>
                        (up-copy-point gl-temp6-x gl-temp1-x)
                        (up-modify-goal gl-temp7 g:= gl-temp1)
                    )

                    (defrule
                        (up-compare-goal gl-temp6-x == -1)
                        (up-compare-goal gl-temp2 g:<= gl-temp1)
                        (up-compare-goal gl-temp2 g:<= gl-temp3)
                        (up-compare-goal gl-temp2 g:<= gl-temp4)
                        =>
                        (up-copy-point gl-temp6-x gl-temp2-x)
                        (up-modify-goal gl-temp7 g:= gl-temp2)
                    )

                    (defrule
                        (up-compare-goal gl-temp6-x == -1)
                        (up-compare-goal gl-temp3 g:<= gl-temp1)
                        (up-compare-goal gl-temp3 g:<= gl-temp2)
                        (up-compare-goal gl-temp3 g:<= gl-temp4)
                        =>
                        (up-copy-point gl-temp6-x gl-temp3-x)
                        (up-modify-goal gl-temp7 g:= gl-temp3)
                    )

                    (defrule
                        (up-compare-goal gl-temp6-x == -1)
                        (up-compare-goal gl-temp4 g:<= gl-temp1)
                        (up-compare-goal gl-temp4 g:<= gl-temp2)
                        (up-compare-goal gl-temp4 g:<= gl-temp3)
                        =>
                        (up-copy-point gl-temp6-x gl-temp4-x)
                        (up-modify-goal gl-temp7 g:= gl-temp4)
                    )
                
                ;find det næsttætteste hjørne gl-temp7-x

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp2 g:== gl-temp7)
                        (up-compare-goal gl-temp1 g:<= gl-temp3)
                        (up-compare-goal gl-temp1 g:<= gl-temp4)
                        =>
                        (up-copy-point gl-temp7-x gl-temp1-x)
                    )

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp3 g:== gl-temp7)
                        (up-compare-goal gl-temp1 g:<= gl-temp2)
                        (up-compare-goal gl-temp1 g:<= gl-temp4)
                        =>
                        (up-copy-point gl-temp7-x gl-temp1-x)
                    )

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp4 g:== gl-temp7)
                        (up-compare-goal gl-temp1 g:<= gl-temp2)
                        (up-compare-goal gl-temp1 g:<= gl-temp3)
                        =>
                        (up-copy-point gl-temp7-x gl-temp1-x)
                    )

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp1 g:== gl-temp7)
                        (up-compare-goal gl-temp2 g:<= gl-temp3)
                        (up-compare-goal gl-temp2 g:<= gl-temp4)
                        =>
                        (up-copy-point gl-temp7-x gl-temp2-x)
                    )

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp3 g:== gl-temp7)
                        (up-compare-goal gl-temp2 g:<= gl-temp1)
                        (up-compare-goal gl-temp2 g:<= gl-temp4)
                        =>
                        (up-copy-point gl-temp7-x gl-temp2-x)
                    )

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp4 g:== gl-temp7)
                        (up-compare-goal gl-temp2 g:<= gl-temp1)
                        (up-compare-goal gl-temp2 g:<= gl-temp3)
                        =>
                        (up-copy-point gl-temp7-x gl-temp2-x)
                    )

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp1 g:== gl-temp7)
                        (up-compare-goal gl-temp3 g:<= gl-temp2)
                        (up-compare-goal gl-temp3 g:<= gl-temp4)
                        =>
                        (up-copy-point gl-temp7-x gl-temp3-x)
                    )

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp2 g:== gl-temp7)
                        (up-compare-goal gl-temp3 g:<= gl-temp1)
                        (up-compare-goal gl-temp3 g:<= gl-temp4)
                        =>
                        (up-copy-point gl-temp7-x gl-temp3-x)
                    )

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp4 g:== gl-temp7)
                        (up-compare-goal gl-temp3 g:<= gl-temp1)
                        (up-compare-goal gl-temp3 g:<= gl-temp2)
                        =>
                        (up-copy-point gl-temp7-x gl-temp3-x)
                    )

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp1 g:== gl-temp7)
                        (up-compare-goal gl-temp4 g:<= gl-temp2)
                        (up-compare-goal gl-temp4 g:<= gl-temp3)
                        =>
                        (up-copy-point gl-temp7-x gl-temp4-x)
                    )

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp2 g:== gl-temp7)
                        (up-compare-goal gl-temp4 g:<= gl-temp1)
                        (up-compare-goal gl-temp4 g:<= gl-temp3)
                        =>
                        (up-copy-point gl-temp7-x gl-temp4-x)
                    )

                    (defrule 
                        (up-compare-goal gl-temp7-x == -1)
                        (up-compare-goal gl-temp3 g:== gl-temp7)
                        (up-compare-goal gl-temp4 g:<= gl-temp1)
                        (up-compare-goal gl-temp4 g:<= gl-temp2)
                        =>
                        (up-copy-point gl-temp7-x gl-temp4-x)
                    )

                    ;de to tætteste hjørner er så gl-temp6-x og gl-temp7-x

                ;find det nærmeste af disse to trade hjørner
                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp10 -1)
                        (set-goal gl-temp11 -1)
                    )

                    (defrule
                        (true)
                        =>
                        (up-get-point position-self gl-temp8-x)
                        (up-get-point-distance gl-temp8-x gl-temp6-x gl-temp8)
                        (up-get-point-distance gl-temp8-x gl-temp7-x gl-temp9)
                    )

                    (defrule
                        (up-compare-goal gl-temp8 g:<= gl-temp9)
                        =>
                        (up-copy-point gl-temp9-x gl-temp6-x)
                        (up-copy-point gl-temp10-x gl-temp7-x)
                    )

                    (defrule
                        (up-compare-goal gl-temp8 g:>= gl-temp9)
                        =>
                        (up-copy-point gl-temp9-x gl-temp7-x)
                        (up-copy-point gl-temp10-x gl-temp6-x)
                    )

                    ;gl-temp9-x er det optimale trade corner.
                    ;gl-temp10-x er det modsatte tradecorner.

                ;Omsæt dette til hjørnenumre fra 1-4

                    (defrule
                        (up-compare-goal gl-temp10 == -1)
                        (up-compare-goal gl-temp9-x == 0)
                        (up-compare-goal gl-temp9-y == 0)
                        =>
                        (set-goal gl-temp10 left) ;1
                    )

                    (defrule
                        (up-compare-goal gl-temp10 == -1)
                        (up-compare-goal gl-temp9-x != 0)
                        (up-compare-goal gl-temp9-y == 0)
                        =>
                        (set-goal gl-temp10 top) ;2
                    )

                    (defrule
                        (up-compare-goal gl-temp10 == -1)
                        (up-compare-goal gl-temp9-x != 0)
                        (up-compare-goal gl-temp9-y != 0)
                        =>
                        (set-goal gl-temp10 right) ;3
                    )

                    (defrule
                        (up-compare-goal gl-temp10 == -1)
                        (up-compare-goal gl-temp9-x == 0)
                        (up-compare-goal gl-temp9-y != 0)
                        =>
                        (set-goal gl-temp10 bottom) ;4
                    )

                    (defrule
                        (up-compare-goal gl-temp11 == -1)
                        (up-compare-goal gl-temp10-x == 0)
                        (up-compare-goal gl-temp10-y == 0)
                        =>
                        (set-goal gl-temp11 left) ;1
                    )

                    (defrule
                        (up-compare-goal gl-temp11 == -1)
                        (up-compare-goal gl-temp10-x != 0)
                        (up-compare-goal gl-temp10-y == 0)
                        =>
                        (set-goal gl-temp11 top) ;2
                    )

                    (defrule
                        (up-compare-goal gl-temp11 == -1)
                        (up-compare-goal gl-temp10-x != 0)
                        (up-compare-goal gl-temp10-y != 0)
                        =>
                        (set-goal gl-temp11 right) ;3
                    )

                    (defrule
                        (up-compare-goal gl-temp11 == -1)
                        (up-compare-goal gl-temp10-x == 0)
                        (up-compare-goal gl-temp10-y != 0)
                        =>
                        (set-goal gl-temp11 bottom) ;4
                    )

                    (defrule
                        (true)
                        =>
                        (up-modify-goal gl-closest-trading-corner g:= gl-temp10)
                        (up-modify-goal gl-opposite-trading-corner g:= gl-temp11)
                    )

                    ;gl-temp10 og gl-temp11 er nu angivet som tætteste og modsat tradecorner med navn. Derved
                    ;kan der let laves build regler.

            ; Set new position for 1 / 2 player teams
                #load-if-defined UP-1-PLAYER-TEAM
                (defrule
                    (true)
                    =>
                    (set-goal gl-my-position 5)
                )
                #end-if

                #load-if-defined UP-2-PLAYER-TEAM
                (defrule
                    (true)
                    =>
                    (set-goal gl-my-position 5)
                )
                #end-if
            ;
                    (defrule
                        (taunt-detected my-player-number 55)
                        =>
                        (set-goal gl-full-skirm-mode 1)
                        (acknowledge-taunt my-player-number 55)
                    )

                    (defrule
                        (up-compare-goal gl-my-position == 3)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                        (up-get-player-fact focus-player allied-goal gl-closest-ally gl-temp1)
                        (up-get-fact player-number 0 gl-temp2)
                    )

                    (defrule
                        (up-compare-goal gl-my-position == 3)
                        (up-compare-goal gl-temp1 g:!= gl-temp2)
                        (game-time > 5)
                        =>
                        (set-strategic-number sn-lone-flank 1)
                    )
            ; Debug (alle er tvunget til at være flanks grundet scenario bug)
                    (defrule ;midlertidig regel grundet scenario bug
                        (true)
                        =>
                        ;(set-goal gl-my-position pocket)
                        (do-nothing)
                    )

                    (defrule
                        (player-number 5)
                        =>
                        ;(set-goal gl-closest-ally 1)
                        ;(set-goal gl-my-position 3)
                        ;(up-full-reset-search)
                        (do-nothing)
                    )

                    (defrule
                        (player-number 1)
                        =>
                        ;(set-goal gl-closest-ally 5)
                        ;(set-goal gl-my-position 4)
                        ;(up-full-reset-search)
                        (do-nothing)
                    )

                    (defrule
                        (game-time < 10)
                        (game-time > 0)
                        (up-find-local c: knight-line c: 200)
                        =>
                        ;(up-target-point gl-temp-x action-stop -1 -1)
                        (disable-self)
                    )
                    
                    (defrule
                        (or(taunt-detected my-player-number 7)
                        (taunt-detected any-ally 7))
                        =>
                        (up-chat-data-to-all "gl-closest-ally is %d." g: gl-closest-ally)
                        (up-chat-data-to-all "gl-other-flank is %d." g: gl-other-flank)
                        (up-chat-data-to-all "gl-other-pocket is %d." g: gl-other-pocket)
                        (up-chat-data-to-all "gl-my-position is %d." g: gl-my-position)
                        (up-chat-data-to-all "my trade corner is %d." g: gl-closest-trading-corner)
                        (up-chat-data-to-all "other trade corner is %d." g: gl-opposite-trading-corner)
                        (acknowledge-taunt my-player-number 7)
                        (acknowledge-taunt every-ally 7)
                    )

        ;
            (defrule
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 359 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration 1: %d" g: 181)
                )
        ; Detect if pockets needs to produce extra army before paladin

            (defrule
                (true)
                =>
                (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                (up-get-player-fact focus-player allied-sn sn-target-player-number gl-temp1)
                (up-modify-sn sn-focus-player-number g:= gl-other-flank)
                (up-get-player-fact focus-player allied-sn sn-target-player-number gl-temp2)
                (set-goal gl-temp3 -1)
                (set-goal gl-temp4 -1)
                (set-strategic-number sn-focus-player-number 1)
            )

            (defrule
                (up-compare-goal gl-temp1 > 0)
                (up-compare-goal gl-temp2 > 0)
                (up-compare-sn sn-focus-player-number g:!= gl-temp1)
                (up-compare-sn sn-focus-player-number g:!= gl-temp2)
                (up-compare-goal gl-temp3 == -1)
                (up-compare-goal gl-temp4 == -1)
                (players-stance focus-player enemy)
                =>
                (up-modify-goal gl-temp3 s:= sn-focus-player-number)
            )

            (defrule
                (up-compare-goal gl-temp1 > 0)
                (up-compare-goal gl-temp2 > 0)
                (up-compare-sn sn-focus-player-number g:!= gl-temp1)
                (up-compare-sn sn-focus-player-number g:!= gl-temp2)
                (up-compare-goal gl-temp3 != -1)
                (up-compare-goal gl-temp4 == -1)
                (players-stance focus-player enemy)
                (or(and(up-players-in-game enemy >= 4)
                (up-compare-sn sn-focus-player-number g:!= gl-temp3))
                (up-players-in-game enemy == 3))
                =>
                (up-modify-goal gl-temp4 s:= sn-focus-player-number)
            )

            (defrule
                (up-compare-sn sn-focus-player-number < 8)
                =>
                (up-modify-sn sn-focus-player-number c:+ 1)
                (up-jump-rule -3)
            )

            (defrule
                (true)
                =>
                (set-goal gl-temp5 0)
                (set-goal gl-temp6 0)
                (up-modify-sn sn-focus-player-number g:= gl-temp3)
                (up-get-player-fact focus-player civilian-population 0 gl-temp)
                (up-modify-goal gl-temp5 g:+ gl-temp)
                (up-modify-sn sn-focus-player-number g:= gl-temp4)
                (up-get-player-fact focus-player civilian-population 0 gl-temp)
                (up-modify-goal gl-temp5 g:+ gl-temp)
                (up-modify-sn sn-focus-player-number g:= gl-temp3)
                (up-get-player-fact focus-player military-population 0 gl-temp)
                (up-modify-goal gl-temp6 g:+ gl-temp)
                (up-modify-sn sn-focus-player-number g:= gl-temp4)
                (up-get-player-fact focus-player military-population 0 gl-temp)
                (up-modify-goal gl-temp6 g:+ gl-temp)
            )

            (defrule
                (up-players-in-game ally >= 4)
                =>
                (set-goal gl-temp7 0)
                (set-goal gl-temp8 0)
                (up-modify-sn sn-focus-player-number c:= my-player-number)
                (up-get-player-fact focus-player civilian-population 0 gl-temp)
                (up-modify-goal gl-temp7 g:+ gl-temp)
                (up-modify-sn sn-focus-player-number g:= gl-other-pocket)
                (up-get-player-fact focus-player civilian-population 0 gl-temp)
                (up-modify-goal gl-temp7 g:+ gl-temp)
                (up-modify-sn sn-focus-player-number c:= my-player-number)
                (up-get-player-fact focus-player military-population 0 gl-temp)
                (up-modify-goal gl-temp8 g:+ gl-temp)
                (up-modify-sn sn-focus-player-number g:= gl-other-pocket)
                (up-get-player-fact focus-player military-population 0 gl-temp)
                (up-modify-goal gl-temp8 g:+ gl-temp)
            )

            (defrule
                (up-players-in-game ally == 3)
                =>
                (set-goal gl-temp7 0)
                (set-goal gl-temp8 0)
                (up-modify-sn sn-focus-player-number c:= my-player-number)
                (up-get-player-fact focus-player civilian-population 0 gl-temp)
                (up-modify-goal gl-temp7 g:+ gl-temp)
                (up-modify-sn sn-focus-player-number c:= my-player-number)
                (up-get-player-fact focus-player civilian-population 0 gl-temp)
                (up-modify-goal gl-temp7 g:+ gl-temp)
                (up-modify-sn sn-focus-player-number c:= my-player-number)
                (up-get-player-fact focus-player military-population 0 gl-temp)
                (up-modify-goal gl-temp8 g:+ gl-temp)
                (up-modify-sn sn-focus-player-number c:= my-player-number)
                (up-get-player-fact focus-player military-population 0 gl-temp)
                (up-modify-goal gl-temp8 g:+ gl-temp)
            )

            (defrule
                (up-compare-goal gl-my-position == 4)
                =>
                ;(up-chat-data-to-all "first flank target is player %d" g: gl-temp1)
                ;(up-chat-data-to-all "second flank target is player %d" g: gl-temp2)
                ;(up-chat-data-to-all "first enemy pocket is %d" g: gl-temp3)
                ;(up-chat-data-to-all "second enemy pocket is %d" g: gl-temp4)
                ;(up-chat-data-to-all "enemy pockets have %d combined vills" g: gl-temp5)
                ;(up-chat-data-to-all "enemy pockets have %d combined military" g: gl-temp6)
                ;(up-chat-data-to-all "our pockets have %d combined vills" g: gl-temp7)
                ;(up-chat-data-to-all "our pockets have %d combined military" g: gl-temp8)
                (up-modify-goal gl-temp g:= gl-temp6)
                (up-modify-goal gl-temp6 g:- gl-temp8)
                (up-modify-goal gl-temp6 g:- gl-temp5)
                (up-modify-goal gl-temp6 g:+ gl-temp7)
                ;(up-chat-data-to-all "enemy pockets have prioritised military over vills by %d more units than our pockets" g: gl-temp6)
            )

            ;et fingerpeg kan være at tallet når over 30 inden 25-26 min

            (defrule
                (up-compare-goal gl-my-position == 4)
                (up-compare-goal gl-temp6 > 30)
                (game-time >= 1200) ;20 min
                (game-time < 1560) ;26 min
                =>
                ;(up-chat-data-to-all "enemy pockets have prioritised military over vills by %d more units than our pockets" g: gl-temp6)
                ;(chat-to-all "delaying imp to produce more knights")
                ;(set-goal gl-delay-imp-new 1)
                (disable-self)
            )

            (defrule
                (or(taunt-detected any-ally 190)
                (taunt-detected my-player-number 190))
                =>
                (up-chat-data-to-all "enemy pockets have prioritised military over vills by %d more units than our pockets" g: gl-temp6)
                (acknowledge-taunt my-player-number 190)
                (acknowledge-taunt every-ally 190)
            )

        ;
            (defrule
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 360 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration 1: %d" g: 181)
                )
        ; Detect if pockets are under massive attack

            (defrule
            (true)
            =>
            (set-goal gl-under-massive-attack -1)
            (up-full-reset-search)
            (up-get-point position-self gl-temp1-x)
            (up-set-target-point gl-temp1-x)
            (up-filter-distance c: -1 c: 40)
            (set-strategic-number sn-focus-player-number 1)
            )

            (defrule ;list remote units after id (every time)
            (players-stance focus-player enemy)
            =>
            (up-filter-include cmdid-military -1 -1 -1)(up-find-remote c: all-units-class c: 240)(up-filter-include cmdid-villager -1 -1 -1)(up-find-remote c: all-units-class c: 240)        
            )

            (defrule
            (up-compare-sn sn-focus-player-number < 8)
            =>
            (up-modify-sn sn-focus-player-number c:+ 1)
            (up-jump-rule -2)
            )

            (defrule
            (true)
            =>
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-temp1 g:= gl-remote-total)
            (up-remove-objects search-remote object-data-class != cavalry-class)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-temp1 g:+ gl-remote-total)
            )

            ;Find egen score af ungrouped units hvor cavalry tæller for 2 og qued units for 1

            (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: knight-line c: 200)
            (up-remove-objects search-local object-data-group-flag == knight-group)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-temp2 g:= gl-local-total)
            (up-get-fact unit-type-count knight-line gl-temp)
            (up-modify-goal gl-temp2 g:- gl-temp)
            (up-get-fact unit-type-count-total knight-line gl-temp)
            (up-modify-goal gl-temp2 g:+ gl-temp)
            (up-modify-goal gl-temp2 c:* 100)
            (up-modify-goal gl-temp2 g:/ gl-temp1)
            )

            ;Hvis modstanderens score er over 10 og over det dobbelte af egen score er man under 
            ;massive attack
            ;hvis kriterierne er opfyldt opløses knight gruppen og en retreat timer starter på 999 sek.

            (defrule
            (up-compare-goal gl-temp1 >= 10)
            (up-compare-goal gl-temp2 < 50)
            =>
            (set-goal gl-under-massive-attack 1)
            )

        ;
            (defrule
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 361 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration 1: %d" g: 181)
                )
