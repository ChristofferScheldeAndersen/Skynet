                ; Change building system (safe)

                    (defrule
                    (or(up-compare-goal gl-need-stable == YES)
                    (or(up-compare-goal gl-need-blacksmith == YES)
                    (or(up-compare-goal gl-need-mining-camp == YES)
                    (or(up-compare-goal gl-need-archery-range == YES)
                    (or(up-compare-goal gl-need-tower == YES)
                    (or(up-compare-goal gl-need-house == YES)
                    (up-compare-goal gl-need-market == YES)))))))
                        =>
                        (set-goal gl-split-rule 300)
                        (set-goal gl-building-system standard-system) ;denne ændring forhindrer gemte vill id's i at blive ændret
                        (set-strategic-number sn-cap-civilian-builders 99)
                    )

                    (defrule
                    (up-compare-goal gl-building-system == build-line-system)
                    (or(goal gl-split-rule 300)
                    (up-compare-goal gl-need-mill == YES))

                        =>
