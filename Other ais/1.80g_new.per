                ; Farms
                    ; Count the number of unfinished farms (not build with a working villager)
                            
                            ; på samme måde kan antallet af unfinished farms uafhænigt af attending findes
                            
                            (defrule
                                (true)
                                =>
                                (set-goal gl-unfinished-farms 0)
                            )

                            (defrule
                                (up-compare-goal gl-first-unfinished-farm != -1)
                                =>
                                (up-modify-goal gl-unfinished-farms c:+ 1)
                            ) 

                            (defrule
                                (up-compare-goal gl-second-unfinished-farm != -1)
                                =>
                                (up-modify-goal gl-unfinished-farms c:+ 1)
                            ) 

                            (defrule
                                (up-compare-goal gl-third-unfinished-farm != -1)
                                =>
                                (up-modify-goal gl-unfinished-farms c:+ 1)
                            ) 

                            (defrule
                                (up-compare-goal gl-forth-unfinished-farm != -1)
                                =>
                                (up-modify-goal gl-unfinished-farms c:+ 1)
                            ) 

                            (defrule
                                (up-compare-goal gl-fifth-unfinished-farm != -1)
                                =>
                                (up-modify-goal gl-unfinished-farms c:+ 1)
                            ) 

                            (defrule ;buggy
                                (goal gl-unfinished-farms 5)
                                (not(and(up-set-target-by-id g: gl-first-assigned-farming-vill)
                                (and(up-set-target-by-id g: gl-second-assigned-farming-vill)
                                (and(up-set-target-by-id g: gl-third-assigned-farming-vill)
                                (and(up-set-target-by-id g: gl-forth-assigned-farming-vill)
                                (up-set-target-by-id g: gl-fifth-assigned-farming-vill))))))
                                =>
                                (set-goal gl-split-rule 250)
                                ;(chat-to-all "resetting unbuild farm goal 1")
                            )

                            (defrule ;buggy
                                (goal gl-unfinished-farms 5)
                                (up-pending-objects c: farm == 0)
                                =>
                                (set-goal gl-split-rule 250)
                                ;(chat-to-all "resetting unbuild farm goal 2")
                            )

                            (defrule
                                (goal gl-split-rule 250)
                                =>
                                (set-goal gl-unfinished-farms 0)
                                (set-goal gl-first-unfinished-farm -1)
                                (set-goal gl-second-unfinished-farm -1)
                                (set-goal gl-third-unfinished-farm -1)
                                (set-goal gl-forth-unfinished-farm -1)
                                (set-goal gl-fifth-unfinished-farm -1)
                                ;(chat-to-all "resetting farm goals to avoid bugs")
                                (do-nothing)
                            )
                                
                        
                    ; Calculating number available villagers for farming
                            (defrule
                                (true)
                                =>
                                (up-full-reset-search)
                                (up-find-local c: villager-class c: 200)
                                (up-remove-objects search-local object-data-group-flag != wood-group)
                                (up-get-search-state gl-local-total)
                                (up-modify-goal gl-stragglers-and-farmers g:= gl-local-total)
                                
                            )

                            (defrule
                                (true)
                                =>
