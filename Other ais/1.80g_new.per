                    (up-filter-include cmdid-monk -1 -1 -1)
                    (up-find-remote c: monk c: 40)(up-filter-include cmdid-military -1 -1 -1)   (up-find-remote c: all-units-class c: 240)(up-filter-include cmdid-villager -1 -1 -1)(up-find-remote c: all-units-class c: 240)        
                    ;(up-clean-search search-remote object-data-id search-order-asc)
                    (set-goal gl-temp3 0)
                    (set-goal gl-temp4 0)
                    (set-goal gl-temp5 0)
                    (set-goal gl-temp6 0)
                    (set-goal gl-temp7 0)
                    )

                    (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -4)
                    )

                    ;loop gennem alle remote units og tjeck deres remaining hits

                    (defrule 
                    (up-set-target-object search-remote g: gl-temp2)
                    =>
                    (up-get-object-data object-data-hitpoints gl-temp3) ;30
                    (up-get-object-data object-data-pierce-armor gl-temp4) ;1
                    (up-modify-goal gl-temp5 g:= gl-temp1) ;5 (6 for skirms)
                    (up-modify-goal gl-temp5 g:- gl-temp4); 4 (5 for skirms)
                    )

                    (defrule ;target unit is a vill
                        (up-object-data object-data-class == archery-class)
                        (goal gl-skirm-group-chosen 1)
                        =>
                        (up-modify-goal gl-temp5 c:+ 3) 
                    )

                    (defrule ;target unit is a skirm
                        (or(up-object-data object-data-type == 6)
                        (or(up-object-data object-data-type == 7)
                        (up-object-data object-data-type == spearman-line))) ;elite
                        (goal gl-skirm-group-chosen 1)
                        (up-compare-goal gl-temp5 < 3)
                        (or(not(research-completed ri-elite-skirmisher))
                        (up-object-data object-data-type == spearman-line))
                        =>
                        (up-modify-goal gl-temp5 c:= 3) 
                    )

                    (defrule ;target unit is a skirm
                        (or(up-object-data object-data-type == 6)
                        (up-object-data object-data-type == 7)) ;elite
                        (goal gl-skirm-group-chosen 1)
                        (up-compare-goal gl-temp5 < 4)
                        (research-completed ri-elite-skirmisher)
                        =>
                        (up-modify-goal gl-temp5 c:= 4) 
                    )

                    (defrule 
                    (up-set-target-object search-remote g: gl-temp2)
                    (up-compare-goal gl-temp5 < 1)
                    =>
                    (up-modify-goal gl-temp5 c:= 1) ;minimum damage is 1.
                    )

                    (defrule 
                    (up-set-target-object search-remote g: gl-temp2)
                    =>
                    (up-modify-goal gl-temp6 g:= gl-temp3)
                    (up-modify-goal gl-temp6 g:/ gl-temp5) ;gl-temp6 number of hits: 30/4 = 7,5 == 7 or 8
                    (up-modify-goal gl-temp7 g:= gl-temp6) ;check if number of hits is rounded down
                    (up-modify-goal gl-temp7 g:* gl-temp5) ;if 7*4 = 28 which is < than gl-temp3 hitpoints
                    )

                    (defrule ;If number of remaining hits has been rounded down add 1 to its goal.
                    (up-set-target-object search-remote g: gl-temp2)
                    (up-compare-goal gl-temp7 g:< gl-temp3)
                    =>
                    (up-modify-goal gl-temp6 c:+ 1)
                    )
                    
                    (defrule
                        (up-set-target-object search-remote g: gl-temp2)
                        =>
                        (up-get-object-data object-data-precise-x gl-temp-x)
                        (up-get-object-data object-data-precise-y gl-temp-y)
                    )



                    (defrule ;set respective goals for remaining hits
