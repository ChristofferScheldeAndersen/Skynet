            ; Siege units are expensive and really important when needed. It's because they have a greater priority over other units
            ; 8 rams to smash enemy's base when attacking, at least 2 rams if enemy builds a castle to avoid possible too late rams
            (defrule
                    (or(unit-type-count-total battering-ram-line < 2)
                (or(and(players-building-type-count any-enemy castle > 0)
                (current-age == imperial-age))
                (and(current-age == imperial-age)
                (unit-type-count-total battering-ram-line < 5))))
                (not(and(goal gl-position Flank)
                (or(research-available ri-arbalest)
                (research-available ri-ring-archer-armor))))
                =>
                (set-goal gl-split-rule 193))

                (defrule
                (unit-type-count-total battering-ram-line < 8)
                (goal gl-split-rule 193)
                (or(players-building-type-count target-player watch-tower-line > 0)
                (or(up-compare-goal gl-MILITARY-SUPERIORITY > 25)
                (and(up-compare-goal gl-MILITARY-SUPERIORITY > 15)
                (current-age == imperial-age))))
                (game-time > 5) =>
                (train battering-ram-line)
            )



            (defrule
                (current-age == feudal-age)
                (not(and(food-amount > 470)
                (gold-amount < 245)))
                (not(and(research-available ri-fletching)
                (gold-amount < 95)))
                (not(and(enemy-buildings-in-town)
                (unit-type-count archer-line > 2)))
                =>
                (set-goal gl-split-rule 194))

                (defrule
                (goal gl-split-rule 194)
                (not(and(game-time < 1200)
                (and(up-compare-goal gl-MILITARY-SUPERIORITY >= -2)
                (and(players-unit-type-count target-player archer-line >= 4)
                (unit-type-count archer-line < 9)))))
                (or(goal g-enemy-is-walled 0)
                (military-population < 5))
                    (game-time > 5) =>
                (train archer-line)
                )

        (defrule
        (or	(current-age != feudal-age)
                    (military-population >= 10))
        =>		(up-jump-rule 1))

            (defrule
                (building-type-count mining-camp > 0)
                (not(and(food-amount > 470)
                (gold-amount < 245)))
                (not(and(players-unit-type-count target-player skirmisher-line >= 5)
                (up-compare-goal gl-MILITARY-SUPERIORITY >= Agressiveness)))
                (not(and(research-available ri-fletching)
                (gold-amount < 95)))
                (goal gl-age-status advancing-to-castle)
                =>
