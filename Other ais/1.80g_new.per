        ;8 preventing sheep from returning to tc prematurely
            (defrule
                (up-set-target-by-id g: gl-explore-sheep-one)
                =>
                (up-get-point position-self gl-temp1-x)
                (up-get-point position-object gl-temp2-x)
                (up-get-object-data object-data-move-x gl-temp3-x)
                (up-get-object-data object-data-move-y gl-temp3-y)
                ;(up-send-flare gl-temp3-x)
                ;(up-chat-data-to-player my-player-number "gl-temp3-x is %d." g: gl-temp3-x)
                ;(up-chat-data-to-player my-player-number "gl-temp3-y is %d." g: gl-temp3-y)
            )

            (defrule
                (up-set-target-by-id g: gl-explore-sheep-one)
                (up-point-distance gl-temp1-x gl-temp2-x > 8)
                (up-point-distance gl-temp1-x gl-temp3-x <= 8)
                (up-timer-status 20 != timer-running)
                (game-time > 30)
                =>
                ;(chat-to-all "sheep 1 is moving towards tc to soon, forcing it to stop")
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-explore-sheep-one)
                (up-lerp-tiles gl-temp2-x gl-temp1-x c: -4)
                (up-target-point gl-temp2-x action-stop -1 -1)
                (enable-timer 20 10)
            )

            (defrule
                (up-set-target-by-id g: gl-explore-sheep-two)
                =>
                (up-get-point position-self gl-temp1-x)
                (up-get-point position-object gl-temp2-x)
                (up-get-object-data object-data-move-x gl-temp3-x)
            )

            (defrule
                (up-set-target-by-id g: gl-explore-sheep-two)
                (up-point-distance gl-temp1-x gl-temp2-x > 8)
                (up-point-distance gl-temp1-x gl-temp3-x <= 6)
                (up-timer-status 21 != timer-running)
                (game-time > 30)
                =>
                ;(chat-to-all "sheep 2 is moving towards tc to soon, forcing it to stop")
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-explore-sheep-two)
                (up-lerp-tiles gl-temp2-x gl-temp1-x c: -4)
                (up-target-point gl-temp2-x action-stop -1 -1)
                (enable-timer 21 10)
            )
    
    
