            (set-strategic-number sn-allow-civilian-defense 3) ; test. h�ber det kan f� villagers til at arbejde mere
                (set-strategic-number sn-maximum-town-size 22)
            )



            (defrule
            (game-time > 600)
                (and(unit-type-count villager-stone < 2)
                (and(unit-type-count villager-gold < 2)
                (and(unit-type-count villager-wood < 2)
                (unit-type-count villager-food < 2))))
                (not(up-timer-status idle-eco-timer == timer-running))
                (not(up-timer-status idle-eco-timer == timer-triggered))
