                (game-time > 840)
                =>
                (up-reset-search 1 1 1 1)
                    (up-reset-filters)
                    (up-filter-distance c: 0 c: 200)
                    (up-find-local c: 900 c: 100)
                (up-find-local c: -287 c: 100)
                ;(up-find-local c: 913 c: 100)
                    (up-get-point position-self gl-point-tc-x)
                    (up-target-point gl-point-tc-x action-default -1 -1)

                (set-strategic-number sn-disable-defend-groups 1)
                (set-strategic-number sn-number-attack-groups 0)

                ;(up-set-attack-stance archery-class c: stance-no-attack)
                    ;(up-set-attack-stance knight-line c: stance-no-attack)
                    (up-gather-inside c: stable c: 1)
                    (up-gather-inside c: archery-range c: 1)
                ;;(chat-to-all "full retreat")
                )

                (defrule
                (goal gl-agression-mode retreating)
                (or(up-timer-status full-retreat-timer == timer-running)
                (timer-triggered no-fighting-timer))
                (game-time > 900)
                =>
                (up-reset-search 1 1 1 1)
                    (up-reset-filters)
                    (up-filter-distance c: 0 c: 200)
                    (up-find-local c: 913 c: 100) ; siege
                    (up-get-point position-self gl-point-tc-x)
                    ;(up-target-point gl-point-tc-x action-default -1 -1)
                )

                (defrule
                    (goal gl-agression-mode retreating)
                    (timer-triggered no-fighting-timer)
                    (game-time > 840)
                    =>
                    (set-goal gl-split-rule 612)
                )

                (defrule
                    (goal gl-split-rule 612)
                    =>
                    (disable-timer no-fighting-timer)


                (up-full-reset-search)
                    (up-filter-distance c: 0 c: 200)
                    (up-find-local c: 900 c: 100)
                (up-find-local c: -287 c: 100)
                ;(up-find-local c: 913 c: 100)
                (up-filter-exclude -1 -1 -1 448)
                    (up-get-point position-self gl-point-tc-x)
                    ;(up-target-point gl-point-tc-x action-default -1 -1)

                ;(set-strategic-number sn-disable-defend-groups 1)
                (set-strategic-number sn-number-attack-groups 0)

                (up-set-attack-stance archery-class c: stance-defensive)
                    (up-set-attack-stance knight-line c: stance-defensive)
                    (up-gather-inside c: stable c: 1)
                    (up-gather-inside c: archery-range c: 1)

                (enable-timer no-fighting-timer 8)
                    ) ; full-retreat når military superiority er under -3
                

                (defrule
                    (or(military-population >= 15)
                    (or(unit-type-count knight-line >= 10)
                    (or(and(game-time < 1200)
                    (military-population >= 8))
                    (and(military-population >= 4)
                    (game-time < 1100)))))
                    =>
                    (set-goal gl-split-rule 614)
                )

                (defrule
                    (goal gl-split-rule 614)
                    (and(wood-amount < 35)
                    (and(up-pending-objects c: skirmisher-line == 0)
                    (and(up-pending-objects c: archer-line == 0)
                    (military-population < 15)))) ;forsøg på at sikre militær bliver brugt hvis wood er denied.
                    =>
                    (set-goal gl-split-rule 615)
                )
                    
                
                (defrule
                    (goal gl-split-rule 615)
                    (timer-triggered retreat-timer)
                    (up-compare-goal gl-MILITARY-SUPERIORITY < Defensiveness)
                    
                    (game-time > 900) ; 15 min) 
                    (town-under-attack) ; forsøg på at undgå hassarderede forhaste counterpush
                    =>
                    (disable-timer retreat-timer)
                    (up-modify-goal gl-retreat-waiting-points c:+ 1) 
                    (enable-timer retreat-timer 4)
                ) ; giver 20 military superiority i minuttet indtil den er 10+. kræver 20 mil eller 10 knight

                (defrule
                    (up-compare-goal gl-MILITARY-SUPERIORITY >= Defensiveness)
                    (up-timer-status counter-push-timer != timer-running)
                    (current-age != feudal-age)
                    =>
                    (disable-timer no-fighting-timer)
                    (disable-timer retreat-timer)
                    (enable-timer counter-push-timer 40)
                    ;(chat-to-all "starting counter push")
                ) 

                (defrule
                    (up-compare-goal gl-MILITARY-SUPERIORITY >= Defensiveness)
                    (up-timer-status counter-push-timer != timer-running)
                    (current-age == feudal-age)
                    =>
                    (disable-timer no-fighting-timer)
                    (disable-timer retreat-timer)
                    (enable-timer counter-push-timer 25)
                    ;(chat-to-all "starting counter push")
                ) 

                (defrule
                    (current-age != feudal-age)
                    =>
                    (up-modify-goal gl-temp1 g:= gl-MILITARY-SUPERIORITY)
                    (up-modify-goal gl-temp1 c:+ 40)
                    (up-modify-goal gl-temp2 s:= sn-maximum-town-size)
                    (set-strategic-number sn-maximum-town-size 40)
                )

                #load-if-defined UP-1-PLAYER-TEAM
                (defrule
                    (current-age != feudal-age)
                    =>
                    (set-strategic-number sn-maximum-town-size 55)
                )
                #end-if

                #load-if-defined UP-2-PLAYER-TEAM
                (defrule
                    (current-age != feudal-age)
                    =>
                    (set-strategic-number sn-maximum-town-size 55)
                )
                #end-if

                (defrule
                    (or(current-age == feudal-age)
                    (military-population < 10))
                    =>
                    (up-modify-goal gl-temp1 g:= gl-MILITARY-SUPERIORITY)
                    (up-modify-goal gl-temp1 c:+ 20)
                    (up-modify-goal gl-temp2 s:= sn-maximum-town-size)
                    (set-strategic-number sn-maximum-town-size 40)
                )


                (defrule
                    (or(timer-triggered counter-push-timer)
                    (or(up-compare-goal gl-retreat-waiting-points g:> gl-temp1)
                    (not(up-enemy-units-in-town > 1))))
                    (up-compare-goal gl-retreat-waiting-points c:> 2)
                    =>
                    ;(chat-to-all "stop counter push4")
                    ;(up-chat-data-to-all "gl-retreat-waiting-points is %d" g: gl-retreat-waiting-points)
                    ;(up-chat-data-to-all "maximum waiting points is %d" g: gl-temp1)
                    ;(up-chat-data-to-all "enemy units in town are %d" c: enemy-buildings-in-town)
                    (disable-timer counter-push-timer)
                    (up-modify-goal gl-retreat-waiting-points c:= 0)
                ) ; stopper ventebonussen og fjerner vente-point efter 20 sek

                (defrule
                    (true)
                    =>
                    (up-modify-sn sn-maximum-town-size g:= gl-temp2)
                )


            ;******************************************************************************
            ;
        ; Defensive-mode
                ;
                ;******************************************************************************

                (defrule 
                (up-compare-goal gl-MILITARY-SUPERIORITY >= Agressiveness)
                (up-compare-goal gl-MILITARY-SUPERIORITY < Defensiveness)
                (not(goal gl-agression-mode defensive))
                        =>
                        (set-goal gl-agression-mode defensive)
                    ; (enable-timer gather-army-timer 1)
                        (set-strategic-number sn-disable-defend-groups 0) ;var 8 før
                        (set-strategic-number sn-number-attack-groups 0)
                        ;(set-strategic-number sn-number-defend-groups 9999)
                        ;(set-strategic-number sn-maximum-defend-group-size 1)
                        ;(set-strategic-number sn-minimum-defend-group-size 1)
                        (up-set-attack-stance archery-class c: stance-aggressive)
                    (up-set-attack-stance knight-line c: stance-aggressive)
                ) ; hvis military superiority er mellem -3 og 9 går ai i defensive-mode



                (defrule
                    (goal gl-agression-mode defensive)
                    (nor(town-under-attack)
                    (up-enemy-units-in-town > 1))
                        =>
                    (set-strategic-number sn-maximum-attack-group-size 0)
                    (set-strategic-number sn-minimum-attack-group-size 0)
                    (set-strategic-number sn-number-attack-groups 0)

                    (up-gather-inside c: stable c: 0)
                    (up-gather-inside c: archery-range c: 0)
                    (up-set-attack-stance archery-class c: stance-aggressive)
                    (up-set-attack-stance knight-line c: stance-aggressive)

                        ) ; når ai'en ikke angribes samler den sin hær et sikker sted hvert halve minut

                (defrule
                    (true)
                    =>
                    (up-get-point position-self gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-full-reset-search)
                    (up-get-search-state gl-local-total)
                    (up-filter-distance c: -1 c: 25)
                    (set-strategic-number sn-focus-player-number 1)
                )

                (defrule
                    (players-stance focus-player enemy)
                    =>
                    (up-find-remote c: all-units-class c: 40)
                    (up-get-search-state gl-local-total)
                )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )

                (defrule
                    (up-compare-goal gl-remote-total >= 3)
                    =>
                    ;(chat-to-all "enemy in town. Dont retreat")
                    (do-nothing)
                )

                (defrule
                    (goal gl-agression-mode defensive)
                    (nor(town-under-attack)
                    (or(up-enemy-units-in-town > 1)
                    (enemy-buildings-in-town)))
                    (timer-triggered gather-army-timer)
                    (game-time > 840)
                    (or(up-compare-goal gl-remote-total < 3)
                    (current-age < castle-age))
                    =>
                    (set-goal gl-split-rule 616)
                )

                (defrule
                    (goal gl-split-rule 616)
                    =>
                    (disable-timer gather-army-timer)

                (up-retreat-now)

                    (up-retreat-to town-center c: archer-line)
                    (up-retreat-to watch-tower c: archer-line)
                    (up-retreat-to castle c: archer-line)

                (up-reset-search 1 1 1 1)
                    (up-reset-filters)
                    (up-filter-distance c: 0 c: 45)
                    (up-find-local c: 900 c: 100)
                (up-find-local c: -287 c: 100)
                ;(up-find-local c: 913 c: 100)
                (up-filter-exclude -1 -1 -1 448)
                    (up-get-point position-self gl-point-tc-x)
                    (up-target-point gl-point-tc-x action-default -1 -1) ; virker tilsyneladende ikke

                    (enable-timer gather-army-timer 20)
                    ) 
                    

                ;(defrule
                ;    (goal gl-agression-mode defensive)
                ;    (town-under-attack)
                ;    (up-enemy-units-in-town > 1)
                ;    =>
                ;    (set-strategic-number sn-maximum-attack-group-size 1)
                ;   (set-strategic-number sn-minimum-attack-group-size 1)
                ;    (set-strategic-number sn-number-attack-groups 200)

                ; (up-gather-inside c: stable c: 0)
                    ;(up-gather-inside c: archery-range c: 0)
                ;    (up-set-attack-stance archery-class c: stance-aggressive)
                ;	(up-set-attack-stance knight-line c: stance-aggressive)
                
                ;        ) ; når ai'en angribes går den angreb som om den var i attacking-mode
                        ; dog kun inden for town size

                (defrule
                    (goal gl-agression-mode defensive)
                    (town-under-attack)
                    (up-enemy-units-in-town > 1)
                    (game-time > 930)
                    =>
                    (up-gather-inside c: stable c: 0)
                    (up-gather-inside c: archery-range c: 0)
                        )

                ;#end-if

            ;******************************************************************************
            ;
        ; Attacking-mode
                ;
                ;******************************************************************************


                (defrule
                    (up-compare-goal gl-MILITARY-SUPERIORITY >= Defensiveness)
                    (game-time > 10)
                        =>
                    (set-goal gl-agression-mode attacking)
                    ;(set-strategic-number sn-disable-defend-groups 1)
                ;(set-strategic-number sn-maximum-attack-group-size 1)
                ;(set-strategic-number sn-minimum-attack-group-size 1)
                    ;(set-strategic-number sn-number-attack-groups 0)
                    (set-strategic-number sn-disable-defend-groups 0)
                (set-strategic-number sn-maximum-attack-group-size 2)
                (set-strategic-number sn-minimum-attack-group-size 1)
                    (set-strategic-number sn-number-attack-groups 200)
                        

                    (up-gather-inside c: stable c: 0)
                    (up-gather-inside c: archery-range c: 0)
                    (up-set-attack-stance archery-class c: stance-aggressive)
                    (up-set-attack-stance knight-line c: stance-aggressive)
                ) ; angiber for fuld kraft når military superiority er 10+


                #end-if




            ;******************************************************************************
            ;
        ; Military superiority timers and chat
            ;
            ;******************************************************************************


            (defrule
            (timer-triggered agression-chat-timer)
                (goal gl-agression-mode attacking)
            =>
            ;;(chat-to-all "agression-mode: attacking")
            (do-nothing)
            )

            (defrule
            (timer-triggered agression-chat-timer)
                (goal gl-agression-mode defensive)
                (nor(town-under-attack)
                (up-enemy-units-in-town > 1))
            =>
            ;;(chat-to-all "agression-mode: defensive gathering units")
            (do-nothing)
            )

            (defrule
            (timer-triggered agression-chat-timer)
                (goal gl-agression-mode defensive)
                (town-under-attack)
                (up-enemy-units-in-town > 1)
            =>
            ;;(chat-to-all "agression-mode: defensive but attacking")
            (do-nothing)
            )

            (defrule
            (timer-triggered agression-chat-timer)
                (goal gl-agression-mode retreating)
            =>
            ;;(chat-to-all "agression-mode: retreating")
            (do-nothing)
            )

            ;;;

            (defrule
                (game-time > 600)
            ;  (game-time > 60)
            =>
            (enable-timer Military-Superiority-timer 60)
            (enable-timer agression-chat-timer 60)
                (disable-self)
            )

            (defrule
            (true)
            =>
            (up-get-fact defend-soldier-count 0 gl-temp)
            )

            (defrule
            (timer-triggered Military-Superiority-timer)
                =>
            (disable-timer Military-Superiority-timer)
            (enable-timer Military-Superiority-timer 60)
            ;;;(up-chat-data-to-all "Millitary of target player is %d." g: gl-ENEMY-MILITARY )
            ;;;(up-chat-data-to-all "target player is %d." s: sn-target-player-number)
            ;;;(up-chat-data-to-all "Military superiority is %d." g: gl-MILITARY-SUPERIORITY )
            ;;;(up-chat-data-to-all "Team military superiority is %d." g: gl-TEAM-MILITARY-SUPERIORITY )
            ;;;(up-chat-data-to-all "Military superiority of my flank is %d." g: gl-POCKET-MILITARY-SUPERIORITY )
            ; ;;;(up-chat-data-to-all "My flank military superiority is %d." s: sn-FLANK-MILITARY-SUPERIORITY)
            ;;;(up-chat-data-to-all "My flank is player %d." g:= gl-myflank ); viser defconst??
            ;;;(up-chat-data-to-all "My flank is player %d." g: gl-myflank )
            ;;;(up-chat-data-to-all "sn-number-civilian-militia is %d." s: sn-number-civilian-militia )
            ;;;(up-chat-data-to-all "sn-allow-civilian-offense is %d." s: sn-allow-civilian-offense )
            ;;;(up-chat-data-to-all "sn-allow-civilian-defense is %d." s: sn-allow-civilian-defense )
            ;;;(up-chat-data-to-all "sn-placement-fail-delta is %d." s: sn-placement-fail-delta )
            ;;;;(up-chat-data-to-all "sn-maximum-town-size is %d." s: sn-maximum-town-size )
            ;;;(up-chat-data-to-all "gl-flank-needs-assistance is %d." g: gl-flank-needs-assistance)
            ;;;(up-chat-data-to-all "gl-flank-needs-assistance is %d." s: sn-flank-needs-assistance)
            ;;;;(up-chat-data-to-all "Defend soldier count is %d." g: gl-temp)
            ;;;(up-chat-data-to-all "gl-safe-tc-spot-x %d." g: gl-safe-tc-spot-x)
            ;;;(up-chat-data-to-all "My pocket priority is %d." g: gl-pocket-military-priority)
            ;;;(up-chat-data-to-all "sn-disable-attack-groups is %d." s: sn-disable-attack-groups)
            ;;;(up-chat-data-to-all "sn-minimum-attack-group-size is %d." s: sn-minimum-attack-group-size)
            ;;;(up-chat-data-to-all "sn-number-attack-groups is %d." s: sn-number-attack-groups)
            ;;;(up-chat-data-to-all "sn-maximum-attack-group-size is %d." s: sn-maximum-attack-group-size)
            ;;;(up-chat-data-to-all "sn-coop-share-attacking is %d." s: sn-coop-share-attacking)
            ;;;(up-chat-data-to-all "sn-attack-winning-player is %d." s: sn-attack-winning-player)
            ;;;(up-chat-data-to-all "sn-attack-intelligence is %d." s: sn-attack-intelligence)
            ;;;(up-chat-data-to-all "sn-scale-minimum-attack-group-size is %d." s: sn-scale-minimum-attack-group-size)
            ;;;(up-chat-data-to-all "sn-scale-maximum-attack-group-size is %d." s: sn-scale-maximum-attack-group-size)
            ;;;(up-chat-data-to-all "sn-scaling-frequency %d." s: sn-scaling-frequency)
            (do-nothing)
            )

            (defrule
            (timer-triggered agression-chat-timer)
                =>
            (disable-timer agression-chat-timer)
            (enable-timer agression-chat-timer 60)
            )











        ; Pocket safety




            ;fix overdreven hjælp af flank
            ;1 slå hjælp fra når flank er stort set død. f.eks. når flank mangler tc, er meget low pop eller er håbløst bagud.
            ;2 slå hjælp af flank fra hvis denne er langt foran og anden pocket er i problemer.
            ;3 hjælp pocket i problemer
            ;3 slå hjælp af flank fra hvis ai selv angribes af signifikant antal units eller hvis trade er under anbreb

            ;lav et goal der dedekterer disse ting.


            #load-if-defined UP-POCKET-POSITION




            (defrule
            (game-time > 5)
            =>
            (up-modify-sn sn-focus-player-number g:= gl-myflank)
            )

            (defrule
            (not(up-enemy-units-in-town >= 3))
            (players-population focus-player > 35)
                =>
            (set-goal gl-pocket-military-priority -1)
            ;(set-goal sn-pocket-safety 3)
            )

            (defrule
            (game-time > 1500)
            (or(players-population focus-player < 20)
            (or(up-compare-goal gl-POCKET-MILITARY-SUPERIORITY < -30) 
            (players-building-type-count focus-player town-center == 0)))

            =>
            (set-goal gl-pocket-military-priority defend-own-base)
            (set-goal sn-pocket-safety 2)
            ;;;(chat-to-all "Flank is dead. Definding own base")
            ;;;(up-chat-data-to-all "flank military superiority is %d." g: gl-POCKET-MILITARY-SUPERIORITY)
            ;;;(up-chat-data-to-all "my flank is player %d." g: gl-myflank)
            ;;;(up-chat-data-to-all "focus player is %d." s: sn-focus-player-number)
            )

            (defrule
            (up-enemy-units-in-town >= 3)
            =>
            (set-goal gl-pocket-military-priority defend-own-base)
            ;(set-goal sn-pocket-safety 3)
            ;;(chat-to-all "Im under attack. Definding own base")
            )


            (defrule
            (up-enemy-units-in-town >= 6)
            (unit-type-count knight-line < 6)
            =>
            (set-goal sn-pocket-safety 2)
            ;;(chat-to-all "Im under attack and vulnerable. Definding own base")
            )

            (defrule
            (game-time > 900)
            (up-compare-goal gl-POCKET-MILITARY-SUPERIORITY > 20) 
                =>
            ;(set-goal gl-pocket-military-priority -1)
            ;;(chat-to-all "Flank is far ahead. Definding other flank")
            ;(set-goal sn-pocket-safety 4)
            (disable-self)
            )

            (defrule
            (up-enemy-units-in-town >= 3)
            =>
            (up-gather-inside c: stable c: 0)
            )

            (defrule
            (research-completed ri-plate-barding)
            =>
            (set-goal gl-pocket-military-priority defend-own-base)
            (set-goal sn-pocket-safety 4)
            )


            #end-if

            ; sidste del. Skab goal med team military superiority og brug det til at kompensere for pocket pasivitet i early 
            ; imp.




        ; Sending pocket knights back to defend
            
            (defrule
                    (up-compare-goal gl-my-position == pocket)
                    (current-age == castle-age)
                    =>
                    (up-modify-goal gl-temp2 s:= sn-maximum-town-size)
                    (up-modify-sn sn-maximum-town-size c:= 50)
                    (up-full-reset-search)
                    (up-get-point position-self gl-temp1-x)
                    (up-set-target-point gl-temp1-x)
                    (up-find-local c: knight-line c: 200)
                    (up-remove-objects search-local object-data-distance < 40)
                    (up-get-search-state gl-local-total)
                )
        
                (defrule
                    ;(up-compare-goal gl-MILITARY-SUPERIORITY < Agressiveness)
                    (up-compare-goal gl-my-position == pocket)
                    (current-age == castle-age)
                    (up-enemy-units-in-town >= 3)
                    ;(town-under-attack)
                    (up-compare-goal gl-local-total > 2)
                    =>
                    (up-target-point gl-temp1-x action-move -1 stance-no-attack)
                    ;(chat-to-all "sending back knights to defend")
                    
                )

                (defrule
                    ;(up-compare-goal gl-MILITARY-SUPERIORITY < Agressiveness)
                    (up-compare-goal gl-my-position == pocket)
                    (current-age == castle-age)
                    (up-compare-goal gl-local-total <= 2)
                    =>
                    (up-set-attack-stance knight-line c: stance-aggressive)
                )

                (defrule
                    (up-compare-goal gl-my-position == pocket)
                    (current-age == castle-age)
                    =>
                    (up-modify-sn sn-maximum-town-size g:= gl-temp2)
                )
    
        ;
        ; Retargeting in old military mode
            (defrule
                (true)
                =>
                (set-goal gl-temp33 -1)
            )

            (defrule
                (true)
                =>
                (set-goal gl-temp33 1)
            )

            (defrule
            (goal gl-temp33 1)
            =>
            ;(set-goal gl-knight-micro-priority -1)
            (set-goal gl-temp1 0)
            (set-goal gl-temp1-x -1)
            (set-goal gl-temp1-y -1)
            (set-goal gl-temp2-x -1)
            (set-goal gl-temp2-y -1)
            (set-goal gl-temp3-x -1)
            (set-goal gl-temp3-y -1)
            (set-goal gl-temp4-x -1)
            (set-goal gl-temp4-y -1)
            (set-goal gl-temp5-x -1)
            (set-goal gl-temp5-y -1)
            )

            (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: knight-line c: 200)
            (up-find-local c: spearman-line c: 200)
            (up-find-local c: archer-line c: 200)
            )

            (defrule
            (true)
            =>
            (set-strategic-number sn-focus-player-number 1)
            (up-get-search-state gl-local-total)
            )

            (defrule
            (up-set-target-object search-local g: gl-temp1)
            =>
            (up-get-object-data object-data-id gl-temp)
            (up-get-point position-object gl-temp-x)
            (up-set-target-point gl-temp-x)
            (up-filter-distance c: -1 c: 9)
            )

            (defrule
            (players-stance focus-player enemy)
            =>
            (up-find-remote c: castle c: 40)
            (up-remove-objects search-local object-data-status == status-pending)
            (up-clean-search search-remote -1 search-order-asc)
            )

            (defrule
