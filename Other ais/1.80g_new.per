    ;2 Town-center
        ;A Training villagers and loom
            #load-if-defined MAYAN-CIV
            (defrule
                (unit-type-count villager == 4)
                (research-available ri-loom)
                =>
                (research ri-loom)
            )
            #end-if
            (defrule
                (up-compare-goal gl-boar-score >= 47)
                (unit-type-count-total villager > 8)
                ;(unit-type-count-total villager != 11)
                ;(unit-type-count-total villager != 12)
                (can-research ri-loom)
                =>
                (research ri-loom)
            ) 
            #load-if-defined DE-AVAILABLE
            (defrule 
            (can-train villager)
            (unit-type-count-total villager < 22)
                =>
            (train villager)
            )
            #end-if

            #load-if-not-defined DE-AVAILABLE
            (defrule 
            (can-train villager)
            (unit-type-count-total villager < 23)
            (or(up-compare-goal gl-boar-score < 47)
            (up-research-status c: ri-loom >= research-pending))
                =>
            (train villager)
            )
            #end-if

                    (defrule
                        (true)
                        =>
                        (up-get-fact resource-amount amount-food gl-temp7)
                        (set-goal gl-loop-counter 0)
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-resource == wood)
                        (up-remove-objects search-local object-data-resource == stone)
                        (up-remove-objects search-local object-data-resource == gold)
                        (up-remove-objects search-local object-data-carry <= 0)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-data object-data-carry gl-villager-food)
                        (up-modify-goal gl-temp7 g:+ gl-villager-food)
                        (up-remove-objects search-local object-data-index == 0)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-compare-goal gl-local-total > 0)
                        (up-compare-goal gl-loop-counter < 50)
                        =>
                        (up-modify-goal gl-loop-counter c:+ 1)
                        (up-jump-rule -2)
                    )


            (defrule
                (up-pending-objects c: villager == 0)
                (up-compare-goal gl-temp7 <= 60)
                (research-available ri-loom)
                =>
                (research ri-loom)
            )






            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: town-center c: 1)
                (set-goal gl-temp 0)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                (or(up-object-data object-data-progress-type == 102) ;vill
                (up-object-data object-data-progress-type == 103)) ;research
                =>
                (up-get-object-data object-data-progress-value gl-temp)
                ;;;(up-chat-data-to-all "town center job is %d. % complete" g: gl-temp)
            )

            (defrule
                (up-compare-goal gl-temp >= 80) ; 5 sekunder til creation
                (can-train villager)
            (unit-type-count-total villager > 22)
            (up-compare-goal gl-strategy != 3)
            (up-compare-goal gl-fase != 2)
            
                =>
            (train villager)
            )

        ;B Forcedropping

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: town-center c: 1)
                (set-goal gl-temp 0)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                (or(up-object-data object-data-progress-type == 102) ;vill
                (up-object-data object-data-progress-type == 103)) ;research
                =>
                (up-get-object-data object-data-progress-value gl-temp)
                ;;;(up-chat-data-to-all "town center job is %d. % complete" g: gl-temp)
            )

            (defrule
                (or(and(up-compare-goal gl-temp >= 72) ; 7 sekunder til creation
                (up-pending-objects c: villager == 1))
                (up-pending-objects c: villager == 0))
                =>
                (set-goal gl-drop-off-food-time-reached YES)
            )

            (defrule
                (up-pending-objects c: villager == 2)
                =>
                (set-goal gl-drop-off-food-time-reached NO)
            )

            (defrule
                (up-pending-objects c: villager == 0)
                (current-age == dark-age)
                (unit-type-count-total villager <= 22)
                (food-amount < 50)
                (food-amount > 40)
                =>
                (up-drop-resources food c: 1) ;A relatively low amount is good here to ensure you get every last bit to ensure you have enough
            ;(chat-to-all "force drop rule 1 running")
            )

            (defrule
                (up-compare-goal gl-drop-off-food-time-reached == YES)
                (current-age == dark-age)
                (unit-type-count-total villager <= 22)
                (food-amount < 50)
                =>
                (up-drop-resources food c: 3) ;A relatively low amount is good here to ensure you get every last bit to ensure you have enough
            ;(chat-to-all "force drop rule 3 running")
            )

        ;C Gather points 
            ;Note* Killing deer will overrule any gather point set in this section
            
            ; Sheppards and early lumberjacks on sheep
                (defrule ;sæt først gather point når sheep er klar
                    (true)
                    =>
                    (up-get-point position-self gl-position-self-x)
                    (up-modify-goal gl-position-self-x c:- 1)
                    (up-modify-goal gl-position-self-y c:- 1)
                    (up-set-target-point gl-position-self-x)
                )

                (defrule
                    (up-set-target-by-id g: gl-current-sheep)
                    (up-object-data object-data-distance < 3)
               
                    (unit-type-count villager < 10)
                    (up-compare-goal gl-distance <= 2)
                    (up-compare-goal gl-distance > -1)
                    (building-type-count-total lumber-camp < 1)
                    (up-compare-goal gl-current-sheep != -1)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: town-center c: 1)
                    (up-add-object-by-id search-remote g: gl-current-sheep)
                    (up-target-objects 0 action-gather -1 -1)
                )


            ; Lumberjacks to first lc once its placed
                (defrule ; set gather point on closest tree around first lumber camp. nok en gammel regel
                    (up-pending-objects c: lumber-camp == 1)
                    (building-type-count-total lumber-camp == 1)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-lumber-camp-location-x)
                (up-filter-distance c: -1 c: 3)
                (up-filter-status c: status-ready c: list-active)
                    (up-find-resource c: wood c: 15)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: wood c: 15)
                    (up-reset-filters)
                    (up-find-local c: town-center c: 1)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    ;(up-remove-objects search-remote object-data-index < 2)
                (up-target-objects 0 action-gather -1 -1)
                    (disable-self)
                )
            
            ; Last early vills to stragglers if lc isn't build (remove?)
                (defrule ; som overstående
                    (unit-type-count villager == 10)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-lumber-camp-location-x)
                (up-filter-distance c: -1 c: 3)
                ;(up-filter-status c: status-ready c: list-active)
                    ;(up-find-resource c: wood c: 15)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: wood c: 15)
                    (up-reset-filters)
                    (up-find-local c: town-center c: 1)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    ;(up-remove-objects search-remote object-data-index < 2)
                (up-target-objects 0 action-gather -1 -1)
                    (disable-self)
                )




            ; Når berry vills går til wood - hjælp dem på vej
                (defrule 
                        (or(unit-type-count villager == 11)
                        (unit-type-count villager == 12))
                        (building-type-count-total mill < 1)
                        (up-compare-goal gl-berry-group-tree != -1)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-berry-group-tree)
                        (up-find-local c: town-center c: 1)
                        (up-target-objects 0 action-gather -1 -1)
                    )
            ; Hjælp vill nr 14 på current boar
                (defrule 
                        (unit-type-count villager == 13)
                        (up-compare-goal gl-first-boar-id != -1)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-first-boar-id)
                        (up-find-local c: town-center c: 1)
                        (up-target-objects 0 action-gather -1 -1)
                    )

            ; Berry vills on the way to mill
                (defrule ;set gather point towards berry bush?
                (or(and(unit-type-count villager == 14)
                (building-type-count-total mill > 0))
                (unit-type-count villager == 15))
                
                    =>
                    (set-goal gl-split-rule 43)
                )

                    (defrule
                        (goal gl-split-rule 43)
                        =>
                        (up-full-reset-search)
                    (up-find-local c: town-center c: 1)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-filter-distance c: 0 c: 20)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: food c: 200)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    (up-set-target-object search-remote c: 0)
                    (up-get-point position-object gl-first-berry-bush-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-lerp-tiles gl-first-berry-bush-x gl-position-self-x c: 7)
                    (up-set-target-point gl-first-berry-bush-x)
                    (up-target-point 0 action-gather -1 -1)
                )
                    
                
            ; Når hjælp vill nr 17-19 på second boar
                (defrule 
                        (unit-type-count villager >= 16)
                        (unit-type-count villager <= 18)
                        (up-compare-goal gl-second-boar-status == second-boar-is-dead)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-second-boar-id)
                        (up-find-local c: town-center c: 1)
                        (up-target-objects 0 action-gather -1 -1)
                    )

            ; Hvis boar er taget i stedet på current sheep
                (defrule 
                        (unit-type-count villager >= 16)
                        (unit-type-count villager <= 18)
                        (up-compare-goal gl-second-boar-status == second-boar-is-gone)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-current-sheep)
                        (up-find-local c: town-center c: 1)
                        (up-target-objects 0 action-gather -1 -1)
                    )  
            ; vill 20+21 to stragglers
                (defrule
                    (or(unit-type-count villager == 19)
                    (unit-type-count villager == 20))
                    =>
                    (up-full-reset-search)
                    (up-get-point position-self gl-position-self-x)
                        (up-set-target-point gl-position-self-x)
                        (up-filter-distance c: -1 c: 8)
                        (up-filter-status c: status-ready c: list-active)
                        (up-find-resource c: wood c: 40)
                        (up-filter-status c: status-resource c: list-active)
                        (up-find-resource c: wood c: 40)
                        (up-clean-search search-remote object-data-distance search-order-asc)
                        (up-find-local c: town-center c: 1)
                        (up-target-objects 0 action-gather -1 -1)
                )  
