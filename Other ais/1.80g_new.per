                (defrule
                    (up-compare-goal gl-fifth-unfinished-farm != -1)
                    (up-compare-goal gl-fifth-assigned-farming-vill == -1)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-object-data object-data-id gl-fifth-assigned-farming-vill)
                    (up-full-reset-search) 
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != farming-group)
                    (up-add-object-by-id search-local g: gl-fifth-assigned-farming-vill)
                    (up-reset-group c: farming-group)
                    (up-modify-group-flag 0 c: farming-group)
                    (up-create-group 0 0 c: farming-group)
                    (up-modify-group-flag 1 c: farming-group)
                    ;;(chat-to-player my-player-number "Adding fifth-assigned-farming-vill to farming-group")
                ) 

            ; 27-max vills - Converting stragglers to builders if needed      :X feudal-stragglers -> shepards

                (defrule
                    (true)
                    =>
                    (up-modify-goal gl-builders-needed c:= 0)
                )

                (defrule
                    (up-pending-objects c: barracks > 0)
                    =>
                    (up-modify-goal gl-builders-needed c:+ 1)
                )

                (defrule
                    (up-pending-objects c: archery-range > 0)
                    =>
                    (up-modify-goal gl-builders-needed c:+ 1)
                )

                (defrule
                    (up-pending-objects c: barracks > 1)
                    =>
                    (up-modify-goal gl-builders-needed c:+ 1)
                )

                (defrule
                    (up-pending-objects c: blacksmith > 0)
                    =>
                    (up-modify-goal gl-builders-needed c:+ 1)
                )

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != shepard-group)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-builders-needed g:- gl-local-total)
                )

                (defrule
                    (goal gl-no-more-sheep YES)
                    (up-compare-goal gl-builders-needed c:> 0) ; do we need more builders than we have?
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    
                    ;fase 1
                    ;(up-remove-objects search-local object-data-group-flag == shepard-group) ;1
                    (up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
                    (up-remove-objects search-local object-data-group-flag == berry-group) ;3
                    (up-remove-objects search-local object-data-group-flag == deer-group) ;4
                    (up-remove-objects search-local object-data-group-flag == gold-mining-group) ;5 - bliver til gold-mining-group
                        
                    ;fase 2
                    (up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
                    ;(up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
                    (up-remove-objects search-local object-data-group-flag == farming-group) ;8

                    )

                    (defrule
                    (goal gl-no-more-sheep YES)
                    (up-compare-goal gl-builders-needed c:> 0) ; do we need more builders than we have?
                    =>
                    
                    (up-remove-objects search-local object-data-id g:== gl-first-assigned-farming-vill)
                    (up-remove-objects search-local object-data-id g:== gl-second-assigned-farming-vill)
                    (up-remove-objects search-local object-data-id g:== gl-third-assigned-farming-vill)
                    (up-remove-objects search-local object-data-id g:== gl-forth-assigned-farming-vill)
                    (up-remove-objects search-local object-data-id g:== gl-fifth-assigned-farming-vill)
                    (up-remove-objects search-local object-data-index g:>= gl-builders-needed)
                    (up-reset-group c: shepard-group)            
                    (up-modify-group-flag 0 c: shepard-group)
                    (up-create-group 0 0 c: shepard-group)
                    (up-modify-group-flag 1 c: shepard-group)
                    (up-get-search-state gl-local-total)
                    ;;(up-chat-data-to-all "need more builders. Converting %d. pre-farming-villagers to shepards." g: gl-local-total)
                    )


            ; 28 vills - 6 wood1 5 berry 4 miners 6 wood2 7 she+str+far       +1 gold
                (defrule
                        (goal gl-ungrouped-vill 1)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        
                        ;fase 1
                        (up-remove-objects search-local object-data-group-flag == shepard-group) ;1
                        (up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
                        (up-remove-objects search-local object-data-group-flag == berry-group) ;3
                        (up-remove-objects search-local object-data-group-flag == deer-group) ;4
                        ;(up-remove-objects search-local object-data-group-flag == gold-mining-group) ;5 - bliver til gold-mining-group
                        
                        ;fase 2
                        (up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
                        (up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
                        (up-remove-objects search-local object-data-group-flag == farming-group) ;8
                        
                        (up-reset-group c: gold-mining-group)
                        (up-modify-group-flag 0 c: gold-mining-group)
                        (up-create-group 0 0 c: gold-mining-group)
                        (up-modify-group-flag 1 c: gold-mining-group)
                        ;;(up-chat-data-to-player my-player-number "Rehoboam has %d. pop. Adding vill to gold-mining-group" g: gl-temp)
                        (set-goal gl-ungrouped-vill -1)
                        (disable-self)
                    )    
           
            ; 29 vills - 5 wood1 5 berry 5 miners 5 wood2 9 she+str+far       +1 gold
                (defrule
                        (goal gl-ungrouped-vill 1)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        
                        ;fase 1
                        (up-remove-objects search-local object-data-group-flag == shepard-group) ;1
                        (up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
                        (up-remove-objects search-local object-data-group-flag == berry-group) ;3
                        (up-remove-objects search-local object-data-group-flag == deer-group) ;4
                        ;(up-remove-objects search-local object-data-group-flag == gold-mining-group) ;5 - bliver til gold-mining-group
                        
                        ;fase 2
                        (up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
                        (up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
                        (up-remove-objects search-local object-data-group-flag == farming-group) ;8
                        
                        (up-reset-group c: gold-mining-group)
                        (up-modify-group-flag 0 c: gold-mining-group)
                        (up-create-group 0 0 c: gold-mining-group)
                        (up-modify-group-flag 1 c: gold-mining-group)
                        ;;(up-chat-data-to-player my-player-number "Rehoboam has %d. pop. Adding vill to gold-mining-group" g: gl-temp)
                        (set-goal gl-ungrouped-vill -1)
                        (disable-self)
                    )    
            ; 29-max vills - Converting berry vill when they run out          :5 berry -> shepards
                    
                    (defrule
                        (game-time > 300)
                        =>
                        (up-full-reset-search)
                        (up-get-point position-self gl-position-self-x)
                        (up-set-target-point gl-position-self-x)
                        (up-filter-distance c: 0 c: 20)
                        (up-filter-status c: status-resource c: list-active)
                        (up-find-resource c: food c: 30)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (game-time > 300)
                        (up-compare-goal gl-remote-total <= 0)
                        =>
                        (set-goal gl-no-more-berries 1)
                    )

                    (defrule
                        (goal gl-no-more-berries 1)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        
                        ;fase 1
                        (up-remove-objects search-local object-data-group-flag == shepard-group) ;1
                        (up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
                        ;(up-remove-objects search-local object-data-group-flag == berry-group) ;3
                        (up-remove-objects search-local object-data-group-flag == deer-group) ;4
                        (up-remove-objects search-local object-data-group-flag == gold-mining-group) ;5 - bliver til gold-mining-group
                        
                        ;fase 2
                        (up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
                        (up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
                        (up-remove-objects search-local object-data-group-flag == farming-group) ;8
                        
                    )   

                    (defrule ;get one vill from berry group into first tree group
                        (goal gl-no-more-berries 1)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-data object-data-id gl-temp)
                        (up-remove-objects search-local object-data-index == 0)
                        (up-reset-group c: berry-group)
                        (up-modify-group-flag 0 c: berry-group)
                        (up-create-group 0 0 c: berry-group)
                        (up-modify-group-flag 1 c: berry-group)
                        (up-full-reset-search)
                        (set-goal gl-split-rule 620)
                        (disable-self)
                    )

                    (defrule
                        (goal gl-split-rule 620)
                        =>
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != first-tree-group)
                        (up-add-object-by-id search-local g: gl-temp)
                        (up-reset-group c: first-tree-group)
                        (up-modify-group-flag 0 c: first-tree-group)
                        (up-create-group 0 0 c: first-tree-group)
                        (up-modify-group-flag 1 c: first-tree-group)
                        (up-full-reset-search)
                        ;(chat-to-all "berries are empty. Converting 1 vill to first tree group")
                        (disable-self)
                    )
                        

                    (defrule ;get one vill from berry group into second tree group
                        (goal gl-no-more-berries 1)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-data object-data-id gl-temp)
                        (up-remove-objects search-local object-data-index == 0)
                        (up-reset-group c: berry-group)
                        (up-modify-group-flag 0 c: berry-group)
                        (up-create-group 0 0 c: berry-group)
                        (up-modify-group-flag 1 c: berry-group)
                        (up-full-reset-search)
                        (set-goal gl-split-rule 621)
                        (disable-self)
                    )

                    (defrule
                        (goal gl-split-rule 621)
                        =>
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != second-tree-group)
                        (up-add-object-by-id search-local g: gl-temp)
                        (up-reset-group c: second-tree-group)
                        (up-modify-group-flag 0 c: second-tree-group)
                        (up-create-group 0 0 c: second-tree-group)
                        (up-modify-group-flag 1 c: second-tree-group)
                        (up-full-reset-search)
                        ;(chat-to-all "berries are empty. Converting 1 vill to second tree group")
                        (disable-self)
                    )
                        

                    (defrule ;get one vill from berry group into second tree group
                        (goal gl-no-more-berries 1)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-data object-data-id gl-temp)
                        (up-remove-objects search-local object-data-index == 0)
                        (up-reset-group c: berry-group)
                        (up-modify-group-flag 0 c: berry-group)
