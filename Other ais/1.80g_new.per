                    (current-age == feudal-age)
                    (building-type-count-total archery-range > 0)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != shepard-group)
                    (up-remove-objects search-local object-data-type == 212) ;dont convert builders
                    (up-remove-objects search-local object-data-type == 118)
