                    =>
                    (up-full-reset-search)
                )

                (defrule
                    (not(research-completed ri-loom))
                    (or(goal BOAR-STATUS Planning-Boar-Attack)
                    (goal BOAR-STATUS Send-vill-to-tc))
                    (or(goal gl-african-boars YES)
                    (or(up-compare-goal gl-boar-point-relation-to-tc == upper-right-quadrant)
