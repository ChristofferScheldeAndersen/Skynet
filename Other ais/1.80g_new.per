        (defrule
            (or(taunt-detected any-ally 201)
            (or(taunt-detected any-enemy 201)
            (taunt-detected my-player-number 201)))
            =>
            (chat-to-all "Taunt 201 detected - Cheats enabled. Use taunt 202 to turn off cheating.")
            (set-goal gl-cheating YES)
            (acknowledge-taunt every-ally 201)
            (acknowledge-taunt every-enemy 201)
            (acknowledge-taunt my-player-number 201)
        )

        (defrule
            (or(taunt-detected any-ally 202)
            (or(taunt-detected any-enemy 202)
            (taunt-detected my-player-number 202)))
            =>
            (chat-to-all "Taunt 202 detected - Cheats turned off")
            (set-goal gl-cheating -1)
            (acknowledge-taunt every-ally 202)
            (acknowledge-taunt every-enemy 202)
            (acknowledge-taunt my-player-number 202)
        )

        (defrule
            (goal gl-cheating YES)
            (up-timer-status difficulty-timer == timer-disabled)
            =>
            (set-goal gl-difficulty 1)
            (enable-timer difficulty-timer 0)
        )


        (defrule
            (goal gl-cheating YES)
            =>
            (up-get-fact unit-type-count villager-food gl-number-of-food-villagers)
            (up-get-fact unit-type-count villager-wood gl-number-of-wood-villagers)
            (up-get-fact unit-type-count villager-gold gl-number-of-gold-villagers)
            (up-get-fact unit-type-count villager-stone gl-number-of-stone-villagers)
        )

        (defrule
        (goal gl-cheating YES)
            (game-time > 900)
            =>
            (up-modify-goal gl-number-of-food-villagers c:* 3)
            (up-modify-goal gl-number-of-food-villagers c:/ 5)
        )


        (defrule
            (timer-triggered difficulty-timer)
            (goal gl-cheating YES)
            (up-research-status c: feudal-age != research-pending)
            ;(up-research-status c: castle-age != research-pending)
            ;(up-research-status c: imperial-age != research-pending)
            (not(and(current-age == feudal-age)
            (building-type-count archery-range < 2)))
            (not(and(current-age == dark-age)
            (unit-type-count villager >= 15)))
            =>
            (set-goal gl-split-rule 19)
        )
        
        (defrule
        (goal gl-split-rule 19)
        =>
        (set-goal gl-split-rule 0)
            (up-cc-add-resource c: food g: gl-number-of-food-villagers)
            (up-cc-add-resource c: wood g: gl-number-of-wood-villagers)
            (up-cc-add-resource c: gold g: gl-number-of-gold-villagers)
            (up-cc-add-resource c: stone g: gl-number-of-stone-villagers)
            (disable-timer difficulty-timer)
            (enable-timer difficulty-timer 15)
        )

