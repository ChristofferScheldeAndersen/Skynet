                    )

                    (defrule
                        (or(and(up-compare-goal gl-my-position != 4)
                            (up-compare-goal gl-local-total >= 150))
                            (and(up-compare-goal gl-my-position == 4)
                            (up-compare-goal gl-local-total >= 300)))
                        =>
                        (set-goal gl-knight-group-superiority-mode 1) 
                    )

                    (defrule
                        ;(up-compare-goal gl-my-position != 4)
                        (goal gl-melee-army-mode 0)
                        (up-compare-goal gl-knight-group-superiority-mode == 1) 
                        ;knight group is stronger than enemy army (new superiority system)
                        (not(up-timer-status under-attack-timer == timer-running))
                        =>
                        (set-goal gl-melee-army-mode snipe-vills)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp30 -1)
                        (set-goal gl-temp31 -1)
                        (set-goal gl-temp32 -1)
                        (set-goal gl-temp33 -1)
                        (set-goal gl-temp34 -1)
                        (set-goal gl-temp35 -1)
                        (set-goal gl-temp36 -1)
                        (set-goal gl-temp37 -1)
                        (set-goal gl-temp38 -1)
                        (set-goal gl-temp39 -1)
                    )





                    (defrule ;knights er ca. 10
                        (true)
                        =>
                        (up-get-player-fact target-player military-population 0 gl-temp1) ;base unit (archer) er 2
                        (up-get-player-fact target-player unit-type-count knight-line gl-temp) ;knights er 4
                        (up-modify-goal gl-temp1 g:+ gl-temp)
                        (up-get-player-fact target-player unit-type-count camel-line gl-temp) ;camels er 5,3
                        (up-modify-goal gl-temp c:* 4)
                        (up-modify-goal gl-temp c:/ 3)
                        (up-modify-goal gl-temp1 g:+ gl-temp)
                        (up-get-player-fact target-player unit-type-count spearman-line gl-temp) ;spears er 3
                        (up-modify-goal gl-temp c:/ 2)
                        (up-modify-goal gl-temp1 g:+ gl-temp)
                        (up-get-player-fact target-player unit-type-count skirmisher-line gl-temp) ;skirms er 0,6
                        (up-modify-goal gl-temp c:* 2)
                        (up-modify-goal gl-temp c:/ 3)
                        (up-modify-goal gl-temp1 g:- gl-temp)
                        (up-modify-goal gl-temp1 c:* 2) ;we asume enemy has fletching making archers count for 2
                    )

                    (defrule
                        (players-current-age target-player >= castle-age) ;multiply enemy army strength by 2,66
                        =>
                        (up-modify-goal gl-temp1 c:* 8)
                        (up-modify-goal gl-temp1 c:/ 3)
                    )

                    (defrule
                        (true) ;own army strength mush be 10 times higher (1,5 before)
                        =>
                        (up-modify-goal gl-temp1 c:* 20)
                        (up-modify-goal gl-temp1 c:/ 2)
                    )

                    (defrule
                        (true)
                        =>
                        (set-strategic-number sn-focus-player-number my-player-number)
                    )

                    (defrule
                        (up-compare-goal gl-my-position == 3)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                    )


                    (defrule
                        (up-compare-goal gl-my-position == 4)
                        (or(up-compare-goal gl-ranged-group-strength < 5)
                        (or(and(up-compare-goal gl-ranged-group-strength < 50)
                        (players-current-age focus-player >= castle-age))
                        (up-allied-goal focus-player gl-ranged-group-safety == safe)))
                        (up-compare-goal gl-melee-group-strength g:> gl-temp1)
                        (up-compare-goal gl-melee-group-strength >= 50)
                        =>
                        ;(set-goal gl-melee-army-mode raid-enemy)
                        (do-nothing)
                    )

                    (defrule
                        (up-compare-goal gl-my-position != 4)
                        (up-compare-goal gl-melee-group-strength g:> gl-temp1)
                        (up-compare-goal gl-melee-group-strength >= 50)
                        =>
                        ;(set-goal gl-melee-army-mode raid-enemy)
                        (do-nothing)
                    )

                    (defrule
                        (true)
                        =>
                        (up-get-focus-fact allied-goal gl-ranged-group-safety gl-temp)
                    )

                    (defrule
                        (taunt-detected my-player-number 121)
                        =>
                        (set-goal gl-melee-army-mode follow-ranged-army)
                    )

                    (defrule
                        (taunt-detected my-player-number 122)
                        =>
                        (set-goal gl-melee-army-mode snipe-vills)
                    )

                    (defrule
                        (taunt-detected my-player-number 123)
                        =>
                        (set-goal gl-melee-army-mode raid-enemy)
                    )

                    (defrule
                        (or(taunt-detected my-player-number 88)
                        (taunt-detected any-ally 88))
