                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;1-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;7                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;ID måske ændret        gl-first-suitable-tree
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                ; 1y Når træet er gemt spørges der om der er flere træer tilbage i remote list. Hvis der er genstartes det lille
                    ;loop. (burde maks kunne køre 40 gange)

                    (defrule
                        (goal gl-build-lc YES) ; bør kun køre efter 9 vills hvis der endnu ikke er fundet en lumber camp
                        =>
                        ;(up-remove-objects search-remote object-data-index == 0)
                        ;(up-get-search-state gl-local-total) 
                        ;;;(up-chat-data-to-all "gl-remote-total at the end of small loop is %d." g: gl-remote-total)
                        (do-nothing)
                    )

                    (defrule ;testrule
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-new-danger-counter c:+ 1)
                    )

                    (defrule
                        (up-compare-goal gl-remote-total > 0)
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-new-danger-counter < 40)
                        (or(up-compare-goal gl-surrounding-trees == 6)
                        (and(up-compare-goal gl-suitable-trees-found < 10)
                        (up-compare-goal gl-surrounding-trees == 5)))
                        =>
                        (up-modify-goal gl-surrounding-trees c:= 0)
                        (up-modify-goal gl-checked-trees c:= 1) ; !!!!!
                        ;;(chat-to-all "resetting small loop")
                        (up-jump-rule -33)
                        ;(disable-self)
                    )

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;1-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0 derfor her nu*evt    gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;7                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;ID måske ændret        gl-first-suitable-tree
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                
                ; 1z Når det lille loop har kørt alle træer igennem genstartes det store loop. Dette kræver:
                ;
                    ;1: at der ikke er fundet de træer der skal (5)
                    ;2: at maximum søgerækkevidde er under 30
                    ;Når det store loop genstartes øges maximum og minimum søge rækkevidde der bruges i træsøgningen i starten
                    ;af det store loop med 1 hver.

                    (defrule
                        (up-compare-goal gl-suitable-trees-found < 20)
                        (up-compare-goal gl-maximum-tree-distance < 50)
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-minimum-tree-distance c:+ 1)
                        (up-modify-goal gl-maximum-tree-distance c:+ 1)
                        (up-modify-goal gl-checked-trees c:= 0)
                        ;;(chat-to-all "resetting big loop")
                        (up-jump-rule -43)
                        ;(disable-self)
                    )

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;1-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;7                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;5                      gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;ID ændret              gl-first-suitable-tree
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                    ;For god ordens skyld gemmer jeg ID på de fundne træer, renser remote list og indsætter dem i rækkefølge efter ID

                    (defrule
                        (up-compare-goal gl-suitable-trees-found > 0)
                        (goal gl-build-lc YES)
                        =>
                        (up-full-reset-search)
                        ;(up-add-object-by-id search-remote g: gl-first-suitable-tree)
                        ;(up-add-object-by-id search-remote g: gl-second-suitable-tree)
                        ;(up-add-object-by-id search-remote g: gl-third-suitable-tree)
                        ;(up-add-object-by-id search-remote g: gl-forth-suitable-tree)
                        ;(up-add-object-by-id search-remote g: gl-fifth-suitable-tree)
                        ;(up-clean-search search-remote object-data-id search-order-asc)
                        ;;;(up-chat-data-to-all "ID of first tree is %d." g: gl-first-suitable-tree)
                        ;;;(up-chat-data-to-all "ID of second tree is %d." g: gl-second-suitable-tree)
                        ;;;(up-chat-data-to-all "ID of third tree is %d." g: gl-third-suitable-tree)
                        ;;;(up-chat-data-to-all "ID of forth tree is %d." g: gl-forth-suitable-tree)
                        ;;;(up-chat-data-to-all "ID of fifth tree is %d." g: gl-fifth-suitable-tree)
                        ;(up-set-target-by-id g: gl-first-suitable-tree)
                        ;(up-get-point position-object gl-chosen-tree-point-x)
                        ;(disable-self)
                    )


        
            
                    
                    
            ; B NEW* FIND DET BEDSTE AF DE 10 TRÆER og byg lumber-camp

                ; 2a+b Det store loop startes med 5 regler der sætter det træ som skal undersøges i loopet. Reglerne styres af
                    ;en counter der øges med en hver gang et nyt træ er valgt. Igen er første regel nederst osv. Når et nyt træ
                    ;vælges findes koordinaterne på træet og sættes som det mål der bruges i det lille loop.

                    (defrule
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-checked-trees c:= 0)
                        (up-modify-goal gl-new-danger-counter c:= 0)
                        (up-modify-goal gl-best-found-lc-score c:= -100)
                        ;(disable-self)
                    )
                    
                    ;;; start of big loop ;;;

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 0)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-first-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 1)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-second-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 2)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-third-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 3)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-forth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 4)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-fifth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 5)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-sixth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 6)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-seventh-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 7)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-nineth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 8)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-eighth-suitable-tree)
                    )
                
                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 9)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-tenth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 10)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-eleventh-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 11)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-twelfth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 12)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-thirteenth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 13)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-forteenth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 14)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-fifteenth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 15)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-sixteenth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 16)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-seventeenth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 17)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-eighteenth-suitable-tree)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 18)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-nineteenth-suitable-tree)
                    )
                
                    (defrule
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees == 19)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-twentyth-suitable-tree)
                    )

                    ; 2 Building DUC lumbercamps
                    
                ; 2a reset points and counters before loop starts (del af rule er i 2b)
                        (defrule
                            ;(up-compare-goal gl-chosen-tree-point-x != -1)
                            ;(up-compare-goal gl-lumber-camp-location-x == -1)
                            (goal gl-build-lc YES)
                            =>
                            (up-set-target-object search-remote c: 0)
                            (up-get-point position-object gl-chosen-tree-point-x)
                            (up-copy-point gl-point-x gl-chosen-tree-point-x)
                            (up-copy-point gl-lumber-camp-testing-spot-x gl-chosen-tree-point-x)
                            ;(set-strategic-number sn-target-point-adjustment 0)
                            (set-goal gl-perpendicular-testing-counter 0)
                            (set-goal gl-parallel-testing-counter -1)
                            (set-goal gl-danger-counter 0)
                                ;(disable-self)
                        )

                ; 2b Check the lokation of the tree in relation to our tc. (done in prior section)


                        ;******************************************************************************
                        ;
                        ; Find lokation of gl-point-x in relation to starting tc
                        ;
                        ;******************************************************************************



                        (defrule ;starting lokation program
                            (up-compare-goal gl-point-x != -1)
                            =>
                            (up-modify-goal gl-point-numeric-x c:= 0)
                        (up-modify-goal gl-point-numeric-y c:= 0)
                        (up-get-point position-self gl-position-self-x)
                        ;(up-modify-goal gl-position-self-x c:+ 5)  ; bedre til boars
                        ;(up-modify-goal gl-position-self-y c:- 5)  ; bedre til boars
                        )

                        (defrule
                            (up-compare-goal gl-point-x != -1) 
                            =>
                            (up-modify-goal gl-point-numeric-x g:+ gl-position-self-x)
                            (up-modify-goal gl-point-numeric-x g:- gl-point-x)
                            ;(disable-self)
                        )

                        (defrule
                            (up-compare-goal gl-point-numeric-x < 0)
                            (up-compare-goal gl-point-x != -1)
                            =>
                            (up-modify-goal gl-point-numeric-x g:neg gl-point-numeric-x)
                            ;(disable-self)
                        )


                        (defrule
                            (up-compare-goal gl-point-y != -1)
                            =>
                            (up-modify-goal gl-point-numeric-y g:+ gl-position-self-y)
                            (up-modify-goal gl-point-numeric-y g:- gl-point-y)
                            ;(disable-self)
                        )

                        (defrule
                            (up-compare-goal gl-point-numeric-y < 0)
                            (up-compare-goal gl-point-y != -1)
                            =>
                            (up-modify-goal gl-point-numeric-y g:neg gl-point-numeric-y)
                            ;(disable-self)
                        )




                        (defrule
                            (up-compare-goal gl-point-y g:< gl-position-self-y)
                            (up-compare-goal gl-point-numeric-y g:>= gl-point-numeric-x)
                            (up-compare-goal gl-point-x != -1)
                            =>
                            (set-goal gl-point-relation-to-tc upper-left-quadrant)
                            ;;(chat-to-all "point is in upper left quadrant")
                            ;(disable-self)
                        )

                        (defrule
                            (up-compare-goal gl-point-y g:>= gl-position-self-y)
                            (up-compare-goal gl-point-numeric-y g:>= gl-point-numeric-x)
                            (up-compare-goal gl-point-x != -1)
                            =>
                            (set-goal gl-point-relation-to-tc lower-right-quadrant)
                            ;;(chat-to-all "point is in lower right quadrant")
                            ;(disable-self)
                        )

                        (defrule
                            (up-compare-goal gl-point-x g:>= gl-position-self-x)
                            (up-compare-goal gl-point-numeric-x g:>= gl-point-numeric-y)
                            (up-compare-goal gl-point-x != -1)
                            =>
                            (set-goal gl-point-relation-to-tc upper-right-quadrant)
                            ;;(chat-to-all "point is in upper right quadrant")
                            ;(disable-self)
                        )

                        (defrule
                            (up-compare-goal gl-point-x g:< gl-position-self-x)
                            (up-compare-goal gl-point-numeric-x g:>= gl-point-numeric-y)
                            (up-compare-goal gl-point-x != -1)
                            =>
                            (set-goal gl-point-relation-to-tc lower-left-quadrant)
                            ;;(chat-to-all "point is in lower left quadrant")
                            ;(disable-self)
                        )
                    
                        (defrule ;needs to be reset in the main script
                        (up-compare-goal gl-point-relation-to-tc != -1)
                        (up-compare-goal gl-point-x != -1)
                        (up-compare-goal gl-chosen-tree-point-x != -1)
                            =>
                        (up-modify-goal gl-tree-point-relation-to-tc g:= gl-point-relation-to-tc)
                        ;(disable-self)
                        )

                        (defrule ;needs to be reset in the main script
                        (up-compare-goal gl-point-relation-to-tc != -1)
                        (up-compare-goal gl-point-x != -1)
                        =>
                        (set-goal gl-point-x -1)
                        ;(disable-self) ; ellers larmer den
                        )


                    ;;; start of small loop ;;;

                    ;del af 2a flyttet ned

                    ; the top part of the code would change the point gradually along a rectangular shape starting at the middle on one 
                    ; end and chosing 5 points starting with the middle point, then the two closer and then the two furthest. 

                    (defrule ;reset testing spot
                        (up-compare-goal gl-chosen-tree-point-x != -1)
                        (up-compare-goal gl-lumber-camp-location-x == -1)
                            =>
                        (up-copy-point gl-lumber-camp-testing-spot-x gl-chosen-tree-point-x)
                        )

                ; 2c move the first testing point 1 tile away from the tc in case of uneven forrest egde. (turned off
                ; due to lc's being build on the wrong side of forrest)


                    (defrule ;move down/left       ; extra 4 regler. Ideen er at starte længere bagud hvis man rammer et hjørne
                    (up-compare-goal gl-parallel-testing-counter < 0)
                    (up-compare-goal gl-tree-point-relation-to-tc == upper-right-quadrant)
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-x c:+ 0) ; ændret fra 1 som test.
                    )

                    (defrule ;move up/left
                    (up-compare-goal gl-parallel-testing-counter < 0)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-right-quadrant)
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-y c:+ 0)
                    )

                    (defrule ;move up/right
                    (up-compare-goal gl-parallel-testing-counter < 0)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-left-quadrant)
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-x c:- 0)
                    )

                    (defrule ;move down/right
                    (up-compare-goal gl-parallel-testing-counter < 0)
                    (up-compare-goal gl-tree-point-relation-to-tc == upper-left-quadrant)
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-y c:- 0)
                    )

                ; 2d move the point between 5 points on a line perpendicular to line between tc and chosen tree

                    (defrule ;move up/right
                    (up-compare-goal gl-perpendicular-testing-counter == 1)
                    (or(up-compare-goal gl-tree-point-relation-to-tc == upper-left-quadrant)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-right-quadrant))
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-x c:+ 1)
                    )

                    (defrule ;move down/left
                    (up-compare-goal gl-perpendicular-testing-counter == 2)
                    (or(up-compare-goal gl-tree-point-relation-to-tc == upper-left-quadrant)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-right-quadrant))
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-x c:- 1)
                    )

                    (defrule ;move up/right
                    (up-compare-goal gl-perpendicular-testing-counter == 3)
                    (or(up-compare-goal gl-tree-point-relation-to-tc == upper-left-quadrant)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-right-quadrant))
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-x c:+ 2)
                    )

                    (defrule ;move down/left
                    (up-compare-goal gl-perpendicular-testing-counter == 4)
                    (or(up-compare-goal gl-tree-point-relation-to-tc == upper-left-quadrant)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-right-quadrant))
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-x c:- 2)
                    )



                    (defrule ;move down/right
                    (up-compare-goal gl-perpendicular-testing-counter == 1)
                    (or(up-compare-goal gl-tree-point-relation-to-tc == upper-right-quadrant)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-left-quadrant))
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-y c:+ 1)
                    )

                    (defrule ;move up/left
                    (up-compare-goal gl-perpendicular-testing-counter == 2)
                    (or(up-compare-goal gl-tree-point-relation-to-tc == upper-right-quadrant)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-left-quadrant))
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-y c:- 1)
                    )

                    (defrule ;move down/right
                    (up-compare-goal gl-perpendicular-testing-counter == 3)
                    (or(up-compare-goal gl-tree-point-relation-to-tc == upper-right-quadrant)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-left-quadrant))
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-y c:+ 2)
                    )

                    (defrule ;move up/left
                    (up-compare-goal gl-perpendicular-testing-counter == 4)
                    (or(up-compare-goal gl-tree-point-relation-to-tc == upper-right-quadrant)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-left-quadrant))
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-y c:- 2)
                    )

                ; 2e when prior 5 points have been tested move testing point 1 tile closer to tc.

                    ; Here either x or y koordinate will be changed depending on the quadrant. Each change of the point would add to a 
                    ; temp counter resetting at 4 (starting at 0). When resetting the other koordinate would be moved 1 towards the tc 
                    ; again depending on the quadrant.

                    (defrule ;move down/left
                    (up-compare-goal gl-parallel-testing-counter > 0)
                    (up-compare-goal gl-tree-point-relation-to-tc == upper-right-quadrant)
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-x g:- gl-parallel-testing-counter)
                    )

                    (defrule ;move up/left
                    (up-compare-goal gl-parallel-testing-counter > 0)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-right-quadrant)
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-y g:- gl-parallel-testing-counter)
                    )

                    (defrule ;move up/right
                    (up-compare-goal gl-parallel-testing-counter > 0)
                    (up-compare-goal gl-tree-point-relation-to-tc == lower-left-quadrant)
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-x g:+ gl-parallel-testing-counter)
                    )

                    (defrule ;move down/right
                    (up-compare-goal gl-parallel-testing-counter > 0)
                    (up-compare-goal gl-tree-point-relation-to-tc == upper-left-quadrant)
                        =>
                    (up-modify-goal gl-lumber-camp-testing-spot-y g:+ gl-parallel-testing-counter)
                    )

                    ; move the testing point between the 4 tiles where the lumber camp would be placed
                    ; Downstream from the upper code would be a loop checking 4 squares for being empty and thereby candidates for putting down a lumbercamp.


                    (defrule
                        (true)
                        =>
                        (up-modify-goal gl-tiles-checker c:= 1)
                        (up-modify-goal gl-trees-in-the-way c:= 0)
                    )


                    (defrule
                        (up-compare-goal gl-tiles-checker == 2)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-x c:- 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 3)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-y c:- 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 4)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-x c:+ 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 5)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-y c:+ 2)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 6)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-x c:- 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 7)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-x c:- 1)
                        (up-modify-goal gl-lumber-camp-testing-spot-y c:- 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 8)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-y c:- 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 9)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-x c:+ 1)
                        (up-modify-goal gl-lumber-camp-testing-spot-y c:- 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 10)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-x c:+ 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 11)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-x c:+ 1)
                        (up-modify-goal gl-lumber-camp-testing-spot-y c:+ 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 12)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-y c:+ 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 13)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-y c:+ 1)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 14)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-x c:- 3)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 15)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-y c:- 3)
                    )

                    (defrule
                        (up-compare-goal gl-tiles-checker == 16)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-x c:+ 3)
                    )


                ; 2f each point for trees

                    (defrule
                        
                    (or(up-compare-goal gl-tiles-checker <= 4)
                        (and(up-compare-goal gl-tiles-checker <= 16)
                        (or(up-point-contains gl-lumber-camp-testing-spot-x c: 66)
                        (up-point-contains gl-lumber-camp-testing-spot-x c: 908))))
                        (up-compare-goal gl-tiles-checker >= 1)
                        =>
                        (set-goal gl-split-rule 39)
                    )

                    (defrule
                    (goal gl-split-rule 39)
                        (or(up-point-contains gl-lumber-camp-testing-spot-x c: 915) ; tree-class = 915
                    (or(up-point-contains gl-lumber-camp-testing-spot-x c: 66)
                    (or(not(and(up-can-build-line 0 gl-lumber-camp-testing-spot-x c: palisade-wall) 
                    (can-afford-building palisade-wall))) ;building
                    (or(up-point-contains gl-lumber-camp-testing-spot-x c: 908)
                    (or(up-point-contains gl-lumber-camp-testing-spot-x c: 903)
                    (up-point-contains gl-lumber-camp-testing-spot-x c: 907))))))
                        =>
                        (set-goal gl-split-rule 40)
                        
                    )

                    (defrule
                        (or(and(up-compare-goal gl-tiles-checker == 1)
                                        (not(and(up-can-build-line 0 gl-lumber-camp-testing-spot-x c: lumber-camp) 
                                        (can-afford-building lumber-camp))))
                    (goal gl-split-rule 40))
                    
                        =>
                        (up-modify-goal gl-trees-in-the-way c:+ 1)
                        (set-goal gl-split-rule 0)
                        ;;;(up-chat-data-to-all "Tile checker is %d." g: gl-tiles-checker)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-split-rule 0)
                    )
                        

                ; 2g reset to the original tile after checking 4 lumbercamp tiles

                    (defrule        ; reset to staring point
                        (up-compare-goal gl-tiles-checker == 16)
                        =>
                        (up-modify-goal gl-lumber-camp-testing-spot-y c:+ 2)
                        (up-modify-goal gl-lumber-camp-testing-spot-x c:- 1)
                        )

                ; 2h reset loop checking the 4 lumbercamp tiles of the testing tile

                    (defrule
                    (goal gl-build-lc YES)
                        (up-compare-goal gl-tiles-checker < 16)
                        (up-compare-goal gl-tiles-checker != -1)
                        =>
                        (up-modify-goal gl-tiles-checker c:+ 1)
                        (up-jump-rule -21)
                    )

                ; 2i add to the counters controlling changing of original testing tile

                    (defrule
                        (up-compare-goal gl-chosen-tree-point-x != -1)
                        (up-compare-goal gl-lumber-camp-location-x == -1)
                        (up-compare-goal gl-perpendicular-testing-counter < 16) ; evt 4
                        =>
                        (up-modify-goal gl-perpendicular-testing-counter c:+ 1)
                    )

                    (defrule
                        (up-compare-goal gl-chosen-tree-point-x != -1)
                        (up-compare-goal gl-lumber-camp-location-x == -1)
                        (up-compare-goal gl-perpendicular-testing-counter == 16) ; evt 4
                        =>
                        (up-modify-goal gl-perpendicular-testing-counter c:== 0)
                        (up-modify-goal gl-parallel-testing-counter c:+ 1)
                    )

                ; 2j reset entire loop checking for wether lumber camp can be placed. (not working, just doing one tjeck per ai run)

                
                    (defrule
                    (goal gl-build-lc YES)
                        (up-compare-goal gl-trees-in-the-way > 0)
                        (up-compare-goal gl-danger-counter < 200)     ; det virker tilsyneladende så længe det ikke er et loop.
                        =>
                        (up-modify-goal gl-danger-counter c:+ 1)
                        (up-jump-rule -42)
                    )

                ; 2k tjeck and maybe replace lc-score
                    
                    #load-if-not-defined ARENA-MAP
                    (defrule
                    (goal gl-build-lc YES)
                    =>
                    (up-full-reset-search)
                    (up-copy-point gl-temp6-x gl-lumber-camp-testing-spot-x)
                    (up-set-target-point gl-temp6-x)
                    (up-filter-distance c: -1 c: 8)
                    (set-goal gl-temp48 0)
                    (set-goal gl-temp49 0)
                    (set-goal gl-temp6-x 0)
                    (set-goal gl-temp6-y 0)
                    (set-goal gl-remote-total 0)
                    (up-filter-status c: status-ready c: list-active)
                    (up-find-resource c: wood c: 200)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: wood c: 200)
                    )

                    (defrule
                    (goal gl-build-lc YES)
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-get-object-data object-data-precise-x gl-temp7-x) ;coordinate * 100
                    (up-get-object-data object-data-precise-y gl-temp7-y)
                    (up-modify-goal gl-temp6-x g:+ gl-temp7-x)
                    (up-modify-goal gl-temp6-y g:+ gl-temp7-y)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp48 c:+ 1) ;number of points checked
                    )

                    (defrule
                    (goal gl-build-lc YES)
                    (up-compare-goal gl-remote-total > 0)
                    =>
                    (up-remove-objects search-remote object-data-index == 0)
                    (up-get-search-state gl-local-total)
                    (up-jump-rule -2)
                    )

                    (defrule
                    (goal gl-build-lc YES)
                    (up-compare-goal gl-temp48 > 0)
                    =>
                    ;(up-chat-data-to-all "gl-temp6-x is %d" g: gl-temp6-x)
                    ;(up-chat-data-to-all "gl-temp6-y is %d" g: gl-temp6-y)
                    ;(up-chat-data-to-all "gl-temp1 is %d" g: gl-temp1)
                    (up-modify-goal gl-temp6-x g:/ gl-temp48) ; finder gennemsnitskoordinaten
                    (up-modify-goal gl-temp6-y g:/ gl-temp48)
                    (up-modify-goal gl-temp6-x c:/ 100)
                    (up-modify-goal gl-temp6-y c:/ 100)
                    (up-get-point position-self gl-temp-x)
                    (up-get-point-distance gl-lumber-camp-testing-spot-x gl-temp-x gl-temp49) ;testing point distance
                    ;(up-chat-data-to-all "gl-temp49 is %d" g: gl-temp49)
                    (up-get-point-distance gl-temp6-x gl-temp-x gl-temp50) ;forrest distance
                    ;(up-chat-data-to-all "gl-temp50 is %d" g: gl-temp50)
                    (up-modify-goal gl-temp49 g:- gl-temp50) ;extra distance to testing point from tc compared to forrest
                    ;(chat-to-all "rule running")
                    )

                    ;Herefter kører det lille loop som normalt indtil før reglen hvor det endelige punkt vælges. Her indsættes
                    ;i stedet et tjeck af punktets lc-score og hvis det er større end den tidligere score indsættes den nye score
                    ;i målets score og punktet gemmes i et mål der bliver det endelige når det store loop slutter. Endvidere
                    ;øges en counter der siger hvor mange træer der er tjekket.

                    (defrule
                        (goal gl-build-lc YES); checks distance
                            =>
                            (up-full-reset-search)
                            (up-get-point position-self gl-position-self-x)
                            (up-get-point position-flank gl-center-x)
                            (up-lerp-tiles gl-position-self-x gl-center-x c: -3)
                            (up-set-target-point gl-position-self-x)
                            (up-get-point-distance gl-position-self-x gl-lumber-camp-testing-spot-x gl-lumber-camp-distance)
                        )

                    (defrule ;tilføj ekstra træer der kun tæller under halvt
                        (goal gl-build-lc YES)
                        =>
                        (set-strategic-number sn-target-point-adjustment 1)
                                (up-full-reset-search)
                                (up-set-target-point gl-lumber-camp-testing-spot-x)
                                (up-filter-distance c: 5 c: 7)
                                (up-filter-status c: status-ready c: list-active)
                                (up-find-resource c: wood c: 200)
                                (up-get-search-state gl-local-total)
                                (up-modify-goal gl-temp31 g:= gl-remote-total)
                                (up-modify-goal gl-temp31 c:* 2)
                                (up-modify-goal gl-temp31 c:/ 7)
                                (set-strategic-number sn-target-point-adjustment 5)
                    )
                    
                    

                    (defrule   
                            (goal gl-build-lc YES) ; checks surrounding trees
                                =>
                                (set-strategic-number sn-target-point-adjustment 1)
                                (up-full-reset-search)
                                (up-set-target-point gl-lumber-camp-testing-spot-x)
                                (up-filter-distance c: -1 c: 5)
                                (up-filter-status c: status-ready c: list-active)
                                (up-find-resource c: wood c: 200)
                                (up-get-search-state gl-local-total)
                                (set-strategic-number sn-target-point-adjustment 5)
                                ;(up-chat-data-to-all "gl-checked-trees is %d." g: gl-checked-trees)
                                ;(up-chat-data-to-all "gl-lumber-camp-location-x is %d." g: gl-lumber-camp-location-x)
                            )

                    

                    (defrule
                        (goal gl-build-lc YES) ; calculate score
                        (up-compare-goal gl-checked-trees < 20)
                        (up-compare-goal gl-lumber-camp-location-x == -1)
                        (up-compare-goal gl-remote-total < 20)
                        =>
                        ;(up-chat-data-to-all "lumber-camp distance to point behind tc is %d." g: gl-lumber-camp-distance)
                        ;(up-chat-data-to-all "number of trees around lumber camp is %d." g: gl-remote-total)
                        ;(up-modify-goal gl-temp50 g:= gl-remote-total)
                        (up-modify-goal gl-remote-total c:- 30)
                        
                        ;(disable-self)
                    )

                    (defrule
                        (goal gl-build-lc YES) ; calculate score
                        (up-compare-goal gl-checked-trees < 20)
                        (up-compare-goal gl-lumber-camp-location-x == -1)
                        (up-compare-goal gl-remote-total > 35)
                        =>
                        ;(up-chat-data-to-all "lumber-camp distance to point behind tc is %d." g: gl-lumber-camp-distance)
                        ;(up-chat-data-to-all "number of trees around lumber camp is %d." g: gl-remote-total)
                        ;(up-modify-goal gl-temp50 g:= gl-remote-total)
                        (up-modify-goal gl-remote-total c:+ 15)
                        
                        ;(disable-self)
                    )

                    (defrule
                        (goal gl-build-lc YES) ; calculate score
                        (up-compare-goal gl-checked-trees < 20)
                        (up-compare-goal gl-lumber-camp-location-x == -1)
                        =>
                        ;(up-chat-data-to-all "lumber-camp distance to point behind tc is %d." g: gl-lumber-camp-distance)
                        ;(up-chat-data-to-all "number of trees around lumber camp is %d." g: gl-remote-total)
                        ;(up-modify-goal gl-temp50 g:= gl-remote-total)
                        (up-modify-goal gl-remote-total g:- gl-lumber-camp-distance)
                        (up-modify-goal gl-lumber-camp-distance c:* 40) ; tidl 50
                        (up-modify-goal gl-lumber-camp-distance c:/ 30)
                        (up-modify-goal gl-remote-total g:- gl-lumber-camp-distance)
                        (up-modify-goal gl-remote-total g:+ gl-temp31)
                        ;(up-chat-data-to-all "lumber camp score is %d." g: gl-remote-total)
                        (up-modify-goal gl-checked-trees c:+ 1)
                        ;(disable-self)
                    )

                    (defrule ;gå 2/3 op i afstand til tc hvis man er pocket
                        (goal gl-strategy fc-two-tc-one-stable-knights)
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-lumber-camp-distance c:* 2)
                        (up-modify-goal gl-lumber-camp-distance c:/ 3)
                        (up-modify-goal gl-remote-total g:+ gl-lumber-camp-distance)
                    )

                    (defrule ;fail safe der sikrer lc ikke kan bygges for tæt på tidl lc.
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-first-lumber-camp-location-x != -1)
                        (up-point-distance gl-first-lumber-camp-location-x gl-lumber-camp-testing-spot-x < 6)
                        =>
                        (up-modify-goal gl-remote-total c:= -99)
                    )

                    (defrule
                        (goal gl-build-lc YES)
                        =>
                        (up-get-point position-map-size gl-temp46)
                        (up-modify-goal gl-temp46 g:- gl-lumber-camp-testing-spot-x)
                        (up-modify-goal gl-temp47 g:- gl-lumber-camp-testing-spot-y)
                    )

                    (defrule
                        (or(up-compare-goal gl-lumber-camp-testing-spot-x < 5)
                        (or(up-compare-goal gl-lumber-camp-testing-spot-y < 5)
                        (or(up-compare-goal gl-temp46 < 5)
                        (up-compare-goal gl-temp47 < 5))))
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-remote-total c:= -449)
                    )
                    
                    

                    (defrule
                    (goal gl-build-lc YES)
                    (up-compare-goal gl-temp49 > 1)
                    (up-compare-goal gl-remote-total > -100)
                    =>
                    ;(up-chat-data-to-all "lumber camp is %d tiles further from tc than forrest" g: gl-temp49)
                    ;(up-chat-data-to-all "gl-remote-total before is %d" g: gl-remote-total)
                    (up-modify-goal gl-remote-total c:= -99)
                    ;(up-chat-data-to-all "gl-remote-total after is %d" g: gl-remote-total)
                    )

                    
                    
                    (defrule
                    (goal gl-build-lc YES)
                    (up-compare-goal gl-remote-total g:> gl-best-found-lc-score)
                    (up-compare-goal gl-new-danger-counter < 20)
                        =>
                    ;(up-chat-data-to-all "lumber camp score is %d." g: gl-remote-total)
                    ;(up-chat-data-to-all "lumber-camp distance to point behind tc is %d." g: gl-lumber-camp-distance)
                    ;(up-chat-data-to-all "number of extra trees around lumber camp is %d." g: gl-temp31)
                    ;(up-chat-data-to-all "number of trees close trees around lumber camp is %d." g: gl-temp50)
                    (up-modify-goal gl-best-found-lc-score g:= gl-remote-total)
                    (up-copy-point gl-best-lumber-camp-spot-x gl-lumber-camp-testing-spot-x)
                    )
                    #end-if
                
                ; 2k tjeck and maybe replace lc-score
                    
                    #load-if-defined ARENA-MAP
                    (defrule
