                    )

                    ;gl-temp33 is skirm
                    ;gl-temp35 is scorpion
                    ;gl-temp36 is mangonell
                ;Find group size
                    (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: all-units-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != archer-group)
                    (up-get-search-state gl-local-total)
                    )

                ;Ajust for 1v2 and 1v3 games for more agression

                    #load-if-defined UP-3-PLAYER-GAME
