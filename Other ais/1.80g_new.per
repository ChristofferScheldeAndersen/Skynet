        ; Train units
            ; Train civillian units
                ;setup
                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp -1)
                    )
                    
                    (defrule ; train knights early castle age if you have the gold
                        (gold-amount >= 75)
                        (food-amount < 110)
                        (up-pending-objects c: knight-line < 1)
                        =>
                        ;(chat-to-all "first rule running")
                        (set-goal gl-temp 1)
                    )
                    
                    (defrule ; dont Que so many vills that imp is delayed
                        (goal gl-saving-for-upgrade saving-for-imperial-age)
                        (or(and(gold-amount > 650)
                        (and(food-amount > 750)
                        (up-pending-objects c: villager >= 2)))
                        (and(gold-amount >= 700)
                        (or(food-amount >= 650)
                        (and(food-amount >= 500)
                        (up-pending-objects c: villager >= 2)))))
                        =>
                        ;(chat-to-all "second rule running")
                        (set-goal gl-temp 1)
                    )

                    (defrule ;dont Que vills when saving for eco upgrades and you are only missing food
                        (or(and(up-compare-goal gl-saving-for-upgrade == saving-for-heavy-plow)
                        (wood-amount >= 125))
                        (and(up-compare-goal gl-saving-for-upgrade == saving-for-hand-cart)
                        (wood-amount >= 200)))
                        =>
                        ;(chat-to-all "third rule running")
                        (set-goal gl-temp 1)
                    )
                    
                    (defrule
                        (up-compare-goal gl-saving-for-upgrade == saving-for-town-watch)
                        (up-research-status c: ri-town-watch < research-pending)
                        =>
                        (set-goal gl-temp 1)
                    )

                    (defrule
                        (goal gl-agression-mode retreating)
                        (or(up-research-status c: ri-paladin >= research-pending)
                        (up-research-status c: ri-savar >= research-pending))
                        (wood-amount > 500)
                        (food-amount < 100)
                        =>
                        (set-goal gl-temp 1)
                    )

                    (defrule
                        (up-research-status c: imperial-age < research-pending)
                        (food-amount > 550)
                        (gold-amount > 450)
                        (or(gold-amount > 600)
                        (food-amount > 700))
                        (up-pending-objects c: villager >= 2)
                        =>
                        (set-goal gl-temp 1)
                    )

                ;train villagers
