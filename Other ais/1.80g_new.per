    ; Setup (safe*)
        ; Resetting old timers just after game start
            
            (defrule
                (timer-triggered scouting-enemy-base-timer)
                =>
                ;(chat-to-all "scouting timer is triggered")
                (do-nothing)
            )

            (defrule
                (game-time < 10)
                =>
                (disable-timer scouting-enemy-base-timer)
            )
            
        ; Setting starting tc goal
            (defrule
                (true)
                =>
                (up-get-point position-self gl-starting-tc-x)
            )
        ;
            (defrule
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 355 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration 1: %d" g: 181)
                )
        ; Player interaction (safe)
            ;Setting personality goal
                (defrule
                    (true)
                    =>
                    (set-goal gl-personality Rehoboam)
                )
            ;general chat
            
                (defrule
                    (game-time > 5)
                    =>
                    (chat-to-all "Good luck. Have fun!") 
                (disable-self)
                )

                (defrule
                    (game-time > 59)
                    =>
                    (chat-to-all "Want to play vs other custom AIs like Rehoboam? On aoeaidatabase.pythonanywhere.com/?src=rh you can search for AIs with certain attributes, look up their 1v1 ELO and find guides on how to install and play vs them.")
                (disable-self)
                )

                (defrule
                    (or(taunt-detected any-ally 199)
                    (or(taunt-detected any-enemy 199)
                    (taunt-detected my-player-number 199)))
                    =>
                    (chat-to-all "Prefered settings are: Arabia, conquest, dark age start, ressources low.")
                    (chat-to-all "Rehoboam needs a benchmark score of 1100 or higher for the military micro to work optimally.")
                    (chat-to-all "Rehoboam is made to play on speeds of 2,0 or lower. Higher speeds will lead to worse micro.")
                    (chat-to-all "Supported civilisations for 1v1 are: Persians (preffered) or Franks")
                    (chat-to-all "Supported civilisations for flank position in team games are: Mayans")
                    (chat-to-all "Supported civilisations for pocket position in team games are: Persians (preffered) or Franks")
                    (chat-to-all "Rehoboam needs to play on Hardest or Extreme")
                    (chat-to-all "Rehoboam is not yet made to play vs forward buildings or full walls. Using these against the ai will likely lead to bugs")
                    (disable-self)
                )

                (defrule
                    (or(taunt-detected any-ally 199)
                    (or(taunt-detected any-enemy 199)
                    (taunt-detected my-player-number 199)))
                    =>
                    (acknowledge-taunt every-ally 199)
                    (acknowledge-taunt every-enemy 199)
                    (acknowledge-taunt my-player-number 199)
                    (disable-self)
                )

            ;informing players of potential buggy settings
                
                (defrule
                (not
                (map-type arabia))
                (game-time > 35)
                (game-time < 300)
                =>
                (set-goal gl-split-rule 0)
                (chat-to-all "Wrong map detected. Rehoboam will likely bug out on non-arabia maps. (Ignore this message when playing a custom arabia map.")
                (disable-self)
                )

                (defrule
                (not
                (map-type arabia))
