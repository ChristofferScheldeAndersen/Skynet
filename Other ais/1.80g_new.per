    ; Villager retasking
            ;------------------------------
            ; Setup
            ;------------------------------

            (defrule
                (true)
                (game-time > 5) =>
                (set-strategic-number sn-food-dropsite-distance 16)
            (set-strategic-number sn-wood-dropsite-distance 9)
            (set-strategic-number sn-gold-dropsite-distance 9)
            (set-strategic-number sn-stone-dropsite-distance 9)
            (set-strategic-number sn-cap-civilian-builders 131)
            (set-strategic-number sn-percent-civilian-builders 100)
            (set-strategic-number sn-percent-civilian-gatherers 0)
                (disable-self)
            )

            ;------------------------------
            ; Get Home Position
            ;------------------------------
            ;(defconst gl-position-self 100)

            (defrule
                (true)
            (game-time > 5) =>
                (up-get-point position-self gl-non-changing-position-self-x)
                (disable-self)
            )

            ; ***************************************
            ; Force food gatherers on sheeps
            ; ***************************************

            ;(defconst male-hunter 122)
            ;(defconst female-hunter 216)

            ;(defrule
                ;(building-type-count mill < 1)
                ;(game-time < 120)
                ;(unit-type-count sheep > 0)
                ;(or 	(unit-type-count male-forager > 0)
                    ;(or	(unit-type-count female-forager > 0)
                        ;(or	(unit-type-count male-hunter > 0)
                        ;	(unit-type-count female-hunter > 0))))	
            ;(game-time > 5) =>
            ;	((up-reset-unit c: villager)
                ;(up-retask-gatherers food c: sheep)))


            ; ***************************************
            ; Force exces foragers on farms
            ; ***************************************

            (defrule
            (true)
            (game-time > 5) =>
            (enable-timer t-villager-retasking 1)
            (disable-self)
            )


            (defrule
            (unit-type-count villager-forager > 0)
            (idle-farm-count > 0)
             (timer-triggered t-villager-retasking)
            (game-time > 5) =>
            (up-reset-search 1 1 1 1)
            (up-reset-filters) 
            (up-modify-sn sn-focus-player-number c:= my-player-number)
            (up-find-local c: farm c: 40)
            (up-remove-objects search-local object-data-tasks-count > 0)
            (up-remove-objects search-local object-data-index > 0)
            (up-set-target-object search-local c: 0)
            )

            (defrule
            (unit-type-count villager-forager > 0)
            (idle-farm-count > 0)
            (timer-triggered t-villager-retasking)
            (game-time > 5) =>
            (up-get-point position-object gl-temp)
            (up-set-target-point gl-temp)
            (up-reset-search 1 1 1 1)
            (up-reset-filters)
            (up-find-local c: 120 c: 10)
            (up-find-local c: 354 c: 10)
            (up-clean-search search-local object-data-distance search-order-asc)
            (up-remove-objects search-local object-data-index > 0)
            (up-target-point 0 action-default -1 -1)
            (chat-local-to-self "Force forager to farm")
            )

            (defrule
            (timer-triggered t-villager-retasking)
            (game-time > 5) =>
            (disable-timer t-villager-retasking)
            (enable-timer t-villager-retasking 10)
            )


    ; Deer luring


            (defrule ; fors�g p� debug til tower-bug
                (true)
                (game-time > 5) =>
                (up-full-reset-search)
                (up-reset-search 1 1 1 1)
            )

            (defrule
            (game-time > 5)
            (game-time > 5) =>
                (set-goal gl-lure 1)
                (disable-self)
            )

            (defrule
                (game-time > 5)
            (game-time > 5) =>
                (up-full-reset-search)
                (up-find-local c: town-center c: 1)
                (up-set-target-object search-local c: 0)
                (up-get-point position-object gl-tc-push-x)
                (set-goal gl-deer-found 2)	
                (set-strategic-number sn-consecutive-idle-unit-limit 0)
                (disable-self)
            )

            (defrule
                (dropsite-min-distance deer-hunting < 31)
                (dropsite-min-distance deer-hunting != -1)
                (game-time > 330)
                (resource-found gold)
            (game-time > 5) =>
                (set-goal gl-deer-found 1)
                ;-chat-to-all "deer found")
                (disable-self)
            )


            (defrule
                (true)
                (game-time > 5) =>
                (set-strategic-number sn-focus-player-number 0)
            )

            (defrule
                (goal gl-lure 1)
                (or(and(game-time > 205)
                (up-compare-goal gl-edge-distanse <= 20))
                (and(game-time > 330)
                (up-compare-goal gl-edge-distanse > 20)))
                (or(and(dropsite-min-distance live-boar > 2)
                (dropsite-min-distance live-boar < 35))
                (game-time > 330))
                =>(set-goal gl-split-rule 228))

            (defrule
               (goal gl-split-rule 228)
                =>
                (up-full-reset-search)
                (up-set-target-point gl-tc-push-x)
                (up-filter-distance c: -1 c: 31)
                (up-find-remote c: 909 c: 40) ; common deer class
                (up-remove-objects search-remote object-data-carry < 100)
                (up-remove-objects search-remote object-data-id g:== gl-deer)
                (set-goal gl-lure 2)
                (set-strategic-number sn-focus-player-number 0)
                (up-get-search-state gl-local-total)
            )

            #load-if-defined UP-POCKET-POSITION
                
                (defrule
                (up-set-target-object search-remote c: 0)
                (game-time < 800)
            (game-time > 5) =>
                (up-set-target-object search-remote c: 0)
                (up-get-object-data object-data-id gl-deer)
            )

            #end-if

