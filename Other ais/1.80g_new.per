            )

            (defrule
            (up-set-target-object search-remote g: gl-index-number)
                (up-object-data object-data-upgrade-type == eagle-warrior)
                =>
                (set-goal gl-unit-score 120)
            )

            (defrule
                (up-set-target-object search-remote g: gl-index-number)
                =>
                (up-modify-goal gl-unit-score g:* gl-hitpoint-percentage)
                (up-modify-goal gl-unit-score c:/ 100)
            )

            (defrule
                (or(players-civ focus-player viking)
                (or(players-civ focus-player burmese)
                (or(players-civ focus-player magyar)
                (players-civ focus-player celtic))))
                (players-current-age focus-player == feudal-age)
                (up-set-target-object search-remote g: gl-index-number)
                (up-object-data object-data-type == militiaman)
