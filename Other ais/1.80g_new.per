                    (set-escrow-percentage stone 0)
                    (up-assign-builders c: town-center-foundation c: 40)
                    (set-strategic-number sn-placement-fail-delta 0)
                    (set-strategic-number sn-placement-zone-size 10)
                    (up-set-target-point gl-safe-tc-spot-x)
                    (up-build place-point 0 c: town-center)
                    (up-modify-escrow wood c:= 300)
                    (up-modify-escrow stone c:= 100)
                    (set-escrow-percentage wood 100)
                    (set-escrow-percentage stone 100)
                    )

                (defrule
                    (up-pending-objects c: town-center == 0)
                    (not(goal gl-safe-tc-spot-x -999))
                    (up-compare-goal gl-safe-tc-spot-x > 0)
                    (game-time > 5) =>
                (set-goal gl-safe-tc-spot-x -1)
                )

                (defrule
                    (not(goal gl-safe-tc-spot-x -1))
                    (up-pending-objects c: town-center > 0)
