                    ; Set priorities
                        
                        
                        (defrule
                            (building-type-count-total town-center < 2)
                            (game-time > 1)
                            (or(goal gl-delay-imp -1)
                            (wood-amount > 500))
                            (not(up-compare-goal gl-saving-for-upgrade == saving-for-elite-skirmisher))
                            =>
                            (up-modify-goal gl-town-center-building-priority c:+ 81)
                        )

                        (defrule
                            (building-type-count-total town-center == 2)
                            (up-research-status c: imperial-age >= research-pending)
                            (or(building-type-count-total farm >= 33)
                            (food-amount > 500))
                            (up-compare-goal gl-saving-wood-needed < 200)
                            (research-completed ri-chain-mail)
                            (game-time > 1)
                            (building-type-count-total market >= 3)
                            (building-type-count-total siege-workshop >= 3)
                            (building-type-count-total barracks >= 3)
                            (building-type-count-total archery-range >= 3)
                            (not(up-compare-goal gl-saving-for-upgrade == saving-for-elite-skirmisher))
                            =>
                            (up-modify-goal gl-town-center-building-priority c:+ 81)
                        )

                
                ; Archery range
                    (defrule
                        (building-type-count-total archery-range < 3)
                        (building-type-count-total town-center >= 2)
                        (not(up-compare-goal gl-saving-for-upgrade == saving-for-elite-skirmisher))
                        =>
                        (up-modify-goal gl-archery-range-building-priority c:+ 21)
                    )
                ; Monastery
                    (defrule
                        ;(goal gl-fase-3-stage 2) ;fejler når mange farms expire
                        (building-type-count-total town-center >= 2)
                        (building-type-count-total monastery < 1)
                        (food-amount > 275)
                        (building-type-count town-center >= 2)
                        ;(up-compare-goal gl-delay-imp == -1)
                        =>
                        (up-modify-goal gl-monastery-building-priority c:+ 106)
                    )
                
                ; University
                    (defrule
                        
                        (or(unit-type-count-total archer-line >= 1)
                        (up-compare-goal gl-calibrated-farm-count >= 30))
                        (or(up-compare-goal gl-calibrated-farm-count >= 24)
                        (and(food-amount >= 275)
                        (building-type-count town-center >= 2)))
                        (or(up-compare-goal gl-delay-imp == -1)
                        (and(building-type-count-total barracks >= 2)
                        (unit-type-count-total archer-line >= 20)))
                        =>
                        (set-goal gl-split-rule 670)
                    )

                    (defrule
                        (goal gl-split-rule 670)
