        ; Train units
            ; Train civillian units
                ;setup
                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp -1)
                    )
                    
                    (defrule ; dont Que so many vills that imp is delayed
                        ;(goal gl-saving-for-upgrade saving-for-imperial-age)
                        (food-amount > 750)
                        (up-pending-objects c: villager >= 1)
                        =>
                        (set-goal gl-split-rule 690)
                    )

                    (defrule
                        (or(goal gl-split-rule 690)
                        (or(and(gold-amount > 550)
                        (and(food-amount > 650)
                        (up-pending-objects c: villager >= 2)))
                        (and(gold-amount >= 650)
                        (or(food-amount >= 600)
                        (and(food-amount >= 450)
                        (up-pending-objects c: villager >= 2))))))
                        =>
                        (set-goal gl-split-rule 691)
                    )

                    (defrule
                        (goal gl-split-rule 691)
                        (up-research-status c: imperial-age < research-pending)
                        (building-type-count-total monastery > 0)
                        (building-type-count-total university > 0)
                        =>
                        ;(chat-to-all "not making vills to save imp")
                        (set-goal gl-temp 1)
                    )
                        
                        

                    (defrule ;dont Que vills when saving for eco upgrades and you are only missing food
                        (or(and(up-compare-goal gl-saving-for-upgrade == saving-for-heavy-plow)
                        (wood-amount >= 125))
                        (and(up-compare-goal gl-saving-for-upgrade == saving-for-hand-cart)
                        (wood-amount >= 200)))
                        =>
                        ;(chat-to-all "not making vills to save for farm upgrades")
                        (set-goal gl-temp 1)
                    )

                    (defrule
                        (or(current-age == imperial-age)
                        (and(up-research-status c: imperial-age == research-pending)
                        (timer-triggered tech-checking-timer)))
                        (food-amount < 1000)
                        (up-research-status c: ri-chemistry < research-pending)
                        (gold-amount >= 200)
                        =>
                        (set-goal gl-temp 1)
                        ;(chat-to-all "not making vills to save for imp-upgrades")
                    )

                    (defrule
                        (current-age == imperial-age)
                        (up-research-status c: ri-chemistry < research-pending)
                        =>
                        (set-goal gl-temp 1)
                        ;(chat-to-all "not making vills to save for imp-upgrades")
                    )

                ;train villagers
                    #load-if-defined DE-AVAILABLE
                    (defrule
                        (can-train villager)
                        (goal gl-temp -1)
                        (unit-type-count-total villager < 130)
                        (civilian-population < 140)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: town-center c: 3)
                        (up-target-point 0 action-train c: villager)
                    )
                    #end-if

                    #load-if-not-defined DE-AVAILABLE
                    (defrule
                        (can-train villager)
                        (goal gl-temp -1)
                        (unit-type-count-total villager < 130)
                        (civilian-population < 140)
                        =>
                        (train villager)
                    )
                    #end-if

                ;train trade carts
                    #load-if-not-defined UP-1-PLAYER-TEAM
                    (defrule
                        (true)
                        =>
                        (up-get-fact gold-amount 0 gl-temp1)
                        (up-modify-goal gl-temp1 g:- gl-saving-gold-needed)
                        (up-get-fact wood-amount 0 gl-temp2)
                        (up-modify-goal gl-temp2 g:- gl-saving-wood-needed)
                        (set-strategic-number sn-preferred-trade-distance 255)
                        (set-strategic-number sn-coop-share-information 1)
                    )

                    (defrule
                        (up-research-status c: ri-capped-ram >= research-pending)
                        (or(unit-type-count-total battering-ram-line >= 4)
                        (wood-amount > 500))
                        (unit-type-count-total trade-cart < 60)
                        (up-pending-objects c: trade-cart <= 4)
                        (civilian-population <= 170)
                        (up-compare-goal gl-temp1 >= 50)
                        (up-compare-goal gl-temp2 >= 100)
                        =>
                        (train trade-cart)
                    )
                    #end-if

                    (defrule
                        (civilian-population > 145)
                        (food-amount > 1000)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != farm-group)
                        (up-get-search-state gl-local-total)
                        (up-remove-objects search-local object-data-carry != 0)
                        (up-remove-objects search-local object-data-type == 212) ; female builder
                        (up-remove-objects search-local object-data-type == 118) ; male builder
                        (up-remove-objects search-local object-data-index != 0)
                    )

                    (defrule
                        (civilian-population > 145)
                        (food-amount > 1000)
                        (up-compare-goal gl-local-total > 35)
                        (up-set-target-object search-local c: 0)
