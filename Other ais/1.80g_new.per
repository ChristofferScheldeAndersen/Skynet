                                (up-modify-goal gl-stragglers-and-farmers g:+ gl-local-total)
                            )
                            
                    ; Chosing to build the farm
                            (defrule
                                (true)
                                =>
                                (up-get-fact wood-amount 0 gl-temp1)
                                (up-modify-goal gl-temp1 c:- 60)
                            )
                            
                            (defrule
                                (building-type-count mill > 0)
                                (up-compare-goal gl-unfinished-farms < 5)
                                (building-type-count-total farm g:< gl-stragglers-and-farmers)
                                (goal gl-farm-was-placed-this-pass -1) ; så der ikke bygges en farm for meget 
                                (game-time > 5)
                                (up-compare-goal gl-fase-3-stage == 1)
                                (or(up-compare-goal gl-saving-wood-needed g:<= gl-temp1)
                                (goal gl-saving-for-upgrade -1))
                                (building-type-count-total stable >= 1)
                                (up-research-status c: ri-bow-saw >= research-pending)
                                (not(up-compare-goal gl-saving-for-upgrade == saving-for-elite-skirmisher))
                                =>
                                (up-modify-goal gl-farm-building-priority c:+ 1)
                            )

                            (defrule
                                (up-compare-goal gl-unfinished-farms < 5)
                                (building-type-count-total farm g:< gl-stragglers-and-farmers)
                                (goal gl-farm-was-placed-this-pass -1) ; så der ikke bygges en farm for meget 
                                (game-time > 5)
                                (up-compare-goal gl-fase-3-stage >= 2)
                                (or(up-compare-goal gl-saving-wood-needed g:<= gl-temp1)
                                (goal gl-saving-for-upgrade -1))
                                =>
                                (set-goal gl-split-rule 251)
                            )

                            (defrule
                                (goal gl-split-rule 251)
                                (or(and(building-type-count-total farm <= 63)
                                (and(up-research-status c: ri-paladin < research-pending)
                                (up-research-status c: ri-savar < research-pending)))
                                (or(and(up-research-status c: ri-capped-ram < research-pending)
                                (building-type-count-total farm <= 60))
                                (building-type-count-total farm <= 60)))
                                (not(up-compare-goal gl-saving-for-upgrade == saving-for-elite-skirmisher))
                                =>
                                (up-modify-goal gl-farm-building-priority c:+ 1)
                                ;(chat-to-all "trying to place farm")
                            )
                                

                            (defrule
                                (up-compare-goal gl-unfinished-farms < 5)
                                (building-type-count-total farm g:< gl-stragglers-and-farmers)
                                (goal gl-farm-was-placed-this-pass -1) ; så der ikke bygges en farm for meget 
                                (game-time > 5)
                                (up-compare-goal gl-fase-3-stage >= 2)
                                (or(up-compare-goal gl-saving-wood-needed g:<= gl-temp1)
                                (goal gl-saving-for-upgrade -1))
                                (up-research-status c: ri-capped-ram >= research-pending)
                                (building-type-count-total farm <= 63)
                                (wood-amount > 500)
                                (not(up-compare-goal gl-saving-for-upgrade == saving-for-elite-skirmisher))
                                =>
                                (up-modify-goal gl-farm-building-priority c:+ 1)
                                ;(chat-to-all "trying to place farm")
                            )
                            
                            (defrule
                                (true)
                                =>
                                (up-get-fact food-amount 0 gl-temp1)
                                (up-get-fact gold-amount 0 gl-temp2)
                            )

                            (defrule
                                (up-compare-goal gl-fase-3-stage == 2)
                                (up-compare-goal gl-farm-building-priority >= 100)
                                (up-compare-goal gl-temp1 < gl-temp2)
                                =>
                                (up-modify-goal gl-farm-building-priority c:+ 30)
                            )

                            (defrule
                                (up-compare-goal gl-unfinished-farms < 5)
                                (building-type-count-total farm g:< gl-stragglers-and-farmers)
                                (goal gl-farm-was-placed-this-pass -1) ; så der ikke bygges en farm for meget 
                                (game-time > 5)
                                (building-type-count-total farm <= 73)
                                (or(wood-amount > 1000)
                                (and(wood-amount > 1000)
                                (population < 160)))
                                (unit-type-count-total villager-wood > 17)
                                 =>
                                (up-modify-goal gl-farm-building-priority c:+ 1)
                                ;(chat-to-all "building farms with extra wood")
                            )

                        (defrule
                            (taunt-detected my-player-number 2)
                            =>
