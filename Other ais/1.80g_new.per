                ;******************************************************************************
                ;
                ; Find target player
                ;
                ;******************************************************************************

                ; 1. først sættes target-player til 1. Herefter øges nummeret til target player er en 
                ; modstander
                ; 2. senere når rehoboam har scouted lidt, måske 12 min, sættes target-player til closest
                ; 3. løbende revurdering



                (defrule
                (true)
                =>
                (enable-timer target-player-timer 60)
                (disable-self)
                )

                ;#load-if-not-defined UP-POCKET-POSITION

                (defrule
                (game-time > 898)
                
                =>
                (up-find-player enemy find-closest CLOSEST-ENEMY)
                (up-modify-sn sn-target-player-number g:= CLOSEST-ENEMY)
                (disable-self)
                )

                (defrule
                ; (players-population target-player > 20)
                (game-time > 899)
                
                =>
                (up-find-player enemy find-closest CLOSEST-ENEMY)
                (up-modify-sn sn-target-player-number g:= CLOSEST-ENEMY)
                )

                (defrule
                (players-population target-player <= 15)
                    (game-time > 900)
                =>
                    (up-find-player enemy find-closest CLOSEST-ENEMY)
                (up-find-next-player enemy find-closest CLOSEST-ENEMY)
                (up-modify-sn sn-target-player-number g:= CLOSEST-ENEMY)
                )

                ;#end-if



                (defrule
                (timer-triggered target-player-timer)
                =>
                (disable-timer target-player-timer)
                (enable-timer target-player-timer 60)
                )

                (defrule
                    (true)
                    =>
                    (set-goal gl-TC-FOUND 0)
                    (disable-self)
                )
            

