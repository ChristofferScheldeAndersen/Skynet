                    (up-modify-group-flag 1 c: farming-group)
                    ;;(chat-to-player my-player-number "Adding third-assigned-farming-vill to farming-group")
                ) 

                (defrule
                    (up-set-target-by-id g: gl-forth-unfinished-farm) ; svt != -1
