                    (up-find-remote c: monk c: 40)(up-filter-include cmdid-military -1 -1 -1)   (up-find-remote c: all-units-class c: 240)(up-filter-include cmdid-villager -1 -1 -1)(up-find-remote c: all-units-class c: 240)
                    
                    (up-clean-search search-remote object-data-id search-order-asc)
                    (set-goal gl-temp11 0)
                    )

