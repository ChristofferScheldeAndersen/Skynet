                        (sell-commodity wood)
                        (chat-to-all "selling wood for knights")
                    )
                    
                    (defrule
                        (up-research-status c: imperial-age < research-pending)
                        (building-type-count university > 0)
                        (building-type-count monastery > 0)
                        (food-amount >= 1100)
                        (gold-amount < 800)
                        (commodity-selling-price food >= 40)
                        =>
