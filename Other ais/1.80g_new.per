                (unit-type-count skirmisher-line > 2))))
                (not(players-unit-type-count target-player scout-cavalry-line > 1))
                (not(and(goal gl-age-status feudal)
                (food-amount > 300)))
                =>
                (train skirmisher-line)
            )

            (defrule
                (players-unit-type-count target-player archer-line > 1)
                (unit-type-count skirmisher-line < 2)
                (unit-type-count archer-line < 5)
                (current-age == feudal-age)
                (food-amount > 75)
                (wood-amount > 65)
                (game-time > 5) =>
                (train skirmisher-line)
            )

            (defrule
                (current-age == imperial-age)
                (or(and(players-unit-type-count target-player spearman-line > 15)
                (unit-type-count skirmisher-line < 15))
                (and(players-unit-type-count target-player spearman-line > 25)
                (unit-type-count skirmisher-line < 25)))
                (not(and(unit-type-count skirmisher-line > 8)
                (not(research-completed ri-elite-skirmisher))))
                (not(players-unit-count any-ally > 20))
                         =>
                (train skirmisher-line)
            )

            (defrule
                (current-age == imperial-age)
                (or(and(players-unit-type-count target-player spearman-line > 35)
                (unit-type-count skirmisher-line < 35))
                (and(players-unit-type-count target-player halberdier > 5)
                (unit-type-count skirmisher-line < 15)))
                (not(and(unit-type-count skirmisher-line > 8)
                (not(research-completed ri-elite-skirmisher))))
                (not(players-unit-count any-ally > 20))
                         =>
                (train skirmisher-line)
            )

            (defrule
                (current-age == imperial-age)
                (or(and(players-unit-type-count target-player halberdier > 15)
                (unit-type-count skirmisher-line < 25))
                (and(players-unit-type-count target-player halberdier > 25)
