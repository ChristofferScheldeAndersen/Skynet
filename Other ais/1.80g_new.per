                        ;(up-chat-data-to-all "gl-temp8 is %d." g: gl-temp8)
                        (do-nothing)
                    )

                    

                ;De to største scores findes og de tilhørende player-numbers gemmes som flanks
                    
                    ;temp11-17 are player numbers and temp1-7-x is their positions
                    ;temp21-27 are ally scores
                    ;temp31-32 are flank scores
                    ;temp33-34 are flank player numbers


                    (defrule
                    (true)
                    =>
                    (set-goal gl-temp33 gl-temp21)
                    (up-modify-goal gl-temp31 g:= gl-temp21)
                    (set-goal gl-temp32 -9999)
                    (set-goal gl-temp41 gl-temp22)
                    (up-modify-goal gl-temp42 g:= gl-temp22)
                    )

                    (defrule
                    (up-compare-goal gl-temp42 g:> gl-temp31)
                    =>
                    (up-modify-goal gl-temp34 g:= gl-temp33)
                    (up-modify-goal gl-temp32 g:= gl-temp31)
                    (up-modify-goal gl-temp33 g:= gl-temp41)
                    (up-modify-goal gl-temp31 g:= gl-temp42)
                    )

                    (defrule
                    (up-compare-goal gl-temp33 g:!= gl-temp41)
                    (up-compare-goal gl-temp42 g:> gl-temp32)
                    =>
                    (up-modify-goal gl-temp34 g:= gl-temp41)
                    (up-modify-goal gl-temp32 g:= gl-temp42)
                    )

                    (defrule
                    (up-compare-goal gl-temp41 < gl-temp27)
                    =>
                    (up-modify-goal gl-temp41 c:+ 1) 
                    (up-get-indirect-goal g: gl-temp41 gl-temp42)
                    (up-jump-rule -3)
                    )

                    (defrule
                        (true)
                        =>
                        (up-modify-goal gl-temp33 c:- 120)
                        (up-modify-goal gl-temp34 c:- 120)
                    )

                ;Convert player numbers 1-4 for the actual player numbers

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp48 -1)
                        (set-goal gl-temp49 -1)
                    )

                    (defrule
                        (up-compare-goal gl-temp33 == 1)
                        (goal gl-temp49 -1)
                        =>
                        (up-modify-goal gl-temp33 g:= gl-temp11)
                        (up-modify-goal gl-temp49 c:+ 1)
                    )

                    (defrule
                        (up-compare-goal gl-temp33 == 2)
                        (goal gl-temp49 -1)
                        =>
                        (up-modify-goal gl-temp33 g:= gl-temp12)
