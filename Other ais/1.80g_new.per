                        (up-modify-goal gl-temp g:- 10) ;5994
                        (up-modify-goal gl-temp g:+ gl-time-since-last-pass) ;6660
                        (up-modify-goal gl-temp c:/ 25) ;666
                        (up-modify-goal 10 g:= gl-temp) ;666
