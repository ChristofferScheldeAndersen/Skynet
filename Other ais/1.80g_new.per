            ;Imperial sling
                    #load-if-defined UP-2-PLAYER-TEAM
                    (defrule
                        (true)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-other-flank)
                        (up-get-fact resource-amount food gl-temp2)
                        (up-modify-goal gl-temp2 c:- 500)
                        (up-get-fact resource-amount wood gl-temp3)
                        (up-modify-goal gl-temp3 c:- 500)
                        (up-get-fact resource-amount gold gl-temp4)
                        (up-modify-goal gl-temp4 c:- 500)
                        (up-get-fact resource-amount stone gl-temp5)
                        (up-modify-goal gl-temp5 c:- 500)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp1 -1)
                    )

                    (defrule
                    (up-compare-goal gl-temp2 > 0)
                    (or(population > 190)
                    (or(up-research-status c: ri-paladin >= research-pending)
                    (or(up-research-status c: ri-savar >= research-pending)
                    (food-amount > 1500))))
                    (research-completed ri-banking)
                    (players-population focus-player > 20)
                    (players-population focus-player < 175)
                    (not(player-resigned focus-player))
                    =>
                    (set-goal gl-split-rule 244)
                    )

                    (defrule
