                (defrule 
                (or(enemy-buildings-in-town)
                (up-enemy-villagers-in-town > 1))
                (game-time < 1800)
                (current-age <= castle-age)
                (players-building-type-count target-player watch-tower-line > 0)
                (up-compare-sn sn-maximum-town-size < 30)
                (game-time > 35)
                (game-time <= 300)
                =>
                (chat-to-all "Forward buildings detected. Rehoboam is not yet made to play vs forward buildings and may bug out due to this.")
                (disable-self)
                )

                (defrule 
                (players-building-type-count target-player watch-tower-line > 1)
                (current-age <= feudal-age)
                (game-time > 35)
                (game-time <= 300)
