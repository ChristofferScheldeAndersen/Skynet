            ; Starting fase 3 when strange civilisation detected*
                #load-if-not-defined FRANKISH-CIV
                (defrule
                        (up-compare-goal gl-strategy == fc-two-tc-one-stable-knights)
                        (game-time > 10)
                        (up-compare-goal gl-fase < 3)
                        =>
                        ;(set-goal gl-fase 3)
                        ;(chat-to-all "strange civ detected - Rehoboam will be handicapped - entering fase 3")
                        (disable-self)
                    )
                #end-if

                #load-if-not-defined FRANKISH-CIV
                #load-if-not-defined MAYAN-CIV
                (defrule
                        (up-compare-goal gl-strategy == greedy-archer-rush)
                        (game-time > 10)
                        (up-compare-goal gl-fase < 3)
                        =>
                        ;(set-goal gl-fase 3)
                        ;(chat-to-all "strange civ detected - Rehoboam will be handicapped - entering fase 3")
                        (disable-self)
                    )
                #end-if
                #end-if
                
            
            ; Starting fase 3 when getting tower rushed
                ;without ID loop
                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-get-point position-self gl-temp-x)
                        (up-set-target-point gl-temp-x)
                        (set-strategic-number sn-focus-player-number 1)
                        (up-filter-distance c: -1 c: 35)
                    )


                    (defrule ;list remote units after id (every time)
                    (players-stance focus-player enemy)
                    =>
                    (up-find-remote c: watch-tower c: 40)
                    )

                    (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                    )

                    (defrule
                        (true)
                        =>
                        (up-get-search-state gl-local-total)
                        (up-full-reset-search)
                        (up-get-point position-self gl-temp-x)
                        (up-set-target-point gl-temp-x)
                        (set-strategic-number sn-focus-player-number 1)
                        (up-filter-distance c: -1 c: 35)
                    )


                    (defrule ;list remote units after id (every time)
                    (players-stance focus-player enemy)
                    =>
                    (up-find-remote c: villager-class c: 40)      
                    )

                    (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                    )

                    (defrule
                        (true)
                        =>
                        (up-modify-goal gl-temp g:= gl-remote-total)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-compare-goal gl-temp > 0)
                        =>
                        ;(up-chat-data-to-all "found %d enemy towers in town without loops" g: gl-temp)
                        (do-nothing)
                    )

                    (defrule
                        (up-compare-goal gl-remote-total > 0)
                        =>
                        ;(up-chat-data-to-all "found %d enemy vills in town without loops" g: gl-remote-total)
                        (do-nothing)
                    )

                ;With ID loop (so that attacking towers, surrounding vills or prior spottet towers will be found)

                    (defrule
                        (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: house c: 200)
                        (up-clean-search search-local object-data-id search-order-asc)
                        (set-goal gl-temp4 0)
                        (set-goal gl-temp15 0)
                    )

                    (defrule
                    (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-data object-data-id gl-temp4)
                        (up-get-object-data object-data-id gl-temp15)
                        (up-get-object-data object-data-id gl-deer-id-checker)
                        (up-modify-goal gl-deer-id-checker c:- 2500)
                        (up-modify-goal gl-temp15 c:+ 2500)
                    )

                    (defrule
                    (current-age < castle-age)
                    (unit-type-count villager >= 20)
                    =>
                    (set-goal gl-temp5 0)
                    (set-goal gl-temp6 0)
                    (up-full-reset-search)
                    (up-get-point position-self gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-get-search-state gl-local-total)
                    (up-find-local c: town-center c: 1)
                    (set-goal gl-temp-x -1)
                    )

                    (defrule
                    (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        (up-set-target-by-id g: gl-deer-id-checker)
                        (up-object-data object-data-distance <= 30)
                        (up-object-data object-data-type == watch-tower)
                        (up-object-data object-data-player != my-player-number)
                        (up-object-data object-data-hitpoints > 1)
                        =>
                        (set-goal gl-temp-x -1)
                        (up-get-point position-object gl-temp-x)
                    )

                        (defrule
                        (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        (up-set-target-by-id g: gl-deer-id-checker)
                        (up-object-data object-data-distance <= 30)
                        (up-object-data object-data-type == watch-tower)
                        (up-object-data object-data-player != my-player-number)
                        (up-object-data object-data-hitpoints > 1)
                            (or(up-point-explored gl-temp-x == explored-active)
                            (and(up-point-explored gl-temp-x != explored-no)
                            (and(wood-amount >= 2)
                            (not(up-can-build-line 0 gl-temp-x c: palisade-wall)))))
                            =>
                    (up-modify-goal gl-temp5 c:+ 1)
                    )

                    (defrule
                        (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        (up-set-target-by-id g: gl-deer-id-checker)
                        (up-object-data object-data-distance <= 30)
                        (up-object-data object-data-type == watch-tower)
                        (up-object-data object-data-player != my-player-number)
                        (up-object-data object-data-hitpoints > 1)
                            (or(up-point-explored gl-temp-x == explored-active)
                            (and(up-point-explored gl-temp-x != explored-no)
                            (and(wood-amount >= 2)
                            (not(up-can-build-line 0 gl-temp-x c: palisade-wall)))))
                            =>
                    (up-get-object-data object-data-id gl-temp7)
                    ;(up-chat-data-to-all "id of found tower was %d" g: gl-temp7)
                    )

                    (defrule
                    (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        (up-set-target-by-id g: gl-deer-id-checker)
                        (up-object-data object-data-distance <= 30)
                        (up-object-data object-data-class == villager-class)
                        (up-object-data object-data-player != my-player-number)
                        (up-object-data object-data-hitpoints > 1)
                        =>
                        (set-goal gl-temp-x -1)
                        (up-get-point position-object gl-temp-x)
                    )

                        (defrule
                        (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        (up-set-target-by-id g: gl-deer-id-checker)
                        (up-object-data object-data-distance <= 30)
                        (up-object-data object-data-class == villager-class)
                        (up-object-data object-data-player != my-player-number)
                        (up-object-data object-data-hitpoints > 1)
                            (up-point-explored gl-temp-x == explored-active)
                            =>
                    (up-modify-goal gl-temp6 c:+ 1)
                    (up-get-object-data object-data-id gl-temp4)
                    ;(up-chat-data-to-all "id of found vill was %d" g: gl-temp4)
                    )

                    (defrule
                        (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        (up-compare-goal gl-deer-id-checker g:< gl-temp15)
                        (or(up-compare-goal gl-my-position == 3)
                        (up-compare-goal gl-my-position == 5))
                        (up-compare-goal gl-anti-trush != 1)
                        =>
                        (up-modify-goal gl-deer-id-checker c:+ 1)
                        (up-jump-rule -6)
                    )


                    (defrule
                        (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        ;(up-compare-goal gl-temp5 > 0)
                        =>
                        ;(up-chat-data-to-all "gl-deer-id-checker is %d" g: gl-deer-id-checker)
                        ;(up-chat-data-to-all "New found %d enemy towers in town" g: gl-temp5)
                        ;(up-chat-data-to-all "New found %d enemy vills in town" g: gl-temp6)
                        (do-nothing)
                    )



                    




                    (defrule 
                        ;(up-compare-goal gl-temp > 0)
                        ;(up-compare-goal gl-remote-total > 1)
                    (unit-type-count villager >= 20)
                        (or(up-compare-goal gl-temp5 > 0)
                        (up-compare-goal gl-temp6 >= 5))
                        
                        ;(or(enemy-buildings-in-town)
                        ;(up-enemy-villagers-in-town > 1))
                        (game-time < 1800)
                        (current-age <= feudal-age)
                        ;(players-building-type-count target-player watch-tower-line > 1)
                        ;(up-compare-sn sn-maximum-town-size < 30)
                        =>
                    (set-strategic-number sn-allow-civilian-offense 2)
                    (set-strategic-number sn-allow-civilian-defense 0)
                    (set-strategic-number sn-maximum-town-size 30)
                    ;(set-strategic-number sn-disable-villager-garrison 3)
                    (set-strategic-number sn-number-civilian-militia 200)
                    ;(chat-to-all "Getting semitrushed.")
                    )

                    (defrule 
                        ;(up-compare-goal gl-temp > 0)
                        ;(up-compare-goal gl-remote-total > 1)
                    (unit-type-count villager >= 20)
                        (or(up-compare-goal gl-temp5 > 0)
                        (up-compare-goal gl-temp6 >= 5))
                        
                        ;(or(enemy-buildings-in-town)
                        ;(up-enemy-villagers-in-town > 1))
                        (game-time < 1800)
                        (current-age <= feudal-age)
                        ;(players-building-type-count target-player watch-tower-line > 1)
                        ;(up-compare-sn sn-maximum-town-size < 30)
                        (up-timer-status semitrush-timer != timer-running)
                        =>
                    (enable-timer semitrush-timer 90)
                    ;(up-chat-data-to-all "Found %d enemy towers in town" g: gl-temp5)
                    ;(up-chat-data-to-all "Found %d enemy vills in town" g: gl-temp6)
                    ;(chat-to-all "Getting semitrushed.")
                    (disable-self)
                    )

                    (defrule 
                        ;(up-compare-goal gl-temp > 0)
                        ;(up-compare-goal gl-remote-total > 1)
                    (unit-type-count villager >= 20)
                        (or(and(up-players-in-game enemy <= 2)
                        (and(timer-triggered semitrush-timer)
                        (and(up-compare-goal gl-temp5 > 0)
                        (up-compare-goal gl-temp6 >= 1))))
                        (or(and(up-compare-goal gl-temp5 > 0)
                        (up-compare-goal gl-temp6 >= 5))
                        (up-compare-goal gl-temp5 > 1)))
                        
                        ;(or(enemy-buildings-in-town)
                        ;(up-enemy-villagers-in-town > 1))
                        (game-time < 1800)
                        (current-age <= feudal-age)
                        ;(up-players-in-game enemy <= 2) ;trigger for ofte i 4v4's
                        ;(players-building-type-count target-player watch-tower-line > 1)
                        ;(up-compare-sn sn-maximum-town-size < 30)
                        =>
                        (set-goal gl-split-rule 1001)
                    
                    )

                    (defrule
                        (goal gl-split-rule 1001)
                        =>
                        (set-goal gl-fase 3)
                    (set-goal gl-anti-trush 1)
                    ;(up-chat-data-to-all "Found %d enemy towers in town" g: gl-temp5)
                    ;(up-chat-data-to-all "Found %d enemy vills in town" g: gl-temp6)
                    ;(chat-to-all "Getting trushed. Entering fase 3")
                    (disable-self)
                    )

                    
                    (defrule
                        (goal gl-anti-trush 1)
                        (up-compare-goal gl-temp5 > 0)
                        (up-set-target-by-id g: gl-temp7)
                        =>
                        (up-find-local c: villager-class c: 200)
                    (up-get-point position-object gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-clean-search search-local object-data-distance search-order-asc)
                    (up-remove-objects search-local object-data-index >= 5)
                    (up-target-objects 1 action-default -1 -1)
                    (disable-self)
                    ;(chat-to-all "force vills to attack first tower once")
                    )
                    




                
            ; Starting fase 3 when playing on lower difficulties
                #load-if-not-defined DIFFICULTY-HARD
                #load-if-not-defined DIFFICULTY-HARDEST
                #load-if-not-defined DIFFICULTY-EXTREME

                (defrule
                    (true)
                    =>
                    (set-goal gl-fase 3)
                    (chat-to-all "Difficulty set lower than hard. Entering fase 3")
                    (disable-self)
                )

                #end-if
                #end-if
                #end-if
            ; Starting fase 3 when taunt 200 is written
                (defrule
                    (or(taunt-detected any-ally 200)
                    (or(taunt-detected any-enemy 200)
                    (taunt-detected my-player-number 200)))
                    =>
                    (set-goal gl-fase 3)
                    (acknowledge-taunt every-ally 200)
                    (acknowledge-taunt every-enemy 200)
                    (acknowledge-taunt my-player-number 200)
                    (chat-to-all "Taunt 200 detected. Entering fase 3")
                )

            ; Starting fase 3 when under severe attack

                (defrule
                (true)
                (game-time > 5) =>
                (up-full-reset-search)
                (up-get-point position-self gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-filter-distance c: -1 c: 27)
                (set-strategic-number sn-focus-player-number 1)
                (set-goal gl-remote-total 0)
                )

                (defrule
                (players-stance focus-player enemy)
                    (game-time > 5) =>
                    (up-filter-include cmdid-military -1 -1 -1)(up-find-remote c: all-units-class c: 240)(up-filter-include cmdid-villager -1 -1 -1)(up-find-remote c: all-units-class c: 240)
                    (up-get-search-state gl-local-total)
                    )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    (up-compare-goal gl-remote-total < 2)
                    (game-time > 5) =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )

                (defrule
                    (true)
                    =>
                    (up-modify-goal gl-temp1 g:= gl-remote-total)
                    (up-get-fact military-population 0 gl-temp2)
                    (up-modify-goal gl-temp2 g:- gl-temp1)
                )


                    (defrule
                        (or(and(military-population < 5)
                    (up-compare-goal gl-MILITARY-SUPERIORITY < -9))
                    (or(and(military-population >= 5)
                    (and(up-compare-goal gl-MILITARY-SUPERIORITY < -12)
                    (up-enemy-units-in-town > 5)))
                    (up-compare-goal gl-temp2 <= -5)))
                        =>
                    (set-goal gl-split-rule 18)
                    )

                    (defrule
                    (goal gl-split-rule 18)
                    (current-age <= feudal-age)
                        (up-research-status c: castle-age < research-pending)
                        (up-enemy-units-in-town > 2)
                        (town-under-attack)
                        =>
                        ;(set-goal gl-split-rule 0)
                        ;(set-goal gl-fase 3)
                    ;(chat-to-all "Under severe attack. Entering fase 3")
                        (disable-self)
                    )
                
            

            ; Starting fase 3 mid feudal on hard
