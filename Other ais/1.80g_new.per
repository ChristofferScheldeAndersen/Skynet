            ;Buying and selling
                ;pocket exces rules before paladin
                    
                    (defrule
                        (goal gl-under-massive-attack 1)
                        (gold-amount > 375)
                        (food-amount < 60)
                        (can-buy-commodity food)
                        (commodity-buying-price food <= 300)
                        (up-pending-objects c: knight-line < 5)
                        =>
                        (buy-commodity food)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp -1)
                    )

                    (defrule
                        (true)
