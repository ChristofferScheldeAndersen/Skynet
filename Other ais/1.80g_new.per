                ;(chat-to-all "Multiple towers detected. Rehoboam is not yet made to play vs more than one tower, but should do ok ursually")
                (disable-self)
                )

                (defrule 
                (or(players-building-type-count target-player palisade-wall > 0)
                (or(players-building-type-count target-player stone-wall > 0)
