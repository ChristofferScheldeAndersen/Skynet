            ;Set retreat goal after deer has been lured

                (defrule 
                (true)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-scout-unit)
                (up-remove-objects search-local object-data-hitpoints >= 25)
                (set-strategic-number sn-focus-player-number 1)
                )

                (defrule
                (players-stance focus-player enemy)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-filter-distance c: -1 c: 9)
                (up-find-remote c: all-units-class c: 40)
                (up-remove-objects search-remote object-data-target-id g:!= gl-scout-unit)
                )

                (defrule
                (up-compare-sn sn-focus-player-number < 8)
                =>
                (up-modify-sn sn-focus-player-number c:+ 1)
                (up-jump-rule -2)
                )

                (defrule
                (or(up-compare-goal gl-deer-luring-stage == No-more-deer)
                (current-age == castle-age))
                (up-set-target-object search-remote c: 0)
                (up-object-target-data object-data-id g:== gl-scout-unit)
                =>
                (set-goal gl-temp1 2)
                ;(chat-to-all "rule 3")
                )

            ;Turn of retreating when scout is under tc and fighting

                (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-scout-unit)
                (up-remove-objects search-local object-data-target-id == -1)
                (up-get-point position-self gl-temp-x)
                (up-remove-objects search-local object-data-distance > 2)
                (up-set-target-point gl-temp-x)
                )

                (defrule
                (up-set-target-object search-local c: 0)
                =>
                (set-goal gl-temp1 -1)
                ;(chat-to-all "rule 4")
                )

            ;Retreating scout 5 tiles towards tc

                (defrule
                (up-compare-goal gl-temp1 > 0)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-scout-unit)
                (up-get-point position-self gl-temp-x)
                )

                (defrule
                (up-compare-goal gl-deer-luring-stage < No-more-deer)
                (up-compare-goal gl-temp1 > 0)
                (up-set-target-object search-local c: 0)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-scout-unit)
                (up-get-point position-self gl-temp-x)
                (up-target-point gl-temp-x action-move -1 -1)
                ;(chat-to-all "retreating scout to tc")
                )

                (defrule
                (or(up-compare-goal gl-deer-luring-stage == No-more-deer)
                (current-age == castle-age))
                (up-compare-goal gl-temp1 > 0)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp1-x)
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-scout-unit)
                (up-get-point position-self gl-temp-x)
                (up-lerp-tiles gl-temp1-x gl-temp-x c: 20)
                (up-target-point gl-temp-x action-move -1 -1)
                ;(chat-to-all "retreating scout 20 tiles towards tc")
                )

            ;Fight back while under tc

                (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-scout-unit)
                (up-get-point position-self gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-remove-objects search-local object-data-distance > 2)
                (set-strategic-number sn-focus-player-number 1)
                (set-goal gl-temp -2)
                )

                (defrule
                (players-stance focus-player enemy)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-target-id gl-temp)
                (up-get-point position-object gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-filter-distance c: -1 c: 5)
                (up-find-remote c: scout-cavalry-line c: 40)
                (up-find-remote c: villager-class c: 40)
                (up-find-remote c: missionary c: 20)(up-filter-include cmdid-monk -1 -1 -1)
                (up-find-remote c: monk c: 40)(up-filter-include cmdid-military -1 -1 -1)   (up-find-remote c: all-units-class c: 240)(up-filter-include cmdid-villager -1 -1 -1)(up-find-remote c: all-units-class c: 240)
                
                )

                (defrule
                (up-compare-sn sn-focus-player-number < 8)
                =>
                (up-modify-sn sn-focus-player-number c:+ 1)
                (up-jump-rule -2)
                )

                (defrule
                (up-set-target-object search-remote c: 0)
                (up-object-data object-data-id g:!= gl-temp)
                =>
                (up-target-objects 0 action-default -1 -1)
                ;(chat-to-all "attacking enemy scout")
                )

        ; 6 Push the deer
            
            
            
            ;mangler optimering herfra. Reglen med no more deer kører ikke pt. Skal også lige fixes

            (defrule
                (goal gl-deer-luring-stage Luring-deer)
                =>
                (up-full-reset-search)
                (set-strategic-number sn-target-point-adjustment 5)
                (up-add-object-by-id search-local g: gl-scout-id)
                (up-add-object-by-id search-remote g: gl-current-deer-id)
                (up-set-target-object search-remote c: 0)
                (up-get-point position-object gl-deer-position-x)
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                )

            ; be close to deer if its close to the tc
            (defrule
                (goal gl-deer-luring-stage Luring-deer)
                ;(up-object-data object-data-distance < 35) ;17
            (up-set-target-by-id g: gl-current-deer-id)
            (up-compare-goal gl-temp1 <= 0)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-scout-id) ;bør ændres til følgende herunder:
                ;(up-add-object-by-id search-local g: gl-scout-unit)
                (up-get-point position-self gl-position-self-x)
                (up-modify-goal gl-position-self-x c:* 100)
                (up-modify-goal gl-position-self-y c:* 100)
                )

                (defrule
                (goal gl-deer-luring-stage Luring-deer)
                ;(up-object-data object-data-distance < 35) ;17
            (up-set-target-by-id g: gl-current-deer-id)
            (up-compare-goal gl-temp1 <= 0)
                =>
                (up-get-object-data object-data-precise-x gl-temp-x)
                (up-get-object-data object-data-precise-y gl-temp-y)
                (up-get-point-distance gl-position-self-x gl-temp-x gl-precise-deer-distance)
                (up-modify-goal gl-precise-deer-distance c:/ 100)
                (up-lerp-tiles gl-temp-x gl-position-self-x c: -75)
                (up-bound-precise-point gl-temp-x 1 c: 20)
                (up-set-precise-target-point gl-temp-x)
                (set-strategic-number sn-target-point-adjustment 6)
                
                (up-target-point 0 action-move -1 -1)
                ;(chat-to-all "pushing deer")
                )

            

        ; 7 Check for dead deer and reset loop

            (defrule
                (goal gl-deer-luring-stage Luring-deer)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-remote g: gl-current-deer-id)
                (up-set-target-object search-remote c: 0)
            )

            (defrule
            (goal gl-deer-luring-stage Luring-deer)
                (up-object-data object-data-hitpoints == 0)
                =>
                ;;(chat-to-all "deer is dead")
                (set-goal gl-deer-luring-stage Looking-for-deers)   
                )

        ; 8 Kill deer (and create deer group) groups stuff flyttet til group kode
            
            
            ; Undersøg afstand fra deer til den deer vill der er længst væk. Hvis en deer er inden for en lidt større 
            ; afstand til tc og samtidigt meget tæt (2 tiles?) på denne vill skal den skydes direkte af deer vills.

        
            
                (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-add-object-by-id search-remote g: gl-shooting-deer)
                (up-remove-objects search-remote object-data-distance > 4)
            )

            (defrule ; garrison skyde regel
                (goal gl-deer-luring-stage Luring-deer)
                (up-compare-goal gl-dont-ungarrison != 1)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-id gl-tc-priority-gatherpoint) ;new
                (up-find-local c: town-center c: 1)
                (up-target-objects 0 action-gather -1 -1)
                (up-target-objects 0 action-ungarrison -1 -1)
                ;(chat-to-all "tc is targeting deer")
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-add-object-by-id search-remote g: gl-shooting-deer)
                (up-remove-objects search-remote object-data-distance > 4)
            )

            (defrule ; garrison skyde regel
                (goal gl-deer-luring-stage Luring-deer)
                (up-set-target-object search-remote c: 0)
                =>
                (up-reset-search 0 0 1 1)
                (up-find-local c: villager-class c: 30)
                (up-remove-objects search-local object-data-group-flag != deer-group)
                (up-remove-objects search-local object-data-target-id g:== gl-shooting-deer)
                (up-remove-objects search-local object-data-target-id g:== gl-current-deer-id)
                ;(up-remove-objects search-local object-data-target == 909)
                (set-strategic-number sn-focus-player-number my-player-number)
                (up-find-remote c: town-center c: 1)
            )
            #load-if-defined DE-AVAILABLE
            
            (defrule
                (goal gl-deer-luring-stage Luring-deer)
                (up-set-target-object search-local c: 0)
                (up-set-target-object search-remote c: 0)
                =>
                (up-target-point gl-temp-x action-stop -1 -1)
                (up-target-objects 0 action-garrison -1 -1)
                ;(chat-to-all "garrison vills to kill deer")
                ;(disable-self)
            )
            #end-if

            (defrule
                (true)
                =>
                (up-full-reset-search)
            )

            (defrule ; ny skyde regel
                (goal gl-deer-luring-stage Luring-deer)
                (up-compare-goal gl-shooting-deer != -1)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 30)
                (up-remove-objects search-local object-data-group-flag != deer-group)
                (up-add-object-by-id search-remote g: gl-shooting-deer)
            )

            (defrule
                (goal gl-deer-luring-stage Luring-deer)
                (up-compare-goal gl-shooting-deer != -1)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-clean-search search-local object-data-distance search-order-desc)
            )

            (defrule
                (goal gl-deer-luring-stage Luring-deer)
                (up-compare-goal gl-shooting-deer != -1)
                (up-set-target-object search-remote c: 0)
                (up-set-target-object search-local c: 0)
                =>
                (up-get-object-data object-data-distance gl-deer-distance-from-vills)
                (up-full-reset-search)
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-add-object-by-id search-remote g: gl-shooting-deer)
                (up-remove-objects search-remote object-data-distance > 4)
            )

            #load-if-defined DE-AVAILABLE
            
            (defrule
            (goal gl-deer-luring-stage Luring-deer)
                (up-compare-goal gl-shooting-deer != -1)
                (up-compare-goal gl-deer-distance-from-vills <= 5)
                (up-set-target-object search-remote c: 0)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 30)
                (up-remove-objects search-local object-data-group-flag != deer-group)
                (up-remove-objects search-local object-data-class == 218) ;lumberjacks
                (up-remove-objects search-local object-data-class == 123)
                (up-remove-objects search-local object-data-target-id g:== gl-shooting-deer)
                (up-remove-objects search-local object-data-target == 915)
                (up-remove-objects search-local object-data-target == building-class)
                (up-add-object-by-id search-remote g: gl-shooting-deer)
                (up-target-objects 0 action-default -1 -1)
                ;(up-chat-data-to-all "shooting deer without garrison - new rule with %d distance" g: gl-deer-distance-from-vills)
            )

            #end-if
            
            #load-if-not-defined DE-AVAILABLE
            (defrule
                (goal gl-deer-luring-stage Luring-deer)
                (up-compare-goal gl-shooting-deer != -1)
                (up-compare-goal gl-deer-distance-from-vills <= 5)
                (up-set-target-object search-remote c: 0)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 30)
                (up-remove-objects search-local object-data-group-flag != deer-group)
                (up-remove-objects search-local object-data-class == 218) ;lumberjacks
                (up-remove-objects search-local object-data-class == 123)
                (up-remove-objects search-local object-data-target-id g:== gl-shooting-deer)
                (up-add-object-by-id search-remote g: gl-shooting-deer)
                (up-target-objects 0 action-default -1 -1)
                ;(up-chat-data-to-all "shooting deer without garrison - new rule with %d distance" g: gl-deer-distance-from-vills)
            )
            #end-if

        ; 9 Eating deer


            
            ; plan:

            ;killing deer
            ; Søg efter deer inden for nuværende distance til tc. Disse dræbes via garrison og så længe dette er tilfældet
            ; slukkes der også for alle eating deer mechanics. !!
        

            ;Eating deer
            ; søg efter døde deers omkring tc og fjern alle uden food. List dem derefter efter tilbageværende food og 
            ; start med den med mindst. Denne vælges som eating deer.


            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-modify-goal gl-remote-total c:= -1)
                (up-find-local c: town-center c: 1)
                (up-set-target-object search-local c: 0)
                (up-get-object-data object-data-id gl-deer-id-checker)
                (up-modify-goal gl-deer-id-checker g:= gl-first-gaia-id)
            )

            (defrule
                (up-set-target-by-id g: gl-deer-id-checker)
                (up-object-data object-data-class == 909)
                (up-object-data object-data-carry > 0)
                (up-object-data object-data-hitpoints < 1)
                =>
            (up-get-object-data object-data-id gl-current-deer-id2)
            (up-add-object-by-id search-remote g: gl-current-deer-id2)
            )

            (defrule
                (up-compare-goal gl-deer-id-checker g:< gl-last-gaia-id)
                (up-compare-goal gl-deer-eating-stage != No-more-deer)
                =>
                (up-modify-goal gl-deer-id-checker c:+ 1)
                (up-jump-rule -2)
            )

            (defrule
                (true)
                =>
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-remove-objects search-remote object-data-distance > 9)
                (up-remove-objects search-remote object-data-carry < 1)
                (up-clean-search search-remote -1 search-order-asc)
                (up-clean-search search-remote object-data-carry search-order-asc)
                (up-remove-objects search-remote object-data-index > 0)
            )

            (defrule
                (true)
                (up-set-target-object search-remote c: 0)
                =>
                (up-get-object-data object-data-id gl-eating-deer)
                (up-get-search-state gl-local-total)
            )

            (defrule
                        (up-compare-goal gl-eating-deer != -1)
                        =>
                        (set-goal gl-confused-vill-loop-counter 0)
                    )

                    (defrule ;1
                        (up-compare-goal gl-eating-deer != -1)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != deer-group)
                        (up-remove-objects search-local object-data-target == building-class)
                        (up-clean-search search-local object-data-id search-order-asc)
                        (up-remove-objects search-local object-data-index g:!= gl-confused-vill-loop-counter)
                        (up-set-target-object search-local c: 0)
                        (up-get-object-target-data object-data-id gl-confused-vill-target)
                    )

                    (defrule
                        (up-compare-goal gl-confused-vill-target g:!= gl-eating-deer)
                        (up-compare-goal gl-eating-deer != -1)
                        (up-compare-goal gl-shooting-deer == -1)
                        =>
                        (up-add-object-by-id search-remote g: gl-eating-deer)
                        (up-target-objects 0 action-default -1 -1)
                        ;;(chat-to-all "retargeting vill to deer")
                    )

                    (defrule
                        (up-compare-goal gl-confused-vill-loop-counter <= 3)
                        =>
                        (up-modify-goal gl-confused-vill-loop-counter c:+ 1)
                        (up-jump-rule -3)
                    )

            (defrule
                (taunt-detected my-player-number 17)
                =>
                (up-chat-data-to-all "gl-eating-deer is %d." g: gl-eating-deer);deer id
                (up-chat-data-to-all "gl-confused-vill-target is %d." g: gl-confused-vill-target);deer id
                (up-chat-data-to-all "gl-confused-vill-loop-counter is %d." g: gl-confused-vill-loop-counter);4
                (up-chat-data-to-all "gl-shooting-deer is %d." g: gl-shooting-deer); 0
                (acknowledge-taunt my-player-number 17)
            )

            ;eating deer chosen kører konstant

            ;(defrule
                ;(up-compare-goal gl-shooting-deer == -1)
            ; (up-compare-goal gl-eating-deer != -1)
            ; =>
            ; (up-full-reset-search)
            ; (up-find-local c: villager-class c: 30)
            ; (up-remove-objects search-local object-data-group-flag != deer-group)
            ; (up-add-object-by-id search-remote g: gl-eating-deer)
            ; (up-target-objects 0 action-default -1 -1)
            ; ;(chat-to-player my-player-number "eating deer")
            ;)

        ; 10 tasking idle deer vills to stragglers and sheep
            (defrule
                (not(up-set-target-by-id g: gl-deer-group-tree))
                (up-compare-goal gl-deer-group-tree != -1)
                =>
                (set-goal gl-deer-group-tree -1)
            )

            (defrule ; find deer-group tree
                (goal gl-eating-deer -1)
                (goal gl-shooting-deer -1)
                (goal gl-deer-group-tree -1)
                (goal gl-first-deer-killed 1)
                =>
                (up-full-reset-search)
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 10)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-group-flag != deer-group)
                (up-clean-search search-local object-data-distance search-order-asc)
                
                ;;(chat-to-player my-player-number "chosing tree for deer group")

                ;(up-get-point position-object gl-position-self-x) ; debug
                ;;;(up-send-flare gl-position-self-x)

                ;(up-get-object-data object-data-carry gl-position-self-x)
                ;;(up-chat-data-to-player my-player-number "tree has %d. wood left" g: gl-position-self-x)
            )

            (defrule ; find deer-group tree
                (goal gl-eating-deer -1)
                (goal gl-shooting-deer -1)
                (goal gl-deer-group-tree -1)
                (goal gl-first-deer-killed 1)
                =>
                
                (up-set-target-object search-local c: 0)
                (up-get-point position-object gl-position-self-x)
                (up-filter-distance c: -1 c: 10)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 200)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: wood c: 200)
                (up-clean-search search-remote object-data-distance search-order-asc)
                (up-set-target-object search-remote c: 0)
                (up-get-object-data object-data-id gl-deer-group-tree)
                ;;(chat-to-player my-player-number "chosing tree for deer group")

                ;(up-get-point position-object gl-position-self-x) ; debug
                ;;;(up-send-flare gl-position-self-x)

                ;(up-get-object-data object-data-carry gl-position-self-x)
                ;;(up-chat-data-to-player my-player-number "tree has %d. wood left" g: gl-position-self-x)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
            )

            (defrule
                (goal gl-eating-deer -1)
                (goal gl-shooting-deer -1)
                (not(goal gl-deer-group-tree -1))
                (goal gl-first-deer-killed 1)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-remote g: gl-deer-group-tree)
                (up-set-target-object search-remote c: 0)
                ;(up-remove-objects search-remote object-data-carry < 1)
                ;;(chat-to-player my-player-number "tree is chopped. chosing new1")
            )

            (defrule
                (goal gl-eating-deer -1)
                (goal gl-shooting-deer -1)
                (not(goal gl-deer-group-tree -1))
                ;(up-set-target-object search-remote c: 0)
                (goal gl-first-deer-killed 1)
                (not(up-object-data object-data-carry > 0))
                (not(up-object-data object-data-carry < 100))
                =>
                (set-goal gl-deer-group-tree -1)
                ;(chat-to-player my-player-number "tree is chopped. chosing new")
            )



            (defrule ; loop to send idle deer-vills to tree
                        (goal gl-eating-deer -1)
                        (goal gl-shooting-deer -1)
                        (goal gl-first-deer-killed 1)
                        =>
                        (set-goal gl-confused-vill-loop-counter 0)
                    )

                    (defrule ;1
                        (goal gl-eating-deer -1)
                        (goal gl-shooting-deer -1)
                        (goal gl-first-deer-killed 1)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != deer-group)
                        (up-clean-search search-local object-data-id search-order-asc)
                        (up-remove-objects search-local object-data-index g:!= gl-confused-vill-loop-counter)
                        (up-remove-objects search-local object-data-carry > 0) ; lad dem droppe food først
                        (up-set-target-object search-local c: 0)
                        (up-get-object-target-data object-data-id gl-confused-vill-target)
                    )

                    (defrule
                        (up-compare-goal gl-confused-vill-target g:!= gl-deer-group-tree)
                        (goal gl-eating-deer -1)
                        (goal gl-shooting-deer -1)
                        (up-set-target-object search-local c: 0)
                        (goal gl-first-deer-killed 1)
                        (not(goal gl-deer-group-tree -1))
                        =>
                        (up-add-object-by-id search-remote g: gl-deer-group-tree)
                        (up-target-objects 0 action-default -1 -1)
                        ;(chat-to-all "retargeting deer-vill to wood")
                    )

                    (defrule
                    (goal gl-eating-deer -1)
                    (goal gl-shooting-deer -1)
                        (up-compare-goal gl-confused-vill-loop-counter <= 3)
                        (goal gl-first-deer-killed 1)
                        =>
                        (up-modify-goal gl-confused-vill-loop-counter c:+ 1)
                        (up-jump-rule -3)
                    )

                    

        ; 11 Resetting deer goals (and checken if there is no more deer to eat)

            
            (defrule
                (or(and(goal gl-eating-deer -1)
                (up-compare-goal gl-deer-luring-stage >= No-more-deer))
                (game-time > 960))
                
                =>
                ;(chat-to-all "No more deer to eat 4.")
                (set-goal gl-deer-eating-stage No-more-deer-to-eat)
                (disable-self)
            )
            
            (defrule
                (true)
                =>
                (set-goal gl-eating-deer -1)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-shooting-deer c:= -1) ; ny
            )

    ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 422 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 691 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                )
    ;8 Forrage bushes
        ;0 make vills go to stragglers untill you have wood for mill
            (defrule ; find deer-group tree

                (building-type-count mill < 1)
                (up-pending-objects c: mill < 1)
                (unit-type-count villager-class > 9)
                =>
                ;find træ tættest på to tiles fra tc mod berries og send vills til det
                (up-full-reset-search)
                        (up-get-point position-self gl-position-self-x)
                        (up-set-target-point gl-position-self-x)
                        (up-filter-distance c: 0 c: 15)
                        (up-filter-status c: status-resource c: list-active)
                        (up-find-resource c: food c: 30)
                        (up-set-target-object search-remote c: 0)
                
                ;;(chat-to-player my-player-number "chosing tree for berry group")
                (disable-self)
                ;(up-get-point position-object gl-position-self-x) ; debug
                ;;;(up-send-flare gl-position-self-x)
                ;(up-get-object-data object-data-carry gl-position-self-x)
                ;;(up-chat-data-to-player my-player-number "tree has %d. wood left" g: gl-position-self-x)
            )

            (defrule ; find deer-group tree

                (building-type-count mill < 1)
                (up-pending-objects c: mill < 1)
                (unit-type-count villager-class > 9)
                =>
               
                (up-get-point position-object gl-building-testing-spot-x) ; berry spot
                (up-lerp-tiles gl-position-self-x gl-building-testing-spot-x c: 1)
                (up-full-reset-search)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: -1 c: 8)
                (up-filter-status c: status-ready c: list-active)
                (up-find-resource c: wood c: 40)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: wood c: 40)
                (up-clean-search search-remote object-data-distance search-order-asc)
                (up-set-target-object search-remote c: 0)
                (up-get-object-data object-data-id gl-berry-group-tree)
                ;;(chat-to-player my-player-number "chosing tree for berry group")
                (disable-self)
                ;(up-get-point position-object gl-position-self-x) ; debug
                ;;;(up-send-flare gl-position-self-x)
                ;(up-get-object-data object-data-carry gl-position-self-x)
                ;;(up-chat-data-to-player my-player-number "tree has %d. wood left" g: gl-position-self-x)
            )



            (defrule ; loop to send idle berry-vills to tree
                        (building-type-count mill < 1)
                (up-pending-objects c: mill < 1)
                (unit-type-count villager-class > 9)
                        =>
                        (set-goal gl-confused-vill-loop-counter 0)
                    )

                    (defrule ;1
                        (building-type-count mill < 1)
                (up-pending-objects c: mill < 1)
                (unit-type-count villager-class > 9)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-target == building-class)
                        (up-remove-objects search-local object-data-group-flag != berry-group)
                        (up-clean-search search-local object-data-id search-order-asc)
                        (up-remove-objects search-local object-data-index g:!= gl-confused-vill-loop-counter)
                        (up-remove-objects search-local object-data-carry > 0) ; lad dem droppe food først
                        (up-set-target-object search-local c: 0)
                        (up-get-object-target-data object-data-id gl-confused-vill-target)
                    )

                    (defrule
                        (up-compare-goal gl-confused-vill-target g:!= gl-berry-group-tree)
                        (building-type-count mill < 1)
                (up-pending-objects c: mill < 1)
                (unit-type-count villager-class > 9)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-add-object-by-id search-remote g: gl-berry-group-tree)
                        (up-target-objects 0 action-default -1 -1)
                        ;(chat-to-all "retargeting berry-vill to wood")
                    )

                    (defrule
                    (building-type-count mill < 1)
                (up-pending-objects c: mill < 1)
                (unit-type-count villager-class > 9)
                        (up-compare-goal gl-confused-vill-loop-counter <= 5)
                        =>
                        (up-modify-goal gl-confused-vill-loop-counter c:+ 1)
                        (up-jump-rule -3)
                    )
        ;1 Decide when to build mill
            (defrule
                            (unit-type-count villager >= 12)
                            (can-afford-building mill)
                            (building-type-count-total mill < 1)
                            (up-compare-goal gl-building-system == build-line-system)
                                =>
                            (set-goal gl-build-first-mill YES)
                            )
        ;2 Send builder to mill

                    (defrule
                        (unit-type-count villager >= 13)
                        (building-type-count mill == 0)
                        (up-pending-objects c: mill == 1)
                    =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != berry-group) 
                        (up-filter-status c: status-pending c: list-active)
                        (set-strategic-number sn-focus-player-number my-player-number)
                        (up-find-status-remote c: mill c: 1)
                        (up-remove-objects search-local object-data-index != 0)
                        (up-remove-objects search-local object-data-target == building-class)
                        (up-target-objects 0 action-default -1 -1)
                        
                        ;(disable-self)
                    )

                    (defrule
                    (up-pending-objects c: mill > 0)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != berry-group)
                    (up-set-target-point gl-mill-location-x)
                    (up-remove-objects search-local object-data-target == building-class)
                    (up-remove-objects search-local object-data-target == 907) ;bushes
                    (up-remove-objects search-local object-data-carry != 0)
                    )

                    (defrule
                        (up-pending-objects c: mill > 0)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-target-point gl-temp-x action-stop -1 -1)
                        ;(disable-self)
                    )

                    (defrule
                    (up-pending-objects c: mill > 0)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != berry-group)
                    (up-remove-objects search-local object-data-carry < 6)
                    (set-strategic-number sn-focus-player-number my-player-number)
                    (up-filter-status c: status-pending c: list-active)
                    (up-find-status-remote c: mill c: 1)
                    
                    )

                    (defrule
                        (up-pending-objects c: mill > 0)
                        (up-set-target-object search-local c: 0)
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-get-point position-object gl-temp-x)
                        (up-set-target-point gl-temp-x)
                        (up-remove-objects search-local object-data-distance >= 6)
                        (up-get-point position-self gl-temp-x)
                        (up-set-target-point gl-temp-x)
                        (up-remove-objects search-local object-data-distance < 6)
                    )

                    (defrule
                        (up-pending-objects c: mill > 0)
                        (up-set-target-object search-local c: 0)
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-target-objects 0 action-default -1 -1)
                        ;(chat-to-all "force vill on unbuild mill")
                        (disable-self)
                    )

                    (defrule
                    (building-type-count mill > 0)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != berry-group)
                    (up-remove-objects search-local object-data-carry < 10)
                    (up-remove-objects search-local object-data-index != 0)
                    (up-get-point position-self gl-temp-x)
                    )

                    (defrule
                        (building-type-count mill > 0)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-data object-data-move-x gl-temp1-x)
                        (up-get-object-data object-data-move-y gl-temp1-y)
                    )

                    (defrule
                        (building-type-count mill > 0)
                        (up-set-target-object search-local c: 0)
                        (up-point-distance gl-temp-x gl-temp1-x < 5)
                        =>
                        (up-target-point gl-temp-x action-stop -1 -1)
                        ;(chat-to-all "stop berry will from walking to tc")
                        (disable-self)
                    )

        ;3 set gather point

            (defrule
                (unit-type-count villager == 12) 
                =>
                (enable-timer berry-gather-timer 21) ; pga villager garrison code
                (disable-self)
            )

            (defrule
                (unit-type-count villager == 14) 
                =>
                (enable-timer berry-gather-timer 21) ; pga villager garrison code
                (disable-self)
            )

            (defrule
                (unit-type-count villager == 15) 
                =>
                (enable-timer berry-gather-timer 21) ; pga villager garrison code
                (disable-self)
            )

            (defrule
                (unit-type-count villager == 16) 
                =>
                (enable-timer berry-gather-timer 21) ; pga villager garrison code
                (disable-self)
            )

            (defrule
                (unit-type-count villager == 17) 
                =>
                (enable-timer berry-gather-timer 21) ; pga villager garrison code
                (disable-self)
            )

            (defrule
            (timer-triggered berry-gather-timer)
                =>
                (up-full-reset-search)
                (up-find-local c: town-center c: 1)
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-get-point position-center gl-center-x)
                (up-set-target-point gl-position-self-x)
                (up-filter-distance c: 0 c: 20)
                (up-filter-status c: status-resource c: list-active)
                (up-find-resource c: food c: 200)
                (up-clean-search search-remote object-data-distance search-order-asc)
                ;(up-remove-objects search-remote object-data-index < 2)
                (up-set-target-object search-remote c: 0)
                (up-get-point position-object gl-first-berry-bush-x)
                (up-set-target-point gl-first-berry-bush-x)

                ;;(up-send-flare gl-first-berry-bush-x)
            ;(up-target-objects 0 action-gather -1 -1) ;fjernet for forsimpling
            (disable-timer berry-gather-timer)
            ; (disable-self)
            )

            

            

        ;4 Retasking idle forragers
            ;
            ;1 Find location of bushes in relation to mill

                ;Algoritme til at finde masse-midtpunkt:
                ; 1 Lav søgning på alle mines inden for 4 tiles af mining camp og gem remote-total i gl-temp1. Sæt gl-temp2 til 0


                (defrule
                    (building-type-count-total mill > 0)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: mill c: 1)(up-filter-status c: status-pending c: list-active)(up-find-status-local c: mill c: 1)
                    
                    
                )

                (defrule
                    (building-type-count-total mill > 0)
                    (up-set-target-object search-local c: 0)
                    =>
                    (set-strategic-number sn-target-point-adjustment 6)
                    (up-get-object-data object-data-precise-x gl-temp3-x) ;coordinate * 100
                    (up-get-object-data object-data-precise-y gl-temp3-y)
                    (up-set-precise-target-point gl-temp3-x) ;should work
                    ;;;;;;(up-chat-data-to-all "gl-temp3-x is %d." g: gl-temp3-x)
                    ;;;;;;(up-chat-data-to-all "gl-temp3-x is %d." g: gl-temp3-y)
                    ;(up-get-point position-point gl-temp3-x)
                    ;;;;;(up-chat-data-to-all "gl-temp3-x is %d." g: gl-temp3-x)
                    ;;;;;(up-chat-data-to-all "gl-temp3-x is %d." g: gl-temp3-y)
                    ;(chat-to-all "found mill")
                )



                (defrule ;søg efter mines
                    (building-type-count-total mill > 0)
                    =>
                    (up-full-reset-search)
                    (set-strategic-number sn-target-point-adjustment 5)
                    (up-find-local c: mill c: 1)
                    (up-filter-status c: status-pending c: list-active)
                    (up-find-status-local c: mill c: 1)
                    (up-get-point position-object gl-temp1-x)
                    (up-set-target-point gl-temp1-x)
                    (up-filter-distance c: -1 c: 5)   ; virker ikke med precise point?
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: food c: 30)
                    
                )

                (defrule ;søg efter mines
                    (building-type-count-total mill > 0)
                    =>
                    
                    (up-get-search-state gl-local-total)
                    (set-strategic-number sn-target-point-adjustment 6)
                    (up-clean-search search-remote object-data-precise-distance search-order-asc)
                    (up-modify-goal gl-temp1 g:= gl-remote-total) ; gl-temp1 = antal mines omkring mining camp
                    ;;;;;(up-chat-data-to-all "number of found mines is %d." g: gl-temp1)
                    (set-goal gl-temp1-x 0)
                    (set-goal gl-temp1-y 0)
                )

                ; 3 Sæt første mine som target object og få dennes præcise koordinater. Læg disse til temp1-x og y.

                (defrule
                    (building-type-count-total mill > 0)
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-get-object-data object-data-precise-x gl-temp2-x) ;coordinate * 100
                    (up-get-object-data object-data-precise-y gl-temp2-y)
                    (up-modify-goal gl-temp1-x g:+ gl-temp2-x)
                    (up-modify-goal gl-temp1-y g:+ gl-temp2-y)
                    ;;;;;(up-chat-data-to-all "gl-temp1-x is %d." g: gl-temp1-x)
                    ;;;;;(up-chat-data-to-all "gl-temp1-y is %d." g: gl-temp1-y)
                    (up-get-search-state gl-local-total)
                )

                ; 4 Loop punkt nr 3 til der ikke er flere search results.

                (defrule
                    (up-compare-goal gl-remote-total > 0)
                    (building-type-count-total mill > 0)
                    =>
                    (up-remove-objects search-remote object-data-index == 0)
                    (up-get-search-state gl-local-total)
                    (up-jump-rule -2)
                )

                ; 5 Find gl-temp-x / gl-temp1

                (defrule
                    (building-type-count-total mill > 0)
                    =>
                    (up-modify-goal gl-temp1-x g:/ gl-temp1) ; finder gennemsnitskoordinaten
                    (up-modify-goal gl-temp1-y g:/ gl-temp1)
                    ;;;;;(up-chat-data-to-all "number of found mines is %d." g: gl-temp1)
                    ;;;;;(up-chat-data-to-all "average x is %d." g: gl-temp1-x)
                    ;;;;;(up-chat-data-to-all "average y is %d." g: gl-temp1-y)
                )

                ; 6 Evt. omregning til normale coordinatvalues. Sæt precise-target-point som gl-temp-2.
                ; (7) Sæt tc gather point for at sikre du har fundet det rigtige punkt.



                (defrule ; tjeck - virker
                    (building-type-count-total mill > 0)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: town-center c: 1)
                    ;(up-modify-goal gl-temp3-x c:/ 100)
                    ;(up-modify-goal gl-temp3-y c:/ 100)
                    
                    ;(up-target-point gl-temp1-x action-gather -1 -1)
                    (up-copy-point gl-point-x gl-temp1-x)
                )






                (defrule ;starting lokation program
                                    (up-compare-goal gl-point-x != -1)
                                    =>
                                    (up-modify-goal gl-point-numeric-x c:= 0)
                                (up-modify-goal gl-point-numeric-y c:= 0)
                                ;gl-temp3-x i stedet for position-self-x
                                )

                                (defrule
                                    (up-compare-goal gl-point-x != -1) 
                                    =>
                                    (up-modify-goal gl-point-numeric-x g:+ gl-temp3-x)
                                    (up-modify-goal gl-point-numeric-x g:- gl-point-x)
                                    ;(disable-self)
                                )

                                (defrule
                                    (up-compare-goal gl-point-numeric-x < 0)
                                    (up-compare-goal gl-point-x != -1)
                                    =>
                                    (up-modify-goal gl-point-numeric-x g:neg gl-point-numeric-x)
                                    ;(disable-self)
                                )


                                (defrule
                                    (up-compare-goal gl-point-y != -1)
                                    =>
                                    (up-modify-goal gl-point-numeric-y g:+ gl-temp3-y)
                                    (up-modify-goal gl-point-numeric-y g:- gl-point-y)
                                    ;(disable-self)
                                )

                                (defrule
                                    (up-compare-goal gl-point-numeric-y < 0)
                                    (up-compare-goal gl-point-y != -1)
                                    =>
                                    (up-modify-goal gl-point-numeric-y g:neg gl-point-numeric-y)
                                    ;(disable-self)
                                )

                                (defrule
                                    (up-compare-goal gl-point-y g:< gl-temp3-y)
                                    (up-compare-goal gl-point-numeric-y g:>= gl-point-numeric-x)
                                    (up-compare-goal gl-point-x != -1)
                                    =>
                                    (set-goal gl-point-relation-to-tc upper-left-quadrant)
                                    ;(;;;chat-to-all "point is in upper left quadrant")
                                    ;(disable-self)
                                )

                                (defrule
                                    (up-compare-goal gl-point-y g:>= gl-temp3-y)
                                    (up-compare-goal gl-point-numeric-y g:>= gl-point-numeric-x)
                                    (up-compare-goal gl-point-x != -1)
                                    =>
                                    (set-goal gl-point-relation-to-tc lower-right-quadrant)
                                    ;(;;chat-to-all "point is in lower right quadrant")
                                    ;(disable-self)
                                )

                                (defrule
                                    (up-compare-goal gl-point-x g:>= gl-temp3-x)
                                    (up-compare-goal gl-point-numeric-x g:>= gl-point-numeric-y)
                                    (up-compare-goal gl-point-x != -1)
                                    =>
                                    (set-goal gl-point-relation-to-tc upper-right-quadrant)
                                    ;(;;chat-to-all "point is in upper right quadrant")
                                    ;(disable-self)
                                )

                                (defrule
                                    (up-compare-goal gl-point-x g:< gl-temp3-x)
                                    (up-compare-goal gl-point-numeric-x g:>= gl-point-numeric-y)
                                    (up-compare-goal gl-point-x != -1)
                                    =>
                                    (set-goal gl-point-relation-to-tc lower-left-quadrant)
                                    ;(;;chat-to-all "point is in lower left quadrant")
                                    ;(disable-self)
                                )
                                
                                    (defrule ;needs to be reset in the main script
                                    (up-compare-goal gl-point-relation-to-tc != -1)
                                    (up-compare-goal gl-point-x != -1)
                                    (building-type-count-total mill > 0)
                                                    =>
                                    (up-copy-point gl-bush-relation-to-mill gl-point-relation-to-tc)
                                    ;(;;chat-to-all "rule is running 1")
                                    (disable-self)
                                    )

                                    (defrule ;needs to be reset in the main script
                                    (up-compare-goal gl-point-relation-to-tc != -1)
                                    (up-compare-goal gl-point-x != -1)
                                    =>
                                    (set-goal gl-point-x -1)
                                    ;(disable-self) ; ellers larmer den
                                    )





                                    (defrule
                                        (up-compare-goal gl-bush-relation-to-mill != -1)
                                        =>
                                        ;;;;;(up-chat-data-to-all "gl-bush-relation-to-mill is %d." g: gl-bush-relation-to-mill)
                                    (do-nothing)
                                    )






            ;2 find bushes with 1 side facing mill and task 1 vill to each
                ; lav en søgning på alle de nærmeste under 40 træer for lc'en og sæt dem i rækkefølge efter afstand til lc.
                            
                                (defrule
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    =>
                                    (up-full-reset-search)
                                    (set-strategic-number sn-target-point-adjustment 5)
                                    (up-find-local c: mill c: 1)(up-filter-status c: status-pending c: list-active)(up-find-status-local c: mill c: 1)
                                    (up-set-target-object search-local c: 0)
                                    (up-get-point position-object gl-temp1-x)
                                    (up-set-target-point gl-temp1-x)
                                    (up-filter-distance c: -1 c: 4)   ; virker ikke med precise point?
                                    (up-filter-status c: status-resource c: list-active)
                                    (up-find-resource c: food c: 30)
                                    (up-clean-search search-remote object-data-distance search-order-asc)
                                    (set-goal gl-trees-checked 0)
                                    (up-get-search-state gl-local-total)
                                    ;;(up-chat-data-to-player my-player-number "Number of close mines is %d." g: gl-remote-total)
                                )
                            
                ; tjeck hvert træ for om mindst 1 omgivende tile er fri via loop.(kræver 2 wood til palisade) resten fjernes
                            
                                (defrule ; punktet findes 1 gang for hvert træ
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-remote g: gl-trees-checked)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    ;(up-modify-goal gl-tiles-checked c:= 0)
                                    (up-modify-goal gl-blocked-spots c:= 0)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-left-quadrant)
                                    ;(up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-left-quadrant)
                                    ;(up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-right-quadrant)
                                    ;(up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-right-quadrant)
                                    ;(up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:- 1)
                                )

                                (defrule ; tæller hvis en tile er blocked
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (not(and(up-can-build-line 0 gl-position-self-x c: palisade-wall) 
                                        (can-afford-building palisade-wall)))
                                    =>
                                    (up-modify-goal gl-blocked-spots c:+ 1)
                                    ;;(up-chat-data-to-player my-player-number "This tree has %d. blocked spots" g: gl-blocked-spots)
                                )


                                (defrule ; fjerner uegnede træer fra listen
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-blocked-spots > 0)
                                    =>
                                    (up-get-search-state gl-local-total)
                                    ;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                    ;;(up-chat-data-to-player my-player-number "gl-trees-checked before removal is %d. " g: gl-trees-checked)
                                    (up-remove-objects search-remote object-data-index g:== gl-trees-checked) ; fjerner tilsyneladende ikke træet?
                                    (up-get-search-state gl-local-total)
                                    ;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                    (up-modify-goal gl-trees-checked c:- 1)
                                    ;;(chat-to-player my-player-number "removing bad tree from search")
                                )

                                (defrule ; 2 regler der genstarter loop efter alle træer er undersøgt
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    =>
                                    (up-get-search-state gl-local-total)
                                    ;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                    (up-modify-goal gl-remote-total c:- 1) ; fordi indexet starter i 0
                                    ;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                )

                                (defrule 
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-trees-checked g:< gl-remote-total)
                                    =>
                                    (up-modify-goal gl-trees-checked c:+ 1)
                                    (up-jump-rule -9)
                                    ;(disable-self) ; chrash prevention
                                )

                                (defrule
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    =>
                                    (up-get-search-state gl-local-total)
                                    ;;(up-chat-data-to-player my-player-number "Number of close suitable mines is %d." g: gl-remote-total)
                                )

                ; Tjeck hver villager for om deres target via loop og fjern hvert pass et træ hvis det har en vill på.

                                ; Sender idle vills i første tree-group til de rigtige træer. Virker kun 1 gange per pass grundet task-count
                                
                                (defrule
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                            =>
                                            (set-goal gl-confused-vill-loop-counter 0)
                                            (set-goal gl-confused-vill-target -2)
                                            (set-goal gl-suitable-tree -1)
                                            (up-reset-filters)
                                        )


                                        (defrule ;vælger en vill ad gangen og finder dennes target
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-remote c: 0)
                                    (goal gl-wait-for-next-pass -1)
                                                                    =>
                                            (up-get-object-data object-data-tasks-count gl-tasks-count)
                                            (up-reset-search 1 1 0 0) ; reset local list
                                    (up-find-local c: villager-class c: 200)
                                    (up-remove-objects search-local object-data-group-flag != berry-group) ; virker ikke
                                            (up-clean-search search-local object-data-id search-order-asc)
                                            (up-remove-objects search-local object-data-index g:!= gl-confused-vill-loop-counter)
                                        ) 
                                            
                                    (defrule
                                        (up-set-target-object search-local c: 0)
                                        ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (goal gl-wait-for-next-pass -1)
                                        =>
                                        (up-get-object-target-data object-data-id gl-confused-vill-target)
                                            (up-remove-objects search-remote object-data-tasks-count >= 1) 
                                    )
                                            
                                    (defrule ; tjekker om der er et træ uden vills på og gemmer dets ID
                                        ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-remote c: 0) 
                                    (goal gl-wait-for-next-pass -1)
                                        =>
                                        (up-get-object-data object-data-id gl-suitable-tree)
                                            (up-remove-objects search-local object-data-idling c:!= 1) ; 
                                        )
                                    
                                        (defrule ; tjekker om den fundne vill er idle og klikker ham på træet
                                            (up-compare-goal gl-confused-vill-target g:!= gl-suitable-tree)
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (goal gl-wait-for-next-pass -1)
                                    (up-set-target-object search-local c: 0)
                                    (up-set-target-object search-remote c: 0) 
                                    
                                            =>
                                            (up-target-objects 0 action-default -1 -1)
                                            (set-goal gl-suitable-tree -1)
                                            (set-goal gl-wait-for-next-pass 1) ; giver lidt idle time men en flottere fordeling. Kan evt fjernes
                                        )
                                    
                                        (defrule
                                            (up-compare-goal gl-confused-vill-loop-counter <= 20)
                                            (building-type-count-total mill > 0)
                                            (wood-amount >= 2)
                                            (goal gl-wait-for-next-pass -1)
                                            =>
                                            (up-modify-goal gl-confused-vill-loop-counter c:+ 1)
                                            (up-jump-rule -5)
                                        )

                                        

            ;3 find bushes with 1 side facing mill and 1-2 sides perpendicular to mill task 1 extra vill to each
                ; lav en søgning på alle de nærmeste under 40 træer for lc'en og sæt dem i rækkefølge efter afstand til lc.
                            
                                (defrule
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    =>
                                    (up-full-reset-search)
                                    (set-strategic-number sn-target-point-adjustment 5)
                                    (up-find-local c: mill c: 1)(up-filter-status c: status-pending c: list-active)(up-find-status-local c: mill c: 1)
                                    (up-set-target-object search-local c: 0)
                                    (up-get-point position-object gl-temp1-x)
                                    (up-set-target-point gl-temp1-x)
                                    (up-filter-distance c: -1 c: 4)   ; virker ikke med precise point?
                                    (up-filter-status c: status-resource c: list-active)
                                    (up-find-resource c: food c: 30)
                                    (up-clean-search search-remote object-data-distance search-order-asc)
                                    (set-goal gl-trees-checked 0)
                                    (up-get-search-state gl-local-total)
                                    ;;(up-chat-data-to-player my-player-number "Number of close mines is %d." g: gl-remote-total)
                                )
                            
                ; tjeck hvert træ for om mindst 1 omgivende tile er fri via loop.(kræver 2 wood til palisade) resten fjernes
                            
                                (defrule ; punktet findes 1 gang for hvert træ
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-remote g: gl-trees-checked)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-tiles-checked c:= 0)
                                    (up-modify-goal gl-blocked-spots c:= 0)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 1)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 2)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 1)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 2)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 1)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 2)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 1)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 2)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:+ 1)
                                )

                                (defrule ; tæller hvis en tile er blocked
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (not(and(up-can-build-line 0 gl-position-self-x c: palisade-wall) 
                                        (can-afford-building palisade-wall)))
                                    (up-compare-goal gl-tiles-checked c:== 0)    
                                    =>
                                    (up-modify-goal gl-blocked-spots c:+ 2)
                                    ;;;(up-chat-data-to-player my-player-number "This tree has %d. blocked spots" g: gl-blocked-spots)
                                )

                                (defrule ; tæller hvis en tile er blocked
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (not(and(up-can-build-line 0 gl-position-self-x c: palisade-wall) 
                                        (can-afford-building palisade-wall)))
                                        (up-compare-goal gl-tiles-checked c:> 0) 
                                    =>
                                    (up-modify-goal gl-blocked-spots c:+ 1)
                                    ;;;(up-chat-data-to-player my-player-number "This tree has %d. blocked spots" g: gl-blocked-spots)
                                )

                                (defrule ; genstarter lille loop indtil alle 4 tiles er tjekket
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-tiles-checked < 2)
                                    =>
                                    (up-modify-goal gl-tiles-checked c:+ 1)
                                    (up-jump-rule -15)
                                )


                                (defrule ; fjerner uegnede træer fra listen
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-blocked-spots > 1)
                                    =>
                                    (up-get-search-state gl-local-total)
                                    ;;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                    ;;;(up-chat-data-to-player my-player-number "gl-trees-checked before removal is %d. " g: gl-trees-checked)
                                    (up-remove-objects search-remote object-data-index g:== gl-trees-checked) ; fjerner tilsyneladende ikke træet?
                                    (up-get-search-state gl-local-total)
                                    ;;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                    (up-modify-goal gl-trees-checked c:- 1)
                                    ;;(chat-to-player my-player-number "removing bad tree from search")
                                )

                                (defrule ; 2 regler der genstarter loop efter alle træer er undersøgt
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    =>
                                    (up-get-search-state gl-local-total)
                                    ;;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                    (up-modify-goal gl-remote-total c:- 1) ; fordi indexet starter i 0
                                    ;;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                )

                                (defrule 
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-trees-checked g:< gl-remote-total)
                                    =>
                                    (up-modify-goal gl-trees-checked c:+ 1)
                                    (up-jump-rule -19)
                                    ;(disable-self) ; chrash prevention
                                )

                                (defrule
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    =>
                                    (up-get-search-state gl-local-total)
                                    ;;(up-chat-data-to-player my-player-number "Number of close suitable mines after 3. rule is %d." g: gl-remote-total)
                                )

                ; Tjeck hver villager for om deres target via loop og fjern hvert pass et træ hvis det har en vill på.

                                ; Sender idle vills i første tree-group til de rigtige træer. Virker kun 1 gange per pass grundet task-count
                                
                                (defrule
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                            =>
                                            (set-goal gl-confused-vill-loop-counter 0)
                                            (set-goal gl-confused-vill-target -2)
                                            (set-goal gl-suitable-tree -1)
                                            (up-reset-filters)
                                        )


                                        (defrule ;vælger en vill ad gangen og finder dennes target
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-remote c: 0)
                                    (goal gl-wait-for-next-pass -1)
                                                                    =>
                                            (up-get-object-data object-data-tasks-count gl-tasks-count)
                                            (up-reset-search 1 1 0 0) ; reset local list
                                    (up-find-local c: villager-class c: 200)
                                    (up-remove-objects search-local object-data-group-flag != berry-group) ; virker ikke
                                            (up-clean-search search-local object-data-id search-order-asc)
                                            (up-remove-objects search-local object-data-index g:!= gl-confused-vill-loop-counter)
                                        ) 
                                            
                                    (defrule
                                        (up-set-target-object search-local c: 0)
                                        ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (goal gl-wait-for-next-pass -1)
                                        =>
                                        (up-get-object-target-data object-data-id gl-confused-vill-target)
                                            (up-remove-objects search-remote object-data-tasks-count >= 4) 
                                    )
                                            
                                    (defrule ; tjekker om der er et træ uden vills på og gemmer dets ID
                                        ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-remote c: 0) 
                                    (goal gl-wait-for-next-pass -1)
                                        =>
                                        (up-get-object-data object-data-id gl-suitable-tree)
                                            (up-remove-objects search-local object-data-idling c:!= 1) ; 
                                        )
                                    
                                        (defrule ; tjekker om den fundne vill er idle og klikker ham på træet
                                            (up-compare-goal gl-confused-vill-target g:!= gl-suitable-tree)
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-local c: 0)
                                    (up-set-target-object search-remote c: 0) 
                                    (goal gl-wait-for-next-pass -1)
                                            =>
                                            (up-target-objects 0 action-default -1 -1)
                                            (set-goal gl-suitable-tree -1)
                                            (set-goal gl-wait-for-next-pass 1) ; giver lidt idle time men en flottere fordeling. Kan evt fjernes
                                        )
                                    
                                        (defrule
                                            (up-compare-goal gl-confused-vill-loop-counter <= 20)
                                            (building-type-count-total mill > 0)
                                            (wood-amount >= 2)
                                            (goal gl-wait-for-next-pass -1)
                                            =>
                                            (up-modify-goal gl-confused-vill-loop-counter c:+ 1)
                                            (up-jump-rule -5)
                                        )

                                        
                        

            ;4 find bushes with 0 sides facing mill and 1-2 sides perpendicular to mill and task 1 vill to each
                ; lav en søgning på alle de nærmeste under 40 træer for lc'en og sæt dem i rækkefølge efter afstand til lc.
                            
                                (defrule
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    =>
                                    (up-full-reset-search)
                                    (set-strategic-number sn-target-point-adjustment 5)
                                    (up-find-local c: mill c: 1)(up-filter-status c: status-pending c: list-active)(up-find-status-local c: mill c: 1)
                                    (up-set-target-object search-local c: 0)
                                    (up-get-point position-object gl-temp1-x)
                                    (up-set-target-point gl-temp1-x)
                                    (up-filter-distance c: -1 c: 4)   ; virker ikke med precise point?
                                    (up-filter-status c: status-resource c: list-active)
                                    (up-find-resource c: food c: 30)
                                    (up-clean-search search-remote object-data-distance search-order-asc)
                                    (set-goal gl-trees-checked 0)
                                    (up-get-search-state gl-local-total)
                                    ;;(up-chat-data-to-player my-player-number "Number of close mines is %d." g: gl-remote-total)
                                )
                            
                ; tjeck hvert træ for om mindst 1 omgivende tile er fri via loop.(kræver 2 wood til palisade) resten fjernes
                            
                                (defrule ; punktet findes 1 gang for hvert træ
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-remote g: gl-trees-checked)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-tiles-checked c:= 0)
                                    (up-modify-goal gl-blocked-spots c:= 0)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 1)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 2)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 1)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-left-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 2)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 1)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == upper-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 2)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:+ 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 0)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-y c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 1)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:- 1)
                                )

                                (defrule ; Vi undersøger først mines med 1 side mod mining camp
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-bush-relation-to-mill == lower-right-quadrant)
                                    (up-compare-goal gl-tiles-checked c:== 2)
                                    =>
                                    (up-get-point position-object gl-position-self-x)
                                    (up-modify-goal gl-position-self-x c:+ 1)
                                )

                                (defrule ; tæller hvis en tile er blocked
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (and(up-can-build-line 0 gl-position-self-x c: palisade-wall) 
                                        (can-afford-building palisade-wall))
                                    (up-compare-goal gl-tiles-checked c:== 0)    
                                    =>
                                    (up-modify-goal gl-blocked-spots c:+ 99)
                                    ;;;(up-chat-data-to-player my-player-number "This tree has %d. blocked spots" g: gl-blocked-spots)
                                )

                                (defrule ; tæller hvis en tile er blocked
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (not(and(up-can-build-line 0 gl-position-self-x c: palisade-wall) 
                                        (can-afford-building palisade-wall)))
                                        (up-compare-goal gl-tiles-checked > 0) 
                                    =>
                                    (up-modify-goal gl-blocked-spots c:+ 1)
                                    ;;;(up-chat-data-to-player my-player-number "This tree has %d. blocked spots" g: gl-blocked-spots)
                                )

                                (defrule ; genstarter lille loop indtil alle 4 tiles er tjekket
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-tiles-checked < 2)
                                    =>
                                    (up-modify-goal gl-tiles-checked c:+ 1)
                                    (up-jump-rule -15)
                                )


                                (defrule ; fjerner uegnede træer fra listen
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-blocked-spots > 1)
                                    =>
                                    (up-get-search-state gl-local-total)
                                    ;;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                    ;;;(up-chat-data-to-player my-player-number "gl-trees-checked before removal is %d. " g: gl-trees-checked)
                                    (up-remove-objects search-remote object-data-index g:== gl-trees-checked) ; fjerner tilsyneladende ikke træet?
                                    (up-get-search-state gl-local-total)
                                    ;;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                    (up-modify-goal gl-trees-checked c:- 1)
                                    ;;(chat-to-player my-player-number "removing bad tree from search")
                                )

                                (defrule ; 2 regler der genstarter loop efter alle træer er undersøgt
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    =>
                                    (up-get-search-state gl-local-total)
                                    ;;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                    (up-modify-goal gl-remote-total c:- 1) ; fordi indexet starter i 0
                                    ;;;(up-chat-data-to-player my-player-number "gl-remote-total is %d. " g: gl-remote-total)
                                )

                                (defrule 
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-compare-goal gl-trees-checked g:< gl-remote-total)
                                    =>
                                    (up-modify-goal gl-trees-checked c:+ 1)
                                    (up-jump-rule -19)
                                    ;(disable-self) ; chrash prevention
                                )

                                (defrule
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    =>
                                    (up-get-search-state gl-local-total)
                                    ;;(up-chat-data-to-player my-player-number "Number of close suitable mines after 3. rule is %d." g: gl-remote-total)
                                )

                ; Tjeck hver villager for om deres target via loop og fjern hvert pass et træ hvis det har en vill på.

                                ; Sender idle vills i første tree-group til de rigtige træer. Virker kun 1 gange per pass grundet task-count
                                
                                (defrule
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                            =>
                                            (set-goal gl-confused-vill-loop-counter 0)
                                            (set-goal gl-confused-vill-target -2)
                                            (set-goal gl-suitable-tree -1)
                                            (up-reset-filters)
                                        )


                                        (defrule ;vælger en vill ad gangen og finder dennes target
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-remote c: 0)
                                    (goal gl-wait-for-next-pass -1)
                                                                    =>
                                            (up-get-object-data object-data-tasks-count gl-tasks-count)
                                            (up-reset-search 1 1 0 0) ; reset local list
                                    (up-find-local c: villager-class c: 200)
                                    (up-remove-objects search-local object-data-group-flag != berry-group) ; virker ikke
                                            (up-clean-search search-local object-data-id search-order-asc)
                                            (up-remove-objects search-local object-data-index g:!= gl-confused-vill-loop-counter)
                                        ) 
                                            
                                    (defrule
                                        (up-set-target-object search-local c: 0)
                                        ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (goal gl-wait-for-next-pass -1)
                                        =>
                                        (up-get-object-target-data object-data-id gl-confused-vill-target)
                                            (up-remove-objects search-remote object-data-tasks-count >= 1) 
                                    )
                                            
                                    (defrule ; tjekker om der er et træ uden vills på og gemmer dets ID
                                        ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-remote c: 0) 
                                    (goal gl-wait-for-next-pass -1)
                                        =>
                                        (up-get-object-data object-data-id gl-suitable-tree)
                                            (up-remove-objects search-local object-data-idling c:!= 1) ; 
                                        )
                                    
                                        (defrule ; tjekker om den fundne vill er idle og klikker ham på træet
                                            (up-compare-goal gl-confused-vill-target g:!= gl-suitable-tree)
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-local c: 0)
                                    (up-set-target-object search-remote c: 0) 
                                    (goal gl-wait-for-next-pass -1)
                                            =>
                                            (up-target-objects 0 action-default -1 -1)
                                            (set-goal gl-suitable-tree -1)
                                            (set-goal gl-wait-for-next-pass 1) ; giver lidt idle time men en flottere fordeling. Kan evt fjernes
                                        )
                                    
                                        (defrule
                                            (up-compare-goal gl-confused-vill-loop-counter <= 20)
                                            (building-type-count-total mill > 0)
                                            (wood-amount >= 2)
                                            (goal gl-wait-for-next-pass -1)
                                            =>
                                            (up-modify-goal gl-confused-vill-loop-counter c:+ 1)
                                            (up-jump-rule -5)
                                        )

                                        
                        
                        
            ;5 Tasking vills on remaining bushes, including far bushes
                ; lav en søgning på alle de nærmeste under 40 træer for lc'en og sæt dem i rækkefølge efter afstand til lc.
                            
                                (defrule
                                    ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    =>
                                    (up-full-reset-search)
                                    (set-strategic-number sn-target-point-adjustment 5)
                                    (up-find-local c: mill c: 1)(up-filter-status c: status-pending c: list-active)(up-find-status-local c: mill c: 1)
                                    (up-set-target-object search-local c: 0)
                                    (up-get-point position-object gl-temp1-x)
                                    (up-set-target-point gl-temp1-x)
                                    (up-filter-distance c: -1 c: 6)   ; virker ikke med precise point?
                                    (up-filter-status c: status-resource c: list-active)
                                    (up-find-resource c: food c: 30)
                                    (up-clean-search search-remote object-data-distance search-order-asc)
                                    (set-goal gl-trees-checked 0)
                                    (up-get-search-state gl-local-total)
                                    ;;(up-chat-data-to-player my-player-number "Number of close mines is %d." g: gl-remote-total)
                                )
                            
                ; Tjeck hver villager for om deres target via loop og fjern hvert pass et træ hvis det har en vill på.

                                ; Sender idle vills i første tree-group til de rigtige træer. Virker kun 1 gange per pass grundet task-count
                                
                                (defrule
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                            =>
                                            (set-goal gl-confused-vill-loop-counter 0)
                                            (set-goal gl-confused-vill-target -2)
                                            (set-goal gl-suitable-tree -1)
                                            (up-reset-filters)
                                        )


                                        (defrule ;vælger en vill ad gangen og finder dennes target
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-remote c: 0)
                                    (goal gl-wait-for-next-pass -1)
                                                                    =>
                                            (up-get-object-data object-data-tasks-count gl-tasks-count)
                                            (up-reset-search 1 1 0 0) ; reset local list
                                    (up-find-local c: villager-class c: 200)
                                    (up-remove-objects search-local object-data-group-flag != berry-group) ; virker ikke
                                            (up-clean-search search-local object-data-id search-order-asc)
                                            (up-remove-objects search-local object-data-index g:!= gl-confused-vill-loop-counter)
                                        ) 
                                            
                                    (defrule
                                        (up-set-target-object search-local c: 0)
                                        ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (goal gl-wait-for-next-pass -1)
                                        =>
                                        (up-get-object-target-data object-data-id gl-confused-vill-target)
                                            (up-remove-objects search-remote object-data-tasks-count >= 4) 
                                    )
                                            
                                    (defrule ; tjekker om der er et træ uden vills på og gemmer dets ID
                                        ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (up-set-target-object search-remote c: 0) 
                                    (goal gl-wait-for-next-pass -1)
                                        =>
                                        (up-get-object-data object-data-id gl-suitable-tree)
                                            (up-remove-objects search-local object-data-idling c:!= 1) ; 
                                        )
                                    
                                        (defrule ; tjekker om den fundne vill er idle og klikker ham på træet
                                            (up-compare-goal gl-confused-vill-target g:!= gl-suitable-tree)
                                            ;(building-type-count lumber-camp > 0)
                                    (building-type-count-total mill > 0)
                                    (wood-amount >= 2)
                                    (goal gl-wait-for-next-pass -1)
                                    (up-set-target-object search-local c: 0)
                                    (up-set-target-object search-remote c: 0) 
                                    
                                            =>
                                            (up-target-objects 0 action-default -1 -1)
                                            (set-goal gl-suitable-tree -1)
                                            (set-goal gl-wait-for-next-pass 1) ; giver lidt idle time men en flottere fordeling. Kan evt fjernes
                                        )
                                    
                                        (defrule
                                            (up-compare-goal gl-confused-vill-loop-counter <= 20)
                                            (building-type-count-total mill > 0)
                                            (wood-amount >= 2)
                                            (goal gl-wait-for-next-pass -1)
                                            =>
                                            (up-modify-goal gl-confused-vill-loop-counter c:+ 1)
                                            (up-jump-rule -5)
                                        )

                                        (defrule
                                            (true)
                                            =>
                                            (set-goal gl-wait-for-next-pass -1)
                                        )

                                        (defrule
                                            (true)
                                            =>
                                            (up-full-reset-search)
                                            (up-find-local c: villager-class c: 200)
                                            (up-remove-objects search-local object-data-group-flag == berry-group)
                                            (up-remove-objects search-local object-data-target != 907)
                                        )

                                        (defrule
                                            (building-type-count mining-camp > 0)
                                            =>
                                            (up-target-point gl-temp-x action-stop -1 -1)
                                        )
                                        
                
            ;6 Force berry vills back to mill after berries are empty

                            (defrule
                            (game-time > 300)
                            =>
                            (up-full-reset-search)
                            (up-get-point position-self gl-position-self-x)
                            (up-set-target-point gl-position-self-x)
                            (up-filter-distance c: 0 c: 20)
                            (up-filter-status c: status-resource c: list-active)
                            (up-find-resource c: food c: 30)
                            (up-get-search-state gl-local-total)
                            )

                            (defrule
                                (game-time > 300)
                                (up-compare-goal gl-remote-total <= 0)
                                =>
                                (up-full-reset-search)
                                (up-find-local c: villager-class c: 200)
                                (up-remove-objects search-local object-data-group-flag != berry-group)
                                (set-strategic-number sn-focus-player-number my-player-number)
                                (up-find-remote c: mill c: 2)
                                (up-clean-search search-remote object-data-id search-order-asc)
                            )

                            (defrule
                                (game-time > 300)
                                (up-compare-goal gl-remote-total <= 0)
                                (up-set-target-object search-local c: 0)
                                (up-set-target-object search-remote c: 0)
                                =>
                                (up-target-objects 0 action-default -1 -1)
                                ;(chat-to-all "Berries are empty. Forcing vills to drop off at mill")
                                (disable-self)
                            )




                            (defrule
                                (true)
                                =>
                                (up-full-reset-search)
                                (up-find-local c: villager-class c: 200)
                                (up-remove-objects search-local object-data-group-flag != berry-group)
                                (up-remove-objects search-local object-data-target != 932)
                            )

                            (defrule
                                (up-set-target-object search-local c: 0)
                                =>
                                (up-target-point gl-temp-x action-stop -1 -1)
                            )
                            


      
    ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 423 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 692 is: %d." g: 181)
