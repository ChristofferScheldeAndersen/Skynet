                    (up-modify-group-flag 1 c: first-tree-group)
                    ;(up-chat-data-to-all "first tree group had %d woodcutters. Adding one more." g: gl-local-total)
                    (set-goal gl-split-rule 0)
                    (up-jump-rule -4)
                )
                    
            ; 22-23 pop - Then gradually sending vills to stragglers        :2 shepard -> wood1 conversions
                (defrule
                    (up-compare-goal gl-fase == 2)
                    (up-compare-goal gl-temp9 >= 5)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != pre-farming-straggler-group)
                    (up-get-search-state gl-local-total)
                )

                    (defrule
                    (up-compare-goal gl-fase == 2)
                    (up-compare-goal gl-local-total <= 1)
                    (up-compare-goal gl-temp9 >= 5)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != shepard-group)
                    ;(up-remove-objects search-local object-data-hitpoints c:< 25)
                    (up-remove-objects search-local object-data-carry c:> 0)
                    (up-clean-search search-local object-data-hitpoints search-order-asc)
                    (up-remove-objects search-local object-data-index c:!= 0)

                    )

                (defrule
                    (unit-type-count villager < 30)
                    (up-compare-goal gl-fase == 2)
                    (up-compare-goal gl-local-total <= 1)
                    (or(unit-type-count villager >= 23)
                    (up-compare-goal gl-local-total <= 1))
                    (up-compare-goal gl-temp9 >= 5)
                    (up-set-target-object search-local c: 0)
                    =>
                    (set-goal gl-split-rule 99)
                )

                (defrule
                    (goal gl-split-rule 99)
                    =>
                    (up-get-object-data object-data-id gl-temp)
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != pre-farming-straggler-group)
                    (up-add-object-by-id search-local g: gl-temp)
                    (up-reset-group c: pre-farming-straggler-group)
                    (up-modify-group-flag 0 c: pre-farming-straggler-group)
                    (up-create-group 0 0 c: pre-farming-straggler-group)
                    (up-modify-group-flag 1 c: pre-farming-straggler-group)
                    ;(up-chat-data-to-all "pre farming straggler group had %d woodcutters. Adding one more." g: gl-local-total)
                    (set-goal gl-split-rule 0)
                    (up-jump-rule -4)
                )
                    
            
            #end-if
            ; 22-25 pop - Converting deer group when deers are gone         :3 deer -> straggler conversions
                (defrule
                    (taunt-detected my-player-number 6)
                    =>
                    (up-chat-data-to-all "gl-deer-luring-stage is %d." g: gl-deer-luring-stage)
                    (up-chat-data-to-all "gl-deer-eating-stage is %d." g: gl-deer-eating-stage)
                    (acknowledge-taunt my-player-number 6)
                )
                
                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != deer-group)
                    (up-get-search-state gl-local-total)
                )

                (defrule 
                    ;(goal gl-deer-luring-stage No-more-deer);midlertidigt slukket fordi sidste deer ikke blev taget. Virker med andre ord ikke.
                    (or(goal gl-deer-eating-stage No-more-deer)
                    (goal gl-deer-eating-stage No-more-deer-to-eat))
                    ;(goal gl-eating-deer -1) ; no more deer betyder bare der ikke er noget at spise
                    ; mangler et tjek af at alle deer er endegyldigt væk.
                    (up-compare-goal gl-local-total > 0)
                    (building-type-count-total farm < 11)
                    (up-compare-goal gl-no-more-berries != 1)
                    (goal gl-full-skirm-mode -1)
                    =>
                    (set-goal gl-split-rule 100)
                )

                (defrule
                    (goal gl-split-rule 100)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    
                    ;fase 1
                    (up-remove-objects search-local object-data-group-flag == shepard-group) ;1
                    (up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
                    (up-remove-objects search-local object-data-group-flag == berry-group) ;3
                    ;(up-remove-objects search-local object-data-group-flag == deer-group) ;4
                    (up-remove-objects search-local object-data-group-flag == gold-mining-group) ;5
                                
                    ;fase 2
                    (up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
                    ;(up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
                    (up-remove-objects search-local object-data-group-flag == farming-group) ;8

                    (up-reset-group c: pre-farming-straggler-group)
                    (up-modify-group-flag 0 c: pre-farming-straggler-group)
                    (up-create-group 0 0 c: pre-farming-straggler-group)
                    (up-modify-group-flag 1 c: pre-farming-straggler-group)
                    (up-get-fact population 0 gl-temp)
                    ;(up-chat-data-to-player my-player-number "Rehoboam has %d. pop. and deer are gone. Converting all deer vills to straggler-group" g: gl-temp)
                    ;(disable-self)
                )
                    

                (defrule 
                    ;(goal gl-deer-luring-stage No-more-deer);midlertidigt slukket fordi sidste deer ikke blev taget. Virker med andre ord ikke.
                    (or(goal gl-deer-eating-stage No-more-deer)
                    (goal gl-deer-eating-stage No-more-deer-to-eat))
                    ;(goal gl-eating-deer -1) ; no more deer betyder bare der ikke er noget at spise
                    ; mangler et tjek af at alle deer er endegyldigt væk.
                    (up-compare-goal gl-local-total > 0)
                    (building-type-count-total farm < 11)
                    (up-compare-goal gl-no-more-berries != 1)
                    (goal gl-full-skirm-mode 1)
                    =>
                    (set-goal gl-split-rule 101)
                )

                (defrule
                    (goal gl-split-rule 101)
                    =>
