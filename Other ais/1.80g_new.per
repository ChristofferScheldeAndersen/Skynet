                    (commodity-selling-price wood > 40)
                    (or(gold-amount <= 200)
                    (commodity-selling-price wood > 60))
                    (up-compare-goal gl-saving-wood-needed < 300)
                    =>
                    (sell-commodity wood)
                    ;(chat-to-all "selling exces wood")
                )

                (defrule
                    (or(up-research-status c: ri-paladin >= research-pending)
                    (up-research-status c: ri-savar >= research-pending))
                    (building-type-count-total castle >= 1)
                    (stone-amount >= 300)
                    (or(gold-amount <= 200)
                    (commodity-selling-price stone > 75))
                    =>
                    (sell-commodity stone)
                    ;(chat-to-all "selling exces stone")
                )

                (defrule
                    (or(up-research-status c: ri-paladin >= research-pending)
                    (up-research-status c: ri-savar >= research-pending))
                    (food-amount >= 300)
                    (commodity-selling-price food > 40)
                    (or(gold-amount <= 200)
                    (commodity-selling-price food > 60))
                    (up-compare-goal gl-saving-food-needed < 300)
                    =>
                    (sell-commodity food)
                    ;(chat-to-all "selling exces food")
                )

                (defrule
                    (up-compare-goal gl-delay-imp == 1)
                    (up-research-status c: imperial-age < research-pending)
                    (or(and(gold-amount > 200)
                    (commodity-buying-price wood <= 155))
                    (and(gold-amount > 300)
                    (commodity-buying-price wood <= 175)))
                    (wood-amount < 200)
                    =>
                    (buy-commodity wood)
                    ;(chat-to-all "buying wood for exces gold while delaying imp")
                )

                (defrule
                    (up-compare-goal gl-delay-imp == 1)
                    (up-research-status c: imperial-age < research-pending)
                    (current-age == castle-age)
                    (food-amount > 300)
                    (gold-amount < 100)
                    (can-sell-commodity food)
                    (commodity-selling-price food > 40)
                    =>
                    (sell-commodity food)
                    ;(chat-to-all "selling food for exces gold while delaying imp")
                )

                (defrule
                    (current-age == castle-age)
                    (or(up-research-status c: ri-bodkin-arrow < research-pending)
                    (up-research-status c: ri-crossbow < research-pending))
                    (food-amount > 300)
                    (gold-amount < 100)
                    (can-sell-commodity food)
                    =>
                    (sell-commodity food)
                    ;(chat-to-all "selling excess food for early archer upgrades")
                )

                (defrule
                    (current-age == castle-age)
                    (unit-type-count-total archer-line < 10)
                    (food-amount > 500)
                    (gold-amount < 100)
                    (can-sell-commodity food)
                    (building-type-count town-center < 2)
                    (commodity-selling-price food > 50)
                    =>
                    (sell-commodity food)
                    ;(chat-to-all "selling excess food for extra early archers")
                )


        ; Controling stages of fase 3
                    (defrule
                        (true)
                        =>
                        (up-get-fact building-type-count-total farm gl-calibrated-farm-count)
                    )

                    (defrule
                        (up-research-status c: ri-wheel-barrow >= research-pending)
                        =>
                        (up-modify-goal gl-calibrated-farm-count c:* 1125)
                        (up-modify-goal gl-calibrated-farm-count c:/ 1000)
                    )

                    (defrule
                        (up-research-status c: ri-heavy-plow >= research-pending)
                        =>
                        (up-modify-goal gl-calibrated-farm-count c:* 1050)
                        (up-modify-goal gl-calibrated-farm-count c:/ 1000)
                    )

                    (defrule
                        (up-research-status c: ri-hand-cart >= research-pending)
                        =>
                        (up-modify-goal gl-calibrated-farm-count c:* 1070)
                        (up-modify-goal gl-calibrated-farm-count c:/ 1000)
                    )

                    (defrule ; stage 1 - getting to 3 working tc's and 80% working stable
                        (true)            
                        =>
                        (set-goal gl-fase-3-stage 1)
                    )
                    
                    (defrule ; stage 2 - getting to 2 stable knights and getting other buildings
                        (up-compare-goal gl-calibrated-farm-count >= 25) ;farms needed to sustain 3tc's and 1 stable
                        =>
                        (set-goal gl-fase-3-stage 2)
                    )

                    (defrule ; stage 3 - making army while booming
                        (up-compare-goal gl-calibrated-farm-count >= 40) ;farms needed to sustain 3tc's and 2 stable
                        (building-type-count-total stable >= 3)
                        (building-type-count-total market >= 1)
                        (building-type-count-total monastery >= 1)
                        =>
                        (set-goal gl-fase-3-stage 3)
                    )

                    (defrule ; stage 4 - saving for imperial age
                        (up-compare-goal gl-calibrated-farm-count >= 30) ;farms needed to sustain 3tc's and 2 stable
                        (building-type-count-total stable >= 2)
                        (building-type-count-total market >= 1)
                        (building-type-count-total monastery >= 1)
                        =>
                        ;(set-goal gl-fase-3-stage 4)
                        (do-nothing)
                    )

                    (defrule ; stage 5 - transitioning to imperial age
                        (up-compare-goal gl-age-status == advancing-to-imperial)
                        =>
                        (do-nothing)
                        ;(set-goal gl-fase-3-stage 5)
                    )

                    (defrule ; stage 6 - Getting imperial upgrades
                        (current-age == imperial-age)
                        =>
                        (do-nothing)
                        ;(set-goal gl-fase-3-stage 6)
                    )

                    (defrule ; stage 7 - Post imp
                        (current-age == imperial-age)
                        =>
                        (do-nothing)
                        ;(set-goal gl-fase-3-stage 7)
                    )

                    (defrule
                        (taunt-detected my-player-number 3)
                        =>
                        (up-chat-data-to-all "gl-calibrated-farm-count is %d." g: gl-calibrated-farm-count)
                        (up-chat-data-to-all "stage is %d." g: gl-fase-3-stage)
                        (acknowledge-taunt my-player-number 3)
                    )
        ; Setting building priorities
                ; Lumber camp castle 
