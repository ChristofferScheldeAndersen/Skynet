            ; ; Sending all vills to stragglers before farm threshold is reached
                (defrule
                        (goal gl-ungrouped-vill 1)
                        (goal gl-strategy balanced-archer-skirm-rush)
                        (goal gl-full-skirm-mode -1)
                        
                        =>
                        (set-goal gl-split-rule 3012)
                )

                (defrule
                    ;(up-group-size c: gold-mining-group >= 10)
                    (goal gl-ungrouped-vill 1)
                        (goal gl-strategy balanced-archer-skirm-rush)
                        (goal gl-full-skirm-mode -1)
                        
                    =>
                    (set-goal gl-split-rule 3012)
                )

                (defrule
                    (goal gl-split-rule 3012)
                    =>
                    (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        
                        ;fase 1
                        ;(up-remove-objects search-local object-data-group-flag == shepard-group) ;1
