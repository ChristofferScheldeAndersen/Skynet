                    ;gl-temp4 - modifier for enemy skirms countering your achers
                    ;gl-temp5 - modifier for your skirms countering enemy archers
                ;Setup

                    (defrule
                    (current-age >= castle-age)
                    =>
                    (up-full-reset-search)
                    (up-set-group search-local c: 7)
                    (up-remove-objects search-local object-data-hitpoints <= 0)
