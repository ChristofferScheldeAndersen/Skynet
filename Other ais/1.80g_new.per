        ; 4 Bør vel køre de første 40 sek.



    ; Stop vills from taking wood the first second on UP
        #load-if-not-defined DE-AVAILABLE
        (defrule
                        (up-find-local c: villager-class c: 4)
                        =>
                        (up-target-point gl-temp-x action-stop -1 -1)
                        (disable-self)
                    )
        #end-if
    ; Restart DUC timer
        (defrule
        (up-timer-status DUC-timer != timer-running)
        =>
        (enable-timer DUC-timer 5)
        )
        ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 430 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 102 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                ) 
    ; Spring til dette punkt når et tick springes over.

        (defrule
            (goal gl-fase 4)
            =>
            (up-get-rule-id gl-almost-last-rule)
        )

        ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 430 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 103 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                ) 
    ; Find time stamp to compare to start of next pass (micro)

        (defrule ;Find time stamp to compare to start of next pass
            (true)
        =>
            ;(up-set-timer c: 45 c: 0)
            ;(up-get-timer c: 45 gl-temp)
            (do-nothing)
        )

    ; Testing  
        (defrule
            (game-time > 10)
            =>
            (up-full-reset-search)
            (up-find-local c: scout-cavalry-line c: 200)
            (up-find-local c: eagle-warrior-line c: 200)
            (up-target-point gl-temp-x action-none -1 stance-no-attack)
            (disable-self)
        )

        (defrule
            (or(taunt-detected my-player-number 211)
            (or(taunt-detected any-ally 211)
            (taunt-detected any-enemy 211)))
            =>
            (set-strategic-number sn-turn-off-anti-overkill 1)
        )

        (defrule
            (or(taunt-detected my-player-number 212)
            (or(taunt-detected any-ally 212)
            (taunt-detected any-enemy 212)))
            =>
            (set-strategic-number sn-turn-off-anti-overkill -1)
            (acknowledge-taunt my-player-number 211)
            (acknowledge-taunt every-ally 211)
            (acknowledge-taunt every-enemy 211)
            (acknowledge-taunt my-player-number 212)
            (acknowledge-taunt every-ally 212)
            (acknowledge-taunt every-enemy 212)
        )
        ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 430 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 104 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                ) 
    ; Retreat from enemy fortifications late game

        ;skip for pocket
            (defrule
                (up-compare-goal gl-my-position == pocket)
                (up-compare-goal gl-post-retreat-rules-id != -1)
                =>
                (up-jump-direct g: gl-post-retreat-rules-id)
            )
        ;Tc's
            ;Named temp goals
                (defconst gl-current-testing-tc 101)
                (defconst gl-maximal-testing-target 102)
                (defconst gl-first-tc-loop-rule 103)
                (defconst gl-saturation-score 104)

            ;Først findes alle enemy tc's

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (set-goal gl-current-testing-tc 0)
                    (set-strategic-number sn-focus-player-number 1)
                )

                (defrule
                    (players-stance focus-player enemy)
                    =>
                    (up-find-remote c: town-center c: 40)
                )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )
                
                (defrule
                    (true)
                    =>
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-maximal-testing-target g:= gl-remote-total)
                    (up-modify-goal gl-maximal-testing-target c:- 1)
                )

            ;Herefter startes tc loop hvor der først findes ud af om det aktuelle tc er mættet med tanky units.

                (defrule
                    (true)
                    =>
                    (up-get-rule-id gl-first-tc-loop-rule)
                    (set-goal gl-temp-x -15)
                    (set-goal gl-temp-y -15)
                    (up-set-target-point gl-temp-x)
                    (up-full-reset-search)
                    (set-strategic-number sn-focus-player-number 1)
                )

                (defrule
                    (players-stance focus-player enemy)
                    =>
                    (up-find-remote c: town-center c: 40)
                )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
