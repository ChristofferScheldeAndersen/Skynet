                    )

                    (defrule
                    (goal gl-fase 2)
                    (goal gl-strategy balanced-archer-skirm-rush)
                    (current-age == feudal-age)
                    (building-type-count-total archery-range > 0)
                    (up-compare-goal gl-local-total > 5)
                    (or(game-time > 900)
                    (up-compare-sn sn-target-player-is-going-scouts == -1))
                    (not(true))
                    =>
                    (up-remove-objects search-local object-data-index < 5)
                    (up-reset-group c: pre-farming-straggler-group)            
                    (up-modify-group-flag 0 c: pre-farming-straggler-group)
                    (up-create-group 0 0 c: pre-farming-straggler-group)
                    (up-modify-group-flag 1 c: pre-farming-straggler-group)
