                    ;hvis kriterierne er opfyldt opløses knight gruppen og en retreat timer starter på 999 sek.

                        (defrule
                            (or(and(up-compare-goal gl-temp1 >= 10)
                            (up-compare-goal gl-temp2 < 50))
                            (and(goal gl-melee-army-mode 0)
                            (up-timer-status under-attack-timer == timer-running)))
                            (strategic-number sn-keep-army-forward == -1)
                            =>
                            (up-full-reset-search)
                            (up-find-local c: knight-line c: 200)
                            (up-remove-objects search-local object-data-group-flag != knight-group)
                            (up-reset-group c: 6)
                            (up-modify-group-flag 0 c: 6)
                            (up-create-group 0 0 c: 6)
                            (up-modify-group-flag 1 c: 6)
                            (set-goal gl-split-rule 2299)

                            )

                            (defrule
                            (goal gl-split-rule 2299)
                            =>
                            
                            (up-full-reset-search)
                            (up-reset-group c: knight-group)
                            (up-modify-group-flag 0 c: knight-group)
                            (up-create-group 0 0 c: knight-group)
                            (up-modify-group-flag 1 c: knight-group)
                            (enable-timer knight-retreat-timer 999)
                            ;(chat-to-all "ungrouping all knights");hhhhh
                            )

                        
                    
                    ;En ny gruppe kan først dannes når retreat timeren ikke er running og massive attack ikke er opfyldt
