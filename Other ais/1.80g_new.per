            (defrule
                (up-compare-sn sn-focus-player-number < 8)
                ;(up-compare-goal gl-remote-total < 2)
                (game-time > 5) =>
                (up-modify-sn sn-focus-player-number c:+ 1)
                (up-jump-rule -2)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-temp3 g:= gl-remote-total)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-temp4 g:= gl-temp2)
                (up-modify-goal gl-temp4 g:+ gl-temp1)
                (up-modify-goal gl-temp4 g:+ gl-temp1)
                (up-modify-goal gl-temp4 g:- gl-temp3)
                (up-modify-goal gl-temp4 g:- gl-temp3)
                (up-modify-goal gl-temp4 g:- gl-temp3)
                (up-get-fact military-population 0 gl-temp)
                (up-modify-goal gl-temp4 g:- gl-temp)
            )

            (defrule
                (taunt-detected my-player-number 29)
                =>
                (up-chat-data-to-all "number of enemy military units in my base is %d" g: gl-temp2)
                (up-chat-data-to-all "number of enemy military cavalry in my base is %d" g: gl-temp1)
                (up-chat-data-to-all "number of ally military cavalry in my base is %d" g: gl-temp3)
                (up-chat-data-to-all "my number of military units is %d" g: gl-temp)
                (up-chat-data-to-all "enemy has %d extra units in my base" g: gl-temp4)
                (acknowledge-taunt my-player-number 29)
            )

            (defrule
                    (or(taunt-detected my-player-number 23)
                    (up-compare-goal gl-temp4 >= 15))
                    (game-time > 5)
                    (goal gl-delay-imp -1)
                    =>
                    (acknowledge-taunt my-player-number 23)
                    (set-goal gl-delay-imp 1)
                    ;(chat-to-all "delaying imp")
                )

            

            ;fjern delay imp mode via taunt (midlertidigt) ;slukkes når du har en fin størrelse army inkl pikes

                (defrule
