                        (set-goal gl-saving-for-upgrade saving-for-squires)
                        (set-goal gl-saving-gold-needed 0)
                        (set-goal gl-saving-food-needed 100)
                    )

                    (defrule
                        (goal gl-saving-for-upgrade -1)
                        (up-research-status c: ri-capped-ram >= research-pending)
                        (or(population >= 155)
                        (up-compare-goal gl-remote-total <= 20))
                        (building-type-count-total farm >= 42)
                        (up-research-status c: ri-halberdier >= research-pending)
                        (research-available ri-chain-mail)
                        =>
                        (set-goal gl-saving-for-upgrade saving-for-chain-mail)
                        (set-goal gl-saving-gold-needed 100)
                        (set-goal gl-saving-food-needed 200)
                    )

                    (defrule
                        (goal gl-saving-for-upgrade -1)
                        (up-research-status c: ri-capped-ram >= research-pending)
                        (or(population >= 155)
                        (up-compare-goal gl-remote-total <= 20))
                        (building-type-count-total farm >= 42)
                        (up-research-status c: ri-halberdier >= research-pending)
                        (research-available ri-plate-mail)
                        =>
                        (set-goal gl-saving-for-upgrade saving-for-plate-mail)
                        (set-goal gl-saving-gold-needed 150)
                        (set-goal gl-saving-food-needed 300)
                    )

                    (defrule
                        (goal gl-saving-for-upgrade -1)
                        (up-research-status c: ri-capped-ram >= research-pending)
                        (or(population >= 155)
                        (up-compare-goal gl-remote-total <= 20))
                        (building-type-count-total farm >= 42)
                        (up-research-status c: ri-halberdier >= research-pending)
                        (research-available ri-arson)
                        =>
                        (set-goal gl-saving-for-upgrade saving-for-arson)
                        (set-goal gl-saving-gold-needed 50)
                        (set-goal gl-saving-food-needed 150)
                    )
