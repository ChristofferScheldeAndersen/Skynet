                        (up-object-data object-data-hitpoints > 1)
                        =>
                        (set-goal gl-temp-x -1)
                        (up-get-point position-object gl-temp-x)
                    )

                        (defrule
                        (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        (up-set-target-by-id g: gl-deer-id-checker)
                        (up-object-data object-data-distance <= 35)
                        (up-object-data object-data-type == watch-tower)
                        (up-object-data object-data-status != status-pending)
                        (up-object-data object-data-player != my-player-number)
                        (up-object-data object-data-hitpoints > 1)
                            (or(up-point-explored gl-temp-x == explored-active)
                            (and(up-point-explored gl-temp-x != explored-no)
                            (and(wood-amount >= 2)
                            (not(up-can-build-line 0 gl-temp-x c: palisade-wall)))))
                            =>
                    (up-modify-goal gl-temp5 c:+ 1)
                    )


                    (defrule
                    (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        (up-set-target-by-id g: gl-deer-id-checker)
                        (up-object-data object-data-distance <= 18)
                        (up-object-data object-data-type == watch-tower)
                        (up-object-data object-data-player != my-player-number)
                        (up-object-data object-data-hitpoints > 1)
                        =>
                        (set-goal gl-temp-x -1)
                        (up-get-point position-object gl-temp-x)
                    )

                        (defrule
                        (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        (up-set-target-by-id g: gl-deer-id-checker)
                        (up-object-data object-data-distance <= 18)
                        (up-object-data object-data-type == watch-tower)
                        (up-object-data object-data-player != my-player-number)
                        (up-object-data object-data-hitpoints > 1)
                            (or(up-point-explored gl-temp-x == explored-active)
                            (and(up-point-explored gl-temp-x != explored-no)
                            (and(wood-amount >= 2)
                            (not(up-can-build-line 0 gl-temp-x c: palisade-wall)))))
                            =>
                    (up-modify-goal gl-temp6 c:+ 1)
                    )

                    (defrule
                        (current-age < castle-age)
                    (unit-type-count villager >= 20)
                        (up-compare-goal gl-deer-id-checker g:< gl-temp15)
                        (or(up-compare-goal gl-my-position == 3)
                        (up-compare-goal gl-my-position == 5))
                        (goal gl-anti-trush 1)
                        (current-age == feudal-age)
                        =>
                        (up-modify-goal gl-deer-id-checker c:+ 1)
                        (up-jump-rule -5)
                    )
                 
               
            

        (defrule ;Turn on vills attacking towers if trushed.
            (current-age == feudal-age)
            (goal gl-anti-trush 1)
            =>
            (set-strategic-number sn-number-civilian-militia 12)
            (set-strategic-number sn-allow-civilian-offense 1)
            (set-strategic-number sn-allow-civilian-defense 0)
            (set-strategic-number sn-maximum-town-size 40)
        )

        (defrule ;Don't send all vills to attack towers if the trush can't be stopped
            (current-age == feudal-age)
            (goal gl-anti-trush 1)
            (up-compare-goal gl-temp5 >= 4) ;all finished towers
            =>
            (set-strategic-number 480 1)
        )

        (defrule
            (up-compare-sn 480 == 1)
            (current-age == feudal-age)
            (goal gl-anti-trush 1)
            =>
            (set-strategic-number sn-number-civilian-militia 8)
            (set-strategic-number sn-allow-civilian-defense 0)
        )

        (defrule
            (current-age == feudal-age)
            (goal gl-anti-trush 1)
            (up-compare-goal gl-temp6 > 0) ;close towers
            =>
            (set-strategic-number sn-allow-civilian-defense 1)
        )

        (defrule ;Turn off vills attacking towers if trush can't be stopped but isn't targeting anything serious.
            (current-age == feudal-age)
            (goal gl-anti-trush 1)
            (up-compare-goal gl-temp5 >= 4) ;all finished towers
            (up-compare-goal gl-temp6 == 0) ;close towers
            =>
            (set-strategic-number sn-number-civilian-militia 0)
            (set-strategic-number sn-allow-civilian-offense 0)
            (set-strategic-number sn-allow-civilian-defense 1)
        )

        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-get-point position-self gl-temp-x)
            (up-set-target-point gl-temp-x)
            (up-filter-distance c: -1 c: 40)
            (set-strategic-number sn-focus-player-number 1)
            
        )
        
        (defrule
            (players-stance focus-player enemy)
            =>
            (up-find-remote c: building-class c: 40)
        )

        (defrule
            (up-compare-sn sn-focus-player-number < 8)
            =>
            (up-modify-sn sn-focus-player-number c:+ 1)
            (up-jump-rule -2)
        )

        (defrule
            (true)
            =>
            (up-get-point position-self gl-temp-x)
            (up-set-target-point gl-temp-x)
            (up-clean-search search-remote object-data-distance search-order-asc)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            =>
            (up-get-object-data object-data-distance gl-temp)
            (up-modify-goal gl-temp c:- 5)
        )

        (defrule
            (up-compare-sn sn-maximum-town-size g:> gl-temp)
            =>
            (up-modify-sn sn-maximum-town-size g:= gl-temp)
        )
                    
                    
    ; Find targets for vills til starten af næste script-run (beginning of fase 4)

        (defrule
            (true)
            =>
            (up-full-reset-search)
        )

        (defrule
            (up-compare-goal gl-fase >= 3)
            =>
            (up-get-fact unit-type-count villager gl-castle-age-vill-count)
            (enable-timer stop-retasking-timer 60)
            (disable-self)
        )
        
        (defrule
        (up-timer-status stop-retasking-timer == timer-running)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 200)
