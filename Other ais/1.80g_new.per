                ;25-27 + 30-34 vills - deers hvis de er der. Ellers nærmeste træ eller sheep
                    (defrule 
                    (up-compare-goal gl-deer-luring-stage != No-more-deer-to-eat)
                    (unit-type-count villager >= 25)
                    (unit-type-count villager <= 27)
                    (up-set-target-by-id g: gl-eating-deer)
