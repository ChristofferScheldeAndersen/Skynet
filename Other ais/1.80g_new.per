        ; 10-19 vills - Forming deer group                                :3 shepard -> deer conversions
            
            (defrule ; finding first eating deer
                (goal gl-deer-luring-stage Luring-deer)
                =>
                (up-full-reset-search)
                (up-modify-goal gl-remote-total c:= -1)
                (up-find-local c: town-center c: 1)
                (up-set-target-object search-local c: 0)
                (up-get-object-data object-data-id gl-deer-id-checker)
                (up-modify-goal gl-deer-id-checker g:= gl-first-gaia-id)
            )

            (defrule
                (goal gl-deer-luring-stage Luring-deer)
                (up-set-target-by-id g: gl-deer-id-checker)
                (up-object-data object-data-class == 909)
                (up-object-data object-data-carry > 0)
                (up-object-data object-data-hitpoints > 0)
                =>
            (up-get-object-data object-data-id gl-current-deer-id2)
            (up-add-object-by-id search-remote g: gl-current-deer-id2)
            )

            (defrule
            (goal gl-deer-luring-stage Luring-deer)
                (up-compare-goal gl-deer-id-checker g:< gl-last-gaia-id)
                (up-compare-goal gl-deer-eating-stage != No-more-deer)
                =>
                (up-modify-goal gl-deer-id-checker c:+ 1)
                (up-jump-rule -2)
            )

            (defrule
                (goal gl-deer-luring-stage Luring-deer)
                =>
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-remove-objects search-remote object-data-distance > 6)
                (up-remove-objects search-remote object-data-hitpoints < 1)
                (up-remove-objects search-remote object-data-index != 0)
                (up-remove-objects search-remote object-data-id g:== gl-shooting-deer)
            )

            (defrule
                (goal gl-deer-luring-stage Luring-deer)
                (up-set-target-object search-remote c: 0)
                (up-object-data object-data-id g:!= gl-shooting-deer)
                =>
                ;(up-chat-data-to-player my-player-number "shooting deer 1 chosen with id %d" g: gl-shooting-deer)
                (up-get-object-data object-data-id gl-shooting-deer)
                (up-remove-objects search-remote object-data-distance > 4)
                (up-get-search-state gl-local-total)
                ;(up-chat-data-to-player my-player-number "shooting deer 2 chosen with id %d" g: gl-shooting-deer)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-remote g: gl-shooting-deer)
                (up-remove-objects search-remote object-data-distance > 5)
            )
            
            (defrule ; Forming deer group
            (goal gl-deer-luring-stage Luring-deer)
                (up-compare-goal gl-remote-total > 0)
                =>
                ;(up-full-reset-search) ; sæt tc gather point på deer.
                ;(up-find-local c: town-center c: 1)
                ;(up-set-target-object search-local c: 0)
                ;(up-add-object-by-id search-remote g: gl-shooting-deer)
                ;(up-set-target-object search-remote c: 0)
                ;(up-target-objects 0 action-gather -1 -1)

                (up-find-local c: villager-class c: 30) ; find potentielle vills
                (up-remove-objects search-local object-data-group-flag != shepard-group)
                (up-clean-search search-local object-data-hitpoints search-order-asc)
            
                (up-set-target-by-id g: gl-first-boar-id) ;fjern boar targets
                (up-get-object-target-data object-data-id gl-unsafe-vill)
                (up-remove-objects search-local object-data-id g:== gl-unsafe-vill)
                (up-set-target-by-id g: gl-second-boar-id) 
                (up-get-object-target-data object-data-id gl-unsafe-vill)
                (up-remove-objects search-local object-data-id g:== gl-unsafe-vill)

                (up-remove-objects search-local object-data-class != villager-class)
                (up-clean-search search-local object-data-index search-order-asc) ; forsøg på at undgå 2-vill-group

                (up-get-search-state gl-local-total)
                (set-goal gl-form-deer-group 1)
                )

                (defrule
                    (up-compare-goal gl-first-boar-luring-villager != -1)
                    (up-compare-goal gl-first-boar-status == -1)
                    =>
                    (up-remove-objects search-local object-data-id g:== gl-first-boar-luring-villager)
                )

                (defrule
                    (up-compare-goal gl-second-boar-luring-villager != -1)
                    (up-compare-goal gl-second-boar-status == -1)
                    =>
                    (up-remove-objects search-local object-data-id g:== gl-second-boar-luring-villager)
                    (up-clean-search search-local object-data-index search-order-asc)
                    (up-get-search-state gl-local-total)
                )

                (defrule
                    (up-compare-goal gl-local-total >= 3)
                    (up-compare-goal gl-form-deer-group == 1)
                    =>
                    (up-remove-objects search-local object-data-index > 2) ; create deer group
                    (up-get-search-state gl-local-total)
                    ;;(up-chat-data-to-player my-player-number "gl-local-total after new check is %d." g: gl-local-total)
                    (up-reset-group c: deer-group)
                    (up-modify-group-flag 0 c: deer-group)
                    (up-create-group 0 0 c: deer-group)
                    (up-modify-group-flag 1 c: deer-group)
                    (set-goal gl-first-deer-killed 1)
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 30)
                    (up-remove-objects search-local object-data-group-flag != deer-group)
                    (up-get-search-state gl-local-total)
                    ;;(up-chat-data-to-player my-player-number "gl-local-total after new check is %d." g: gl-local-total)
                    ;(up-get-fact population 0 gl-temp)
                    ;(up-chat-data-to-player my-player-number "Rehoboam has %d. pop. Converting 3 shepards to deer-group" g: gl-temp)
                    (disable-self)
                    )

                    (defrule
                (goal gl-form-deer-group 1)
                =>
                (set-goal gl-form-deer-group -1)
            )
        ; 20 vills - 8 shepards 4 wood 4 berry 3 deer 1 straggler         +1 straggler
            (defrule
            (goal gl-ungrouped-vill 1)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 200)
                        
            ;fase 1
            (up-remove-objects search-local object-data-group-flag == shepard-group) ;1
            (up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
            (up-remove-objects search-local object-data-group-flag == berry-group) ;3
            (up-remove-objects search-local object-data-group-flag == deer-group) ;4
            ;(up-remove-objects search-local object-data-group-flag == dark-age-straggler-group) ;5 - bliver til gold-mining-group
                        
            ;fase 2
            (up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
            (up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
            (up-remove-objects search-local object-data-group-flag == farming-group) ;8

            (up-reset-group c: dark-age-straggler-group)             
            (up-modify-group-flag 0 c: dark-age-straggler-group)
            (up-create-group 0 0 c: dark-age-straggler-group)
            (up-modify-group-flag 1 c: dark-age-straggler-group)
            ;(up-get-fact population 0 gl-temp)
            ;;(up-chat-data-to-player my-player-number "Rehoboam has %d. pop. Adding vill to dark-age-straggler-group" g: gl-temp)
            (set-goal gl-ungrouped-vill -1)
            (disable-self)
            )
        ; 21 vills - 8 shepards 4 wood 4 berry 3 deer 2 straggler         +1 straggler
            (defrule
            (goal gl-ungrouped-vill 1)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 200)
                        
            ;fase 1
            (up-remove-objects search-local object-data-group-flag == shepard-group) ;1
            (up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
            (up-remove-objects search-local object-data-group-flag == berry-group) ;3
            (up-remove-objects search-local object-data-group-flag == deer-group) ;4
            ;(up-remove-objects search-local object-data-group-flag == dark-age-straggler-group) ;5 - bliver til gold-mining-group
                        
            ;fase 2
            (up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
            (up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
            (up-remove-objects search-local object-data-group-flag == farming-group) ;8

            (up-reset-group c: dark-age-straggler-group)             
            (up-modify-group-flag 0 c: dark-age-straggler-group)
            (up-create-group 0 0 c: dark-age-straggler-group)
            (up-modify-group-flag 1 c: dark-age-straggler-group)
            ;(up-get-fact population 0 gl-temp)
            ;;(up-chat-data-to-player my-player-number "Rehoboam has %d. pop. Adding vill to dark-age-straggler-group" g: gl-temp)
            (set-goal gl-ungrouped-vill -1)
            (disable-self)
            )

        ;
    ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 415 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 63 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
