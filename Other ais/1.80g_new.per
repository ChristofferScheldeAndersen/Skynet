                        (up-research-status c: imperial-age >= research-pending))))
                        =>
                        (set-goal gl-split-rule 713)
                    )

                    (defrule
                        ;(goal gl-split-rule 713)
                        (or(research-completed ri-paladin)
                        (research-completed ri-savar))
                        (or(and(wood-amount >= 500)
                        (commodity-selling-price wood >= 50))
                        (or(and(wood-amount >= 800)
                        (commodity-selling-price wood >= 40))
                        (or(and(wood-amount >= 1000)
                        (commodity-selling-price wood >= 30))
                        (wood-amount >= 1200))))
                        =>
                        (sell-commodity wood)
                        ;(chat-to-all "selling excess wood")
                    )
                        

                    (defrule
                        (up-research-status c: ri-paladin < research-pending)
                        (up-research-status c: ri-savar < research-pending)
                        (or(stone-amount > 750)
                        (and(unit-type-count-total knight-line < 5)
