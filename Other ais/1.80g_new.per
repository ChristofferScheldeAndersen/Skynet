                (or(and(up-point-distance gl-temp-x gl-temp6-x <= 10)
                    (up-point-distance gl-temp-x gl-temp6-x > 3))
                    (or(and(up-point-distance gl-temp-x gl-temp7-x <= 10)
                    (up-point-distance gl-temp-x gl-temp7-x > 3))
                    (or(and(up-point-distance gl-temp-x gl-temp8-x <= 10)
                    (up-point-distance gl-temp-x gl-temp8-x > 3))
                    (or(and(up-point-distance gl-temp-x gl-temp9-x <= 10)
                    (up-point-distance gl-temp-x gl-temp9-x > 3))
                    (and(up-point-distance gl-temp-x gl-temp10-x <= 10)
                    (up-point-distance gl-temp-x gl-temp10-x > 3)))))))

                    (up-compare-goal gl-temp20 < 3)
                (up-compare-goal gl-temp48 > 0)
                (up-set-target-object search-local g: gl-temp1)
                    =>
                     (up-set-target-point gl-temp-x)
                    (up-find-remote c: town-center c: 40)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    ;(up-chat-data-to-all "vill nr %d is close to enemy units" g: gl-temp1)
                    (set-goal gl-split-rule 2345)
                )



                (defrule
                    (goal gl-split-rule 2345)
                    (up-compare-goal gl-temp20 < 3)
                    (up-compare-goal gl-temp48 > 0)
                    (or(current-age == castle-age)
                    (military-population < 15))
                    (game-time < 2100)
                    (up-compare-goal gl-my-position == pocket)
                    (up-set-target-object search-local c: 0)
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-remove-objects search-local object-data-index g:!= gl-temp1)
                    (up-get-point position-object gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-remove-objects search-local object-data-distance <= 7)
                    (up-target-objects 0 action-garrison -1 -1)
                    ;(up-chat-data-to-all "sending vill with index nr %d to garrison in tc" g: gl-temp1)
                )

                (defrule
                    (up-compare-goal gl-temp48 > 0) ;only run loop if enemy units are found
                    (up-compare-goal gl-local-total g:> gl-temp1) ;run loop untill there are no more vills to check
                    (up-compare-goal gl-temp47 != -1)
                    =>
                    (up-modify-goal gl-temp1 c:+ 1)
                    (up-jump-direct g: gl-temp47)
                )

                (defrule
                    (or(taunt-detected my-player-number 236)
                    (or(taunt-detected any-ally 236)
                    (taunt-detected any-enemy 236)))
                    =>
                    (up-chat-data-to-all "nr of checked vills were %d" g: gl-temp1)
                )
