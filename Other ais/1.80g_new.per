                    (defrule;start of loop
                        (true)
                        =>
                        (up-get-point position-self gl-temp1-x)
                        (up-modify-goal gl-temp1-x g:+ gl-temp1)
                        (up-modify-goal gl-temp1-y g:+ gl-temp2)
                        (up-copy-point gl-temp2-x gl-temp1-x)
                        (up-bound-precise-point gl-temp2-x 0 c: 3)
                        (set-goal gl-temp5 0) ; antal unexplored tiles inden for scout radius fra punkt
                        (set-goal gl-temp6 1) ; indeks number for point checked in scout LOS
