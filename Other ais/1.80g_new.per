    ;10 Wood
        ; A Decide when to build first lumber-camp
                    
                    (defrule
                        (can-afford-building lumber-camp)
                        (wood-amount >= 125)
                        (unit-type-count villager >= 10)
                        (up-compare-goal gl-building-system == build-line-system)
                        (building-type-count-total lumber-camp == 0)
