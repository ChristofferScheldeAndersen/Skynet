                                (up-find-resource c: wood c: 200)
                                (up-filter-distance c: -1 c: 4)
                                (up-find-local c: wall-class c: 200)
                                (up-find-local c: gate-class c: 200)
                                (up-get-search-state gl-local-total)
                                (up-modify-goal gl-local-total c:* 6)
                                (up-modify-goal gl-remote-total g:- gl-local-total)
