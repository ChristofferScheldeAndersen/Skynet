                    ;(up-remove-objects search-local object-data-type != mangonel)
                    ;(up-remove-objects search-local object-data-type != scorpion)
                    (up-clean-search search-local -1 search-order-asc)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp33 g:= gl-local-total) ;gl-temp is enemy nr of the chosen unit
                    )

                    (defrule
                    (current-age >= castle-age)
                    =>
                    (up-full-reset-search)
                    (up-set-group search-local c: 7)
                    (up-remove-objects search-local object-data-hitpoints <= 0)
                    ;chosen unit:
                    ;(up-remove-objects search-local object-data-type != scout-cavalry)
                    ;(up-remove-objects search-local object-data-type != archer)
                    ;(up-remove-objects search-local object-data-type != skirmisher)
                    ;(up-remove-objects search-local object-data-type != spearman)
                    ;(up-remove-objects search-local object-data-type != mangonel)
                    (up-remove-objects search-local object-data-type != scorpion)
                    (up-clean-search search-local -1 search-order-asc)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp35 g:= gl-local-total) ;gl-temp is enemy nr of the chosen unit
                    )

                    (defrule
                    (current-age >= castle-age)
                    =>
                    (up-full-reset-search)
                    (up-set-group search-local c: 7)
                    (up-remove-objects search-local object-data-hitpoints <= 0)
                    ;chosen unit:
                    ;(up-remove-objects search-local object-data-type != scout-cavalry)
                    ;(up-remove-objects search-local object-data-type != archer)
                    ;(up-remove-objects search-local object-data-type != skirmisher)
                    ;(up-remove-objects search-local object-data-type != spearman)
                    (up-remove-objects search-local object-data-type != mangonel)
                    ;(up-remove-objects search-local object-data-type != scorpion)
                    (up-clean-search search-local -1 search-order-asc)
                    (up-get-search-state gl-local-total)
