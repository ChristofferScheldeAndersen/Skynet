                    )


                    (defrule
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-point position-object gl-temp1-x)
                    (up-reset-search 0 0 1 1)
                    (up-reset-filters)
                    (up-set-target-point gl-temp1-x)
                    (up-filter-distance c: -1 c: 6)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: stone c: 40) 
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    (up-get-search-state gl-local-total)
                    )

                    (defrule
                    (up-set-target-object search-local c: 0)
                    (up-set-target-object search-remote c: 0)
                    (up-object-data object-data-class == 908)
                    (up-compare-goal gl-remote-total >= 5)
                    (up-compare-goal gl-enemy-flank-y == -1)
                    (up-point-distance gl-temp1-x gl-temp3-x > 38)
                    (up-point-distance gl-temp1-x gl-temp7-x > 38)
                    =>
                    (up-get-object-data object-data-id gl-enemy-flank-y)
                    ;(chat-to-all "found enemy ressource 4")
                    )





                    (defrule
                    (true)
                    =>
                    (set-strategic-number sn-focus-player-number 1)
                    (up-reset-search 0 0 1 1)
                    (up-reset-filters)
                    )

                    (defrule
                    (players-stance focus-player enemy)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-point position-object gl-temp1-x)
                    (up-set-target-point gl-temp1-x)
                    (up-filter-distance c: -1 c: 15)
                    (up-find-remote c: building-class c: 40)
                    (up-remove-objects search-remote object-data-type == 562)
                    (up-remove-objects search-remote object-data-type == 563)
                    (up-remove-objects search-remote object-data-type == 70)
                    (up-remove-objects search-remote object-data-type == 463)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    (up-get-search-state gl-local-total)
                    )

                    (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                    )

                    (defrule
                    (up-set-target-object search-local c: 0)
                    (up-set-target-object search-remote c: 0)
                    (up-compare-goal gl-remote-total > 0)
                    (up-compare-goal gl-enemy-flank-y == -1)
                    =>
                    (up-get-object-data object-data-id gl-enemy-flank-y)
                    ;(chat-to-all "found enemy building 5")
                    )

                ;Scouting for enemy tc

                    (defrule
                    (game-time > 1080)
                    (up-compare-goal gl-enemy-flank-x == -1)
                    (up-compare-goal gl-enemy-flank-y != -1)
                    =>
                    ;(set-goal gl-enemy-flank-y -1)
                    (do-nothing)
                    )


                    (defrule
                    (game-time < 900)
                    (up-set-target-object search-local c: 0)
                    (up-set-target-by-id g: gl-enemy-flank-y)
                    (up-compare-goal gl-enemy-flank-x == -1)
                    (up-timer-status scout-movement-timer != timer-running)
                    
                    =>
                    (up-get-point position-object gl-temp5-x)
                    (up-set-target-point gl-temp5-x)

                    (set-goal gl-temp1 18) ;prefered distance to gold 18
                    (up-cross-tiles gl-temp1-x gl-temp5-x c: 10)
                    (up-get-point-distance gl-temp1-x gl-temp5-x gl-temp2) ;current distance to gold 5
                    (up-modify-goal gl-temp2 g:- gl-temp1)
                    (up-lerp-tiles gl-temp1-x gl-temp5-x g: gl-temp2)
                    (up-bound-precise-point gl-temp1-x 0 c: 6)
                    (up-target-point gl-temp1-x action-move -1 -1)
                    (enable-timer scout-movement-timer 5)
                    ;(chat-to-all "looking for enemy tc 1")
                    )
                
                ;Saving position and ID of enemy tc

                    (defrule
                    (true)
                    =>
                    (up-reset-search 0 0 1 1)
                    (up-reset-filters)
                    (set-strategic-number sn-focus-player-number 1)
                    )

                    (defrule
                    (players-stance focus-player enemy)
                    (up-set-target-by-id g: gl-scout-unit)
                    =>
                    (up-get-point position-object gl-temp1-x)
                    (up-set-target-point gl-temp1-x)
                    (up-filter-distance c: -1 c: 15)
                    (up-find-remote c: town-center c: 40)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    )

                    (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                    )

                    (defrule
                    (up-set-target-object search-remote c: 0)
                    (up-compare-goal gl-enemy-flank-x == -1)
                    =>
                    (up-get-point position-object gl-temp-x)
                    )

                    (defrule
                    (up-compare-goal gl-enemy-flank-x == -1)
                    (game-time > 840)
                    =>
                    ;(up-get-point position-flank gl-enemy-flank-x)
                    (disable-self)
                    )

                    (defrule
                    (up-set-target-object search-remote c: 0)
                    (up-compare-goal gl-enemy-flank-x == -1)
                    (up-compare-goal gl-temp-x > 8)
                    (up-compare-goal gl-temp-y > 8)
                    =>
                    (up-get-point position-object gl-enemy-flank-x)
                    (up-get-point position-object gl-enemy-x)
                    (up-get-object-data object-data-id gl-enemy-tc)
                    (up-get-object-data object-data-player gl-flank)
                    ;(up-chat-data-to-all "flank is player %d." g: gl-flank)
                    (up-send-flare gl-enemy-flank-x)
                    ;(chat-to-all "found flank")
                    (set-goal gl-found-enemy 1)
                    (disable-self)
                    )

                ;Force scout close to enemy base once enemy is feudal age

                    (defrule
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-compare-goal gl-enemy-flank-x != -1)
                    (or(players-current-age target-player >= feudal-age)
                    (up-compare-goal gl-my-position != 5))
                    =>
                    (up-get-point position-object gl-temp1-x)
                    (up-get-point-distance gl-temp1-x gl-enemy-flank-x gl-temp)
                    )

                    (defrule
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-compare-goal gl-enemy-flank-x != -1)
                    (players-current-age target-player >= feudal-age)
                    (up-timer-status scouting-enemy-base-timer != timer-running)
                    (up-timer-status scouting-enemy-base-timer != timer-triggered)
                    (up-compare-goal gl-temp > 15)
                    =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-scout-unit)
                    (up-target-point gl-enemy-flank-x action-move -1 -1)
                    ;(chat-to-all "sending scout to enemy base1 ")
                    (disable-self)
                    )

                    (defrule
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-compare-goal gl-enemy-flank-x != -1)
                    (players-building-type-count target-player archery-range == 0)
                    (players-unit-type-count target-player skirmisher-line == 0)
                    (players-unit-type-count target-player archer-line == 0)
                    (players-current-age target-player >= feudal-age)
                    (players-unit-type-count target-player militiaman-line > 0)
                    (up-timer-status scouting-enemy-base-timer != timer-running)
                    (up-timer-status scouting-enemy-base-timer != timer-triggered)
                    (up-compare-goal gl-temp > 15)
                    =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-scout-unit)
                    (up-target-point gl-enemy-flank-x action-move -1 -1)
                    ;(chat-to-all "sending scout to enemy base2")
                    (disable-self)
                    )
                    

                ;backup scouting if no point close to enemy tc is found

                    ;back up scouting:
                    ;1 hvis scout er 100 eller flere tiles væk fra egen flank tc og gl-enemy-flank-y er -1 sættes gl-flank-backup-x
                    ;til nuværende position med 6 x 5 tiles baglæns cross fra scout location og map center
                    ;2 normal scouting kode kan ikke køre mens gl-flank-backup-x er aktiv

                    (defrule
                        (true)
                        =>
                        (up-get-point position-self gl-temp6-x)
                        (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                        (set-goal gl-temp49 -1)
                    )

                    (defrule
                        (up-compare-goal gl-my-position == 4)
                        =>
                        (up-get-focus-fact allied-goal gl-starting-tc-x gl-temp6-x)
                        (up-get-focus-fact allied-goal gl-starting-tc-y gl-temp6-y)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        =>
                        (up-get-point position-object gl-temp9-x)
                        (up-get-point-distance gl-temp9-x gl-temp6-x gl-temp49)
                    )

                    

                    (defrule
                        (up-compare-goal gl-enemy-flank-y == -1)
                        (up-compare-goal gl-temp49 >= 102)
                        (up-compare-goal gl-enemy-flank-backup-x == -1)
                        (up-compare-goal gl-scouting-enemy-direction == clockwise)
                        =>
                        (up-get-point position-center gl-temp6-x)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 6)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 6)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 5)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 5)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 5)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 5)
                        
                    )

                    (defrule
                        (up-compare-goal gl-enemy-flank-y == -1)
                        (up-compare-goal gl-temp49 >= 102)
                        (up-compare-goal gl-enemy-flank-backup-x == -1)
                        (up-compare-goal gl-scouting-enemy-direction == counter-clockwise)
                        =>
                        (up-get-point position-center gl-temp6-x)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -6)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -6)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -5)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -5)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -5)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -5)
                        
                    )

                    (defrule
                        (true)
                        =>
                        (up-get-point position-zero gl-temp6-x)
                        (up-get-point-distance gl-temp6-x gl-temp9-x gl-temp31)
                        (up-get-point position-map-size gl-temp6-x)
                        (up-modify-goal gl-temp6-x c:= 0)
                        (up-get-point-distance gl-temp6-x gl-temp9-x gl-temp32)
                        (up-get-point position-map-size gl-temp6-x)
                        (up-modify-goal gl-temp6-y c:= 0)
                        (up-get-point-distance gl-temp6-x gl-temp9-x gl-temp33)
                        (up-get-point position-map-size gl-temp6-x)
                        (up-get-point-distance gl-temp6-x gl-temp9-x gl-temp34)
                    )

                    (defrule
                        (or(up-compare-goal gl-temp31 < 60)
                        (or(up-compare-goal gl-temp32 < 60)
                        (or(up-compare-goal gl-temp33 < 60)
                        (up-compare-goal gl-temp34 < 60))))
                        =>
                        (up-get-point position-center gl-temp6-x)
                        (up-lerp-tiles gl-temp9-x gl-temp6-x c: -10)
                        ;(up-chat-data-to-all "first corner is %d tiles away" g: gl-temp31)
                        ;(up-chat-data-to-all "first corner is %d tiles away" g: gl-temp32)
                        ;(up-chat-data-to-all "first corner is %d tiles away" g: gl-temp33)
                        ;(up-chat-data-to-all "first corner is %d tiles away" g: gl-temp34)
                    )

                    (defrule
                        (true)
                        =>
                        (up-get-point position-self gl-temp6-x)
                        (up-set-target-point gl-temp6-x)
                    )

                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        (up-object-data object-data-distance > 65)
                        (up-compare-goal gl-enemy-flank-y == -1)
                        (up-compare-goal gl-temp49 >= 102)
                        (up-compare-goal gl-enemy-flank-backup-x == -1)
                        (up-compare-goal gl-number-of-players-on-enemy-team > 1)
                        (up-allied-goal focus-player gl-personality == Rehoboam)
                        =>
                        (up-copy-point gl-enemy-flank-backup-x gl-temp9-x)
                        ;(up-send-flare gl-temp9-x)
                        ;(chat-to-all "start backup scouting flank")
                    )

                    (defrule
                    (up-compare-goal gl-enemy-flank-y == -1)
                    (up-compare-goal gl-enemy-flank-backup-x != -1)
                    (up-timer-status scout-movement-timer != timer-running)
                    (up-set-target-by-id g: gl-scout-unit)
                    =>
                    (up-reset-search 1 1 0 0)
                    (up-add-object-by-id search-local g: gl-scout-unit)
                    )

                    (defrule
                    (game-time < 900)
                    (up-compare-goal gl-enemy-flank-y == -1)
                    (up-compare-goal gl-enemy-flank-backup-x != -1)
                    (up-timer-status scout-movement-timer != timer-running)
                    (up-set-target-by-id g: gl-scout-unit)
                    =>
                    (up-get-point position-object gl-temp9-x)
                    (up-copy-point gl-temp1-x gl-temp9-x)
                    (up-copy-point gl-temp9-x gl-enemy-flank-backup-x)
                    (set-goal gl-temp1 20) ;prefered distance to gold 18
                    (up-cross-tiles gl-temp1-x gl-temp9-x c: 12)
                    (up-get-point-distance gl-temp1-x gl-temp9-x gl-temp2) ;current distance to gold 5
                    (up-modify-goal gl-temp2 g:- gl-temp1)
                    (up-lerp-tiles gl-temp1-x gl-temp9-x g: gl-temp2)
                    (up-bound-precise-point gl-temp1-x 0 c: 5)
                    (up-target-point gl-temp1-x action-move -1 -1)
                    (enable-timer scout-movement-timer 6)
                    ;(chat-to-all "backup scouting")
                    )

                ;scout enemy base

                    (defrule
                    (players-current-age target-player >= feudal-age)
                    (or(up-compare-goal gl-my-position == 5)
                    (up-compare-sn sn-lone-flank == 1))
                    (up-compare-goal gl-enemy-flank-x != -1)
                    (up-compare-goal gl-temp <= 18)
                    (up-compare-goal gl-temp > 6)
                    (not(goal gl-look-for-trush 1))
                    =>
                    (enable-timer scouting-enemy-base-timer 60)
                    ;(chat-to-all "start scouting timer for flank")
                    (disable-self)
                    )

                    (defrule
                    (players-building-type-count target-player archery-range == 0)
                    (players-unit-type-count target-player skirmisher-line == 0)
                    (players-unit-type-count target-player archer-line == 0)
                    (players-current-age target-player >= feudal-age)
                    (players-unit-type-count target-player militiaman-line > 0)
                    (taunt-detected my-player-number 249)
                    (or(up-compare-goal gl-my-position == 5)
                    (up-compare-sn sn-lone-flank == 1))
                    (up-compare-goal gl-enemy-flank-x != -1)
                    (up-compare-goal gl-temp <= 18)
                    (up-compare-goal gl-temp > 6)
                    (not(goal gl-look-for-trush 1))
                    =>
                    (enable-timer scouting-enemy-base-timer 60)
                    ;(chat-to-all "start scouting timer for flank2")
                    (disable-self)
                    )

                    (defrule
                        (up-compare-goal gl-my-position != 5)
                        (up-compare-sn sn-lone-flank != 1)
                    (up-compare-goal gl-enemy-flank-x != -1)
                    (up-compare-goal gl-temp <= 18)
                    (up-compare-goal gl-temp > 6)
                    (not(goal gl-look-for-trush 1))
                        =>
                        (enable-timer scouting-enemy-base-timer 45)
                        (disable-self)
                    )

                    (defrule
                    (up-timer-status scouting-enemy-base-timer == timer-running)
                    (up-compare-goal gl-enemy-flank-x != -1)
                    (up-compare-goal gl-temp > 5)
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-timer-status scout-movement-timer != timer-running)
                    ;(players-building-type-count target-player archery-range == 0)
                    ;(players-building-type-count target-player stable == 0)
                    ;(players-building-type-count target-player barracks <= 1)
                    =>
                    (up-full-reset-search)
                    (up-get-point position-object gl-temp1-x)
                    (up-copy-point gl-temp2-x gl-enemy-flank-x)
                    (set-goal gl-temp1 15) ;prefered distance to gold 18
                    (up-cross-tiles gl-temp1-x gl-temp2-x c: 10)
                    
                    )

                    (defrule
                    (up-timer-status scouting-enemy-base-timer == timer-running)
                    (up-compare-goal gl-enemy-flank-x != -1)
                    (up-compare-goal gl-temp > 5)
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-timer-status scout-movement-timer != timer-running)
                    ;(players-building-type-count target-player archery-range == 0)
                    ;(players-building-type-count target-player stable == 0)
                    ;(players-building-type-count target-player barracks <= 1)
                    =>
                    
                    (up-get-point-distance gl-temp1-x gl-temp2-x gl-temp2) ;current distance to gold 5
                    (up-modify-goal gl-temp2 g:- gl-temp1)
                    (up-lerp-tiles gl-temp1-x gl-temp2-x g: gl-temp2)
                    (up-bound-precise-point gl-temp1-x 0 c: 4)
                    (up-add-object-by-id search-local g: gl-scout-unit)
                    (up-target-point gl-temp1-x action-move -1 -1)
                    ;(chat-to-all "scouting enemy base 2")
                    (enable-timer scout-movement-timer 5)
                    )
                ;Stop scouting enemy-base in team games when scout is on the right side of the enemy tc
                    

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp50 -1)
                    )

                    (defrule
                        (goal gl-scouting-enemy-direction counter-clockwise)
                        (up-set-target-by-id g: gl-scout-unit)
                        =>
                        (up-get-point position-object gl-temp9-x)
                        (up-get-point position-center gl-temp6-x)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: 7)
                    )

                    (defrule
                        (goal gl-scouting-enemy-direction clockwise)
                        (up-set-target-by-id g: gl-scout-unit)
                        =>
                        (up-get-point position-object gl-temp9-x)
                        (up-get-point position-center gl-temp6-x)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -7)
                        (up-cross-tiles gl-temp9-x gl-temp6-x c: -7)
                    )

                    (defrule
                        (up-compare-goal gl-enemy-flank-x != -1)
                        (up-set-target-by-id g: gl-scout-unit)
                        =>
                        (up-get-point-distance gl-temp9-x gl-enemy-flank-x gl-temp50)
                        (up-get-point position-object gl-temp6-x)
                        (up-get-point-distance gl-temp9-x gl-temp6-x gl-temp44)
                        (up-modify-goal gl-temp50 g:- gl-temp44)
                    )

                    (defrule
                        (up-compare-goal gl-temp50 >= 9)
                        (not(goal gl-scouting-stage 1))
                        (up-compare-goal gl-number-of-players-on-enemy-team > 2)
                        (up-compare-sn sn-lone-flank != 1)
                        (up-timer-status scouting-enemy-base-timer == timer-running)
                        =>
                        (enable-timer scouting-enemy-base-timer 0)
                        ;(chat-to-all "scout is on the correct side of enemy-flank tc 1")
                    )

                ;Run scout away once enemy base is scouted
                    ;1v1
                    (defrule
                    (up-timer-status scouting-enemy-base-timer == timer-triggered)
                    (up-compare-goal gl-enemy-flank-x != -1)
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-compare-goal gl-number-of-players-on-enemy-team <= 2)
                    =>
                    (up-full-reset-search)
                    (up-get-point position-object gl-temp1-x)
                    (up-copy-point gl-temp2-x gl-enemy-flank-x)
                    (up-lerp-tiles gl-temp1-x gl-temp2-x c: -40)
                    (up-bound-precise-point gl-temp1-x 0 c: 3)
                    (up-add-object-by-id search-local g: gl-scout-unit)
                    (up-target-point gl-temp1-x action-move -1 -1)
                    ;(chat-to-all "running scout away once enemy is scouted in 1v1 and 2v2")
                    (disable-self)
                    )

                ;

                ;Making sure scout is far enough away from flank to start scouting pocket
                    (defrule
                        (up-set-target-by-id g: gl-scout-unit)
                        =>
                        (up-get-point position-object gl-temp1-x)
                    )

                    (defrule
                        (up-timer-status scouting-enemy-base-timer == timer-triggered)
                    (up-compare-goal gl-enemy-flank-x != -1)
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-compare-goal gl-number-of-players-on-enemy-team > 2)
                    (up-compare-goal gl-temp50 >= 9)
                        =>
                        (set-goal gl-scouting-stage 1)
                        ;(chat-to-all "scout is on the correct side of enemy-flank tc 2")
                    (disable-self)
                    )

                    (defrule
                        (up-timer-status scouting-enemy-base-timer == timer-triggered)
                    (up-compare-goal gl-enemy-flank-x != -1)
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-compare-goal gl-number-of-players-on-enemy-team <= 2)
                    (up-compare-goal gl-temp50 >= 9)
                        =>
                        (set-goal gl-scouting-stage 2)
                        ;(chat-to-all "scout is on the correct side of enemy-flank tc 2 stop scouting?")
