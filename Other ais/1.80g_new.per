                    (defrule
                        (goal gl-temp1 1)
                        =>
                        (set-goal gl-temp1 2)
                    )

                    #load-if-defined UP-4-PLAYER-TEAM
                    (defrule
                    (up-compare-goal gl-temp1 != 2)
                    (up-compare-sn sn-focus-player-number g:== gl-other-pocket)
                    (game-time > 5)
                    =>
                    (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                    (up-jump-rule -11)
                    )

                    (defrule
                    (up-compare-goal gl-temp1 != 2)
                    (up-compare-sn sn-focus-player-number g:== gl-closest-ally)
                    (game-time > 5)
                    =>
                    (up-modify-sn sn-focus-player-number g:= gl-other-flank)
