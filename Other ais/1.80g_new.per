            ;;;(up-chat-data-to-all "idle eco points: %d." g: g-idle-eco-points)
            )

            (defrule
                (or(current-age > feudal-age)
                (or(and(nor(enemy-buildings-in-town)
                (up-enemy-villagers-in-town > 1))
