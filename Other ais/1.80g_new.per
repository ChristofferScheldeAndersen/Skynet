        ;Find kombineret enemy score

            (defrule
                (true)
                =>
                (set-goal gl-index-number 0)
                (set-goal gl-combined-enemy-unit-score 0)
                (set-goal gl-unit-score 0)
                (up-reset-search 0 0 1 1)
                (up-add-object-by-id search-remote g: gl-temp11)
                (up-add-object-by-id search-remote g: gl-temp12)
                (up-add-object-by-id search-remote g: gl-temp13)
                (up-add-object-by-id search-remote g: gl-temp14)
                (up-add-object-by-id search-remote g: gl-temp15)
                (up-add-object-by-id search-remote g: gl-temp16)
                (up-add-object-by-id search-remote g: gl-temp17)
                (up-add-object-by-id search-remote g: gl-temp18)
                (up-add-object-by-id search-remote g: gl-temp19)
                (up-add-object-by-id search-remote g: gl-temp20)
            )

            (defrule
                (true)
                =>
                (up-get-rule-id gl-enemy-unit-score-first-rule)
                (set-goal gl-unit-score 0)
            )

            (defrule
                (up-set-target-object search-remote g: gl-index-number)
                =>
                (up-get-object-data object-data-hitpoints gl-hitpoints)
                (up-get-object-data object-data-maxhp gl-max-hitpoints)
                (up-modify-goal gl-hitpoint-percentage g:= gl-hitpoints)
                (up-modify-goal gl-hitpoint-percentage c:* 100)
                (up-modify-goal gl-hitpoint-percentage g:/ gl-max-hitpoints)
                (up-modify-goal gl-hitpoint-percentage c:* 100)
                (up-modify-goal gl-hitpoint-percentage c:/ 150)
                (up-modify-goal gl-hitpoint-percentage c:+ 33) ;En unit på 50% hp vil så ende på 66,6%
                (up-get-object-data object-data-player gl-player)
                (up-modify-sn sn-focus-player-number g:= gl-player)
            )

            (defrule
            (up-set-target-object search-remote g: gl-index-number)
                (up-object-data object-data-upgrade-type == militiaman)
                =>
                (set-goal gl-unit-score 100)
            )

            (defrule
            (up-set-target-object search-remote g: gl-index-number)
                (up-object-data object-data-upgrade-type == man-at-arms)
                =>
                (set-goal gl-unit-score 180)
            )

            (defrule
            (up-set-target-object search-remote g: gl-index-number)
            (players-current-age focus-player == dark-age)
                (up-object-data object-data-upgrade-type == scout-cavalry)
                =>
                (set-goal gl-unit-score 80)
            )

            (defrule
            (up-set-target-object search-remote g: gl-index-number)
            (players-current-age focus-player == feudal-age)
                (up-object-data object-data-upgrade-type == scout-cavalry)
                =>
