                ; Change building system

                    (defrule
                    (up-compare-goal gl-building-system == build-line-system)
                    (or(up-compare-goal gl-need-stable == YES)
                    (or(up-compare-goal gl-need-blacksmith == YES)
                    (or(up-compare-goal gl-need-house == YES)
                    (or(up-compare-goal gl-need-barracks == YES)
                    (up-compare-goal gl-need-mining-camp == YES)))))
                        =>
                        (set-goal gl-building-system standard-system) ;denne ændring forhindrer gemte vill id's i at blive ændret
                        (set-strategic-number sn-cap-civilian-builders 99)
                    )

                    (defrule
                    (up-compare-goal gl-building-system == standard-system)
                    (up-compare-goal gl-need-stable == NO)
                    (up-compare-goal gl-need-blacksmith == NO)
                    (up-compare-goal gl-need-mining-camp == NO)
                    (up-compare-goal gl-need-house == NO)
                    (up-compare-goal gl-need-barracks == NO)
                        =>
                        (set-goal gl-building-system build-line-system)
                        (set-strategic-number sn-cap-civilian-builders 0)
                        (set-goal gl-reset-builders YES)
                    )

                ; Reset builders after standard-system -> build-line-system

                    (defrule
                        (goal gl-reset-builders YES)
                        =>
                                    (up-full-reset-search)
                                    (up-find-local c: villager-class c: 200)
                                    (up-remove-objects search-local object-data-type != 118) ; male builder
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp1)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp2)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp3)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp4)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp5)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp6)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp7)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp8)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp9)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp10)
                                    
                    )

                    (defrule
                        (goal gl-reset-builders YES)
                        =>
                                    
                                    (up-remove-objects search-local object-data-id g:== gl-first-assigned-farming-vill) 
                                    (up-remove-objects search-local object-data-id g:== gl-second-assigned-farming-vill) 
                                    (up-remove-objects search-local object-data-id g:== gl-third-assigned-farming-vill) 
                                    (up-remove-objects search-local object-data-id g:== gl-forth-assigned-farming-vill) 
                                    (up-remove-objects search-local object-data-id g:== gl-fifth-assigned-farming-vill) 
                                    (up-set-target-object search-local c: 0)
                                    ;(up-target-objects 1 action-stop -1 -1 )
                    )

                    (defrule
                        (goal gl-reset-builders YES)
                        =>
                        (up-full-reset-search)
                                    (up-find-local c: villager-class c: 200)
                                    (up-remove-objects search-local object-data-type != 212) ; female builder
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp1)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp2)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp3)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp4)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp5)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp6)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp7)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp8)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp9)
                                    (up-remove-objects search-local object-data-id g:== gl-psudo-temp10)
                                    
                    )

                    (defrule
                        (goal gl-reset-builders YES)
                        =>
                        
                                    (up-remove-objects search-local object-data-id g:== gl-first-assigned-farming-vill) 
                                    (up-remove-objects search-local object-data-id g:== gl-second-assigned-farming-vill) 
                                    (up-remove-objects search-local object-data-id g:== gl-third-assigned-farming-vill) 
                                    (up-remove-objects search-local object-data-id g:== gl-forth-assigned-farming-vill) 
                                    (up-remove-objects search-local object-data-id g:== gl-fifth-assigned-farming-vill) 
                                    (up-set-target-object search-local c: 0)
                                    ;(up-target-objects 1 action-stop -1 -1 )
                                    (set-goal gl-reset-builders NO)
                    )

                ; Build buildings with standard system

                    (defrule
                    (up-compare-goal gl-need-barracks == YES)
                        (can-build barracks) ;standard system er slået til
                        (up-pending-objects c: barracks == 0)
                        (goal gl-building-placed-this-pass NO)
                        =>
                        (up-set-target-point gl-second-lumber-camp-location-x)
                    (up-build place-point 0 c: barracks)
                    (set-goal gl-building-placed-this-pass YES)
                    (up-copy-point gl-final-target-point-x gl-second-lumber-camp-location-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-lerp-tiles gl-final-target-point-x gl-position-self-x c: 3)
                    ;(chat-to-all "build special barracks")
                    (disable-timer barracks-timer)
                    )

                    (defrule
                    (up-compare-goal gl-need-house == YES)
                        (can-build house) ;standard system er slået til
                        (up-pending-objects c: house == 0)
                        (goal gl-building-placed-this-pass NO)
                        (building-type-count house <= 5)
                        =>
                        (up-set-target-point gl-first-lumber-camp-location-x)
                    (up-build place-point 0 c: house)
                    (set-goal gl-building-placed-this-pass YES)
                    (up-copy-point gl-final-target-point-x gl-first-lumber-camp-location-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-lerp-tiles gl-final-target-point-x gl-position-self-x c: 5)
                    ;(chat-to-all "build special house1")
                    )
                    
                    (defrule
                    (up-compare-goal gl-need-stable == YES)
                        (can-build stable) ;standard system er slået til
                        (up-pending-objects c: stable == 0)
                        (goal gl-building-placed-this-pass NO)
                        =>
                        (up-set-target-point gl-second-lumber-camp-location-x)
                    (up-build place-point 0 c: stable)
                    (set-goal gl-building-placed-this-pass YES)
                    (up-copy-point gl-final-target-point-x gl-second-lumber-camp-location-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-lerp-tiles gl-final-target-point-x gl-position-self-x c: 3)
                    ;(chat-to-all "build special stable1")
                    )

                    (defrule
                        (current-age == feudal-age)
                        (building-type-count-total stable > 1)
                        =>
                        (up-full-reset-search)
                        (up-filter-status c: status-pending c: list-active)
                        (up-find-status-local c: stable c: 2)
                        (up-clean-search search-local object-data-id search-order-asc)
                        (up-remove-objects search-local object-data-index == 0)
                    )

                    (defrule
                        (current-age == feudal-age)
                        (building-type-count-total stable > 1)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-remove-objects search-local object-data-type == knight)
                        (up-remove-objects search-local object-data-type == spearman)
                        (up-remove-objects search-local object-data-type == archer)
                        (up-remove-objects search-local object-data-type == hand-cannoneer)
                        (up-remove-objects search-local object-data-type == battering-ram)
                        (up-target-point gl-point-x action-delete -1 -1)
                    )
                    
                    (defrule
                    (up-compare-goal gl-need-blacksmith == YES)
                        (can-build blacksmith) ;standard system er slået til
                        (up-pending-objects c: blacksmith == 0)
                        (goal gl-building-placed-this-pass NO)
                        =>
                    (up-set-target-point gl-first-lumber-camp-location-x)
                    (up-build place-point 0 c: blacksmith)
                    (set-goal gl-building-placed-this-pass YES)
                    (up-copy-point gl-final-target-point-x gl-first-lumber-camp-location-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-lerp-tiles gl-final-target-point-x gl-position-self-x c: 3)
                    ;(chat-to-all "build special blacksmith")
                    )

                    (defrule
                    (up-compare-goal gl-need-mining-camp == YES)
                        (can-build mining-camp) ;standard system er slået til
                        (up-pending-objects c: mining-camp == 0)
                        (goal gl-building-placed-this-pass NO)
                        =>
                    (build mining-camp)
                    (set-goal gl-building-placed-this-pass YES)
                    ;(chat-to-all "build special mining-camp 3")
                    (set-goal gl-fail-safe-building-point get-mining-camp-point)
                    )

                    (defrule
                        (goal gl-fail-safe-building-point get-mining-camp-point)
                        =>
                        (up-full-reset-search)
                        (set-strategic-number sn-focus-player-number my-player-number)
                        (up-filter-status c: status-pending c: list-active)
                        (up-find-status-remote c: mining-camp c: 1)
                    )

                    (defrule
                        (goal gl-fail-safe-building-point get-mining-camp-point)
                        (up-set-target-object search-remote c: 0)
                        =>
                        (up-get-point position-object gl-mining-camp-location-x)
                        (set-goal gl-fail-safe-building-point -1)
                    )

            ;
            ;Chose building to place
                

                        (defrule
                            (can-afford-building blacksmith)
                            (building-type-count-total blacksmith < 1)
                            (building-type-count-total stable > 0)
                            (current-age == feudal-age)
                            (up-compare-goal gl-building-system == build-line-system)
                            =>
                            (up-full-reset-search)
                            (up-copy-point gl-position-self-x gl-first-lumber-camp-location-x)
                            (up-get-point position-self gl-true-position-self-x)
                            (up-get-point position-center gl-center-x)
                            ;(up-modify-goal gl-position-self-x c:+ 6)
                            ;(up-modify-goal gl-position-self-y c:+ 6)
                            ;(up-cross-tiles gl-position-self-x gl-center-x c: 9)
                            (up-cross-tiles gl-position-self-x gl-true-position-self-x c: -1)
                            (up-cross-tiles gl-position-self-x gl-true-position-self-x c: -1)
                            (up-lerp-tiles gl-position-self-x gl-center-x c: 0) ; barracks placement
                            ;(up-lerp-tiles gl-position-self-x gl-center-x c: 5)
                            (set-goal gl-building-tiles 5)
                            ;(up-send-flare gl-position-self-x)
                            (set-goal gl-build-blacksmith YES)
                            (up-copy-point gl-new-building-spot-x gl-position-self-x)
                            (disable-self)
                        )

                        (defrule ; 6. house 
                            (can-afford-building house)
                            (building-type-count-total house < 6)
                            (building-type-count-total stable > 0)
                            (building-type-count-total blacksmith > 0)
                            (current-age == feudal-age)
                            (up-compare-goal gl-building-system == build-line-system)
                            =>
                            (up-full-reset-search)
                            (up-get-point position-self gl-true-position-self-x)
                            (up-copy-point gl-position-self-x gl-first-lumber-camp-location-x)

                            (up-lerp-tiles gl-position-self-x gl-true-position-self-x c: 3) 
                            (set-goal gl-building-tiles 4)
                            ;(up-send-flare gl-position-self-x)
                            ;(set-goal gl-build-house YES)
                            (up-copy-point gl-new-building-spot-x gl-position-self-x)
                            ;(chat-to-all "building house rule 2")
                            (disable-self)
                        )
            ;Send villagers to building foundations
                (defrule
                            (up-pending-objects c: barracks == 1)
                            =>
                            (up-full-reset-search)
                            (set-strategic-number sn-focus-player-number my-player-number)
                            (up-filter-status c: status-pending c: list-active)
                            (up-find-status-remote c: barracks c: 1)
                            (up-remove-objects search-remote object-data-tasks-count > 0)
                )

                            (defrule
                            (up-pending-objects c: barracks == 1)
                            (up-set-target-object search-remote c: 0)
                                =>
                            (up-find-local c: villager-class c: 200)
                             ;fase 1
                            (up-remove-objects search-local object-data-group-flag == shepard-group) ;1
                            ;(up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
                            (up-remove-objects search-local object-data-group-flag == berry-group) ;3
                            (up-remove-objects search-local object-data-group-flag == deer-group) ;4
                            (up-remove-objects search-local object-data-group-flag == gold-mining-group) ;5
                                        
                            ;fase 2
                            ;(up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
                            (up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
                            (up-remove-objects search-local object-data-group-flag == farming-group) ;8
                            (up-remove-objects search-local object-data-type == 212) ;builder
                            (up-remove-objects search-local object-data-type == 118) ;builder
                            (up-clean-search search-local object-data-id search-order-asc)
                            (up-remove-objects search-local object-data-index != 0)
                            (up-target-objects 0 action-default -1 -1)
                            ;(chat-to-player my-player-number "trying to send vill to barrack")
                        )
                        
                        (defrule
                            (up-pending-objects c: stable > 0)
                            =>
                            (up-full-reset-search)
                            (set-strategic-number sn-focus-player-number my-player-number)
                            (up-filter-status c: status-pending c: list-active)
                            (up-find-status-remote c: stable c: 1)
                            (up-remove-objects search-remote object-data-tasks-count > 2)
                    )
                        (defrule
                            (up-pending-objects c: stable > 0)
                            (up-set-target-object search-remote c: 0)
                                =>
                            (up-find-local c: villager-class c: 200)
                             ;fase 1
                            (up-remove-objects search-local object-data-group-flag == shepard-group) ;1
                            (up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
                            (up-remove-objects search-local object-data-group-flag == berry-group) ;3
                            (up-remove-objects search-local object-data-group-flag == deer-group) ;4
                            (up-remove-objects search-local object-data-group-flag == gold-mining-group) ;5
                                        
                            ;fase 2
                            ;(up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
                            (up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
                            (up-remove-objects search-local object-data-group-flag == farming-group) ;8
                            (up-remove-objects search-local object-data-type == 212) ;builder
                            (up-remove-objects search-local object-data-type == 118) ;builder
                            (up-clean-search search-local object-data-distance search-order-asc)
                            (up-remove-objects search-local object-data-index > 1)
                            (up-target-objects 0 action-default -1 -1)
                            ;(chat-to-player my-player-number "trying to send 2 vills to stable")
                        )

                (defrule
                            (up-pending-objects c: blacksmith > 0)
                            =>
                            (up-full-reset-search)
                            (set-strategic-number sn-focus-player-number my-player-number)
                            (up-filter-status c: status-pending c: list-active)
