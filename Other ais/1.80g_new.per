                ; Tjeck hver villager for om deres target via loop og fjern hvert pass et træ hvis det har en vill på.

                    ; Sender idle vills i første tree-group til de rigtige træer. Virker kun 1 gange per pass grundet task-count
                    
                    (defrule
                                ;(building-type-count lumber-camp > 0)
                        (up-compare-goal gl-second-lumber-camp-location-x != -1)
                        (wood-amount >= 2)
                                =>
                                (set-goal gl-confused-vill-loop-counter 0)
                                (set-goal gl-confused-vill-target -2)
                                (set-goal gl-suitable-tree -1)
                                (up-reset-filters)
                            )


                            (defrule ;vælger en vill ad gangen og finder dennes target
                                ;(building-type-count lumber-camp > 0)
                        (up-compare-goal gl-second-lumber-camp-location-x != -1)
                        (wood-amount >= 2)
                        (up-set-target-object search-remote c: 0)
                        (goal gl-wait-for-next-pass -1)
                                                        =>
                                (up-get-object-data object-data-tasks-count gl-tasks-count)
                                (up-reset-search 1 1 0 0) ; reset local list
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != second-tree-group) ; virker ikke
                        (up-remove-objects search-local object-data-id g:== gl-feudal-stone-vill)
                                (up-clean-search search-local object-data-id search-order-asc)
                                (up-remove-objects search-local object-data-index g:!= gl-confused-vill-loop-counter)
                            ) 
                                
                        (defrule
                            (up-set-target-object search-local c: 0)
                            ;(building-type-count lumber-camp > 0)
                        (up-compare-goal gl-second-lumber-camp-location-x != -1)
                        (wood-amount >= 2)
                        (goal gl-wait-for-next-pass -1)
                            =>
                            (up-get-object-target-data object-data-id gl-confused-vill-target)
                                (up-remove-objects search-remote object-data-tasks-count >= 3) 
                        )
                                
                        (defrule ; tjekker om der er et træ uden vills på og gemmer dets ID
                            ;(building-type-count lumber-camp > 0)
                        (up-compare-goal gl-second-lumber-camp-location-x != -1)
                        (up-set-target-object search-remote c: 0) 
                        (wood-amount >= 2)
                        (goal gl-wait-for-next-pass -1)
                            =>
                            (up-get-object-data object-data-id gl-suitable-tree)
                                (up-remove-objects search-local object-data-idling c:!= 1) ; 
                            )
                        
                            (defrule ; tjekker om den fundne vill er idle og klikker ham på træet
                                (up-compare-goal gl-confused-vill-target g:!= gl-suitable-tree)
                                ;(building-type-count lumber-camp > 0)
                        (up-compare-goal gl-second-lumber-camp-location-x != -1)
                        (or(up-timer-status semitrush-timer != timer-running)
                        (current-age == dark-age))
                        (up-set-target-object search-remote c: 0) 
                        (up-set-target-object search-local c: 0)
                        (wood-amount >= 2)
                        (goal gl-wait-for-next-pass -1)
                                =>
                                (up-target-objects 0 action-default -1 -1)
                                (set-goal gl-suitable-tree -1)
                                (set-goal gl-wait-for-next-pass 1) ; giver lidt idle time men en flottere fordeling. Kan evt fjernes
                            )
                        
                            (defrule
                                (up-compare-goal gl-confused-vill-loop-counter <= 6)
                                (wood-amount >= 2)
                                (goal gl-wait-for-next-pass -1)
                                =>
                                (up-modify-goal gl-confused-vill-loop-counter c:+ 1)
                                (up-jump-rule -5)
                            )

                            (defrule
                                (true)
                                =>
                                (set-goal gl-wait-for-next-pass -1)
                            )
            
            ;
            ; direkting skipping rule
                (defrule
                (true)
                =>
                (up-get-rule-id gl-end-of-lumber-jack-retasking-rule)
                )
            ;
            ;Making vills drop off food to go to 2. lc

                (defrule
                    (up-compare-goal gl-fase == 2)
                    (up-compare-goal gl-second-lumber-camp-location-x != -1)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != second-tree-group)
                    (up-remove-objects search-local object-data-carry == 0)
                    (up-remove-objects search-local object-data-type == 218) ; male lumberjack
                    (up-remove-objects search-local object-data-type == 123) ; female lumberjack
                    (up-remove-objects search-local object-data-type == 212) ; female builder
                    (up-remove-objects search-local object-data-type == 118) ; male builder
                    (up-remove-objects search-local object-data-type == 579) ; male gold miner
                    (up-remove-objects search-local object-data-type == 581) ; female gold miner
                    (up-remove-objects search-local object-data-id g:== gl-feudal-stone-vill)
                    (up-get-search-state gl-local-total)
                )

                (defrule
                    (up-compare-goal gl-fase == 2)
                    (up-compare-goal gl-second-lumber-camp-location-x != -1)
                    (up-compare-goal gl-local-total > 0)
                    =>
                    (set-strategic-number sn-focus-player-number my-player-number);12345
                    (up-find-remote c: town-center c: 1)
                    (up-target-objects 0 action-default -1 -1)
                    ;;(chat-to-all "rule running")
                )
            
            ;;;; manglende vills på 1. lc ;;;; bør opdateres senere

                (defrule
                    (unit-type-count villager >= 100) ; 10
                    ; fix!
                        =>
                        (up-full-reset-search)
                        (up-get-point position-self gl-position-self-x)
                        (up-set-target-point gl-position-self-x)
                        (up-filter-distance c: 0 c: 10)
                        (up-find-local c: villager-class c: 30)
                        (up-set-target-point gl-first-lumber-camp-location-x) ; så den ikke kambulerer med træ retasking
                        (up-remove-objects search-local object-data-distance <= 9) ;
                        (up-remove-objects search-local object-data-idling c:!= 1)
                        (up-remove-objects search-local object-data-id g:== gl-first-boar-luring-villager)
                        (up-remove-objects search-local object-data-id g:== gl-second-boar-luring-villager)
                        (up-remove-objects search-local object-data-id g:== gl-feudal-stone-vill)
                        (up-copy-point gl-position-new-x gl-first-lumber-camp-location-x)
                        (up-lerp-tiles gl-position-new-x gl-position-self-x c: 7)
                        (up-set-target-point gl-position-new-x)
                        (up-target-point gl-position-new-x action-default -1 -1)
                        ;;(chat-to-all "jeg skaber problemer")
                        ;(disable-self)
                    )

            ;;;; second lc ;;;;



            ;;; straggler vills

                ; 1.70 aproach

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp1 3)
                    )

                    (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-get-point position-self gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-filter-distance c: -1 g: gl-temp1)
                    (up-filter-status c: status-ready c: list-active)
                    (up-find-resource c: wood c: 40)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: wood c: 40)
                    (up-get-search-state gl-local-total)
                    )

                    (defrule
                    (up-compare-goal gl-remote-total < 10)
                    (up-compare-goal gl-temp1 < 8)
                    =>
                    (up-modify-goal gl-temp1 c:+ 1)
                    (up-jump-rule -2)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp1 2)
                        (set-goal gl-temp3 0)
                    )

                    (defrule
                    (up-compare-goal gl-first-lumber-camp-location-x != -1)
                    =>
                    (up-get-point position-self gl-temp-x)
                    (up-set-target-point gl-first-lumber-camp-location-x)
                    (up-filter-distance c: -1 g: gl-temp1)
                    (up-filter-status c: status-ready c: list-active)
                    (up-find-resource c: wood c: 40)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: wood c: 40)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp3 g:= gl-remote-total)
                    )

                    (defrule
                    (up-compare-goal gl-second-lumber-camp-location-x != -1)
                    =>
                    (up-set-target-point gl-second-lumber-camp-location-x)
                    (up-filter-distance c: -1 g: gl-temp1)
                    (up-filter-status c: status-ready c: list-active)
                    (up-find-resource c: wood c: 40)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: wood c: 40)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-remote-total g:+ gl-temp3)
                    )

                    (defrule
                    (up-compare-goal gl-remote-total < 10)
                    (up-compare-goal gl-temp1 < 6)
                    =>
                    (up-modify-goal gl-temp1 c:+ 1)
                    (up-jump-rule -3)
                    )
                    
                    (defrule 
                    (true)
                    =>
                    (up-reset-filters)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != pre-farming-straggler-group)
                    (up-remove-objects search-local object-data-idling c:!= 1)
                    )

                    (defrule
                        (up-set-target-object search-remote c: 0)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-point position-object gl-temp-x)
                        (up-set-target-point gl-temp-x)
                        (up-clean-search search-remote object-data-distance search-order-asc)
                        (up-target-objects 0 action-default -1 -1)
                        (up-remove-objects search-local object-data-index == 0)
                        (up-jump-rule -1)
                        ;(chat-to-all "rule running")
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp3 0)
                    )

                    (defrule 
                    (true)
                    =>
