                    ;lad os starte med at få antallet af enemy archers, skirms, knights, eagles, andet infanry og 
                    ;andet cavalry ind i hver sine goals.






                    (defrule
                        (true)
                        =>
                        (up-modify-goal gl-temp13 g:= gl-temp11)
                        (up-modify-goal gl-temp13 c:* 4)
                    )

                    (defrule
                        (taunt-detected my-player-number 97)
                        =>
                        (up-chat-data-to-all "enemy ranged unit score is %d" g: gl-temp10)
                        (up-chat-data-to-all "enemy melee unit score is %d" g: gl-temp11)
                        (up-chat-data-to-all "ranged army score is %d" g: gl-temp12)
                        (up-chat-data-to-all "enemy melee score times 4 is %d" g: gl-temp13)
                    )


                    (defrule
                    ;hvis man står til at være i ranged unit mode bør man kun overgå til melee mode hvis:

                    ; -Der næste ikke er nogen ranged units tilbage og melee units kan gøre skade.
                    ; -Der er farligt mange melee units og de er inden for en given afstand


                    ;Ok. Hvilke indformationer kræver det så at vurdere disse ting og hvor grundig skal jeg være?
                    ;tja... den simpleste version ville vel bare være at kigge på antal archery, infantry og cavalry
                    ;man kunne give point så archers får 1 point. Skirms får 2.
                    ;infantry får 1 i archer mode og 2 i skirm mode
                    ;knights får 5 point for archers og 15 for skirms
                    ;andet cavalry får 2 point for archers og 6 for skirms
                    ;det er nok noget der kræver et friskt sind. Kunne være fedt at ramme rigtigt.
                    (up-compare-goal gl-temp11 > 0) ;melee units exist.

                    (or(up-compare-goal gl-temp11 g:> gl-temp10) ;melee thread bigger than ranged threat.
                    (up-compare-goal gl-temp10 == 0)) ;ranged units does not exist.

                    (up-compare-goal gl-temp12 g:< gl-temp13) ;melee thread bigger than own army strength
                    
                    ;(not(and(up-compare-goal gl-temp12 g:< gl-temp13)
                    ;(goal 11 1))) ;not in superior mode with only slightly better army

                    ;(up-compare-goal gl-remote-total > 0)
                    ;(or(up-compare-goal gl-remote-total > 5)
                    ;(or(up-compare-goal gl-temp17 < 10)
                    ;(goal gl-skirm-group-chosen -1)))
                    =>
                    ;(up-chat-data-to-all "gl-remote-total is %d" g: gl-remote-total)
                    ;(up-chat-data-to-all "gl-local-total is %d" g: gl-local-total)
                    ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                    (set-goal gl-archer-micro-priority melee-units)
                    (set-goal 11 -1)
                    ;(chat-to-all "running")
                    )






                    ;konverter alle all units scenarier til ranged units

                    (defrule
                        (true)
                        =>
                        (set-goal 14 -1)
                    )

                    (defrule
                        (goal gl-archer-micro-priority all-units)
                        (not(goal gl-archer-micro-priority melee-units))
                        =>
                        (set-goal gl-archer-micro-priority ranged-units)
                        (set-goal 14 1)
                        (set-goal 11 1)
                    )

