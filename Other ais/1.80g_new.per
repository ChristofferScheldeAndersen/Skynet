                        (set-goal gl-cow-detecter -1)
                        (set-goal gl-sheep-reserve -1)
                        (up-modify-goal gl-sheep-counter c:= 0)
                        (disable-self)
                    )

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: livestock-class c: 100)
                    (up-remove-objects search-local object-data-id g:== gl-sheepcount1-id)
                    (up-remove-objects search-local object-data-id g:== gl-sheepcount2-id)
                    (up-remove-objects search-local object-data-id g:== gl-sheepcount3-id)
                    (up-remove-objects search-local object-data-id g:== gl-sheepcount4-id)
                    (up-remove-objects search-local object-data-id g:== gl-sheepcount5-id)
                    (up-remove-objects search-local object-data-id g:== gl-sheepcount6-id)
                    (up-remove-objects search-local object-data-id g:== gl-sheepcount7-id)
                    (up-remove-objects search-local object-data-id g:== gl-sheepcount8-id)
                    (up-get-search-state gl-local-total)
                )

                (defrule
                    (up-compare-goal gl-local-total > 0)
                    (up-compare-goal gl-sheepcount1-id == -1)
                    =>
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-id gl-sheepcount1-id)
                    (up-remove-objects search-local object-data-index == 0)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-sheep-counter c:+ 1)
                    ;(up-chat-data-to-player my-player-number "Found %d. sheep" g: gl-sheep-counter)
                )

                (defrule
                    (up-compare-goal gl-local-total > 0)
                    (up-compare-goal gl-sheepcount2-id == -1)
                    =>
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-id gl-sheepcount2-id)
                    (up-remove-objects search-local object-data-index == 0)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-sheep-counter c:+ 1)
                    ;(up-chat-data-to-player my-player-number "Found %d. sheep" g: gl-sheep-counter)
                )

                (defrule
                    (up-compare-goal gl-local-total > 0)
                    (up-compare-goal gl-sheepcount3-id == -1)
                    =>
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-id gl-sheepcount3-id)
                    (up-remove-objects search-local object-data-index == 0)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-sheep-counter c:+ 1)
                    ;(up-chat-data-to-player my-player-number "Found %d. sheep" g: gl-sheep-counter)
                )

                (defrule
                    (up-compare-goal gl-local-total > 0)
                    (up-compare-goal gl-sheepcount4-id == -1)
                    =>
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-id gl-sheepcount4-id)
                    (up-remove-objects search-local object-data-index == 0)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-sheep-counter c:+ 1)
                    ;(up-chat-data-to-player my-player-number "Found %d. sheep" g: gl-sheep-counter)
                )

                (defrule
                    (up-compare-goal gl-local-total > 0)
                    (up-compare-goal gl-sheepcount5-id == -1)
                    =>
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-id gl-sheepcount5-id)
                    (up-remove-objects search-local object-data-index == 0)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-sheep-counter c:+ 1)
                    ;(up-chat-data-to-player my-player-number "Found %d. sheep" g: gl-sheep-counter)
                )

                (defrule
                    (up-compare-goal gl-local-total > 0)
                    (up-compare-goal gl-sheepcount6-id == -1)
                    =>
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-id gl-sheepcount6-id)
                    (up-remove-objects search-local object-data-index == 0)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-sheep-counter c:+ 1)
                    ;(up-chat-data-to-player my-player-number "Found %d. sheep" g: gl-sheep-counter)
                )

                (defrule
                    (up-compare-goal gl-local-total > 0)
                    (up-compare-goal gl-sheepcount7-id == -1)
                    =>
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-id gl-sheepcount7-id)
                    (up-remove-objects search-local object-data-index == 0)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-sheep-counter c:+ 1)
                    ;(up-chat-data-to-player my-player-number "Found %d. sheep" g: gl-sheep-counter)
                )

                (defrule
                    (up-compare-goal gl-local-total > 0)
                    (up-compare-goal gl-sheepcount8-id == -1)
                    =>
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-id gl-sheepcount8-id)
                    (up-remove-objects search-local object-data-index == 0)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-sheep-counter c:+ 1)
                    ;(up-chat-data-to-player my-player-number "Found %d. sheep" g: gl-sheep-counter)
                )
            ;C Cow detecter
                
                (defrule
                    (game-time > 5)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: livestock-class c: 20)
                    (up-remove-objects search-local object-data-carry < 150)
                )

                (defrule
                (game-time > 5)
                    (up-set-target-object search-local c: 0)
                    =>
                    (set-goal gl-cow-detecter 1)
                    ;(chat-to-player my-player-number "cows detected")
                    (disable-self)
                )
                
        ; 1 Initiate deer luring
            (defrule
                (true)
                =>
                (set-strategic-number focus-player 0)
                (up-full-reset-search)
                (up-get-point position-self gl-temp1-x)
                (up-set-target-point gl-temp1-x)
                (up-filter-distance c: -1 c: 30)
            )

            (defrule
            (or(and(up-compare-goal gl-sheep-counter == 8)
            (and(up-compare-goal gl-boar-counter == 2)
            (game-time > 240)))
            (and(game-time > 420)
            (up-compare-goal gl-boar-counter > 0)))
            =>
            (set-goal gl-split-rule 62)
            )

            (defrule
                (or(goal gl-split-rule 62)
                (and(goal gl-cow-detecter 1)
            (and(up-compare-goal gl-sheep-counter >= 6)
            (and(up-compare-goal gl-boar-counter == 2)
            (goal gl-first-boar-status first-boar-is-dead)))))
            (goal gl-deer-found YES)
            (not(up-find-remote c: livestock-class c: 1))
            =>
            (set-goal gl-split-rule 0)
            (set-goal gl-deer-luring-stage Looking-for-deers)
            ;(chat-to-all "enable deer luring")
            (disable-self)
            )
            

        ; 2 Finding deer
            ;first make sure there is deer close by
            (defrule
                (game-time > 5)
                =>
                (up-full-reset-search)
                (up-filter-distance c: -1 c: 34)
                (set-strategic-number sn-focus-player-number 0)
                (up-find-remote c: 909 c: 40)
                (up-remove-objects search-remote object-data-carry < 100)
            )

            (defrule
                (game-time > 5)
                (up-set-target-object search-remote c: 0)
                =>
                ;(chat-to-all "deer found")
                (set-goal gl-deer-found YES)
                (disable-self)
            )
            ;


            ; alternativ regel til at finde boar der er tråt ind i synsfelt uden at være scouted

                (defrule
                (game-time > 240)
                =>
                (up-full-reset-search)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-deer-id-checker g:= gl-first-gaia-id)
                (set-goal gl-temp-x -1)
                )

                (defrule
                (game-time > 240)
                (up-compare-goal gl-deer-found == -1)
                    (up-set-target-by-id g: gl-deer-id-checker)
                    (up-object-data object-data-class == 909)
                    (up-object-data object-data-carry > 100)
                    (up-object-data object-data-hitpoints > 0)
                    (up-object-data object-data-distance < 35)
                    =>
                    (set-goal gl-temp-x -1)
                    (up-get-point position-object gl-temp-x)
                )

                    (defrule
                    (game-time > 240)
                        (up-point-explored gl-temp-x != explored-no)
                        (up-compare-goal gl-deer-found == -1)
                        =>
                (set-goal gl-deer-found YES)
                ;(chat-to-all "found deer SPECIAL RULE")
                (disable-self)
                )

                (defrule
                (game-time > 240)
                (up-compare-goal gl-deer-found == -1)
                    (up-compare-goal gl-deer-id-checker g:< gl-last-gaia-id)
                    (up-compare-goal gl-deer-eating-stage != No-more-deer)
                    =>
                    (up-modify-goal gl-deer-id-checker c:+ 1)
                    (up-jump-rule -3)
                )



            ; disse 4 regler finder alle deers i nærområdet, får dem på remote list og husker ID'et på den nærmeste.

            (defrule ;bugfix
                (true)
                =>
                (set-goal gl-remote-total -1)
            )

            (defrule
                (goal gl-deer-luring-stage Looking-for-deers)
                =>
                (up-full-reset-search)
                (up-get-search-state gl-local-total)
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-modify-goal gl-deer-id-checker g:= gl-first-gaia-id)
            )

            (defrule
                (goal gl-deer-luring-stage Looking-for-deers)
                (up-set-target-by-id g: gl-deer-id-checker)
                (up-object-data object-data-class == 909)
                (up-object-data object-data-carry > 0)
                (up-object-data object-data-hitpoints > 0)
                (up-object-data object-data-distance < 37)
                =>
            (up-get-object-data object-data-id gl-current-deer-id)
            (up-add-object-by-id search-remote g: gl-current-deer-id)
            (up-get-search-state gl-local-total)
            ;;(up-chat-data-to-player my-player-number "gl-remote-total is %d." g: gl-local-total)
            )

            (defrule
            (goal gl-deer-luring-stage Looking-for-deers)
                (up-compare-goal gl-deer-id-checker g:< gl-last-gaia-id)
                (up-compare-goal gl-deer-eating-stage != No-more-deer)
                =>
                (up-modify-goal gl-deer-id-checker c:+ 1)
                (up-jump-rule -2)
            )
            
            (defrule ; Slukker deer luring når der ikke er flere deers
            (goal gl-deer-luring-stage No-more-deer)
                (up-compare-goal gl-deer-id-checker g:== gl-last-gaia-id)
                (up-compare-goal gl-remote-total == 0)
                (game-time > 420) ; den tror der ikke er flere hvis de ikke er fundet inden deer luring enables
                =>
                ;(chat-to-all "No more deer to eat 1")
                (set-goal gl-deer-eating-stage No-more-deer)
                (disable-self)
            )

            (defrule
                (goal gl-deer-luring-stage Looking-for-deers)
                =>
                (up-get-search-state gl-local-total)
                ;;;(up-chat-data-to-all "Number of deers on map is %d." g: gl-remote-total)
                (up-set-target-object search-local c: 0)
                (up-remove-objects search-remote object-data-distance > 37)
                (up-get-search-state gl-local-total)
                ;;;(up-chat-data-to-all "Number of deers close to you is %d." g: gl-remote-total)
                (up-remove-objects search-remote object-data-index > 3)
                (up-get-search-state gl-local-total)
                (up-clean-search search-remote object-data-distance search-order-asc)
                (up-set-target-object search-remote c: 0)
                (up-get-object-data object-data-id gl-current-deer-id)
                (up-get-object-data object-data-speed gl-deer-speed)
            )
        
            
            (defrule ; vælg en anden deer hvis den er på vej tilbage

                (goal gl-deer-luring-stage Looking-for-deers)
                (up-object-data object-data-action == actionid-move)
                (goal gl-deer-speed 73)
                (timer-triggered deer-walking-timer)
                (up-compare-goal gl-remote-total > 0)
                =>
                (up-get-object-data object-data-id gl-bad-deer)
                (up-remove-objects search-remote object-data-index == 0)
                (up-set-target-object search-remote c: 0)
                (up-get-object-data object-data-id gl-current-deer-id)
                ;;(chat-to-all "deer is walking. Chosen new deer for luring")
                (up-get-search-state gl-local-total)
                (up-jump-rule -1)
            )

            

            (defrule ; videre
                (goal gl-deer-luring-stage Looking-for-deers)
                =>
                (set-goal gl-deer-luring-stage Sending-scout-to-deer)
            )





            (defrule
                (goal gl-deer-luring-stage No-more-deer)
                =>
                (up-full-reset-search)
                (up-get-search-state gl-local-total)
                (up-find-local c: town-center c: 1)
                (up-set-target-object search-local c: 0)
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-get-object-data object-data-id gl-deer-id-checker)
                (up-modify-goal gl-deer-id-checker g:= gl-first-gaia-id)
            )

            (defrule
                (goal gl-deer-luring-stage No-more-deer)
                (up-set-target-by-id g: gl-deer-id-checker)
                (up-object-data object-data-class == 909)
                (up-object-data object-data-carry > 0)
                ;(up-object-data object-data-hitpoints > 0) find også eating deer
                (up-object-data object-data-distance < 35)
                =>
            (up-get-object-data object-data-id gl-current-deer-id)
            (up-add-object-by-id search-remote g: gl-current-deer-id)
            (up-get-search-state gl-local-total)
            ;;(up-chat-data-to-player my-player-number "gl-remote-total is %d." g: gl-local-total)
            )

            (defrule
            (goal gl-deer-luring-stage No-more-deer)
                (up-compare-goal gl-deer-id-checker g:< gl-last-gaia-id)
                (up-compare-goal gl-deer-eating-stage != No-more-deer)
                =>
                (up-modify-goal gl-deer-id-checker c:+ 1)
                (up-jump-rule -2)
            )
            
            (defrule ; Slukker deer luring når der ikke er flere deers
            (goal gl-deer-luring-stage No-more-deer)
                (up-compare-goal gl-deer-id-checker g:< gl-last-gaia-id)
                (up-compare-goal gl-remote-total == 0)
                (game-time > 420) ; den tror der ikke er flere hvis de ikke er fundet inden deer luring enables
                =>
                ;(chat-to-all "No more deer to eat 2")
                (set-goal gl-deer-eating-stage No-more-deer)
                (disable-self)
            )

            (defrule ; Slukker deer luring når der ikke er flere deers
                (or(game-time > 900)
                (and(game-time > 850) ; den tror der ikke er flere hvis de ikke er fundet inden deer luring enables
                (or(unit-type-count scout-cavalry-line == 0)
                (not(up-set-target-by-id g: gl-eating-deer)))))
                
                =>
                ;(chat-to-all "No more deer to eat 3")
                (set-goal gl-deer-eating-stage No-more-deer)
                (disable-self)
            )





        ; 3 Send scout to deer
            (defrule ; er i tvivl om denne regel gør noget, men ideen er at undgå at starte med at skubbe den gale vej
                (goal gl-deer-luring-stage Sending-scout-to-deer)
                =>
                (up-full-reset-search)
                (set-strategic-number sn-target-point-adjustment 5)
                (up-add-object-by-id search-local g: gl-scout-id)
                (up-add-object-by-id search-remote g: gl-current-deer-id)
                (up-get-point position-object gl-deer-position-x)
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-lerp-tiles gl-deer-position-x gl-position-self-x c: -2)
                (up-target-point gl-deer-position-x action-move -1 -1)
                ;(chat-to-all "sending scout to deer")
                (set-goal gl-deer-luring-stage Luring-deer)
            )

        ; 4 Reset lure if deer is walking back

            ; Disse regler vil uafhængigt af tidspunktet genstarte loopet hvis luring deer er på vej tilbage. Denne "bad-deer"
            ; vil ikke blive forsøgt lured de næste 12 sekunder mens den går tilbage. Dette sker ved at fjerne den fra næste
            ; reglers søgning.
            #load-if-defined DE-AVAILABLE
            
            (defrule
                (up-compare-goal gl-deer-luring-stage != No-more-deer)
                (up-compare-goal gl-current-deer-id != -1)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-current-deer-id)
                        (up-set-target-object search-remote c: 0)
                (up-get-object-data object-data-speed gl-deer-speed)
                ;;;(up-chat-data-to-all "Deer speed is %d." g: gl-deer-speed)
            )

            (defrule
                (goal gl-deer-speed 73)
            (up-object-data object-data-action == actionid-move)
            (not(timer-triggered deer-walking-timer))
            (up-timer-status deer-walking-timer != timer-running)
                =>
                ;(chat-to-all "deer is maybe walking")
                (enable-timer deer-walking-timer 2) 
                )


                (defrule
                    (timer-triggered deer-walking-timer)
                    (not(and(goal gl-deer-speed 73)
            (up-object-data object-data-action == actionid-move)))
                    =>
                    (disable-timer deer-walking-timer)
                    ;(chat-to-all "disable deer walking timer")
                    (enable-timer bad-deer-timer 15)
                )
        
                (defrule
                    (timer-triggered bad-deer-timer)
                    =>
                    (set-goal gl-bad-deer -1)
                )
        
                (defrule
                    (timer-triggered deer-walking-timer)
                    (game-time < 530)
                    =>
                    (set-goal gl-deer-luring-stage Looking-for-deers)
                )
                #end-if

        ; 5 looking for deer again

            ; der laves en ny søgning igen mens der skubbes deer. Dette er nødvendigt fordi der ellers ikke evalueres
            ; hvorvidt den valgte deer stadig er den tætteste mens der skubbes. Da dette tidl har kamboleret med reglen
            ; om at droppe en tilbagegående deer er der nu lavet en regel der fjerner denne "bad deer" fra søgningen.

            (defrule
                    (goal gl-deer-luring-stage Luring-deer)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: town-center c: 1)
                    (up-set-target-object search-local c: 0)
                    (up-get-object-data object-data-id gl-deer-id-checker)
                    (up-modify-goal gl-deer-id-checker g:= gl-first-gaia-id)
                    
                )

                (defrule
                    (goal gl-deer-luring-stage Luring-deer)
                    (up-set-target-by-id g: gl-deer-id-checker)
                    (up-object-data object-data-class == 909)
                    (up-object-data object-data-carry > 0)
                    (up-object-data object-data-hitpoints > 0)
                    =>
                (up-get-object-data object-data-id gl-current-deer-id)
                (up-add-object-by-id search-remote g: gl-current-deer-id)
                )

                (defrule
                (goal gl-deer-luring-stage Luring-deer)
                    (up-compare-goal gl-deer-id-checker g:< gl-last-gaia-id)
                    (up-compare-goal gl-deer-eating-stage != No-more-deer)
                    =>
                    (up-modify-goal gl-deer-id-checker c:+ 1)
                    (up-jump-rule -2)
                )

                (defrule
                    (goal gl-deer-luring-stage Luring-deer)
                    =>
                    (up-get-search-state gl-local-total)
                    ;;;(up-chat-data-to-all "Number of deers on map is %d." g: gl-remote-total)
                    (up-set-target-object search-local c: 0)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-remove-objects search-remote object-data-distance > 35)
                    (up-get-search-state gl-local-total)
                    ;;;(up-chat-data-to-all "Number of deers close to you is %d." g: gl-remote-total)
                    (up-remove-objects search-remote object-data-index > 3)
                    (up-get-search-state gl-local-total)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    (up-remove-objects search-remote object-data-id g:== gl-bad-deer) ;fjern deer der er på vej tilbage
                    (up-set-target-object search-remote c: 0)
                    (up-get-object-data object-data-id gl-current-deer-id)
                    (up-get-object-data object-data-speed gl-deer-speed)
                )

                (defrule ; Slukker deer luring når der ikke er flere deers
            (goal gl-deer-luring-stage Luring-deer)
                (up-compare-goal gl-deer-id-checker g:>= gl-last-gaia-id)
                (up-compare-goal gl-remote-total == 0)
                (game-time > 420) ; den tror der ikke er flere hvis de ikke er fundet inden deer luring enables
                =>
                ;(chat-to-all "No more deer 1")
                (set-goal gl-deer-luring-stage No-more-deer)
                (disable-self)
            )

            (defrule ;
                (true)
                =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-scout-unit)
                (set-goal gl-temp-x -1)
                (set-goal gl-temp-y -1)
                (set-goal gl-temp8-x -1)
                (set-goal gl-temp8-y -1)
                )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-get-point position-object gl-temp-x)
                (up-get-point position-self gl-temp8-x)
            )
            
            (defrule ; Slukker deer luring når der ikke er flere deers
            ;(goal gl-deer-luring-stage Luring-deer)
                (or(game-time > 780) ; den tror der ikke er flere hvis de ikke er fundet inden deer luring enables
                (and(game-time > 580) ;evt op til 60 højere
                (up-point-distance gl-temp-x gl-temp8-x > 20)))
                (goal gl-my-position 5)
                =>
                ;(chat-to-all "No more deer 2")
                (set-goal gl-deer-luring-stage No-more-deer)
                (disable-self)
            )

            (defrule ; Slukker deer luring når der ikke er flere deers
            ;(goal gl-deer-luring-stage Luring-deer)
                (or(game-time > 690) ; den tror der ikke er flere hvis de ikke er fundet inden deer luring enables
                (and(game-time > 580) ;evt op til 60 højere
                (up-point-distance gl-temp-x gl-temp8-x > 20)))
                (goal gl-my-position 3)
                =>
                ;(chat-to-all "No more deer 3")
                (set-goal gl-deer-luring-stage No-more-deer)
                (disable-self)
            )

            (defrule ; Slukker deer luring når der ikke er flere deers
            ;(goal gl-deer-luring-stage Luring-deer)
                (or(game-time > 870) ; den tror der ikke er flere hvis de ikke er fundet inden deer luring enables
                (and(game-time > 720) ;evt op til 60 højere
                (up-point-distance gl-temp-x gl-temp8-x > 20)))
                (goal gl-my-position 4)
                =>
                ;(chat-to-all "No more deer 4")
                (set-goal gl-deer-luring-stage No-more-deer)
                (disable-self)
            )

            (defrule
                (game-time > 530)
                (up-compare-goal gl-deer-luring-stage < Sending-scout-to-deer)
                =>
                (set-goal gl-deer-luring-stage No-more-deer)
                ;(chat-to-all "skipping deer luring if no deer are found at 9 minuts")
                (disable-self)
            )
        ; 6a Retreat scout to tc when attacked by enemy (moved to deer code)

            ;extra - see if enemy is human
                (defrule
                    (true)
                    =>
                    (set-strategic-number sn-focus-player-number 1)
                    (set-goal gl-temp40 -1)
                )

                (defrule
                    (player-human focus-player)
                    (players-stance focus-player enemy)
                    =>
                    (set-goal gl-temp40 1)
                )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )

            ;set retreat goal before deer has been lured    
                (defrule ;
                (true)
