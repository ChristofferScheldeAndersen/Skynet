                                (and(food-amount > 600)
                                (gold-amount > 400))))
                                (not(and(up-compare-goal gl-saving-for-upgrade == saving-for-thumb-ring)
                                (wood-amount < 310)))
                                (goal gl-delay-imp -1)
                                =>
