            ;First boar
                (defrule
                    (up-compare-goal gl-second-boar-id == -1)
                    (up-set-target-by-id g: gl-first-boar-id)
                    =>
                    (set-goal gl-boar-score 0)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                )

                (defrule ; calculate distance
                    (up-compare-goal gl-second-boar-id == -1)
                    (up-set-target-by-id g: gl-first-boar-id)
                    =>
                    (up-get-object-data object-data-distance gl-boar-score)
                    (up-get-object-data object-data-distance gl-temp20)
                )

                (defrule
                    (up-compare-goal gl-temp20 > 40)
                    (up-compare-goal gl-temp20 < 250)
                    =>
                    ;(up-chat-data-to-all "boar distance was %d" g: gl-temp20)
                    ;(up-chat-data-to-all "boar id was %d" g: gl-first-boar-id)
                    (set-goal gl-first-boar-id -1)
                )

                (defrule ; ajust for boar position
                    (up-compare-goal gl-second-boar-id == -1)
                    (up-set-target-by-id g: gl-first-boar-id)
                    (or(up-compare-goal gl-boar-point-relation-to-tc == upper-right-quadrant)
                    (up-compare-goal gl-boar-point-relation-to-tc == upper-right-quadrant))
                    =>
                    (up-modify-goal gl-boar-score c:+ 3)
                )

                (defrule ; ajust for african boars
                    (up-compare-goal gl-second-boar-id == -1)
                    (up-set-target-by-id g: gl-first-boar-id)
                    (up-compare-goal gl-african-boars == YES)
                    =>
                    (up-modify-goal gl-boar-score c:+ 18)
                )

                (defrule ; ajust for game speed in ai games
                    (up-compare-goal gl-second-boar-id == -1)
                    (up-set-target-by-id g: gl-first-boar-id)
                    (up-compare-goal 10 > 1100)
                    =>
                    (up-modify-goal gl-temp g:= 10)
                    (up-modify-goal gl-temp c:- 1000)
                    (up-modify-goal gl-temp c:/ 125)
                    (up-modify-goal gl-boar-score g:+ gl-temp)
                )

                

                    

                #load-if-not-defined DE-AVAILABLE
                (defrule ; ajust for game version
                    (up-compare-goal gl-second-boar-id == -1)
                    (up-set-target-by-id g: gl-first-boar-id)
                    =>
                    (up-modify-goal gl-boar-score c:+ 25)
                )
                #end-if

                (defrule
                    (up-compare-goal gl-second-boar-id == -1)
                    (up-set-target-by-id g: gl-first-boar-id)
                    (up-compare-goal gl-boar-score < 47)
                    =>
                    ;(up-chat-data-to-all "First boar has a score of %d. No loom needed" g: gl-boar-score)
                    (disable-self)
                )

                (defrule
                    (up-compare-goal gl-second-boar-id == -1)
                    (up-set-target-by-id g: gl-first-boar-id)
                    (up-compare-goal gl-boar-score >= 47)
                    =>
                    ;(up-chat-data-to-all "First boar has a score of %d. Loom should be reseached" g: gl-boar-score)
                    (disable-self)
                )
            
