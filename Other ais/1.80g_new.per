                ; Need buildings

                    ; kræver at der er råd til alle bygninger samtidigt. -tower

                    (defrule
                        (can-afford-building house)
                            (housing-headroom < 10)
                            (building-type-count house >= 3)
                            (up-pending-objects c: house == 0)
                            (up-compare-goal gl-building-system == build-line-system)
                        =>
                        ;(set-goal gl-need-house YES)
                        (do-nothing)
