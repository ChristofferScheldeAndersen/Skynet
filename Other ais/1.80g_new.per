        ;B Town-center
            ;A Advancing
                (defrule
                    (current-age == dark-age)
                    =>
                    (set-goal gl-age-status dark)
                    (disable-self)
                )
                
                (defrule
                (not(research-available ri-loom))
                (unit-type-count-total villager >= 27)
                (can-research feudal-age)
                =>
                (research feudal-age)
                (set-goal gl-age-status advancing-to-feudal)
                )

                (defrule
                    (current-age == feudal-age)
                    =>
                    (set-goal gl-age-status feudal)
                    (disable-self)
                )
                
                (defrule
                (can-research castle-age)
                =>
                (research castle-age)
                (set-goal gl-age-status advancing-to-castle)
                )
                
            ;B Villager creation and loom
                    
                ; plan

                ;fase 1: træn til 21 villagers. Herefter vurderes hvor meget food der mangler
                ;for at clicke feudal og hvis dette er over 100 trænes fortsat villagers 
                ;op til 24. Ellers loom. Fjern advancing regler.

                ;fase 2: archer rush
                ;importer nuværende regler for villagers og tillad træning til 24 villagers. 
                ;Advancing kræver minimum 24 villagers.
                ;villgers

                ;fase 2: fc
                ;importer nuværende regler med ændring op til 27 villagers. Advancing kræver
                ; 27 villagers.

                ;lav evt buffer i fase 2. 

                
                (defrule 
                (can-train villager)
                (or(unit-type-count-total villager < 27)
                (and(up-research-status c: feudal-age == research-pending)
                (unit-type-count-total villager < 28)))
                (up-compare-goal gl-strategy == fc-two-tc-one-stable-knights)
                    =>
                (train villager)
                )

                (defrule 
                (unit-type-count-total villager == 27)
                (can-research ri-loom)
                    =>
                (research ri-loom)
                )


                (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: town-center c: 1)
                (set-goal gl-temp 0)
                )

                (defrule
                    (up-set-target-object search-local c: 0)
                    (or(up-object-data object-data-progress-type == 102) ;vill
                    (up-object-data object-data-progress-type == 103)) ;research
                    =>
                    (up-get-object-data object-data-progress-value gl-temp)
                )

                    (defrule 
                    ;(up-compare-goal gl-temp >= 88)
                    (current-age == feudal-age) ; skal også gælde mens der advances
                    (can-train villager)
                    (not(and(food-amount > 600)
                    (and(gold-amount > 150)
                    (unit-type-count-total villager >= 29))))
                        =>
                    (train villager)
                    )

            ;C Forcedropping
                    ;(defrule
                    ;(up-compare-goal gl-drop-off-food-time-reached == YES)
                    ;(current-age == feudal-age)
                    ;(unit-type-count-total villager >= 29)
                    ;(research-available castle-age)
                    ;(food-amount < 800)
                    ;(gold-amount >= 200)
                    ;=>
                    ;(up-drop-resources food c: 6) ;A relatively low amount is good here to ensure you get every last bit to ensure you have enough
                    ;(chat-to-all "force drop rule 6 running (food for castle age)")
                    ;)

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp7 0)
