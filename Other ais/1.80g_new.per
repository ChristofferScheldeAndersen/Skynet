                    (defrule
                    (true)
                    =>
                    (up-modify-goal gl-local-total c:* 150)
                    (up-modify-goal gl-local-total c:/ 100)
                    )
                    #end-if
                    #end-if

                    #load-if-defined UP-4-PLAYER-GAME
                    #load-if-defined UP-3-PLAYER-TEAM
                    (defrule
                    (true)
                    =>
                    (up-modify-goal gl-local-total c:* 170)
                    (up-modify-goal gl-local-total c:/ 100)
                    )
                    #end-if
                    #end-if

                    
                ;Ajust for feudal ranged unit upgrades
                    (defrule
                            (not(research-completed ri-fletching))
                            =>
                            (up-modify-goal gl-local-total c:* 8)
                            (up-modify-goal gl-local-total c:/ 10)
                        )
                    
                    (defrule
                            (not(research-completed ri-padded-archer-armor))
                            =>
                            (up-modify-goal gl-local-total c:* 19)
                            (up-modify-goal gl-local-total c:/ 20)
                        )
                ;Modifier for being more agressive when you have knight support
                    ;lav en converter der omdanner egne knights til ca. at svare til 2 x bows. Kan dog tælle for
                    ;mere afh af upgrades og om modstanderen er heavy på skirms og siege.

                    (defrule
                        (up-compare-goal gl-my-position == 3)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                        (up-get-focus-fact allied-goal gl-melee-group-strength gl-melee-group-strength)
                    )

                    (defrule
                        (up-compare-goal gl-melee-group-strength > 10)
                        =>
                        (up-modify-goal gl-temp31 g:= gl-melee-group-strength)
                        (up-modify-goal gl-temp31 c:* 100)
                        (up-modify-goal gl-temp31 c:/ 10)
                        ;(up-get-target-fact unit-type-count scorpion-line gl-temp35)
                        ;(up-get-target-fact unit-type-count mangonel-line gl-temp36)
                        (up-modify-goal gl-temp36 c:* 2)
                        (up-modify-goal gl-temp36 g:+ gl-temp35)
                        (up-modify-goal gl-temp36 c:* 2)
                        ;lad os sige enemy har 4 scorps og 1 mangonell og jeg har 7 knights
                        ;normalt ville de 7 knights tælle for 14. Der kan maks være en bonus på 2*6 altså 12
                        ;Hvis der f.eks. havde været 3 knights havde bonussen været på 6, men nu er den altså på 
                        ;12.

                        (up-get-target-fact unit-type-count skirmisher-line gl-temp33)
                        (up-get-target-fact military-population 0 gl-temp34)
                        (up-modify-goal gl-temp33 c:* 100)
                        (up-modify-goal gl-temp33 g:/ gl-temp34)  ;gl-temp33 er procentel af modstanders hær der er skirms
                        ;(up-modify-goal gl-temp33 c:/ 100)
                    )

                    (defrule
                        (up-compare-goal gl-temp31 g:< gl-temp36) ;der er ikke nok knights til at counter alt siege.
                        (up-compare-goal gl-temp31 >= 0)
                        =>
                        (up-modify-goal gl-temp36 g:= gl-temp31)
                    )

                    (defrule
                        (up-compare-goal gl-temp33 > 100)
                        =>
                        (set-goal gl-temp33 100)
                    )

                    (defrule
                        ;(current-age >= castle-age)
                        ;(up-compare-goal gl-temp33 > 0)
                        (true)
                        =>
                        (up-modify-goal gl-temp33 c:* 3) 
                        (up-modify-goal gl-temp33 c:+ 350) ;gl-temp33 er factor mellem 350 og 550 der ganges med
                        )

                    (defrule
                        (current-age >= castle-age)
                        (up-compare-goal gl-temp33 == 0)
                        =>
                        (up-modify-goal gl-temp33 c:* 200) 
                    )

                    (defrule
                        (up-compare-goal gl-my-position == 3)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                        (up-get-focus-fact allied-goal gl-melee-army-x gl-melee-army-x)
                        (up-get-focus-fact allied-goal gl-melee-army-y gl-melee-army-y)
                    )

                    (defrule
                        (up-point-distance gl-melee-army-x gl-temp9-x < 2000)
                        (up-compare-sn sn-lone-flank != 1)
                        =>
                        ;afhængigt af enemy skirm count
                        (up-modify-goal gl-temp31 g:* gl-temp33)
                        (up-modify-goal gl-temp31 c:/ 10000)
                        (up-modify-goal gl-local-total g:+ gl-temp31) ;modifier for knights countering skirms
                        ;(up-modify-goal gl-local-total g:+ gl-temp36) ;modifier for knights countering siege
                        ;(up-chat-data-to-all "pocket knights adds %d to group superiority" g: gl-temp31)
                    )
                    
                    
                ;Ajust for Castle ranged unit upgrades
                    (defrule
                    (players-current-age target-player == castle-age)
                    =>
                    (enable-timer enemy-has-imp-tech-timer 60)
                    (disable-self)
                    )

                    
                    (defrule
                            (or(up-research-status c: ri-crossbow >= research-pending)
                            (up-research-status c: ri-elite-skirmisher >= research-pending))
                            (up-timer-status enemy-has-imp-tech-timer != timer-running)
                            (up-timer-status enemy-has-imp-tech-timer != timer-triggered)
                            =>
                            (up-modify-goal gl-local-total c:* 2)
                        )
                ;Find ajusted number of local units
                    (defrule
                    (true)
                    =>
                    (up-modify-goal gl-group-superiority g:= gl-local-total)
                    (up-modify-goal gl-temp1 g:= gl-group-superiority)
                    )
                ;Find base group superiority

                    (defrule
                    (true)
                    =>

                    (up-get-player-fact target-player military-population 0 gl-temp2)
                    (up-modify-goal gl-temp2 c:* -1)
                    (up-modify-goal gl-group-superiority g:+ gl-temp2)
                    (up-modify-goal gl-temp3 g:= gl-group-superiority)
                    )

        
                ;Modify for counter units

                    (defrule
                    (true)
                    =>
                    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
                    (up-full-reset-search)
                    (up-find-local c: archer-line c: 200) 
                    (up-remove-objects search-local object-data-group-flag != archer-group)
                    (up-get-search-state gl-local-total)   
                    (up-modify-goal gl-temp41 g:= gl-local-total) ;temp41 is all own archers
                    (up-full-reset-search)
                    (up-find-local c: skirmisher-line c: 200) 
