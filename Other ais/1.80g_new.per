        ; Bugs
            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-get-point position-zero gl-temp1-x)
                (up-set-target-point gl-temp1-x)
                (up-filter-distance c: -1 c: 6)
                (up-filter-status c: status-pending c: list-active)
                (up-find-status-local c: farm c: 5)
            )

            (defrule
                (up-set-target-object search-local c: 0)
                =>
                (up-remove-objects search-local object-data-type == knight)
                        (up-remove-objects search-local object-data-type == spearman)
                        (up-remove-objects search-local object-data-type == archer)
                        (up-remove-objects search-local object-data-type == hand-cannoneer)
                        (up-remove-objects search-local object-data-type == battering-ram)
                (up-target-point gl-temp1-x action-delete -1 -1)
                ;(chat-to-all "deleting bugged farm")
            )
        ; Villager distribution
            ; wood vills
                
                (defrule ;find the furthest farm vill and turn it to wood if you have excess food while delaying imp
                    (true)
                    =>
                    
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != wood-group)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp2 g:= gl-local-total)
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != farm-group)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp1 g:= gl-local-total)
                    ;(up-modify-goal gl-temp1 c:+ 2) ;må gerne være 1 idle farms efter et angreb
                    (up-get-point position-self gl-temp1-x)
                    (up-set-target-point gl-temp1-x)
                    (up-remove-objects search-local object-data-carry > 5)
                    (up-clean-search search-local object-data-distance search-order-desc)
                    (up-modify-goal gl-temp2 g:- gl-temp1)
                )

                (defrule
                    (up-compare-goal gl-delay-imp == 1)
                    (up-compare-goal gl-temp2 < -10) ;food vills outnumber woodvills by more than 10
                    (food-amount > 350)
                    (wood-amount < 200)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-object-data object-data-id gl-temp5)
                    (up-reset-search 1 1 0 0)
                    (up-reset-filters)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != wood-group)
                    (up-add-object-by-id search-local g: gl-temp5)
                    (up-reset-group c: wood-group)
                    (up-modify-group-flag 0 c: wood-group)
                    (up-create-group 0 0 c: wood-group)
                    (up-modify-group-flag 1 c: wood-group)
                    ;(chat-to-all "move exces farm vill to wood")
                )
                
            ; gold vills
                (defrule
                        (current-age == castle-age)
                        (unit-type-count-total skirmisher-line > 0)
                        =>
                        (set-goal gl-gold-vills 14)
                    )

                    (defrule
                        (current-age == imperial-age)
                        (unit-type-count-total skirmisher-line == 0)
                        =>
                        (set-goal gl-gold-vills 9)
                    )

                    (defrule
                        (current-age == castle-age)
                        (unit-type-count-total skirmisher-line == 0)
                        =>
                        (set-goal gl-gold-vills 13) ;13
                    )

                (defrule
                ;(up-compare-goal gl-fase-3-stage >= 2)
                (true)
                =>
                (up-modify-goal gl-temp1 g:= gl-calibrated-farm-count) ;1= 30
                (up-modify-goal gl-temp1 c:- 12) ;1= 18
                )

                (defrule
                ;(up-compare-goal gl-fase-3-stage >= 2)
                (up-compare-goal gl-temp1 > 12); 6 over
                =>
                (up-modify-goal gl-temp2 g:= gl-temp1) ;2= 18
                (up-modify-goal gl-temp2 c:- 12) ;2= 6
                (up-modify-goal gl-temp2 c:/ 2) ;2= 2
                (up-modify-goal gl-temp1 c:= 12) ;1= 12
                (up-modify-goal gl-temp1 g:+ gl-temp2) ;1= 14
                )

                ;når calibrated farm count når over 35 sv.t actual farm count over ca. 30 sendes en vill til guld for hver 
                ;calibrated farm over 35 for de første 12 farms. Ved ca. 50 farms er der altså 17 gold vills Herefter sendes 
                ;en halv for hver ekstra farm. Når paladin er clicked sendes 30 ekstra svt. ca. 47 gold vills.
                
                (defrule
                (up-compare-goal gl-fase-3-stage >= 2)
                (true)
                =>
                (up-modify-goal gl-gold-vills g:+ gl-temp1); 9+14= 23
                )

                (defrule
                    (or(up-research-status c: ri-paladin >= research-pending)
                    (up-research-status c: ri-savar >= research-pending))
                    =>
                    (up-modify-goal gl-gold-vills c:+ 30)
                    (up-get-fact unit-type-count-total trade-cart gl-temp2)
                    (up-modify-goal gl-temp2 c:* 2); 2 før
                    (up-modify-goal gl-temp2 c:/ 3); 3 før
                    (up-modify-goal gl-gold-vills g:- gl-temp2)
                )

                (defrule
                    (up-compare-goal gl-gold-vills > 23) ;19 før
                    =>
                    (up-modify-goal gl-gold-vills c:= 23)
                )

                (defrule
