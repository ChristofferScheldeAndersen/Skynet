                            (up-modify-goal gl-temp3 g:= gl-temp1-x) 
                            (up-modify-goal gl-temp3 c:/ 4) ;maximum tiles to move
                            (up-modify-goal gl-temp1-x c:= 0)
                            (up-modify-goal gl-temp1-x c:+ 2) ;starting tile for placement
                            (up-modify-goal gl-temp1-y c:- 2)
