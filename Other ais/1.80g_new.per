            (defrule
                ;(up-find-remote c: 910 c: 1)
                (or(and(up-set-target-by-id g: gl-first-boar-luring-villager)
                (and(up-object-data object-data-hitpoints > 14)
                (and(up-set-target-by-id g: gl-first-boar-id)
                (up-object-data object-data-distance <= 3))))
                (and(up-set-target-by-id g: gl-first-boar-luring-villager)
                (and(up-object-data object-data-hitpoints <= 14)
                (and(up-set-target-by-id g: gl-first-boar-id)
                (up-object-data object-data-distance <= 5)))))
                =>
                (set-goal gl-split-rule 93)
            )
            #end-if

            #load-if-not-defined DE-AVAILABLE
            (defrule
                ;(up-find-remote c: 910 c: 1)
                (or(and(up-set-target-by-id g: gl-first-boar-luring-villager)
                (and(up-object-data object-data-hitpoints > 14)
                (and(up-set-target-by-id g: gl-first-boar-id)
                (up-object-data object-data-distance <= 3))))
                (and(up-set-target-by-id g: gl-first-boar-luring-villager)
                (and(up-object-data object-data-hitpoints <= 14)
                (and(up-set-target-by-id g: gl-first-boar-id)
                (up-object-data object-data-distance <= 6)))))
                =>
                (set-goal gl-split-rule 93)
            )

            (defrule
                (up-set-target-by-id g: gl-first-boar-luring-villager)
                (up-object-data object-data-hitpoints <= 14)
                (up-set-target-by-id g: gl-first-boar-id)
                (up-object-data object-data-distance <= 9)
                (goal gl-sheppard-priority 4-stragglers)
                    (up-compare-goal gl-fase == 1)
                    (not(goal gl-split-rule 93))
                =>
                (set-goal gl-split-rule 93)
            )

            #end-if

            (defrule
                (goal gl-split-rule 93)
                (or(goal BOAR-STATUS Planning-Boar-Attack)
                (goal BOAR-STATUS Send-vill-to-tc))
                (up-compare-goal gl-second-boar-luring-villager == -1)
                
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200) ;it would be good to check villager HP, etc.
                (up-remove-objects search-local object-data-hitpoints < 9)
                (up-remove-objects search-local object-data-group-flag != shepard-group)
                (up-remove-objects search-local object-data-id g:== gl-first-boar-luring-villager)
                (up-target-objects 1 action-default -1 -1) ;right-click the boar with the villager
                (set-goal BOAR-STATUS Killing-Boar)
                (enable-timer save-boar-villager-timer 5)
                ;(chat-to-all "killing boar 1")
            )
                
                

            #load-if-defined DE-AVAILABLE
            (defrule
                (or(and(up-set-target-by-id g: gl-second-boar-luring-villager)
                (and(up-object-data object-data-hitpoints > 14)
                (and(up-set-target-by-id g: gl-second-boar-id)
                (up-object-data object-data-distance <= 3))))
                (and(up-set-target-by-id g: gl-second-boar-luring-villager)
                (and(up-object-data object-data-hitpoints <= 14)
                (and(up-set-target-by-id g: gl-second-boar-id)
                (up-object-data object-data-distance <= 5)))))
                =>
                (set-goal gl-split-rule 94)
            )
            #end-if

            #load-if-not-defined DE-AVAILABLE
            (defrule
                (or(and(up-set-target-by-id g: gl-second-boar-luring-villager)
                (and(up-object-data object-data-hitpoints > 14)
                (and(up-set-target-by-id g: gl-second-boar-id)
                (up-object-data object-data-distance <= 3))))
                (and(up-set-target-by-id g: gl-second-boar-luring-villager)
                (and(up-object-data object-data-hitpoints <= 14)
                (and(up-set-target-by-id g: gl-second-boar-id)
                (up-object-data object-data-distance <= 6)))))
                =>
                (set-goal gl-split-rule 94)
            )
            #end-if

            (defrule
                (goal gl-split-rule 94)
                (or(goal BOAR-STATUS Planning-Boar-Attack)
                (goal BOAR-STATUS Send-vill-to-tc))
                (up-compare-goal gl-second-boar-luring-villager != -1)
                
                =>
                ;set the boar as the target-object
                (up-full-reset-search)
            ; (up-get-point position-self gl-position-self-x)
            ; (up-set-target-point gl-position-self-x)
            ; (up-filter-distance c: -1 c: 2)
                (up-find-local c: villager-class c: 200) ;it would be good to check villager HP, etc.
                (up-remove-objects search-local object-data-hitpoints < 9)
                (up-remove-objects search-local object-data-group-flag != shepard-group)
                (up-remove-objects search-local object-data-id g:== gl-second-boar-luring-villager)
                
                (up-target-objects 1 action-default -1 -1) ;right-click the boar with the villager
                (set-goal BOAR-STATUS Killing-Boar)
                (enable-timer save-boar-villager-timer 5)
                ;(chat-to-all "killing boar 2")
            )
                
            (defrule
                (goal BOAR-STATUS Killing-Boar)
                (up-compare-goal gl-first-boar-status == -1)
                (up-set-target-by-id g: gl-first-boar-id)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200) 
                (up-remove-objects search-local object-data-hitpoints < 9)
                (up-remove-objects search-local object-data-group-flag != shepard-group)
                (up-remove-objects search-local object-data-id g:== gl-first-boar-luring-villager)
                (up-remove-objects search-local object-data-target-id g:== gl-first-boar-id)
                (up-remove-objects search-local object-data-idling c:!= 1)
            )

            (defrule
                (goal BOAR-STATUS Killing-Boar)
                (up-compare-goal gl-first-boar-status == -1)
                (up-set-target-by-id g: gl-first-boar-id)
                =>
                (up-target-objects 1 action-default -1 -1)
            ) 

            (defrule
                (goal BOAR-STATUS Killing-Boar)
                (up-set-target-by-id g: gl-second-boar-id)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200) 
                (up-remove-objects search-local object-data-hitpoints < 9)
                (up-remove-objects search-local object-data-group-flag != shepard-group)
                (up-remove-objects search-local object-data-id g:== gl-second-boar-luring-villager)
                (up-remove-objects search-local object-data-target-id g:== gl-second-boar-id)
                (up-remove-objects search-local object-data-idling c:!= 1)
            )

            (defrule
                (goal BOAR-STATUS Killing-Boar)
                (up-set-target-by-id g: gl-second-boar-id)
                =>
                (up-target-objects 1 action-default -1 -1)
            )


        ;21 eating boars
            
            ; Entering eating boar mode
                (defrule ; to første regler tjekker afstand til second boar hvis den er der
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                )
                
                (defrule
                (up-compare-goal gl-second-boar-id != -1)
                    (up-set-target-by-id g: gl-second-boar-id)
                    =>
                    (do-nothing)
                )
                
                (defrule
                (goal BOAR-STATUS Killing-Boar)
                (or
                (and(up-compare-goal gl-first-boar-status == first-boar-is-dead) ; enten first boar is dead while 
                (not(and(up-set-target-by-id g: gl-second-boar-id) ; second boar isnt being killed
                (up-object-data object-data-distance < 10))))

                (up-compare-goal gl-second-boar-status != -1)) ; eller second boar is dead
                =>
                (set-goal BOAR-STATUS Eating-Boar)
                ;(chat-to-all "eating boar")
                )

                (defrule ; hvis second boar er død burde man sikkert kunne blive på eating boar
                    (up-compare-goal gl-second-boar-status != -1)
                    (up-compare-goal BOAR-STATUS != Eating-Boar)
                    =>
                    (set-goal BOAR-STATUS Eating-Boar)
                ;(chat-to-all "eating boar 2")
                )

            


            ; Detect if boars are dead or gone

                    (defrule
                        (up-compare-goal gl-first-boar-id != -1)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-first-boar-id)
                        (up-set-target-object search-remote c: 0)
                        (up-get-object-data object-data-carry gl-boar-starting-amount)
                        (disable-self)
                    )

                    
                    (defrule
                        (up-compare-goal gl-second-boar-luring-villager == -1)
                            =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-first-boar-id)
                        
                            )

                    (defrule
                    (up-compare-goal gl-second-boar-luring-villager == -1)
                    (up-set-target-object search-remote c: 0)
                        (up-object-data object-data-hitpoints < 1)
                        (up-object-data object-data-carry > 200)  ; boar er død
                        =>
                        ;(chat-to-all "first boar is dead")
                        (set-goal gl-luring-step -1)
                        (set-goal gl-first-boar-status first-boar-is-dead)
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        ; remove all but 7 food vills
                        ; do stuff like finish remaining sheep first.

                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-second-boar-id)
                        (up-set-target-object search-remote c: 0)
                        (up-get-object-data object-data-carry gl-boar-starting-amount)
                        (disable-self)      ;sluk for gåtur og send alle relevante på boar
                    )
                    

                        (defrule
                        (up-compare-goal gl-second-boar-luring-villager != -1)
                            =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-second-boar-id)
                        
                            )

                    (defrule
                    (up-compare-goal gl-second-boar-luring-villager != -1)
                    (up-set-target-object search-remote c: 0)
                        (up-object-data object-data-hitpoints < 1)
                        (up-object-data object-data-carry > 200)  ; boar er død
                        (up-compare-goal gl-second-boar-luring-villager != -1)
                        =>
                        ;(chat-to-all "second boar is dead")
                        (set-goal gl-luring-step -1)
                        (set-goal gl-second-boar-status second-boar-is-dead)

                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        ; remove all but 7 food vills
                        ; do stuff like finish remaining sheep first.

                        (disable-self)      ;sluk for gåtur og send alle relevante på boar
                    )

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-first-boar-id)
                    )

                        (defrule
                        (up-set-target-object search-remote c: 0)
                        (up-object-data object-data-carry c:< 12)
                        (up-object-data object-data-carry c:> 0)  ; boar er væk
                        ;(goal gl-second-boar-status second-boar-is-dead)
                        =>
                        ;(chat-to-all "first boar is gone")
                        (set-goal gl-first-boar-status first-boar-is-gone)

                        (disable-self)      ;sluk for gåtur og send alle relevante på boar
                    )

                    (defrule
                        (not(up-set-target-by-id g: gl-first-boar-id))
                        (goal gl-first-boar-status first-boar-is-dead)
                        =>
                        ;(chat-to-all "first boar is gone")
                        (set-goal gl-first-boar-status first-boar-is-gone)

                        (disable-self)      ;sluk for gåtur og send alle relevante på boar
                    )

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-add-object-by-id search-remote g: gl-second-boar-id)
                    )

                    (defrule
                            (up-set-target-object search-remote c: 0)
                        (up-object-data object-data-carry c:< 10)
                        (up-object-data object-data-carry c:> 0)  ; boar er væk
                        (up-compare-goal gl-second-boar-luring-villager != -1)
                        =>
                        ;(chat-to-all "second boar is gone")
                        (set-goal gl-second-boar-status second-boar-is-gone)
                        (disable-self)      ;sluk for gåtur og send alle relevante på boar
                    )

            ; Retasking vills to eat first boar

                
                
            ; Retasking vills to eat second boar

                

            ; ?? ekstra?

                (defrule
                    (unit-type-count villager < 20)
                    (or(goal BOAR-STATUS Eating-Boar)
                    (goal BOAR-STATUS Killing-Boar)) 
                    (up-compare-goal gl-luring-step == -1)
                    (up-idle-unit-count idle-type-villager > 0)
                        =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-first-boar-luring-villager)
                    (up-add-object-by-id search-remote g: gl-first-boar-id)
                    (up-set-target-object search-remote c: 0)
                    (up-target-objects 1 action-default -1 -1)
                    ;(chat-to-all "sending boar luring villager back to work")
                    (disable-self)
                )

                (defrule
                    (unit-type-count villager < 20)
                    (or(goal BOAR-STATUS Eating-Boar)
                    (goal BOAR-STATUS Killing-Boar)) 
                    (unit-type-count villager-wood == 5) ;lumberjack
                        =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-first-boar-luring-villager)
                    (up-add-object-by-id search-remote g: gl-first-boar-id)
                    (up-set-target-object search-remote c: 0)
                    (up-target-objects 1 action-default -1 -1)
                    ;(chat-to-all "sending boar luring villager back to work nr 2")
                    (disable-self)
                    )

    
        ;22 Stopping wrong vills from luring boar (new patch bug)
            (defrule
                (true)
                =>
                (set-goal gl-temp1 0)
            )

            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                
                (set-goal gl-temp -1)
            )

            (defrule
                (up-set-target-object search-local g: gl-temp1)
                =>
                (up-get-object-data object-data-target-id gl-temp)
            )

            (defrule
                (up-set-target-object search-local g: gl-temp1)
                (up-set-target-by-id g: gl-temp)
                =>
                (up-get-point position-object gl-temp-x)
                (up-get-point position-self gl-position-self-x)
            )

            (defrule
                (up-set-target-by-id g: gl-temp)
                (up-object-data object-data-class == 910)
                (up-object-data object-data-carry > 0)
                (up-set-target-object search-local g: gl-temp1)
                (up-point-distance gl-temp-x gl-position-self-x > 8)
                (nor(and(up-object-data object-data-id g:== gl-first-boar-luring-villager)
                (up-compare-goal gl-temp g:== gl-first-boar-id))
                (and(up-object-data object-data-id g:== gl-second-boar-luring-villager)
                (up-compare-goal gl-temp g:== gl-second-boar-id)))
                =>
                (up-remove-objects search-local object-data-index g:!= gl-temp1)
                (up-target-point gl-temp-x action-stop -1 -1)
                ;(chat-to-all "stopped boar vill")
            )

            (defrule
                (up-compare-goal gl-temp1 < 25)
                =>
                (up-modify-goal gl-temp1 c:+ 1)
                (up-jump-rule -5)
            )
    ;
        (defrule
                ;(true)
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 420 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 68 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                )
    ;6 Sheep ;up-target-point
        ;0z calculating sheep reserve
            (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: livestock-class c: 10)
                (up-get-search-state gl-local-total)
                (up-modify-goal gl-sheep-reserve g:= gl-local-total)
            )

            (defrule
                (taunt-detected my-player-number 4)
                =>
                (up-chat-data-to-player my-player-number "I have %d. live sheep in reserve" g: gl-sheep-reserve)
                (acknowledge-taunt my-player-number 4)
            )

        ;0y Making sure explore sheep make it back in time
            ;(defrule
                    ;(true)
                    ;=>
                    ;(up-chat-data-to-all "gl-explore-sheep-one is %d." g: gl-explore-sheep-one)
                    ;(up-chat-data-to-all "gl-explore-sheep-two is %d." g: gl-explore-sheep-two)
                ;)

            (defrule
                (up-compare-goal gl-sheep-reserve < 4)
                (up-compare-goal gl-current-sheep != -1)
                (up-compare-goal gl-next-sheep != -1)
                (up-compare-goal gl-explore-sheep-one != -1)
                (up-set-target-by-id g: gl-current-sheep)
                =>
                (up-get-object-data object-data-carry gl-maximum-explore-sheep1-distance)
                (up-modify-goal gl-maximum-explore-sheep1-distance c:/ 4)
                (up-modify-goal gl-maximum-explore-sheep1-distance c:+ 16) ; skal måske være lavere ift stuck bag woddline
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
            )

            (defrule
                (up-compare-goal gl-sheep-reserve < 4)
                (up-compare-goal gl-current-sheep != -1)
                (up-compare-goal gl-next-sheep != -1)
                (up-compare-goal gl-explore-sheep-one != -1)
                (up-set-target-by-id g: gl-explore-sheep-one)
                (up-object-data object-data-distance g:>= gl-maximum-explore-sheep1-distance)
                (not(and(up-compare-goal gl-first-boar-status == first-boar-is-dead)
                (up-set-target-by-id g: gl-second-boar-id)))
                (not(and(up-set-target-by-id g: gl-second-boar-id)
                (up-object-data object-data-carry > 250)))
                =>
                (set-goal gl-split-rule 60)
            )

            (defrule
                (goal gl-split-rule 60)
                =>
                (set-goal gl-split-rule 0)
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-explore-sheep-one)
                (up-get-point position-self gl-position-self-x)
                (up-target-point gl-position-self-x action-default -1 -1)
                ;(chat-to-all "explore sheep one might not make it back in time. Forcing it to tc")
                (enable-timer 20 3)
            )
                

        

        ;1 Setup the sheeps (CheeseOnToast*)
            ;Note* This section is heavily based on a similar script by CheeseOnToast. I have released this section
            ;with his permission and he deserves alot of credit not only for this but for alot of help through the
            ;entire 1.60 update. 

            ;Remove any sheep ID's of sheep you dont controll

                (defrule
                    (up-set-target-by-id g: gl-current-sheep)
                    (up-object-data object-data-player != my-player-number)
                    (up-object-data object-data-hitpoints > 0 )
                    =>
                    (set-goal gl-current-sheep -1)
                )

                (defrule
                    (up-set-target-by-id g: gl-next-sheep)
                    (up-object-data object-data-player != my-player-number)
                    (up-object-data object-data-hitpoints > 0 )
                    =>
                    (set-goal gl-next-sheep -1)
                )

                (defrule
                    (up-set-target-by-id g: gl-explore-sheep-one)
                    (up-object-data object-data-player != my-player-number)
                    (up-object-data object-data-hitpoints > 0 )
                    =>
                    (set-goal gl-explore-sheep-one -1)
                )

                (defrule
                    (up-set-target-by-id g: gl-explore-sheep-two)
                    (up-object-data object-data-player != my-player-number)
                    (up-object-data object-data-hitpoints > 0 )
                    =>
                    (set-goal gl-explore-sheep-two -1)
                )

                


            ;Put all controlled sheep without ID into the local list
            
                (defrule
                (true)
                =>
                (up-full-reset-search)
                (up-find-local c: livestock-class c: 240)
                (up-remove-objects search-local object-data-id g:== gl-explore-sheep-one)
                (up-remove-objects search-local object-data-id g:== gl-explore-sheep-two)
                (up-remove-objects search-local object-data-id g:== gl-current-sheep)
                (up-remove-objects search-local object-data-id g:== gl-next-sheep)
                (up-get-point position-self gl-position-self-x)
                (up-set-target-point gl-position-self-x)
                (up-clean-search search-local object-data-distance search-order-asc)
                (up-get-search-state gl-local-total)
                )

            ;Assign ID's to current, next and the two explore sheep

                (defrule 
                    (goal gl-current-sheep -1)
                    (up-set-target-object search-local c: 0)
                    (or(up-object-data object-data-distance < 5)
                    (and(up-object-data object-data-distance < 10)
                    (game-time < 60)))
                    ;(or(goal gl-first-boar-status -1)
                    ;(up-compare-goal gl-second-boar-status != -1))
                =>
                    (up-get-object-data object-data-id gl-current-sheep)
                    (up-remove-objects search-local object-data-id g:== gl-current-sheep)
                    (up-modify-goal gl-sheep-taken c:+ 1)
                    ;;;(up-chat-data-to-all "Taking sheep number %d." g: gl-sheep-taken)
                    ;(up-chat-data-to-all "Debug: Current sheep is now %d" g: gl-current-sheep)
                )

                ; hvis der er fundet et sheep at tage og det næste sheep i rækken ikke er fundet findes
                ; dette nu fra de tilbageværende på listen. Efter gl-next-sheep er sat fjernes det fra
                ; listen

                (defrule
                    (up-compare-goal gl-current-sheep != -1)
                    (goal gl-next-sheep -1)
                    (up-set-target-object search-local c: 0)
                ; (up-compare-goal gl-sheep-taken < 3) ; sikrer at sheep ikke er i vejen for boar
                =>
                    (up-get-object-data object-data-id gl-next-sheep)
                    (up-remove-objects search-local object-data-id g:== gl-next-sheep)
                    ;(up-chat-data-to-all "Debug: Next sheep is now %d" g: gl-next-sheep)
                )
                ;når disse to er fundet gentages processen for 2 scouting sheeps.


                (defrule
                (game-time <= 480)
                (up-compare-goal gl-deer-luring-stage < Luring-deer)
                (up-compare-goal gl-current-sheep != -1)
                (up-compare-goal gl-next-sheep != -1)
                (goal gl-explore-sheep-one -1)
                (up-set-target-object search-local c: 0)
                ;(game-time s:< sn-home-exploration-time) sæt evt nyt nummer
                =>
                (up-get-object-data object-data-id gl-explore-sheep-one)
                (up-remove-objects search-local object-data-id g:== gl-explore-sheep-one)
                ;(up-chat-data-to-all "Debug: Sheep %d is assigned to explore" g: gl-explore-sheep-one)
                )
                (defrule
                (game-time <= 480)
                (up-compare-goal gl-deer-luring-stage < Luring-deer)
                (up-compare-goal gl-current-sheep != -1)
                (up-compare-goal gl-next-sheep != -1)
                (up-compare-goal gl-explore-sheep-one != -1)
                (goal gl-explore-sheep-two -1)
                (up-set-target-object search-local c: 0)
                ;(game-time s:< sn-home-exploration-time) ; sæt evt nyt nummer
                =>
                (up-get-object-data object-data-id gl-explore-sheep-two)
                (up-remove-objects search-local object-data-id g:== gl-explore-sheep-two)
                ;(up-chat-data-to-all "Debug: Sheep %d is assigned to explore" g: gl-explore-sheep-two)
                )


            ;Move sheep without ID to spot behind TC

                
                (defrule
                    (up-compare-goal gl-my-position != 4)
                    =>
                    (up-get-point position-self gl-position-self-x)
                    (up-get-point position-flank gl-temp-x)
                )

                (defrule
                    (up-compare-goal gl-my-position != 4)
                    (up-compare-goal gl-enemy-x != -1)
                    =>
                    (up-copy-point gl-temp-x gl-enemy-x)
                )

                (defrule
                    (up-compare-goal gl-my-position == 4)
                    =>
                    (up-get-point position-center gl-position-self-x)
                    (up-get-point position-flank gl-temp-x)
                    (up-lerp-tiles gl-temp-x gl-position-self-x c: 40)
                    (up-get-point position-self gl-position-self-x)
                )

                (defrule
                    (true)
                    =>
                    (up-lerp-tiles gl-position-self-x gl-temp-x c: -3)
                )

                (defrule
                    (up-compare-goal gl-second-boar-status < second-boar-is-dead)
                    =>
                    (up-get-point position-self gl-position-self-x)
                    (up-modify-goal gl-position-self-x c:+ 2)
                    (up-modify-goal gl-position-self-y c:- 2)
                )

                (defrule
                    (up-set-target-object search-local c: 0)
                ; (up-timer-status t-sheep-move != timer-running)
                =>
                    (up-set-target-point gl-position-self-x)
                    (up-remove-objects search-local object-data-distance <= 1)
                    (up-target-point gl-position-self-x action-move -1 -1)
                    ;(chat-to-all "moving extra sheep behind tc")
                )

            ;Change ID's between sheep that have already been asigned ID's.
                (defrule
                    (or(not(up-set-target-by-id g: gl-current-sheep))
                    (or(up-object-data object-data-carry < 2)
                    (and(up-object-data object-data-carry < 8)
                    (unit-type-count villager < 10)) ))
                    (up-compare-goal gl-next-sheep != -1)
                    ;(up-compare-goal gl-sheep-taken < 4) ;sikre at der kun tages 4 sheep før boar
                =>
                    (up-modify-goal gl-current-sheep g:= gl-next-sheep)
                    ;;;(up-chat-data-to-all "Debug: Current sheep changed to next sheep. %d" g: gl-next-sheep)
                    (set-goal gl-next-sheep -1)
                    (up-modify-goal gl-sheep-taken c:+ 1)
                    ;(up-chat-data-to-all "Taking sheep number %d." g: gl-sheep-taken)
                )
                (defrule
                    (not(up-set-target-by-id g: gl-current-sheep))
                    (up-compare-goal gl-current-sheep != -1)
                    (goal gl-next-sheep -1)
                =>
                    (set-goal gl-current-sheep -1)
                )

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-remote g: gl-current-sheep)
                )

                (defrule
                    (up-set-target-object search-remote c: 0)
                    (up-object-data object-data-carry < 1)
                    =>
                    (set-goal gl-current-sheep -1)
                    ;(chat-to-all "reseting gl-current-sheep")
                )


                (defrule
                
                (up-compare-goal gl-explore-sheep-two != -1)
                (up-compare-goal gl-explore-sheep-one != -1)
                (or(and(up-compare-goal gl-local-total == 0)
                (goal gl-next-sheep -1))
                (or(game-time > 480)
                (up-compare-goal gl-deer-luring-stage >= Luring-deer)))
                ;(game-time > 60)
                =>
                (set-goal gl-explore-sheep-two -1)
                ;(chat-to-all "Debug: Unassigning explore sheep 2.")
                (up-jump-rule 1)
                )
                (defrule
                (goal gl-explore-sheep-two -1)
                (up-compare-goal gl-explore-sheep-one != -1)
                (or(and(up-compare-goal gl-local-total == 0)
                (goal gl-next-sheep -1))
                (or(game-time > 480)
                (up-compare-goal gl-deer-luring-stage >= Luring-deer)))
                ;(game-time > 60)
                =>
                (set-goal gl-explore-sheep-one -1)
                ;(chat-to-all "Debug: Unassigning explore sheep 1.")
                )

                (defrule
                    (or(game-time > 480)
                (up-compare-goal gl-deer-luring-stage >= Luring-deer))
                    (or(up-compare-goal gl-explore-sheep-two != -1)
                    (up-compare-goal gl-explore-sheep-one != -1))
                    =>
                    (set-goal gl-explore-sheep-two -1)
                    (set-goal gl-explore-sheep-one -1)
                )
            
        ;2 move sheep to correct locations
            
            ;Now we need to move the current and next livestock to their correct positions.

            (defrule
                (taunt-detected my-player-number 21)
                =>
                (up-chat-data-to-all "Debug: Current sheep is now %d" g: gl-current-sheep)
                ;(acknowledge-taunt my-player-number 21)
            )

            (defrule
            ;(or(goal gl-sheppard-priority 0-build-first-two-houses)
            ;(goal gl-sheppard-priority 3-living-current-sheep))
                (up-compare-goal gl-current-sheep != 1)
            ; (up-timer-status t-sheep-move != timer-running)                   ;hvorfor?
            =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-current-sheep)
                (up-get-point position-self gl-position-self-x)
                (up-modify-goal gl-position-self-x c:- 2)
                (up-modify-goal gl-position-self-y c:- 1)
                (set-strategic-number sn-target-point-adjustment 5)
                (up-set-target-point gl-position-self-x)
                (up-remove-objects search-local object-data-distance <= 1)
                (up-target-point gl-position-self-x action-move -1 -1)
            )
            
            (defrule
            (not(goal gl-sheppard-priority 0-build-first-two-houses))
                (up-compare-goal gl-next-sheep != 1)
                (up-set-target-by-id g: gl-current-sheep)
                (up-object-data object-data-carry < 65)
            ; (up-timer-status t-sheep-move != timer-running)
            ;(up-compare-goal gl-sheep-taken < 4) ; sikrer at sheep ikke er i vejen for boar
            ;(not(taunt-detected my-player-number 209))
            =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-next-sheep)
                (up-get-point position-self gl-position-self-x)
                (up-modify-goal gl-position-self-x c:- 2)
                (up-modify-goal gl-position-self-y c:- 1)
                (set-strategic-number sn-target-point-adjustment 5)
                (up-set-target-point gl-position-self-x)
                (up-remove-objects search-local object-data-distance <= -1)
                (up-target-point gl-position-self-x action-move -1 -1)
                ;(chat-to-all "moving sheep to be taken soon")
            )

            (defrule
            (not(goal gl-sheppard-priority 0-build-first-two-houses))
                (up-compare-goal gl-next-sheep != 1)
                (up-set-target-by-id g: gl-current-sheep)
                (up-object-data object-data-carry < 18)
                (up-set-target-by-id g: gl-next-sheep)
                (up-object-data object-data-distance > 1)
            ; (up-timer-status t-sheep-move != timer-running)
            =>
                (up-full-reset-search)
                (up-find-local c: livestock-class c: 10)
                (up-get-search-state gl-local-total)
                (up-remove-objects search-local object-data-id g:== gl-next-sheep)
                (up-remove-objects search-local object-data-id g:== gl-stuck-sheep)
                (up-clean-search search-local object-data-distance search-order-asc)
            )

            (defrule
                (up-compare-goal gl-local-total > 3)
                (not(goal gl-sheppard-priority 0-build-first-two-houses))
                (up-compare-goal gl-next-sheep != 1)
                (up-set-target-by-id g: gl-current-sheep)
                (up-object-data object-data-carry < 25)
                (up-set-target-by-id g: gl-next-sheep)
                (up-object-data object-data-distance > 3) ;3?
                (up-set-target-object search-local c: 0)
                (up-object-data object-data-distance < 6)
                (up-timer-status new-sheep-timer != timer-running)
                =>
                (up-modify-goal gl-stuck-sheep g:= gl-next-sheep)
                (up-get-object-data object-data-id gl-next-sheep)
                
                ;(chat-to-all "Next sheep cant make it to correct location. Chosing new")
                (enable-timer new-sheep-timer 7)
            )

            (defrule
                    (up-compare-goal gl-my-position != 4)
                    =>
                    (up-get-point position-self gl-position-self-x)
                    (up-get-point position-flank gl-temp-x)
                )

                (defrule
                    (up-compare-goal gl-my-position != 4)
                    (up-compare-goal gl-enemy-x != -1)
                    =>
                    (up-copy-point gl-temp-x gl-enemy-x)
                )

                (defrule
                    (up-compare-goal gl-my-position == 4)
                    =>
                    (up-get-point position-center gl-position-self-x)
                    (up-get-point position-flank gl-temp-x)
                    (up-lerp-tiles gl-temp-x gl-position-self-x c: 40)
                    (up-get-point position-self gl-position-self-x)
                )

                (defrule
                    (true)
                    =>
                    (up-lerp-tiles gl-position-self-x gl-temp-x c: -3)
                )

                (defrule
                    (up-compare-goal gl-second-boar-status < second-boar-is-dead)
                    =>
                    (up-get-point position-self gl-position-self-x)
                    (up-modify-goal gl-position-self-x c:+ 2)
                    (up-modify-goal gl-position-self-y c:- 2)
                )

            (defrule
            (not(goal gl-sheppard-priority 0-build-first-two-houses))
                (up-compare-goal gl-next-sheep != 1)
                (up-set-target-by-id g: gl-current-sheep)
                (up-object-data object-data-carry >= 65)
            ; (up-timer-status t-sheep-move != timer-running)
            ;(up-compare-goal gl-sheep-taken < 4) ; sikrer at sheep ikke er i vejen for boar
            =>
                (up-full-reset-search)
                (up-add-object-by-id search-local g: gl-next-sheep)
                
                (set-strategic-number sn-target-point-adjustment 5)
                (up-set-target-point gl-position-self-x)
                (up-remove-objects search-local object-data-distance <= -1)
                (up-target-point gl-position-self-x action-move -1 -1)
            )
            (defrule
                (up-timer-status t-sheep-move != timer-running)
            =>
                (enable-timer t-sheep-move 12)
            )

        ;5 retask sheppards
            ; debug
                (defrule
                    (taunt-detected my-player-number 18)
                    =>
                    (up-chat-data-to-all "gl-sheppard-priority is %d." g: gl-sheppard-priority)
                    (acknowledge-taunt my-player-number 18)
                )
            ;
            ; Set sheppard priority
                (defrule
                (true)
                =>
                (set-goal gl-sheppard-priority 4-stragglers)
                )

                (defrule
                    (true)
                    =>
                    (up-get-point position-self gl-position-self-x)
                    (up-modify-goal gl-position-self-x c:- 1)
                    (up-modify-goal gl-position-self-y c:- 1)
                    (up-set-target-point gl-position-self-x)
                )

                (defrule
                    (up-set-target-by-id g: gl-current-sheep)
                    (up-object-data object-data-hitpoints >= 1)
                    (up-object-data object-data-distance < 4)
                =>
                (set-goal gl-sheppard-priority 3-living-current-sheep)
                )

                (defrule
                    (true)
                    =>
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                )

                (defrule
                    (or(and(goal gl-first-boar-status first-boar-is-dead)
                    (and(up-set-target-by-id g: gl-first-boar-id)
                    (up-object-data object-data-distance < 8)))
                    (and(goal gl-first-boar-status first-boar-is-gone)
                    (and(goal gl-second-boar-status second-boar-is-dead)
                    (and(up-set-target-by-id g: gl-second-boar-id)
                    (up-object-data object-data-distance < 8)))))
                    =>
                    (set-goal gl-sheppard-priority 2-dead-boar)
                )

                (defrule
                    (true)
                    =>
                    (up-get-point position-self gl-position-self-x)
                    (up-modify-goal gl-position-self-x c:- 1)
                    (up-modify-goal gl-position-self-y c:- 1)
                    (up-set-target-point gl-position-self-x)
                )

                (defrule
                    (up-set-target-by-id g: gl-current-sheep)
                    (up-object-data object-data-hitpoints < 1)
                    ;(up-object-data object-data-distance < 3)
                =>
                (set-goal gl-sheppard-priority 1-dead-current-sheep)
                )

                (defrule
                    (up-pending-objects c: house > 0)
                    (building-type-count-total house <= 2)
                =>
                (set-goal gl-sheppard-priority 0-build-first-two-houses)
                )
            
            ; 0-build-first-two-houses
                (defrule 
                        (goal gl-sheppard-priority 0-build-first-two-houses)
                        =>
                        (set-goal gl-confused-vill-loop-counter 0)
                    )

                    (defrule 
                        (goal gl-sheppard-priority 0-build-first-two-houses)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != shepard-group)
                        (up-clean-search search-local object-data-id search-order-asc)
                        (up-remove-objects search-local object-data-index g:!= gl-confused-vill-loop-counter)
                        (up-remove-objects search-local object-data-type == 212) ; female builder
                        (up-remove-objects search-local object-data-type == 118) ; male builder
                        (up-get-point position-self gl-temp-x)
                        (up-modify-goal gl-position-self-x c:- 1)
                        (up-modify-goal gl-position-self-y c:- 1)
                        (up-set-target-point gl-temp-x)
                    )

                        (defrule
                        (goal gl-sheppard-priority 0-build-first-two-houses)
                            (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-target-data object-data-id gl-confused-vill-target)
                    )

                    (defrule
                        (goal gl-sheppard-priority 0-build-first-two-houses)
                        (up-compare-goal gl-confused-vill-target g:!= gl-current-sheep)
                        (up-set-target-object search-local c: 0)
                        (up-object-data object-data-hitpoints >= 1)
                        (up-object-data object-data-distance < 3)
                        (game-time > 5)
                        =>
                        (up-add-object-by-id search-remote g: gl-current-sheep)
                        (up-target-objects 0 action-default -1 -1)
                        ;(chat-to-all "retargeting vill to living current sheep while houses are completed")
                    )

                    (defrule
                        (goal gl-sheppard-priority 0-build-first-two-houses)
                        (up-compare-goal gl-confused-vill-loop-counter <= 7)
                        =>
                        (up-modify-goal gl-confused-vill-loop-counter c:+ 1)
                        (up-jump-rule -4)
                    )
            ; 1-dead-current-sheep
                
                        (defrule 
                        (goal gl-sheppard-priority 1-dead-current-sheep)
                        =>
                        (set-goal gl-confused-vill-loop-counter 0)
                    )

                    (defrule 
                        (goal gl-sheppard-priority 1-dead-current-sheep)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != shepard-group)
                        (up-clean-search search-local object-data-id search-order-asc)
                        (up-remove-objects search-local object-data-index g:!= gl-confused-vill-loop-counter)
                        (up-remove-objects search-local object-data-type == 212) ; female builder
                        (up-remove-objects search-local object-data-type == 118) ; male builder
                    )

                    (defrule
                       (goal gl-sheppard-priority 1-dead-current-sheep)
                       (game-time < 400) ; fungerer sammen med regel med garrison de første 400 sek for at forhindrer at lumberjacks mister deres wood når de retarskes
                       (up-set-target-object search-local c: 0)
                       (up-object-data object-data-carry > 0)
                        =>
                        (up-remove-objects search-local object-data-type == 218) ; male lumberjack
                    (up-remove-objects search-local object-data-type == 123) ; female lumberjack
                    )

                    (defrule ;vil gerne fjerne ca. halvdelen.
                        (goal gl-sheppard-priority 1-dead-current-sheep)
                        (goal gl-first-boar-status first-boar-is-dead)
                        (up-set-target-object search-local c: 0)
                       (up-object-data object-data-target != 915)
                        =>
                        (up-remove-objects search-local object-data-carry == 0)
                        (up-remove-objects search-local object-data-carry == 3)
                        (up-remove-objects search-local object-data-carry == 4)
                        (up-remove-objects search-local object-data-carry == 5)
                        (up-remove-objects search-local object-data-carry == 6)
                    )

                    (defrule
                    (goal gl-sheppard-priority 1-dead-current-sheep)
                        (up-compare-goal BOAR-STATUS != Eating-Boar)
                        (up-compare-goal BOAR-STATUS != -1)
                        (up-compare-goal gl-second-boar-status < second-boar-is-dead)
                        =>
                        (up-remove-objects search-local object-data-id g:== gl-first-boar-luring-villager)
                        (up-remove-objects search-local object-data-id g:== gl-second-boar-luring-villager)
                    )

                        (defrule
                        (goal gl-sheppard-priority 1-dead-current-sheep)
                            (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-target-data object-data-id gl-confused-vill-target)
                    )

                    (defrule
                    (up-set-target-by-id g: gl-current-sheep)
                    
                    (not(and(up-object-data object-data-tasks-count > 1)
                        (goal gl-first-boar-status first-boar-is-dead)))
                        (not(and(up-object-data object-data-carry < 20)
                        (and(up-object-data object-data-tasks-count > 0)
                        (goal gl-first-boar-status first-boar-is-dead))))

                        (goal gl-sheppard-priority 1-dead-current-sheep)
                        (up-compare-goal gl-confused-vill-target g:!= gl-current-sheep)
                        (up-set-target-object search-local c: 0)
                        (up-compare-goal BOAR-STATUS != Killing-Boar)
                        =>
                        (set-goal gl-split-rule 61)
                    )

                    (defrule
                        (goal gl-split-rule 61)
                        =>
                        (set-goal gl-split-rule 0)
                        (up-add-object-by-id search-remote g: gl-current-sheep)
                        (up-target-objects 0 action-default -1 -1)
                        ;(chat-to-all "retargeting vill to dead current sheep")
                    )
                        

                    (defrule
                        (goal gl-sheppard-priority 1-dead-current-sheep)
                        (up-compare-goal gl-confused-vill-loop-counter <= 15)
                        =>
                        (up-modify-goal gl-confused-vill-loop-counter c:+ 1)
                        (up-jump-rule -8)
                    )

                    (defrule ;extra for at first-boar-luring villager ikke går idle 
                        (goal gl-sheppard-priority 1-dead-current-sheep)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != shepard-group)
                        (up-remove-objects search-local object-data-idling c:!= 1)
                    )

                    (defrule 
                        (goal gl-sheppard-priority 1-dead-current-sheep)
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-add-object-by-id search-remote g: gl-first-boar-id)
                        (up-target-objects 0 action-default -1 -1)
                        ;(chat-to-all "sending idle luring vill to boar")
                    )
            ; 2-dead-boar
                
                (defrule ;First boar
                    (goal gl-sheppard-priority 2-dead-boar)
                    =>
                    (set-goal gl-confused-vill-loop-counter 0)
                )

                (defrule 
                    (goal gl-sheppard-priority 2-dead-boar)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != shepard-group)
                    (up-clean-search search-local object-data-id search-order-asc)
                    (up-remove-objects search-local object-data-index g:!= gl-confused-vill-loop-counter)
                    (up-remove-objects search-local object-data-type == 212) ; female builder
                        (up-remove-objects search-local object-data-type == 118) ; male builder
                    ;(up-remove-objects search-local object-data-carry > 0)
                )
                
                (defrule ;make only some vills take the last food from first boar
                        (goal gl-sheppard-priority 1-dead-current-sheep)
                        (goal gl-first-boar-status first-boar-is-dead)
                        (goal gl-first-boar-status second-boar-is-dead)
                        =>
                        (up-remove-objects search-local object-data-carry > 8)
                    )

                (defrule
                    (goal gl-sheppard-priority 2-dead-boar)
                        (up-compare-goal BOAR-STATUS != Eating-Boar)
                        ;(up-compare-goal BOAR-STATUS != -1)
                        ;(up-compare-goal BOAR-STATUS != 0)
                        ;(up-compare-goal BOAR-STATUS != 1)
                        =>
                        (up-remove-objects search-local object-data-id g:== gl-second-boar-luring-villager)
                    )

                    (defrule
                    (goal gl-sheppard-priority 2-dead-boar)
                        (up-set-target-object search-local c: 0)
                    =>
                    (up-get-object-target-data object-data-id gl-confused-vill-target)
                )

                (defrule
                    (goal gl-sheppard-priority 2-dead-boar)
                    (goal gl-first-boar-status first-boar-is-dead)
                    (up-compare-goal gl-confused-vill-target g:!= gl-first-boar-id)
                    (up-compare-goal BOAR-STATUS != Killing-Boar)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-add-object-by-id search-remote g: gl-first-boar-id)
                    (up-target-objects 0 action-default -1 -1)
                    ;(chat-to-all "retargeting vill to first dead boar")
                )

                (defrule
                    (up-compare-goal gl-confused-vill-loop-counter <= 15)
                    =>
                    (up-modify-goal gl-confused-vill-loop-counter c:+ 1)
                    (up-jump-rule -6)
                )


                (defrule ;second boar
                    (goal gl-sheppard-priority 2-dead-boar)
                    =>
                    (set-goal gl-confused-vill-loop-counter 0)
                )

                (defrule ;1
