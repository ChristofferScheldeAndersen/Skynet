                        (up-get-fact unit-type-count villager-stone gl-temp3)
                        (up-modify-goal gl-temp2 c:+ 1) ; så der ikke bygges stone mining camp med det samme
                        (up-modify-goal gl-temp2 c:* 100)
                        (up-modify-goal gl-temp2 g:/ gl-temp3)
                        ;(up-modify-goal gl-temp2 c:/ 100)
                        ;(up-chat-data-to-all "stone mines per 100 stone miners are %d." g: gl-temp2)
                    )

                    (defrule 
                        (building-type-count-total castle < 1)
                        (up-research-status c: imperial-age >= research-pending)
                        =>
                        (up-get-fact unit-type-count villager-stone gl-temp3)
                        (up-modify-goal gl-temp2 c:* 100)
                        (up-modify-goal gl-temp2 g:/ gl-temp3)
                        ;(up-modify-goal gl-temp2 c:/ 100)
                        ;(up-chat-data-to-all "stone mines per 100 stone miners are %d." g: gl-temp2)
                    )

