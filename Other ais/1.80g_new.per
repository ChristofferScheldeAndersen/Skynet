                (up-filter-distance c: -1 c: 4)
                (up-find-local c: 904 c: 4)
                (up-remove-objects search-local object-data-hitpoints < 40)
                (up-target-objects 1 action-default -1 -1)
                ;;(chat-to-all "shooting deer")
            )

            #load-if-not-defined UP-POCKET-POSITION

            (defrule
                (goal gl-lure 2)
            (or	(not	(up-set-target-by-id g: gl-deer))
                (and	(up-set-target-by-id g: gl-deer)
                    (and	(up-object-data object-data-status != 2)
                        (up-object-data object-data-status != -1))))
                        (game-time < 590)
            (game-time > 5) =>
                (set-goal gl-lure 1)
            )

            #end-if

            #load-if-defined UP-POCKET-POSITION

            (defrule
                (goal gl-lure 2)
            (or	(not	(up-set-target-by-id g: gl-deer))
                (and	(up-set-target-by-id g: gl-deer)
                    (and	(up-object-data object-data-status != 2)
                        (up-object-data object-data-status != -1))))
                        (game-time < 890)
            (game-time > 5) =>
