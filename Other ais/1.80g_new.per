                        (defrule
                        (goal gl-agression-mode retreating)
                        (up-research-status c: ri-halberdier < research-pending)
                        (up-research-status c: ri-pikeman >= research-pending)
                        (up-compare-goal gl-temp3 >= 25)
                        (up-compare-goal gl-temp2 >= 35)
