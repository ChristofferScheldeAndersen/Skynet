                    (up-target-objects 0 action-gather -1 -1)
                    )

                    (defrule 
                    ;(up-compare-goal gl-deer-luring-stage == No-more-deer-to-eat)
                    (or(and(unit-type-count villager >= 25)
                    (unit-type-count villager <= 27))
                    (and(unit-type-count villager >= 30)
                    (and(unit-type-count villager <= 32)
                    (not(goal gl-no-more-berries 1)))))
                    =>
                    (set-goal gl-split-rule 104)
                    )

