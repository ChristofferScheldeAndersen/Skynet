                                    ;;;(up-chat-data-to-all "id of tree is %d." g: gl-temp14)
                                ) 

                                (defrule
                                    (goal gl-build-stone-mining-camp YES)
                                    (up-set-target-object search-remote c: 0)
                                    =>
                                    (up-get-object-data object-data-id gl-temp15)
                                    (up-remove-objects search-remote object-data-index == 0)
                                    ;;;(up-chat-data-to-all "id of tree is %d." g: gl-temp15)
                                ) 

                                (defrule
                                    (goal gl-build-stone-mining-camp YES)
                                    (up-set-target-object search-remote c: 0)
                                    =>
                                    (up-get-object-data object-data-id gl-temp16)
