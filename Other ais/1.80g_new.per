                        (up-modify-goal gl-remote-total c:/ 4)
                    )

                    (defrule
                        (up-compare-goal gl-local-total g:< gl-remote-total)
                        (up-compare-goal gl-remote-total > 2)
                        ;(or(up-compare-goal gl-temp34 > 0)
                        (up-point-distance gl-temp-x gl-enemy-x > 20)
                        =>
                        (up-modify-goal gl-group-superiority c:= -10)
                    )

                ;Modifier for lowering retreat thresshold while allready attacking

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp8 0)
                    )

                    (defrule
                        (goal 1 1)
                        (up-compare-goal gl-temp1 >= 8) ;dont keep attacking when army numbers are low
                        =>
                        (set-goal gl-temp8 5)
                        (up-modify-goal gl-group-superiority g:+ gl-temp8)
                    )

                ;Stop attacking when first enemy is killed in FFA
                    #load-if-not-defined UP-2-PLAYER-GAME
                    #load-if-not-defined UP-3-PLAYER-GAME
                    #load-if-not-defined UP-2-PLAYER-TEAM
                    #load-if-not-defined UP-3-PLAYER-TEAM
                    #load-if-not-defined UP-4-PLAYER-TEAM
                    #load-if-not-defined UP-5-PLAYER-TEAM
                    #load-if-not-defined UP-6-PLAYER-TEAM
                    #load-if-not-defined UP-7-PLAYER-TEAM
                    (defrule
                        (true)
                        =>
                        (up-modify-sn sn-focus-player-number g:= gl-flank)
                    )
                    
                    (defrule
                        (or(players-population focus-player < 15)
                        (player-resigned focus-player))
                        (game-time > 800)
                        =>
                        (set-strategic-number sn-stay-defensive-untill-imp 1)
                        (disable-self)
                    )

                    (defrule
                        (players-population focus-player < 20)
                        (game-time > 900)
                        =>
                        (set-strategic-number sn-stay-defensive-untill-imp 1)
                        (disable-self)
                    )

                    (defrule
                        (players-population focus-player < 25)
                        (game-time > 1000)
                        =>
                        (set-strategic-number sn-stay-defensive-untill-imp 1)
                        (disable-self)
                    )

                    (defrule
                        (players-population focus-player < 30)
                        (game-time > 1100)
                        =>
                        (set-strategic-number sn-stay-defensive-untill-imp 1)
                        (disable-self)
                    )

                    (defrule
                        (game-time > 1200)
                        =>
                        (set-strategic-number sn-stay-defensive-untill-imp 1)
                        (disable-self)
                    )

                    (defrule
                        (up-compare-sn sn-stay-defensive-untill-imp == 1)
                        =>
                        (set-goal gl-group-superiority -1)
                    )
                    #end-if
                    #end-if
                    #end-if
                    #end-if
                    #end-if
                    #end-if
                    #end-if
                    #end-if

                ;Modifier for not retreating when behind enemy tc.
                    (defrule
                        (true)
                        =>
                        (up-get-point position-self gl-temp1-x)
                        (up-modify-goal gl-temp1-x c:* 100)
                        (up-modify-goal gl-temp1-y c:* 100)
                        (up-copy-point gl-temp2-x gl-enemy-x)
                        (up-modify-goal gl-temp2-x c:* 100)
                        (up-modify-goal gl-temp2-y c:* 100)
                        (up-get-point-distance gl-temp1-x gl-temp2-x gl-temp10)
                        (up-get-point-distance gl-temp1-x gl-temp9-x gl-temp11)
                        (up-modify-goal gl-temp11 g:- gl-temp10)
                    )

                    (defrule
                        (up-compare-goal gl-temp11 > 200)
                        =>
                        (up-modify-goal gl-group-superiority c:+ 1000)
                    )
                ;Keep attacking pocket untill army dies

                    (defrule
                        (true)
                        =>
                        (up-copy-point gl-temp-x gl-ranged-army-x)
                        (up-modify-goal gl-temp-x c:/ 100)
                        (up-modify-goal gl-temp-y c:/ 100)
                        (up-get-point position-self gl-temp1-x)
                    )
                    
                    (defrule
                        (up-compare-goal gl-enemy-x g:== gl-enemy-pocket-x)
                        (up-compare-goal gl-enemy-y g:== gl-enemy-pocket-y)
                        (up-point-distance gl-temp-x gl-temp1-x > 65)
                        =>
                        (set-goal gl-group-superiority 999)
                    )
                ;Changing attacking goal

                    (defrule
                        (true)
                        =>
                        (set-goal 1 0)
                    )

                    (defrule
                        (up-compare-goal gl-group-superiority >= 0)
                        =>
                        (set-goal 1 1)
                    )

