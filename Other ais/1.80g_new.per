                        (up-research-status c: imperial-age == research-complete)
                        =>
                        (set-goal gl-temp5 1)
                    )

                    ;training rule
                        (defrule
                            (goal gl-temp1 1) ;dont produce if you soon will need to save for upgrades   
                            (can-train knight-line)
                            (up-compare-goal gl-temp2 >= 60)
                            (up-compare-goal gl-temp3 >= 75)

                            (not(and(research-completed imperial-age)
                            (and(up-pending-objects c: knight-line >= 8)
                            (and(up-research-status c: ri-paladin < research-pending)
                            (up-research-status c: ri-savar < research-pending)))))
                            =>
                            (set-goal gl-split-rule 253)
                        )

                        (defrule
                            (goal gl-split-rule 253)
                            (not(and(research-completed imperial-age)
                            (and(up-pending-objects c: knight-line >= 7)
                            (up-research-status c: ri-cavalier < research-pending))))

                            (or(goal gl-early-imp-strat early-paladin)
                            (up-research-status c: imperial-age < research-pending))
                            (goal gl-temp5 -1)
                            =>
                            (train knight-line)
                        )
                            

                        (defrule
                            (goal gl-temp1 1) ;dont produce if you soon will need to save for upgrades   
                            (can-train knight-line)
                            (up-compare-goal gl-temp2 >= 60)
                            (up-compare-goal gl-temp3 >= 75)

                            (not(and(research-completed imperial-age)
                            (and(up-pending-objects c: knight-line >= 8)
                            (and(up-research-status c: ri-paladin < research-pending)
                            (up-research-status c: ri-savar < research-pending)))))
                            =>
                            (set-goal gl-split-rule 254)
                        )

                        (defrule
                            (goal gl-split-rule 254)
                            (not(and(research-completed imperial-age)
                            (and(up-pending-objects c: knight-line >= 7)
                            (up-research-status c: ri-cavalier < research-pending))))

                            (or(goal gl-early-imp-strat early-paladin)
                            (up-research-status c: imperial-age < research-pending))
                            (or(up-research-status c: ri-paladin >= research-pending)
                            (up-research-status c: ri-savar >= research-pending))
                            (goal gl-temp5 -1)
                            =>
                            (train knight-line)
                        )
                            

                        (defrule
                            (goal gl-temp1 1) ;dont produce if you soon will need to save for upgrades   
                            (can-train knight-line)
                            (up-compare-goal gl-temp2 >= 60)
                            (up-compare-goal gl-temp3 >= 75)

                            (not(and(research-completed imperial-age)
                            (and(up-pending-objects c: knight-line >= 8)
                            (and(up-research-status c: ri-paladin < research-pending)
                            (up-research-status c: ri-savar < research-pending)))))
                            =>
                            (set-goal gl-split-rule 255)
                        )

                        (defrule
                            (goal gl-split-rule 255)
                            (not(and(research-completed imperial-age)
                            (and(up-pending-objects c: knight-line >= 7)
                            (up-research-status c: ri-cavalier < research-pending))))

                            (or(goal gl-early-imp-strat early-paladin)
                            (up-research-status c: imperial-age < research-pending))
                            (or(up-research-status c: ri-paladin >= research-pending)
                            (up-research-status c: ri-savar >= research-pending))
                            (goal gl-temp5 -1)
                            =>
                            (train knight-line)
                        )
                            

                        (defrule
                            (goal gl-temp1 1) ;dont produce if you soon will need to save for upgrades   
                            (can-train knight-line)
                            (goal gl-saving-for-upgrade -1)
                            (or(goal gl-early-imp-strat delayed-paladin)
                            (up-research-status c: imperial-age < research-pending))
                            (not(and(research-completed imperial-age)
                            (and(up-pending-objects c: knight-line >= 7)
                            (up-research-status c: ri-cavalier < research-pending))))
                            (up-compare-goal gl-temp2 >= 60)
                            (up-compare-goal gl-temp3 >= 75)
                            (goal gl-temp5 -1)
                            =>
                            (train knight-line)
                        )

                        (defrule
                            (goal gl-temp1 1) ;dont produce if you soon will need to save for upgrades  
                            (or(unit-type-count-total knight-line < 15)
                            (and(food-amount > 1200)
                            (gold-amount > 800)))
                            (or(up-research-status c: imperial-age >= research-pending)
                            (and(up-research-status c: imperial-age < research-pending)
                            (and(unit-type-count-total villager >= 75)
                            (up-compare-goal gl-MILITARY-SUPERIORITY < -5))))
                            (can-train knight-line)
                            (up-compare-goal gl-saving-for-upgrade != saving-for-cavalier)
