                                ;Check tiles
                                    ;der skiftes mellem de 9 farm tiles

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 2)
                                        =>
                                        (up-modify-goal gl-building-testing-spot-y c:- 1)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 3)
                                        =>
                                        (up-modify-goal gl-building-testing-spot-x c:- 1)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 4) ; end of original square
                                        =>
                                        (up-modify-goal gl-building-testing-spot-y c:+ 1)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 5)
                                        =>
                                        (up-modify-goal gl-building-testing-spot-y c:+ 1)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 6)
                                        =>
                                        (up-modify-goal gl-building-testing-spot-x c:+ 1)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 7)
                                        =>
                                        (up-modify-goal gl-building-testing-spot-x c:+ 1)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 8)
                                        =>
                                        (up-modify-goal gl-building-testing-spot-y c:- 1)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 9)
                                        =>
                                        (up-modify-goal gl-building-testing-spot-y c:- 1)
                                    )


                                    ;tile checkes

                                    (defrule
                                        (up-compare-goal gl-tiles-checker <= 9)
                                        (up-compare-goal gl-tiles-checker != -1)
                                        (or(not(and(up-can-build-line 0 gl-building-testing-spot-x c: palisade-wall) 
                                        (can-afford-building palisade-wall)))
                                        (and(up-compare-goal gl-tiles-checker == 1)
                                        (not(and(up-can-build-line 0 gl-building-testing-spot-x c: farm) 
                                        (can-afford-building farm)))))
                                        (goal gl-build-farm YES)
                                        =>
                                        (up-modify-goal gl-stuff-in-the-way c:+ 1)
                                    )

                                    (defrule ;extra rule to not make bugged farm in the corner
                                        (goal gl-build-farm YES)
                                        (up-compare-goal gl-building-testing-spot-x < 6)
                                        (up-compare-goal gl-building-testing-spot-y < 6)
                                        =>
                                        (up-modify-goal gl-stuff-in-the-way c:+ 1)
                                    )


                                    ;det lille loop med de 9 farm tiles genstartes

                                    (defrule
                                        (up-compare-goal gl-tiles-checker < 9) ; evt også lig med
                                        (up-compare-goal gl-tiles-checker != -1)
                                        (goal gl-build-farm YES)
                                        =>
                                        (up-modify-goal gl-tiles-checker c:+ 1)
                                        (set-goal gl-dont-count-tile -1)
                                        (up-jump-rule -11)
                                    )



                                    ;hvis der ikke kan bygges farm på spottet genstartes det store loop fra næste farm spot

                                    (defrule
                                        (goal gl-build-farm YES)
                                        (up-compare-goal gl-stuff-in-the-way > 0)
                                        (up-compare-goal gl-tiles-checker != -1)
                                        (up-compare-goal gl-danger-counter < 300)
                                        =>
                                        ;;;(up-chat-data-to-all "Placement blocked or to close to tc. Number of unfit tiles for placing building is %d." g: gl-stuff-in-the-way)
                                        (up-modify-goal gl-tiles-checker c:= 1)
                                        (up-modify-goal gl-farm-check c:+ 1)
                                        (up-modify-goal gl-stuff-in-the-way c:= 0) ; skal aktiveres
                                        (up-modify-goal gl-danger-counter c:+ 1)
                                        (up-jump-rule -289)
                                    )



                ;hvis der ikke er blokkeret bygges farm og loop stoppes

                (defrule
                    (true)
                    =>
                    (set-goal gl-farm-was-placed-this-pass -1)
                    (set-goal gl-temp -1)
                )

                (defrule
                    (goal gl-build-farm YES)
                    (up-compare-goal gl-stuff-in-the-way == 0)
                    (up-compare-goal gl-tiles-checker != -1)
                    (up-can-build-line 0 gl-position-self-x c: farm)
                    =>
                    ;;(chat-to-all "build farm")
                    (up-build-line gl-position-self-x gl-position-self-x c: farm)
                    (set-goal gl-temp 1)
                )

                (defrule
                    (true)
                    =>
                    (set-goal gl-no-space-for-farms -1)
                )

                (defrule
                    (goal gl-build-farm YES)
                    (up-compare-goal gl-stuff-in-the-way == 0)
                    (up-compare-goal gl-tiles-checker != -1)
                    (goal gl-temp -1)
                    (up-pending-objects c: farm == 0)
                    (wood-amount >= 100)
                    =>
                    (set-goal gl-no-space-for-farms 1)
                    ;(chat-to-all "no space for farms")
                )

                (defrule
                    (goal gl-build-farm YES)
                    (up-compare-goal gl-stuff-in-the-way == 0)
                    (up-compare-goal gl-tiles-checker != -1)
                    =>
                    ;;(chat-to-all "build farm")
                    (set-goal gl-build-farm -1)
                    (set-goal gl-farm-was-placed-this-pass YES)
                )

    
    
        ;Lumber camps
            ; A NEW* Finding a part of a forrest suitable for a lumber camp.
                ; 1a Searching for trees - Start of big loop

                        ; general search for wood starting at a point behind the tc sortet by distance to that point.

                        (defrule 
                            (goal gl-build-lc YES)
                            =>
                            ;(up-modify-goal gl-surrounding-trees c:== -1)
                            (up-modify-goal gl-checked-trees c:= 0)
                            (up-modify-goal gl-suitable-trees-found c:= 0)
                            (up-modify-goal gl-minimum-tree-distance c:= 5)
                            (up-modify-goal gl-maximum-tree-distance c:= 6)
                            (up-modify-goal gl-first-suitable-tree c:= -1)
                            (up-modify-goal gl-second-suitable-tree c:= -1)
                            (up-modify-goal gl-third-suitable-tree c:= -1)
                            (up-modify-goal gl-forth-suitable-tree c:= -1)
                            (up-modify-goal gl-fifth-suitable-tree c:= -1)
                            (up-modify-goal gl-sixth-suitable-tree c:= -1)
                            
                        )

                        (defrule
                            (goal gl-build-lc YES)
                            =>
                            ;(up-modify-goal gl-surrounding-trees c:== -1)
                            
                            (up-modify-goal gl-seventh-suitable-tree c:= -1)
                            (up-modify-goal gl-eighth-suitable-tree c:= -1)
                            (up-modify-goal gl-nineth-suitable-tree c:= -1)
                            (up-modify-goal gl-tenth-suitable-tree c:= -1)
                            (up-modify-goal gl-remote-total c:= -1)
                            (up-modify-goal gl-tree-checking-tile-x c:= -1)
                            (up-modify-goal gl-tree-checking-tile-y c:= -1)
                            (up-modify-goal gl-first-lumber-camp-tree-x c:= -1)
                            (up-modify-goal gl-first-lumber-camp-tree-y c:= -1)
                            (up-modify-goal gl-chosen-tree-point-x c:= -1)
                        )

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;0                      gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0                      gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0                      gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0                      gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15                     gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;-1                     gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;0                      gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                    ;;; efter big-loop-reset ;;;

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;0    netop reset       gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0 derfor reset         gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0-8?!                  gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;7?!                    gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                        (defrule 
                        (goal gl-build-lc YES) ; find trees
                            =>
                            (set-strategic-number sn-target-point-adjustment 5)
                            (up-full-reset-search)
                            (up-get-point position-self gl-position-self-x)
                            (up-get-point position-center gl-center-x)
                            (up-lerp-tiles gl-position-self-x gl-center-x c: -3) 
                            (up-set-target-point gl-position-self-x)
                            ;;;(up-chat-data-to-all "gl-maximum-tree-distance is %d." g: gl-maximum-tree-distance)
                            (up-filter-distance g: gl-minimum-tree-distance g: gl-maximum-tree-distance)
                            (up-filter-status c: status-ready c: list-active)
                            (up-find-resource c: wood c: 200)
                        )

                        (defrule
                            (goal gl-build-lc YES) ;remove trees close to first lc
                            (building-type-count lumber-camp >= 1)
                            =>
                            (up-reset-filters)
                            (up-filter-distance c: -1 c: 75)
                            (up-find-local c: lumber-camp c: 10)
                            (up-clean-search search-local object-data-index search-order-asc)
                            (up-set-target-object search-local c: 0)
                            (up-get-point position-object gl-position-x)
                            (up-set-target-point gl-position-x)
                            (up-remove-objects search-remote object-data-distance <= 10)
                        )
                            
                        (defrule
                            (goal gl-build-lc YES) ;remove trees close to second lc
                            (building-type-count lumber-camp >= 2)
                            =>
                            (up-remove-objects search-local object-data-index == 0)
                            (up-set-target-object search-local c: 0)
                            (up-get-point position-object gl-position-x)
                            (up-set-target-point gl-position-x)
                            (up-remove-objects search-remote object-data-distance <= 10)
                        )
                            
                        (defrule
                            (goal gl-build-lc YES) ;chose target tree for first check
                            =>
                            (up-set-target-object search-remote c: 0)
                            (up-get-point position-object gl-first-lumber-camp-tree-x)
                            (up-get-search-state gl-local-total)
                            ;;;(up-chat-data-to-all "number of trees found is %d." g: gl-remote-total)
                        )
                            

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;0                      gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0-8?!                  gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;7?!                    gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y    ny              gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                    ;;; efter lille loop reset ;;;

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;0-40 1 efter li-loop   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;7                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                
                
                
                ; 1b resetting loop variables (once per loop) - Start of small loop

                    ; then a rule resetting gl-surrounding-trees to 0 and adding one to gl-checked-trees so it will become 0 for the 
                    ; first run (starting at -1)

                    (defrule        ; runs once per tree
                        (goal gl-chosen-tree-point-x -1)
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-surrounding-trees c:= 0)
                        (up-modify-goal gl-surrounding-tiles-checked c:= 0)
                        ;;(chat-to-all "other rule is running")
                    )

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0                      gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                    ; then a rule subtracting one tree from the search if gl-checked trees are more than 0.

                    (defrule        ; runs conce per tree. Not first time
                        (up-compare-goal gl-checked-trees > 0)
                        (goal gl-chosen-tree-point-x -1)
                        (goal gl-build-lc YES)
                        =>
                        (up-remove-objects search-remote object-data-index == 0)
                        (up-set-target-object search-remote c: 0)
                        (up-get-point position-object gl-first-lumber-camp-tree-x)
                        (up-get-search-state gl-local-total)
                        ;;(chat-to-all "remove tree from the search that isnt the first one")
                    )

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40  -1               gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0                      gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y    ny              gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;



                ; 1c Loop counting number of surrounding trees for the current first tree on the list
                        ; there also needs to be a reset of the original tree-tile. idealy with a new temp goal used in the lines below this


                    (defrule        ; runs 8 times per tree
                        (goal gl-chosen-tree-point-x -1)
                        (goal gl-build-lc YES)
                        =>
                        (up-copy-point gl-tree-checking-tile-x gl-first-lumber-camp-tree-x)
                    )

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0                      gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y    reset           gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                    ; each tree will then enter a looping evaluation mode in the following fasion

                    (defrule ;up
                        (goal gl-chosen-tree-point-x -1)
                        (up-compare-goal gl-surrounding-tiles-checked == 0)
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-tree-checking-tile-x c:+ 1)
                        (up-modify-goal gl-tree-checking-tile-y c:- 1)
                    )

                    (defrule ;up-right
                        (goal gl-chosen-tree-point-x -1)
                        (up-compare-goal gl-surrounding-tiles-checked == 1)
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-tree-checking-tile-x c:+ 1)
                        )

                    (defrule ;right
                        (goal gl-chosen-tree-point-x -1)
                        (up-compare-goal gl-surrounding-tiles-checked == 2)
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-tree-checking-tile-x c:+ 1)
                        (up-modify-goal gl-tree-checking-tile-y c:+ 1)
                    )

                    (defrule ;low-right
                        (goal gl-chosen-tree-point-x -1)
                        (up-compare-goal gl-surrounding-tiles-checked == 3)
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-tree-checking-tile-y c:+ 1)
                    )

                    (defrule ;low
                        (goal gl-chosen-tree-point-x -1)
                        (up-compare-goal gl-surrounding-tiles-checked == 4)
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-tree-checking-tile-x c:- 1)
                        (up-modify-goal gl-tree-checking-tile-y c:+ 1)
                    )

                    (defrule ;low-left
                        (goal gl-chosen-tree-point-x -1)
                        (up-compare-goal gl-surrounding-tiles-checked == 5)
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-tree-checking-tile-x c:- 1)
                    )

                    (defrule ;left
                        (goal gl-chosen-tree-point-x -1)
                        (up-compare-goal gl-surrounding-tiles-checked == 6)
                        (goal gl-build-lc YES)
                                        =>
                        (up-modify-goal gl-tree-checking-tile-x c:- 1)
                        (up-modify-goal gl-tree-checking-tile-y c:- 1)
                    )

                    (defrule ;upper-left
                        (goal gl-chosen-tree-point-x -1)
                        (up-compare-goal gl-surrounding-tiles-checked == 7)
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-tree-checking-tile-y c:- 1)
                    )

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0                      gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y    ændret          gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                    ;checking tile and resetting loop


                    (defrule
                    (or(up-point-contains gl-tree-checking-tile-x c: 915) ; tree-class = 915
                    (up-point-contains gl-tree-checking-tile-x c: 66))
                    (goal gl-build-lc YES)
                    =>
                    (up-modify-goal gl-surrounding-trees c:+ 1)
                    )

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;0                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                    (defrule
                        (up-compare-goal gl-surrounding-tiles-checked < 7)
                        (up-compare-goal gl-surrounding-tiles-checked != -1)
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-surrounding-tiles-checked c:+ 1)
                        (up-jump-rule -11)
                    )

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;0-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;7                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                ; 1d When all surrounding tiles are tjecked the loop will reset, now with a new tree chosen unless the chosen tree
                    ; is surrounded by exactly 7 trees.
                    ; modify the point before the upper rule, then repeat 8 times in total clockwise. You should only need to paste the 
                    ; upper rule once.
                    ; if at the end of the loop gl-surrounding trees is above 5 the loop will stop and a tree is found

                
                    (defrule
                        (up-compare-goal gl-surrounding-tiles-checked == 7)
                        (nor(up-compare-goal gl-surrounding-trees == 6)
                        (and(up-compare-goal gl-suitable-trees-found < 10)
                        (up-compare-goal gl-surrounding-trees == 5)))
                        ;(up-compare-goal gl-surrounding-trees != 7) ; forsøg på at undgå camps på forkert sidde af weird lines
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-checked-trees < 40)                
                        =>
                        (up-modify-goal gl-checked-trees c:+ 1) ; 0 on first run
                        (up-jump-rule -14)
                    )

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;1-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;7                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5                    gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                ; 1x Når det originale loop gemmer et træ kræves det at der ikke er fundet de træer der skal (startende på 5)
                    ;Samtidig laves der multiple regler (først 5) for at gemme ID'et på hver af de fundne træer. Hver regel
                    ;lægger 1 til en counter der bruges til at åbne næste regel. Første regel må nødvendigvis være nederst osv.
                    ;I stedet er det nok bedre bare at have en regel tidligere der lægger en til counteren når et træ rent
                    ; faktisk er fundet. Så slipper man for omvendt rækkefølge

                    (defrule
                        (or(up-compare-goal gl-surrounding-trees == 6)
                        (and(up-compare-goal gl-suitable-trees-found < 10)
                        (up-compare-goal gl-surrounding-trees == 5)))
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-suitable-trees-found c:+ 1)
                    )

                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                    ;1-40                   gl-checked-trees: Antal træer der tjekkes inden et godkendt træ, 0-40
                    ;0-40                   gl-remote-total: Antal træer på search-remote-list,              0-40
                    ;0-8                    gl-surrounding-trees: Antal træer omkring tjek-træ,              0-8
                    ;7                      gl-surrounding-tiles-checked: Antal tiles undersøgt omkring træ, 0-7
                    ;0-5 måske ændret       gl-suitable-trees-found, antal træer med goal ID,                0-5
                    ;15-29                  gl-max/minimimum-tree-distance, søgeradius,                      15-30               

                    ;x,y                    gl-tree-checking-tile-x: Koordinaten der konstant ændres for at tælle træer.
                    ;x,y                    gl-first-lumber-camp-tree-x: Koordinaten til træet der tjekkes. Ændres ikke, men kopieres til den over.
                    ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

                    (defrule
                        (up-compare-goal gl-suitable-trees-found == 1)
                        (up-compare-goal gl-first-suitable-tree == -1)
                        (goal gl-build-lc YES)
                        =>
                        (up-get-search-state gl-local-total)
                        ;;;(up-chat-data-to-all "gl-remote-total before assigning ID is %d." g: gl-remote-total)
                        (up-set-target-object search-remote c: 0) ; måske ikke nødvendig
                        (up-get-object-data object-data-id gl-first-suitable-tree)
                        ;;;(up-chat-data-to-all "Number of trees surrounding first suitable tree is %d." g: gl-surrounding-trees)
                        ;;;(up-chat-data-to-all "Number of checked trees is %d." g: gl-checked-trees)
                        ;;;(up-chat-data-to-all "ID of first tree is %d." g: gl-first-suitable-tree)
                        ;;;(up-chat-data-to-all "first tree was found with gl-maximum-tree-distance %d." g: gl-maximum-tree-distance)
                    )

                    
