                    (players-unit-type-count target-player knight-line  < 2)
                        =>
                (up-modify-goal gl-MILITARY-SUPERIORITY c:+ 5)
                )

                (defrule
                (timer-triggered Military-Superiority-timer)
                (unit-type-count skirmisher-line >= 4)
                    (players-unit-type-count target-player archer-line  >= 5)
                    (players-unit-type-count target-player archer-line  < 10)
                    (players-unit-type-count target-player knight-line  < 2)
                        =>
                ;(chat-to-all "Countering opponent with skirmishers +5")
