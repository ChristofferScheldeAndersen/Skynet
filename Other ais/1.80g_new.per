                ; Build buildings with standard system (safe) ;stable
                    #load-if-defined DE-AVAILABLE
                    (defrule
                    (up-compare-goal gl-need-house == YES)
                        (can-build house) ;standard system er slået til
                        (up-pending-objects c: house == 0)
                        (goal gl-building-placed-this-pass NO)
                        (building-type-count house <= 5)
                        =>
                        (up-set-target-point gl-first-lumber-camp-location-x)
