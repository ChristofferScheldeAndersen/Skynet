            ;(chat-to-all "didnt find target player in time")
            )

            ;lav en god algoritme der kan afgøre hvornår target player bør skiftes

            ;lad os lave et score system for modstanderne hvor hver pop giver et point og hver age up giver en
            ;fordobling i score. En 200 pop imp player ville så have 1600. Måske det skal være mindre end fordobling
            ;på sigt. Hvis så ens target player har en score under en fjerdedel af ens egen og næstnærmeste modstander
            ;ikke har en score der er over 25% højere end ens egen kan man skifte target.

            (defrule
                (true)
                =>
                (up-find-player enemy find-closest gl-temp)
                (up-modify-sn sn-focus-player-number g:= gl-temp)
                (up-get-player-fact focus-player population 0 gl-temp1) ;nærmeste targets score

                (up-find-next-player enemy find-closest gl-temp)
                ;(up-chat-data-to-all "far player number is %d" g: gl-temp)
                (up-modify-sn sn-focus-player-number g:= gl-temp)
                ;(up-chat-data-to-all "focus player is %d" s: sn-focus-player-number)
                (up-get-player-fact focus-player population 0 gl-temp2) ;næstnærmeste target score
                ;(up-chat-data-to-all "gl-temp2 is %d" g: gl-temp2)

                (up-get-fact population 0 gl-temp3) ;egen score
            )

