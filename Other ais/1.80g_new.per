                (gold-amount > 400))))
                (up-compare-goal gl-MILITARY-SUPERIORITY <= -8)
                (not(and(enemy-buildings-in-town)
                (unit-type-count skirmisher-line > 1)))
                (food-amount >= 75)
                (unit-type-count archer-line < 7)
                =>
                (set-goal gl-split-rule 196))

                (defrule
                (goal gl-split-rule 196)
