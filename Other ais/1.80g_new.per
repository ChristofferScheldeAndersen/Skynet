                        (up-remove-objects search-local object-data-index == 0)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-compare-goal gl-local-total > 0)
                        (up-compare-goal gl-loop-counter < 50)
                        =>
                        (up-modify-goal gl-loop-counter c:+ 1)
                        (up-jump-rule -2)
                    )

                (defrule
                    (true)
                    =>
                    (up-get-fact food-amount 0 gl-temp1)
                    (up-modify-goal gl-temp7 g:+ gl-temp1)
                    ;(up-chat-data-to-all "food incl food carried by villagers is %d." g: gl-temp7)
                )

                (defrule
                (up-compare-goal gl-drop-off-food-time-reached == YES)
                (current-age == feudal-age)
                (unit-type-count-total villager >= 29)
                (up-pending-objects c: villager < 2)
                (research-available castle-age)
                (up-compare-goal gl-temp7 >= 800)
                (food-amount < 800)
                (gold-amount >= 200)
                =>
                (up-drop-resources food c: 1) ;A relatively low amount is good here to ensure you get every last bit to ensure you have enough
                ;(chat-to-all "force drop rule 6 running (food for castle age)")
                )

            ;D Gather points (skal samles fra resten af scriptet)
                ; vill nr 22 til berries
                    (defrule 
                        (unit-type-count villager == 21)
                        =>
                        (up-full-reset-search)
                    (up-find-local c: town-center c: 1)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-filter-distance c: 0 c: 20)
                    (up-filter-status c: status-resource c: list-active)
                    (up-find-resource c: food c: 200)
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    (up-set-target-object search-remote c: 0)
                    (up-get-point position-object gl-first-berry-bush-x)
                    (up-get-point position-self gl-position-self-x)
                    (up-lerp-tiles gl-first-berry-bush-x gl-position-self-x c: 7)
                    (up-set-target-point gl-first-berry-bush-x)
                    (up-target-point 0 action-gather -1 -1)
                    )  

                ; vill nr 23-24 på current sheep hvis det er der. 
                    (defrule 
                        (or(unit-type-count villager == 22)
                        (unit-type-count villager == 23))
                        (up-compare-goal gl-current-sheep != -1)
                        =>
                    (up-full-reset-search)
                    (up-find-local c: town-center c: 1)
                    (up-add-object-by-id search-remote g: gl-current-sheep)
                    (up-target-objects 0 action-gather -1 -1)
                    )

                ; vill nr 25 på second lumber camp
                    (defrule 
                    (unit-type-count villager == 24)
                    (building-type-count-total lumber-camp > 1)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: town-center c: 1)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-copy-point gl-temp-x gl-second-lumber-camp-location-x)
                    (up-lerp-tiles gl-temp-x gl-position-self-x c: 7)
                    (up-set-target-point gl-temp-x)
                    (up-target-point 0 action-gather -1 -1)
                    )

                ; vill nr 26-27 på first lumber camp
                    (defrule 
                    (or(unit-type-count villager == 25)
                    (unit-type-count villager == 26))
                    (building-type-count-total lumber-camp > 1)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: town-center c: 1)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-copy-point gl-temp-x gl-first-lumber-camp-location-x)
                    (up-lerp-tiles gl-temp-x gl-position-self-x c: 7)
                    (up-set-target-point gl-temp-x)
                    (up-target-point 0 action-gather -1 -1)
                    )

                ; vill nr 28-29 på guld
                    (defrule 
                    (or(unit-type-count villager == 27)
                    (unit-type-count villager == 28))
                    (building-type-count-total mining-camp > 0)
                    =>
                    (up-full-reset-search)
                    (up-get-point position-self gl-position-self-x)
                    (up-set-target-point gl-position-self-x)
                    (up-find-local c: mining-camp c: 1)
                    )

                    (defrule 
                    (or(unit-type-count villager == 27)
                    (unit-type-count villager == 28))
                    (building-type-count-total mining-camp > 0)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: town-center c: 1)
                    (up-get-point position-object gl-temp-x)
                    (up-lerp-tiles gl-temp-x gl-position-self-x c: 7)
                    (up-set-target-point gl-temp-x)
                    (up-target-point 0 action-gather -1 -1)
                    )
                
                    
                ; reset gather point after last vill
                    (defrule 
                    (unit-type-count villager == 29)
                    =>
                    (up-full-reset-search)
                    (up-gather-inside c: town-center c: 0)
                    )
        ;C Buildings
            ; NEW BUILDING SYSTEM
                ; Debug
                    (defrule
                        (taunt-detected my-player-number 9)
                        =>
                        (up-chat-data-to-all "gl-building-system is %d." g: gl-building-system)
                        (up-chat-data-to-all "gl-reset-builders is %d." g: gl-reset-builders)
                        (up-chat-data-to-all "gl-need-mill is %d." g: gl-need-mill)
                        (up-chat-data-to-all "gl-need-house is %d." g: gl-need-house)
                        (up-chat-data-to-all "gl-building-placed-this-pass is %d." g: gl-building-placed-this-pass)
                        (up-chat-data-to-all "gl-psudo-temp1 is %d." g: gl-psudo-temp1)
                        (up-chat-data-to-all "gl-psudo-temp2 is %d." g: gl-psudo-temp2)
                        (up-chat-data-to-all "gl-psudo-temp3 is %d." g: gl-psudo-temp3)
                        (up-chat-data-to-all "gl-psudo-temp4 is %d." g: gl-psudo-temp4)
                        (up-chat-data-to-all "gl-psudo-temp5 is %d." g: gl-psudo-temp5)
                        (up-chat-data-to-all "gl-psudo-temp6 is %d." g: gl-psudo-temp6)
                        (up-chat-data-to-all "gl-psudo-temp7 is %d." g: gl-psudo-temp7)
                        (up-chat-data-to-all "gl-psudo-temp8 is %d." g: gl-psudo-temp8)
                        (up-chat-data-to-all "gl-psudo-temp9 is %d." g: gl-psudo-temp9)
                        
                        (acknowledge-taunt my-player-number 9)
                    )
                ; Resetting goals

                    (defrule
                        (true)
                        =>
                        (set-goal gl-building-system build-line-system)
                        (set-goal gl-reset-builders NO)
                        (set-goal gl-need-mill NO)
                        (set-goal gl-need-house NO)
                        (set-goal gl-need-stable NO)
                        (set-goal gl-need-blacksmith NO)
                        (set-goal gl-need-mining-camp NO)
                        (set-goal gl-need-barracks NO)
                        (disable-self)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-building-placed-this-pass NO)
                    )

                    (defrule
                        (up-pending-objects c: barracks > 0)
                        (up-compare-goal gl-need-barracks == YES)
                        =>
                        (set-goal gl-need-barracks NO)
                    ) ; * alle bygninger

                    (defrule
                        (up-pending-objects c: house > 0)
                        (up-compare-goal gl-need-house == YES)
                        =>
                        (set-goal gl-need-house NO)
                    ) ; * alle bygninger

                    (defrule
                        (up-pending-objects c: stable > 0)
                        (up-compare-goal gl-need-stable == YES)
                        =>
                        (set-goal gl-need-stable NO)
                    ) ; * alle bygninger

                    (defrule
                        (up-pending-objects c: blacksmith > 0)
                        (up-compare-goal gl-need-blacksmith == YES)
                        =>
                        (set-goal gl-need-blacksmith NO)
                    ) ; * alle bygninger

                    (defrule
                        (up-pending-objects c: mining-camp > 0)
                        (up-compare-goal gl-need-mining-camp == YES)
                        =>
                        (set-goal gl-need-mining-camp NO)
                    ) ; * alle bygninger

                    ;(defrule
                    ;    (up-compare-goal gl-building-system == build-line-system)
                    ;    =>
                    ;    (set-goal gl-psudo-temp1 -1)
