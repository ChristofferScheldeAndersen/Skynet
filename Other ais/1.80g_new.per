                #end-if
            ; Starting fase 4 when taunt 203 is written
                (defrule
                    (or(taunt-detected any-ally 203)
                    (or(taunt-detected any-enemy 203)
                    (taunt-detected my-player-number 203)))
                    =>
                    (set-goal gl-fase 4)
                    (acknowledge-taunt every-ally 203)
                    (acknowledge-taunt every-enemy 203)
                    (acknowledge-taunt my-player-number 203)
                    (chat-to-all "Taunt 203 detected. Entering fase 4")
                )

            ; Starting fase 3 when reaching castle age

                (defrule
                    (current-age >= castle-age)
                    (up-compare-goal gl-fase != 4)
                    =>
                    (set-goal gl-fase 3)
                    (chat-to-all "Rehoboam is castle age. Entering fase 3")
                    (disable-self)
                )

            ; Starting fase 3 when game breaking error is detected
                ;Bugs detected based on ressources and villager distribution
                    ;obs: bør sammenholdes med antallet af vills på forskellige ressourcer for at sikre fejlen ikke er rettet.
                    ;Tal er fundet for 2x speed

                    (defrule ; test af hvad der kan forventes
                        (taunt-detected my-player-number 1)
                        =>
                        (up-get-fact resource-amount amount-food-total gl-temp)
                        (up-chat-data-to-player my-player-number "amount-food-total is %d." g: gl-temp)
                        (up-get-fact resource-amount amount-wood-total gl-temp)
                        (up-chat-data-to-player my-player-number "amount-wood-total is %d." g: gl-temp)
                        (up-get-fact resource-amount amount-gold-total gl-temp)
                        (up-chat-data-to-player my-player-number "amount-gold-total is %d." g: gl-temp)
                        (up-get-fact resource-amount amount-stone-total gl-temp)
                        (up-chat-data-to-player my-player-number "amount-stone-total is %d." g: gl-temp)
                        (acknowledge-taunt my-player-number 1)
                    )

                    (defrule ; 1,5 min
                        (up-compare-goal gl-fase <= 2)
                        (game-time > 120)
                        (game-time < 150)
                        (up-resource-amount amount-food-total < 10) ; 70 is expected
                        (unit-type-count villager-food < 5) ; 6 is expected
                        =>
                        (chat-to-all "Game breaking error 1,5 detected. Entering fase 3")
                        (set-goal gl-fase 3)
                        (disable-self)
                    )

                    (defrule ; 3 min
                        (up-compare-goal gl-fase <= 2)
                        (game-time > 180)
                        (game-time < 190)
                        (up-resource-amount amount-food-total < 200) ; 250 is expected
                        (unit-type-count villager-food < 6) ; 8 is expected
                        =>
                        (set-goal gl-fase 3)
                        (chat-to-all "Gamebreaking bug 3! Returning to old eco mode")
                        (disable-self)
                    )

                    (defrule ; 5 min
                        (up-compare-goal gl-fase <= 2)
                        (game-time > 300)
                        (game-time < 310)
                        (or(up-resource-amount amount-food-total < 250) ; 450 is expected
                        (up-resource-amount amount-wood-total < 10)) ; 100 is expected
                        (or(unit-type-count villager-food < 5) ; 8 is expected
                        (unit-type-count villager-wood < 2)) ; 4 is expected
                        =>
                        (set-goal gl-fase 3)
                        (chat-to-all "Gamebreaking bug 5! Returning to old eco mode")
                        (disable-self)
                    )

                    (defrule ; 7 min
                        (up-compare-goal gl-fase <= 2)
                        (game-time > 420)
                        (game-time < 430)
                        (or(up-resource-amount amount-food-total < 600) ; 750 is expected
                        (up-resource-amount amount-wood-total < 175)) ; 275 is expected
                        (or(unit-type-count villager-food < 13) ; 15 is expected
                        (unit-type-count villager-wood < 3)) ; 4 is expected
                        =>
                        (set-goal gl-fase 3)
                        (chat-to-all "Gamebreaking bug 7! Returning to old eco mode")
                        (disable-self)
                    )

                    ; fase 2 - greedy archer rush:
                    (defrule ; 9 min
                        (up-compare-goal gl-strategy == greedy-archer-rush)
                        (up-compare-goal gl-fase <= 2)
                        (game-time > 540)
                        (game-time < 550)
                        (or(up-resource-amount amount-food-total < 1025) ; 1425 is expected
                        (up-resource-amount amount-wood-total < 250)) ; 475 is expected
                        (or(unit-type-count villager-food < 8) ; 10 is expected
                        (unit-type-count villager-wood < 9)) ; 12 is expected
                        =>
                        (set-goal gl-fase 3)
                        (chat-to-all "Gamebreaking bug 9! Returning to old eco mode")
                        (disable-self)
                    )

                    (defrule ; 11 min
                    (up-compare-goal gl-strategy == greedy-archer-rush)
                        (up-compare-goal gl-fase <= 2)
                        (game-time > 660)
                        (game-time < 670)
                        (or(up-resource-amount amount-food-total < 1300) ; 1800 is expected
                        (or(up-resource-amount amount-wood-total < 600) ; 925 is expected
                        (up-resource-amount amount-gold-total < 5))) ; 75 is expected
                        =>
                        (set-goal gl-split-rule 14)
                    )

                    (defrule
                        (goal gl-split-rule 14)
                        (or(unit-type-count villager-food < 5) ; 7-10 is expected
                        (or(unit-type-count villager-wood < 9) ; 12-15 is expected
                        (unit-type-count villager-gold < 1))) ; 2 is expected
                        =>
                        (set-goal gl-split-rule 0)
                        (set-goal gl-fase 3)
                        (chat-to-all "Gamebreaking bug 11! Returning to old eco mode")
                        (disable-self)
                    )
                        
                    (defrule ; 13 min
                    (up-compare-goal gl-strategy == greedy-archer-rush)
                        (up-compare-goal gl-fase <= 2)
                        (game-time > 780)
                        (game-time < 790)
                        (or(up-resource-amount amount-food-total < 1600) ; 2150 is expected
                        (or(up-resource-amount amount-wood-total < 1000) ; 1450 is expected
                        (up-resource-amount amount-gold-total < 25))) ; 175 is expected
                        =>
                        (set-goal gl-split-rule 15)
                    )

                    (defrule
                    (goal gl-split-rule 15)
                        (or(unit-type-count villager-food < 8) ; 4-12 is expected
                        (or(unit-type-count villager-wood < 9) ; 12 is expected
                        (unit-type-count villager-gold < 2))) ; 3 is expected
                        =>
                        (set-goal gl-split-rule 0)
                        (set-goal gl-fase 3)
                        (chat-to-all "Gamebreaking bug 13! Returning to old eco mode")
                        (disable-self)
                    )

                    ; fase 2 - fc-two-tc-one-stable-knights:
                    (defrule ; 9 min - same as archer build
                        (up-compare-goal gl-strategy == fc-two-tc-one-stable-knights)
                        (up-compare-goal gl-fase <= 2)
                        (game-time > 540)
                        (game-time < 550)
                        (or(up-resource-amount amount-food-total < 1175) ; 1425 is expected
                        (up-resource-amount amount-wood-total < 300)) ; 475 is expected
                        (or(unit-type-count villager-food < 7) ; 9-12 is expected
                        (unit-type-count villager-wood < 5)) ; 9 is expected
                        =>
                        (set-goal gl-fase 3)
                        (chat-to-all "Gamebreaking bug 9! Returning to old eco mode")
                        (disable-self)
                    )

                    (defrule ; 11 min
                    (up-compare-goal gl-strategy == fc-two-tc-one-stable-knights)
                        (up-compare-goal gl-fase <= 2)
                        (game-time > 660)
                        (game-time < 670)
                        (or(up-resource-amount amount-food-total < 1700) ; 1950 is expected
                        (or(up-resource-amount amount-wood-total < 700) ; 900 is expected
                        (up-resource-amount amount-gold-total < 25))) ; 75 is expected
                        =>
                        (set-goal gl-split-rule 16)
                    )

                    (defrule
                    (goal gl-split-rule 16)
                        (or(unit-type-count villager-food < 10) ; 12-14 is expected
                        (or(unit-type-count villager-wood < 7) ; 9-11 is expected
                        (unit-type-count villager-gold < 1))) ; 2 is expected
                        =>
                        (set-goal gl-split-rule 0)
                        (set-goal gl-fase 3)
                        (chat-to-all "Gamebreaking bug 11! Returning to old eco mode")
                        (disable-self)
                    )

                    (defrule ; 13 min
                    (up-compare-goal gl-strategy == fc-two-tc-one-stable-knights)
                        (up-compare-goal gl-fase <= 2)
                        (game-time > 780)
                        (game-time < 790)
                        (or(up-resource-amount amount-food-total < 2200) ; 2500 is expected
                        (or(up-resource-amount amount-wood-total < 1000) ; 1250 is expected
                        (up-resource-amount amount-gold-total < 75))) ; 175 is expected
                        =>
                        (set-goal gl-split-rule 17)
                    )

                    (defrule
                    (goal gl-split-rule 17)
                        (or(unit-type-count villager-food < 7) ; 8-14 is expected
                        (or(unit-type-count villager-wood < 3) ; 5 is expected
                        (unit-type-count villager-gold < 1))) ; 2 is expected
                        =>
                        (set-goal gl-split-rule 0)
                        (set-goal gl-fase 3)
                        (chat-to-all "Gamebreaking bug 13! Returning to old eco mode")
                        (disable-self)
                    )

                    (defrule ; 16 min
                    (up-compare-goal gl-strategy == fc-two-tc-one-stable-knights)
                        (up-compare-goal gl-fase <= 2)
                        (game-time > 960)
                        (game-time < 970)
