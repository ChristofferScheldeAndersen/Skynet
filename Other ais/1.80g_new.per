                            ;(or(up-enemy-units-in-town > 0)
                            ;(up-compare-goal gl-temp24 > 0))) ;bliver de her 2 brugt til noget? måske trush
                            (up-timer-status group-retreat-timer == timer-running)
                            =>
                            (disable-timer group-retreat-timer)
                            ;(chat-to-all "stop retreating")
                            ;(chat-to-all "ranged army is close to wanted location. Disable retreat timer")
                        )

                        (defrule
                            (up-compare-goal gl-group-superiority < 0)
                            (up-compare-goal gl-local-total > 0)
                            (up-compare-goal gl-archer-micro-priority < 0)
                            (or(and(up-enemy-units-in-town == 0)
                            (and(up-compare-goal gl-temp24 == 0)
                            (up-point-distance gl-temp1-x gl-temp9-x > 400)))
                            (up-point-distance gl-temp2-x gl-temp9-x g:> gl-temp48)) ;1200 before
                            (up-timer-status group-retreat-timer != timer-running)
                            ;(up-point-distance gl-temp2-x gl-temp9-x <= 3500)
                            =>
                            (set-goal gl-split-rule 7)
                            (up-get-point-distance gl-temp1-x gl-temp9-x gl-temp)
                            (up-modify-goal gl-temp c:/ 250)
                            (up-set-timer c: group-retreat-timer g: gl-temp)
                            ;(up-chat-data-to-all "setting retreat-timer to %d seconds" g: gl-temp)
                        )

                        (defrule
                            (up-compare-goal gl-group-superiority < 0)
                            (up-compare-goal gl-local-total > 0)
                            (up-compare-goal gl-archer-micro-priority < 0)
                            (or(and(up-enemy-units-in-town == 0)
                            (and(up-compare-goal gl-temp24 == 0)
                            (up-point-distance gl-temp1-x gl-temp9-x > 400)))
                            (up-point-distance gl-temp2-x gl-temp9-x g:> gl-temp48)) ;1200 before
                            (up-timer-status group-retreat-timer != timer-running)
                            ;(up-point-distance gl-temp2-x gl-temp9-x > 3500)
                            (not(true))
                            =>
                            (set-goal gl-split-rule 7)
                            (up-get-point-distance gl-temp1-x gl-temp9-x gl-temp)
                            (up-modify-goal gl-temp c:/ 140)
                            (up-set-timer c: group-retreat-timer c: 10)
                            (chat-to-all "setting retreat-timer to flat 10 seconds")
                        )

                        (defrule
                        (up-compare-goal gl-group-superiority < 0)
                            (up-compare-goal gl-local-total > 0)
                            (up-compare-goal gl-archer-micro-priority < 0)
                            (or(and(up-enemy-units-in-town == 0)
                            (and(up-compare-goal gl-temp24 == 0)
                            (up-point-distance gl-temp1-x gl-temp9-x > 400)))
                            (up-point-distance gl-temp2-x gl-temp9-x g:> gl-temp48)) ;1200 before
                        (up-compare-goal gl-anti-trush != 1)
                        (up-timer-status group-retreat-timer == timer-running)
                        =>
