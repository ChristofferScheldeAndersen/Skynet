                                (not(and(up-research-status c: ri-ballistics < research-pending)
                                (and(food-amount > 600)
                                (gold-amount > 400))))

                                (not(and(or(up-compare-goal gl-saving-for-upgrade == saving-for-thumb-ring)
                                (up-compare-goal gl-saving-for-upgrade == saving-for-ballistics))
                                (and(wood-amount < 310)
                                (building-type-count-total farm >= 26))))
                                
                                
