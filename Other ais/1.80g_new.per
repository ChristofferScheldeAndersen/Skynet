                    (defrule
                        (up-compare-goal gl-second-unfinished-farm != -1)
                        =>
                        (up-modify-goal gl-unfinished-farms c:+ 1)
                    ) 

                    (defrule
                        (up-compare-goal gl-third-unfinished-farm != -1)
                        =>
                        (up-modify-goal gl-unfinished-farms c:+ 1)
                    ) 

                    (defrule
                        (up-compare-goal gl-forth-unfinished-farm != -1)
                        =>
                        (up-modify-goal gl-unfinished-farms c:+ 1)
                    ) 

                    (defrule
                        (up-compare-goal gl-fifth-unfinished-farm != -1)
                        =>
                        (up-modify-goal gl-unfinished-farms c:+ 1)
                    ) 
                
            ; Calculating number available villagers for farming
                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != pre-farming-straggler-group)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-stragglers-and-farmers g:= gl-local-total)
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-group-flag != farming-group)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-stragglers-and-farmers g:+ gl-local-total)
                    )
            ; Chosing to build the farm
                ;setup
                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: mill c: 1)
                        (set-goal gl-temp 0)
                    )

                    (defrule
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-data object-data-progress-value gl-temp)
                    )

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: town-center c: 1)
                        (set-goal gl-temp1 0)
                    )

                    (defrule
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-data object-data-progress-value gl-temp1)
                        (set-goal gl-temp2 160)
                        (up-modify-goal gl-temp2 g:* gl-temp1)
                        (up-modify-goal gl-temp2 c:/ 100) ;gl-temp2 is nr of seconds researching castle age
                        (set-goal gl-temp1 160)
                        (up-modify-goal gl-temp1 g:- gl-temp2) ;gl-temp1 is now nr of seconds til castle age
                        ;(up-chat-data-to-all "there are %d seconds to castle age" g: gl-temp1)
                        (up-modify-goal gl-temp1 c:* 13) ;11-15 vills on wood - now gl-temp2 is vill seconds
                        (up-modify-goal gl-temp1 c:* 43) ;0,39-0,47 gather rate dep on upgrade but also walking
                        (up-modify-goal gl-temp1 c:/ 100) ;percentage in the above line
                        ;gl-temp1 is now the expected wood to be collected before castle age.
                        ;(up-chat-data-to-all "expected to collect %d wood before castle age" g: gl-temp1)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp7 0)
                    )

                    (defrule
                        (true)
                        =>
                        (up-get-fact resource-amount amount-wood gl-temp2)
                        (set-goal gl-loop-counter 0)
                        (up-full-reset-search)
                        (up-find-local c: villager-class c: 200)
                        (up-remove-objects search-local object-data-resource == food)
                        (up-remove-objects search-local object-data-resource == stone)
                        (up-remove-objects search-local object-data-resource == gold)
                        (up-remove-objects search-local object-data-carry <= 0)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-object-data object-data-carry gl-villager-food)
                        (up-modify-goal gl-temp7 g:+ gl-villager-food)
                        (up-remove-objects search-local object-data-index == 0)
                        (up-get-search-state gl-local-total)
                    )

                    (defrule
                        (up-compare-goal gl-local-total > 0)
                        (up-compare-goal gl-loop-counter < 50)
                        =>
                        (up-modify-goal gl-loop-counter c:+ 1)
                        (up-jump-rule -2)
                    )

                    (defrule
                        (true)
                        =>
                        (up-modify-goal gl-temp2 g:+ gl-temp7)
                        ;(up-chat-data-to-all "current wood-amount including carried is %d" g: gl-temp2)
                        
                    )

                    (defrule
                        (research-available ri-double-bit-axe)
                        =>
                        (up-modify-goal gl-temp2 c:- 50)
                    )

                    (defrule
                        (research-available ri-horse-collar)
                        =>
                        (up-modify-goal gl-temp2 c:- 75)
                    )

                    (defrule
                        (true)
                        =>
                        (up-modify-goal gl-temp2 g:+ gl-temp1)
                        ;(up-chat-data-to-all "expected wood amount in castle age is %d" g: gl-temp2)
                    )

                ;building rules
                    #load-if-not-defined DE-AVAILABLE
                    (defrule
                        (building-type-count-total stable > 0)
                        (building-type-count-total blacksmith > 0)
                        (or(up-compare-goal gl-temp > 30)
                        (or(research-completed ri-horse-collar)
                        (and(up-compare-goal gl-temp2 > 900)
                        (wood-amount >= 80))))
                        ;(or(research-completed ri-double-bit-axe)
                        ;(up-research-status c: ri-double-bit-axe == research-pending));food er problemet, ikke wood
                        (up-compare-goal gl-unfinished-farms < 5)
                        (building-type-count-total farm g:< gl-stragglers-and-farmers)
                        (up-compare-goal gl-temp2 > 430)
                        =>
                        (set-goal gl-split-rule 626)
                    )
                    #end-if

                    #load-if-defined DE-AVAILABLE
                    (defrule
                        (building-type-count-total stable > 0)
                        (building-type-count-total blacksmith > 0)
                        (or(up-compare-goal gl-temp > 30)
                        (or(research-completed ri-horse-collar)
                        (and(up-compare-goal gl-temp2 > 900)
                        (wood-amount >= 200))))
                        ;(or(research-completed ri-double-bit-axe)
                        ;(up-research-status c: ri-double-bit-axe == research-pending));food er problemet, ikke wood
                        (up-compare-goal gl-unfinished-farms < 5)
                        (building-type-count-total farm g:< gl-stragglers-and-farmers)
                        (up-compare-goal gl-temp2 > 550)
                        =>
                        (set-goal gl-split-rule 626)
                    )
                    #end-if

                    (defrule
                        (building-type-count mill > 0)
                        (or(and(up-compare-goal gl-wood-saved >= 560) ;500+60 for en farm 
                        (research-completed ri-horse-collar))
                        (and(or(building-type-count-total farm < 4)
                        (and(goal gl-need-more-farms-for-castle-age YES)
                        (building-type-count-total farm < 6)))
                        (building-type-count-total mining-camp > 0)))
                        (up-compare-goal gl-unfinished-farms < 5)
                        (building-type-count-total farm g:< gl-stragglers-and-farmers)
                        (building-type-count-total farm < 6)
                        =>
                        (set-goal gl-split-rule 626)
                    )

                    (defrule
                        (goal gl-split-rule 626)
                        (goal gl-farm-was-placed-this-pass -1) ; så der ikke bygges en farm for meget 
                        (up-compare-goal gl-building-system == build-line-system)
                        =>
                        (set-goal gl-build-farm YES)
                        (set-goal gl-farm-check 1) 
                        (up-modify-goal gl-danger-counter c:= 0)
                    )
                        
               

        ;F Gold 
            ;force gold miners to gold 
                (defrule
                    (building-type-count mining-camp > 0)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != gold-mining-group)
                    (up-remove-objects search-local object-data-target == 932) ;gold mine
                    (up-remove-objects search-local object-data-target == building-class)
                    (up-remove-objects search-local object-data-carry == 0)
                )

                (defrule
                    (building-type-count mining-camp > 0)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-target-point gl-temp1-x action-stop -1 -1)
                )
        ;G Eco upgrades
            (defrule
                (up-compare-goal gl-age-status >= advancing-to-castle)
                =>
                (research ri-horse-collar)
            )

            (defrule
                (up-compare-goal gl-age-status >= advancing-to-castle)
            (not(research-available castle-age))
            (not(research-available ri-horse-collar))
                =>
                (research ri-double-bit-axe)
            )
        ;H Military production
            (defrule
                (true)
                (game-time > 5) =>
                (up-full-reset-search)
                (up-get-point position-self gl-temp-x)
                (up-set-target-point gl-temp-x)
                (up-filter-distance c: -1 c: 27)
                (set-strategic-number sn-focus-player-number 1)
                (set-goal gl-remote-total 0)
            )

            (defrule
                (up-find-remote c: scout-cavalry-line c: 10)
                (players-stance focus-player enemy)
                (game-time > 5) =>
                (up-get-search-state gl-local-total)
                )

            (defrule
                (up-compare-sn sn-focus-player-number < 8)
                (up-compare-goal gl-remote-total < 2)
                (game-time > 5) =>
                (up-modify-sn sn-focus-player-number c:+ 1)
                (up-jump-rule -2)
            )

            (defrule
                (up-compare-goal gl-remote-total > 2)
                (unit-type-count-total spearman-line < 1)
                (current-age < castle-age)
                (game-time > 5) =>
                (train spearman-line)
                )

            (defrule
                (up-compare-goal gl-remote-total > 3)
                (unit-type-count-total spearman-line < 2)
            (current-age < castle-age)
                (game-time > 5) =>
                (train spearman-line)
            )

            (defrule
                (true)
                =>
                (set-goal gl-temp -1)
                (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                (up-get-focus-fact allied-sn sn-target-player-is-going-scouts gl-temp)
            )

            (defrule
                (up-compare-goal gl-temp > 0)
                (unit-type-count-total spearman-line < 2)
            (current-age < castle-age)
                (game-time > 5) =>
                (train spearman-line)
            )

        ; Skipping other strategies and fase 3
            (defrule
            (up-compare-goal gl-strategy == fc-two-tc-one-stable-knights)
            (up-compare-goal gl-end-of-script-rule != -1)
            =>
            (up-jump-direct g: gl-end-of-script-rule)
            )
        ;
    ;3 Balanced archer-skirm rush
        ; Directing the script to this strategy (safe)
            (defrule
            (up-compare-goal gl-strategy == balanced-archer-skirm-rush)
            =>
            (up-get-rule-id gl-chosen-strategy-first-rule)
            )    
        ;

        ;L Changing to full skirm mode
            

            ;(defrule
            ;    (true)
            ;    =>
            ;    (set-strategic-number sn-target-player-number 2)
            ;)

            ;#load-if-not-defined UP-3-PLAYER-TEAM
            ;#load-if-not-defined UP-4-PLAYER-TEAM
            (defrule
                (or(players-unit-type-count target-player archer-line > 0) ;target-player
                (or(players-unit-type-count target-player skirmisher-line > 0)
                (players-building-type-count target-player archery-range > 0)))
                (up-research-status c: feudal-age >= research-pending)
                (building-type-count-total farm < 10)
                
                (players-building-type-count target-player stable == 0)
                (players-building-type-count target-player barracks <= 1)
                (players-unit-type-count target-player scout-cavalry-line < 2)
                ;(up-timer-status scouting-enemy-base-timer == timer-triggered);
                (or(goal gl-my-position 5)
                (and(goal gl-my-position 3)
                (and(up-players-in-game enemy == 3)
                (up-compare-sn sn-lone-flank == 1))))

                =>
                (set-goal gl-full-skirm-mode 1)
            )

            (defrule
                (goal gl-full-skirm-mode 1)
                (building-type-count-total farm < 6)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                (up-remove-objects search-local object-data-target != 932) ;gold mine
                (up-remove-objects search-local object-data-group-flag == 5) ;gold mine
                (up-target-point gl-temp-x action-stop -1 -1)
                ;(disable-self)
            )

            (defrule
                (goal gl-full-skirm-mode 1)
                (building-type-count-total farm < 6)
                (up-set-target-object search-local c: 0)
                =>
                (up-target-point gl-temp-x action-stop -1 -1)
                ;(disable-self)
            )
