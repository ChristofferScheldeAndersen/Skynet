                    ;(up-chat-data-to-all "checked unit score is %d" g: gl-temp8)
                )

                (defrule
                    (up-compare-goal gl-temp9 g:< gl-temp8) ;checked units has highest score found
                    (up-set-target-object search-remote g: gl-temp2)
                    (up-set-target-by-id g: gl-scout-unit)
                    =>
                    (up-modify-goal gl-temp9 g:= gl-temp8) ;gl-temp9 is highest score found
                    (up-modify-goal gl-temp10 g:= gl-temp6) ;gl-temp10 is id of unit found with highest score
                    (up-modify-goal gl-temp14 g:= gl-temp2) ;gl-temp14 is the index nr of highest score unit
                )

                ;loopet genstartes først med et index skift for remote unit
                
                (defrule
