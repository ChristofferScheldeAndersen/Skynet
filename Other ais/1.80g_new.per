                ;;(up-chat-data-to-player my-player-number "Rehoboam has %d. pop. Adding vill to first-tree-group" g: gl-temp)
                (set-goal gl-ungrouped-vill -1)
                (disable-self)
                )
            ; 27 vills - 4 shepards 6 wood1 5 berry 3 deer 3 miners 6 wood2   +1 wood1
                (defrule
                (goal gl-ungrouped-vill 1)
                =>
                (up-full-reset-search)
                (up-find-local c: villager-class c: 200)
                            
                ;fase 1
                (up-remove-objects search-local object-data-group-flag == shepard-group) ;1
                ;(up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
                (up-remove-objects search-local object-data-group-flag == berry-group) ;3
                (up-remove-objects search-local object-data-group-flag == deer-group) ;4
                (up-remove-objects search-local object-data-group-flag == gold-mining-group) ;5
                            
                ;fase 2
                (up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
                (up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
                (up-remove-objects search-local object-data-group-flag == farming-group) ;8

                (up-reset-group c: first-tree-group)            
                (up-modify-group-flag 0 c: first-tree-group)
                (up-create-group 0 0 c: first-tree-group)
                (up-modify-group-flag 1 c: first-tree-group)
                ;;(up-chat-data-to-player my-player-number "Rehoboam has %d. pop. Adding vill to first-tree-group" g: gl-temp)
                (set-goal gl-ungrouped-vill -1)
                (disable-self)
                )
            ; 22-27 vills - Converting deer group when deers are gone         :3 deer -> shepard conversions
                (defrule
                    (taunt-detected my-player-number 6)
                    =>
                    (up-chat-data-to-all "gl-deer-luring-stage is %d." g: gl-deer-luring-stage)
                    (up-chat-data-to-all "gl-deer-eating-stage is %d." g: gl-deer-eating-stage)
                    (acknowledge-taunt my-player-number 6)
                )
                
                (defrule 
                    (or(goal gl-deer-eating-stage No-more-deer)
                    (goal gl-deer-eating-stage No-more-deer-to-eat))
                    ;(goal gl-eating-deer -1) ; no more deer betyder bare der ikke er noget at spise
                    ; mangler et tjek af at alle deer er endegyldigt væk.
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    
                    ;fase 1
                    ;(up-remove-objects search-local object-data-group-flag == shepard-group) ;1
                    (up-remove-objects search-local object-data-group-flag == first-tree-group) ;2
                    (up-remove-objects search-local object-data-group-flag == berry-group) ;3
                    ;(up-remove-objects search-local object-data-group-flag == deer-group) ;4
                    (up-remove-objects search-local object-data-group-flag == gold-mining-group) ;5
                                
                    ;fase 2
                    (up-remove-objects search-local object-data-group-flag == second-tree-group) ;6
                    (up-remove-objects search-local object-data-group-flag == pre-farming-straggler-group) ;7
                    (up-remove-objects search-local object-data-group-flag == farming-group) ;8

                    (up-reset-group c: shepard-group)
                    (up-modify-group-flag 0 c: shepard-group)
                    (up-create-group 0 0 c: shepard-group)
                    (up-modify-group-flag 1 c: shepard-group)
                    ;;(up-chat-data-to-player my-player-number "Rehoboam has %d. pop. and deer are gone. Converting 3 deer vills to shepard-group" g: gl-temp)
                    (disable-self)
                )
            ;
            ; Feudal age
            ;
            ; 27-max vills - Converting shepards when sheep are gone          :all shepards -> feudal-stragglers

                (defrule
                    (goal gl-no-more-sheep YES)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != shepard-group)
                    (up-remove-objects search-local object-data-type == 212) ;dont convert builders
                    (up-remove-objects search-local object-data-type == 118)
                    (up-reset-group c: pre-farming-straggler-group)            
                    (up-modify-group-flag 0 c: pre-farming-straggler-group)
                    (up-create-group 0 0 c: pre-farming-straggler-group)
                    (up-modify-group-flag 1 c: pre-farming-straggler-group)
                    ;(chat-to-all "test 1")
                    )

                (defrule
                    (goal gl-need-more-farms-for-castle-age YES)
                    (building-type-count-total farm == 5)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != shepard-group)
                    (up-remove-objects search-local object-data-type == 212) ;dont convert builders
                    (up-remove-objects search-local object-data-type == 118)
                    )

                (defrule
                    (goal gl-need-more-farms-for-castle-age YES)
                    (building-type-count-total farm == 5)
                    (or(up-set-target-object search-local c: 1)
                    (and(up-set-target-object search-local c: 0)
                    (goal gl-no-more-sheep YES)))
                    =>
                    (up-reset-group c: pre-farming-straggler-group)            
                    (up-modify-group-flag 0 c: pre-farming-straggler-group)
                    (up-create-group 0 0 c: pre-farming-straggler-group)
                    (up-modify-group-flag 1 c: pre-farming-straggler-group)
                    ;(chat-to-all "test 2")
                    (disable-self)
                    )

                    (defrule
                    (goal gl-no-more-sheep YES)
                    (building-type-count blacksmith > 0) ; if blacksmith is complete no more builders are needed
                    =>
                    (up-full-reset-search)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != shepard-group)
                    (up-reset-group c: pre-farming-straggler-group)            
                    (up-modify-group-flag 0 c: pre-farming-straggler-group)
                    (up-create-group 0 0 c: pre-farming-straggler-group)
                    (up-modify-group-flag 1 c: pre-farming-straggler-group)
                    ;(chat-to-all "test 3")
                    )
                
            ; 27-max vills - Converting stragglers to farmers                 :X feudal-stragglers -> farmers

                ; Setting gl-X-assigned-farming-vill and including it in Farming-group
        
                ;Hvis et farm goal er != -1 mens det's villager goal er -1 findes den nærmeste straggler
                ;vill og sættes ind i det tilsvarende villager goal

                (defrule
                    (up-set-target-by-id g: gl-first-unfinished-farm) ; svt != -1
                    (up-compare-goal gl-first-assigned-farming-vill == -1)
                    =>
                    (up-full-reset-search) 
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != pre-farming-straggler-group)
                    (up-clean-search search-local object-data-distance search-order-asc)
                )

                (defrule
                    (up-compare-goal gl-first-unfinished-farm != -1)
                    (up-compare-goal gl-first-assigned-farming-vill == -1)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-object-data object-data-id gl-first-assigned-farming-vill)
                    (up-full-reset-search) 
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != farming-group)
                    (up-add-object-by-id search-local g: gl-first-assigned-farming-vill)
                    (up-reset-group c: farming-group)
                    (up-modify-group-flag 0 c: farming-group)
                    (up-create-group 0 0 c: farming-group)
                    (up-modify-group-flag 1 c: farming-group)
                    ;;(chat-to-player my-player-number "Adding first-assigned-farming-vill to farming-group")
                ) 

                (defrule
                    (up-set-target-by-id g: gl-second-unfinished-farm) ; svt != -1
                    (up-compare-goal gl-second-assigned-farming-vill == -1)
