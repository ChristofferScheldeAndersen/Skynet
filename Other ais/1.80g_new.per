                (set-goal gl-split-rule 183))

                (defrule
                (goal gl-split-rule 183)
        =>                  (up-modify-escrow wood c:= 9999)
                    (up-modify-escrow stone c:= 9999)
                    (set-escrow-percentage wood 100)
                    (set-escrow-percentage stone 100)
                    (up-get-point position-self gl-temp-x)
                    (up-copy-point gl-safe-tc-spot-x gl-position-mypocket-x)
                    (up-lerp-tiles gl-safe-tc-spot-x gl-temp-x c: -15)
                    (up-full-reset-search)
                    (up-reset-search 1 1 1 1)
                    (up-find-local c: villager-class c: 30)
                    (up-target-point gl-safe-tc-spot-x action-move -1 -1)
                    (delete-building town-center)
                    (delete-building town-center)
                    (delete-building town-center)
                    (set-goal gl-need-sling-to-reboom 1)
                )



                (defrule
                        (or(building-type-count town-center == 0)
                    (or(and(current-age == imperial-age)
                        (unit-type-count villager < 30))
                (and(current-age == castle-age)
                        (unit-type-count villager < 20))))
                            (game-time > 5)
                 =>
                    (set-goal gl-split-rule 184))

                (defrule
                    (goal gl-split-rule 184)
                 =>
                    (release-escrow wood)
