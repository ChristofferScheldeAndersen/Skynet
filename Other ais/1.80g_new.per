                    (up-research-status c: imperial-age >= research-pending)
                    (up-compare-goal gl-saving-for-upgrade != saving-for-heresy)
                    (up-compare-goal gl-saving-for-upgrade != saving-for-devotion)
                    (up-compare-goal gl-saving-for-upgrade != saving-for-faith)
                    =>
