                    ;(up-chat-data-to-all "gl-remote-total after is %d" g: gl-remote-total)
                    (do-nothing)
                    )

                    
                    
                    (defrule
                    (goal gl-build-lc YES)
                    (up-compare-goal gl-remote-total g:> gl-best-found-lc-score)
                    (up-compare-goal gl-new-danger-counter < 20)
                        =>
                    ;(up-chat-data-to-all "lumber camp score is %d." g: gl-remote-total)
                    ;(up-chat-data-to-all "lumber-camp distance to point behind tc is %d." g: gl-lumber-camp-distance)
                    ;(up-chat-data-to-all "number of extra trees around lumber camp is %d." g: gl-temp31)
                    ;(up-chat-data-to-all "number of trees close trees around lumber camp is %d." g: gl-temp50)
                    (up-modify-goal gl-best-found-lc-score g:= gl-remote-total)
                    (up-copy-point gl-best-lumber-camp-spot-x gl-lumber-camp-testing-spot-x)
                    )
                    #end-if
                
                ; 2l Hvis der ikke er tjekket 5 træer eller alle fundne træer ikke er tjekket genstartes det store loop.

                    (defrule
                        (goal gl-build-lc YES)
                        =>
                        (up-modify-goal gl-new-danger-counter c:+ 1)
                    )

                    (defrule
                            (goal gl-build-lc YES)
                            (up-compare-goal gl-new-danger-counter < 20)
                            (up-compare-goal gl-lumber-camp-location-x == -1)
                            ;(up-compare-goal gl-checked-trees < 10)
                            =>
                            ;;;(up-chat-data-to-all "Number of building checks were %d." g: gl-danger-counter)
                            ;;;(up-chat-data-to-all "times big loop has run is %d." g: gl-new-danger-counter)
                            (up-jump-rule -92) ; 49?
                        )

                ; 2m Ellers bygges lumbercampen i det bedst fundne punkt.

                    

                    (defrule
                        (up-compare-goal gl-new-danger-counter >= 20)
                        (goal gl-build-lc YES)
                        (up-compare-goal gl-best-found-lc-score > -100)
                            =>
                        (up-copy-point gl-lumber-camp-location-x gl-best-lumber-camp-spot-x)
                        ;(up-chat-data-to-all "best lumber camp score is %d." g: gl-best-found-lc-score)
                        ;;;(up-chat-data-to-all "times big loop has run is %d. and a spot is chosen" g: gl-new-danger-counter)
                        ;(disable-self)
                    )

                ; 2n Place down first 2 lumber camps
                    ; when a lumbercamp can be build and you have at least 125 wood use up-build-line to build the lumbercamp at the point

                    (defrule
                        (building-type-count-total lumber-camp == 0)
                        (up-compare-goal gl-lumber-camp-location-x != -1)
                        (goal gl-build-lc YES)
                        =>
                        (up-build-line gl-lumber-camp-location-x gl-lumber-camp-location-x c: lumber-camp)
                        ;(chat-to-all "Attempting to place first DUC lumber-camp")
                        (up-copy-point gl-first-lumber-camp-location-x gl-lumber-camp-location-x)
                        ;(up-send-flare gl-lumber-camp-location-x)
                        (up-modify-goal gl-lumber-camp-location-x c:= -1)
                        (set-goal gl-build-lc NO)
                    )

                    (defrule
                        (up-compare-goal gl-lumber-camp-location-x != -1)
                        (building-type-count-total lumber-camp == 1)
                        (building-type-count lumber-camp == 1)
                        (goal gl-build-lc YES)
                        (can-afford-building lumber-camp)
                        =>
                        (up-build-line gl-lumber-camp-location-x gl-lumber-camp-location-x c: lumber-camp)
                        ;(chat-to-all "Attempting to place second DUC lumber-camp")
                        ;(up-send-flare gl-lumber-camp-location-x)
                        (up-copy-point gl-second-lumber-camp-location-x gl-lumber-camp-location-x)
                        (up-modify-goal gl-lumber-camp-location-x c:= -1)
                        ;(chat-to-all "placing down second lc")
                        (set-goal gl-build-lc NO)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-build-lc NO)
                    )

                    (defrule
                        (taunt-detected my-player-number 134)
                        =>
                        (up-build-line gl-second-lumber-camp-location-x gl-second-lumber-camp-location-x c: lumber-camp)
                    )

                    (defrule
                        (taunt-detected my-player-number 135)
                        =>
                        (up-build-line gl-second-lumber-camp-location-x gl-second-lumber-camp-location-x c: palisade-wall)
                    )
                   
        ;Mill
            ; Find up to 20 forrage bushes and save them into temp goals (10-29):
                
                    
