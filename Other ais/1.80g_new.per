                    (up-gather-inside c: town-center c: -1)
                    (up-target-objects 0 action-garrison -1 -1)
                    ;(chat-to-all "garrison weak non-luring vill 2")
                )





                (defrule
                    (or(goal BOAR-STATUS Send-vill-to-tc)
