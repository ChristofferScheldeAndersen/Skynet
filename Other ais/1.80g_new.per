           (defrule
               (taunt-detected my-player-number 160)
               =>
               (up-full-reset-search)
               (up-find-local c: villager-class c: 200)
               (up-remove-objects search-local object-data-type != 214)
               (up-get-search-state gl-local-total)
               (up-modify-goal gl-temp g:= gl-local-total)
               (up-full-reset-search)
               (up-find-local c: villager-class c: 200)
               (up-remove-objects search-local object-data-type != 259)
               (up-get-search-state gl-local-total)
               (up-modify-goal gl-temp g:+ gl-local-total)
               
           )

           (defrule
               (taunt-detected my-player-number 160)
               =>
               (up-full-reset-search)
               (up-get-fact building-type-count farm gl-temp1)
               (up-get-fact idle-farm-count 0 gl-temp2)
               (up-chat-data-to-all "number of farmers is %d" g: gl-temp)
               (up-chat-data-to-all "number of finished farms is %d" g: gl-temp1)
               (up-chat-data-to-all "idle farm count is %d" g: gl-temp2)
               (acknowledge-taunt my-player-number 160)
           )
           
           
           
           
           
