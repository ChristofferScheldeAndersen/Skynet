                        (up-chat-data-to-all "knight group is %d percent stronger than enemy army" g: gl-local-total)
                        (up-chat-data-to-all "gl-knight-group-superiority-mode is %d" g: gl-knight-group-superiority-mode)
                        (up-chat-data-to-all "gl-ranged-group-safety is %d - -1 unsafe, 1 safe " g: gl-temp)
                        (up-chat-data-to-all "gl-melee-army-mode is %d - 1 follow, 2 snipe, 3 kill" g: gl-melee-army-mode)
                        (acknowledge-taunt my-player-number 88)
                        (acknowledge-taunt every-ally 88)
