                        (goal gl-temp48 -1)
                        =>
                        (up-modify-goal gl-temp34 g:= gl-temp17)
                        (up-modify-goal gl-temp48 c:+ 1)
                    )

                    (defrule
                    (taunt-detected my-player-number 7)
                    =>
                    ;(up-chat-data-to-all "First flank is: %d" g: gl-temp33)
                    ;(up-chat-data-to-all "Its value is: %d" g: gl-temp31)
                    ;(up-chat-data-to-all "Second flank is: %d" g: gl-temp34)
                    ;(up-chat-data-to-all "Its value is: %d" g: gl-temp32)
                    (do-nothing)
                    )
                ;Sæt gl-my-position
                    (defrule
                        (current-age == dark-age)
                        =>
                        (set-goal gl-my-position pocket)
                    )

                    (defrule
                        (current-age == dark-age)
                        (or(up-compare-goal gl-temp33 == my-player-number)
                        (up-compare-goal gl-temp34 == my-player-number))
                        =>
                        (set-goal gl-my-position flank)
                        ;(up-chat-data-to-all "gl-temp33 is %d." g: gl-temp33)
                        ;(up-chat-data-to-all "gl-temp34 is %d." g: gl-temp34)
                    )

                ;Find closest ally som flank
                

                    ;find alle team tc's der ikke er eget af flank player numbers. 
                    
                    (defrule
                        (goal gl-my-position flank)
                        =>
