    ; Scouting
            ;******************************************************************************
            ;
            ; Scouting setup
            ;
            ;******************************************************************************

            #load-if-not-defined MAYAN-CIV

            (defconst scout-unit scout-cavalry-line)

            #end-if

            #load-if-defined MAYAN-CIV

            (defconst scout-unit eagle-warrior-line)

            #end-if

            (defrule
                (game-time < 1800)
                (game-time > 5)
                (game-time > 5) =>
                (up-set-attack-stance scout-cavalry-line c: stance-no-attack)
                (up-set-attack-stance eagle-warrior-line c: stance-no-attack)
                (set-strategic-number sn-home-exploration-time 600)
                (disable-self)
            )

            (defrule
                (unit-type-count-total scout-cavalry-line == 0)
                (unit-type-count-total eagle-warrior-line == 0)
                (game-time > 300)
                (game-time > 5)
                (game-time > 5) =>
                (set-strategic-number sn-total-number-explorers 0)
            (set-strategic-number sn-number-explore-groups 0)
            )
            
            (defrule
                (or(unit-type-count-total scout-cavalry-line > 0)
                (unit-type-count-total eagle-warrior-line > 0))
                (game-time < 2100)
                (game-time > 5)
                (game-time > 5) =>
                (set-strategic-number sn-total-number-explorers 1)
            (set-strategic-number sn-number-explore-groups 1)
            )

            (defrule
                (game-time > 1800)
                (game-time > 5)
                (game-time > 5) =>
                    (up-set-attack-stance scout-cavalry-line c: stance-aggressive)
                    (up-set-attack-stance eagle-warrior-line c: stance-aggressive)
            )


            ;******************************************************************************
            ;
            ; Calculating spiral scouting zones
            ;
            ;******************************************************************************

            
            ;(defconst gl-mapsize-temp-x 139)
            ; (up-modify-goal G-mapsize g:= P-x)

            (defrule
                (game-time > 5)
                (game-time > 5) =>
                (up-get-point position-self gl-point-tc-x)
            (up-get-point position-map-size gl-full-map-size-x)
            ; lets say ur tc coords are 105, 40
            (up-modify-goal gl-temp1 g:= gl-full-map-size-x); 120   120
            (up-modify-goal gl-temp2 g:= gl-full-map-size-x); 120   120
            (up-modify-goal gl-temp1 g:- gl-point-tc-x); 120 - 105 = 15
            (up-modify-goal gl-temp2 g:- gl-point-tc-y); 120 - 40 = 80
            (up-modify-goal gl-temp1 g:min gl-temp2); 15 < 80
            (up-modify-goal gl-temp1 g:min gl-point-tc-x); 15 < 105
            (up-modify-goal gl-temp1 g:min gl-point-tc-y); 15 < 40
            ; so now u know ur tc is 15 tiles from the edge
            (up-modify-goal gl-edge-distanse g:= gl-temp1)
                (disable-self)
            )

            (defrule
                (game-time > 5)
                (game-time > 5) =>
                ;(up-get-point position-self gl-point-tc-x)
            ;(up-get-point position-border gl-point-border-x)
            ;(up-get-point-distance gl-point-tc-x gl-point-border-x gl-edge-distanse)
            ;;;(up-chat-data-to-all "Distance to egde from tc is %d." g: gl-edge-distanse)
            (up-modify-goal gl-first-scouting-spiral-radius c:= 12)
            (up-modify-goal gl-second-scouting-spiral-radius c:= 20)
            (up-modify-goal gl-third-scouting-spiral-radius c:= 27)
            (disable-self)
            )

            (defrule
            (up-compare-goal gl-edge-distanse <= 15)
            (game-time > 5)
                (game-time > 5) =>
                (up-modify-goal gl-first-scouting-spiral-radius g:= gl-edge-distanse)
                (up-modify-goal gl-first-scouting-spiral-radius c:- 1)
                (disable-self)
            )

            (defrule
            (up-compare-goal gl-edge-distanse <= 20)
            (up-compare-goal gl-edge-distanse > 15)
            (game-time > 5)
                (game-time > 5) =>
                (up-modify-goal gl-second-scouting-spiral-radius g:= gl-edge-distanse)
                (up-modify-goal gl-second-scouting-spiral-radius c:- 1)
                (up-modify-goal gl-first-scouting-spiral-radius c:= 15)
                (disable-self)
            )

            (defrule
                (up-compare-goal gl-edge-distanse <= 27)
                (game-time > 5)
                (game-time > 5) =>
                (up-modify-goal gl-third-scouting-spiral-radius g:= gl-edge-distanse)
                (up-modify-goal gl-third-scouting-spiral-radius c:- 1)
                (disable-self)
            )

            (defrule
                (up-compare-goal gl-edge-distanse > 23)
                (game-time > 5)
                (game-time > 5) =>
                ;-chat-to-all "First scouting radius is 12")
                ;;;(up-chat-data-to-all "Second scouting radius is %d." g: gl-second-scouting-spiral-radius)
                ;;;(up-chat-data-to-all "Third scouting radius is %d." g: gl-third-scouting-spiral-radius)
                (disable-self)
            )

            (defrule
                (up-compare-goal gl-edge-distanse <= 23)
                (up-compare-goal gl-edge-distanse > 20)
                (game-time > 5)
                    (game-time > 5) =>
                ;-chat-to-all "First scouting radius is 12")
                ;;;(up-chat-data-to-all "Second scouting radius is %d." g: gl-second-scouting-spiral-radius)
                ;-chat-to-all "Third scouting radius is disabled")
                (disable-self)
            )

            (defrule
                
                (up-compare-goal gl-edge-distanse <= 20)
                (game-time > 5)
                    (game-time > 5) =>
                    ;;;(up-chat-data-to-all "First scouting radius is %d." g: gl-first-scouting-spiral-radius)
                ;-chat-to-all "Second scouting radius is disabled.")
                ;-chat-to-all "Third scouting radius is disabled")
                (disable-self)
            )

            (defrule
                (game-time == 58)
                (up-compare-goal gl-edge-distanse > 20)
                (game-time > 5)
                (game-time > 5) =>
                ;-chat-to-all "Starting second spiral scouting fase")
                (disable-self)
            )

            (defrule
                (game-time == 204)
                (up-compare-goal gl-edge-distanse > 23)
                (game-time > 5)
                (game-time > 5) =>
                ;-chat-to-all "Starting third spiral scouting fase")
                (disable-self)
            )

            (defrule
                (or(game-time == 330)
                (or(and(game-time == 204)
                (and(up-compare-goal gl-edge-distanse <= 23)
                (up-compare-goal gl-edge-distanse > 20)))
                (and(game-time == 70)
                (up-compare-goal gl-edge-distanse <= 20))))
                (game-time > 5)
                (game-time > 5) =>
                ;-chat-to-all "stop spiral scouting")
                (disable-self)
            )

            ; First spiral: 12 radius for 45 seconds
            ; Second spiral: 20 radius for 3 minutes or distance to egde minus 1.
            ; third spiral: distans to egde minus 1 unless less than 20 or all food found. - 3 min


            ;******************************************************************************
            ;
            ; Scouting first sheep
            ;
            ;******************************************************************************

            ; Ideer til userpatch featues. Den f�rste er en videre udvikling af themax scouting cirkel og den n�ste er en regel til at bygge f�rste house og denne virker.




            ;(defconst gl-temp-x 200)
            ;(defconst gl-self-y 201)
            ;(defconst gl-misc-x 202)
            ;(defconst gl-misc-y 203)
            ;(defconst gl-temp 204)
            ;(defconst gl-temp10 205)

            (defrule
                (game-time > 5)
                (game-time > 5) =>
                (set-goal gl-temp 0)
                (disable-self)
            )

            ; preventing scout from suiciding by attacking



            ; finding first sheep

            (defrule
                (current-age < feudal-age)
                (game-time > 5)
            (game-time > 5) =>
                (up-modify-goal gl-temp10 s:= sn-focus-player-number)
                (set-strategic-number sn-focus-player-number 0)
                (up-reset-search 1 1 1 1)
                (up-reset-filters)
            )

            (defrule
                (game-time > 0)
                (game-time < 660)
                (not(up-find-remote c: livestock-class c: 1))
                (game-time > 5)
                (game-time > 5) =>
                (set-goal gl-temp 0)
            )

            (defrule
                (game-time > 0)
                (game-time < 660)
                (up-find-remote c: livestock-class c: 1)
                (game-time > 5)
            (game-time > 5) =>
                (up-reset-search 1 1 1 1)
                (up-reset-filters)
                (up-find-local c: scout-cavalry-line c: 1)
                (up-find-local c: eagle-warrior-line c: 1)
                (up-find-remote c: livestock-class c: 1)
                (up-target-objects 0 action-move -1 -1)
                (set-goal gl-temp livestock-class)
                (up-modify-sn sn-focus-player-number g:= gl-temp10)
                (up-reset-search 1 1 1 1)
                (up-reset-filters)
                (enable-timer 5 1)
            )

            (defrule
                (goal gl-temp livestock-class)
                (timer-triggered 5)
                (game-time > 5)
                
            (game-time > 5) =>
                (set-goal gl-temp 0)
                ;(up-reset-scouts)
                ;(up-send-scout group-type-land-explore -1)
                ;-chat-local-to-self "Sheep found, sending scout again")
            )


            ;******************************************************************************
            ;
            ; Spiral-scouting for first 5 et halvt min
            ;
            ;******************************************************************************



            (defrule
            (game-time > 5)
            (game-time > 5) =>
                (set-goal gl-lure 1)
                (disable-self)
            )

            (defrule
                (game-time > 5)
            (game-time > 5) =>
                (up-full-reset-search)
                (up-find-local c: town-center c: 1)
                (up-set-target-object search-local c: 0)
                (up-get-point position-object gl-tc-push-x)
                (set-goal gl-deer-found 2)	
                (disable-self)
            )

            ;(defconst gl-saved-point-x 100)
            ;(defconst gl-saved-point-y 101)
            ;(defconst gl-object-point-x 269)
            ;(defconst gl-object-point-y 270)
            ;(defconst gl-point-distance 150)
            ;(defconst gl-extra-point-x 177)
            ;(defconst gl-extra-point-y 178)

            (defrule
                (game-time < 58)
                (game-time > 0)
                (goal gl-temp 0)
                (game-time > 5)
            (game-time > 5) =>
                (set-goal gl-split-rule 205))

            (defrule
               (goal gl-split-rule 205)
                =>
                (up-reset-search 1 1 1 1)
                (up-filter-include -1 -1 -1 -1)
                (up-filter-exclude -1 -1 -1 -1)
                (up-filter-range -1 -1 -1 -1)
                (up-find-local c: town-center c: 1)
                (up-set-target-object search-local c: 0)
                (up-get-point position-object gl-extra-point-x)
                (up-get-point position-object gl-saved-point-x)
                (up-reset-search 1 1 1 1)
                (up-find-local c: scout-unit c: 1)
                (up-set-target-object search-local c: 0)
                (up-get-point position-object gl-object-point-x)
                (up-cross-tiles gl-object-point-x gl-extra-point-x c: 5)
                )

            (defrule
                (game-time < 58)
                (game-time > 0)
                    (goal gl-temp 0)
                ;	(not(goal gl-deer-found 1))
                (game-time > 5)
            (game-time > 5) =>
                (up-modify-goal gl-saved-point-x g:- gl-object-point-x)
                (up-modify-goal gl-saved-point-y g:- gl-object-point-y)
                (up-modify-goal gl-saved-point-x g:* gl-first-scouting-spiral-radius); Radius
                (up-modify-goal gl-saved-point-y g:* gl-first-scouting-spiral-radius); Radius
                (up-get-point-distance gl-extra-point-x gl-object-point-x gl-point-distance)
                (up-modify-goal gl-saved-point-x g:/ gl-point-distance)
                (up-modify-goal gl-saved-point-y g:/ gl-point-distance)
                (up-modify-goal gl-extra-point-x g:- gl-saved-point-x)
                (up-modify-goal gl-extra-point-y g:- gl-saved-point-y)
                (up-target-point gl-extra-point-x action-move -1 -1)
            )

            (defrule
                (game-time < 63)
                (game-time > 58)
                (goal gl-temp 0)
                (up-compare-goal gl-edge-distanse <= 20)
            (game-time > 5) =>
                (set-goal gl-split-rule 206))

            (defrule
