    ;13 preventing stupid vills on journeys
        (defrule
            (true)
            =>
            (set-goal gl-temp 0)
            (set-goal gl-temp-x -1)
            (set-goal gl-temp-y -1)
            (up-get-point position-self gl-temp1-x)
        )
        
        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 200)
            (up-remove-objects search-local object-data-index g:!= gl-temp)
        )

        (defrule
            (current-age < castle-age)
            (up-set-target-object search-local c: 0)
            =>
            (up-get-object-data object-data-move-x gl-temp-x)
            (up-get-object-data object-data-move-y gl-temp-y)
        )

        (defrule
            (current-age < castle-age)
            (up-set-target-object search-local c: 0)
            (up-object-data object-data-idling != 1)
            (up-point-distance gl-temp-x gl-temp1-x > 42)
            =>
            (up-target-point gl-temp-x action-stop -1 -1)
            ;(chat-to-all "fixing stupid vill on journey")
            (do-nothing)
        )

        (defrule
            (up-compare-goal gl-temp < 200)
            =>
            (up-modify-goal gl-temp c:+ 1)
            (up-jump-rule -4)
        )
        
        #load-if-not-defined DE-available
        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-local c: villager-class c: 200)
            (up-remove-objects search-local object-data-group-flag != first-tree-group)
            (up-remove-objects search-local object-data-target != 915)
            (up-get-point position-self gl-temp-x)
            (up-set-target-point gl-temp-x)
        )

        (defrule
            (up-set-target-object search-local c: 0)
            (up-object-target-data object-data-distance > 8)
            =>
            (up-target-point gl-temp-x action-stop -1 -1)
            ;(chat-to-all "fixing stupid wood vill early")
            (disable-self)
        )
        #end-if
        

; Fase 2: 
    ; Set strategy (safe*)
        (defrule
            (true)
            =>
            (set-goal gl-strategy greedy-archer-rush)
            (disable-self)
        )  

        
    ; Info (safe)
        ; Runs from Rehoboam has enough food to click up at 22 pop dark-age untill it reaches Castle age.
        ; Fase 2 will differ based on strategy choice.
