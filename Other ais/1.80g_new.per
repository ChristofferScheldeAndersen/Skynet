                        (goal gl-temp49 -1)
                        =>
                        (up-modify-goal gl-temp33 g:= gl-temp17)
                        (up-modify-goal gl-temp49 c:+ 1)
                    )

                    (defrule
                        (up-compare-goal gl-temp34 == 1)
                        (goal gl-temp48 -1)
                        =>
                        (up-modify-goal gl-temp34 g:= gl-temp11)
