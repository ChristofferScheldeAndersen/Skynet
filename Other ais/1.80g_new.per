        (up-get-point position-object gl-temp1-x)
        (up-set-target-point gl-temp1-x)
        )

        (defrule
        (goal gl-temp33 1)
        (up-set-target-object search-local g: gl-temp1)
        (up-set-target-by-id g: gl-temp3)
        (up-point-distance gl-enemy-x gl-temp-x > 9)
        (up-point-distance gl-enemy-x gl-temp-x <= 12)
        (up-point-distance gl-temp1-x gl-temp-x > 2)
        =>
        ;(set-goal gl-temp11 1)
        ;(chat-to-all "allowing target to change based on being far from target being semi close to tc")
        (do-nothing)
        )

        ;så:
        ;Skiftes target til det target med højest score. Dette gøres ved først at reset local list og tilføje
        ;den valgte knight. Remote list resettes aldrig. I stedet bruges den komando der rammer target object.

        (defrule
        (goal gl-temp33 1)
        (goal gl-temp11 1)
        (up-set-target-object search-local g: gl-temp1)
        (up-set-target-by-id g: gl-temp10)
        (up-set-target-object search-remote g: gl-temp14)
        =>
        (up-reset-search 1 1 0 0)
        (up-add-object-by-id search-local g: gl-temp13)
        (up-target-objects 1 action-default -1 -1)
        ;(up-chat-data-to-all "current knight nr %d" g: gl-temp1)
        ;(up-chat-data-to-all "with id %d" g: gl-temp13)
        ;(up-chat-data-to-all "change knight target from unit with score %d" g: gl-temp5)
        ;(up-chat-data-to-all "and id %d" g: gl-temp3)
        ;(up-chat-data-to-all "to unit with score %d" g: gl-temp9)
        ;(up-chat-data-to-all "and id %d" g: gl-temp10)
        )

        (defrule
                    (true)
                    =>
                    (up-get-precise-time 16 181)
                    (up-modify-sn 409 g:= 181)
                    )

                    ;til sidst genstartes loopet med et index skift for local unit
                    
                    (defrule
                    (up-compare-goal 181 < 20)
        (up-compare-goal gl-temp1 g:< gl-local-total)
        =>
        (up-modify-goal gl-temp1 c:+ 1)
        (up-jump-rule -35)
        )












    

        ; Direct skipping rule here
            (defrule
            (true)
            =>
            (up-get-rule-id gl-old-military-control-last-rule)
            )
            #end-if
            #end-if
            #end-if
            #end-if
            #end-if
            #end-if
    ;
        (defrule
            ;(true)
            (true)
            =>
            
            (up-get-precise-time 16 181)
            (up-modify-sn 410 g:= 181)
            ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
            )

            (defrule
                (or(taunt-detected my-player-number 234)
                (or(taunt-detected any-ally 234)
                (taunt-detected any-enemy 234)))
            =>
            (up-chat-data-to-all "script loop-duration 5 is: %d." g: 181)
            ;(up-jump-direct g: gl-end-of-script-rule)
            ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
            ;(up-chat-data-to-all "superiority goal is %d" g: 11)
            (do-nothing)
            )
    ; Old rules for military control (3+ player team)
        #load-if-not-defined UP-1-PLAYER-TEAM
        #load-if-not-defined UP-2-PLAYER-TEAM
        ; Skipping rules in the early game
            (defrule
            (true)
            =>
            (up-get-rule-id gl-old-military-control-first-rule)
            )
            
            (defrule
            (goal gl-change-to-old-military-rules -1)
            (up-compare-goal gl-old-military-control-last-rule != -1)
            =>
            (up-jump-direct g: gl-old-military-control-last-rule)
            (do-nothing)
            )
        ;Update gl-enemy-x to the location of the current target enemy efter der skiftes til gamle regler
            ;1 Detect whenever the ai changes target player.

                (defrule
                    (true)
                    =>
                    (set-goal gl-temp1 -1)
                )

                (defrule
                    (up-compare-sn sn-target-player-number s:!= sn-last-target-player-number)
                    =>
                    (set-goal gl-temp1 1)
                )

                (defrule
                    (true)
                    =>
                    (up-modify-sn sn-last-target-player-number s:= sn-target-player-number)
                    (set-goal gl-temp2 1)
                    (set-goal gl-temp-x -1)
                    (set-goal gl-temp1-x 0)
                    (set-goal gl-temp1-y 0)
                    (set-goal gl-temp3 0)
                )

            ;2 When it does then an id loop will run checking all buildings of the target player at locations that have been explored

                (defrule
                    (up-set-target-by-id g: gl-temp2)
                    =>
                    (up-get-point position-object gl-temp-x)
                )

                (defrule
                    (up-set-target-by-id g: gl-temp2)
                    (up-point-explored gl-temp-x != explored-no)
                    (up-object-data object-data-player s:== sn-target-player-number)
                    (up-object-data object-data-class == building-class)
                    (up-object-data object-data-type != mining-camp)
                    (up-object-data object-data-type != lumber-camp)
                    =>
                    (up-add-point gl-temp1-x gl-temp-x c: 1)
                    (up-modify-goal gl-temp3 c:+ 1)
                )

                (defrule
                    (goal gl-temp1 1)
                    (up-compare-goal gl-temp2 < 200000)
                    =>
                    (up-modify-goal gl-temp2 c:+ 1)
                    (up-jump-rule -3)
                )

            ;3 Find the center of gravity for all these buildings and update gl-enemy-x to use this point
            ;that should make sure there is no cheating and no lag

                (defrule
                    (goal gl-temp1 1)
                    (game-time > 5)
                    =>
                    (up-modify-goal gl-temp1-x g:/ gl-temp3)
                    (up-modify-goal gl-temp1-y g:/ gl-temp3)
                    (up-copy-point gl-enemy-x gl-temp1-x)
                    (up-send-flare gl-enemy-x)
                    ;(up-chat-data-to-all "new target player is player %d" s: sn-target-player-number)
                )
        ;
        ; Changing stance of all units once old rules are activated
            (defrule
                (game-time > 60)
                =>
                (up-set-attack-stance archery-class c: stance-defensive)
                (disable-self)
            )
        ; Military Priorities
            ;
            ;******************************************************************************

            (defrule
            (true)
            =>
            (up-set-offense-priority c: watch-tower c: -1)
            (up-set-offense-priority c: town-center c: 11)
            (up-set-offense-priority c: castle c: -1)
            (up-set-offense-priority c: villager c: -1)
                (up-set-offense-priority c: lumber-camp c: 4)
            (up-set-offense-priority c: mining-camp c: 4)
            (up-set-offense-priority c: mill c: 4)
                (up-set-offense-priority c: archer-line c: 5)
            (up-set-offense-priority c: knight-line c: 5)
            (disable-self)
            )

            ;(defrule
            ; (current-age == imperial-age)
            ; =>
            ; (up-set-offense-priority c: watch-tower c: 0)
            ; (up-set-offense-priority c: town-center c: 3)
            ; (up-set-offense-priority c: castle c: 0)
            ; (up-set-offense-priority c: villager c: 5)
            ;   (up-set-offense-priority c: lumber-camp c: 4)
            ; (up-set-offense-priority c: mining-camp c: 4)
            ; (up-set-offense-priority c: mill c: 4)
            ;  (up-set-offense-priority c: archer-line c: 8)
            ; (up-set-offense-priority c: knight-line c: 7)
            ; (up-set-offense-priority c: spearman-line c: 11)
            ; (disable-self)
            ;)

            ;******************************************************************************
            ;
        ; Chosing same targets
                ;
                ;******************************************************************************

                #load-if-defined UP-POCKET-POSITION

                (defrule
                (goal gl-pocket-military-priority -1)
                (game-time > 5)
                =>
                (up-modify-sn sn-focus-player-number g:= gl-myflank)
                (up-get-focus-fact allied-sn sn-target-player-number sn-target-player-number)
                )

                #end-if

            ;******************************************************************************
            ;
        ; Military Superiority
                ;
                ;******************************************************************************

                (defrule
                    (or(taunt-detected my-player-number 12)
                    (taunt-detected any-ally 12))
                    =>
                    (up-chat-data-to-all "Military superiority is %d." g: gl-MILITARY-SUPERIORITY)
                    (up-chat-data-to-all "gl-retreat-waiting-points is %d" g: gl-retreat-waiting-points)
                    (acknowledge-taunt my-player-number 12)
                    (acknowledge-taunt every-ally 12)
                )

                (defrule
                (true)
                =>
                (set-goal gl-MY-MILITARY 0)
                (set-goal gl-ENEMY-MILITARY 0)
                (set-goal gl-MILITARY-SUPERIORITY 0)
                (up-get-fact military-population 0 gl-MY-MILITARY)
                ;(set-strategic-number sn-focus-player-number target-player)
                (up-get-target-fact military-population 0 gl-ENEMY-MILITARY);virker pludselig ikke???
                (up-modify-goal gl-MY-MILITARY g:- gl-ENEMY-MILITARY) ; the important line
                (up-modify-goal gl-MILITARY-SUPERIORITY g:= gl-MY-MILITARY)
                )

                (defrule
                (true)
                =>
                (set-goal gl-MY-MILITARY 0)
                (set-goal gl-ENEMY-MILITARY 0)
                (set-goal gl-MY-TEAM-MILITARY 0)
                (set-goal gl-ENEMY-TEAM-MILITARY 0)
                (set-goal gl-TEAM-MILITARY-SUPERIORITY 0)
                (set-strategic-number sn-focus-player-number 1)
                )

                (defrule
                (or(players-stance focus-player ally)
                (up-compare-sn sn-focus-player-number == my-player-number))
                =>
                (up-get-focus-fact military-population 0 gl-MY-MILITARY)
                (up-modify-goal gl-MY-TEAM-MILITARY g:+ gl-MY-MILITARY)
                )

                (defrule
                (players-stance focus-player enemy)
                =>
                (up-get-focus-fact military-population 0 gl-ENEMY-MILITARY)
                (up-modify-goal gl-ENEMY-TEAM-MILITARY g:+ gl-ENEMY-MILITARY)
                )

                (defrule
                (up-compare-sn sn-focus-player-number < 8)
                =>
                (up-modify-sn sn-focus-player-number c:+ 1)
                (up-jump-rule -3)
                )

                (defrule
                (true)
                =>
                ;;;;(up-chat-data-to-all "my team military is %d." g: gl-MY-TEAM-MILITARY)
                ;;;;(up-chat-data-to-all "enemy team military is %d." g: gl-ENEMY-TEAM-MILITARY)
                (up-modify-goal gl-MY-TEAM-MILITARY g:- gl-ENEMY-TEAM-MILITARY) 
                (up-modify-goal gl-TEAM-MILITARY-SUPERIORITY g:= gl-MY-TEAM-MILITARY)
                ;;;;(up-chat-data-to-all "Team military superiority is %d." g: gl-TEAM-MILITARY-SUPERIORITY)
                )


                (defrule
                (true)
                =>
                (set-goal gl-MY-ECONOMY 0)
                (set-goal gl-ENEMY-ECONOMY 0)
                (set-goal gl-MY-TEAM-ECONOMY 0)
                (set-goal gl-ENEMY-TEAM-ECONOMY 0)
                (set-goal gl-TEAM-ECONOMY-SUPERIORITY 0)
                (set-goal gl-number-of-players-on-my-team 0)
                (set-goal gl-number-of-players-on-enemy-team 0)
                (set-goal gl-player-number-advantage 0)
                (set-strategic-number sn-focus-player-number 1)
                )

                (defrule
                (or(players-stance focus-player ally)
                (up-compare-sn sn-focus-player-number == my-player-number))
                =>
                (up-get-focus-fact civilian-population 0 gl-MY-ECONOMY)
                (up-modify-goal gl-MY-TEAM-ECONOMY g:+ gl-MY-ECONOMY)
                (up-modify-goal gl-number-of-players-on-my-team c:+ 1)
                )

                (defrule
                (players-stance focus-player enemy)
                =>
                (up-get-focus-fact civilian-population 0 gl-ENEMY-ECONOMY)
                (up-modify-goal gl-ENEMY-TEAM-ECONOMY g:+ gl-ENEMY-ECONOMY)
                (up-modify-goal gl-number-of-players-on-enemy-team c:+ 1)
                )

                (defrule
                (up-compare-sn sn-focus-player-number < 8)
                =>
                (up-modify-sn sn-focus-player-number c:+ 1)
                (up-jump-rule -3)
                )

                (defrule
                (true)
                =>
                ;;;;(up-chat-data-to-all "my team villagers is %d." g: gl-MY-TEAM-ECONOMY)
                ;;;;(up-chat-data-to-all "enemy team villagers is %d." g: gl-ENEMY-TEAM-ECONOMY)
                (up-modify-goal gl-MY-TEAM-ECONOMY g:- gl-ENEMY-TEAM-ECONOMY) 
                (up-modify-goal gl-TEAM-ECONOMY-SUPERIORITY g:= gl-MY-TEAM-ECONOMY)
                ;;;;(up-chat-data-to-all "Team civilian superiority is %d." g: gl-TEAM-ECONOMY-SUPERIORITY)
                (up-modify-goal gl-player-number-advantage g:+ gl-number-of-players-on-my-team)
                (up-modify-goal gl-player-number-advantage g:- gl-number-of-players-on-enemy-team)
                )

                (defrule
                (true)
                =>
                (up-modify-goal gl-TEAM-POP-SUPERIORITY c:= 0)
                (up-modify-goal gl-TEAM-POP-SUPERIORITY g:+ gl-TEAM-ECONOMY-SUPERIORITY)
                (up-modify-goal gl-TEAM-POP-SUPERIORITY g:+ gl-TEAM-MILITARY-SUPERIORITY)
                ;;;;(up-chat-data-to-all "Team pop superiority is %d." g: gl-TEAM-POP-SUPERIORITY)
                ;;;;(up-chat-data-to-all "Number of players on my team is %d." g: gl-number-of-players-on-my-team)
                ;;;;(up-chat-data-to-all "Number of players on enemy team is %d." g: gl-number-of-players-on-enemy-team)
                ;;;;(up-chat-data-to-all "Player number advantage is %d." g: gl-player-number-advantage)
                )

                #load-if-defined UP-4-PLAYER-GAME

                (defrule
                    (up-compare-goal gl-TEAM-POP-SUPERIORITY >= 65)
                    (population >= 180)
                    =>
                    (up-modify-goal gl-MILITARY-SUPERIORITY c:+ 30)
                )

                #end-if

                #load-if-defined UP-2-PLAYER-GAME

                (defrule
                (players-military-population target-player > 4)
                    (or(and(unit-type-count-total archer-line > 6)
                    (and(not(research-completed ri-crossbow))
                    (players-current-age target-player > feudal-age)))
                    (and(not(research-completed ri-plate-barding))
                    (players-current-age target-player > castle-age)))
                    =>
                (up-modify-goal gl-MILITARY-SUPERIORITY c:- 15)
                )

                (defrule
                (timer-triggered Military-Superiority-timer)
                (players-military-population target-player > 4)
                ;(game-time > 840)
                    (or(and(unit-type-count-total archer-line > 6)
                    (and(not(research-completed ri-crossbow))
                    (players-current-age target-player > feudal-age)))
                    (and(not(research-completed ri-plate-barding))
                    (players-current-age target-player > castle-age)))
                =>
                ;(chat-to-all "I am behind in upgrades -15")
                (do-nothing)
                )

                #end-if

                (defrule
                    (or(and(or(research-completed ri-crossbow)
                    (research-completed ri-elite-skirmisher))
                    (players-current-age target-player < castle-age))
                    (or(and(research-completed ri-plate-barding)
                    (players-current-age target-player < imperial-age))
                    (and(research-completed ri-arbalest)
                    (players-current-age target-player < imperial-age))))
                    =>
                (up-modify-goal gl-MILITARY-SUPERIORITY c:+ 15)
                )

                (defrule
                (timer-triggered Military-Superiority-timer)
                ; (game-time > 840)
                    (or(and(or(research-completed ri-crossbow)
                    (research-completed ri-elite-skirmisher))
                    (players-current-age target-player < castle-age))
                    (or(and(research-completed ri-plate-barding)
                    (players-current-age target-player < imperial-age))
                    (and(research-completed ri-arbalest)
                    (players-current-age target-player < imperial-age))))
                =>
                ;(chat-to-all "I am ahead in upgrades +15")
                (do-nothing)
                )

                (defrule
                    (players-military-population target-player < 2)
                        =>
                (up-modify-goal gl-MILITARY-SUPERIORITY c:+ 10)
                )

                (defrule
                (timer-triggered Military-Superiority-timer)
                ; (game-time > 840)
                (players-military-population target-player < 2)
                
                =>
                ;(chat-to-all "Opponent has no army +10")
                (do-nothing)
                )

                (defrule
                    (enemy-buildings-in-town)
                    (current-age < imperial-age)
                    (players-building-type-count target-player watch-tower-line > 1)
                    (unit-type-count battering-ram-line < 2)
                        =>
                (up-modify-goal gl-MILITARY-SUPERIORITY c:- 8)
                )

                (defrule
                (timer-triggered Military-Superiority-timer)
                (enemy-buildings-in-town)
                (current-age < imperial-age)
                (players-building-type-count target-player watch-tower-line > 1)
                (unit-type-count battering-ram-line < 2)
                    =>
                ;(chat-to-all "Defending trush -8")
                (do-nothing)
                )

                (defrule
                    (unit-type-count archer-line > 3)
                    (players-unit-type-count target-player skirmisher-line  > 2)
                    
                    (unit-type-count knight-line < 4)
                        (current-age < imperial-age)
                        =>
                (up-modify-goal gl-MILITARY-SUPERIORITY c:- 11)
                )

                (defrule
                (timer-triggered Military-Superiority-timer)
                (unit-type-count archer-line > 3)
                (unit-type-count knight-line < 4)
                    (players-unit-type-count target-player skirmisher-line  > 2)
                    (current-age < imperial-age)
                    =>
                ;(chat-to-all "Opponent counters my army with skirmishers -11")
                (do-nothing)
                )

                (defrule
                (unit-type-count skirmisher-line >= 15)
                    (players-unit-type-count target-player knight-line   >= 5)
                        =>
                (up-modify-goal gl-MILITARY-SUPERIORITY c:- 10)
