            (defrule
                (and	(up-compare-goal gl-deer-distance < 5)
                        (up-compare-goal gl-deer-distance != -1))
                (up-set-target-by-id g: gl-deer)
                (up-object-data object-data-status == 2)
                (goal gl-lure 2)
                (game-time < 800)
            (game-time > 5) =>
                (up-full-reset-search)
                (up-set-target-by-id g: gl-deer)
