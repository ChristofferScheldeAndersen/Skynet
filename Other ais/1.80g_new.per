                                        (up-modify-goal gl-position-self-x c:- 6)
                                        (up-modify-goal gl-position-self-y c:- 7)
                                        (up-copy-point gl-building-testing-spot-x gl-position-self-x)
                                    )


                                ;Check tiles
                                    ;der skiftes mellem de 9 farm tiles

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 2)
                                        =>
                                        ;(up-modify-goal gl-building-testing-spot-y c:- 1)
                                        (do-nothing)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 3)
                                        =>
                                        ;(up-modify-goal gl-building-testing-spot-x c:- 1)
                                        (do-nothing)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 4) ; end of original square
                                        =>
                                        ;(up-modify-goal gl-building-testing-spot-y c:+ 1)
                                        (do-nothing)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 5)
                                        =>
                                        ;(up-modify-goal gl-building-testing-spot-y c:+ 1)
                                        (do-nothing)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 6)
                                        =>
                                        ;(up-modify-goal gl-building-testing-spot-x c:+ 1)
                                        (do-nothing)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 7)
                                        =>
                                        ;(up-modify-goal gl-building-testing-spot-x c:+ 1)
                                        (do-nothing)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 8)
                                        =>
                                        ;(up-modify-goal gl-building-testing-spot-y c:- 1)
                                        (do-nothing)
                                    )

                                    (defrule
                                        (up-compare-goal gl-tiles-checker == 9)
                                        =>
                                        ;(up-modify-goal gl-building-testing-spot-y c:- 1)
                                        (do-nothing)
                                    )


                                    ;tile checkes

                                    (defrule
                                        (up-compare-goal gl-tiles-checker <= 9)
                                        (up-compare-goal gl-tiles-checker != -1)
                                        (not(and(up-can-build-line 0 gl-building-testing-spot-x c: farm) 
                                        (can-afford-building farm)))
                                        (goal gl-build-farm YES)
                                        =>
                                        (up-modify-goal gl-stuff-in-the-way c:+ 1)
                                    )

                                    (defrule ;extra rule to not make bugged farm in the corner
                                        (goal gl-build-farm YES)
                                        (up-compare-goal gl-building-testing-spot-x < 6)
                                        (up-compare-goal gl-building-testing-spot-y < 6)
                                        =>
                                        (up-modify-goal gl-stuff-in-the-way c:+ 1)
                                    )


                                    ;det lille loop med de 9 farm tiles genstartes

                                    (defrule
                                        (up-compare-goal gl-tiles-checker < 9) ; evt også lig med
                                        (up-compare-goal gl-tiles-checker != -1)
                                        (goal gl-build-farm YES)
                                        =>
                                        (up-modify-goal gl-tiles-checker c:+ 1)
                                        (set-goal gl-dont-count-tile -1)
                                        (up-jump-rule -11)
                                    )



                                    ;hvis der ikke kan bygges farm på spottet genstartes det store loop fra næste farm spot

                                    (defrule
                                        (goal gl-build-farm YES)
                                        (up-compare-goal gl-stuff-in-the-way > 0)
                                        (up-compare-goal gl-tiles-checker != -1)
                                        (up-compare-goal gl-danger-counter < 300)
                                        =>
                                        ;;;(up-chat-data-to-all "Placement blocked or to close to tc. Number of unfit tiles for placing building is %d." g: gl-stuff-in-the-way)
                                        (up-modify-goal gl-tiles-checker c:= 1)
                                        (up-modify-goal gl-farm-check c:+ 1)
                                        (up-modify-goal gl-stuff-in-the-way c:= 0) ; skal aktiveres
                                        (up-modify-goal gl-danger-counter c:+ 1)
                                        (up-jump-rule -289)
                                    )


                                ;Build farm
                                    ;hvis der ikke er blokkeret bygges farm og loop stoppes

                                    (defrule
                                        (true)
                                        =>
                                        (set-goal gl-farm-was-placed-this-pass -1)
                                    )

                                    (defrule
                                        (goal gl-build-farm YES)
                                        (up-compare-goal gl-stuff-in-the-way == 0)
                                        (up-compare-goal gl-tiles-checker != -1)
                                        =>
                                        (up-get-fact wood-amount 0 gl-temp1)
                                        (up-build-line gl-position-self-x gl-position-self-x c: farm)
                                        (up-get-fact wood-amount 0 gl-temp2)
                                    )

                                    (defrule
                                        (true)
                                        =>
                                        (set-goal gl-no-space-for-farms -1)
                                    )

                                    (defrule
                                        (goal gl-build-farm YES)
                                        (up-compare-goal gl-stuff-in-the-way == 0)
                                        (up-compare-goal gl-tiles-checker != -1)
                                        (up-compare-goal gl-temp1 g:== gl-temp2)
                                        (up-pending-objects c: farm == 0)
                                        =>
                                        (set-goal gl-no-space-for-farms 1)
                                    )

                                    (defrule
                                        (goal gl-build-farm YES)
                                        (up-compare-goal gl-stuff-in-the-way == 0)
                                        (up-compare-goal gl-tiles-checker != -1)
                                        =>
                                        ;;(chat-to-all "build farm")
                                        (set-goal gl-build-farm -1)
                                        (set-goal gl-farm-was-placed-this-pass YES)
                                        (set-strategic-number sn-cap-civilian-builders 0)
                                    )

                    ; send vills to unbuild farms
                                ; Resetting gl-X-unfinished-farm and gl-X-assigned-farming-vill when farm is finished
                                    
                                    ;Først tjekkes 5 farm goals for om den pågældende farm er færdigbygget og er target 
                                    ;for sin tilhørende villager. Hvis ja sættes begge goals til -1.
                        
                                    (defrule
                                        (up-compare-goal gl-first-unfinished-farm != -1) 
                                        (up-set-target-by-id g: gl-first-assigned-farming-vill) ; svt. goal != -1
                                        =>
                                        (up-get-object-target-data object-data-id gl-temp) 
                                    )

                                    (defrule
                                        (up-compare-goal  gl-first-assigned-farming-vill != -1)
                                        (up-set-target-by-id g: gl-first-unfinished-farm) ; svt. goal != -1
                                        (up-object-data object-data-status == status-ready) ; færdigbygget
                                        (up-compare-goal gl-temp g:== gl-first-unfinished-farm) ; vill arbejder
                                        =>
                                        (set-goal gl-first-unfinished-farm -1)
                                        (set-goal gl-first-assigned-farming-vill -1)
                                        ;(chat-to-all "first farm has been completed and assigned a vill. Resetting goals")
                                    ) ;2x5

                                    (defrule
                                        (up-compare-goal gl-second-unfinished-farm != -1) 
                                        (up-set-target-by-id g: gl-second-assigned-farming-vill) ; svt. goal != -1
                                        =>
                                        (up-get-object-target-data object-data-id gl-temp) 
                                    )

                                    (defrule
                                        (up-compare-goal  gl-second-assigned-farming-vill != -1)
                                        (up-set-target-by-id g: gl-second-unfinished-farm) ; svt. goal != -1
                                        (up-object-data object-data-status == status-ready) ; færdigbygget
                                        (up-compare-goal gl-temp g:== gl-second-unfinished-farm) ; vill arbejder
                                        =>
                                        (set-goal gl-second-unfinished-farm -1)
                                        (set-goal gl-second-assigned-farming-vill -1)
                                        ;(chat-to-all "second farm has been completed and assigned a vill. Resetting goals")
                                    ) ;2x5

                                    (defrule
                                        (up-compare-goal gl-third-unfinished-farm != -1) 
                                        (up-set-target-by-id g: gl-third-assigned-farming-vill) ; svt. goal != -1
                                        =>
                                        (up-get-object-target-data object-data-id gl-temp) 
                                    )

                                    (defrule
                                        (up-compare-goal  gl-third-assigned-farming-vill != -1)
                                        (up-set-target-by-id g: gl-third-unfinished-farm) ; svt. goal != -1
                                        (up-object-data object-data-status == status-ready) ; færdigbygget
                                        (up-compare-goal gl-temp g:== gl-third-unfinished-farm) ; vill arbejder
                                        =>
                                        (set-goal gl-third-unfinished-farm -1)
                                        (set-goal gl-third-assigned-farming-vill -1)
                                        ;(chat-to-all "third farm has been completed and assigned a vill. Resetting goals")
                                    ) ;2x5

                                    (defrule
                                        (up-compare-goal gl-forth-unfinished-farm != -1) 
                                        (up-set-target-by-id g: gl-forth-assigned-farming-vill) ; svt. goal != -1
                                        =>
                                        (up-get-object-target-data object-data-id gl-temp) 
                                    )

                                    (defrule
                                        (up-compare-goal  gl-forth-assigned-farming-vill != -1)
                                        (up-set-target-by-id g: gl-forth-unfinished-farm) ; svt. goal != -1
                                        (up-object-data object-data-status == status-ready) ; færdigbygget
                                        (up-compare-goal gl-temp g:== gl-forth-unfinished-farm) ; vill arbejder
                                        =>
                                        (set-goal gl-forth-unfinished-farm -1)
                                        (set-goal gl-forth-assigned-farming-vill -1)
                                        ;(chat-to-all "forth farm has been completed and assigned a vill. Resetting goals")
                                    ) ;2x5

                                    (defrule
                                        (up-compare-goal gl-fifth-unfinished-farm != -1) 
                                        (up-set-target-by-id g: gl-fifth-assigned-farming-vill) ; svt. goal != -1
                                        =>
                                        (up-get-object-target-data object-data-id gl-temp) 
                                    )

                                    (defrule
                                        (up-compare-goal  gl-fifth-assigned-farming-vill != -1)
                                        (up-set-target-by-id g: gl-fifth-unfinished-farm) ; svt. goal != -1
                                        (up-object-data object-data-status == status-ready) ; færdigbygget
                                        (up-compare-goal gl-temp g:== gl-fifth-unfinished-farm) ; vill arbejder
                                        =>
                                        (set-goal gl-fifth-unfinished-farm -1)
                                        (set-goal gl-fifth-assigned-farming-vill -1)
                                        ;(chat-to-all "fifth farm has been completed and assigned a vill. Resetting goals")
                                    ) ;2x5

                                ; Setting gl-X-unfinished-farm if a farm doesn't have vills tasked on it
                                    
                                    (defrule ;Hvis der er unattended farms og under 5 farms under konstruktion -> lav liste
                                        (or(up-compare-goal gl-first-unfinished-farm == -1)
                                        (or(up-compare-goal gl-second-unfinished-farm == -1)
                                        (or(up-compare-goal gl-third-unfinished-farm == -1)
                                        (or(up-compare-goal gl-forth-unfinished-farm == -1)
                                        (up-compare-goal gl-fifth-unfinished-farm == -1)))))
                                        =>
                                        (set-goal gl-split-rule 234)
                                    )

                                    (defrule
                                        (goal gl-split-rule 234)
                                        =>
                                        (up-full-reset-search)
                                        (up-filter-status c: status-pending c: list-active)
                                        (up-find-status-local c: farm c: 200)
                                        ;(up-remove-objects search-local object-data-tasks-count > 0)
                                        (up-remove-objects search-local object-data-id g:== gl-first-unfinished-farm)
                                        (up-remove-objects search-local object-data-id g:== gl-second-unfinished-farm)
                                        (up-remove-objects search-local object-data-id g:== gl-third-unfinished-farm)
                                        (up-remove-objects search-local object-data-id g:== gl-forth-unfinished-farm)
                                        (up-remove-objects search-local object-data-id g:== gl-fifth-unfinished-farm)
                                        (up-get-search-state gl-local-total)
                                        ;(up-chat-data-to-all "number of pending farms without ID's is %d." g: gl-local-total)
                                        )
                                        

                                    (defrule ;Hvis et farm-goal er ledigt sættes farm til dette goal
                                        (up-compare-goal gl-first-unfinished-farm == -1)
                                        (up-set-target-object search-local c: 0)
                                        =>
                                        (up-get-object-data object-data-id gl-first-unfinished-farm)
                                        (up-remove-objects search-local object-data-index == 0)
                                        ;(chat-to-all "setting ID for gl-first-unfinished-farm")
                                    ) 

                                    (defrule ;Hvis et farm-goal er ledigt sættes farm til dette goal
                                        (up-compare-goal gl-second-unfinished-farm == -1)
                                        (up-set-target-object search-local c: 0)
                                        =>
                                        (up-get-object-data object-data-id gl-second-unfinished-farm)
                                        (up-remove-objects search-local object-data-index == 0)
                                        ;(chat-to-all "setting ID for gl-second-unfinished-farm")
                                    ) 

                                    (defrule ;Hvis et farm-goal er ledigt sættes farm til dette goal
                                        (up-compare-goal gl-third-unfinished-farm == -1)
                                        (up-set-target-object search-local c: 0)
                                        =>
                                        (up-get-object-data object-data-id gl-third-unfinished-farm)
                                        (up-remove-objects search-local object-data-index == 0)
                                        ;(chat-to-all "setting ID for gl-third-unfinished-farm")
                                    ) 

                                    (defrule ;Hvis et farm-goal er ledigt sættes farm til dette goal
                                        (up-compare-goal gl-forth-unfinished-farm == -1)
                                        (up-set-target-object search-local c: 0)
                                        =>
                                        (up-get-object-data object-data-id gl-forth-unfinished-farm)
                                        (up-remove-objects search-local object-data-index == 0)
                                        ;(chat-to-all "setting ID for gl-forth-unfinished-farm")
                                    ) 

                                    (defrule ;Hvis et farm-goal er ledigt sættes farm til dette goal
                                        (up-compare-goal gl-fifth-unfinished-farm == -1)
                                        (up-set-target-object search-local c: 0)
                                        =>
                                        (up-get-object-data object-data-id gl-fifth-unfinished-farm)
                                        (up-remove-objects search-local object-data-index == 0)
                                        ;(chat-to-all "setting ID for gl-fifth-unfinished-farm")
                                    ) 

                                ; Forcing gl-X-assigned-farming-vills on their farms
                                    
                                    ;Der laves et tjeck for om hver vill har sin target farm som target og hvis ikke laves
                                    ;kommandoen.
                                    
                                    (defrule
                                        (up-compare-goal gl-first-unfinished-farm != -1) 
                                        (up-set-target-by-id g: gl-first-assigned-farming-vill) ; svt. goal != -1
                                        =>
                                        (up-get-object-target-data object-data-id gl-temp) 
                                    )

                                    (defrule
                                        (up-compare-goal  gl-first-assigned-farming-vill != -1)
                                        (up-set-target-by-id g: gl-first-unfinished-farm) ; svt. goal != -1
                                        (up-compare-goal gl-temp g:!= gl-first-unfinished-farm) ; vill arbejder ikke på farm
                                        =>
                                        (up-full-reset-search)
                                        (up-add-object-by-id search-local g: gl-first-assigned-farming-vill)
                                        (up-add-object-by-id search-remote g: gl-first-unfinished-farm)
                                        (up-target-objects 0 action-default -1 -1)
                                        ;(chat-to-all "assigning first farming vill to first unfinished farm")
                                    )

                                    (defrule
                                        (up-compare-goal gl-second-unfinished-farm != -1) 
                                        (up-set-target-by-id g: gl-second-assigned-farming-vill) ; svt. goal != -1
                                        =>
                                        (up-get-object-target-data object-data-id gl-temp) 
                                    )

                                    (defrule
                                        (up-compare-goal  gl-second-assigned-farming-vill != -1)
                                        (up-set-target-by-id g: gl-second-unfinished-farm) ; svt. goal != -1
                                        (up-compare-goal gl-temp g:!= gl-second-unfinished-farm) ; vill arbejder ikke på farm
                                        =>
                                        (up-full-reset-search)
                                        (up-add-object-by-id search-local g: gl-second-assigned-farming-vill)
                                        (up-add-object-by-id search-remote g: gl-second-unfinished-farm)
                                        (up-target-objects 0 action-default -1 -1)
                                        ;(chat-to-all "assigning second farming vill to second unfinished farm")
                                    )

                                    (defrule
                                        (up-compare-goal gl-third-unfinished-farm != -1) 
                                        (up-set-target-by-id g: gl-third-assigned-farming-vill) ; svt. goal != -1
                                        =>
                                        (up-get-object-target-data object-data-id gl-temp) 
                                    )

                                    (defrule
                                        (up-compare-goal  gl-third-assigned-farming-vill != -1)
                                        (up-set-target-by-id g: gl-third-unfinished-farm) ; svt. goal != -1
                                        (up-compare-goal gl-temp g:!= gl-third-unfinished-farm) ; vill arbejder ikke på farm
                                        =>
                                        (up-full-reset-search)
                                        (up-add-object-by-id search-local g: gl-third-assigned-farming-vill)
                                        (up-add-object-by-id search-remote g: gl-third-unfinished-farm)
                                        (up-target-objects 0 action-default -1 -1)
                                        ;(chat-to-all "assigning third farming vill to third unfinished farm")
                                    )

                                    (defrule
                                        (up-compare-goal gl-forth-unfinished-farm != -1) 
                                        (up-set-target-by-id g: gl-forth-assigned-farming-vill) ; svt. goal != -1
                                        =>
                                        (up-get-object-target-data object-data-id gl-temp) 
                                    )

                                    (defrule
                                        (up-compare-goal  gl-forth-assigned-farming-vill != -1)
                                        (up-set-target-by-id g: gl-forth-unfinished-farm) ; svt. goal != -1
                                        (up-compare-goal gl-temp g:!= gl-forth-unfinished-farm) ; vill arbejder ikke på farm
                                        =>
                                        (up-full-reset-search)
                                        (up-add-object-by-id search-local g: gl-forth-assigned-farming-vill)
                                        (up-add-object-by-id search-remote g: gl-forth-unfinished-farm)
                                        (up-target-objects 0 action-default -1 -1)
                                        ;(chat-to-all "assigning forth farming vill to forth unfinished farm")
                                    )

                                    (defrule
                                        (up-compare-goal gl-fifth-unfinished-farm != -1) 
                                        (up-set-target-by-id g: gl-fifth-assigned-farming-vill) ; svt. goal != -1
                                        =>
                                        (up-get-object-target-data object-data-id gl-temp) 
                                    )

                                    (defrule
                                        (up-compare-goal  gl-fifth-assigned-farming-vill != -1)
                                        (up-set-target-by-id g: gl-fifth-unfinished-farm) ; svt. goal != -1
                                        (up-compare-goal gl-temp g:!= gl-fifth-unfinished-farm) ; vill arbejder ikke på farm
                                        =>
                                        (up-full-reset-search)
                                        (up-add-object-by-id search-local g: gl-fifth-assigned-farming-vill)
                                        (up-add-object-by-id search-remote g: gl-fifth-unfinished-farm)
                                        (up-target-objects 0 action-default -1 -1)
                                        ;(chat-to-all "assigning fifth farming vill to fifth unfinished farm")
                                    )

                            


                    ; Setting gl-X-assigned-farming-vill and including it in farm-group
                            
                                    ;Hvis et farm goal er != -1 mens det's villager goal er -1 findes den nærmeste straggler
                                    ;vill og sættes ind i det tilsvarende villager goal

                                    (defrule
                                        (up-set-target-by-id g: gl-first-unfinished-farm) ; svt != -1
                                        (up-compare-goal gl-first-assigned-farming-vill == -1)
                                        =>
                                        (up-get-point position-object gl-temp1-x)
                                        (up-set-target-point gl-temp1-x)
                                        (up-full-reset-search) 
                                        (up-find-local c: villager-class c: 200)
                                        (up-remove-objects search-local object-data-group-flag != wood-group)
                                        (up-remove-objects search-local object-data-target == building-class)
                                        (up-remove-objects search-local object-data-id g:== gl-first-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-second-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-third-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-forth-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-fifth-assigned-farming-vill)
                                        (up-clean-search search-local object-data-distance search-order-asc)

                                    )

                                    (defrule
                                        (up-compare-goal gl-first-unfinished-farm != -1)
                                        (up-compare-goal gl-first-assigned-farming-vill == -1)
                                        (up-set-target-object search-local c: 0)
                                        =>
                                        (up-get-object-data object-data-id gl-first-assigned-farming-vill)
                                        (up-full-reset-search) 
                                        (up-find-local c: villager-class c: 200)
                                        (up-remove-objects search-local object-data-group-flag != farm-group)
                                        (up-add-object-by-id search-local g: gl-first-assigned-farming-vill)
                                        (up-reset-group c: farm-group)
                                        (up-modify-group-flag 0 c: farm-group)
                                        (up-create-group 0 0 c: farm-group)
                                        (up-modify-group-flag 1 c: farm-group)
                                        ;(chat-to-player my-player-number "Adding first-assigned-farming-vill to farm-group")
                                    ) 

                                    (defrule
                                        (up-set-target-by-id g: gl-second-unfinished-farm) ; svt != -1
                                        (up-compare-goal gl-second-assigned-farming-vill == -1)
                                        =>
                                        (up-get-point position-object gl-temp1-x)
                                        (up-set-target-point gl-temp1-x)
                                        (up-full-reset-search) 
                                        (up-find-local c: villager-class c: 200)
                                        (up-remove-objects search-local object-data-group-flag != wood-group)
                                        (up-remove-objects search-local object-data-target == building-class)
                                        (up-remove-objects search-local object-data-id g:== gl-first-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-second-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-third-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-forth-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-fifth-assigned-farming-vill)
                                        (up-clean-search search-local object-data-distance search-order-asc)
                                    )

                                    (defrule
                                        (up-compare-goal gl-second-unfinished-farm != -1)
                                        (up-compare-goal gl-second-assigned-farming-vill == -1)
                                        (up-set-target-object search-local c: 0)
                                        =>
                                        (up-get-object-data object-data-id gl-second-assigned-farming-vill)
                                        (up-full-reset-search) 
                                        (up-find-local c: villager-class c: 200)
                                        (up-remove-objects search-local object-data-group-flag != farm-group)
                                        (up-add-object-by-id search-local g: gl-second-assigned-farming-vill)
                                        (up-reset-group c: farm-group)
                                        (up-modify-group-flag 0 c: farm-group)
                                        (up-create-group 0 0 c: farm-group)
                                        (up-modify-group-flag 1 c: farm-group)
                                        ;(chat-to-player my-player-number "Adding second-assigned-farming-vill to farm-group")
                                    ) 

                                    (defrule
                                        (up-set-target-by-id g: gl-third-unfinished-farm) ; svt != -1
                                        (up-compare-goal gl-third-assigned-farming-vill == -1)
                                        =>
                                        (up-get-point position-object gl-temp1-x)
                                        (up-set-target-point gl-temp1-x)
                                        (up-full-reset-search) 
                                        (up-find-local c: villager-class c: 200)
                                        (up-remove-objects search-local object-data-group-flag != wood-group)
                                        (up-remove-objects search-local object-data-target == building-class)
                                        (up-remove-objects search-local object-data-id g:== gl-first-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-second-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-third-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-forth-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-fifth-assigned-farming-vill)
                                        (up-clean-search search-local object-data-distance search-order-asc)
                                    )

                                    (defrule
                                        (up-compare-goal gl-third-unfinished-farm != -1)
                                        (up-compare-goal gl-third-assigned-farming-vill == -1)
                                        (up-set-target-object search-local c: 0)
                                        =>
                                        (up-get-object-data object-data-id gl-third-assigned-farming-vill)
                                        (up-full-reset-search) 
                                        (up-find-local c: villager-class c: 200)
                                        (up-remove-objects search-local object-data-group-flag != farm-group)
                                        (up-add-object-by-id search-local g: gl-third-assigned-farming-vill)
                                        (up-reset-group c: farm-group)
                                        (up-modify-group-flag 0 c: farm-group)
                                        (up-create-group 0 0 c: farm-group)
                                        (up-modify-group-flag 1 c: farm-group)
                                        ;(chat-to-player my-player-number "Adding third-assigned-farming-vill to farm-group")
                                    ) 

                                    (defrule
                                        (up-set-target-by-id g: gl-forth-unfinished-farm) ; svt != -1
                                        (up-compare-goal gl-forth-assigned-farming-vill == -1)
                                        =>
                                        (up-get-point position-object gl-temp1-x)
                                        (up-set-target-point gl-temp1-x)
                                        (up-full-reset-search) 
                                        (up-find-local c: villager-class c: 200)
                                        (up-remove-objects search-local object-data-group-flag != wood-group)
                                        (up-remove-objects search-local object-data-target == building-class)
                                        (up-remove-objects search-local object-data-id g:== gl-first-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-second-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-third-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-forth-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-fifth-assigned-farming-vill)
                                        (up-clean-search search-local object-data-distance search-order-asc)
                                    )

                                    (defrule
                                        (up-compare-goal gl-forth-unfinished-farm != -1)
                                        (up-compare-goal gl-forth-assigned-farming-vill == -1)
                                        (up-set-target-object search-local c: 0)
                                        =>
                                        (up-get-object-data object-data-id gl-forth-assigned-farming-vill)
                                        (up-full-reset-search) 
                                        (up-find-local c: villager-class c: 200)
                                        (up-remove-objects search-local object-data-group-flag != farm-group)
                                        (up-add-object-by-id search-local g: gl-forth-assigned-farming-vill)
                                        (up-reset-group c: farm-group)
                                        (up-modify-group-flag 0 c: farm-group)
                                        (up-create-group 0 0 c: farm-group)
                                        (up-modify-group-flag 1 c: farm-group)
                                        ;(chat-to-player my-player-number "Adding forth-assigned-farming-vill to farm-group")
                                    ) 

                                    (defrule
                                        (up-set-target-by-id g: gl-fifth-unfinished-farm) ; svt != -1
                                        (up-compare-goal gl-fifth-assigned-farming-vill == -1)
                                        =>
                                        (up-get-point position-object gl-temp1-x)
                                        (up-set-target-point gl-temp1-x)
                                        (up-full-reset-search) 
                                        (up-find-local c: villager-class c: 200)
                                        (up-remove-objects search-local object-data-group-flag != wood-group)
                                        (up-remove-objects search-local object-data-target == building-class)
                                        (up-remove-objects search-local object-data-id g:== gl-first-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-second-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-third-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-forth-assigned-farming-vill)
                                        (up-remove-objects search-local object-data-id g:== gl-fifth-assigned-farming-vill)
                                        (up-clean-search search-local object-data-distance search-order-asc)
                                    )

                                    (defrule
                                        (up-compare-goal gl-fifth-unfinished-farm != -1)
                                        (up-compare-goal gl-fifth-assigned-farming-vill == -1)
                                        (up-set-target-object search-local c: 0)
                                        =>
                                        (up-get-object-data object-data-id gl-fifth-assigned-farming-vill)
                                        (up-full-reset-search) 
                                        (up-find-local c: villager-class c: 200)
                                        (up-remove-objects search-local object-data-group-flag != farm-group)
                                        (up-add-object-by-id search-local g: gl-fifth-assigned-farming-vill)
                                        (up-reset-group c: farm-group)
                                        (up-modify-group-flag 0 c: farm-group)
                                        (up-create-group 0 0 c: farm-group)
                                        (up-modify-group-flag 1 c: farm-group)
                                        ;(chat-to-player my-player-number "Adding fifth-assigned-farming-vill to farm-group")
                                    ) 


                    ; Make sure no vills are send by the ai engine to unbuild farms
                        (defrule
                            (true)
                            =>
                            (set-strategic-number sn-cap-civilian-builders 50)
                            (up-full-reset-search)
                            (up-filter-status c: status-pending c: list-active)
                            (set-strategic-number sn-focus-player-number my-player-number)
                            (up-find-status-remote c: farm c: 200)
                            (up-remove-objects search-remote object-data-tasks-count > 0)
                        )

                        (defrule
                            (up-set-target-object search-remote c: 0)
                            =>
                            (set-strategic-number sn-cap-civilian-builders 0)
                            ;(chat-to-all "capping building vills at 0")
                        )

                    ; Chosing to build farm if it has top priority

                        (defrule
                        (up-compare-goal gl-top-building-priority >= 100)
                            (up-compare-goal gl-next-building == priority-farm)
                            (can-afford-building farm)
                            =>
                            (set-goal gl-build-farm YES)
                                    (set-goal gl-farm-check 1) 
                                    (up-modify-goal gl-danger-counter c:= 0)
                        )
                    ; Debug
                        (defrule
                            (taunt-detected my-player-number 9)
                            =>
                            (up-chat-data-to-all "gl-first-unfinished-farm is %d." g: gl-first-unfinished-farm)
                            (up-chat-data-to-all "gl-first-assigned-farming-vill is %d." g: gl-first-assigned-farming-vill)
                            (up-chat-data-to-all "gl-second-unfinished-farm is %d." g: gl-second-unfinished-farm)
                            (up-chat-data-to-all "gl-second-assigned-farming-vill is %d." g: gl-second-assigned-farming-vill)
                            (up-chat-data-to-all "gl-third-unfinished-farm is %d." g: gl-third-unfinished-farm)
                            (up-chat-data-to-all "gl-third-assigned-farming-vill is %d." g: gl-third-assigned-farming-vill)
                            (up-chat-data-to-all "gl-forth-unfinished-farm is %d." g: gl-forth-unfinished-farm)
                            (up-chat-data-to-all "gl-forth-assigned-farming-vill is %d." g: gl-forth-assigned-farming-vill)
                            (up-chat-data-to-all "gl-fifth-unfinished-farm is %d." g: gl-fifth-unfinished-farm)
                            (up-chat-data-to-all "gl-fifth-assigned-farming-vill is %d." g: gl-fifth-assigned-farming-vill)
                            (acknowledge-taunt my-player-number 9)
                        )


                ;
                ; Town center
                    




                    ;sidste 3 regler kører kun når can-build tc passer og building priority er tc.
                    ;sæt goals før loop inkl bedste score og bedste point til -999. gl-temp1 og gl-temp2 sættes til -45
                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp1 -45)
                        (set-goal gl-temp2 -45)
                        (set-goal gl-temp3 -999)
                        (set-goal gl-temp1-x -1)
                        (set-goal gl-temp1-y -1)
                    )

                    ;start loop med full-reset-search og vælge position-self og justere for x og y goal counters (gl-temp1 og gl-temp2)
                    (defrule
                        (true)
                        =>
                        (up-get-point position-self gl-temp-x)
                        (up-modify-goal gl-temp-x g:+ gl-temp1)
                        (up-modify-goal gl-temp-y g:+ gl-temp2)
                        (set-goal gl-temp4 -1)
                        (set-goal gl-temp5 -1)
                        (up-get-search-state gl-local-total)
                    )

                    ;tjek om tc kan bygges i point.
                    (defrule
                        (up-can-build-line 0 gl-temp-x c: town-center)
                        (up-point-distance gl-temp-x gl-last-deleted-building-x > 12)
                        =>
                        (set-goal gl-temp4 1)
                    )
                    ;hvis ja så tjek score ved at lave search for nære træer, semi nære træer og nære gold tiles
                    (defrule
                        (goal gl-temp4 1)
                        =>
                        (up-full-reset-search)
                        (up-set-target-point gl-temp-x)
                        (up-filter-distance c: -1 c: 6)
                        (up-filter-status c: status-ready c: list-active)
                        (up-find-resource c: wood c: 40)
                        (up-filter-status c: status-resource c: list-active)
                        (up-find-resource c: wood c: 40)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-remote-total c:* 2)
                        (up-modify-goal gl-temp5 g:+ gl-remote-total)
                    )

                    (defrule
                        (goal gl-temp4 1)
                        =>
                        (up-full-reset-search)
                        (up-set-target-point gl-temp-x)
                        (up-filter-distance c: 6 c: 8)
                        (up-filter-status c: status-ready c: list-active)
                        (up-find-resource c: gold c: 40)
                        (up-filter-status c: status-resource c: list-active)
                        (up-find-resource c: wood c: 40)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-temp5 g:+ gl-remote-total)
                    )

                    (defrule
                        (goal gl-temp4 1)
                        =>
                        (up-full-reset-search)
                        (up-set-target-point gl-temp-x)
                        (up-filter-distance c: -1 c: 4)
                        (up-filter-status c: status-resource c: list-active)
                        (up-find-resource c: gold c: 40)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-remote-total c:* 12)
                        (up-modify-goal gl-temp5 g:+ gl-remote-total)
                    )

                    (defrule
                        (goal gl-temp4 1)
                        =>
                        (up-full-reset-search)
                        (up-set-target-point gl-temp-x)
                        (up-filter-distance c: 4 c: 6)
                        (up-filter-status c: status-resource c: list-active)
                        (up-find-resource c: gold c: 40)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-remote-total c:* 6)
                        (up-modify-goal gl-temp5 g:+ gl-remote-total)
                    )

                    (defrule
                        (goal gl-temp4 1)
                        =>
                        (up-full-reset-search)
                        (up-set-target-point gl-temp-x)
                        (up-filter-distance c: -1 c: 4)
                        (up-filter-status c: status-resource c: list-active)
                        (up-find-resource c: stone c: 40)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-remote-total c:* 3)
                        (up-modify-goal gl-temp5 g:+ gl-remote-total)
                    )
                    ;træk afstand til main tc fra scoren
                    (defrule
                        (goal gl-temp4 1)
                        =>
                        (up-get-point position-self gl-temp2-x)
                        (up-get-point-distance gl-temp2-x gl-temp-x gl-temp)
                        (up-modify-goal gl-temp c:* 3)
                        (up-modify-goal gl-temp5 g:- gl-temp)
                    )
                    ;træk 50 fra scoren hvis tc er inden for 16 tiles af andet tc
                    (defrule
                        (goal gl-temp4 1)
                        =>
                        (up-full-reset-search)
                        (up-set-target-point gl-temp-x)
                        (set-strategic-number sn-focus-player-number my-player-number)
                        (up-find-remote c: town-center c: 10)
                        (up-remove-objects search-remote object-data-status == status-pending)
                        (up-filter-status c: status-pending c: list-active)
                        (up-find-status-remote c: town-center-foundation c: 10)
                        (up-remove-objects search-remote object-data-distance > 12)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-remote-total c:* 50)
                        (up-modify-goal gl-temp5 g:- gl-remote-total)
                    )

                    ;Hvis town er under attack og man ikke er pocket lægges afstanden til enemy tc til scoren
                    ;der trækkes også 80 fra for at få en mere gennemsnitlig værdi
                    (defrule
                        (goal gl-temp4 1)
                        (up-compare-goal gl-enemy-x != -1)
                        (town-under-attack)
                        (up-enemy-units-in-town > 3)
                        =>
                        (up-get-point-distance gl-enemy-x gl-temp-x gl-temp)
                        (up-modify-goal gl-temp c:* 2)
                        (up-modify-goal gl-temp c:/ 3)
                        (up-modify-goal gl-temp5 g:+ gl-temp)
                        (up-modify-goal gl-temp5 c:- 50)
                    )

                    ;hvis point har bedre score end tidl bedste gemmes det nye point og score
                    (defrule
                        (goal gl-temp4 1)
                        (up-compare-goal gl-temp5 g:> gl-temp3)
                        =>
                        (up-modify-goal gl-temp3 g:= gl-temp5)
                        (up-copy-point gl-temp1-x gl-temp-x)
                    )

                    ;genstart loop for x goals under 45 og læg 1 til
                    (defrule
                        (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-town-center)
                        (can-build town-center)
                        (stone-amount >= 100)
                        (up-compare-goal gl-temp1 < 45)
                        =>
                        (up-modify-goal gl-temp1 c:+ 1)
                        (up-jump-rule -12)
                    )

                    ;genstart loop for y goals under 45 og læg en til. sæt x goal til -45
                    (defrule
                        (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-town-center)
                        (can-build town-center)
                        (stone-amount >= 100)
                        (up-compare-goal gl-temp2 < 45)
                        =>
                        (up-modify-goal gl-temp2 c:+ 1)
                        (set-goal gl-temp1 -45)
                        (up-jump-rule -13)
                    )

                    ;byg tc i bedste point og nulstil building priority goal
                    
                    (defrule
                        (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-town-center)
                        (can-build town-center)
                        (up-compare-goal gl-temp1-x != -1)
                        (building-type-count-total town-center < 3)
                        =>
                        (up-build-line gl-temp1-x gl-temp1-x c: town-center-foundation)
                        ;(up-chat-data-to-all "bulding tc with score %d" g: gl-temp3)
                    )

                ; Stable
                    (defrule
                        (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-stable)
                        (can-build stable)
                        (building-type-count-total stable >= 2)
                        (building-type-count-total stable <= 4)
                        =>
                        (build stable)
                    )

                    (defrule
                        (up-compare-goal gl-top-building-priority >= 100)
                        (up-compare-goal gl-next-building == priority-stable)
                        (can-build stable)
                        (building-type-count-total stable < 2)
