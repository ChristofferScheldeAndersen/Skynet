                        (commodity-selling-price stone > 75)
                        (gold-amount < 250)
                        (building-type-count-total town-center == 3)
                        =>
                        (sell-commodity stone)
                        ;(chat-to-all "selling excess stone")
                    )

                    (defrule
                        (up-research-status c: ri-paladin < research-pending)
                        (up-research-status c: ri-savar < research-pending)
                        (or(and(food-amount >= 500)
                        (commodity-selling-price food >= 55))
                        (or(and(food-amount >= 800)
                        (commodity-selling-price food >= 45))
                        (wood-amount >= 2000)))
                        (gold-amount < 100)
                        =>
                        (sell-commodity food)
                        ;(chat-to-all "selling excess food")
                    )

                    (defrule
                        (up-research-status c: ri-paladin < research-pending)
                        (up-research-status c: ri-savar < research-pending)
                        (or(and(food-amount < 100)
                        (gold-amount > 250))
                        (and(food-amount < 1000)
                        (gold-amount > 1000)))
                        =>
                        (set-goal gl-split-rule 714)
                    )

                    (defrule
                        (goal gl-split-rule 714)
                        (or(commodity-buying-price food < 160)
                        (or(and(gold-amount > 1000)
                        (commodity-buying-price food < 185))
                        (and(gold-amount > 500)
                        (commodity-buying-price food < 175))))
                        =>
                        (buy-commodity food)
                        ;(chat-to-all "buying food for exces gold")
                    )
                        
                
                ;from 1v1 rules
                    (defrule
                        (up-research-status c: imperial-age < research-pending)
                        (or(and(gold-amount > 400)
                        (commodity-buying-price food <= 150))
                        (and(gold-amount > 700)
                        (commodity-buying-price food <= 200)))
                        (food-amount < 200)
                        (gold-amount > 400)
                        (building-type-count town-center <= 1)
                        (stone-amount >= 100)
                        =>
                        (buy-commodity food)
                        ;(chat-to-all "buying food in early castle age")
                    )

                    (defrule
                        (wood-amount >= 500)
                        (not(can-buy-commodity stone))
                        (building-type-count-total town-center < 3)
                        (up-pending-objects c: town-center-foundation == 0)
                        (stone-amount < 100)
                        (can-sell-commodity wood)
                        =>
                        (sell-commodity wood)
                        ;(chat-to-all "selling wood to buy stone for tc")
                    )

                    (defrule
                        (can-buy-commodity stone)
                        (building-type-count-total town-center <= 2)
                        (up-pending-objects c: town-center-foundation == 0)
                        (stone-amount < 100)
                        =>
                        (buy-commodity stone)
                        ;(chat-to-all "buying stone for 3. tc")
                    )
                    
                    (defrule
                        (or(up-research-status c: ri-paladin >= research-pending)
                        (up-research-status c: ri-savar >= research-pending))
                        (wood-amount >= 300)
                        (commodity-selling-price wood > 40)
                        (or(gold-amount <= 200)
                        (commodity-selling-price wood > 60))
                        (up-compare-goal gl-saving-wood-needed < 300)
                        =>
                        (sell-commodity wood)
                        ;(chat-to-all "selling exces wood")
                    )
                    
                    (defrule
                        (or(up-research-status c: ri-paladin >= research-pending)
                        (up-research-status c: ri-savar >= research-pending))
                        (building-type-count-total castle >= 1)
                        (stone-amount >= 300)
                        (or(gold-amount <= 200)
                        (commodity-selling-price stone > 75))
                        =>
                        (sell-commodity stone)
                       ; (chat-to-all "selling exces stone")
                    )

                    (defrule
                        (or(up-research-status c: ri-paladin >= research-pending)
                        (up-research-status c: ri-savar >= research-pending))
                        (food-amount >= 300)
                        (or(commodity-selling-price food > 40)
                        (food-amount >= 1600))
                        (or(gold-amount <= 200)
                        (commodity-selling-price food > 60))
                        (up-compare-goal gl-saving-food-needed < 300)
                        =>
                        (sell-commodity food)
                        ;(chat-to-all "selling exces food")
