                (up-object-data object-data-type == militiaman)
                =>
                (up-modify-goal gl-unit-score c:* 133)
                (up-modify-goal gl-unit-score c:/ 100)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-combined-enemy-unit-score g:+ gl-unit-score)
            )

            (defrule
                (up-compare-goal gl-index-number < 10)
                =>
                (up-modify-goal gl-index-number c:+ 1)
                (up-jump-direct g: gl-enemy-unit-score-first-rule)
            )



            ;Hvordan vill jeg gerne have vills til at kæmpe mod militia, scouts og man at arms kontra at flygte?

            ;lad os sige hver villager med 40 hp har en score på 100.
            ;lad os sige hver militia med 40 hp også har en score på 100
            ;lad os sige en scout med 45 hp og 3 attack har en score på 80
            ;lad os sige en scout med 45 hp og 5 attack har en score på 140
            ;lad os sige en man at arms med 45 hp og 6 attack har en score på 180 (evt 200)
            ;lad os sige at egne archer units i basen tæller for 200.
            ;militia score kan så ganges med en faktor afh af enemy civ.
            ;en af scorene må ganges med 100 for at kunne finde forholdet i procent.

            ;Hver unit's score udgøres af en base score på 33% af maks scoren + restscoren på der afhænger af tilbageværende hp.
            ;Den simpleste form af mit nye system ville bare finde den kombinerede score for alle enemy units fundet i den originale search.
            ;For et 3 militia drush + en scout ville det være 380.
            ;For et 4 man at arms rush + en scout ville det være 960
            ;For en woodline med 6 vills ville det være 600.
            ;For en berry gruppe ville det være 400.

            ;Der sættes et goal ud fra om forholdet mellem vill gruppe og enemy gruppe. F.eks. kunne man sige at hvis enemy army er over 50%
            ;stærkere skal der retreates og ellers kører scriptet som normalt. Dette sker ved at sætte dette goal som præmis for fight eller
            ;retask reglerne.
            ;Det ville i udgangspunktet betyde at der altid kæmpes mod et drush og at der aldrig kæmpes mod et man at arms rush medmindre det 
            ; er et 3 man at arms rush på en woodline eller en stor gold gruppe.
        
        ;Find kombineret local score

            (defrule
                (true)
                =>
                (set-goal gl-index-number 0)
                (set-goal gl-combined-ally-unit-score 0)
                (up-clean-search search-local -1 search-order-asc)
                
            )

            (defrule
                (true)
                =>
                (up-get-rule-id gl-ally-unit-score-first-rule)
                (set-goal gl-unit-score 0)
            )

            (defrule
                (up-set-target-object search-local g: gl-index-number)
                (up-object-data object-data-class == villager-class)
                =>
                (up-get-object-data object-data-hitpoints gl-hitpoints)
                (up-get-object-data object-data-maxhp gl-max-hitpoints)
                (up-modify-goal gl-hitpoint-percentage g:= gl-hitpoints)
                (up-modify-goal gl-hitpoint-percentage c:* 100)
                (up-modify-goal gl-hitpoint-percentage g:/ gl-max-hitpoints)
                (up-modify-goal gl-hitpoint-percentage c:* 133)
                (up-modify-goal gl-hitpoint-percentage c:/ 100)
                (up-modify-goal gl-hitpoint-percentage c:- 33) ;En unit på 50% hp vil så ende på 33,3%
                (up-modify-goal gl-unit-score g:= gl-hitpoint-percentage)
            )

            (defrule
                (up-set-target-object search-local g: gl-index-number)
                (up-object-data object-data-type == archer)
                =>
                (up-modify-goal gl-unit-score c:= 80)
            )

            (defrule
                (true)
                =>
                (up-modify-goal gl-combined-ally-unit-score g:+ gl-unit-score)
            )

            (defrule
                (up-compare-goal gl-index-number < 39)
                =>
                (up-modify-goal gl-index-number c:+ 1)
                (up-jump-direct g: gl-ally-unit-score-first-rule)
            )

        ;Løb til tc hvis modstanderens gruppe er for stærk til at kæmpe mod

            (defrule
                (true)
                =>
                ;(up-chat-data-to-all "ally score is %d" g: gl-combined-ally-unit-score)
                ;(up-chat-data-to-all "enemy score is %d" g: gl-combined-enemy-unit-score)
                
                (up-modify-goal gl-local-enemy-superiority-percentage g:= gl-combined-enemy-unit-score)
                (up-modify-goal gl-local-enemy-superiority-percentage c:* 100)
                (up-modify-goal gl-local-enemy-superiority-percentage g:/ gl-combined-ally-unit-score)
                (set-goal gl-run-away -1)
                ;(up-chat-data-to-all "gl-local-enemy-superiority-percentage is %d" g: gl-local-enemy-superiority-percentage)
            )

            (defrule
                (taunt-detected my-player-number 248)
                =>
                (up-chat-data-to-all "ally score is %d" g: gl-combined-ally-unit-score)
                (up-chat-data-to-all "enemy score is %d" g: gl-combined-enemy-unit-score)
                (up-chat-data-to-all "gl-local-enemy-superiority-percentage is %d" g: gl-local-enemy-superiority-percentage)
                (acknowledge-taunt my-player-number 248)
            )

            (defrule
                (up-compare-goal gl-local-enemy-superiority-percentage >= 120)
                (unit-type-count archer-line < 4)
                (unit-type-count skirmisher-line < 4)
                =>
                (set-goal gl-run-away 1)
            )

            (defrule
                (true)
                =>
                (set-goal gl-temp -1)
                (set-goal gl-temp1 -1)
            )
        
            (defrule
                (goal gl-run-away 1)
                (up-set-target-by-id g: gl-tc-id)
                =>
                (up-remove-objects search-local object-data-target-id g:== gl-tc-id)
                (up-target-objects 1 action-default -1 -1)
                (set-goal gl-temp 1)
            )

            ;Når vills løber har jeg brug for at vide om der er en unfinished bygning tæt på en af disse vills.
