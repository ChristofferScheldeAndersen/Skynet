                    (up-reset-search 1 1 0 0)
                    (up-find-local c: villager-class c: 200)
                    (up-remove-objects search-local object-data-group-flag != pre-farming-straggler-group)
                    (up-remove-objects search-local object-data-target != 915) ;tree
                    (up-remove-objects search-local object-data-carry != 0)
                    (up-clean-search search-local object-data-id search-order-asc)
                    (set-goal gl-temp2 -1)
                    (set-goal gl-temp4 -1)
                    (set-goal gl-temp-x -1)
                    (set-goal gl-temp-y -1)
                    (up-get-point position-self gl-temp1-x)
                    )
                    
                    (defrule
                        (up-set-target-object search-local g: gl-temp3)
                        =>
                        (up-get-object-data object-data-id gl-temp4)
                        (up-get-object-target-data object-data-id gl-temp2)
                    )

                    (defrule
                        (up-set-target-object search-local g: gl-temp3)
                        (up-set-target-by-id g: gl-temp2)
                        =>
                        (up-get-point position-object gl-temp-x)
                    )

                    (defrule
                        (up-point-distance gl-temp-x gl-temp1-x > 9)
                        (up-point-distance gl-temp-x gl-first-lumber-camp-location-x > 6)
                        (up-point-distance gl-temp-x gl-second-lumber-camp-location-x > 6)
                        (up-compare-goal gl-temp3 < 50)
                        (up-set-target-by-id g: gl-temp2)
                        (up-set-target-object search-local g: gl-temp3)
                        =>
                        (up-reset-search 1 1 0 0)
                        (up-add-object-by-id search-local g: gl-temp4)
                        (up-target-point gl-temp-x action-stop -1 -1)
                        (up-reset-search 1 1 0 0)
                        (up-modify-goal gl-temp3 c:+ 1)
                        (up-jump-rule -4)
                    )

                    

