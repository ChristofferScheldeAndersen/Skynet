        (defrule
        (true)
        =>
        (set-goal gl-temp2 0)
        (set-goal gl-temp3 0)
        (set-goal gl-temp4 0)
        (set-goal gl-temp5 0)
        (set-strategic-number sn-focus-player-number 1)
        )

        (defrule
        (or(players-stance focus-player ally)
        (up-compare-sn sn-focus-player-number == my-player-number))
        =>
        (up-get-focus-fact population 0 gl-temp2)
        (up-modify-goal gl-temp3 g:+ gl-temp2)
        )

        (defrule
        (players-stance focus-player enemy)
        =>
        (up-get-focus-fact population 0 gl-temp4)
        (up-modify-goal gl-temp5 g:+ gl-temp4)
        )

        (defrule
        (up-compare-sn sn-focus-player-number < 8)
        =>
        (up-modify-sn sn-focus-player-number c:+ 1)
        (up-jump-rule -3)
        )

        (defrule
            (true)
            =>
            (up-modify-goal gl-temp3 c:* 100)
            (up-modify-goal gl-temp3 g:/ gl-temp5)
            (up-modify-goal gl-temp1 g:= gl-temp3)
        )

        (defrule
            (goal gl-temp11 -1)
            (or(and(up-compare-goal gl-temp1 < 14)
            (up-compare-goal gl-player-number-advantage <= -2))
            (or(and(up-compare-goal gl-temp1 < 18)
            (up-compare-goal gl-player-number-advantage == -1))
            (or(and(up-compare-goal gl-temp1 < 25)
            (up-compare-goal gl-player-number-advantage == 0))
            (or(and(up-compare-goal gl-temp1 < 40)
            (up-compare-goal gl-player-number-advantage == 1))
            (and(up-compare-goal gl-temp1 < 55)
            (up-compare-goal gl-player-number-advantage >= 2))))))
            =>
            (enable-timer resign-timer 10)
            
                (chat-to-all "gg wp")
                (disable-self)
        )
        ;load-if-defined 8-player

        (defrule
            (timer-triggered resign-timer)
            =>
            (up-chat-data-to-all "LTI: %d ms." g: gl-lowest-avg-tick-interval)
            (up-chat-data-to-all "at: %d s." g: gl-lowest-avg-tick-interval-stamp)
            (up-chat-data-to-all "HTI: %d ms." g: gl-highest-avg-tick-interval)
            (up-chat-data-to-all "at: %d s" g: gl-highest-avg-tick-interval-stamp)
            (up-chat-data-to-all "ATI: %d." g: gl-final-avg-time-between-ticks)
            (up-chat-data-to-all "LST: %d ms." g: gl-lowest-avg-script-time)
            (up-chat-data-to-all "at: %d s." g: gl-lowest-avg-script-time-stamp)
            (up-chat-data-to-all "HST: %d ms." g: gl-highest-avg-script-time)
            (up-chat-data-to-all "at: %d." g: gl-highest-avg-script-time-stamp)
            (up-chat-data-to-all "AST: %d ms." g: gl-final-avg-script-time)
            (chat-to-all "Want to play vs other custom AIs like Rehoboam? On aoeaidatabase.pythonanywhere.com/?src=rh you can search for AIs with certain attributes, look up their 1v1 ELO and find guides on how to install and play vs them.")
            (resign)
        )

    ; 
        (defrule
                (true)
                =>
                
                (up-get-precise-time 16 181)
                (up-modify-sn 369 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration 1: %d" g: 181)
                )
    ; Attacking, retreating and avoiding dangerous objects (safe)
        ; New late game army controll 
            ; skip rules
                (defrule
                    (up-compare-goal gl-post-new-army-rules-id != -1)
                    (up-compare-goal gl-skip-new-army-counter < 4)
                    (up-compare-goal gl-time-between-ticks-avg-for-group > 950)
                    =>
                    (up-jump-direct g: gl-post-new-army-rules-id)
                    (up-modify-goal gl-skip-new-army-counter c:+ 1)
                )


                (defrule
                    (true)
                    =>
                    (set-goal gl-skip-new-army-counter 1)
                )
            ;Find army-center


                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: archery-class c: 200)
                    (up-find-local c: skirmisher-line c: 200)
                    (up-find-local c: spearman-line c: 200)
                    (up-find-local c: knight-line c: 200)
                    (up-find-local c: battering-ram-line c: 200)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp2 g:= gl-local-total)
                    (up-modify-goal gl-local-total c:* 30)
                    (up-modify-goal gl-local-total c:/ 100)
                    (up-modify-goal gl-temp2 g:- gl-local-total)
                    (set-goal gl-temp1 0)
                    (set-goal gl-temp1-x 0)
                    (set-goal gl-temp1-y 0)
                )

                (defrule
                    (goal gl-change-to-old-military-rules 1)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-point position-object gl-temp-x)
                    (up-add-point gl-temp1-x gl-temp-x c: 1)
                    (up-modify-goal gl-temp1 c:+ 1)
                    (up-remove-objects search-local object-data-index == 0)
                    (up-jump-rule -1)
                )

                (defrule
                    (goal gl-change-to-old-military-rules 1)
                    (game-time > 5)
                    =>
                    (up-modify-goal gl-temp1-x g:/ gl-temp1)
                    (up-modify-goal gl-temp1-y g:/ gl-temp1)
                )

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: archery-class c: 200)
                    (up-find-local c: skirmisher-line c: 200)
                    (up-find-local c: spearman-line c: 200)
                    (up-find-local c: knight-line c: 200)
                    (up-find-local c: battering-ram-line c: 200)
                    (up-set-target-point gl-temp1-x)
                    (up-clean-search search-local object-data-distance search-order-asc)
                    (up-remove-objects search-local object-data-index g:>= gl-temp2) ;fjern de 30% af units der er længst væk
                    (set-goal gl-temp1 0)
                    (set-goal gl-temp1-x 0)
                    (set-goal gl-temp1-y 0)
                )

                (defrule
                    (goal gl-change-to-old-military-rules 1)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-point position-object gl-temp-x)
                    (up-add-point gl-temp1-x gl-temp-x c: 1)
                    (up-modify-goal gl-temp1 c:+ 1)
                    (up-remove-objects search-local object-data-index == 0)
                    (up-jump-rule -1)
                )

                (defrule
                    (goal gl-change-to-old-military-rules 1)
                    (game-time > 5)
                    =>
                    (up-modify-goal gl-temp1-x g:/ gl-temp1)
                    (up-modify-goal gl-temp1-y g:/ gl-temp1)
                    (up-copy-point gl-ranged-army-x gl-temp1-x)
                )

                (defrule
                    (or(taunt-detected my-player-number 236)
                (or(taunt-detected any-ally 236)
                (taunt-detected any-enemy 236)))
                    =>
                    (up-chat-data-to-all "current center x of all army is %d" g: gl-temp1-x)
                (up-chat-data-to-all "current center y of all army is %d" g: gl-temp1-y)
                )
            
            ;Move stray units towards army center
                (defrule
                    (true)
                    =>
                    (set-goal gl-temp1 0)
                )

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-filter-include cmdid-military -1 -1 -1)
                    (up-find-local c: all-units-class c: 200)
                    (up-remove-objects search-local object-data-type == battering-ram)
                    (up-remove-objects search-local object-data-type == trebuchet)
                    (up-set-target-point gl-ranged-army-x)
                    (up-remove-objects search-local object-data-distance <= 20) 
                    (up-get-search-state gl-local-total)
                )

                (defrule
                    (up-compare-goal gl-my-position == 3)
                    (up-compare-sn sn-tsa > 0)
                    (goal gl-change-to-old-military-rules 1)
                    (up-set-target-object search-local g: gl-temp1)
                    (or(up-object-data object-data-target == building-class)
                    (or(up-object-data object-data-target == wall-class)
                    (or(up-object-data object-data-target == gate-class)
                    (or(up-object-data object-data-target == farm-class)
                    (up-object-data object-data-target == tower-class)))))
                    =>
                    (up-remove-objects search-local object-data-index g:!= gl-temp1)
                    (up-get-point position-object gl-temp-x)
                    (up-lerp-tiles gl-temp-x gl-ranged-army-x c: 10)
                    (up-target-point gl-temp-x action-move -1 -1)
                )

                (defrule
                    (up-compare-goal gl-my-position == 3)
                    (goal gl-change-to-old-military-rules 1)
                    (up-compare-sn sn-tsa > 0)
                    (up-compare-goal gl-temp1 g:< gl-local-total)
                    =>
                    (up-modify-goal gl-temp1 c:+ 1)
                    (up-jump-rule -3)
                )

            ;Retreat to fortification when defending

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-set-target-point gl-enemy-x)
                    (up-find-local c: town-center c: 200)
                    (up-clean-search search-local object-data-distance search-order-asc)
                )

                (defrule
                    (goal gl-change-to-old-military-rules 1)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-point position-object gl-temp1-x)
                )

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: castle c: 200)
                    (up-clean-search search-local object-data-distance search-order-asc)
                    (set-goal gl-temp1 0)

                )

                (defrule
                    (goal gl-change-to-old-military-rules 1)
                    (up-set-target-object search-local c: 0)
                    =>
                    (up-get-point position-object gl-temp1-x)
                )

                (defrule
                    (true)
                    =>
                    (up-get-point position-self gl-temp2-x)
                    (up-get-point-distance gl-temp2-x gl-temp1-x gl-temp2) ;temp2 is distance from position self to fortification
                )

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-filter-include cmdid-military -1 -1 -1)
                    (up-find-local c: all-units-class c: 200)
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-local-total c:- 1)
                )

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-filter-include cmdid-military -1 -1 -1)
                    (up-find-local c: all-units-class c: 200)
                )

                (defrule
                    (goal gl-change-to-old-military-rules 1)
                    (up-compare-sn sn-tsa == 0)
                    (up-set-target-object search-local g: gl-temp1)
                    =>
                    (up-get-point position-object gl-temp-x)
                )

                (defrule
                    (goal gl-change-to-old-military-rules 1)
                    (up-compare-sn sn-tsa == 0)
                    (up-compare-goal gl-my-position == 3)
                    (up-set-target-object search-local g: gl-temp1)
                    (up-point-distance gl-temp-x gl-temp1-x > 13) ;unit is over 13 tiles from most forward fortification.
                    (up-point-distance gl-temp-x gl-temp2-x g:> gl-temp2) ;unit is further from position self than most forward fortification.
                    =>
                    (up-lerp-tiles gl-temp-x gl-temp1-x c: 5)
                    (up-remove-objects search-local object-data-index g:!= gl-temp1)
                    (up-target-point gl-temp-x action-move -1 -1)
                )

                (defrule
                (goal gl-change-to-old-military-rules 1)
                    (up-compare-sn sn-tsa == 0)
                    (up-compare-goal gl-my-position == 3)
                    (up-compare-goal gl-temp1 g:< gl-local-total)
                    =>
                    (up-modify-goal gl-temp1 c:+ 1)
                    (up-jump-rule -4)
                )


            ;Treb controll
                ;Defining temp goals

                    (defconst gl-fortification-x 101)
                    (defconst gl-fortification-y 102)
                    (defconst gl-fortification-distance-to-self 103)
                    (defconst gl-short-distance 104)
                    (defconst gl-long-distance 105)
                    (defconst gl-max-remote-index 106)
                    (defconst gl-max-local-index 107)
                    (defconst gl-current-local-index 108)
                    (defconst gl-current-remote-index 109)
                    (defconst gl-local-loop-first-rule 110)
                    (defconst gl-remote-loop-first-rule 111)
                    (defconst gl-best-found-score 112)
                    (defconst gl-best-found-target 113)
                    (defconst gl-treb-distance-to-self 114)
                    (defconst gl-treb-x 115)
                    (defconst gl-treb-y 116)
                    (defconst gl-combined-score 117)
                    (defconst gl-potential-target-x 118)
                    (defconst gl-potential-target-y 119)
                    (defconst gl-fortification-distance-score 120)
                    (defconst gl-fortification-distance-modifier 121)
                    (defconst gl-treb-distance-modifier 123)
                    (defconst gl-fortification-range-bonus 124)
                    (defconst gl-castle-bonus 125)
                    (defconst gl-town-center-bonus 126)
                    (defconst gl-tower-bonus 127)
                    (defconst gl-treb-war-bonus 128)
                    (defconst gl-target-distance-score 129)

                ;Controll panel - use this to controll behavior.

                    (defrule
                        (true)
                        =>
                        (set-goal gl-fortification-distance-modifier 5) ;how much to prioritise distance from own fortified position to potential target
                        (set-goal gl-treb-distance-modifier 3) ;how much to prioritise distance from own treb to potential target
                        (set-goal gl-fortification-range-bonus 75) ;bonus for targeting objects close enough to own castle for own treb to be protectet
                        (set-goal gl-castle-bonus 150) 
                        (set-goal gl-town-center-bonus 100)
                        (set-goal gl-tower-bonus 50)
                        (set-goal gl-treb-war-bonus 75)
                    )

                ;Forcing trebs on no-attack-stance

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: unpacked-trebuchet-class c: 200)
                        (up-find-local c: packed-trebuchet-class c: 200)
                        (up-remove-objects search-local object-data-attack-stance == stance-no-attack)
                    )

                    (defrule
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-target-point gl-temp-x action-none -1 stance-no-attack)
                    )

                ;Find fortification og afstand fra denne til position-self

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-set-target-point gl-enemy-x)
                        (up-find-local c: town-center c: 200)
                        (up-clean-search search-local object-data-distance search-order-asc)
                    )

                    (defrule
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-point position-object gl-fortification-x)
                    )

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: castle c: 200)
                        (up-clean-search search-local object-data-distance search-order-asc)

                    )

                    (defrule
                        (up-set-target-object search-local c: 0)
                        =>
                        (up-get-point position-object gl-fortification-x)
                    )

                    (defrule
                        (true)
                        =>
                        (up-get-point position-self gl-temp-x)
                        (up-get-point-distance gl-temp-x gl-fortification-x gl-fortification-distance-to-self) 
                    )

                    
                ;søg først efter alle enemy tc's og castles startende med dem tættest på i et loop (udgangspunktet er mest forward fortification)

                    (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-set-target-point gl-fortification-x)
                        (set-goal gl-short-distance 0)
                        (set-goal gl-long-distance 5)
                    )

                    (defrule
                        (true)
                        =>
                        (up-filter-distance g: gl-short-distance g: gl-long-distance)
                        (set-strategic-number sn-focus-player-number 1)
                    )

                    (defrule
                        (players-stance focus-player enemy)
                        =>
                        (up-find-remote c: castle c: 40)
                        (up-find-remote c: town-center c: 40)
                        (up-find-remote c: watch-tower c: 40)
                        (up-find-remote c: unpacked-trebuchet-class c: 40)
                        (up-find-remote c: packed-trebuchet-class c: 40)
                    )

                    (defrule
                        (up-compare-sn sn-focus-player-number < 8)
                        =>
                        (up-modify-sn sn-focus-player-number c:+ 1)
                        (up-jump-rule -2)
                    )

                    (defrule
                        (up-compare-goal gl-long-distance < 200)
                        =>
                        (up-modify-goal gl-short-distance c:+ 5)
                        (up-modify-goal gl-long-distance c:+ 5)
                        (up-jump-rule -4)
                    )

                ;søg herefter efter alle bygninger startende med dem der er tættest på i et loop

                    (defrule
                        (true)
                        =>
                        (set-goal gl-short-distance 0)
                        (set-goal gl-long-distance 5)
                    )

                    (defrule
                        (true)
                        =>
                        (up-filter-distance g: gl-short-distance g: gl-long-distance)
                        (set-strategic-number sn-focus-player-number 1)
                    )

                    (defrule
                        (players-stance focus-player enemy)
                        =>
                        (up-find-remote c: building-class c: 40)
                    )

                    (defrule
                        (up-compare-sn sn-focus-player-number < 8)
                        =>
                        (up-modify-sn sn-focus-player-number c:+ 1)
                        (up-jump-rule -2)
                    )

                    (defrule
                        (up-compare-goal gl-long-distance < 200)
                        =>
                        (up-modify-goal gl-short-distance c:+ 5)
                        (up-modify-goal gl-long-distance c:+ 5)
                        (up-jump-rule -4)
                    )

                ;Hvis attack groups er 0 fjernes alle bygninger mere end 24 tiles fra fortification

                    (defrule
                        (up-compare-sn sn-tsa == 0)
                        =>
                        (up-remove-objects search-remote object-data-distance > 24)
                        (do-nothing)
                    )

                ;Antallet af local og remote search results findes for at afgrænse loopet

                    (defrule
                        (true)
                        =>
                        (up-reset-search 1 1 0 0)
                        (up-reset-filters)
                        (up-find-local c: unpacked-trebuchet-class c: 200)
                        (up-find-local c: packed-trebuchet-class c: 200)
                        (up-remove-objects search-local object-data-target == building-class)
                        (up-remove-objects search-local object-data-target == tower-class)
                        (up-remove-objects search-local object-data-target == unpacked-trebuchet-class)
                        (up-remove-objects search-local object-data-target == packed-trebuchet-class)
                        (up-get-search-state gl-local-total)
                        (up-modify-goal gl-max-remote-index g:= gl-remote-total)
                        (up-modify-goal gl-max-remote-index c:- 1)
                        (up-modify-goal gl-max-local-index g:= gl-local-total)
                        (up-modify-goal gl-max-local-index c:- 1)
                    )

                ;Reset goals før loop

                    (defrule
                        (true)
                        =>
                        (set-goal gl-current-local-index 0)
                        (set-goal gl-local-loop-first-rule -1)
                        (set-goal gl-remote-loop-first-rule -1)
                    )


                ;Søg på alle local trebs og fjern de trebs der allerede har et target eller som har position-move inden for 11 tiles af fortification.

                    (defrule
                        (true)
                        =>
                        (up-get-rule-id gl-local-loop-first-rule)
                        (set-goal gl-best-found-score -99999)
                        (set-goal gl-best-found-target -1)
                        (set-goal gl-current-remote-index 0)
                        (up-reset-search 1 1 0 0)
                        (up-find-local c: unpacked-trebuchet-class c: 200)
                        (up-find-local c: packed-trebuchet-class c: 200)
                        (up-remove-objects search-local object-data-target == building-class)
                        (up-remove-objects search-local object-data-target == tower-class)
                        (up-remove-objects search-local object-data-target == unpacked-trebuchet-class)
                        (up-remove-objects search-local object-data-target == packed-trebuchet-class)
                    )

                ;Find relevant info about current treb

                    (defrule 
                        (up-set-target-object search-local g: gl-current-local-index)
                        =>
                        (up-get-point position-object gl-treb-x)
                        (up-get-point position-self gl-temp-x)
                        (up-get-point-distance gl-treb-x gl-temp-x gl-treb-distance-to-self)
                        (up-get-object-data object-data-move-x gl-temp-x)
                        (up-get-object-data object-data-move-y gl-temp-y)
                    )

                ;Restart loop if treb is on its way to fortification.

                    (defrule
                        (up-set-target-object search-local g: gl-current-local-index)
                        (up-point-distance gl-temp-x gl-fortification-x <= 11)
                        (up-point-distance gl-treb-x gl-fortification-x > 7)
                        (up-compare-goal gl-local-loop-first-rule != -1)
                        =>
                        ;(up-modify-goal gl-current-local-index c:+ 1)
                        ;(up-jump-direct g: gl-local-loop-first-rule)
                        (do-nothing)
                    )

                ;Hvis treb er på usikker grund sendes den mod fortification og loop restartes.
                    ;Loopet starter med at hver treb uden target gennemgår følgende evaluering: (move commands genstarter det store local loop)
                    ;-Hvis attack groups er 0 og treb er mere end 11 fra fortification sendes treb mod fortification
                    ;-Hvis attack groups er over nul og treb er tættere på position-self end fortification sendes treb mod fortification
                    ;-Hvis attack groups er 0 og treb er mindre end eller lig med 11 tiles fra fortification skal treb have nyt target
                    ;-Hvis attack groups er over nul og treb er længere fra position-self end fortification skal treb have nyt target
                    ;Overstående kan forenkles til at sige at trebs på usikker grund skal sendes til fortification og ellers skal have nyt target.

                    (defrule 
                        (up-set-target-object search-local g: gl-current-local-index)
                        (or(and(up-compare-sn sn-tsa > 0)
                        (and(up-compare-goal gl-treb-distance-to-self g:< gl-fortification-distance-to-self)
                        (up-point-distance gl-treb-x gl-fortification-x > 7)))
                        (and(up-compare-sn sn-tsa == 0)
                        (up-point-distance gl-treb-x gl-fortification-x > 11)))
                        (up-compare-goal gl-local-loop-first-rule != -1)
                        =>
                        (up-remove-objects search-local object-data-index g:!= gl-current-local-index)
                        (up-copy-point gl-temp-x gl-fortification-x)
                        (up-lerp-tiles gl-temp-x gl-enemy-x c: -5)
                        (up-target-point gl-temp-x action-move -1 -1)
                        (up-modify-goal gl-current-local-index c:+ 1)
                        (up-jump-direct g: gl-local-loop-first-rule)
                        (do-nothing)
                    )

                ;Find score for potentiel target

                    ;Hvis en treb skal have nyt target udregnes en score ud fra afstand til target fra treb, afstand til target fra fortification og 
                    ;bonus for bygninger hvor castles belønnes højest, derefter tc's, derefter towers. Der bør gives en ekstra bonus til targets der
                    ;er inden for 24 tiles af fortification.


                    (defrule
                        (up-set-target-object search-remote g: gl-current-remote-index)
                        =>
                        (up-get-rule-id gl-remote-loop-first-rule)
                        (set-goal gl-combined-score 0)
                        (up-get-point position-object gl-potential-target-x)
                        (up-get-point-distance gl-potential-target-x gl-fortification-x gl-fortification-distance-score)
                        (up-modify-goal gl-fortification-distance-score g:* gl-fortification-distance-modifier)
                        (up-get-point-distance gl-potential-target-x gl-treb-x gl-target-distance-score)
                        (up-modify-goal gl-target-distance-score g:* gl-treb-distance-modifier)
                    )

                    (defrule
                        (up-set-target-object search-remote g: gl-current-remote-index)
                        (up-point-distance gl-potential-target-x gl-fortification-x <= 24)
                        =>
                        (up-modify-goal gl-combined-score g:+ gl-fortification-range-bonus)
                    )

                    (defrule
                        (up-point-distance gl-potential-target-x gl-fortification-x <= 24)
                        (up-set-target-object search-remote g: gl-current-remote-index)
                        (or(up-object-data object-data-type == unpacked-trebuchet-class)
                        (up-object-data object-data-type == packed-trebuchet-class))
                        =>
                        (up-modify-goal gl-combined-score g:+ gl-treb-war-bonus)
                    )

                    (defrule
                        (up-set-target-object search-remote g: gl-current-remote-index)
                        (up-object-data object-data-type == castle)
                        =>
                        (up-modify-goal gl-combined-score g:+ gl-castle-bonus)
                    )

                    (defrule
                        (up-set-target-object search-remote g: gl-current-remote-index)
                        (up-object-data object-data-type == town-center)
                        =>
                        (up-modify-goal gl-combined-score g:+ gl-town-center-bonus)
                    )

                    (defrule
                        (up-set-target-object search-remote g: gl-current-remote-index)
                        (up-object-data object-data-type == watch-tower)
                        =>
                        (up-modify-goal gl-combined-score g:+ gl-tower-bonus)
                    )

                    (defrule
                        (up-set-target-object search-remote g: gl-current-remote-index)
                        =>
                        (up-modify-goal gl-combined-score g:- gl-fortification-distance-score)
                        (up-modify-goal gl-combined-score g:- gl-target-distance-score)
                    )

                ;Husk bygning og score hvis denne er den hidtil bedst fundne.

                    (defrule
                        (up-set-target-object search-remote g: gl-current-remote-index)
                        (up-compare-goal gl-combined-score g:> gl-best-found-score)
                        =>
                        (up-modify-goal gl-best-found-score g:= gl-combined-score)
                        (up-get-object-data object-data-id gl-best-found-target)            
                    )

                ;genstart lille loop der tjekker alle bygninger på remote list

                    (defrule
                        (up-set-target-object search-local g: gl-current-local-index)
                        (up-set-target-object search-remote g: gl-current-remote-index)
                        ;(up-compare-goal gl-current-remote-index g:< gl-max-remote-index) ;Er vel egentlig unødvendig?
                        (up-compare-goal gl-remote-loop-first-rule != -1)
                        =>
                        (up-modify-goal gl-current-remote-index c:+ 1)
                        (up-jump-direct g: gl-remote-loop-first-rule)
                    )

                ;give en attack command for den givne treb. (Local list må gerne rydes løbende.)

                    (defrule
                        (up-set-target-object search-local g: gl-current-local-index)
                        (up-set-target-by-id g: gl-best-found-target)
                        =>
                        (up-remove-objects search-local object-data-index g:!= gl-current-local-index)
                        ;(up-chat-data-to-all "attacking target with score %d" g: gl-best-found-score)
                        (up-target-objects 1 action-default -1 -1)
                    )

                ;genstart det store loop for local list.

                    (defrule
                        (up-compare-goal gl-current-local-index g:< gl-max-local-index)
                        (up-compare-goal gl-local-loop-first-rule != -1)
                        =>
                        (up-modify-goal gl-current-local-index c:+ 1)
                        (up-jump-direct g: gl-local-loop-first-rule)
                    )



                        ;

        ;
            (defrule
                ;(true)
                (true)
                =>
                (up-get-rule-id gl-post-new-army-rules-id)
                (up-get-precise-time 16 181)
                (up-modify-sn 430 g:= 181)
                ;(up-chat-data-to-all "Second loop-duration: %d" g: 181)
                )

                (defrule
                    (or(taunt-detected my-player-number 234)
                    (or(taunt-detected any-ally 234)
                    (taunt-detected any-enemy 234)))
                =>
                (up-chat-data-to-all "script loop-duration 28 is: %d." g: 181)
                ;(up-jump-direct g: gl-end-of-script-rule)
                ;(up-chat-data-to-all "gl-archer-micro-priority is %d" g: gl-archer-micro-priority)
                ;(up-chat-data-to-all "superiority goal is %d" g: 11)
                (do-nothing)
                ) 
        ; Start a timer while under attack

            (defrule
                (town-under-attack)
                =>
                (enable-timer under-attack-timer 10)
            )
        ; Scout micro vs military
                ;1 Der er en lang række conditions der skal være opfyldt først. Man skal være færdig med at scoute og have nok hp på
                ;scouten til det giver mening mm.
                ;2 Når overstående er opfyldt kan scouten være i et af to modes. Fighting mode eller retreating mode. Fighting mode
                ;er aktiv så længe der er enemy skirms og ikke er enemy spears. En tredje faktor er at hvis scouten er for langt
                ;fra ranged army skal det give mening at angribe ift modstanderens hærs størrelse og evt second scout.
                ;V 3 Når retreating mode er aktiv placeres scouten bag egen ranged army i 1-3 tiles i retning mod starting tc
                ;V 4 Når fighting mode er aktiv angriber scouten den nærmeste enemy skirm med et system der minder om prioriterings-
                ;systemet fra knight army. Det burde være ret simpelt da scouten ikke skal bruges nær enemy tc.
                ;(5 Som det sidste bør der måske være en form for prioritering af enemy spears når scouten er i brug)
                ;V 6 Der bør ikke ventes på enemy bliver feudal age i 3v3/4v4 da det ikke har inflydelse på strategi. 
                ;archers bør blive tæt på tc eller tower indtil der er mere support?
            ;debug
                (defrule
                    (taunt-detected my-player-number 79)
                    =>
                    (set-goal gl-scout-mode -1)
                    (acknowledge-taunt my-player-number 79)
                )

                (defrule
                    (taunt-detected my-player-number 81)
                    =>
                    (set-goal gl-scout-mode hide-behind-archers)
                    (acknowledge-taunt my-player-number 81)
                )

                (defrule
                    (taunt-detected my-player-number 82)
                    =>
                    (set-goal gl-scout-mode attack-skirms)
                    (acknowledge-taunt my-player-number 82)
                )
            ;Decide scout mode

                (defrule
                    (game-time < 1100)
                    (up-compare-goal gl-my-position == 4)
                    =>
                    (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                    (up-get-focus-fact allied-goal gl-ranged-army-x gl-ranged-army-x)
                    (up-get-focus-fact allied-goal gl-ranged-army-y gl-ranged-army-y)
                )

                (defrule
                    (game-time < 1100)
                    (up-compare-goal gl-my-position == 5)
                    =>
                    (up-modify-sn sn-focus-player-number c:= my-player-number)
                    (up-get-focus-fact allied-goal gl-ranged-army-x gl-ranged-army-x)
                    (up-get-focus-fact allied-goal gl-ranged-army-y gl-ranged-army-y)
                )

                (defrule
                    (up-set-target-by-id g: gl-scout-unit)
                    =>
                    (up-get-point position-object gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-copy-point gl-temp1-x gl-ranged-army-x)
                    (up-modify-goal gl-temp1-x c:/ 100)
                    (up-modify-goal gl-temp1-y c:/ 100)
                    (up-full-reset-search)
                    (set-strategic-number sn-focus-player-number 1)
                    (up-filter-distance c: -1 c: 20)
                )

                (defrule
                    (players-stance focus-player enemy)
                    =>
                    (up-find-remote c: militiaman-line c: 240)
                    (up-find-remote c: skirmisher-line c: 240)
                )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )

                (defrule
                    (true)
                    =>
                    (up-get-search-state gl-local-total)
                    (up-modify-goal gl-temp1 g:= gl-remote-total)
                )

                (defrule
                    (up-set-target-by-id g: gl-scout-unit)
                    =>
                    (up-get-point position-object gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-copy-point gl-temp1-x gl-ranged-army-x)
                    (up-modify-goal gl-temp1-x c:/ 100)
                    (up-modify-goal gl-temp1-y c:/ 100)
                    (up-full-reset-search)
                    (set-strategic-number sn-focus-player-number 1)
                    (up-filter-distance c: -1 c: 6)
                )

                (defrule
                    (players-stance focus-player enemy)
                    =>
                    (up-find-remote c: militiaman-line c: 240)
                )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )

                (defrule
                    (up-set-target-by-id g: gl-scout-unit)
                    =>
                    (up-get-point position-object gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-remove-objects search-remote object-data-target-id g:!= gl-scout-unit)
                    (up-remove-objects search-remote object-data-distance > 5)
                )

                (defrule
                    (up-set-target-by-id g: gl-scout-unit)
                    =>
                    (up-get-point position-object gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-copy-point gl-temp1-x gl-ranged-army-x)
                    (up-modify-goal gl-temp1-x c:/ 100)
                    (up-modify-goal gl-temp1-y c:/ 100)
                    (set-strategic-number sn-focus-player-number 1)
                    (up-filter-distance c: -1 c: 6)
                )

                (defrule
                    (players-stance focus-player enemy)
                    =>
                    (up-find-remote c: spearman-line c: 240)
                )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )

                (defrule
                    (true)
                    =>
                    (up-get-search-state gl-local-total)
                )



                (defrule
                    
                    (up-set-target-by-id g: gl-scout-unit)
                    (or(up-object-data object-data-hitpoints < 10)
                    (or(game-time >= 1100)
                    (or(players-unit-type-count target-player archer-line >= 4)
                    (or(and(players-unit-type-count target-player archer-line >= 2)
                    (players-unit-type-count target-player skirmisher-line >= 6))
                    (and(up-object-data object-data-hitpoints < 20)
                    (players-military-population target-player >= 14))))))
                    =>
                    (set-goal gl-scout-mode -2)
                    
                )
                
                (defrule
                (goal gl-scout-mode -2)
                =>
                    (up-full-reset-search)
                    (up-add-object-by-id search-local g: gl-scout-unit)
                    (up-get-point position-self gl-temp2-x)
                    (up-target-point gl-temp2-x action-default -1 -1)
                    (disable-self)
                )

                (defrule
                    (or(goal gl-scouting-stage 2)
                    (and(up-compare-goal gl-my-position == 5)
                    (and(up-compare-goal gl-flank != -1)
                    (and(up-compare-goal gl-number-of-players-on-enemy-team <= 2)
                    (up-timer-status scouting-enemy-base-timer == timer-triggered)))))
                    (up-compare-goal gl-scout-mode != -2)
                    (up-compare-goal gl-scout-mode != hide-behind-archers)
                    =>
                    (set-goal gl-scout-mode hide-behind-archers)
                    ;(chat-to-all "sending scout to archer army")
                )

                (defrule
                    (goal gl-scout-mode attack-skirms)
                    (game-time < 1100)
                    =>
                    (set-goal gl-scout-mode hide-behind-archers)
                )

                (defrule
                    (goal gl-scout-mode hide-behind-archers)
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-object-data object-data-hitpoints >= 10)
                    (up-compare-goal gl-remote-total == 0) ;spear
                    (up-compare-goal gl-temp1 > 0) ;skirm
                    (up-point-distance gl-temp-x gl-temp1-x <= 15) ;distance from scout to ranged army is less than
                    =>
                    (set-goal gl-scout-mode attack-skirms)
                )

                (defrule
                    (up-point-distance gl-temp-x gl-enemy-x < 12)
                    (game-time < 1100)
                    (goal gl-scout-mode attack-skirms)
                    =>
                    (set-goal gl-scout-mode hide-behind-archers)
                )

            ;hiding scout behind archers

                (defrule
                    (goal gl-scout-mode hide-behind-archers)
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-compare-goal gl-temp1 == 0)
                    =>
                    (up-full-reset-search)
                    (up-copy-point gl-temp-x gl-ranged-army-x)
                    (up-modify-goal gl-temp-x c:/ 100)
                    (up-modify-goal gl-temp-y c:/ 100)
                    (up-get-point position-self gl-temp1-x)
                    (up-lerp-tiles gl-temp-x gl-temp1-x c: 1)
                    (up-add-object-by-id search-local g: gl-scout-unit)
                    (set-goal gl-split-rule 2213)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp6-x -1)
                        (set-goal gl-temp6-y -1)
                    )

                    (defrule
                        (goal gl-split-rule 2213)
                        (up-compare-goal gl-enemy-x != -1)
                        =>
                        (up-get-point position-object gl-temp6-x)
                        (up-lerp-tiles gl-temp6-x gl-temp-x c: 5)
                    )

                    (defrule
                    (up-compare-goal gl-my-position == 4)
                    =>
                    (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                    )

                    (defrule
                        (up-compare-goal gl-my-position != 4)
                        =>
                        (up-modify-sn sn-focus-player-number c:= my-player-number)
                    )


                    (defrule
                        (players-unit-type-count focus-player archer-line == 0)
                        (players-unit-type-count focus-player skirmisher-line == 0)
                        (not(and(up-compare-goal gl-my-position != 4)
                        (or(unit-type-count archer-line > 0)
                        (unit-type-count skirmisher-line > 0))))
                        =>
                        (up-get-point position-self gl-temp-x)
                        ;(chat-to-all "flank has no archers")
                    )

                    (defrule
                        (goal gl-split-rule 2213)
                        (up-point-distance gl-temp6-x gl-enemy-x >= 8)
                        =>
                        (up-target-point gl-temp-x action-default -1 stance-no-attack)
                    )

                (defrule
                    (goal gl-scout-mode hide-behind-archers)
                    (up-set-target-by-id g: gl-scout-unit)
                    (up-compare-goal gl-temp1 > 0)
                    =>
                    (up-full-reset-search)
                    (up-get-point position-object gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-get-point position-self gl-temp1-x)
                    (up-lerp-tiles gl-temp-x gl-temp1-x c: 10)
                    (up-add-object-by-id search-local g: gl-scout-unit)
                    (set-goal gl-split-rule 2214)
                    )

                    (defrule
                        (true)
                        =>
                        (set-goal gl-temp6-x -1)
                        (set-goal gl-temp6-y -1)
                    )

                    (defrule
                        (goal gl-split-rule 2214)
                        (up-compare-goal gl-enemy-x != -1)
                        =>
                        (up-get-point position-object gl-temp6-x)
                        (up-lerp-tiles gl-temp6-x gl-temp-x c: 5)
                    )

                    (defrule
                    (up-compare-goal gl-my-position == 4)
                    =>
                    (up-modify-sn sn-focus-player-number g:= gl-closest-ally)
                    )

                    (defrule
                        (up-compare-goal gl-my-position != 4)
                        =>
                        (up-modify-sn sn-focus-player-number c:= my-player-number)
                    )


                    (defrule
                        (players-unit-type-count focus-player archer-line == 0)
                        (players-unit-type-count focus-player skirmisher-line == 0)
                        (not(and(up-compare-goal gl-my-position != 4)
                        (or(unit-type-count archer-line > 0)
                        (unit-type-count skirmisher-line > 0))))
                        =>
                        (up-get-point position-self gl-temp-x)
                        ;(chat-to-all "flank has no archers 2")
                    )

                    (defrule
                        (goal gl-split-rule 2214)
                        (up-point-distance gl-temp6-x gl-enemy-x >= 8)
                        =>
                        (up-target-point gl-temp-x action-default -1 stance-no-attack)
                    )

            ;attacking skirms with scout
                    (defrule ;clean ;distance
                    (true)
                    =>
                    (set-strategic-number sn-focus-player-number 1)
                )

                (defrule
                    (up-set-target-by-id g: gl-scout-unit)
                    =>
                    (up-get-object-data object-data-id gl-temp)
                    (up-get-point position-object gl-temp-x)
                    (up-set-target-point gl-temp-x)
                    (up-filter-distance c: -1 c: 15)
                )

                (defrule
                    (players-stance focus-player enemy)
                    =>
                    (up-find-remote c: militiaman-line c: 240)
                    (up-find-remote c: skirmisher-line c: 240)
                    (up-clean-search search-remote -1 search-order-asc)
                )

                (defrule
                    (up-compare-sn sn-focus-player-number < 8)
                    =>
                    (up-modify-sn sn-focus-player-number c:+ 1)
                    (up-jump-rule -2)
                )




                (defrule
                    (true)
                    =>
                    (up-clean-search search-remote object-data-distance search-order-asc)
                    (set-goal gl-temp3 -1)
                    (set-goal gl-temp4 -999)
                    (set-goal gl-temp5 -999)
