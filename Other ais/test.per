    ; Military production 
        ;setup
            ;finding maximum number of spears to train

                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
                    (up-find-remote c: stable c: 40)
                    (set-goal gl-temp -1)
                    (up-remove-objects search-remote object-data-garrison-count == 0)
                )

                (defrule
                    (up-set-target-object search-remote c: 0)
                    =>
                    (up-get-object-data object-data-garrison-count gl-temp)
                )

                (defrule
                (or(players-unit-type-count target-player scout-cavalry-line > 1)
                (or(players-unit-type-count target-player knight-line > 0)
                (or(players-unit-type-count target-player camel-line > 0)
                (or(players-building-type-count target-player stable > 1)
                (up-compare-goal gl-temp > 0)))))
                =>
                (up-get-player-fact target-player military-population 0 gl-temp1); 8
                (up-get-player-fact target-player unit-type-count-total archer-line gl-temp)
                (up-modify-goal gl-temp1 g:- gl-temp)
                (up-get-player-fact target-player unit-type-count-total skirmisher-line gl-temp)
                (up-modify-goal gl-temp1 g:- gl-temp)
                (up-get-player-fact target-player unit-type-count-total militiaman-line gl-temp)
                (up-modify-goal gl-temp1 g:- gl-temp)
                (up-get-player-fact target-player unit-type-count-total spearman-line gl-temp)
                (up-modify-goal gl-temp1 g:- gl-temp)
                (up-get-player-fact target-player unit-type-count-total eagle-warrior-line gl-temp)
                (up-modify-goal gl-temp1 g:- gl-temp)
                (up-get-fact military-population 0 gl-temp2); 20
                (up-modify-goal gl-temp2 g:* 50)
                (up-modify-goal gl-temp2 g:/ 100);10
                (set-goal gl-enemy-cavalry 1)
                (up-modify-goal gl-maximum-spears g:= gl-temp2)
                )

                (defrule
                    (goal gl-enemy-cavalry 1)
                    (up-compare-goal gl-temp2 g:> gl-temp1)
                    =>
                    (up-modify-goal gl-temp2 g:= gl-temp1)
                    (up-modify-goal gl-maximum-spears g:= gl-temp2)
                )
            ;Check if we should make barracks units
                (defrule
                    (true)
                    =>
                    (up-full-reset-search)
                    (up-find-local c: town-center c: 1)
                    (set-goal gl-temp2 200)
                    (set-goal gl-temp1 -1)
                )

                (defrule
                    (up-set-target-object search-local c: 0)
                    (up-object-data object-data-progress-type == 103) ;research
                    =>
                    (up-get-object-data object-data-progress-value gl-temp2)
                )

                (defrule ;reasons to train units
                    (or(up-research-status c: ri-man-at-arms >= research-pending) 
                    (unit-type-count-total militiaman-line < 3))

                    (or(unit-type-count-total military-population < 19) ;no need to save for castle age
                    (or(building-type-count-total market == 0)
                    (up-research-status c: castle-age >= research-pending)))

                    (or(food-amount > 450) ;no need to save for castle age upgrades
                    (or(up-compare-goal gl-temp2 <= 52)
                    (up-research-status c: castle-age != research-pending)))

                    (or(up-research-status c: castle-age >= research-pending)
                    (or(food-amount < 450)
                    (or(food-amount >= 860)
                    (building-type-count-total market < 1))))
                    =>
                    (set-goal gl-temp1 1)
                )
                
                (defrule ;dont train units while saving for upgrades
                    (or(research-available ri-man-at-arms)
                    (or(research-available ri-supplies)
                    (or(research-available ri-squires)
                    (or(research-available ri-long-swordsman)
                    (or(research-available ri-chain-mail)
                    (or(research-available ri-two-handed-swordsman)
                    (or(research-available ri-champion)
                    (or(research-available ri-plate-mail)
                    (and(research-available ri-pikeman)
                    (unit-type-count-total spearman-line > 0))))))))))
                    =>
                    (set-goal gl-temp1 -1)
                )

        ;train spearman-line
            (defrule
            (research-completed ri-arson)
            (goal gl-temp1 1)
            (unit-type-count-total spearman-line g:< gl-maximum-spears)
            (can-train spearman-line)
            =>
            (train spearman-line)
            )

            (defrule
            (goal gl-temp1 1)
            (unit-type-count-total spearman-line g:< gl-maximum-spears)
            (can-train spearman-line)
            =>
            (train spearman-line)
            (set-goal gl-temp1 -1) ;dont train multiple units at once while training spears
            )
        ;train militia-line
            (defrule
            (goal gl-temp1 1)
            (can-train militiaman-line)
            =>
            (train militiaman-line)
            )

            (defrule
            (research-completed ri-arson)
            (goal gl-temp1 1)
            (can-train militiaman-line)
            =>
            (train militiaman-line)
            )

        ;train rams
            (defrule
            (unit-type-count battering-ram-line < 4)
            (can-train battering-ram-line)
            (not(and(up-research-status c: imperial-age == research-available)
            (building-type-count-total monastery < 1)))
            =>
            (train battering-ram-line)
            )

        ;train monks
            (defrule
            (unit-type-count-total monk < 3)
            (can-train monk)
            (not(or(research-available ri-long-swordsman)
            (or(research-available ri-chain-mail)
            (or(research-available ri-two-handed-swordsman)
            (or(research-available ri-champion)
            (research-available ri-plate-mail))))))
            =>
            (train monk)
            )   

    ; Finding and targeting opponents 
        
        (defrule
        (game-time > 720)
        =>
        (up-find-player enemy find-closest CLOSEST-ENEMY)
        (up-modify-sn sn-target-player-number g:= CLOSEST-ENEMY)
        (disable-self)
        )
        
        (defrule
        (players-population target-player <= 15)
        (game-time > 720)
        =>
        (up-find-player enemy find-closest CLOSEST-ENEMY)
        (up-find-next-player enemy find-closest CLOSEST-ENEMY)
        (up-modify-sn sn-focus-player-number g:== CLOSEST-ENEMY)
        )
        
        (defrule
        (players-population target-player <= 15)
        (game-time > 720)
        (players-stance focus-player enemy)
        =>
        (up-modify-sn sn-target-player-number g:= CLOSEST-ENEMY)
        )
        
    ; Attacking and defending 
        
        (defrule
        (true)
        =>
        (set-goal MY-MILITARY 0)
        (set-goal ENEMY-MILITARY 0)
        (set-goal MILITARY-SUPERIORITY 0)
        (up-get-fact military-population 0 MY-MILITARY)
        (up-get-player-fact target-player military-population 0 ENEMY-MILITARY)
        (up-modify-goal MY-MILITARY g:- ENEMY-MILITARY)
        (up-modify-goal MILITARY-SUPERIORITY g:= MY-MILITARY)
        )

        (defrule
            (current-age < castle-age)
            (players-current-age target-player >= castle-age)
            (players-military-population target-player > 1)
            =>
            (up-modify-goal MILITARY-SUPERIORITY c:/ 5)
        )

        (defrule
            (up-research-status c: castle-age >= research-pending)
            (or(up-research-status c: ri-long-swordsman < research-complete)
            (up-research-status c: ri-chain-mail < research-complete))
            =>
            (up-modify-goal MILITARY-SUPERIORITY c:/ 2)
        )

        (defrule
            (up-research-status c: imperial-age >= research-pending)
            (or(up-research-status c: ri-champion < research-complete)
            (up-research-status c: ri-plate-mail < research-complete))
            =>
            (up-modify-goal MILITARY-SUPERIORITY c:/ 2)
        )

        (defrule
            (players-current-age target-player < castle-age)
            (research-completed ri-long-swordsman)
            (research-completed ri-chain-mail)
            =>
            (up-modify-goal MILITARY-SUPERIORITY c:* 2)
        )

        (defrule
            (players-current-age target-player < imperial-age)
            (research-completed ri-champion)
            (research-completed ri-plate-mail)
            =>
            (up-modify-goal MILITARY-SUPERIORITY c:* 2)
        )

        (defrule
            (military-population > 5)
            (players-military-population target-player <= 1)
            =>
            (up-modify-goal MILITARY-SUPERIORITY c:+ 15)
        )
        
        (defrule
            (taunt-detected my-player-number 1)
            =>
            (up-modify-goal MILITARY-SUPERIORITY c:+ 15)
        )

        (defrule
            (taunt-detected my-player-number 2)
            =>
            (up-modify-goal MILITARY-SUPERIORITY c:- 15)
        )


        (defrule
        (or(up-compare-goal MILITARY-SUPERIORITY > 18)
        (population > 180))
        =>
        (set-strategic-number sn-number-attack-groups 200)
        (up-set-attack-stance militiaman-line c: stance-aggressive)
        (up-set-attack-stance spearman-line c: stance-aggressive)
        (up-set-attack-stance battering-ram-line c: stance-aggressive)
        )
        
        (defrule
        (up-compare-goal MILITARY-SUPERIORITY < 10)
        (population <= 170)
        =>
        (set-strategic-number sn-number-attack-groups 0)
        )

        (defrule
        (strategic-number sn-number-attack-groups == 0)
        (not(town-under-attack))
        (not(enemy-buildings-in-town))
        (up-timer-status 2 != timer-running)
        (up-timer-status 2 != timer-triggered)
        =>
        (enable-timer 2 40)
        )

        

        (defrule
        (strategic-number sn-number-attack-groups == 0)
        (or(town-under-attack)
        (enemy-buildings-in-town))
            =>
            (disable-timer 2)
            (up-set-attack-stance militiaman-line c: stance-aggressive)
            (up-set-attack-stance spearman-line c: stance-aggressive)
            (up-set-attack-stance battering-ram-line c: stance-aggressive)
        )

        (defrule
            (strategic-number sn-number-attack-groups == 0)
            (not(town-under-attack))
            (not(enemy-buildings-in-town))
            (timer-triggered 2)
            =>
            (up-full-reset-search)
        (up-filter-include cmdid-military -1 -1 -1)
        (up-find-local c: all-units-class c: 240)
        (up-remove-objects search-local object-data-class == 947) ;scout
        (up-target-point gl-position-self-x action-default -1 stance-no-attack)
        )

    ; Tc avoidance
        (defrule
        (true)
        =>
        (set-strategic-number sn-focus-player-number 1)
        (up-full-reset-search)
        )

        (defrule
        (players-stance focus-player enemy)
        =>
        (up-find-remote c: town-center c: 40)
        )

        (defrule
        (up-compare-sn sn-focus-player-number < 8)
        =>
        (up-modify-sn sn-focus-player-number c:+ 1)
        (up-jump-rule -2)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            =>
            (up-get-point position-object gl-temp1-x)
            (up-set-target-point gl-temp1-x)
        )

        (defrule
            (true)
            =>
            (set-goal gl-temp1 0)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            =>
            (up-reset-search 1 1 0 0)
            (up-filter-distance c: -1 c: 17)
            (up-find-local c: militiaman-line c: 200)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-temp2 g:= gl-local-total)
            (up-reset-search 1 1 0 0)
            (up-find-local c: battering-ram-line c: 200)
            (up-get-search-state gl-local-total)
            (up-modify-goal gl-local-total g:* 100)
            (up-modify-goal gl-temp2 g:+ gl-local-total)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            =>
            (up-reset-search 1 1 0 0)
            (up-filter-distance c: -1 c: 9)
            (up-find-local c: scout-cavalry-line c: 200)
            (up-find-local c: militiaman-line c: 200)
            (up-find-local c: spearman-line c: 200)
            (up-get-search-state gl-local-total)
            (up-remove-objects search-local object-data-index g:!= gl-temp1)
        )

        (defrule
            (research-completed ri-chain-mail)
            =>
            (up-modify-goal gl-temp2 c:* 3)
        )

        (defrule
            (research-completed ri-two-handed-swordsman)
            =>
            (up-modify-goal gl-temp2 c:* 4)
        )

        (defrule
            (research-completed ri-champion)
            =>
            (up-modify-goal gl-temp2 c:* 999)
        )
        
        (defrule
            (up-set-target-object search-remote c: 0)
            (up-set-target-object search-local c: 0)
            (up-compare-goal gl-temp2 <= 20)
            =>
            (up-get-point position-object gl-temp2-x)
            (up-lerp-tiles gl-temp2-x gl-temp1-x c: -10)
            (up-bound-point gl-temp2-x gl-temp2-x)
            (up-target-point gl-temp2-x action-move -1 -1)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            (up-compare-goal gl-temp1 g:< gl-local-total)
            =>
            (up-modify-goal gl-temp1 c:+ 1)
            (up-jump-rule -7)
        )

        (defrule
            (up-set-target-object search-remote c: 1)
            =>
            (up-remove-objects search-remote object-data-index == 0)
            (up-jump-rule -10)
        )



    


    ; Lag test
        (defrule
        (taunt-detected my-player-number 103)
        =>
        (up-modify-goal gl-temp g:= gl-script-time__#051)
        (up-get-precise-time gl-script-start-time__#051 gl-script-time__#051)
        (up-modify-goal gl-temp g:- gl-script-time__#051)
        (up-modify-goal gl-temp1 g:neg gl-temp)
        (up-modify-goal gl-temp g:max gl-temp1)
        (up-chat-data-to-all "Panda tuto: %d ms" g: gl-script-time__#051)
        )
    #end-if
