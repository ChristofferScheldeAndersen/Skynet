; Panda Tutorial ai
    #load-if-defined MALIAN-CIV
    ; Goals and constants 

        #load-if-not-defined DE-AVAILABLE

                (defconst sn-enable-research-queue 0)
                (defconst ri-arson 0)
                (defconst ri-supplies 0)
                (defconst my-second-unique-research 0)
                #end-if

        ;goals
        (defconst CLOSEST-ENEMY 1)
        (defconst MY-MILITARY 2)
        (defconst ENEMY-MILITARY 3)
        (defconst MILITARY-SUPERIORITY 4)
        
        (defconst gl-drop-off-food-time-reached 308)
        (defconst gl-split-rule 315)
        (defconst gl-enemy-cavalry 316)
        (defconst gl-maximum-spears 317)
        ;constants
        (defconst Defensiveness 15)

        
        
    ; sn's

        (defrule
            (true)
            =>
            (set-strategic-number sn-enable-training-queue 1)
            (set-strategic-number sn-enable-research-queue 1)
        )
    ; Advancing 
        
        (defrule
        (unit-type-count villager >= 22)
        =>
        (research feudal-age)
        (research castle-age)
        (research imperial-age)
        )

    ; Economy 
        
        (defrule
            (building-type-count-total farm >= 15)
            (research-available ri-wheel-barrow)
            (or(building-type-count-total market == 0)
            (current-age >= castle-age))
            =>
            (research ri-wheel-barrow)
        )

        (defrule
            (building-type-count-total farm >= 30)
            (research-available ri-hand-cart)
            =>
            (research ri-hand-cart)
        )

        (defrule
            (true)
            =>
            (set-goal gl-split-rule -1)
        )

        (defrule
        (unit-type-count-total villager < 130)
        (or(up-pending-objects c: villager == 0)
        (or(not(research-available feudal-age))
        (unit-type-count-total villager < 25)))
        
        (or(up-pending-objects c: villager == 0)
        (building-type-count-total market == 0))
        =>
        (set-goal gl-split-rule 1)
        )

        (defrule
            (unit-type-count-total villager >= 26)
            =>
        (research ri-loom)
        )

        (defrule
            (goal gl-split-rule 1)
            (or(up-pending-objects c: villager == 0)
        (or(not(research-available imperial-age))
        (and(building-type-count monastery == 0)
        (food-amount > 700))))
        (up-pending-objects c: villager <= 1)
        =>
        (train villager)
        )

        

        (defrule
        (true)
        =>
        (set-strategic-number sn-food-gatherer-percentage 100)
        (set-strategic-number sn-wood-gatherer-percentage 0)
        (set-strategic-number sn-gold-gatherer-percentage 0)
        (set-strategic-number sn-stone-gatherer-percentage 0)
        )

        (defrule
        (current-age == dark-age)
        (unit-type-count villager >= 8)
        =>
        (set-strategic-number sn-food-gatherer-percentage 65)
        (set-strategic-number sn-wood-gatherer-percentage 35)
        (set-strategic-number sn-gold-gatherer-percentage 0)
        (set-strategic-number sn-stone-gatherer-percentage 0)
        )

        (defrule
        (or(up-research-status c: feudal-age >= research-pending)
        (unit-type-count villager >= 25))
        =>
        (set-strategic-number sn-food-gatherer-percentage 50)
        (set-strategic-number sn-wood-gatherer-percentage 35)
        (set-strategic-number sn-gold-gatherer-percentage 15)
        (set-strategic-number sn-stone-gatherer-percentage 0)
        )

        (defrule
        (current-age == feudal-age)
        (building-type-count-total blacksmith > 0)
        =>
        (set-strategic-number sn-food-gatherer-percentage 60)
        (set-strategic-number sn-wood-gatherer-percentage 27)
        (set-strategic-number sn-gold-gatherer-percentage 13)
        (set-strategic-number sn-stone-gatherer-percentage 0)
        )
        
        (defrule
        (current-age == castle-age)
        =>
        (set-strategic-number sn-food-gatherer-percentage 55)
        (set-strategic-number sn-wood-gatherer-percentage 27)
        (set-strategic-number sn-gold-gatherer-percentage 18)
        (set-strategic-number sn-stone-gatherer-percentage 0)
        )

        (defrule
        (current-age == castle-age)
        (unit-type-count-total battering-ram-line > 2)
        =>
        (set-strategic-number sn-food-gatherer-percentage 60)
        (set-strategic-number sn-wood-gatherer-percentage 22)
        (set-strategic-number sn-gold-gatherer-percentage 18)
        (set-strategic-number sn-stone-gatherer-percentage 0)
        )
        
        (defrule
        (current-age == imperial-age)
        =>
        (set-strategic-number sn-food-gatherer-percentage 57)
        (set-strategic-number sn-wood-gatherer-percentage 25)
        (set-strategic-number sn-gold-gatherer-percentage 18)
        (set-strategic-number sn-stone-gatherer-percentage 0)
        )

        (defrule
            (unit-type-count-total spearman-line > 0)
            =>
            (up-modify-sn sn-gold-gatherer-percentage c:- 5)
            (up-modify-sn sn-wood-gatherer-percentage c:+ 5)
        )
    ; Larger buildings 
        
        #load-if-not-defined UP-POCKET-POSITION
        (defrule
        (players-current-age target-player > dark-age)
        (game-time < 780)
        (can-afford-building watch-tower)
        (building-available watch-tower)
        (goal gl-build -1)
        (up-compare-goal gl-enemy-flank-x != -1)
        =>
        (set-goal gl-build watch-tower)
        )
        #end-if

        (defrule
        (building-type-count-total town-center < 3)
        (can-afford-building town-center-foundation)
        (building-available town-center)
        (goal gl-build -1)
        =>
        (set-goal gl-build town-center)
        ;(chat-to-all "trying to build town center")
        )

        (defrule
        (building-type-count-total mining-camp > 0)
        (or(building-type-count-total barracks < 1)
        (or(and(building-type-count-total barracks < 2)
        (up-research-status c: castle-age >= research-pending))
        (and(building-type-count-total barracks < 10)
        (up-research-status c: imperial-age >= research-pending))))
        (can-afford-building barracks)
        (building-available barracks)
        (goal gl-build -1)
        =>
        (set-goal gl-build barracks)
        )
        
        (defrule
        (building-type-count-total barracks > 0)
        (building-type-count-total blacksmith < 1)
        (can-afford-building barracks)
        (building-available barracks)
        (goal gl-build -1)
        =>
        (set-goal gl-build blacksmith)
        )
        
        (defrule
        (building-type-count-total blacksmith > 0)
        (building-type-count-total market < 1)
        (can-afford-building market)
        (building-available market)
        (goal gl-build -1)
        =>
        (set-goal gl-build market)
        )
        
        (defrule
        (building-type-count-total siege-workshop < 1)
        (can-afford-building siege-workshop)
        (building-available siege-workshop)
        (goal gl-build -1)
        =>
        (set-goal gl-build siege-workshop)
        )
        
        (defrule
        (building-type-count-total monastery < 1)
        (can-afford-building monastery)
        (building-available monastery)
        (goal gl-build -1)
        =>
        (set-goal gl-build monastery)
        )

    ; Dropsides and farms 
        
        (defrule
        (building-type-count-total house > 0) 
        (building-type-count-total mill < 1)
        (resource-found food)
        (can-afford-building mill)
        (building-available mill)
        (goal gl-build -1)
        (game-time > 150)
        =>
        (set-strategic-number sn-allow-adjacent-dropsites 0)
        (set-goal gl-build Berry-mill)
        )

        (defrule
        (building-type-count-total mill < 2)
        (building-type-count-total farm > 22)
        (can-afford-building mill)
        (building-available mill)
        (goal gl-build -1)
        =>
        (set-strategic-number sn-allow-adjacent-dropsites 0)
        (set-goal gl-build Farming-mill)
        )

        (defrule
        (building-type-count-total mill < 3)
        (building-type-count-total farm > 30)
        (can-afford-building mill)
        (building-available mill)
        (goal gl-build -1)
        =>
        (set-strategic-number sn-allow-adjacent-dropsites 0)
        (set-goal gl-build Farming-mill)
        )
        
        (defrule
        (building-type-count-total mill > 0)
        (resource-found wood)
        (or(building-type-count-total lumber-camp < 1)
        (and(building-type-count-total lumber-camp < 2)
        (building-type-count-total barracks > 0)))
        (can-afford-building lumber-camp)
        (building-available lumber-camp)
        (goal gl-build -1)
        =>
        (set-strategic-number sn-lumber-camp-max-distance 25)
        (set-strategic-number sn-allow-adjacent-dropsites 1)
        (set-goal gl-build lumber-camp)
        )

        (defrule
        (building-type-count-total mill > 0)
        (resource-found wood)
        (building-type-count-total lumber-camp < 3)
        (can-afford-building lumber-camp)
        (building-available lumber-camp)
        (goal gl-build -1)
        (building-type-count-total market > 0)
        (building-type-count-total farm > 18)
        =>
        (set-strategic-number sn-allow-adjacent-dropsites 1)
        (set-goal gl-build lumber-camp)
        )
        
        (defrule
        (resource-found gold)
        (building-type-count-total farm >= 4)
        (or(building-type-count-total mining-camp < 1)
        (and(up-research-status c: imperial-age >= research-pending)
        (building-type-count-total mining-camp < 5)))
        (can-afford-building mining-camp)
        (building-available mining-camp)
        (goal gl-build -1)
        =>
        (set-strategic-number sn-allow-adjacent-dropsites 0)
        (set-goal gl-build Gold-mining-camp)
        )

        (defrule
            (true)
            =>
            (set-goal gl-temp 0)
            (set-goal gl-temp1 -1)
        )
        
        (defrule
        (building-type-count-total market < 1)
        (building-type-count-total blacksmith > 0)
        (or(food-amount > 350)
        (building-type-count-total farm >= 16))
            =>
            (set-goal gl-temp 1)
        )

        (defrule
        (building-type-count-total siege-workshop < 1)
        (building-type-count-total monastery > 0)
        (food-amount > 500)
            =>
            (set-goal gl-temp 1)
        )

        (defrule
        (building-type-count-total blacksmith < 1)
        (building-type-count-total farm > 10)
            =>
            (set-goal gl-temp 1)
        )

        (defrule
        (building-type-count-total barracks < 1)
        (building-type-count-total farm >= 4)
            =>
            (set-goal gl-temp 1)
        )

        (defrule
        (building-type-count-total barracks < 6)
        (up-research-status c: imperial-age >= research-pending)
        (building-type-count-total farm > 20)
            =>
            (set-goal gl-temp 1)
        )

        (defrule
        (building-type-count-total barracks < 2)
        (up-research-status c: castle-age >= research-pending)
            =>
            (set-goal gl-temp 1)
        )

        (defrule
        (building-type-count-total barracks < 2)
        (up-research-status c: castle-age >= research-pending)
            =>
            (set-goal gl-temp 1)
        )

        (defrule
            (or(building-type-count-total monastery < 1)
            (building-type-count-total siege-workshop < 1))
            (food-amount > 450)
            =>
            (set-goal gl-temp 1)
        )

        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-find-remote c: prey-animal-class c: 40)
            (up-remove-objects search-remote object-data-hitpoints == 0)
            (up-remove-objects search-remote object-data-carry > 100)
        )

        (defrule
            (up-set-target-object search-remote c: 0)
            =>
            (set-goal gl-temp1 1)
        )

        (defrule
            (true)
            =>
            (up-full-reset-search)
            (up-set-target-point gl-position-self-x)
            (up-set-group search-remote c: scouted-animal-group)
            (up-remove-objects search-remote object-data-carry > 100)
            (up-remove-objects search-remote object-data-distance > 25)
            (up-get-search-state gl-local-total)
        )

        (defrule
        (up-compare-goal gl-remote-total >= 5)
        (building-type-count-total lumber-camp > 0)
        (building-type-count-total mill < 2)
        (idle-farm-count < 5)
        (can-afford-building mill)
        (building-available mill)
        (goal gl-build -1)
        (goal gl-temp 0)
        (goal gl-temp1 1)
        (up-pending-objects c: mill == 0)
        =>
        (set-goal gl-build Chicken-mill)
        )

        (defrule
        (building-type-count-total lumber-camp > 0)
        (idle-farm-count < 5)
        (can-afford-building farm)
        (building-available farm)
        (goal gl-build -1)
        (goal gl-temp 0)
        (or(wood-amount >= 100)
        (game-time > 600))
        =>
        (set-goal gl-build farm)
        (do-nothing)
        )


    ; Houses 
      
        
        (defrule
        (population < 20)
        (housing-headroom < 3)
        (population-headroom > 3)
        (can-afford-building house)
        (building-available house)
        (goal gl-build -1)
        (up-pending-objects c: house < 1)
        =>
        (set-goal gl-build house)
        )

        (defrule
        (population >= 20)
        (population < 60)
        (housing-headroom < 20)
        (population-headroom > 3)
        (can-afford-building house)
        (building-available house)
        (goal gl-build -1)
        (up-pending-objects c: house < 1)
        =>
        (set-goal gl-build house)
        )

        (defrule
        (population >= 60)
        (housing-headroom < 30)
        (population-headroom > 3)
        (can-afford-building house)
        (building-available house)
        (goal gl-build -1)
        (up-pending-objects c: house < 2)
        =>
        (set-goal gl-build house)
        )

        
    ; Force drop

        (defrule
                        (true)
                        =>
                        (up-full-reset-search)
                        (up-find-local c: town-center c: 1)
                        (set-goal gl-temp 0)
                        (set-goal gl-drop-off-food-time-reached 0)
                    )

                    (defrule
                        (up-set-target-object search-local c: 0)
                        (or(up-object-data object-data-progress-type == 102) ;vill
                        (up-object-data object-data-progress-type == 103)) ;research
                        =>
                        (up-get-object-data object-data-progress-value gl-temp)
                    )

                    (defrule
                        (or(and(up-compare-goal gl-temp >= 72) ; 7 sekunder til creation
                        (up-pending-objects c: villager == 1))
                        (up-pending-objects c: villager == 0))
                        =>
                        (set-goal gl-drop-off-food-time-reached 1)
                    )

                    (defrule
                        (or(and(up-compare-goal gl-temp >= 32) ; 7 sekunder til creation
                        (up-pending-objects c: villager == 1))
                        (up-pending-objects c: villager == 0))
                        (current-age == feudal-age)
                        =>
                        (set-goal gl-drop-off-food-time-reached 1)
                    )

                    (defrule
                        (up-pending-objects c: villager == 2)
                        =>
                        (set-goal gl-drop-off-food-time-reached 0)
                    )
        
                    (defrule
                        (up-compare-goal gl-drop-off-food-time-reached == 1)
                        (current-age == dark-age)
                        (unit-type-count-total villager <= 22)
                        (food-amount < 50)
                        =>
                        (up-drop-resources food c: 3)
                    )

                    (defrule
                        (up-pending-objects c: villager == 0)
                        (current-age == dark-age)
                        (unit-type-count-total villager <= 22)
                        (food-amount < 50)
                        (food-amount > 40)
                        =>
                        (up-drop-resources food c: 1)
                    )



                    (defconst gl-temp1 200)
                    (defconst gl-temp7 201)
                    (defconst gl-villager-food 202)
                    (defconst gl-loop-counter 203)


                    (defrule
                                (true)
                                =>
                                (set-goal gl-temp7 0)
                            )

                            (defrule
                                (true)
                                =>
                                (up-get-fact resource-amount amount-food gl-temp1)
                                (set-goal gl-loop-counter 0)
                                (up-full-reset-search)
                                (up-find-local c: villager-class c: 50)
                                (up-remove-objects search-local object-data-resource == wood)
                                (up-remove-objects search-local object-data-resource == stone)
                                (up-remove-objects search-local object-data-resource == gold)
                                (up-remove-objects search-local object-data-carry <= 0)
                                (up-get-search-state gl-local-total)
                            )

                            (defrule
                                (up-set-target-object search-local c: 0)
                                =>
                                (up-get-object-data object-data-carry gl-villager-food)
                                (up-modify-goal gl-temp7 g:+ gl-villager-food)
                                (up-remove-objects search-local object-data-index == 0)
                                (up-get-search-state gl-local-total)
                            )

                            (defrule
                                (up-compare-goal gl-local-total > 0)
                                (up-compare-goal gl-loop-counter < 50)
                                =>
                                (up-modify-goal gl-loop-counter c:+ 1)
                                (up-jump-rule -2)
                            )

                        (defrule
                            (true)
                            =>
                            (up-get-fact food-amount 0 gl-temp1)
                            (up-modify-goal gl-temp7 g:+ gl-temp1)
                            ;(up-chat-data-to-all "food incl food carried by villagers is %d." g: gl-temp7)
                        )
                        
                        (defrule
                        (up-compare-goal gl-drop-off-food-time-reached == 1)
                        (current-age == dark-age)
                        (unit-type-count-total villager >= 27)
                        (research-available feudal-age)
                        (up-compare-goal gl-temp7 >= 500)
                        (food-amount < 500)
                        =>
                        (up-drop-resources food c: 1) ;A relatively low amount is good here to ensure you get every last bit to ensure you have enough
                        ;(chat-to-all "force drop rule 6 running (food for castle age)")
                        )

                        (defrule
                        (up-compare-goal gl-drop-off-food-time-reached == 1)
                        (current-age == feudal-age)
                        (building-type-count market > 0)
                        (up-pending-objects c: villager < 2)
                        (research-available castle-age)
                        (up-compare-goal gl-temp7 >= 800)
                        (food-amount < 800)
                        (gold-amount >= 200)
                        =>
                        (up-drop-resources food c: 1) ;A relatively low amount is good here to ensure you get every last bit to ensure you have enough
                        ;(chat-to-all "force drop rule 6 running (food for castle age)")
                        )

                        (defrule
                        (up-compare-goal gl-drop-off-food-time-reached == 1)
                        (current-age == castle-age)
                        (building-type-count monastery > 0)
                        (up-pending-objects c: villager < 2)
                        (research-available imperial-age)
                        (up-compare-goal gl-temp7 >= 1000)
                        (food-amount < 1000)
                        (gold-amount >= 800)
                        =>
                        (up-drop-resources food c: 1) ;A relatively low amount is good here to ensure you get every last bit to ensure you have enough
                        ;(chat-to-all "force drop rule 6 running (food for castle age)")
                        )

    ; Market
        (defrule
            (can-sell-commodity stone)
            =>
            (sell-commodity stone)
        )
        
        (defrule
            (or(research-available ri-supplies)
            (or(research-available ri-long-swordsman)
            (or(research-available ri-chain-mail)
            (or(research-available ri-plate-mail)
            (research-available ri-two-handed-swordsman)))))
            (gold-amount < 100)
            (food-amount >= 300)
            (can-sell-commodity food)
            =>
            (sell-commodity food)
        )

        (defrule
            (research-available ri-champion)
            (gold-amount < 350)
            (food-amount >= 850)
            (can-sell-commodity food)
            =>
            (sell-commodity food)
        )
        
        (defrule
            (up-research-status c: castle-age < research-pending)
            (gold-amount < 200)
            (food-amount >= 800)
            (wood-amount >= 100)
            (building-type-count-total market > 0)
            =>
            (sell-commodity wood)
        )

        (defrule
            (up-research-status c: castle-age < research-pending)
            (gold-amount < 200)
            (food-amount >= 900)
            =>
            (sell-commodity food)
        )

        (defrule
            (up-research-status c: castle-age < research-pending)
            (wood-amount >= 100)
            (gold-amount < 350)
            (food-amount > 500)
            (food-amount < 800)
            (building-type-count-total market > 0)
            =>
            (sell-commodity wood)
        )

        (defrule
            (up-research-status c: castle-age < research-pending)
            (gold-amount >= 350)
            (food-amount < 800)
            (building-type-count-total market > 0)
            =>
            (buy-commodity food)
        )

        (defrule
            (up-research-status c: imperial-age < research-pending)
            (gold-amount < 800)
            (food-amount >= 1000)
            (wood-amount >= 100)
            (building-type-count-total siege-workshop > 0)
            (building-type-count-total monastery > 0)
            =>
            (sell-commodity wood)
        )

        (defrule
            (up-research-status c: imperial-age < research-pending)
            (gold-amount < 800)
            (food-amount >= 1100)
            (building-type-count-total siege-workshop > 0)
            (building-type-count-total monastery > 0)
            =>
            (sell-commodity food)
        )

        (defrule
            (up-research-status c: imperial-age < research-pending)
            (wood-amount >= 100)
            (gold-amount < 950)
            (food-amount > 700)
            (food-amount < 1000)
            (building-type-count-total market > 0)
            =>
            (sell-commodity wood)
        )

        (defrule
            (up-research-status c: imperial-age < research-pending)
            (gold-amount >= 950)
            (food-amount < 1000)
            (building-type-count-total market > 0)
            =>
            (buy-commodity food)
        )
