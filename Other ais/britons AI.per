	(set-difficulty-parameter ability-to-maintain-distance 100)
	(set-difficulty-parameter ability-to-dodge-missiles 0)

	(up-setup-cost-data 1 gl-amount-saving-food)
	(set-goal gl-log-clarity-progression 0)
	(set-goal gl-global-range-modifier 0)
	(set-goal gl-enemy-wall-count-tracker 0)
	(set-goal gl-enemy-gate-count-tracker 0)
