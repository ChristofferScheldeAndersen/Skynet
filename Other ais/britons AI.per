(defconst gl-tempgoal-distance-to-reference-point gl-temp1id)
(defconst gl-tempgoal-distance-to-home gl-temp2id)
(defconst gl-tempgoal-overall-best-distance-from-edge gl-temp3id)
(defconst gl-tempgoal-current-point-best-distance-from-edge gl-temp4id)
(defconst gl-tempgoal-small-loop-counter gl-temp5id)
(defconst gl-tempgoal-current-point-current-distance-from-edge gl-temp6id)
(defconst gl-tempgoal-current-checking-edge gl-temp7id)
	(defconst minimum-x-edge 0)
	(defconst minimum-y-edge 1)
	(defconst maximum-x-edge 2)
	(defconst maximum-y-edge 3)
(defconst gl-tempgoal-current-best-distance-edge-specifier gl-temp8id)
(defconst gl-tempgoal-current-best-distance-from-edge gl-temp9id)
(defconst gl-tempgoal-overall-best-edge-specifier gl-temp10id)
(defconst gl-tempgoal-overall-best-distance-from-edge gl-temp11id)

(defrule
	(true)
=>
	(set-goal gl-x-looper firstforestpointxindex)	;predefined start of forest point goal defconsts
	(set-goal gl-y-looper firstforestpointyindex)
	
	(set-goal gl-tempgoal-distance-to-reference-point -1)
	(set-goal gl-tempgoal-distance-to-home -1)
	(set-goal gl-tempgoal-overall-best-distance-from-edge 100)
	
	
	(up-copy-point point1-x home-x)
	(up-cross-tiles point1-x center-x c: 15)
	(up-lerp-tiles point1-x center-x c: -5)
	(up-bound-point point1-x point1-x)
	;(up-send-flare point1-x)
	
)

;overall loop upjump target
(defrule
	(true)
=>
	(up-get-indirect-goal g: gl-x-looper current-loop-point-x) ;get the value of the forestpoints indirectly using gl-x-looper
	(up-get-indirect-goal g: gl-y-looper current-loop-point-y)	
	(up-get-point-distance current-loop-point-x point1-x gl-tempgoal-distance-to-reference-point)
	(up-get-point-distance current-loop-point-x home-x gl-tempgoal-distance-to-home)
	
	(set-goal gl-tempgoal-current-point-best-distance-from-edge 100)
	(set-goal gl-tempgoal-small-loop-counter 0)
)

;check the point
;figure out if this point is closer to any edge than the current best
;store the point if it is, and which edge its closest to

(defrule
	(up-compare-goal gl-tempgoal-distance-to-reference-point g:> gl-tempgoal-distance-to-home)	;on the wrong side of the tc
=>
	;;(chat-to-all "jump")
	(up-jump-rule 7)
)

;small upjump target
(defrule
	(false)
	(goal gl-tempgoal-small-loop-counter 0)
=>
	(up-modify-goal gl-tempgoal-current-point-current-distance-from-edge g:= current-loop-point-x)
	(set-goal gl-tempgoal-current-checking-edge minimum-x-edge)
)

(defrule
	(false)
	(goal gl-tempgoal-small-loop-counter 1)
=>
	(up-modify-goal gl-tempgoal-current-point-current-distance-from-edge g:= current-loop-point-y)
	(set-goal gl-tempgoal-current-checking-edge minimum-y-edge)
)

(defrule
	(false)
	(goal gl-tempgoal-small-loop-counter 2)
=>
	(up-modify-goal gl-tempgoal-current-point-current-distance-from-edge g:= gl-max-coordinate-value)
	(up-modify-goal gl-tempgoal-current-point-current-distance-from-edge g:- current-loop-point-x)
	(set-goal gl-tempgoal-current-checking-edge maximum-x-edge)
)

(defrule
	(false)
	(goal gl-tempgoal-small-loop-counter 3)
=>
	(up-modify-goal gl-tempgoal-current-point-current-distance-from-edge g:= gl-max-coordinate-value)
	(up-modify-goal gl-tempgoal-current-point-current-distance-from-edge g:- current-loop-point-y)
	(set-goal gl-tempgoal-current-checking-edge maximum-y-edge)
)

(defrule
	(false)
	(up-compare-goal gl-tempgoal-current-point-current-distance-from-edge g:< gl-tempgoal-current-best-distance-from-edge)
=>
	(up-modify-goal gl-tempgoal-current-best-distance-from-edge g:= gl-tempgoal-current-point-current-distance-from-edge)
	(up-modify-goal gl-tempgoal-current-best-distance-edge-specifier g:= gl-tempgoal-current-checking-edge)
)

(defrule
	(false)
	(up-compare-goal gl-tempgoal-small-loop-counter < 3)
=>
	(up-modify-goal gl-tempgoal-small-loop-counter c:+ 1)
	(up-jump-rule -6)
)

(defrule
	(false)
	(up-compare-goal gl-tempgoal-overall-best-distance-from-edge g:< gl-tempgoal-current-best-distance-from-edge)
=>
	(up-modify-goal gl-tempgoal-overall-best-edge-specifier g:= gl-tempgoal-current-best-distance-edge-specifier)
	(up-modify-goal gl-tempgoal-overall-best-distance-from-edge g:= gl-tempgoal-current-best-distance-from-edge)
	(up-set-indirect-goal g: gl-x-looper g: point1-x)
	(up-set-indirect-goal g: gl-y-looper g: point1-y)
)
	
;currentpoint skip target
(defrule
	(up-compare-goal gl-x-looper < lastforestpoint-x-index)
=>
	;;(chat-to-all "next point")
;	;;(up-chat-data-to-all "x-looper: %d" g: gl-x-looper)
;	;;(up-chat-data-to-all "y-looper: %d" g: gl-y-looper)
;	;;(up-chat-data-to-all "x-coord: %d" g: current-loop-point-x)
;	;;(up-chat-data-to-all "y-coord: %d" g: current-loop-point-y)
	(up-modify-goal gl-x-looper c:+ 2)
	(up-modify-goal gl-y-looper c:+ 2)
	;(up-send-flare current-loop-point-x)
	(up-jump-rule -10)
	(do-nothing)
)

(defrule
	(true)
	(false)
=>
	(up-copy-point edgepoint1-x point1-x)
	;(up-send-flare edgepoint1-x)
	;;(chat-to-all "edgepoint1 found")
)

(defrule
	(true)
;	(goal gl-new-wall-progression forestsfound)
;	(up-compare-goal gl-x-looper > lastforestpoint-x-index)
=>
	(set-goal gl-new-wall-progression edgepoint1found)
	;;(chat-to-all "move to next stage")
)
;end edgepoints jump
	




































