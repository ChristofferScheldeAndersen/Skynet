	(up-jump-rule -5)
)
(defrule
;	(false)
	(up-compare-goal gl-temp11 < 200)
=>
	(up-modify-goal gl-temp1 g:= gl-temp12)		;increase both by the difference between them (to avoid overlap)
	(up-modify-goal gl-temp1 g:- gl-temp11)		;temp1 not used till below
	(up-modify-goal gl-temp11 g:+ gl-temp1)
	(up-modify-goal gl-temp12 g:+ gl-temp1)
	(up-jump-rule -7)	;main upjump
)

