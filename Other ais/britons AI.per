(defrule
	(false)
	(goal gl-tenth-turn 1)
	(not(taunt-detected me 68))
	(up-compare-flag gl-misc-flag1 == fl-attack)
=>
	;(chat-to-all "attacking(68)")
	(do-nothing)
)

(defrule
	(taunt-detected me 69)
=>
	(acknowledge-taunt me 68)
	(acknowledge-taunt me 69)
)









;qbeco
(defrule
	(or	(current-age-time < 100)
		(or	(current-age < imperial-age)
			(up-timer-status t-beco == timer-running)))
=>
	(up-jump-rule 3)
)




;========= decrease wood for lategame farms
(defrule
	(wood-amount >= 1200)
	(or	(up-compare-goal gl-add-scouts >= lategame)
		(up-compare-goal gl-strategy-style != longbows))
	(strategic-number sn-wood-gatherer-percentage >= 15)
=>
	(up-modify-sn sn-wood-gatherer-percentage c:- 5)
	(up-modify-sn sn-food-gatherer-percentage c:+ 5)
	(enable-timer t-beco 60)
	(log "increase food")
	(up-jump-rule 2)
)


;========= increase wood
(defrule
	(wood-amount < 100)
	(food-amount >= 900)
	(goal gl-saving-food -1)
	(up-compare-goal gl-strategy != fccastle)
	(up-compare-goal gl-saving-overhead-food >= 400)
	(strategic-number sn-food-gatherer-percentage >= 10)	;not if really low
=>
	(up-modify-sn sn-food-gatherer-percentage c:- 5)
	(up-modify-sn sn-wood-gatherer-percentage c:+ 5)
	;hi;(chat-to-all "/13")
	;hi;(chat-to-all "/13increase wood and decrease food 2")
	;(chat-to-all "/13 increase wood and decrease food 2")
	(up-modify-goal gl-wood-beco c:+ 1)
	(enable-timer t-beco 60)
	(up-jump-rule 1)
)

(defrule
	(wood-amount < 100)
	(food-amount >= 400)
	(goal gl-saving-food -1)
	(up-compare-goal gl-strategy != fccastle)
	(up-compare-goal gl-saving-overhead-food >= 400)
	(strategic-number sn-food-gatherer-percentage >= 10)	;not if really low
=>
	(up-modify-sn sn-food-gatherer-percentage c:- 2)
	(up-modify-sn sn-wood-gatherer-percentage c:+ 2)
	;hi;(chat-to-all "/13")
	;hi;(chat-to-all "/13increase wood and decrease food")
	;(chat-to-all "/13 increase wood and decrease food")
	(up-modify-goal gl-wood-beco c:+ 1)
	(enable-timer t-beco 60)
)
