	(false)
	(up-set-target-by-id g: gl-next-sheep-id)
=>
	(up-get-object-data object-data-action gl-temp10)
;	;(up-chat-data-to-all "action: %d" g: gl-temp10)
)

(defrule
	(game-time >= 5)
	(or	(goal gl-fifth-turn 1)
		(up-set-target-object search-local c: 0))
	(up-set-target-by-id g: gl-current-sheep-id)
	(up-set-target-by-id g: gl-next-sheep-id)	;
