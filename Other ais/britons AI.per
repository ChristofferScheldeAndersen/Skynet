(defrule
	(or	(goal scout-checking-x -1)
		(or	(and(goal gl-scout-stuck -1)
				(up-point-distance scout-checking-x scout-x >= 4))
			(and(goal gl-scout-stuck 1)
				(up-point-distance scout-checking-x scout-x >= 16))))
=>
	(up-copy-point scout-checking-x scout-x)
	(set-goal gl-scout-stuck-counter -1)
;	;(up-send-flare scout-checking-x)
;	;;(chat-to-all "scout not stuck")
	(set-goal gl-scout-stuck -1)
)

(defrule
	(goal gl-scout-stuck -1)
