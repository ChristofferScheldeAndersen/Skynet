;these rules might need moved later
(defrule
	(goal gl-strategy pikesiege) 
	(up-research-status c: castle-age >= research-pending)
=>
	(up-modify-goal gl-desired-food-vills c:- 1)
	(up-modify-goal gl-desired-wood-vills c:+ 1)
	(set-goal gl-source-villager straggler)
	;hi;(chat-to-all "send one to wood")
	(disable-self)
)

(defrule	;match the entrance vill numbers
	(current-age == castle-age)
	(goal gl-strategy pikesiege) 
	(up-compare-flag gl-misc-flag2 != fl-build-order-finished)
=>
	(set-goal gl-switch-to-percentage-eco 1)
	(set-goal gl-percent-wood-gatherers 36) 
	(set-goal gl-percent-food-gatherers 56)
	(set-goal gl-percent-gold-gatherers 8)
	(set-goal gl-percent-stone-gatherers 0)
	(up-modify-flag gl-misc-flag2 c:+ fl-build-order-finished)
	(set-goal gl-eco-switch 1)
	(disable-self)
)

(defrule	;match the entrance vill numbers
	(false)
	(up-research-status c: castle-age >= research-pending)
	(up-compare-flag gl-misc-flag2 != fl-build-order-finished)
=>
	(up-modify-flag gl-misc-flag2 c:+ fl-build-order-finished)
	(disable-self)
)

(defrule
	(false)
	(up-compare-flag gl-misc-flag2 == fl-build-order-finished)
=>
	(up-modify-flag gl-misc-flag2 c:+ fl-use-default-eco)
	;hi;(chat-to-all "switch to default eco")
	(disable-self)
)
	
