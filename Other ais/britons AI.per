;;;;;
(defrule
	(goal gl-strategy norman)
	(up-compare-flag gl-misc-flag1 != fl-attack)
;	(or	(unit-type-count trebuchet-set >= 2)
;		(players-building-type-count target-player castle < 1))
	(current-age >= castle-age)
	(or	(military-population >= 31)
		(or	(up-compare-goal gl-temp2 >= 7)	;have superiority...
			(and(or	(military-population >= 9)	;...or have some military pop
					(and(unit-type-count knight-line >= 1) 
						(up-compare-flag gl-misc-flag1 != fl-enemy-flushing)))
				(or	(players-current-age-time target-player < 30)	;...and player isn't in castle yet
					(players-current-age target-player < castle-age)))))
=>
	(set-strategic-number sn-maximum-town-size 1000)
	(up-modify-flag gl-misc-flag1 c:+ fl-attack)
;	(enable-timer t-tsa 20)
	;hi;(chat-to-all "attack")
)

(defrule
	(goal gl-strategy norman)
	(up-compare-flag gl-misc-flag1 == fl-attack)
	(players-building-count target-player < 1)
=>
	;hi;(chat-to-all "attack 2")
	(up-full-reset-search)
	(up-find-local c: knight-line c: 40)
	(up-target-point estimated-enemy-x action-patrol -1 -1)
	(up-full-reset-search)
	(up-find-local c: scorpion-line c: 40)
	(up-target-point estimated-enemy-x action-patrol -1 -1)
	(up-full-reset-search)
	(up-find-local c: infantry-class c: 40)
	(up-target-point estimated-enemy-x action-patrol -1 -1)
	(disable-self)
)

