(defrule
	(up-compare-goal gl-current-sheep-id != -1)
	(not(up-set-target-by-id g: gl-current-sheep-id))
=>
	;;(chat-to-all "reset current sheep id")
	(set-goal gl-current-sheep-id -1)
)

(defrule
	(up-set-target-by-id g: gl-next-sheep-id)
	(up-object-data object-data-player != 0)
	(up-object-data object-data-player != my-player-number)
=>
	(up-get-object-data object-data-player gl-temp1)
