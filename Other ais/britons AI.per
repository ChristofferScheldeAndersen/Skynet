	(up-compare-flag gl-misc-flag2 == fl-use-default-eco)
=>
	(up-jump-rule 31)
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-group-flag != miscfoodgroup)
	(up-get-search-state lt)
	(up-modify-goal gl-temp1 g:= lt)
	(up-modify-goal gltemp-plusone-projected-food-gatherers g:= lt)
	(up-modify-goal gltemp-plusone-projected-food-gatherers c:+ 1)
	
	(up-full-reset-search)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-group-flag != miscwoodgroup)
	(up-get-search-state lt)
	(up-modify-goal gl-temp2 g:= lt)
	(up-modify-goal gltemp-plusone-projected-wood-gatherers g:= lt)
	(up-modify-goal gltemp-plusone-projected-wood-gatherers c:+ 1)
	
	(up-full-reset-search)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-group-flag != berrygroup)
	(up-get-search-state lt)
	(up-modify-goal gl-temp3 g:= lt)
	(up-modify-goal gltemp-plusone-projected-berry-gatherers g:= lt)
	(up-modify-goal gltemp-plusone-projected-berry-gatherers c:+ 1)
)	

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-group-flag != miscgoldgroup)
