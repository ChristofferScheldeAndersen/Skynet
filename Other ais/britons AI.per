(defrule
	(can-build house)
	(goal gl-strategy drush)
	(unit-type-count villager >= 17)
	(building-type-count-total house < 4)
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))

	(up-compare-goal gl-walling-stage != 100)
=>
	(set-goal gl-walling-building house)
	;;(chat-to-all "house2b")
)	


(defrule
	(can-build house)
	(housing-headroom < 10)
	(goal gl-strategy scrush)
	(up-pending-objects c: house < 1)
	(building-type-count-total mill >= 1)
	(building-type-count-total house >= 3)
	(or	(building-type-count-total house < 4)
		(building-type-count-total stable >= 1))
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))

	(up-compare-goal gl-walling-stage != 100)
=>
	(set-goal gl-walling-building house)
	;;(chat-to-all "house3")
)

;5th
(defrule
	(can-build house)
	(goal gl-strategy drush)
	(building-type-count-total house < 5)
	(building-type-count-total barracks >= 1)
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))

	(up-compare-goal gl-walling-stage != 100)
=>
	(set-goal gl-walling-building house)
)

;later houses
(defrule
	(goal gl-opening-type fc)
	(building-type-count-total house >= 3)
=>
	;hi;(chat-to-all "enable default housing")
	(set-goal gl-default-housing 1)
	(disable-self)
)

(defrule	;don't need houses in feudal for fc
	(goal gl-opening-type fc)
	(up-research-status c: feudal-age >= research-pending)
=>
	;hi;(chat-to-all "pause default housing")
	(set-goal gl-default-housing 0)
	(disable-self)
)

(defrule
	(goal gl-opening-type fc)
	(up-research-status c: castle-age >= research-pending)
=>
	;hi;(chat-to-all "restart default housing")
	(set-goal gl-default-housing 1)
	(disable-self)
)

(defrule
	(can-build house)
	(goal gl-default-housing 1)
	(up-compare-goal gl-walling-stage != 100)
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))
	(or	(and(housing-headroom < 5)
			(up-pending-objects c: house < 1))
		(or	(and(housing-headroom < 10)
				(and(civilian-population >= 35)
					(up-pending-objects c: house < 2)))
			(or	(and(housing-headroom < 15)
					(and(civilian-population >= 50)
						(up-pending-objects c: house < 2)))
				(and(housing-headroom < 20)
					(and(civilian-population >= 80)
						(up-pending-objects c: house < 4))))))
=>
	(set-goal gl-walling-building house)
	;hi;(chat-to-all "default house")
)

(defrule
	(can-build house)
	(housing-headroom < 10)
	(civilian-population >= 35)
	(building-type-count house >= 2)
	(up-pending-objects c: house < 2)
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))

	(up-compare-goal gl-walling-stage != 100)
=>
	(set-goal gl-walling-building house)
)

(defrule
	(or	(taunt-detected me 13)
		(taunt-detected any-computer 13))
=>;debuggggg
	;(up-chat-data-to-all "Wood percentage: %d" s: sn-wood-gatherer-percentage);debuggggg
	;(up-chat-data-to-all "Food percentage: %d" s: sn-food-gatherer-percentage);debuggggg
	;(up-chat-data-to-all "Gold percentage: %d" s: sn-gold-gatherer-percentage);debuggggg
	;(up-chat-data-to-all "Stone percentage: %d" s: sn-stone-gatherer-percentage);debuggggg
	(acknowledge-taunt this-any-computer 13)
	(acknowledge-taunt me 13)
)

(defrule	;how many berries left?
	(building-type-count-total mill < 1)
=>
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance c: -1 c: 25)
	(set-strategic-number sn-focus-player-number 0)
	(up-find-remote c: forage-class c: 10)	
	(up-get-search-state lt)
)

(defrule
	(can-build mill)
	(up-compare-goal rt >= 4)
	(building-type-count house == 3)
	(building-type-count-total mill < 1)
=>
	(set-goal gl-dropsite-to-build mill)
	(disable-self)
)

;qrax	;qbarracks
(defrule
	(can-build barracks)
	(goal gl-strategy drush)
	(building-type-count-total house >= 4)
	(building-type-count-total barracks < 1)
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))
=>
	(set-goal gl-walling-building barracks)
	;hi;(chat-to-all "rax1")
)

(defrule
	(can-build rax)
	(goal gl-walling-building -1)
	(building-type-count-total tc >= 3)
	(or	(up-compare-goal gl-add-spears >= normal)
		(building-type-count-total rax < 1))
	(or	(building-type-count-total rax < 2)
		(and(building-type-count-total rax < 5)
			(up-research-status c: imperial-age >= research-pending)))
	(or	(game-time >= 1500)	;25 min
		(or	(unit-type-count villager >= 58)
			(or	(up-compare-goal gl-add-scouts != -1)
				(or	(up-compare-goal gl-add-knights != -1)
					(or	(up-compare-goal gl-add-archers != -1)
						(or	(up-compare-goal gl-add-spears != -1)
							(up-compare-goal gl-add-skirms != -1)))))))
=>
	(set-goal gl-walling-building rax)
	;hi;(chat-to-all "rax")
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: town-center c: 1)
)

(defrule
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-progress-value >= 50)
	(up-research-status c: feudal-age == research-pending)
	
	(can-build barracks)
	(goal gl-strategy scrush)
	(building-type-count-total barracks < 1)
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))
=>
	(set-goal gl-walling-building barracks)
	;;(chat-to-all "rax")
)

(defrule
	(can-build barracks)
	(building-type-count-total barracks < 1)
	(building-type-count palisade-wall >= 1)
	(building-type-count-total lumber-camp >= 2)
=>
	;;(chat-to-all "rax 2")
	(build barracks)
)





































