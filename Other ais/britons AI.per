;	;(up-send-flare counterclockwise-next-vertex-x)
	
	(up-modify-goal gl-next-counterclockwise-vertex-x-index c:- 1)	;previous -y
	(up-get-indirect-goal g: gl-next-counterclockwise-vertex-x-index counterclockwise-next-vertex-y)
	(up-modify-goal gl-next-counterclockwise-vertex-x-index c:- 1)	;previous -x
	(up-get-indirect-goal g: gl-next-counterclockwise-vertex-x-index counterclockwise-next-vertex-x)
	
	(up-modify-goal gl-walling-stage c:max pastfirstvertex)	;important for not ending immediately
	(set-goal gl-misc-vertex-skip 1)

	;(up-send-flare counterclockwise-next-vertex-x)
