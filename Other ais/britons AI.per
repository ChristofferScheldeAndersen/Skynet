(defrule	;penalize distance from home/enemy
	(true)
	(up-compare-goal gl-dropsite-to-build == lumber-camp)
=>
	(up-get-point-distance point2-x home-x lt)
	(up-modify-goal lt g:* gl-temp13)
	(up-modify-goal gl-temp3 g:- lt)
	
	(up-get-point-distance estimated-enemy-x home-x lt)	
	(up-modify-goal lt c:* 2)
	(up-modify-goal gl-temp3 g:+ lt)	;slightly encourage greater distance from enemy
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point point2-x)
	(up-filter-distance c: -1 g: gl-temp9)		;g: gl-temp9)
