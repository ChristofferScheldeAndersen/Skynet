	(goal gl-sheep-scout-index 2)
	(up-compare-goal gl-temp5 < 1)
    (up-compare-flag gl-scouting-flag == SKIP-FLAG-2)
=>
    (up-modify-flag gl-scouting-flag c:- SKIP-FLAG-2)
;	;;(chat-to-all "remove treeskip 2")
)


;--------THREE
