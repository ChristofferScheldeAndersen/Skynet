(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-point-x point2-x)
	(up-get-object-data object-data-point-y point2-y)
	(up-modify-goal point1-x g:+ point2-x)
	(up-modify-goal point1-y g:+ point2-y)
	(up-modify-goal gl-temp1 c:+ 1) ;number of points checked
)

(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-remove-objects search-remote -1 == 0)
	(up-jump-rule -2)
)

(defrule
	(up-compare-goal gl-temp1 > 0)
=>
	(up-get-indirect-goal g: gl-x-looper point3-x)	;get the x/y of the current vertex into goals
	(up-get-indirect-goal g: gl-y-looper point3-y)
	;(up-send-flare point3-x)
	(up-modify-goal point1-x g:/ gl-temp1)
	(up-modify-goal point1-y g:/ gl-temp1)
	(up-set-indirect-goal g: gl-x-looper g: point1-x)	;copy the average x/y into the current vertex
	(up-set-indirect-goal g: gl-y-looper g: point1-y)
	;(up-send-flare point1-x)
	;;(chat-to-all "adjusted")
)
;end small jump
;end adjustfortrees jump
	
(defrule
	(true)
=>
;	;;(up-chat-data-to-all "x-looper: %d" g: gl-x-looper)
;	;;(up-chat-data-to-all "y-looper: %d" g: gl-y-looper)
;	;;(up-chat-data-to-all "x-coord: %d" g: current-wall-point-x)
