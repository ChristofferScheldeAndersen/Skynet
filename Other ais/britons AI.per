(defrule
	(up-timer-status t-one-min != timer-running)
=>
	(up-modify-goal gl-longbow-marchcross c:* -1)
	(enable-timer t-one-min 60)
)

(defrule
	(goal gl-longbow-marchcross -1)
=>
	(set-goal gl-temp1 -9)
)

(defrule
	(goal gl-longbow-marchcross 1)
=>
	(set-goal gl-temp1 9)
)

(defrule
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-copy-point point1-x longbow-group-x)
	(up-copy-point point2-x estimated-enemy-x)
	(up-cross-tiles point2-x home-x g: gl-temp1)
	(up-lerp-tiles point1-x point2-x c: 15)
;	;(up-send-flare point2-x)
)

(defrule
	(up-compare-goal gl-longbow-group-size >= 1)
	(or	(goal gl-longbow-home-defense 1)
		(or	(goal gl-longbow-monk-retreat 1)
			(or	(goal gl-longbow-siege-retreat 1)
				(or	(goal gl-longbows-near-fortification 1)
					(goal gl-enemy-military-near-longbows 1)))))
=>
	(up-copy-point point1-x longbow-group-x)
	(up-lerp-tiles point1-x home-x c: 15)
)

(defrule
	(true)
;	(taunt-detected me 76)
	(up-compare-goal gl-longbow-group-size >= 1)
=>
;	;(up-chat-data-to-all "state: %d" g: gl-longbow-group-state)
;	;(up-chat-data-to-all "fire: %d" g: gl-time-to-fire)
;	;(up-chat-data-to-all "target: %d" g: gl-longbow-group-target1-id)
;	;(up-chat-data-to-all "fort: %d" g: gl-longbows-near-fortification)
;	;(up-chat-data-to-all "mil: %d" g: gl-enemy-military-near-longbows)
	

;	(up-log-data 0 " ----- : %d" g: ----- )

	(up-get-fact game-time 0 gl-temp1)
	(up-log-data 0 " time : %d" g: gl-temp1)

	(up-modify-goal gl-log-clarity-progression c:+ 1)
	(up-log-data 0 "gl-log-clarity-progression: %d" g: gl-log-clarity-progression )

	(up-log-data 0 " state : %d" g: gl-longbow-group-state )
	(up-log-data 0 " fire : %d" g: gl-time-to-fire )
	(up-log-data 0 "target: %d" g: gl-longbow-group-target1-id)
	(up-log-data 0 "fort: %d" g: gl-longbows-near-fortification)
	(up-log-data 0 "mil: %d" g: gl-enemy-military-near-longbows)
)

(defrule
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(set-goal gl-temp2 0)
)

(defrule
	(goal gl-longbow-home-defense 1)
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(set-goal gl-temp2 5)
)

;move the group toward tracking target
(defrule
;	(goal gl-longbow-home-defense -1)
	(goal gl-longbow-monk-retreat -1)
	(goal gl-longbow-siege-retreat -1)
	(goal gl-longbows-near-fortification -1)
	(goal gl-enemy-military-near-longbows -1)
	(or	(goal gl-time-to-fire -1)
		(goal gl-longbow-group-target1-id -1))
	(up-compare-goal gl-longbow-group-size >= 1)
	(up-set-target-by-id g: gl-longbow-tracking-target-id)
	(or	(goal gl-fifth-turn 1)
		(up-compare-goal gl-longbow-group-state != tracking))
=>
	(up-full-reset-search)
	(up-find-local c: longbowman-line c: 100)
	(up-remove-objects search-local object-data-group-flag != longbow1)
	(up-copy-point point1-x longbow-group-x)
	(up-lerp-tiles point1-x longbow-tracking-target-x c: 15)
	(up-lerp-tiles point1-x home-x g: gl-temp2)
	(up-bound-point point1-x point1-x)
	(up-target-point point1-x action-move formation-line no-attack)
	(set-goal gl-longbow-group-state tracking)
	(up-modify-goal gl-log-clarity-progression c:+ 1)
	(up-log-data 0 "gl-log-clarity-progression: %d" g: gl-log-clarity-progression )
;	;(chat-to-all "tracking longbows")
;	;(chat-to-all "track longbows")
	(log "track longbows")
)


;move the group toward the desired destination (usually enemy base but home base if under attack)
(defrule
;	(goal gl-longbow-home-defense -1)
	(goal gl-longbow-monk-retreat -1)
	(goal gl-longbow-siege-retreat -1)
	(goal gl-longbow-tracking-target-id -1)
	(goal gl-longbows-near-fortification -1)
	(goal gl-enemy-military-near-longbows -1)
	(or	(goal gl-time-to-fire -1)
		(goal gl-longbow-group-target1-id -1))
	(up-compare-goal gl-longbow-group-size >= 1)
	(or	(goal gl-fifth-turn 1)
		(up-compare-goal gl-longbow-group-state != marching))
=>
	(up-full-reset-search)
	(up-find-local c: longbowman-line c: 100)
	(up-remove-objects search-local object-data-group-flag != longbow1)
	(up-bound-point point1-x point1-x)
	(up-target-point point1-x action-move formation-line no-attack)
	(set-goal gl-longbow-group-state marching)
	(up-modify-goal gl-log-clarity-progression c:+ 1)
	(up-log-data 0 "gl-log-clarity-progression: %d" g: gl-log-clarity-progression )
;	;(chat-to-all "march longbows")
;	;(chat-to-all "move longbows")
	(log "move longbows")
)

;retreat the group from threats
(defrule
	(or	(goal gl-time-to-fire -1)
		(goal gl-longbow-group-target1-id -1))
	(up-compare-goal gl-longbow-group-size >= 1)
	(or	(goal gl-longbow-monk-retreat 1)
		(or	(goal gl-longbow-siege-retreat 1)
			(or	(goal gl-longbows-near-fortification 1)
				(goal gl-enemy-military-near-longbows 1))))
	(or	(goal gl-fifth-turn 1)
		(up-compare-goal gl-longbow-group-state != retreating))
=>
	(up-full-reset-search)
	(up-find-local c: longbowman-line c: 100)
	(up-remove-objects search-local object-data-group-flag != longbow1)
	(up-bound-point point1-x point1-x)
	(up-target-point point1-x action-move formation-line no-attack)
	(set-goal gl-longbow-group-state retreating)
;	;(chat-to-all "retreat longbows")
	(log "retreat longbows")
	(up-modify-goal gl-log-clarity-progression c:+ 1)
	(up-log-data 0 "gl-log-clarity-progression: %d" g: gl-log-clarity-progression )
)

