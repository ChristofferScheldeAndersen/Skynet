;stop vills from killing boar outside tc
(defrule
	(true)
;	(or	(game-time < 10)
;		(or	(goal boar-original-x -1)
;			(up-compare-flag gl-misc-flag2 == fl-boring-pause)))
=>
	(up-jump-rule 3)
)

(defrule
	(true)
=>
