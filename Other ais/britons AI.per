;qstart ;qq

(defrule
    (true)
=>
	(log "qqstart")
	(disable-self)
)

(defrule
    (taunt-detected my-player-number 71)
=>
    (fe-break-point 1 == 1 -1)
    (acknowledge-taunt my-player-number 71)
)

(defconst gl-start-time1 299)

;this is for detecting internal script lag
(defrule
    (true)
=>
    (up-get-precise-time 0 gl-start-time1 )    ;get a timestamp
)

(defrule
	(taunt-detected my-player-number 74)
=>
	;(chat-to-all "----------")
	(do-nothing)
)

(defrule
	(taunt-detected my-player-number 75)
=>
	(acknowledge-taunt my-player-number 74)
	(acknowledge-taunt my-player-number 75)
)










(defconst gl-elapsed 444)
(defconst gl-previous-game-time 445)
(defconst gl-current-game-time 446)

(defrule	;leif's
    (true)
	(taunt-detected my-player-number 25)
=>
    (up-modify-goal gl-previous-game-time g:= gl-current-game-time)
    (up-set-timer c: 50 c: 0)
    (up-get-timer c: 50 gl-current-game-time)
    (up-modify-goal gl-elapsed g:= gl-current-game-time)
    (up-modify-goal gl-elapsed g:- gl-previous-game-time)
    ;(up-chat-data-to-all "Time between passes: %d" g: gl-elapsed)
)

(defrule
	(taunt-detected my-player-number 26)
=>
    (acknowledge-taunt my-player-number 25)
    (acknowledge-taunt my-player-number 26)
)

(defrule ;start rule
    (true)
	(false)
=>
    (up-set-timer c: 50 c: 0)
    (up-get-timer c: 50 445)
    (up-modify-goal 444 g:= 445)
    (up-modify-goal 444 g:- 443)
	;;(up-chat-data-to-all "elapsed: %d" g: 444)
)

(defrule
	(true)
	(false)
=>
	;;(chat-to-all "g-----------g")
	(do-nothing)
)

(defrule
    (true)
	(false)
=>
    (up-get-precise-time 0 444)
;	;;(up-chat-data-to-all "time: %d" g: 444)
)



