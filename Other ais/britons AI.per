(defrule
	(current-age >= imperial-age)
	(goal gl-strategy-style longbows)
	(or	(wood-amount >= 900)
		(and(building-type-count-total stable >= 5)
			(up-compare-goal gl-add-scouts >= lategame)))
	(up-research-status c: my-unique-unit-upgrade >= research-pending)
=>
	(set-strategic-number sn-food-gatherer-percentage 47)
	(set-strategic-number sn-wood-gatherer-percentage 30)
	(set-strategic-number sn-gold-gatherer-percentage 18)
	(set-strategic-number sn-stone-gatherer-percentage 5)
	;(chat-to-all "add more food")
	(disable-self)
)
