;retarget idles
(defrule
	(goal gl-opening-type fc)
=>
	(set-goal gl-retargetting-to-stragglers-state retargetoncenofoodundertc)
	(disable-self)
)

(defrule
	(true)
	(current-age == feudal-age)
	(up-compare-goal gl-opening-type != fc)
=>
	(set-goal gl-temp4 3)
)

(defrule
	(goal gl-retargetting-to-stragglers-state retargetoncenofoodundertc)
=>
	(set-goal gl-temp4 -1)
)

;retarget idle foodies to stragglers
(defrule
	(game-time >= 10)
	(or	(and(current-age == feudal-age)
			(up-compare-goal gl-opening-type != fc))
		(and(goal gl-food-left-under-tc -1)
			(goal gl-retargetting-to-stragglers-state retargetoncenofoodundertc)))
=>
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance g: gl-temp4 c: 20)	;not right under tc sometimes
	(up-find-local c: villager-class c: 20)
		(up-get-search-state lt)
;	;;(up-chat-data-to-all "lt1: %d" g: lt)
	(up-remove-objects search-local object-data-group-flag != miscfoodgroup)
;	(up-remove-objects search-local object-data-id g:== gl-lurer-id)
;	(up-remove-objects search-local object-data-id g:== gl-shooter-id)
	(up-remove-objects search-local object-data-action == actionid-build)(up-remove-objects search-local object-data-action == actionid-attack)
	(up-remove-objects search-local object-data-target == tree-class)
	(up-remove-objects search-local object-data-target == farm-class)
	(up-remove-objects search-local object-data-target == deer-class)
	(up-remove-objects search-local object-data-target == boar-class)
;	(up-remove-objects search-local object-data-target-id g:== gl-current-sheep-id)
	(up-remove-objects search-local object-data-id g:== gl-clockwise-builder-id)
	(up-remove-objects search-local object-data-id g:== gl-counterclockwise-builder-id)
	(up-get-search-state lt)
;	;;(up-chat-data-to-all "lt: %d" g: lt)
;	;;(up-chat-data-to-all "temp4: %d" g: gl-temp4)
)

(defrule
	(or	(and(current-age == feudal-age)
			(up-compare-goal gl-opening-type != fc))
		(and(goal gl-food-left-under-tc -1)
			(goal gl-retargetting-to-stragglers-state retargetoncenofoodundertc)))
=>
	(up-filter-distance c: -1 c: 10)	;only straggs
	(set-strategic-number sn-focus-player-number 0)
	(up-filter-status c: status-resource c: list-active)
	(up-find-status-remote c: tree-class c: 10)					;partially chopped trees
	(up-remove-objects search-remote object-data-tasks-count > 0)
	(up-filter-status c: status-ready c: list-active)
	(up-find-remote c: tree-class c: 40)						;standing trees
	(up-remove-objects search-remote object-data-tasks-count > 0)
	
	(up-filter-status c: status-resource c: list-active)
	(up-find-status-remote c: tree-class c: 10)					;partially chopped trees
	(up-remove-objects search-remote object-data-tasks-count > 3)
	(up-filter-status c: status-ready c: list-active)
	(up-find-remote c: tree-class c: 40)						;standing trees
	(up-remove-objects search-remote object-data-tasks-count > 3)
	
	(up-clean-search search-remote 44 search-order-asc)
	(up-get-search-state lt)
;	;;(up-chat-data-to-all "rt: %d" g: rt)
)

(defrule
	(up-set-target-object search-local c: 0)
	(up-set-target-object search-remote c: 0)
	
	(or	(and(current-age == feudal-age)
			(up-compare-goal gl-opening-type != fc))
		(and(goal gl-food-left-under-tc -1)
			(goal gl-retargetting-to-stragglers-state retargetoncenofoodundertc)))
=>
	(up-remove-objects search-local -1 > 0)
	(up-target-objects 1 action-default -1 -1)
	;;(chat-to-all "retarget to straggler")
)

;qtreetask
(defrule	;set gatherpoint on unbuilt lc
	(unit-type-count villager == 6)
	(goal gl-next-villager miscwood)
	(building-type-count lumber-camp == 0)
	(up-compare-flag gl-misc-flag1 != 32768)
	(building-type-count-total lumber-camp == 1)
=>
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active)
	(set-strategic-number sn-focus-player-number me)
	(up-find-status-remote c: lumber-camp c: 1)
)

(defrule
	(up-set-target-object search-remote c: 0)
	
	(unit-type-count villager == 6)
	(goal gl-next-villager miscwood)
	(building-type-count lumber-camp == 0)
	(up-compare-flag gl-misc-flag1 != 32768)
	(building-type-count-total lumber-camp == 1)
=>
	(up-full-reset-search)
	(up-find-local c: town-center c: 1)
	(up-target-objects 1 action-gather -1 -1)
	(up-modify-flag gl-misc-flag1 c:+ 32768)
	;hi;(chat-to-all "gatherpoint set on lc")
)

(defrule
	(true)
	(false)
=>
	(up-jump-rule 13)
)

(defrule			;old code
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 40)
;	(up-remove-objects search-local object-data-group-flag != miscwoodgroup)
;	(up-remove-objects search-local object-data-idling != 1)
;	(up-remove-objects search-local object-data-gather-type != gathertype-wood)
;	(up-remove-objects search-local object-data-dropsite != lumber-camp)
;	(up-remove-objects search-local object-data-action == actionid-build)(up-remove-objects search-local object-data-action == actionid-attack)
)

(defrule	;if we've found a bad woodie, look for a lumber
	(up-set-target-object search-local c: 0)
	(false)
=>
	(up-get-point position-object point1-x)
	;(up-send-flare point1-x)
	(up-get-object-data object-data-gather-type gl-temp1)
	;;(up-chat-data-to-all "gather type: %d" g: gl-temp1)
)








;retargetting to trees if not on trees/setting gatherpoints on trees
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-group-flag != miscwoodgroup)
;	(up-remove-objects search-local object-data-idling != 1)
;	(up-remove-objects search-local object-data-gather-type != gathertype-wood)
	(up-remove-objects search-local object-data-target == tree-class)
	(up-remove-objects search-local object-data-id g:== gl-clockwise-builder-id)
	(up-remove-objects search-local object-data-id g:== gl-counterclockwise-builder-id)
;	(up-remove-objects search-local object-data-dropsite == lumber-camp)
	(up-remove-objects search-local object-data-action == actionid-build)(up-remove-objects search-local object-data-action == actionid-attack)
)

(defrule	;if we've found a bad woodie, look for a lumber
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-temp1)	;for targetting at the end
	
	(up-full-reset-search)
	(up-find-local c: lumber-camp c: 10)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: lumber-camp c: 10)
	(up-set-target-point home-x)
	(up-clean-search search-local 44 search-order-asc)
)

(defrule	;...or if we need to set the gatherpoint
	(goal gl-next-villager miscwood)
	(unit-type-count villager >= 7)
	(up-compare-flag gl-misc-flag1 != 32768)
=>
	(set-goal gl-temp1 -1)	;reset the id

	(up-full-reset-search)
	(up-find-local c: lumber-camp c: 10)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: lumber-camp c: 10)
	(up-set-target-point home-x)
	(up-clean-search search-local 44 search-order-asc)
)

;end upjump
(defrule	
	(false)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	(up-filter-distance c: -1 c: 7)
	(set-strategic-number sn-focus-player-number me)
	(up-find-remote c: villager-class c: 20)	;need them in the remote list in order to loop through lc's
	(up-remove-objects search-remote object-data-dropsite != lumber-camp)
)

(defrule
	(false)
	(up-set-target-object search-remote c: 100)	;not for now
=>
;	;;(chat-to-all "camp saturated")
	(up-remove-objects search-local -1 == 0)
	(up-remove-objects search-remote -1 < 100)
;	;(up-send-flare point1-x)
	(up-jump-rule -2)
)

(defrule
	(up-set-target-object search-local c: 0)
=>
;	;;(chat-to-all "found lc")
	
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	
	(up-full-reset-search) 
	(up-filter-distance c: -1 c: 4)
	(set-strategic-number sn-focus-player-number 0)
	(up-filter-status c: status-resource c: list-active)
	(up-find-status-remote c: tree-class c: 10)		;partially chopped trees
	(up-remove-objects search-remote object-data-tasks-count > 2)
	(up-filter-status c: status-ready c: list-active)
	(up-find-remote c: tree-class c: 40)			;standing trees
	(up-remove-objects search-remote object-data-tasks-count > 2)
	(up-clean-search search-remote 44 search-order-asc)
	
	(set-goal gl-temp4 0)	;set up tree loop counter
	(set-goal gl-temp5 0)	;number of open spaces
)

;start big upjump
(defrule
	(up-set-target-object search-remote c: 0)
=>
;	;;(chat-to-all "reset")
	(up-get-point position-object point1-x)		;center point, position of tree
	(up-copy-point point2-x point1-x)	
	(up-modify-goal point2-x c:+ 1)
	(up-modify-goal point2-y c:+ 1)	;should work to do just +1 and -1 on each side to get the 3x3 area around the tree
	
	(up-modify-goal gl-temp2 g:= point1-x)
	(up-modify-goal gl-temp2 c:- 1)	;x limit
	(up-modify-goal gl-temp3 g:= point1-y)
	(up-modify-goal gl-temp3 c:- 1)	;y limit	
)

;start upjumps for the scan
(defrule
	(up-set-target-object search-remote c: 0)
	(up-can-build-line 0 point2-x c: palisade-wall)
=>
;	(up-build-line point2-x point2-x c: palisade-wall)
	(up-modify-goal gl-temp5 c:+ 1)
)

(defrule	;move down the column
	(up-set-target-object search-remote c: 0)
	
	(up-compare-goal gl-temp5 < 2)	;not enough spaces
	(up-compare-goal point2-x g:> gl-temp2)		;not past the end of the column
=>
	(up-modify-goal point2-x c:- 1)
	(up-jump-rule -2)
)

(defrule	;move over a column
	(up-set-target-object search-remote c: 0)	
	
	(up-compare-goal gl-temp5 < 2)	;not enough spaces
	(up-compare-goal point2-y g:> gl-temp3)		;not last column yet
	(up-compare-goal point2-x g:<= gl-temp2)	;but has reached the end of the current column
=>
	(up-modify-goal point2-x g:= point1-x)	;reset to center
	(up-modify-goal point2-x c:+ 1)	;get it back to the top
	(up-modify-goal point2-y c:- 1)	;shift it over one
	(up-jump-rule -3)
)

(defrule
	(up-set-target-object search-remote c: 0)
	
	(up-compare-goal gl-temp4 < 40)	;not enough trees checked yet
	(or	(up-compare-goal gl-temp5 < 1)
		(and(up-compare-goal gl-temp5 < 2)	
			(up-compare-goal gl-desired-wood-vills >= 5)))
=>
;	;;(up-chat-data-to-all "not enough spaces found around tree(%d)" g: gl-temp4)
	(up-remove-objects search-remote -1 == 0)
	(up-modify-goal gl-temp4 c:+ 1)
	(set-goal gl-temp5 0)	;reset
	(up-jump-rule -5)
)

(defrule
	(up-set-target-object search-remote c: 0)

	(unit-type-count villager >= 7)
	(goal gl-next-villager miscwood)
	(up-compare-flag gl-misc-flag1 != 32768)
=>
	(up-full-reset-search)
	(up-find-local c: town-center c: 1)
	(up-target-objects 1 action-gather -1 -1)
	;hi;(chat-to-all "gatherpoint set on tree")
	
	(up-modify-flag gl-misc-flag1 c:+ 32768)
)

(defrule
	(up-set-target-by-id g: gl-temp1)
	(up-set-target-object search-remote c: 0)
=>
	(up-reset-search 1 1 0 0)
	(up-add-object-by-id search-local g: gl-temp1)
	(up-target-objects 1 action-default -1 -1)
	;hi;(chat-to-all "new target tree")
	
	(up-get-point position-object point1-x)
;	;(up-send-flare point1-x)
)
;end main jump





















(defrule
	(true)
	(or	(up-compare-goal gl-under-attack != -1)
		(or	(up-compare-goal gl-fifth-turn != 1)
			(building-type-count lumber-camp < 2)))
=>
	(up-jump-rule 18)
)

;count lumberjacks around the first lumber camp
;how do we determine which lumber camp? we could say, if there are more than 6 lumberjacks,
;this is a little tricky 
;just loop through the lc's and if one is found with more, task any new to the other one

(defrule
	(true)
=>
	(set-goal gl-temp1 -1)
	(set-goal gl-temp2 -1)
	(set-goal gl-temp3 -1)
	(set-goal gl-temp4 -1)
	(set-goal gl-temp5 -1)
	(set-goal point1-x -1)
	(set-goal point1-y -1)
	(set-goal point2-x -1)
	(set-goal point2-y -1)

	(up-full-reset-search)
	(up-find-local c: lumber-camp c: 10)
	(up-set-target-point home-x)
	(up-clean-search search-local 44 search-order-asc)
)

;seems like we might need a different approach to this
;could we go, find camps, search for vills, around, if saturated camp found, search-through lumberjacks for ones targetting that lumbercamp, if none found
;go to the next lumbercamp from the first list?

;end big upjump
;end upjump
(defrule	
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	(up-filter-distance c: -1 c: 7)
	(set-strategic-number sn-focus-player-number me)
	(up-find-remote c: villager-class c: 20)	;need them in the remote list in order to loop through lc's
	(up-remove-objects search-remote object-data-target != tree-class)
)

(defrule
	(up-set-target-object search-local c: 0)
	(not(up-set-target-object search-remote c: 4))
=>
;	;;(chat-to-all "not too many lumberjacks")
	(up-remove-objects search-local -1 == 0)
	(up-remove-objects search-remote -1 < 100)
	(up-jump-rule -2)
)

;loop through lumberjacks not near the camp and find ones whose target-x is close to the camp
(defrule	;set up search for bad lumberjacks
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	(up-remove-objects search-remote -1 < 100)	;clear remote list
	(up-filter-distance c: 6 c: -1)
	(set-strategic-number sn-focus-player-number me)
	(up-find-remote c: villager-class c: 50)		;use remote search for lumberjacks to keep lc's in local list
	(up-remove-objects search-remote object-data-target != tree-class)
	(up-clean-search search-remote 44 search-order-asc)	;retarget closest first
)

;end of upjump
(defrule	
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-target-id gl-temp1)
)

(defrule
	(up-set-target-by-id g: gl-temp1)
=>
	(up-get-point position-object point2-x)	;need second point for comparison
)

(defrule
	(up-compare-goal point2-x >= 1)
	(up-set-target-object search-remote c: 0)
	(up-point-distance point1-x point2-x >= 7)
=>
;	;;(chat-to-all "wrong lumberjack")
	(up-remove-objects search-remote -1 == 0)
	(set-goal gl-temp1 -1)
	(up-jump-rule -3)
)

(defrule
	(not(up-set-target-object search-remote c: 0))
	(up-set-target-object search-local c: 0)
=>
;	;;(chat-to-all "no bad lumberjacks found for that saturated camp")
	(up-remove-objects search-local -1 == 0)	;remove that camp
	(up-jump-rule -7)
)

(defrule	;if we've found a bad lumberjack, now retask them
	(up-compare-goal point2-x != -1)
	(up-set-target-object search-remote c: 0)
	(up-point-distance point1-x point2-x < 7)
=>
	(up-get-object-data object-data-id gl-temp1)
	(up-full-reset-search)
	(up-find-local c: lumber-camp c: 10)
	(up-set-target-point home-x)
	(up-clean-search search-local 44 search-order-asc)
)

;end upjump
(defrule	
	(up-set-target-by-id g: gl-temp1)
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	(up-filter-distance c: -1 c: 7)
	(set-strategic-number sn-focus-player-number me)
	(up-find-remote c: villager-class c: 20)	;need them in the remote list in order to loop through lc's
	(up-remove-objects search-remote object-data-target != tree-class)
)

(defrule
	(up-set-target-by-id g: gl-temp1)
	(up-set-target-object search-local c: 0)
	(up-set-target-object search-remote c: 3)
=>
;	;;(chat-to-all "camp saturated")
	(up-remove-objects search-local -1 == 0)
	(up-remove-objects search-remote -1 < 100)
;	;(up-send-flare point1-x)
	(up-jump-rule -2)
)

(defrule
	(up-set-target-by-id g: gl-temp1)
	(up-set-target-object search-local c: 0)
=>
;	;;(chat-to-all "found other lc")
	(up-get-point position-object point1-x)
;	;(up-send-flare point1-x)
	(up-full-reset-search) 
	(up-set-target-point point1-x)
	(up-filter-distance c: -1 c: 7)
	(set-strategic-number sn-focus-player-number 0)
	(up-find-remote c: tree-class c: 40)
	(up-clean-search search-remote 44 search-order-asc)
	(up-remove-objects search-remote -1 >= 30)	;keep only 30 closest standing trees
	(up-remove-objects search-remote object-data-tasks-count > 1)
	(up-filter-status c: status-resource c: list-active)
	(up-find-status-remote c: tree-class c: 20)
	(up-remove-objects search-remote object-data-tasks-count > 1)
	(up-clean-search search-remote 44 search-order-asc)
	
	(set-goal gl-temp4 0)	;set up tree loop counter
	(set-goal gl-temp5 0)	;number of open spaces
)

;start big upjump
(defrule
	(up-set-target-by-id g: gl-temp1)
	(up-set-target-object search-remote c: 0)
=>
;	;;(chat-to-all "reset")
	(up-get-point position-object point1-x)		;center point, position of tree
	(up-copy-point point2-x point1-x)	
	(up-modify-goal point2-x c:+ 1)
	(up-modify-goal point2-y c:+ 1)	;should work to do just +1 and -1 on each side to get the 3x3 area around the tree
	
	(up-modify-goal gl-temp2 g:= point1-x)
	(up-modify-goal gl-temp2 c:- 1)	;x limit
	(up-modify-goal gl-temp3 g:= point1-y)
	(up-modify-goal gl-temp3 c:- 1)	;y limit	
)

;start upjumps for the scan
(defrule
	(up-set-target-by-id g: gl-temp1)
	(up-set-target-object search-remote c: 0)
	(up-can-build-line 0 point2-x c: palisade-wall)
=>
;	(up-build-line point2-x point2-x c: palisade-wall)
	(up-modify-goal gl-temp5 c:+ 1)
)

(defrule	;move down the column
	(up-set-target-by-id g: gl-temp1)
	(up-set-target-object search-remote c: 0)
	
	(up-compare-goal gl-temp5 < 2)	;not enough spaces
	(up-compare-goal point2-x g:> gl-temp2)		;not past the end of the column
=>
	(up-modify-goal point2-x c:- 1)
	(up-jump-rule -2)
)

(defrule	;move over a column
	(up-set-target-by-id g: gl-temp1)
	(up-set-target-object search-remote c: 0)	
	
	(up-compare-goal gl-temp5 < 2)	;not enough spaces
	(up-compare-goal point2-y g:> gl-temp3)		;not last column yet
	(up-compare-goal point2-x g:<= gl-temp2)	;but has reached the end of the current column
=>
	(up-modify-goal point2-x g:= point1-x)	;reset to center
	(up-modify-goal point2-x c:+ 1)	;get it back to the top
	(up-modify-goal point2-y c:- 1)	;shift it over one
	(up-jump-rule -3)
)

(defrule
	(up-set-target-by-id g: gl-temp1)
	(up-set-target-object search-remote c: 0)
	
	(up-compare-goal gl-temp5 < 2)	;not enough spaces	
	(up-compare-goal gl-temp4 < 40)	;not enough trees checked yet
=>
;	;;(up-chat-data-to-all "not enough spaces found around tree(%d)" g: gl-temp4)
	(up-remove-objects search-remote -1 == 0)
	(up-modify-goal gl-temp4 c:+ 1)
	(set-goal gl-temp5 0)	;reset
	(up-jump-rule -5)
)

(defrule
	(up-set-target-by-id g: gl-temp1)
	(up-set-target-object search-remote c: 0)
	
	(up-compare-goal gl-temp5 >= 2)	;enough spaces found next to the tree
=>
	(up-add-object-by-id search-local g: gl-temp1)
	(up-target-objects 1 action-default -1 -1)
	;;(chat-to-all "old target new tree")
	
	(up-get-point position-object point1-x)
;	;(up-send-flare point1-x)
)
;end main jump











	




(defrule
	(unit-type-count knight-line >= 1)
=>
	(up-full-reset-search)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-find-remote c: mangonel-line c: 10)
	(up-set-target-point estimated-enemy-x)
	(up-remove-objects search-remote 44 < 7)
	(up-set-target-point home-x)
	(up-clean-search search-remote 44 search-order-asc)
)

(defrule
	(goal gl-fifth-turn 1)
	(unit-type-count knight-line >= 1)
	(up-set-target-object search-remote c: 0)
=>		
	;;(chat-to-all "attack mangonel with knights")
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	(up-filter-distance c: -1 c: 20)
	(up-find-local c: knight-line c: 20)
	(up-clean-search search-local 44 1)
	(up-remove-objects search-local object-data-attack-stance == no-attack)
	(up-remove-objects search-local object-data-target == battering-ram)
	(up-remove-objects search-local object-data-target == mangonel)
	(up-remove-objects search-local -1 > 1)
	(up-target-objects 1 action-default -1 -1)
)

