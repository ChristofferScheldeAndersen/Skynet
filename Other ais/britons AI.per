;qcancel forward castle
(defrule
	(goal gl-strategy-style longbows)
	(goal gl-cancel-forward-castle -1)
=>
	(set-goal gl-cancel-forward-castle 1)
)
	

(defrule
	(true)
	(or	(current-age < castle-age)
		(or	(military-population >= 15)
			(or	(goal gl-strategy-style longbows)
				(up-compare-flag gl-misc-flag1 == fl-attack))))
=>
	(up-jump-rule 3)
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point home-x)
;	(up-filter-distance c: -1 c: 30)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-filter-include cmdid-military -1 -1 -1)
	(up-find-remote c: -1 c: 40)
)

(defrule
	(military-population >= 5)
	(goal gl-cancel-forward-castle 1)
	(timer-triggered t-castle-checking)
	(not(up-set-target-object search-remote c: 2))
=>
	;hi;(chat-to-all "allow forward castle again")
	(set-goal gl-cancel-forward-castle -1)
	(disable-timer t-castle-checking)
)

(defrule
	(goal gl-cancel-forward-castle -1)
	(or	(up-set-target-object search-remote c: 10)
		(or	(and(military-population < 8)
				(up-set-target-object search-remote c: 5))
			(and(military-population < 4)
				(up-set-target-object search-remote c: 3))))
=>
	(set-goal gl-cancel-forward-castle 1)
	(enable-timer t-castle-checking 120)
	;(chat-to-all "no forward castle")
)
;end jump

;delete forward foundation if there is one and stop builders-- only delete the foundation below 10 percent
(defrule
	(true)
	(goal gl-cancel-forward-castle 1)
=>
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance c: 30 c: -1)	;search not near your base
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: castle c: 10)
)

(defrule
	(goal gl-cancel-forward-castle 1)
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-maxhp gl-temp1)
	(up-get-object-data object-data-hitpoints gl-temp2)
	(up-modify-goal gl-temp2 c:* 100)	;give a whole number
	(up-modify-goal gl-temp2 g:/ gl-temp1)
	;hi;(up-chat-data-to-all "percent completion: %d" g: gl-temp2)
	(up-get-object-data object-data-hitpoints gl-temp1)   ;
)

(defrule
;	(false)
	(or	(up-compare-goal gl-temp1 < 500)	;low hp
		(up-compare-goal gl-temp2 < 20))	;low completion
	(goal gl-cancel-forward-castle 1)
	(up-set-target-object search-local c: 0)
	(up-timer-status t-pause-castle-deletes != timer-running)
=>
	(up-get-object-data object-data-id gl-temp1)
	(up-target-point 0 action-delete -1 -1)
	(up-full-reset-search)
	(up-find-local c: villager-class c: 100)
	(up-remove-objects search-local object-data-action != actionid-build)
	(up-remove-objects search-local object-data-target-id g:!= gl-temp1)
	(up-target-point 0 action-stop -1 -1)
	(up-modify-goal gl-castle-deletes-consecutive c:max 0) 
	(up-modify-goal gl-castle-deletes-consecutive c:+ 1) 
	;hi;(up-chat-data-to-all "delete forward castle foundation(%d)" g: gl-castle-deletes-consecutive)
)

(defrule	
	(timer-triggered t-check-consecutive-deletes-castle)
=>
	(disable-timer t-check-consecutive-deletes-castle)
	;hi;(chat-to-all "reset consecutive deletes goal")
	(set-goal gl-castle-deletes-consecutive 0)
)

(defrule
	(up-compare-goal gl-castle-deletes-consecutive > 0)
	(up-timer-status t-check-consecutive-deletes-castle != timer-running)
=>
	(enable-timer t-check-consecutive-deletes-castle 30)
	;hi;(chat-to-all "consec timer")
)

(defrule
	(up-compare-goal gl-castle-deletes-consecutive >= 2)	;within 30 secs
	(up-timer-status t-pause-castle-deletes != timer-running)
=>
	;hi;(chat-to-all "pause deleting castles for a while")
	(enable-timer t-pause-castle-deletes 60)
)






























