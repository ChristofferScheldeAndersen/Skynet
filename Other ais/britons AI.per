)

(defrule
	(up-compare-goal gl-temp1 < 80)
	(up-can-build 0 g: gl-walling-building)
	(up-point-explored counterclockwise-walling-x != explored-no)
	(not(up-can-build-line 0 counterclockwise-walling-x g: gl-walling-building))
	(or	(up-compare-goal counterclockwise-walling-x g:!= counterclockwise-next-vertex-x)
		(up-compare-goal counterclockwise-walling-y g:!= counterclockwise-next-vertex-y))
=>
	(up-lerp-tiles counterclockwise-walling-x counterclockwise-next-vertex-x c: 1)
;	;(up-send-flare counterclockwise-walling-x)
	(up-modify-goal gl-temp1 c:+ 1)
	(up-jump-rule -1)
)

(defrule
	(goal gl-just-skipped-edge-vertex -1)
	(goal gl-walling-building palisade-wall)
	(up-can-build-line 0 counterclockwise-walling-x g: gl-walling-building)
=>
