;scout enemy
(defrule
	(or	(goal gl-deer 100)
		(players-current-age target-player >= feudal-age))
	(up-compare-flag gl-misc-flag1 != fl-scout-enemy-base)
=>
	(up-modify-flag gl-misc-flag1 c:+ fl-scout-enemy-base)
	;hi;(chat-to-all "time to scout enemy base")
	(set-goal gl-deer 100)
	(disable-self)
)
	
(defrule	;cross around town center
	(goal gl-fifth-turn 1)
	(up-timer-status t-scout-busy != timer-running)
	(up-compare-flag gl-misc-flag1 == fl-scout-enemy-base)
=>
	(up-copy-point point1-x estimated-enemy-x)
	(up-lerp-tiles point1-x scout-x c: 14)
	(up-cross-tiles point1-x estimated-enemy-x c: 7)
	(up-bound-point point1-x point1-x)

	(up-full-reset-search)
	(up-find-local c: scout-cavalry-line c: 1)
	(up-bound-point point1-x point1-x)
	(up-target-point point1-x action-move -1 no-attack)
;	;;(chat-to-all "enemycross")
;	;(up-send-flare point1-x)
)

(defrule	
	(up-compare-flag gl-misc-flag1 == fl-scout-enemy-base)
	(or	(unit-type-count scout-cavalry-line < 1)
		(or	(players-building-type-count target-player stable >= 1)
			(or	(players-building-type-count target-player castle >= 1)
				(or	(players-building-type-count target-player stone-wall >= 1)
					(players-building-type-count target-player archery-range >= 1)))))
=>
	(up-modify-flag gl-misc-flag1 c:- fl-scout-enemy-base)
	(up-send-scout group-type-land-explore scout-center)
	;hi;(chat-to-all "stop scouting enemy base")
	(disable-self)
)

