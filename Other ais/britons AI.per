;if you've paused on a boar, attack it again once it gets under the tc
(defrule
	(or	(game-time < 10)
		(or	(goal boar-original-x -1)
			(up-compare-flag gl-misc-flag2 != fl-boring-pause)))
=>
	(up-jump-rule 5)
)

(defrule
	(true)
=>
	(set-goal gl-temp1 -1)
	
	(up-full-reset-search)
	(up-copy-point point1-x home-x)
;	(up-lerp-tiles point1-x boar-original-x c: -1)
	;(up-send-flare point1-x)
	;(up-send-flare boar-original-x)
	(up-set-target-point point1-x)
;	(up-filter-distance c: -1 c: 2)
	(up-find-resource c: boar-class c: 10)
	(up-remove-objects search-remote 44 >= 3)
	(up-clean-search search-remote object-data-hitpoints 1)
)

(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-temp1)
	(up-find-local c: villager-class c: 60)
	(up-remove-objects search-local object-data-group-flag != miscfoodgroup)
	(up-remove-objects search-local object-data-target-id g:== gl-temp1)
	(up-remove-objects search-local object-data-id g:== gl-current-boar-target-id)
	(up-remove-objects search-local object-data-action == actionid-build)(up-remove-objects search-local object-data-action == actionid-attack)
)

(defrule
	(up-set-target-object search-local c: 0)
	(up-set-target-by-id g: gl-temp1)	;
=>
	(up-modify-flag gl-misc-flag2 c:- fl-boring-pause)
	(up-target-objects 1 action-default -1 -1)
	;hi2;(chat-to-all "kill boar 2")
)

(defrule
	(true)
=>	
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance c: -1 c: 10)
	(up-find-resource c: boar-class c: 10)
)

(defrule
	(not(up-set-target-object search-remote c: 0))
=>
	(up-modify-flag gl-misc-flag2 c:- fl-boring-pause)
	;hi2;(chat-to-all "boar dead anyway 1")
)
