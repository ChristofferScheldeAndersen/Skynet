(defrule	;third house
	(or (goal gl-strategy -1)
		(or	(and(goal gl-time-to-build-mill -1)
				(and(up-compare-goal gl-strategy != drush)
					(up-compare-goal gl-strategy != scrush)))
			(or	(and(goal gl-strategy drush)
					(unit-type-count villager != 12))
				(or	(and(goal gl-strategy scrush)
						(unit-type-count villager != 11))
					(building-type-count-total house > 2)))))
=>
	(up-jump-rule 4)
)

