	(up-modify-goal gl-temp1 g:= gl-current-food-amount)
	(up-modify-goal gl-temp1 g:- gl-amount-saving-food)
	(up-setup-cost-data 1 gl-temporary-cost-food)
	(up-add-object-cost c: scout-cavalry-line c: 1)
)

;fccastle
(defrule
;	(goal gl-saving-food -1)
	(or	(goal gl-saving-food -1)
		(or	(up-compare-goal gl-temp1 g:>= gl-temporary-cost-food) 
			(up-pending-objects c: scout-cavalry-line g:< gl-allowed-pending-units-saving)))
	(goal gl-strategy fccastle)
	(can-train scout-cavalry-line)
	(up-compare-goal gl-add-scouts != -1)
	(or (unit-type-count-total scout-cavalry-line < 2)
		(or	(and(up-compare-goal gl-add-scouts >= lategame)
				(unit-type-count-total scout-cavalry-line < 40))
			(and(up-compare-goal gl-add-scouts >= normal)
				(unit-type-count-total scout-cavalry-line < 7))))
	(or	(up-compare-goal gl-add-scouts < normal)
		(up-research-status c: ri-light-cavalry >= research-pending))
	(or	(up-compare-goal gl-saving-overhead-food >= 200)
		(or	(current-age < imperial-age)
			(or	(up-compare-goal gl-scouts-trained < 40)
				(up-research-status c: ri-plate-barding >= research-pending))))
=>
	;hi;(chat-to-all "train scout 3")
	(train scout-cavalry-line)
	(up-modify-goal gl-scouts-trained c:+ 1)
)

