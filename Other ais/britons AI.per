;	(false)
	(up-compare-goal gl-enemy-wall-breachage >= 3)
=>
	(up-remove-objects search-remote object-data-class == gate-class)
)

(defrule
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class == gate-class)
=>		
	(up-get-point position-object point1-x)
	(up-find-local c: packed-trebuchet-class c: 20)
	(up-find-local c: unpacked-trebuchet-class c: 20)
	(up-set-target-point point1-x)
	(up-remove-objects search-local 44 < 14)
)

(defrule
	(goal gl-fifth-turn 1)
	(up-set-target-object search-local c: 0)
	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class == gate-class)
=>		
	(up-target-point point1-x action-move -1 no-attack)
	;hi;(chat-to-all "move to gate with trebs first")
	;(up-send-flare point1-x)
)

(defrule
	(up-set-target-object search-remote c: 0)
=>		
	(up-reset-search 1 1 0 0)
	(up-get-object-data object-data-id gl-temp1)
	(up-find-local c: packed-trebuchet-class c: 20)
	(up-find-local c: unpacked-trebuchet-class c: 20)
	(up-remove-objects search-local object-data-target-id g:== gl-temp1)
