	(can-build market)
;	(goal gl-fifth-turn 1)
	(goal gl-opening-type fc)
	(building-type-count-total market < 1)
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))
=>
	(set-goal gl-walling-building market)
	;hi;(chat-to-all "market")
)

;qsmith	qbs qblacksmith
(defrule
	(goal gl-fifth-turn 1)
	(can-build blacksmith)
	(goal gl-strategy scrush)
	(building-type-count-total farm >= 14)
	(building-type-count-total blacksmith < 1)
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))
=>
	(set-goal gl-walling-building blacksmith)
	;hi;(chat-to-all "blacksmith")
)

(defrule
;	(goal gl-fifth-turn 1)
	(can-build blacksmith)
	(goal gl-opening-type fc)
	(building-type-count-total market >= 1)
	(building-type-count-total blacksmith < 1)
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))
=>
	(set-goal gl-walling-building blacksmith)
	;hi;(chat-to-all "blacksmith 2")
;	(disable-self)
)

;qrange qarchery range
;barbecue
(defrule
	(can-build range)
	(goal gl-strategy barbecue)
	(goal gl-walling-building -1)
	(or	(goal gl-saving-wood -1)
		(goal gl-saving-wood range))
	(or	(building-type-count-total range < 2)
		(or	(and(unit-type-count villager >= 50)
				(building-type-count-total range < 3))
			(and(building-type-count-total range < 5)
				(up-research-status c: imperial-age >= research-pending))))
=>
	(set-goal gl-walling-building range)
	;hi;(chat-to-all "barbecue range")
)


;fccastle
(defrule
	(can-build range)
	(up-compare-goal gl-strategy-style != longbows)
	(goal gl-strategy fccastle)
	(goal gl-walling-building -1)
	(or	(goal gl-saving-wood -1)
		(goal gl-saving-wood range))
	(building-type-count-total tc >= 3)
	(up-compare-goal gl-add-archers != -1)
	(or	(building-type-count-total archery-range < 1)
		(and(unit-type-count villager >= 65)
			(up-compare-goal gl-add-archers >= normal)))	;only one range till enough eco and you are committed
	(or	(building-type-count-total range < 2)
		(or	(and(unit-type-count villager >= 90)
				(building-type-count-total range < 3))
			(and(building-type-count-total range < 5)
				(up-research-status c: imperial-age >= research-pending))))
=>
	(set-goal gl-walling-building range)
	;hi;(chat-to-all "archer range")
)

(defrule
	(up-compare-goal gl-strategy-style != longbows)
	(goal gl-strategy fccastle)
	(can-build archery-range)
	(goal gl-walling-building -1)
	(building-type-count-total tc >= 3)
	(up-compare-goal gl-add-skirms != -1)
	(or	(building-type-count-total archery-range < 1)
		(and(unit-type-count villager >= 65)
			(up-compare-goal gl-add-skirms >= normal)))
	(or	(building-type-count-total archery-range < 2)
		(or	(and(unit-type-count villager >= 83)
				(building-type-count-total archery-range < 4))
			(and(building-type-count-total archery-range < 5)
				(up-research-status c: imperial-age >= research-pending))))
=>
	(set-goal gl-walling-building range)
	;hi;(chat-to-all "skirm range")
)

;scrush
(defrule
	(goal gl-fifth-turn 1)
	(can-build archery-range)
	(goal gl-strategy scrush)
	(building-type-count-total farm >= 10)
	(building-type-count-total archery-range < 1)
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))
=>
	(set-goal gl-walling-building archery-range)
	;hi;(chat-to-all "archery-range")
)

;qstable
(defrule
	(can-build stable)
	(goal gl-walling-building -1)
	(up-compare-goal gl-add-scouts != -1)
	(or	(game-time >= 1380)		;23min
		(building-type-count-total tc >= 3))
	(or	(unit-type-count villager >= 55)
		(building-type-count-total stable < 1))
	(or	(building-type-count-total stable < 1)
		(up-compare-goal gl-add-scouts >= normal))
	(or	(building-type-count-total stable < 2)
		(or	(and(up-compare-goal gl-add-scouts >= lategame)
				(building-type-count-total stable < 8))
			(or	(and(unit-type-count villager >= 70)
					(building-type-count-total stable < 2))
				(and(building-type-count-total stable < 2)
					(up-research-status c: imperial-age >= research-pending)))))		;just 2 for now
=>
	(set-goal gl-walling-building stable)
	;hi;(chat-to-all "scouts stable")
)

(defrule
	(can-build stable)
	(goal gl-walling-building -1)
	(building-type-count-total tc >= 3)
	(up-compare-goal gl-add-knights != -1)
	(or	(unit-type-count villager >= 65)
		(building-type-count-total stable < 1))	;only one if eco is weak
	(or	(building-type-count-total stable < 1)
		(up-compare-goal gl-add-knights != light))	;if it is light commit, stay on one stable
	(or	(building-type-count-total stable < 2)
		(or	(and(unit-type-count villager >= 70)
				(building-type-count-total stable < 4))
			(and(building-type-count-total stable < 5)
				(up-research-status c: imperial-age >= research-pending))))
=>
	(set-goal gl-walling-building stable)
	;hi;(chat-to-all "knights stable")
)

(defrule
	(can-build stable)
	(goal gl-fifth-turn 1)
	(goal gl-strategy scrush)
	(up-pending-objects c: stable < 1)
	(building-type-count-total stable < 1)
	(or	(goal gl-walling-building -1)
		(goal gl-walling-building palisade-wall))
=>
	(set-goal gl-walling-building stable)
	;hi;(chat-to-all "stable")
)

(defrule
	(false)
	(can-build stable)
	(building-type-count-total stable < 1)
	(up-research-status c: castle-age >= research-pending)
=>
	(up-set-placement-data my-player-number -1 c: -10)
	(up-build place-control 0 c: stable)
)	

(defrule
	(false)
	(can-build stable)
	(building-type-count-total stable < 1)
=>
	(up-copy-point point1-x home-x)
	(up-lerp-tiles point1-x estimated-enemy-x c: -9)
	(up-cross-tiles point1-x home-x c: 3)
	(set-goal gl-temp1 0)
)

(defrule
	(false)
	(can-build stable)
	(up-compare-goal gl-temp1 < 20)
	(building-type-count-total stable < 1)
	(not(up-can-build-line 0 point1-x c: stable))
=>
	(up-cross-tiles point1-x home-x c: -2)
	(up-modify-goal gl-temp1 c:+ 1)
	(up-jump-rule -1)
)

(defrule
	(false)
	(can-build stable)
	(up-compare-goal gl-temp1 < 20)
	(building-type-count-total stable < 1)
=>
	(up-build-line point1-x point1-x c: stable)
	;;(chat-to-all "stable")
)

(defrule
	(false)
	(can-build stable)
	(civilian-population >= 45)
	(up-pending-objects c: stable < 1)
	(up-pending-objects c: scorpion >= 1)
	(building-type-count-total stable == 1)
	(building-type-count siege-workshop >= 1)
	(up-research-status c: ri-forging >= research-pending)
=>
	(up-set-placement-data my-player-number -1 g: gl-building-placement-control)
	(up-build place-control 0 c: stable)
)

