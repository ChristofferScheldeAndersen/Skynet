	(can-build lumber-camp)
	(current-age-time >= 360)
	(current-age >= imperial-age)
	(goal gl-dropsite-to-build -1)
=>
	(set-goal gl-dropsite-to-build lumber-camp)
	;hi;(chat-to-all "lategame lc2")
	(disable-self)
)

(defrule
	(true)
=>
	(up-full-reset-search) 
;	(up-find-local c: villager-class c: 100)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: lumber-camp c: 1)
;	(up-remove-objects search-local object-data-group-flag != miscwoodgroup)
)

(defrule
	(game-time >= 10)
	(can-build lumber-camp)
	(current-age >= feudal-age)
	(goal gl-dropsite-to-build -1)
	(building-type-count lumber-camp < 1)
	(not(up-set-target-object search-local c: 0))
=>
	(set-goal gl-dropsite-to-build lumber-camp)
	;hi;(chat-to-all "backup lc")
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: town-center c: 1)
)

(defrule
	(up-set-target-object search-local c: 0)
	(up-object-data object-data-progress-value >= 60)

	(can-build lumber-camp)
	(or	(unit-type-count villager >= 6)
		(and(or	(goal gl-strategy drush)
				(goal gl-strategy scrush))
			(unit-type-count villager >= 6)))
	(building-type-count-total lumber-camp < 1)
=>
	(set-goal gl-dropsite-to-build lumber-camp)
	(disable-self)
)	

(defrule
	(false)
	(can-build lumber-camp)
	(goal gl-dropsite-to-build -1)
	(unit-type-count villager >= 20)
=>
	(set-goal gl-dropsite-to-build lumber-camp)
	(disable-self)
)	

(defrule
	(can-build lumber-camp)
	(goal gl-dropsite-to-build -1)
	(or	(game-time >= 1380)	;23 min
		(and(game-time >= 1170)	;19.5 min
			(up-compare-goal gl-strategy != fccastle)))
	(up-research-status c: castle-age >= research-pending)
=>
	(set-goal gl-dropsite-to-build lumber-camp)
	(disable-self)
)	

(defrule
	(game-time >= 1890)	;31.5 min
	(can-build lumber-camp)
	(goal gl-dropsite-to-build -1)
	(up-research-status c: castle-age >= research-pending)
=>
	(set-goal gl-dropsite-to-build lumber-camp)
	(disable-self)
)	


















;qmarket
