;qvillagers qvills qvils
(defrule
	(true)
=>
	(set-strategic-number sn-enable-training-queue 1)
	(disable-self)
)

(defrule
	(false)
	(up-research-status c: feudal-age >= research-pending)
=>
	(set-strategic-number sn-enable-training-queue 0)
	(disable-self)
)

(defrule
	(up-research-status c: ri-loom >= research-pending)
=>
	(set-strategic-number sn-enable-training-queue 1)
	(disable-self)
)

(defrule	;get loom if under attack
	(up-compare-goal gl-under-attack > -1)
	(up-research-status c: ri-loom < research-pending)			
=>
	(up-jump-rule 6)
)

(defrule	;stop vills for loom during forward castle
	(goal gl-strategy fccastle)
	(or	(building-type-count-total castle >= 2)	;not first
		(and(stone-amount >= 600)
			(building-type-count-total castle >= 1)))	;but also if there's one and almost enough for second
	
	(up-research-status c: ri-loom < research-pending)			
=>
	(up-jump-rule 5)
)

(defrule	;stop vills for handcart/wheelbarrow
	(or (building-type-count tc < 3)
		(up-pending-objects c: villager >= 2))
	(or	(goal gl-saving-food ri-hand-cart)
		(or	(goal gl-saving-food ri-wheel-barrow)
			(or	(and(building-type-count farm >= 34)
					(up-research-status c: ri-hand-cart < research-pending))
				(and(building-type-count farm >= 23)
					(up-research-status c: ri-wheel-barrow < research-pending)))))		
=>
	(up-jump-rule 4)
)

(defrule	;don't train vills if you can go up
	(food-amount >= 650)
	(gold-amount >= 140)
	(up-compare-goal gl-opening-type != fc)
	(up-research-status c: castle-age < research-pending)
=>
	(up-jump-rule 3)
)

(defrule
	(or	(and(food-amount >= 950)
			(gold-amount >= 350))
		(or	(and(food-amount >= 750)
				(gold-amount >= 600))
			(and(food-amount >= 400)
				(gold-amount >= 750))))
	(up-research-status c: imperial-age < research-pending)
=>
	(up-jump-rule 2)
)

(defrule
	(can-train villager)
	(goal gl-opening-type ff)
	(unit-type-count-total villager < 120)
	(or	(up-compare-flag gl-misc-flag1 != fl-drushed)
		(up-research-status c: ri-loom >= research-pending))
	(or	(up-research-status c: feudal-age >= research-pending)
		(and(current-age == dark-age)
			(and(up-research-status c: feudal-age < research-pending)
				(unit-type-count-total villager g:< gl-number-dark-age-vills))))
=>
	(enable-timer t-villager 20)	;maybe don't use due to queueing irregularity
	(train villager)
)

(defrule
	(can-train villager)
	(goal gl-opening-type fc)
	(unit-type-count-total villager < 120)
	(or	(up-compare-flag gl-misc-flag1 != fl-drushed)
		(up-research-status c: ri-loom >= research-pending))
	(or	(current-age >= castle-age)
		(or	(and(current-age == dark-age)
				(unit-type-count-total villager g:< gl-number-dark-age-vills))
			(and(up-research-status c: feudal-age >= research-pending)
					(unit-type-count-total villager g:< gl-number-feudal-age-vills))))
=>
	(enable-timer t-villager 20)	;maybe don't use due to queueing irregularity
	(train villager)
)
