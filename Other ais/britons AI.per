=>
	(set-strategic-number sn-maximum-town-size 30)
	(enable-timer t-tsa 35)
	;;(chat-to-all "tsa off")
)

(defrule
	(false)
	(up-compare-flag gl-misc-flag1 == fl-attack)
	(timer-triggered t-tsa)
	(strategic-number sn-maximum-town-size == 30)
=>
	(set-strategic-number sn-maximum-town-size 1000)
	(enable-timer t-tsa 9)
	;;(chat-to-all "tsa on")
)

(defrule	;you have to be behind in superiority, with either a castled opponent or a low military pop
;	(false)
	(goal gl-strategy norman)
	(up-compare-flag gl-misc-flag1 == fl-attack)
	(military-population < 25)
	(up-compare-goal gl-temp2 < -2)	;don't have superiority...
;	(or	(and(unit-type-count trebuchet-set < 1)
;			(players-building-type-count target-player castle >= 1))
	(or	(unit-type-count knight-line < 1)	;...and military population is low
		(or	(and(military-population < 5)
				(up-compare-flag gl-misc-flag1 == fl-enemy-flushing))
			(and(players-current-age-time target-player >= 30)	;...or target is in castle
				(players-current-age target-player >= castle-age))))
=>
	(set-strategic-number sn-maximum-town-size 30)
	(up-full-reset-search)
	(up-filter-include cmdid-military -1 -1 -1)
	(up-find-local c: -1 c: 40)
	(up-remove-objects search-local object-data-base-type == scout-cavalry)
	(up-remove-objects search-local object-data-base-type == scorpion)
	(up-copy-point point1-x home-x)
	(up-lerp-tiles point1-x estimated-enemy-x c: 10)
	(up-target-point point1-x action-move -1 no-attack)
	(up-full-reset-search)
	(up-find-local c: scorpion-line c: 40)
	(up-target-point point1-x action-move -1 no-attack)
	;hi;(chat-to-all "retreat")
	(up-modify-flag gl-misc-flag1 c:- fl-attack)
	(disable-timer t-tsa)
)

(defrule
	(true)
=>
	(set-goal gl-temp1 15)
	(set-goal gl-temp2 -1)
)

(defrule
	(military-population >= 15)
=>
	(set-goal gl-temp1 22)
)

(defrule
	(up-compare-flag gl-misc-flag1 == fl-attack)
=>
	(set-goal gl-temp2 25)	;only near town when attacking
)

(defrule
	(up-compare-goal gl-under-attack != -1)
=>
	(set-goal gl-temp2 15)	;only very close when under attack
)

(defrule	;anti-luring
	(up-compare-flag gl-misc-flag1 != fl-attack)
	(goal gl-anti-luring -1)
	(goal gl-strategy norman)
=>
	(up-full-reset-search)
	(up-set-target-point estimated-enemy-x)
	(up-filter-distance c: -1 c: 26)
	(up-filter-include cmdid-military -1 -1 -1)
	(up-find-local c: -1 c: 100)
	(up-remove-objects search-local object-data-base-type == scout-cavalry)
)

(defrule
;	(false)
	(goal gl-strategy norman)
	(goal gl-anti-luring -1)
	(up-set-target-object search-local c: 0)
	(up-compare-flag gl-misc-flag1 != fl-attack)
=>
	;hi;(chat-to-all "retreat to prevent luring")
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance c: -1 c: -1)
	(up-filter-include cmdid-military -1 -1 -1)
	(up-find-local c: -1 c: 100)
	(up-remove-objects search-local object-data-base-type == scout-cavalry)
	(up-remove-objects search-local object-data-class == infantry-class)
	(up-remove-objects search-local object-data-base-type == scorpion)
	(up-copy-point point1-x home-x)
	(up-lerp-tiles point1-x estimated-enemy-x g: gl-temp1)
	(up-target-point point1-x action-move -1 no-attack)
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance c: -1 c: -1)	
	(up-find-local c: scorpion-line c: 40)
	(up-remove-objects search-local object-data-action != actionid-attack)
	(up-target-point point1-x action-move -1 no-attack)
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance c: -1 c: -1)	
	(up-find-local c: infantry-class c: 40)
	(up-target-point point1-x action-move -1 no-attack)
	(set-goal gl-anti-luring 1)
	(enable-timer t-anti-luring 20)
