	(up-find-remote c: crocodile c: 10)
	(up-find-remote c: komodo-dragon c: 10)
	(up-find-remote c: snow-leopard c: 10)
	(up-find-remote c: tiger c: 10)
	(up-find-remote c: lion c: 10)
	(up-find-remote c: jaguar c: 10)
	(up-find-remote c: wolf c: 10)
	(up-find-remote c: rabid-wolf c: 10)
	(up-find-remote c: dire-wolf c: 10)
	(up-remove-objects search-remote object-data-carry > 0)
	(up-clean-search search-remote -1 search-order-asc)
	
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(set-goal temp-gl-sorting-preference -1)
	(up-remove-objects search-remote object-data-id g:== gl-longbow-group-target1-id)
	(up-remove-objects search-remote object-data-id g:== gl-longbow-group-target2-id)
	(up-remove-objects search-remote object-data-id g:== gl-longbow-group-target3-id)
	(up-remove-objects search-remote object-data-id g:== gl-longbow-group-target4-id)
