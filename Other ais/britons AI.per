;build palisades
(defrule
	(false)
	(current-age == feudal-age) 
=>
	(enable-timer t-add-more-palisades 10)	;initialize the timer
	(disable-self)
)

(defrule
	(false)
	(goal gl-walling-building palisade-wall)
	(up-compare-goal gl-consecutive-palisades-built >= 11)
=>
	(set-goal gl-consecutive-palisades-built 0)
	(set-goal gl-walling-building-size -1)	
	(enable-timer t-add-more-palisades 1)
	(set-goal gl-walling-building -1)
	;;(chat-to-all "stop palisades")
	(acknowledge-taunt me 102)
)

(defrule
;	(or	(taunt-detected me 102)
;		(timer-triggered t-add-more-palisades))
	
	(goal gl-clockwise-builder-idle 1)
	(false)
	(goal gl-walling-building -1)
	(up-can-build 0 c: palisade-wall)
	(building-type-count-total stable >= 1)
	(up-compare-goal gl-walling-stage != 100)
	(up-compare-goal gl-walling-stage >= startwalling)
	(up-compare-goal gl-consecutive-palisades-built < 3)
=>
	(set-goal gl-walling-building palisade-wall)
	(set-goal gl-walling-building-size 1)
;	;;(chat-to-all "palisade")
)

(defrule	;initialize clockwise-walling-x, and next vertex index and position
	(up-compare-goal gl-walling-stage >= startwalling)	;stuff is initialized
=>
	(up-copy-point clockwise-walling-x front-vertex-x)
	(up-modify-goal gl-next-clockwise-vertex-x-index g:= gl-front-vertex-x-index)
	(up-modify-goal gl-next-clockwise-vertex-x-index c:+ 3)	;next -y
	(up-get-indirect-goal g: gl-next-clockwise-vertex-x-index clockwise-next-vertex-y)
	(up-modify-goal gl-next-clockwise-vertex-x-index c:- 1)	;next -x
	(up-get-indirect-goal g: gl-next-clockwise-vertex-x-index clockwise-next-vertex-x)
	
	(up-copy-point counterclockwise-walling-x front-vertex-x)
	(up-modify-goal gl-next-counterclockwise-vertex-x-index g:= gl-front-vertex-x-index)
	(up-modify-goal gl-next-counterclockwise-vertex-x-index c:- 1)	;last -y
	(up-get-indirect-goal g: gl-next-counterclockwise-vertex-x-index counterclockwise-next-vertex-y)
	(up-modify-goal gl-next-counterclockwise-vertex-x-index c:- 1)	;last -x
	(up-get-indirect-goal g: gl-next-counterclockwise-vertex-x-index counterclockwise-next-vertex-x)
	
	(set-goal gl-current-walling-direction clockwise)
	;;(chat-to-all "initialize actual-walling stuff")
	(set-goal gl-consecutive-palisades-built 0)
	(set-goal gl-consecutive-tiles-walled 0)
	(disable-self)
)

;side switcher
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active) 
	(up-find-status-local c: palisade-wall c: 40)
	(up-find-status-local c: house c: 40)
	(up-find-status-local c: barracks c: 40)
	(up-find-status-local c: stable c: 40)
	(up-remove-objects search-local object-data-group-flag != -2)
)
;don't switch sides if there are still buildings to group

(defrule
	(not(up-set-target-object search-local c: 0))
	(up-compare-goal gl-consecutive-tiles-walled >= 10)
	(goal gl-current-walling-direction counterclockwise)
	(up-compare-goal gl-walling-stage < almostreachedfinalvertex)
=>
;	;;(chat-to-all "switch walling direction to clockwise")
	(set-goal gl-current-walling-direction clockwise)
	(set-goal gl-consecutive-tiles-walled 0)
)

(defrule
	(false)
	(not(up-set-target-object search-local c: 0))
	(goal gl-current-walling-direction clockwise)
	(up-compare-goal gl-consecutive-tiles-walled >= 10)
	(up-compare-goal gl-walling-stage < almostreachedfinalvertex)
=>
;	;;(chat-to-all "switch walling direction to counterclockwise")
	(set-goal gl-current-walling-direction counterclockwise)
	(set-goal gl-consecutive-tiles-walled 0)
)

;final stages
(defrule
	(up-compare-goal gl-walling-stage == pastfirstvertex)
	(up-compare-goal gl-next-clockwise-vertex-x-index g:== gl-next-counterclockwise-vertex-x-index)
=>
	(set-goal gl-walling-stage almostreachedfinalvertex)
	;;(chat-to-all "walling almost done1")
	(set-goal gl-misc-vertex-skip -1)
	(disable-self)
)

(defrule
	(goal gl-misc-vertex-skip 1)	;skipped one more vertex after the last stage
	(up-compare-goal gl-walling-stage == almostreachedfinalvertex)
=>
	(set-goal gl-walling-stage reachedfinalvertex)
	;;(chat-to-all "walling almost done2")
)

(defrule	;walling point has reached next vertex, and clockwise is past counterclockwise, its done
	(up-compare-goal gl-walling-stage == reachedfinalvertex)
	(or	(and(goal gl-current-walling-direction clockwise)
			(and(up-compare-goal clockwise-walling-x g:== clockwise-next-vertex-x)
				(up-compare-goal clockwise-walling-y g:== clockwise-next-vertex-y)))
		(and(goal gl-current-walling-direction counterclockwise)
			(and(up-compare-goal counterclockwise-walling-x g:== counterclockwise-next-vertex-x)
				(up-compare-goal counterclockwise-walling-y g:== counterclockwise-next-vertex-y))))
	(up-compare-goal gl-next-clockwise-vertex-x-index g:> gl-next-counterclockwise-vertex-x-index)
=>
	(set-goal gl-walling-building-size -1)
	(set-goal gl-walling-building -1)
	(set-goal gl-walling-stage 100)
	;;(chat-to-all "walling done")
)


(defrule	;main jump
;	(goal gl-walling-building -1)
	(true)
=>
	(up-jump-rule 21)
)

(defrule
	(true)
=>
	(set-goal gl-temp1 0)
	(set-goal gl-temp2 1)
)

(defrule
	(goal gl-walling-building house)
=>
	(set-goal gl-temp2 2)
)

(defrule
	(or	(goal gl-walling-building stable)
		(or	(goal gl-walling-building barracks)
			(or	(goal gl-walling-building blacksmith)
				(goal gl-walling-building archery-range))))
=>
	(set-goal gl-temp2 3)
)

(defrule
	(up-compare-goal gl-current-walling-direction != clockwise)
=>
	(up-jump-rule 8)
)

(defrule
	(up-compare-goal gl-temp1 < 80)
	(up-can-build 0 g: gl-walling-building)
	(up-point-explored clockwise-walling-x != explored-no)
	(not(up-can-build-line 0 clockwise-walling-x g: gl-walling-building))
	(or	(up-compare-goal clockwise-walling-x g:!= clockwise-next-vertex-x)
		(up-compare-goal clockwise-walling-y g:!= clockwise-next-vertex-y))
=>
	(up-lerp-tiles clockwise-walling-x clockwise-next-vertex-x c: 1)
;	;(up-send-flare clockwise-walling-x)
	(up-modify-goal gl-temp1 c:+ 1)
	(up-jump-rule -1)
)

(defrule
	(goal gl-just-skipped-edge-vertex -1)
	(goal gl-walling-building palisade-wall)
	(up-can-build-line 0 clockwise-walling-x g: gl-walling-building)
;	(or	(and(up-compare-goal clockwise-walling-x > 0)	;not against an edge
;			(up-compare-goal clockwise-walling-x g:< gl-max-coordinate-value))
;		(and(up-compare-goal clockwise-walling-y > 0)
;			(up-compare-goal clockwise-walling-y g:< gl-max-coordinate-value)))
=>
	(up-build-line clockwise-walling-x clockwise-walling-x g: gl-walling-building)
	(up-modify-goal gl-consecutive-tiles-walled g:+ gl-temp2)
	(up-modify-goal gl-consecutive-palisades-built c:+ 1)
;	;;(chat-to-all "build palisade clockwise")
	(set-goal gl-walling-building-size -1)
	(set-goal gl-walling-building -1)
)

(defrule
	(goal gl-just-skipped-edge-vertex -1)
	(up-compare-goal gl-walling-building != palisade-wall)
	(up-can-build-line 0 clockwise-walling-x g: gl-walling-building)
=>
	(up-build-line clockwise-walling-x clockwise-walling-x g: gl-walling-building)
	(up-modify-goal gl-consecutive-tiles-walled g:+ gl-temp2)
	;;(chat-to-all "build wall building clockwise")
	(set-goal gl-consecutive-palisades-built 0)
	(set-goal gl-walling-building-size -1)
	(set-goal gl-walling-building -1)
)

;end upjump (not for now)

(defrule	;go to the next vertex if the walling point is close to the current next-x
	(up-compare-goal gl-walling-stage < reachedfinalvertex)
	(up-compare-goal clockwise-walling-x g:== clockwise-next-vertex-x)
	(up-compare-goal clockwise-walling-y g:== clockwise-next-vertex-y)
=>
;	;;(up-chat-data-to-all "get next clockwise vertex identical(%d)" g: gl-next-clockwise-vertex-x-index)
;	;;(up-chat-data-to-all "front-vertex-x: %d" g: front-vertex-x)
;	;;(up-chat-data-to-all "front-vertex-y: %d" g: front-vertex-y)
;	;;(up-chat-data-to-all "walling-x: %d" g: clockwise-walling-x)
;	;;(up-chat-data-to-all "walling-y: %d" g: clockwise-walling-y)
;	;;(up-chat-data-to-all "next-vertex-x: %d" g: clockwise-next-vertex-x)
;	;;(up-chat-data-to-all "next-vertex-y: %d" g: clockwise-next-vertex-y)
;	;(up-send-flare front-vertex-x)
;	;(up-send-flare clockwise-walling-x)
;	;(up-send-flare clockwise-next-vertex-x)
	
	(up-modify-goal gl-next-clockwise-vertex-x-index c:+ 3)	;next -y
	(up-get-indirect-goal g: gl-next-clockwise-vertex-x-index clockwise-next-vertex-y)
	(up-modify-goal gl-next-clockwise-vertex-x-index c:- 1)	;next -x
	(up-get-indirect-goal g: gl-next-clockwise-vertex-x-index clockwise-next-vertex-x)
	
	(up-modify-goal gl-walling-stage c:max pastfirstvertex)	;important for not ending immediately
	(set-goal gl-misc-vertex-skip 1)
	
	;(up-send-flare clockwise-next-vertex-x)
;	;(up-send-flare clockwise-walling-x)
;	;(up-send-flare front-vertex-x)

;	(up-jump-rule -2)
)

(defrule	;reset the goalid loop if needed
	(up-compare-goal gl-next-clockwise-vertex-x-index > highest-wall-x-index)
=>
	(set-goal gl-next-clockwise-vertex-x-index lowest-wall-x-index)
	(up-copy-point clockwise-next-vertex-x lowest-wall-x-index)
	;(up-send-flare clockwise-next-vertex-x) 
	;;(chat-to-all "reset 2a")
	(do-nothing)
)

(defrule	;if clockwise-walling-x and the next vertex are against the edge of the map, move to the next vertex, and put the wall-x on the vertex before that
	(up-compare-goal gl-walling-stage < reachedfinalvertex)
	(or	(and(up-compare-goal clockwise-walling-x == 0)
			(up-compare-goal clockwise-next-vertex-x == 0))
		(or	(and(up-compare-goal clockwise-walling-y == 0)
				(up-compare-goal clockwise-next-vertex-y == 0))
			(or	(and(up-compare-goal clockwise-walling-x g:== gl-max-coordinate-value)
					(up-compare-goal clockwise-next-vertex-x g:== gl-max-coordinate-value))
				(and(up-compare-goal clockwise-walling-y g:== gl-max-coordinate-value)
					(up-compare-goal clockwise-next-vertex-y g:== gl-max-coordinate-value)))))
=>
;	;;(up-chat-data-to-all "get next vertex edge clockwise(%d)" g: gl-next-clockwise-vertex-x-index)
;	;;(up-chat-data-to-all "front-vertex-x: %d" g: front-vertex-x)
;	;;(up-chat-data-to-all "front-vertex-y: %d" g: front-vertex-y)
;	;;(up-chat-data-to-all "walling-x: %d" g: clockwise-walling-x)
;	;;(up-chat-data-to-all "walling-y: %d" g: clockwise-walling-y)
;	;;(up-chat-data-to-all "next-vertex-x: %d" g: clockwise-next-vertex-x)
;	;;(up-chat-data-to-all "next-vertex-y: %d" g: clockwise-next-vertex-y)
;	;(up-send-flare front-vertex-x)
;	;(up-send-flare clockwise-walling-x)
;	;(up-send-flare clockwise-next-vertex-x)
	
	(up-copy-point clockwise-walling-x clockwise-next-vertex-x)
	(up-modify-goal gl-next-clockwise-vertex-x-index c:+ 3)	;next -y
	(up-get-indirect-goal g: gl-next-clockwise-vertex-x-index clockwise-next-vertex-y)
	(up-modify-goal gl-next-clockwise-vertex-x-index c:- 1)	;next -x
	(up-get-indirect-goal g: gl-next-clockwise-vertex-x-index clockwise-next-vertex-x)

	(set-goal gl-just-skipped-edge-vertex 1)
	(set-goal gl-misc-vertex-skip 1)
	
	;(up-send-flare clockwise-next-vertex-x)
;	;(up-send-flare clockwise-walling-x)
;	;(up-send-flare front-vertex-x)

;	(up-jump-rule -3)
	(up-jump-rule 1)
)

(defrule
	(goal gl-just-skipped-edge-vertex 1)
=>
	(set-goal gl-just-skipped-edge-vertex -1)
)

(defrule	;reset the goalid loop if needed (with added control of changing clockwise-walling-x since you are skippng a vertex) (put it on the one before)
	(up-compare-goal gl-next-clockwise-vertex-x-index > highest-wall-x-index)
=>
	(set-goal gl-next-clockwise-vertex-x-index lowest-wall-x-index)
	(up-copy-point clockwise-next-vertex-x lowest-wall-x-index)
	(up-copy-point clockwise-walling-x highest-wall-x-index)
	;(up-send-flare clockwise-next-vertex-x) 
	;(up-send-flare clockwise-walling-x) 
	;;(chat-to-all "reset 2b")
	(do-nothing)
)
;end clockwise jump

(defrule
	(up-compare-goal gl-current-walling-direction != counterclockwise)
=>
