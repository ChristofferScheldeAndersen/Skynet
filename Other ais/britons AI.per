(defrule	;main small upjump target
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance g: gl-temp11 g: gl-temp12)	;need a gradually expanding limited radius to get around the 40 object limit of remote list.
	(set-strategic-number sn-focus-player-number 0)
	(up-find-remote g: gl-resource-to-find c: 40)
)

(defrule	;small jump target
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point1-x)		;potential center point of future scan
	(up-set-target-point point1-x)
	(up-filter-distance c: -1 c: 7)
	(up-find-local c: tc c: 10)
	(up-find-local g: gl-dropsite-to-build c: 10)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: tcf c: 10)
	(up-find-status-local g: gl-dropsite-to-build c: 10)
;	;(up-send-flare point1-x)

	(up-filter-distance c: -1 c: 10)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-find-remote c: castle c: 10)
	(up-get-search-state lt)
	(up-remove-objects search-remote object-data-base-type == castle)
)

(defrule
;	(false)
	(goal gl-resource-to-find gold-mine-class)	;ignore nearby mcs on the other resource if there happen to be any
=>
	(up-remove-objects search-local object-data-group-flag == mctypestonegroup)
)

(defrule
;	(false)
	(goal gl-resource-to-find stone-mine-class)
=>
	(up-remove-objects search-local object-data-group-flag == mctypegoldgroup)
)

