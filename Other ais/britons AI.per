; ====== calculate
(defrule
	(up-compare-goal gl-longbow-group-size >= 1)
	(up-set-target-by-id g: gl-longbow-group-target1-id)
=>
	(up-modify-goal gl-temp3 g:= temp-gl-longbow-pierce-attack)
	(up-get-object-data object-data-pierce-armor gl-temp2)
	(up-modify-goal gl-temp3 g:- gl-temp2)	
	(up-modify-goal gl-temp3 c:max 1)		;damage per shot
	(up-get-object-data object-data-hp gl-temp2)
	(up-modify-goal gl-temp2 g:/ gl-temp3)
	(up-modify-goal gl-temp2 c:max 1)
	(up-modify-goal gl-temp2 c:+ 1)
	(up-modify-goal gl-temp2 c:+ 1)
	(up-modify-goal gl-longbows-number-of-shots-to-kill-target1 g:= gl-temp2)
)

