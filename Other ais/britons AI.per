;============= MOVE FINALLY 
(defrule
	(goal gl-fifth-turn 1)
	(or	(and(goal gl-sheep-scout-index 0)
			(up-compare-flag gl-scouting-flag != SKIP-FLAG-0))
		(or	(and(goal gl-sheep-scout-index 1)
				(up-compare-flag gl-scouting-flag != SKIP-FLAG-1))
			(and(goal gl-sheep-scout-index 2)
				(up-compare-flag gl-scouting-flag != SKIP-FLAG-2))))
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-current-sheep-scout-id)
	(up-lerp-tiles point2-x point1-x c: -4)
	(up-bound-point point2-x point2-x)
	(up-target-point point2-x action-move -1 -1)
;	;;(up-chat-data-to-all "move to point2-x 1(%d)" g: gl-temp2)
;	;(up-send-flare point2-x)
)

(defrule
	(goal gl-fifth-turn 1)
	(or	(and(goal gl-sheep-scout-index 3)
			(up-compare-flag gl-scouting-flag != SKIP-FLAG-3))
		(or	(and(goal gl-sheep-scout-index 4)
				(up-compare-flag gl-scouting-flag != SKIP-FLAG-4))
			(and(goal gl-sheep-scout-index 5)
				(up-compare-flag gl-scouting-flag != SKIP-FLAG-5))))
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-current-sheep-scout-id)
	(up-lerp-tiles point2-x point1-x c: -4)
	(up-bound-point point2-x point2-x)
	(up-target-point point2-x action-move -1 -1)
;	;;(up-chat-data-to-all "move to point2-x 2(%d)" g: gl-temp2)
;	;(up-send-flare point2-x)
)	

(defrule
	(up-compare-goal gl-sheep-scout-index >= 1)
=>
	(up-modify-goal gl-sheep-scout-index c:- 1)
	(up-jump-rule -35)	;DFGSDAFASDF
)
;end main jump asdsaddsfasf


