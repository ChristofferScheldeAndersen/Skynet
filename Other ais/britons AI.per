(defrule	;if the building is a castle, encourage building toward center		;enemy
	(goal gl-walling-building castle)
=>
	(set-goal gl-temp12 10)	;supply a distance for the threshold
	(up-get-point-distance point2-x center-x lt)	;estimated-enemy-x
	(up-copy-point point5-x home-x)			;point1 only used before the loop (actually not true, this could really mess up some stuff!!)
	(up-lerp-tiles point5-x estimated-enemy-x g: lt)	;point5 is now lt number of tiles away from home-x, toward enemy x
;	(up-lerp-percent point5-x center-x c: 50)	;get the point halfway between these two points
	(up-get-point-distance point2-x point5-x lt)	;score tiles in reference to the new point
	(up-modify-goal lt c:/ 2)	;not too much influence
