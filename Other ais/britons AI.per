    (true)
	(false)
=>
    (up-set-timer c: 50 c: 0)
    (up-get-timer c: 50 443)
)


;qelapsed
(defrule
    (true)
=>
    (up-get-precise-time gl-start-time1 gl-temp1)    ;get elapsed time since gl-start-time1 which is a timestamp
;	;(up-chat-data-to-all "elapsed: %d" g: gl-temp1)
	(up-modify-goal gl-log-clarity-progression c:+ 1)
	(up-log-data 0 "gl-log-clarity-progression: %d" g: gl-log-clarity-progression)
	(up-log-data 0 "elapsed: %d" g: gl-temp1)
)

