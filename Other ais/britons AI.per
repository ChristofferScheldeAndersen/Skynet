	(true)
=>
	(up-copy-point gl-side-reference-x-djsfalk home-x)
	(up-cross-tiles gl-side-reference-x-djsfalk center-x c: 10)
	;(up-send-flare gl-side-reference-x-djsfalk)
	(set-goal gl-temp13 0)
;	(disable-self)
)

;side switch upjump target
(defrule
	(goal gl-temp13 1)
=>
	(up-copy-point gl-side-reference-x-djsfalk home-x)
	(up-cross-tiles gl-side-reference-x-djsfalk center-x c: -10)
	;(up-send-flare gl-side-reference-x-djsfalk)
;	(disable-self)
)

;next, need to find blocked point along one side that is closest to the center without being in the front of the base
;set up a loop through all points, but skip any not walls

;seems like if we already have the side limit for extra wall we can skip this and just supply it.

(defrule
	(true)
=>
	(set-goal gl-half-square-side-length 30) ;temp7, half the side of the square area to scan
	(up-copy-point point1-x home-x)
	
	(up-copy-point point2-x point1-x)	
	(up-modify-goal point2-x g:+ gl-half-square-side-length)
	(up-modify-goal point2-y g:+ gl-half-square-side-length)	;checking point
	(up-copy-point point3-x point2-x)	;best point
	
	(up-modify-goal gl-temp1 g:= point1-x)
	(up-modify-goal gl-temp1 g:- gl-half-square-side-length)	;x limit
	(up-modify-goal gl-temp2 g:= point1-y)
	(up-modify-goal gl-temp2 g:- gl-half-square-side-length)	;y limit
	(set-goal gl-temp3 1000)	;current score
	(set-goal gl-temp4 0)	;best score

;	;(up-send-flare point1-x)
;	;(up-send-flare point2-x)
)

;start the checking process
;start both upjumps
(defrule
	(true)
=>
	(up-get-point-distance point2-x gl-side-reference-x-djsfalk gl-temp11)
	(up-get-point-distance front-point-x-djsfalk center-x gl-temp14)
	(up-modify-goal gl-temp14 c:+ 15)
)

(defrule
	(or	(up-point-distance point2-x center-x g:< gl-temp14)	;within 15 tiles of the front point's distance to the center
	(or	(up-point-distance point2-x home-x g:< gl-temp11)	;on the wrong side: tc is closer than the reference point
			(or	(and(not(up-point-contains point2-x c: wall-class))
					(not(up-point-contains point2-x c: gate-class)))
				(up-point-distance point2-x front-point-x-djsfalk < 15))))
=>
	(up-jump-rule 9)	;skip
)

;start inner loop to check around each wall tile for trees
(defrule
	(true)
=>
	(set-goal gl-half-square-side-length-djsfalk-djsfalk 1)
	(up-copy-point gl-point1-x-djsfalk-djsfalk point2-x)
	(up-copy-point gl-point2-x-djsfalk-djsfalk point2-x)	
	(up-modify-goal gl-point2-x-djsfalk-djsfalk g:+ gl-half-square-side-length-djsfalk-djsfalk)
	(up-modify-goal gl-point2-y-djsfalk-djsfalk g:+ gl-half-square-side-length-djsfalk-djsfalk)	;checking point
	(up-modify-goal gl-temp1-djsfalk-djsfalk g:= gl-point1-x-djsfalk-djsfalk)
	(up-modify-goal gl-temp1-djsfalk-djsfalk g:- gl-half-square-side-length-djsfalk-djsfalk)	;x limit
	(up-modify-goal gl-temp2-djsfalk-djsfalk g:= gl-point1-y-djsfalk-djsfalk)
	(up-modify-goal gl-temp2-djsfalk-djsfalk g:- gl-half-square-side-length-djsfalk-djsfalk)	;y limit
;	;(up-send-flare gl-point1-y-djsfalk-djsfalk)
;	;(up-send-flare gl-point2-x-djsfalk-djsfalk)
	(set-goal gl-temp5-djsfalk-djsfalk 0)	;tree counter
)

;start both upjumps
(defrule
;	(not(up-point-contains gl-point2-x-djsfalk-djsfalk c: wall-class))
;	(not(up-point-contains gl-point2-x-djsfalk-djsfalk c: gate-class))
;	(not(up-can-build-line 0 gl-point2-x-djsfalk-djsfalk c: palisade-wall))
	(up-point-contains gl-point2-x-djsfalk-djsfalk c: tree-class)
=>
	(up-modify-goal gl-temp5-djsfalk-djsfalk c:+ 1)
	(up-modify-goal gl-temp11 c:+ 1)
)

(defrule	;move down the column
	(up-compare-goal gl-point2-x-djsfalk-djsfalk g:> gl-temp1-djsfalk-djsfalk)	;if it is <=, time to reset 
=>
	(up-modify-goal gl-point2-x-djsfalk-djsfalk c:- 1)
;	;(up-send-flare gl-point2-x-djsfalk-djsfalk)
;	;;(chat-to-all "move point down column")
	(up-jump-rule -2)
)

(defrule	;move over a column
	(up-compare-goal gl-point2-y-djsfalk-djsfalk g:> gl-temp2-djsfalk-djsfalk)	;if it is <=, done with scan
	(up-compare-goal gl-point2-x-djsfalk-djsfalk g:<= gl-temp1-djsfalk-djsfalk)	;if it is <=, time to shift
=>
	(up-modify-goal gl-point2-x-djsfalk-djsfalk g:= gl-point1-x-djsfalk-djsfalk)
	(up-modify-goal gl-point2-x-djsfalk-djsfalk g:+ gl-half-square-side-length-djsfalk-djsfalk)	;get it back to the top
	(up-modify-goal gl-point2-y-djsfalk-djsfalk c:- 1)	;shift it over one
;	;(up-send-flare gl-point2-x-djsfalk-djsfalk)
;	;;(chat-to-all "reset column")
	(up-jump-rule -3)
)

(defrule
	(true)
;	(false)
=>
	(up-full-reset-search)
	(up-set-target-point point2-x)
;	(up-filter-distance c: -1 c: 1)
;	(up-find-resource c: tree-class c: 40)
	(up-filter-distance c: -1 c: 3)
	(up-find-resource c: tree-class c: 40)
	(up-get-search-state lt)
	
;	;(up-send-flare point2-x)
)

(defrule
	(true)
	(false)
;	(up-compare-goal rt >= 3)
;	(up-compare-goal rt >= 4)
	(up-compare-goal gl-temp5-djsfalk-djsfalk >= 2)	;tree found around the tile
=>
	(up-full-reset-search)
	(up-set-target-point point2-x)
;	(up-copy-point point8-x point2-x)
;	(up-modify-goal point8-x c:* 100)
;	(up-modify-goal point8-y c:* 100)
;	(up-set-precise-target-point point8-x)
	(up-filter-distance c: -1 c: 1)
	(up-find-local c: wall-class c: 10)
	(up-find-local c: gate-class c: 10)
	(up-clean-search search-local 45 1)
	(up-remove-objects search-local -1 > 1)
	(up-target-point 0 action-delete -1 -1)
	;;(chat-to-all "wall tile found")

;	(up-filter-distance c: -1 c: -1)
;	(up-find-resource c: tree-class c: 1)
;	(up-target-objects 1 action-delete -1 -1)
)

(defrule	;skip if not connected to forest
;	(or	
;	(up-compare-goal rl < 1)	;not touching a forest or...
;	(up-compare-goal rt < 1)
;	(false)
;	)	;...not a forest...
	(up-compare-goal gl-temp5-djsfalk-djsfalk < 2)
=>
	(up-jump-rule 2)	;...skip it
)

(defrule
	(true)
=>
	(up-get-point-distance point2-x center-x gl-temp5)
	(up-modify-goal gl-temp3 g:- gl-temp5)
)

(defrule
	(up-compare-goal gl-temp3 g:> gl-temp4)
=>
	(up-modify-goal gl-temp4 g:= gl-temp3)
	;;(up-chat-data-to-all "found new best tile(%d)" g: gl-temp3)
;	;;(up-chat-data-to-all "rl(%d)" g: rl)
;	;;(up-chat-data-to-all "rt(%d)" g: rt)
	(up-copy-point point3-x point2-x)
;	;(up-send-flare point3-x)
;	(up-set-target-point point3-x)
;	(up-full-reset-search)
;	(up-filter-distance c: -1 c: 0)
;	(up-find-local c: wall-class c: 2)
;	(up-find-local c: gate-class c: 2)
;	(up-target-point 0 action-delete -1 -1)
)
;tileskip jumps target

(defrule	;move down the column
	(up-compare-goal point2-x g:> gl-temp1)	;if it is <=, time to reset 
=>
	(set-goal gl-temp3 1000)	;reset score
	(up-modify-goal point2-x c:- 1)
;	;(up-send-flare point2-x)
;	;;(chat-to-all "move point down column")
	(up-jump-rule -12)
)

(defrule	;move over a column
	(up-compare-goal point2-y g:> gl-temp2)	;if it is <=, done with scan
	(up-compare-goal point2-x g:<= gl-temp1)	;if it is <=, time to shift
=>
	(set-goal gl-temp3 0)	;reset score
	(up-modify-goal point2-x g:= point1-x)
	(up-modify-goal point2-x g:+ gl-half-square-side-length)	;get it back to the top
	(up-modify-goal point2-y c:- 1)	;shift it over one
;	;(up-send-flare point2-x)
;	;;(chat-to-all "reset column")
	(up-jump-rule -13)
)

(defrule
	(true)
	(goal gl-temp13 0)
;	(false)
=>
	;(up-send-flare point3-x)
	;hi;(chat-to-all "found side limit")
;	;;(up-chat-data-to-all "print info: %d" g: gl-temp4)
;	(disable-self)
	(do-nothing)
)

(defrule
	(goal gl-temp4 0)
	(goal gl-temp13 0)
;	(or	(up-point-contains point3-x c: wall-class)
;		(up-point-contains point3-x c: gate-class))
=>
	;hi;(chat-to-all "no point found--skip deleting")
	(up-copy-point nondeletedside-x gl-side-reference-x-djsfalk)
;	;(up-send-flare nondeletedside-x)
	(up-jump-rule 7)
;	(disable-self)
	(do-nothing)
)

(defrule
	(goal gl-temp13 1)
=>
	;(up-send-flare point3-x)
	;hi;(chat-to-all "found side limit 2")
;	;;(up-chat-data-to-all "print info: %d" g: gl-temp4)
;	(disable-self)
	(do-nothing)
)

(defrule
	(goal gl-temp4 0)
	(goal gl-temp13 1)
;	(or	(up-point-contains point3-x c: wall-class)
;		(up-point-contains point3-x c: gate-class))
=>
	(up-copy-point nondeletedside-x gl-side-reference-x-djsfalk)
	;hi;(chat-to-all "no point found--skip deleting2") 
	(up-jump-rule 6)
;	(disable-self)
)


;now, scan and delete any walls on the right side and back far enough (just reuse the inner loop goals since those arent used after this point in the loop for this side
;just need to save best tile for the side and that's it
(defrule
	(true)
=>
	(set-goal gl-half-square-side-length-djsfalk-djsfalk 30)
	(up-copy-point gl-point1-x-djsfalk-djsfalk home-x)
	(up-copy-point gl-point2-x-djsfalk-djsfalk home-x)	
	(up-modify-goal gl-point2-x-djsfalk-djsfalk g:+ gl-half-square-side-length-djsfalk-djsfalk)
	(up-modify-goal gl-point2-y-djsfalk-djsfalk g:+ gl-half-square-side-length-djsfalk-djsfalk)	;checking point
	(up-modify-goal gl-temp1-djsfalk-djsfalk g:= gl-point1-x-djsfalk-djsfalk)
	(up-modify-goal gl-temp1-djsfalk-djsfalk g:- gl-half-square-side-length-djsfalk-djsfalk)	;x limit
	(up-modify-goal gl-temp2-djsfalk-djsfalk g:= gl-point1-y-djsfalk-djsfalk)
	(up-modify-goal gl-temp2-djsfalk-djsfalk g:- gl-half-square-side-length-djsfalk-djsfalk)	;y limit
;	;(up-send-flare gl-point1-y-djsfalk-djsfalk)
;	;(up-send-flare gl-point2-x-djsfalk-djsfalk)
	;hi;(chat-to-all "hi2")
)

;start both upjumps
(defrule
	(true)
=>
	(up-get-point-distance point3-x center-x gl-temp1)
	(up-modify-goal gl-temp1 c:+ 2)	;make it be a little further just to be sure you don't delete wrongly
	(up-get-point-distance gl-point2-x-djsfalk-djsfalk home-x gl-temp2)
	(up-modify-goal gl-temp2 c:+ 5)
)

(defrule
	(or	(up-point-contains gl-point2-x-djsfalk-djsfalk c: wall-class)
		(up-point-contains gl-point2-x-djsfalk-djsfalk c: gate-class))
	(up-point-distance gl-point2-x-djsfalk-djsfalk center-x g:> gl-temp1)	;further from the center than the limit
	(up-point-distance gl-point2-x-djsfalk-djsfalk gl-side-reference-x-djsfalk g:< gl-temp2)	;closer to the reference point than to the tc
=>
	(up-full-reset-search)
	(up-set-target-point gl-point2-x-djsfalk-djsfalk)
	(up-filter-distance c: -1 c: 0)
	(up-find-local c: wall-class c: 10)
	(up-find-local c: gate-class c: 10)
	(up-target-point 0 action-delete -1 -1)
;	;;(chat-to-all "wall tile delete")
)

(defrule	;move down the column
	(up-compare-goal gl-point2-x-djsfalk-djsfalk g:> gl-temp1-djsfalk-djsfalk)	;if it is <=, time to reset 
=>
	(up-modify-goal gl-point2-x-djsfalk-djsfalk c:- 1)
;	;(up-send-flare gl-point2-x-djsfalk-djsfalk)
;	;;(chat-to-all "move point down column")
	(up-jump-rule -3)
)

(defrule	;move over a column
	(up-compare-goal gl-point2-y-djsfalk-djsfalk g:> gl-temp2-djsfalk-djsfalk)	;if it is <=, done with scan
	(up-compare-goal gl-point2-x-djsfalk-djsfalk g:<= gl-temp1-djsfalk-djsfalk)	;if it is <=, time to shift
=>
	(up-modify-goal gl-point2-x-djsfalk-djsfalk g:= gl-point1-x-djsfalk-djsfalk)
	(up-modify-goal gl-point2-x-djsfalk-djsfalk g:+ gl-half-square-side-length-djsfalk-djsfalk)	;get it back to the top
	(up-modify-goal gl-point2-y-djsfalk-djsfalk c:- 1)	;shift it over one
;	;(up-send-flare gl-point2-x-djsfalk-djsfalk)
;	;;(chat-to-all "reset column")
	(up-jump-rule -4)
)

;skip jump target1
(defrule
	(goal gl-temp13 0)
	(up-compare-flag gl-misc-flag1 != fl-extra-wall-added)	;not for that.
=>
	(set-goal gl-temp13 1)
	(up-jump-rule -25)
	(disable-self)
	;;(chat-to-all "check other side")
)

;skip jump target2
(defrule
	(true)
=>
	(up-modify-flag gl-misc-flag1 c:+ 262144);debuggggg
;;(chat-to-all "exiting function1")
)

(defrule	;debug
	(false)
=>
	;;(chat-to-all "false something went wrong--reset")
	;(up-send-flare point3-x)
	(do-nothing)
)

;arena walls jump target



;WWWWWWWWWWWWWWWWWW QSHEEP SCOUTING	
(defrule
	(true)
=>
	(set-goal gl-scouting-flag 0)  ;sets all flags to 0 or off, the flag gl-temp1 has to be initialized to zero
	(disable-self)
)

;============== FIND ALL ELIGIBLE SHEEP
(defrule
	(true)
	(or	(game-time < 1)
		(or	(up-compare-goal gl-fifth-turn != 1)
			(up-compare-flag gl-misc-flag1 == fl-sheep-scouting-finished)))
=>
	(up-jump-rule 36)	;asdsaddsfasf
)

(defrule
	(game-time >= 150)	;3 mins
=>
	(up-modify-flag gl-misc-flag1 c:+ fl-sheep-scouting-finished)
	;;(chat-to-all "sheep scouting finished")
	(disable-self)
)

(defrule	;initialize the loop counter to the right number of sheep available (you will count down to zero)
	(true)
=>
	(set-goal gl-sheep-scout-index -1)
	(up-full-reset-search)
	(up-find-local c: livestock-class c: 10)
	(up-remove-objects search-local object-data-id g:== gl-next-sheep-id)
	(up-remove-objects search-local object-data-id g:== gl-current-sheep-id)
	(up-set-target-point estimated-enemy-x)
	(up-remove-objects search-local 44 < 35)	;avoid enemy 
	(up-get-search-state lt)
;	;;(up-chat-data-to-all "lt 1: %d" g: lt)
	(up-modify-goal gl-sheep-scout-index g:= lt)
	(up-modify-goal gl-sheep-scout-index c:- 1)	;it is 0-based, so subtract one
;	;;(up-chat-data-to-all "initialize loop counter(%d)" g: gl-sheep-scout-index)
)

;start of main upjump DFGSDAFASDF
(defrule	;find the right sheep
	(up-compare-goal gl-sheep-scout-index >= 0)
=>
	(up-full-reset-search)
	(up-find-local c: livestock-class c: 10)
	(up-remove-objects search-local object-data-group-flag != counterclockwisesheepscoutgroup)
	(up-remove-objects search-local object-data-id g:== gl-next-sheep-id)
	(up-get-search-state lt)
	(up-modify-goal gl-temp6 g:= lt)
;	;;(up-chat-data-to-all "gl-temp6: %d" g: gl-temp6)
	
	(up-full-reset-search)
	(up-find-local c: livestock-class c: 10)
	(up-remove-objects search-local object-data-group-flag != clockwisesheepscoutgroup)
	(up-remove-objects search-local object-data-id g:== gl-next-sheep-id)
	(up-get-search-state lt)
	(up-modify-goal gl-temp7 g:= lt)
;	;;(up-chat-data-to-all "gl-temp7: %d" g: gl-temp7)
	
	(up-full-reset-search)
	(up-find-local c: livestock-class c: 10)
	(up-clean-search search-local object-data-id search-order-desc)	;just order them objectively
	(up-remove-objects search-local object-data-id g:== gl-next-sheep-id)
	(up-remove-objects search-local object-data-id g:== gl-current-sheep-id)
	(up-remove-objects search-local -1 g:!= gl-sheep-scout-index)
	(up-set-target-point estimated-enemy-x)
	(up-remove-objects search-local 44 < 35)
;	;;(chat-to-all "remove all but next sheep")
;	;;(up-chat-data-to-all "current index: %d" g: gl-sheep-scout-index)
	(up-get-search-state lt)
;	;;(up-chat-data-to-all "lt: %d" g: lt)
)

(defrule
	(up-set-target-object search-local c: 0)	;cuz there's only one now
=>
	(up-get-object-data object-data-id gl-current-sheep-scout-id)
;	;;(up-chat-data-to-all "Shout %d found" g: gl-sheep-scout-index)
)

;============== EACH SHEEP MOVEMENT CODE
(defrule
	(not(up-set-target-by-id g: gl-current-sheep-scout-id))
=>
	(up-jump-rule 31)	;to last backloop
)

(defrule
	(up-set-target-by-id g: gl-current-sheep-scout-id)	;found a sheep
=>
	(set-goal rt 0)
	(set-goal gl-temp1 0)	;loop counter for borderlerp
	(set-goal gl-temp2 0)	;path distance
	(set-goal gl-temp3 0)	;initial point explored?
	(set-goal gl-temp4 -1)	;lerp away if initial cross is explored	
	(set-goal gl-temp5 -1)	;rt for trees found
;		(set-goal gl-temp6 -1)	;counts counterclockwise sheep, set above
;		(set-goal gl-temp7 -1)	;counts clockwise sheep, set above
	(set-goal gl-temp8 -1)	;controls switching direction
	(set-goal gl-temp9 -1)	;don't spam switching direction
	(set-goal gl-temp10 0)	;how far out to treeskip (lerping from home-x)
	
	(up-get-point position-object point1-x)
	(up-copy-point point2-x point1-x)
	(up-set-target-point point1-x)
	(up-filter-distance c: -1 c: 3)
	(up-filter-status c: status-ready c: list-active)
	(set-strategic-number sn-focus-player-number 0)
	(up-find-resource c: wood c: 40)
	(up-get-search-state lt)
	(up-modify-goal gl-temp5 g:= rt)
)

;---------- SWITCH DIRECTION
(defrule
	(true)
	(up-object-data object-data-group-flag == clockwisesheepscoutgroup)
=>
	(up-set-target-point point1-x)
	(up-filter-distance c: -1 c: 3)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-find-remote c: livestock-class c: 5)
	(up-remove-objects search-remote object-data-group-flag != clockwisesheepscoutgroup)
	(up-get-search-state lt)
;	;;(up-chat-data-to-all "clockwise livestock: %d" g: rt)
)

(defrule
	(true)
	(up-object-data object-data-group-flag == counterclockwisesheepscoutgroup)
=>
	(up-set-target-point point1-x)
	(up-filter-distance c: -1 c: 3)
	(set-strategic-number sn-focus-player-number my-player-number)
	(up-find-remote c: livestock-class c: 5)
	(up-remove-objects search-remote object-data-group-flag != counterclockwisesheepscoutgroup)
	(up-get-search-state lt)
;	;;(up-chat-data-to-all "counterclockwise livestock: %d" g: rt)
)

(defrule
	(game-time > 15)
	(up-compare-goal rt == 2)
	(up-object-data object-data-group-flag == counterclockwisesheepscoutgroup)
=>
	(set-goal gl-temp8 clockwisesheepscoutgroup)
;	;;(chat-to-all "switch direction clockwise")
)

(defrule
	(game-time > 15)
	(up-compare-goal rt == 2)
	(up-object-data object-data-group-flag == clockwisesheepscoutgroup)
=>
	(set-goal gl-temp8 counterclockwisesheepscoutgroup)
;	;;(chat-to-all "switch direction counterclockwise")
)

(defrule
	(or (goal gl-temp8 clockwisesheepscoutgroup)
		(and(up-compare-goal gl-temp7 g:<= gl-temp6)	;not enough clockwises
			(up-object-data object-data-group-flag < 0)))
=>
	(up-create-group 0 0 c: clockwisesheepscoutgroup)
	(up-modify-group-flag 1 c: clockwisesheepscoutgroup)
;	;;(chat-to-all "Add to clockwise group")
	(up-modify-goal gl-temp7 c:+ 1)
)

(defrule
	(or (goal gl-temp8 counterclockwisesheepscoutgroup)
		(up-object-data object-data-group-flag < 0))
=>
	(up-create-group 0 0 c: counterclockwisesheepscoutgroup)
	(up-modify-group-flag 1 c: counterclockwisesheepscoutgroup)
;	;;(chat-to-all "Add to counterclockwise group")
	(up-modify-goal gl-temp6 c:+ 1)
)	

(defrule
	(up-object-data object-data-group-flag == counterclockwisesheepscoutgroup)
=>
	(up-cross-tiles point2-x home-x c: 5)
;	;;(chat-to-all "cross1")
)

(defrule
	(up-object-data object-data-group-flag == clockwisesheepscoutgroup)
=>
	(up-cross-tiles point2-x home-x c: -5)
;	;;(chat-to-all "cross2")
)

;================ POSITION ON THE EDGE OF EXPLORATION
(defrule
	(up-point-explored point2-x == explored-no)
=>
	(set-goal gl-temp3 1)
	(set-goal gl-temp4 1)
)

(defrule	;if it was unexplored, but now explored or vice-versa, skip
	(or	(and(goal gl-temp3 0)
			(up-point-explored point2-x == explored-no))
		(and(goal gl-temp3 1)
			(up-point-explored point2-x != explored-no)))
=>
	(up-jump-rule 3)
)

(defrule
	(up-compare-goal gl-temp1 < 20)
=>
	(up-lerp-tiles point2-x home-x g: gl-temp4)
;	;;(up-chat-data-to-all "borderlerp(%d)" g: gl-temp4)
	(up-modify-goal gl-temp1 c:+ 1)
	(up-jump-rule -2)
)

(defrule
	(goal gl-temp1 20)
	(goal gl-temp9 -1)
	(up-timer-status t-misc2 != timer-running)
	(up-object-data object-data-group-flag == counterclockwisesheepscoutgroup)
=>
;	;;(chat-to-all "SWITCH DIRECTION CLOCKWISE 2")
	(set-goal gl-temp8 clockwisesheepscoutgroup)
	(enable-timer t-misc2 20)
	(set-goal gl-temp9 1)
	(up-jump-rule -8)	;up to switch
)

(defrule
	(goal gl-temp1 20)
	(goal gl-temp9 -1)
	(up-timer-status t-misc2 != timer-running)
	(up-object-data object-data-group-flag == clockwisesheepscoutgroup)
=>
;	;;(chat-to-all "SWITCH DIRECTION COUNTERCLOCKWISE 2")
	(set-goal gl-temp8 counterclockwisesheepscoutgroup)
	(enable-timer t-misc2 20)
	(set-goal gl-temp9 1)
	(up-jump-rule -8)	;back to switch
)

(defrule
	(goal gl-temp3 0)
=>
	(up-lerp-tiles point2-x home-x c: 1)
)

;================	THEN MOVE IT OUT
(defrule
	(true)
=>
	(up-lerp-tiles point2-x home-x c: -5)
;	;;(up-chat-data-to-all "gl-temp5: %d" g: gl-temp5)
;	;;(chat-to-all "lerp out")
;	;(up-send-flare point2-x)
)

;================	TREESKIP (thanks to Leif for helping with the flag)
;--------CONTROL
(defrule
	(up-point-distance point1-x home-x >= 20)
=>
	(set-goal gl-temp10 25)
)


;--------ZERO
(defrule
	(goal gl-sheep-scout-index 0)
	(up-compare-goal gl-temp5 >= 4)
    (up-compare-flag gl-scouting-flag != SKIP-FLAG-0)
=>
	(up-add-object-by-id search-local g: gl-current-sheep-scout-id)
	(up-lerp-tiles point2-x point1-x c: -30)
	(up-lerp-tiles point2-x home-x g: gl-temp10)
	(up-bound-point point2-x point2-x)
	(up-target-point point2-x action-move -1 -1)
    (up-modify-flag gl-scouting-flag c:+ SKIP-FLAG-0)
;	;;(up-chat-data-to-all "treeskip move 0(%d)" g: gl-temp2)
;	;(up-send-flare point2-x)
)

(defrule
	(goal gl-sheep-scout-index 0)
	(up-compare-goal gl-temp5 < 1)
    (up-compare-flag gl-scouting-flag == SKIP-FLAG-0)
=>
    (up-modify-flag gl-scouting-flag c:- SKIP-FLAG-0)
;	;;(chat-to-all "remove treeskip 0")
)

