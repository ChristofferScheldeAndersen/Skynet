	(up-timer-status t-villagers-moving-to-new-sheep != timer-running)	;so old next sheep doesn't interfere moving out if replaced with deer/boar
=>
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance c: -1 c: 5)
	(up-find-local c: livestock-class c: 10)
	(up-remove-objects search-local object-data-id g:== gl-next-sheep-id)
	(up-remove-objects search-local object-data-id g:== gl-current-sheep-id)
	(up-set-target-point estimated-enemy-x)
	(up-remove-objects search-local 44 < 30)
	(up-set-target-point point1-x)
	(up-remove-objects search-local 44 g:< gl-temp10)
)

(defrule
	(game-time < 30)
	(goal gl-fifth-turn 1)
	(goal gl-sheep-control -1)
	(unit-type-count livestock-class >= 1)
	(up-set-target-by-id g: gl-current-sheep-id)
	(up-timer-status t-villagers-moving-to-new-sheep != timer-running)
=>
	(up-remove-objects search-local object-data-group-flag == clockwisesheepscoutgroup)
	(up-remove-objects search-local object-data-group-flag == counterclockwisesheepscoutgroup)
)

(defrule
	(up-set-target-object search-local c: 0)	;
	(goal gl-fifth-turn 1)
	(goal gl-sheep-control -1)
	(unit-type-count livestock-class >= 1)
	(up-set-target-by-id g: gl-current-sheep-id)
	(up-timer-status t-villagers-moving-to-new-sheep != timer-running)	;so old next sheep doesn't interfere moving out if replaced with deer/boar
=>
	(up-target-point point1-x action-move -1 -1)
	;hi;(chat-to-all "Move other sheep 1")
)



;next
(defrule
	(up-set-target-by-id g: gl-current-sheep-id)
=>
	(up-get-point position-object point2-x)
	(up-copy-point point1-x home-x)
	(up-modify-goal point1-x c:- 1)
	(up-modify-goal point1-y c:+ 1)
)

(defrule
	(up-set-target-by-id g: gl-next-sheep-id)
	(up-set-target-by-id g: gl-current-sheep-id)
	(up-point-distance point1-x point2-x >= 2)
=>
	(up-lerp-tiles point1-x point2-x c: 1)
)

(defrule
	(game-time >= 5)
	(goal gl-sheep-control -1)
	(up-set-target-by-id g: gl-next-sheep-id)
	(up-object-data object-data-player == my-player-number)		;needs to be here
	(up-set-target-by-id g: gl-current-sheep-id)
	(or	(up-point-distance tempx-next-sheep-x home-x >= 1)	;only delay it if its already under the tc
		(up-timer-status t-villagers-moving-to-new-sheep != timer-running))
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-next-sheep-id)
	;hi;(chat-to-all "move next sheep")
	(up-target-point point1-x action-move -1 -1)
	(set-goal gl-sheep-control 0)
)

(defrule
	(game-time >= 5)
	(up-set-target-by-id g: gl-current-sheep-id)
	(up-set-target-by-id g: gl-next-sheep-id)	;
	(up-object-data object-data-player == my-player-number) ;
	(or	(goal gl-fifth-turn 1)
		(and(up-point-distance tempx-next-sheep-x point1-x >= 1)
			(up-object-data object-data-move-x g:!= point1-x)))	;
	(or	(up-point-distance tempx-next-sheep-x point1-x >= 1)
		(up-timer-status t-villagers-moving-to-new-sheep != timer-running))
=>
	(up-full-reset-search)
	(up-set-target-point point1-x)
	(up-add-object-by-id search-local g: gl-next-sheep-id)
	(up-remove-objects search-local 44 < 3)
;	;(chat-to-all "move next sheep 2a")
)

