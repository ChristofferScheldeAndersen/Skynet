	(up-compare-goal gl-walling-stage < reachedfinalvertex)
	(or	(and(up-compare-goal counterclockwise-walling-x == 0)
			(up-compare-goal counterclockwise-next-vertex-x == 0))
		(or	(and(up-compare-goal counterclockwise-walling-y == 0)
				(up-compare-goal counterclockwise-next-vertex-y == 0))
			(or	(and(up-compare-goal counterclockwise-walling-x g:== gl-max-coordinate-value)
					(up-compare-goal counterclockwise-next-vertex-x g:== gl-max-coordinate-value))
				(and(up-compare-goal counterclockwise-walling-y g:== gl-max-coordinate-value)
