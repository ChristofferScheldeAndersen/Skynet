	(goal rl 0)		;not near enemy castles
	(up-set-target-object search-remote c: 0)
	(not(up-set-target-object search-local c: 0))
=>
	;hi;(up-chat-data-to-all "found suitable resource tile - exiting(%d)" g: gl-temp11)
	(up-jump-rule 5)
)

(defrule
	(true) 	;dropsite nearby
;	(false)
	(up-set-target-object search-remote c: 0)
=>
	(up-remove-objects search-remote -1 == 0)	;not that one
	(up-reset-search 1 1 0 0)	;clear local search
