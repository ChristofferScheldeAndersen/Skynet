	(up-find-remote c: gate-class c: 40)
	(up-get-search-state lt)
)

(defrule
	(up-compare-goal rt g:> gl-enemy-gate-count-tracker)
=>
	(up-modify-goal gl-enemy-gate-count-tracker g:= rt)
	;hi;(up-chat-data-to-all "another gate found (%d)" g: gl-enemy-gate-count-tracker)
)

(defrule
	(up-compare-goal rt g:< gl-enemy-gate-count-tracker)
=>
	;hi;(up-chat-data-to-all "breachage str(%d)" g: gl-enemy-wall-breachage)
	;hi;(up-chat-data-to-all "breachage tracker(%d)" g: gl-enemy-gate-count-tracker)
	;hi;(up-chat-data-to-all "breachage rt(%d)" g: rt)
	(up-modify-goal gl-enemy-gate-count-tracker g:- rt)		;get the difference first
	;hi;(up-chat-data-to-all "breachage diff(%d)" g: gl-enemy-gate-count-tracker)
	(up-modify-goal gl-enemy-gates-destroyed g:+ gl-enemy-gate-count-tracker)	;difference here is the number of gates destroyed
	(up-modify-goal gl-enemy-gate-count-tracker c:* 4)	;take up 4 tiles, so however many times 4 is number of tiles additionally breached
	;hi;(up-chat-data-to-all "breachage diff b(%d)" g: gl-enemy-gate-count-tracker)
	;hi;(up-chat-data-to-all "breachage a(%d)" g: gl-enemy-wall-breachage)
	(up-modify-goal gl-enemy-wall-breachage g:+ gl-enemy-gate-count-tracker)
	;hi;(up-chat-data-to-all "enemy gate destroyed! (%d)" g: gl-enemy-gates-destroyed)
	;hi;(up-chat-data-to-all "breachage(%d)" g: gl-enemy-wall-breachage)
	(up-modify-goal gl-enemy-gate-count-tracker g:= rt)	;reset it
)

;;;;;



;detect when a relic has been taken
(defrule
	(game-time < 10)
=>
	(up-jump-rule 4)
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(set-strategic-number sn-focus-player-number 0)
	(up-find-remote c: relic c: 40)
	(up-get-search-state lt)
)

(defrule
	(up-compare-goal rt g:> gl-relics-seen-tracker)
=>
	(up-modify-goal gl-relics-seen-tracker g:= rt)
	;hi;(up-chat-data-to-all "another relic found (%d)" g: gl-relics-seen-tracker)
)

(defrule
	(unit-type-count monk-with-relic >= 1)
	(up-compare-goal rt g:< gl-relics-seen-tracker)
=>
	(up-modify-goal gl-relics-seen-tracker g:= rt)
	;hi;(up-chat-data-to-all "we destroyed a relic! (%d)" g: gl-relics-seen-tracker)
)

(defrule
	(unit-type-count monk-with-relic < 1)
	(up-compare-goal rt g:< gl-relics-seen-tracker)
=>
	(up-modify-goal gl-relics-seen-tracker g:- rt)		;get the difference first
	(up-modify-goal gl-enemy-relics-destroyed g:+ gl-relics-seen-tracker)	;difference here is the number of relics destroyed
	;hi;(up-chat-data-to-all "enemy relic destroyed! (%d)" g: gl-enemy-relics-destroyed)
	(up-modify-goal gl-relics-seen-tracker g:= rt)	;reset it
)

