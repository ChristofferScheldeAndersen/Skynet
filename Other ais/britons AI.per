;qunder attack detection
(defrule
	(current-age == dark-age)
=>
	(up-jump-rule 5)
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance c: -1 c: 35)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-find-remote c: all-units-class c: 40)
	(up-find-remote c: tower-class c: 40)
	(up-get-search-state lt)
	(up-modify-goal rl c:* 10)
	(up-modify-goal rt g:+ rl)
;	;;(up-chat-data-to-all "rt: %d" g: rt)
)

(defrule
	(goal gl-under-attack -1)
	(or	(goal gl-antitrush-control 1)
		(up-compare-goal rt >= 4))
=>	
	;(chat-to-all "under attack")
	(up-assign-builders c: castle c: 11)
	(set-goal gl-under-attack 1)
)

(defrule
	(up-compare-goal rt < 2)
	(goal gl-under-attack 1)
	(goal gl-antitrush-control -1)
	(up-timer-status t-under-attack != timer-running)
=>
;	;(chat-to-all "maybe not under attack")
	(enable-timer t-under-attack 20)
	(set-goal gl-under-attack 0)
)

(defrule
	(up-compare-goal rt < 2)
	(goal gl-under-attack 0)
	(goal gl-antitrush-control -1)
	(timer-triggered t-under-attack)
=>
	;(chat-to-all "not under attack anymore")
	(disable-timer t-under-attack)
	(set-goal gl-under-attack -1)
)

(defrule
	(goal gl-under-attack 0)
	(or (goal gl-antitrush-control 1)
		(up-compare-goal rt >= 2))
=>
;	;(chat-to-all "still under attack")
	(disable-timer t-under-attack)
	(set-goal gl-under-attack 1)
)
;end main jump

