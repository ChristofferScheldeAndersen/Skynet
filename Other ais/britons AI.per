;don't build lcs outside of walls
;	find the nearest wall (only if the point is >= 17 distance from tc)
;	don't build if the distance to tc is > the wall's distance to tc

(defrule
;	(false)
	(or	(military-population < 15)
		(unit-type-count villager < 90))
	(building-type-count wall-class >= 20)
	(up-point-distance point2-x home-x >= 17)
	(or	(goal gl-dropsite-to-build lc)
		(up-compare-flag gl-misc-flag2 == fl-dropsite-is-tc))
=>
	(up-full-reset-search)
	(up-set-target-point point2-x)
	(up-filter-distance c: -1 c: 20)
	(up-find-local c: wall-class c: 50)
	(up-clean-search search-local 44 1)
)

