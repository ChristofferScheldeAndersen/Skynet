	(goal gl-sheep-scout-index 3)
	(up-compare-goal gl-temp5 < 1)
    (up-compare-flag gl-scouting-flag == SKIP-FLAG-3)
=>
    (up-modify-flag gl-scouting-flag c:- SKIP-FLAG-3)
;	;;(chat-to-all "remove treeskip 3")
)


;--------FOUR
