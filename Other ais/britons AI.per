;qhouse

;qfirst two houses
(defconst villager-center-x-houses12 point3-xid)
(defconst villager-center-y-houses12 point3-yid)
(defconst two-vills-center-x-houses12 point4-xid)
(defconst two-vills-center-y-houses12 point4-yid)

(defrule
	(or	(game-time < 1)
		(or	(goal home-x -1)	;asap
			(or	(not(can-build house))
				(up-compare-flag gl-misc-flag2 == fl-first-houses-done))))
=>
	(up-jump-rule 20)
)

;find average point of vills
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 10)
	(set-goal gl-temp1 0)
	(set-goal villager-center-x-houses12 0)
	(set-goal villager-center-y-houses12 0)
	(up-get-search-state lt)
)

;jump up here
(defrule
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-point-x point1-x)
	(up-get-object-data object-data-point-y point1-y)
	(up-modify-goal villager-center-x-houses12 g:+ point1-x)
	(up-modify-goal villager-center-y-houses12 g:+ point1-y)
	(up-modify-goal gl-temp1 c:+ 1) ;number of points checked
	(up-get-search-state lt)
)

(defrule
	(up-compare-goal lt > 0)
=>
	(up-remove-objects search-local -1 == 0)
	(up-get-search-state lt)
	(up-jump-rule -2)
)

(defrule
	(up-compare-goal gl-temp1 > 0)
=>
	(up-modify-goal villager-center-x-houses12 g:/ gl-temp1)
	(up-modify-goal villager-center-y-houses12 g:/ gl-temp1)
)


;find average point of vills
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 10)
	(up-set-target-point villager-center-x-houses12)
	(up-clean-search search-local 44 2)
	(up-remove-objects search-local -1 == 0)	;remove furthest
	(set-goal two-vills-center-x-houses12 0)
	(set-goal two-vills-center-y-houses12 0)
	(set-goal gl-temp1 0)
	(up-get-search-state lt)
)

;jump up here
(defrule
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-point-x point1-x)
	(up-get-object-data object-data-point-y point1-y)
	(up-modify-goal two-vills-center-x-houses12 g:+ point1-x)
	(up-modify-goal two-vills-center-y-houses12 g:+ point1-y)
	(up-modify-goal gl-temp1 c:+ 1)
	(up-get-search-state lt)
)

(defrule
	(up-compare-goal lt > 0)
=>
	(up-remove-objects search-local -1 == 0)
	(up-get-search-state lt)
	(up-jump-rule -2)
)

(defrule
	(up-compare-goal gl-temp1 > 0)
=>
	(up-modify-goal two-vills-center-x-houses12 g:/ gl-temp1)
	(up-modify-goal two-vills-center-y-houses12 g:/ gl-temp1)
;	;(up-send-flare two-vills-center-x-houses12)
)

;2 vill house

;ok. how do you do this. get the average point of the other two vills
(defrule
	(true)
=>
	(up-copy-point point1-x two-vills-center-x-houses12)
	(set-goal gl-temp1 0)
)

(defrule
	(up-point-distance point1-x home-x < 9)
=>
	(up-lerp-tiles point1-x home-x c: -1)
	(up-jump-rule -1)
)

(defrule
	(true)
=>	
	(up-full-reset-search)
	(up-set-target-point point1-x)
	(up-filter-distance c: -1 c: 3)
	(up-filter-status c: status-resource c: list-active)
	(up-find-resource c: gold-mine-class c: 1)
	(up-find-resource c: stone-mine-class c: 1)
)

(defrule	;crossing rule1
	(up-compare-goal gl-temp1 < 20)
	(or	(up-set-target-object search-remote c: 0)
		(not(up-can-build-line 0 point1-x c: house)))
=>
	(up-cross-tiles point1-x home-x c: -1)
	(up-modify-goal gl-temp1 c:+ 1)
	(up-jump-rule -2)
)

(defrule
	(up-can-build-line 0 point1-x c: house)
=>
	(up-build-line point1-x point1-x c: house)
