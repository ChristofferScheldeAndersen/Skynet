(defrule
	(true)
	(goal gltemp-unassign-skip-this-pass -1)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 240)
	(up-remove-objects search-local object-data-group-flag != miscstonegroup)
	(up-remove-objects search-local object-data-carry > 0)
)

(defrule
	(goal gltemp-unassign-skip-this-pass -1)
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-temp5 g:> gl-desired-stone-vills)
	(or	(up-compare-goal gltemp-plusone-projected-food-gatherers g:<= gl-desired-food-vills)			
		(or	(up-compare-goal gltemp-plusone-projected-wood-gatherers g:<= gl-desired-wood-vills)
			(or	(up-compare-goal gltemp-plusone-projected-berry-gatherers g:<= gl-desired-berry-vills)
				(up-compare-goal gltemp-plusone-projected-gold-gatherers g:<= gl-desired-gold-vills))))
=>
	(up-remove-objects search-local -1 > 0)	
	;;(chat-to-all "unassign stone")
	;;(up-chat-data-to-all "gl-temp5: %d" g: gl-temp5)
	(up-create-group 0 0 c: miscstonegroup)
	(up-modify-group-flag 0 c: miscstonegroup)
)














;old code
;section for switching assigned vills to different group
(defrule
	(false)
	(up-compare-goal gl-source-villager != -1)
	(up-group-size c: miscfoodgroup g:== gl-desired-food-vills)
	(up-group-size c: berrygroup g:== gl-desired-berry-vills)
	(up-group-size c: miscwoodgroup g:== gl-desired-wood-vills)
	(up-group-size c: miscgoldgroup g:== gl-desired-gold-vills)
	(up-group-size c: miscstonegroup g:== gl-desired-stone-vills)
=>
	;;(chat-to-all "transfer done--deactivate source goals")
	(set-goal gl-source-villager -1)
)
	

;change foodies to wood
(defrule
	(false)
	(true)
	(goal gl-source-villager -1)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-group-flag != miscfoodgroup)
	(up-remove-objects search-local object-data-carry > 0)
)

(defrule
	(goal gl-source-villager -1)
	(false)
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-temp2 g:< gl-desired-wood-vills)
	(up-compare-goal gl-temp1 g:> gl-desired-food-vills)
=>
	(up-remove-objects search-local -1 > 0)	
	;;(chat-to-all "add foodie to group miscwoodgroup")
	(up-create-group 0 0 c: miscwoodgroup)
	(up-modify-group-flag 1 c: miscwoodgroup)
)

;change foodies to berries
(defrule
	(true)
	(goal gl-source-villager -1)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-group-flag != miscfoodgroup)
	(up-remove-objects search-local object-data-carry > 0)
)

(defrule
	(goal gl-source-villager -1)
	(false)
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-temp3 g:< gl-desired-berry-vills)
	(up-compare-goal gl-temp1 g:> gl-desired-food-vills)
=>
	(up-remove-objects search-local -1 > 0)	
	;;(chat-to-all "add foodie to berrygroup")
	(up-create-group 0 0 c: berrygroup)
	(up-modify-group-flag 1 c: berrygroup)
)

;change straggvill to woodie
(defrule
	(false)
	(goal gl-source-villager straggler)
=>
	(up-full-reset-search)
	(up-find-local c: lumber-camp c: 40)
	(up-set-target-point home-x)
	(up-clean-search search-local 44 1)
)

(defrule
	(false)
	(up-set-target-object search-local c: 0)
	(goal gl-source-villager straggler)
=>
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	(up-full-reset-search)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-group-flag != miscfoodgroup)
	(up-remove-objects search-local object-data-target != tree-class)
	(up-clean-search search-local 44 1)
)

(defrule
	(goal gl-source-villager straggler)
	(false)
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-temp3 g:< gl-desired-wood-vills)
	(up-compare-goal gl-temp1 g:> gl-desired-food-vills)
=>
	(up-remove-objects search-local -1 > 0)	
	;;(chat-to-all "add stragg to woodgroup")
	(up-create-group 0 0 c: miscwoodgroup)
	(up-modify-group-flag 1 c: miscwoodgroup)
	(set-goal gl-source-villager -1)
)

;end villgroup section







;qlcav
;micro lightcav
(defrule
	(true)
	(or	(unit-type-count scout-cavalry-line < 1)
		(up-compare-goal gl-add-scouts >= lategame))
=>
	(up-jump-rule 12)
)

(defrule
	(true)
=>
	(up-copy-point lightcav-x home-x)
	(up-lerp-tiles lightcav-x estimated-enemy-x c: 10)
)

(defrule
	(up-compare-flag gl-misc-flag1 == fl-attack)
=>
	(up-copy-point lightcav-x estimated-enemy-x)
	(up-lerp-tiles lightcav-x home-x c: 25)
)

(defrule
	(goal gl-strategy fccastle)
=>
	(up-copy-point lightcav-x front-castle-x)
	(up-lerp-tiles lightcav-x home-x c: 5)
)

;target monks
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: scout-cavalry-line c: 10)
	(up-set-target-point home-x)
	(up-clean-search search-local 44 1)
	(set-goal gl-temp1 -1)
	(set-goal gl-temp2 -1)
;	;(chat-to-all "hi")
)

(defrule
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	
	(up-full-reset-search)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-find-remote c: monastery-class c: 10)
	(up-find-remote c: missionary c: 10)
	(up-find-remote c: monk c: 10)
	(up-find-remote c: monk-with-relic c: 10)
	(up-clean-search search-remote 44 1)
;	;(chat-to-all "hi2")
)

(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-object-data object-data-id gl-temp1)
	(up-get-point position-object point2-x)
	(up-full-reset-search)
	(up-set-target-point point2-x)
	(up-filter-distance c: -1 c: 17)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-find-remote c: wall-class c: 40)
	(up-clean-search search-remote 44 1)
;	;(chat-to-all "hi3")
)

(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point3-x)
	(up-get-point-distance point3-x estimated-enemy-x gl-temp2)
	(up-get-point-distance point2-x estimated-enemy-x gl-temp3)
;	;(chat-to-all "hi4")
;	;(up-send-flare point3-x)
)

(defrule
	(up-set-target-by-id g: gl-temp1)	;
	(or	(goal gl-temp2 -1)
		(or	(up-compare-goal gl-enemy-wall-breachage >= 3)
			(or	(up-point-distance point1-x point2-x < 2)
				(or	(up-point-distance point1-x estimated-enemy-x < 20)	;scout inside walls
					(and(up-compare-goal gl-temp2 > -1)
						(up-point-distance point2-x estimated-enemy-x g:>= gl-temp2))))))	;monk outside walls
=>
	(up-full-reset-search)
	(up-find-local c: scout-cavalry-line c: 10)
	;hi;(up-chat-data-to-all "target monk new(%d)" g: gl-temp1)
	(up-remove-objects search-local object-data-target-id g:== gl-temp1)
	(up-target-objects 1 action-default formation-box no-attack)
	(up-jump-rule 4)
)

(defrule
	(up-compare-goal gl-temp2 > -1)
	(up-set-target-by-id g: gl-temp1)	;
	(up-point-distance point2-x estimated-enemy-x g:< gl-temp2)
=>
	(up-full-reset-search)
	(up-find-local c: scout-cavalry-line c: 10)
	(up-remove-objects search-local object-data-target-id g:!= gl-temp1)
)

(defrule
	(up-compare-goal gl-temp2 > -1)
	(up-set-target-by-id g: gl-temp1)	;
	(up-set-target-object search-local c: 0)
	(up-point-distance point2-x estimated-enemy-x g:< gl-temp2)
=>
	(up-target-point home-x action-stop -1 no-attack)
	;hi;(chat-to-all "stop attacking monk")
	;hi;(up-chat-data-to-all "temp2(%d)" g: gl-temp2)
	;hi;(up-chat-data-to-all "temp2(%d)" g: gl-temp3)
	;(up-send-flare estimated-enemy-x)
	;(up-send-flare point3-x)
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: scout-cavalry-line c: 10)
	(up-remove-objects search-local object-data-id g:== gl-scout-id)
)

(defrule
	(goal gl-fifth-turn 1)
	(up-set-target-object search-local c: 0)
=>
	(up-target-point lightcav-x action-move -1 no-attack)
	;hi;(chat-to-all "move lcav to point")
)
