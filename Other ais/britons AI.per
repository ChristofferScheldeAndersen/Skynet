(defrule
	(up-set-target-object search-local c: 0)
	(goal gltemp-unassign-skip-this-pass -1)
	(up-compare-goal gl-temp4 g:< gl-desired-gold-vills)
=>
	(up-remove-objects search-local -1 > 0)	
	;;(chat-to-all "add to group miscgoldgroup")
	(up-create-group 0 0 c: miscgoldgroup)
	(up-modify-group-flag 1 c: miscgoldgroup)
	(set-goal gltemp-unassign-skip-this-pass 1)
)

