(defrule	
	(true)
=>
	(set-strategic-number sn-do-not-scale-for-difficulty-level 1)
	
	(up-assign-builders c: blacksmith c: 2)
	(up-assign-builders c: market c: 2)
	(up-assign-builders c: castle c: 6)
