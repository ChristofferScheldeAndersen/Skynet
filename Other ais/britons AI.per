;WWWWWWWWWWWWWWWWWW	EATING SHEEP
;@@@@@@@@@@@@@@ SETUP
(defrule
	(true)
=>
	(set-goal gl-temp1 0)	;food left on current
	(set-goal gl-temp2 0)	;vills targeting current sheep
