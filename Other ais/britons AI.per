(defrule
	(true)
	(false)
	(can-build mining-camp)
	(goal gl-dropsite-to-build mc)
	(up-compare-flag gl-misc-flag2 == fl-use-default-eco)
=>
	(set-strategic-number sn-stone-dropsite-distance 200)
	(set-strategic-number sn-gold-dropsite-distance 0)
	(set-goal gl-dropsite-to-build -1)
	(build mining-camp)
)

(defrule
	(true)
	(false)
	(can-build mining-camp)
	(goal gl-dropsite-to-build mc)
	(up-compare-flag gl-misc-flag2 == fl-use-default-eco)
	(up-compare-flag gl-misc-flag2 == fl-mining-camp-type-stone)
=>
	(set-strategic-number sn-stone-dropsite-distance 0)
	(set-strategic-number sn-gold-dropsite-distance 200)
	(up-modify-flag gl-misc-flag2 c:- fl-mining-camp-type-stone)
	(set-goal gl-dropsite-to-build -1)
	(build mining-camp)
)


(defrule	;camps	(just lc 111111)
	(up-can-build 0 g: gl-dropsite-to-build)
	(up-compare-goal gl-dropsite-to-build != -1)
	(up-compare-goal gl-dropsite-to-build != mc)
	(up-compare-flag gl-misc-flag2 != fl-dropsite-is-tc)
	(up-compare-flag gl-misc-flag2 == fl-use-default-eco)
=>
	(up-build place-normal 0 g: gl-dropsite-to-build)
	(set-goal gl-dropsite-to-build -1)
)


(defrule	;tc's
	(false)
	(up-can-build 0 g: gl-dropsite-to-build)
	(up-compare-goal gl-dropsite-to-build != -1)
	(up-compare-flag gl-misc-flag2 == fl-dropsite-is-tc)
	(up-compare-flag gl-misc-flag2 == fl-use-default-eco)
=>
	(up-modify-sn sn-town-center-placement g:= gl-dropsite-to-build)
	(set-goal gl-dropsite-to-build -1)
	(up-build place-normal 0 c: tc)
	(up-modify-flag gl-misc-flag2 c:- fl-dropsite-is-tc)
)



(defrule
	(true)
	(or	(game-time < 5)
		(or	(and(up-compare-goal gl-dropsite-to-build != mc)
				(and(up-compare-flag gl-misc-flag2 != fl-dropsite-is-tc)
					(up-compare-flag gl-misc-flag2 == fl-use-default-eco)))
			(or	(up-compare-goal gl-buildings-placed-this-pass >= 1)
				(or	(goal gl-debug 101)
					(or	(goal gl-dropsite-to-build -1)
						(not(up-can-build 0 g: gl-dropsite-to-build)))))))
=>
	(up-jump-rule 45)
;	;(chat-to-all "j")
)	;start big jump

