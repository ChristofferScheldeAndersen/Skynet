	(up-jump-rule -7)
)

(defrule	;move over a column
	(up-compare-goal point2-y g:> gl-temp2)	;if it is ==, done with scan
	(up-compare-goal point2-x g:<= gl-temp1)	;if it is <=, time to shift
=>
	(set-goal gl-temp3 0)	;reset score
	(up-modify-goal point2-x g:= point1-x)
	(up-modify-goal point2-x g:+ gl-half-square-side-length)	;get it back to the top
	(up-modify-goal point2-y c:- 1)	;shift it over one
;	;(up-send-flare point2-x)
;	;;(chat-to-all "reset column")
	(up-jump-rule -8)
)

(defrule	;build it!
	(up-can-build-line 0 point3-x c: farm)
=>
	(up-copy-point point5-x point3-x)
	(up-lerp-tiles point5-x point6-x c: 1)
	(up-build-line point5-x point5-x c: farm)	;try lerping once closer to best one

	(up-build-line point3-x point3-x c: farm)
	(set-goal gl-farm-placement -1)
;	;(chat-to-all "build farm")

;	(up-modify-goal point3-x c:+ 1)
;	(up-build-line point3-x point3-x c: palisade-wall)
	(up-modify-goal gl-buildings-placed-this-pass c:+ 1)
	;hi;(up-chat-data-to-all "build farm(%d)" g: gl-temp4)
	(up-copy-point last-farm-placed-x point3-x)
	(up-jump-rule 1)
)

(defrule	;debug
	(not(up-can-build-line 0 point3-x c: farm))
=>
	;(up-send-flare point3-x)
	;;(chat-to-all "farm something went wrong--reset")
	(set-goal gl-farm-placement -1)
)
;end main jump







(defrule
	(can-build farm)
	(idle-farm-count < 2)
	(goal gl-strategy norman)
	(up-pending-objects c: farm < 2)
	(building-type-count lumber-camp > 0)
	
	(or	(and(unit-type-count villager >= 20)
			(building-type-count-total farm < 2))
		(or	(building-type-count-total mining-camp >= 1)
			(and(wood-amount >= 165)
				(building-type-count-total barracks >= 1))))
					
	(or	(building-type-count-total stable >= 1)
		(up-research-status c: castle-age < research-pending))

;	(or	(current-age < castle-age)
;		(up-research-status c: ri-bow-saw >= research-pending))

	(or	(building-type-count-total farm < 7)
		(and(building-type-count-total market >= 1)
			(up-research-status c: ri-horse-collar >= research-complete)))	;wait for hc before more farms
=>
	(build farm)
)



























;qmonastery
(defrule
	(true)
=>
	(up-setup-cost-data 1 gl-temporary-cost-food)
	(up-add-object-cost c: monastery c: 1)
)

(defrule
	(goal gl-strategy fccastle)
	(goal gl-saving-wood -1)
	(goal gl-walling-building -1)
	(unit-type-count villager >= 70)
	(building-type-count-total monastery < 1)
=>
	(up-modify-goal gl-amount-saving-wood g:+ gl-temporary-cost-wood)
	;hi;(chat-to-all "save wood for monastery")
	(set-goal gl-saving-wood monastery)
)

(defrule
	(can-build monastery)
	(goal gl-strategy fccastle)
	(unit-type-count villager >= 70)
	(goal gl-walling-building -1)
	(or (goal gl-saving-wood -1)
		(goal gl-saving-wood monastery))
	(building-type-count-total monastery < 1)
=>
	(set-goal gl-walling-building monastery)
	;hi;(chat-to-all "monastery")
	(set-goal gl-split 1)
)

(defrule
	(goal gl-split 1)
	(goal gl-saving-wood monastery)
=>
	;hi;(chat-to-all "stop saving wood for monastery")
	(set-goal gl-amount-saving-wood 0)
	(set-goal gl-saving-wood -1)
)

(defrule
	(goal gl-split 1)
=>
	(set-goal gl-split -1)
)





;norman
