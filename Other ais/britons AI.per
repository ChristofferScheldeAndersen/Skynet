	(set-goal gl-spears-trained 0)
	(set-goal gl-wood-beco 0)
	
	(up-copy-point last-lc-used-x home-x)

	
	(set-goal gl-misc-flag1 0)
	(set-goal gl-misc-flag2 0)
	(disable-self)
)

