)

(defrule
	(true)
=>
	(up-full-reset-search)
	(set-goal gl-temp1 0)
	(set-goal gl-temp2 0)

	(up-copy-point point1-x home-x)
	(up-lerp-tiles point1-x estimated-enemy-x c: 11)
	;(up-send-flare point1-x)
)

(defrule
	(goal gl-front-gold 1)
=>
	(up-full-reset-search)
	(up-find-local c: mining-camp c: 10)
	(up-set-target-point home-x)
	(up-clean-search search-local 44 search-order-asc)
)

(defrule	;get point of the gold mine nearest the mining camp
	(up-set-target-object search-local c: 0)
=>
	(up-get-point position-object point1-x)
	(up-get-point-distance point1-x estimated-enemy-x gl-temp3)

	(set-strategic-number sn-focus-player-number 0)
	(up-find-remote c: gold-mine-class c: 40)
	(up-set-target-point point1-x)
	(up-clean-search search-remote 44 search-order-asc)
	;;(chat-to-all "hi")
)

(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point2-x)
	(up-get-point-distance point2-x estimated-enemy-x gl-temp2)
	(up-modify-goal gl-temp2 c:- 1)	;be safe
;	(set-goal gl-split 1)
	;;(chat-to-all "hi2")
)
;compare the distance to the enemy of the tower point to the distance to the enemy of the gold mine nearest the camp
;then if the distance to the enemy of the tower point is greater than that of the closest gold mine, move the tower point
(defrule
	(up-compare-goal gl-temp1 < 15)
	(or	(and(up-compare-goal gl-temp3 g:>= gl-temp2)		;further from enemy than the gold tile closest to the camp
			(up-set-target-object search-remote c: 0))
		(not(up-can-build-line 0 point1-x c: watch-tower)))
=>
	(up-get-point-distance point1-x estimated-enemy-x gl-temp3)
	(up-lerp-tiles point1-x estimated-enemy-x c: 1)
	(up-modify-goal gl-temp1 c:+ 1)
	;(up-send-flare point1-x)
	(up-jump-rule -1)
)

(defrule
	(true)
;	(up-can-build-line 0 point1-x c: watch-tower)
=>
	;;(up-chat-data-to-all "gl-temp2: %d" g: gl-temp2)
	;;(up-chat-data-to-all "gl-temp3: %d" g: gl-temp3)
	(up-build-line point1-x point1-x c: watch-tower)
	(up-modify-flag gl-misc-flag1 c:- fl-need-tower)
	;;(chat-to-all "tower")
)

(defrule
	(up-compare-goal gl-temp1 >= 15)
=>
	(up-set-placement-data my-player-number -1 c: 13)
	(up-modify-flag gl-misc-flag1 c:- fl-need-tower)
	(up-build place-control 0 c: watch-tower)
	;;(up-chat-data-to-all "failsafe tower(%d)" g: gl-temp1)
)
;end main jump

