(defrule	;account for leftover vills if all requirements have been met
	(up-set-target-object search-local c: 0)
	(goal gltemp-unassign-skip-this-pass -1)
	(up-compare-flag gl-misc-flag2 == fl-first-builders-assigned)
	(up-compare-goal gl-temp1 g:>= gl-desired-food-vills)
	(up-compare-goal gl-temp2 g:>= gl-desired-wood-vills)
	(up-compare-goal gl-temp3 g:>= gl-desired-berry-vills)
	(up-compare-goal gl-temp4 g:>= gl-desired-gold-vills)
	(up-compare-goal gl-temp5 g:>= gl-desired-stone-vills)
=>
	(up-remove-objects search-local -1 > 0)	
	;;(chat-to-all "add extra vills to group miscfoodgroup")
	(up-create-group 0 0 c: miscfoodgroup)
	(up-modify-group-flag 1 c: miscfoodgroup)
	(set-goal gltemp-unassign-skip-this-pass 1)
)













