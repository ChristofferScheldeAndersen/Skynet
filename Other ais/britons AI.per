	(up-find-remote c: farm c: 40)
	(up-remove-objects search-remote object-data-tasks-count > 0)
	(up-remove-objects search-remote 10 < 2)
	(up-set-target-point home-x)
	(up-clean-search search-remote 44 1)
)

(defrule
	(up-set-target-object search-remote c: 0)
=>
;	;;(chat-to-all "found idle farm")
	
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	
	(up-find-local c: villager-class c: 100)
	(up-remove-objects search-local object-data-group-flag == berrygroup)
	(up-remove-objects search-local object-data-group-flag == miscwoodgroup)
	(up-remove-objects search-local object-data-group-flag == miscgoldgroup)
	(up-remove-objects search-local object-data-group-flag == miscstonegroup)
	(up-remove-objects search-local object-data-group-flag == -2)
	(up-remove-objects search-local object-data-target == forage-class)
	(up-remove-objects search-local object-data-target == farm-class)
	(up-remove-objects search-local object-data-target == deer-class)
	(up-remove-objects search-local object-data-action == actionid-build)
	(up-remove-objects search-local object-data-action == actionid-attack)
	(up-clean-search search-local 44 1)
)

(defrule
	(up-set-target-object search-local c: 0)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point1-x)
;	;(up-send-flare point1-x)
	
	;hi;(chat-to-all "found foodie to retask")
	
	(up-remove-objects search-local -1 > 0)
	(up-target-objects 1 action-default -1 -1)
)
;end main jump
	
	


(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance c: -1 c: 30)
	(set-strategic-number sn-focus-player-number 0)
	(up-find-remote c: forage-class c: 10)
	(up-remove-objects search-remote object-data-carry < 15)
	(up-get-search-state lt)
)

(defrule
	(idle-farm-count >= 1)
	(or	(dropsite-min-distance live-boar > 15)
		(dropsite-min-distance live-boar == -1))
=>
	(up-full-reset-search)
	(set-strategic-number sn-focus-player-number me)
	(up-find-remote c: farm c: 40)
	(up-remove-objects search-remote object-data-tasks-count > 0)
)

(defrule					;if there are too many foragers
	(idle-farm-count >= 1)
	(up-set-target-object search-remote c: 0)
	(or	(dropsite-min-distance live-boar > 15)
		(dropsite-min-distance live-boar == -1))
	(up-compare-flag gl-misc-flag1 != fl-garrison)
	(or	(unit-type-count villager-forager >= 7)	;keep some foragers
		(and(up-compare-goal rt < 4)
			(unit-type-count villager-forager >= 5)))
=>
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	;;(chat-to-all "farmtask")
	
	(up-find-local c: forager1 c: 20)
	(up-find-local c: forager2 c: 20)
	(up-remove-objects search-local object-data-carry == 10)
	(up-remove-objects search-local object-data-action == actionid-build)
	(up-remove-objects search-local object-data-action == actionid-attack)
	(up-clean-search search-local 44 search-order-asc)
	(up-remove-objects search-local -1 > 0)
	(up-target-objects 0 action-default -1 -1)
	(up-jump-rule 2)
)

(defrule				;if there aren't too many foragers in dark age
	(idle-farm-count >= 1)
	(current-age == dark-age)
	(or	(dropsite-min-distance live-boar > 15)
		(dropsite-min-distance live-boar == -1))
	(up-compare-flag gl-misc-flag1 != fl-garrison)
	(unit-type-count villager-forager g:<= gl-desired-berry-vills)

	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class == farm-class)
=>
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	
	(up-find-local c: villager-class c: 20)
	(up-remove-objects search-local object-data-dropsite == mining-camp)
	(up-remove-objects search-local object-data-target == tree-class)
	(up-remove-objects search-local object-data-target == farm-class)
	(up-remove-objects search-local object-data-target == forage-class)
	(up-remove-objects search-local object-data-target == deer-class)
	(up-remove-objects search-local object-data-action == actionid-build)
	(up-remove-objects search-local object-data-action == actionid-attack)
	(up-clean-search search-local 44 search-order-asc)
	(up-remove-objects search-local -1 > 0)
)

(defrule
	(idle-farm-count >= 1)
	(current-age == dark-age)
	(or	(dropsite-min-distance live-boar > 15)
		(dropsite-min-distance live-boar == -1))
	(up-compare-flag gl-misc-flag1 != fl-garrison)
	(unit-type-count villager-forager g:<= gl-desired-berry-vills)

	(up-set-target-object search-remote c: 0)
	(up-object-data object-data-class == farm-class)
	(up-set-target-object search-local c: 0)
=>
	(up-target-objects 0 action-default -1 -1)
	;;(chat-to-all "new farmtask")
)

;qclaim sheep qsheepclaim
(defrule
	(true)
;	(false)
	(or	(up-compare-goal gl-scout-task != -1)
		(unit-type-count scout-cavalry-line < 1))
=>
	(up-jump-rule 6)
)

(defrule
	(true)
=>
	(set-goal gl-temp1 20)
)

(defrule
	(map-type arena)
=>
	(set-goal gl-temp1 30)
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point scout-x)
	(up-filter-distance c: -1 g: gl-temp1)
	(set-strategic-number sn-focus-player-number 0)
	(up-find-remote c: livestock-class c: 10)
	(up-clean-search search-remote 44 search-order-asc)
	(up-remove-objects search-remote 10 < 1)
)

(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point1-x)
	(up-bound-point point1-x point1-x)
	(up-find-local c: cobra-car c: 1)
	(up-target-point point1-x action-move -1 no-attack)
	(up-reset-search 1 1 0 0)

	(up-lerp-tiles point1-x scout-x c: -6)
	(up-bound-point point1-x point1-x)
	(up-find-local c: scout-cavalry-line c: 1)
	(up-target-point point1-x action-move -1 no-attack)

	(enable-timer t-sheep-claim 5)
; 	;;(chat-to-all "claim sheep")
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point scout-x)
	(up-filter-distance c: -1 c: 6)
	(up-find-local c: livestock-class c: 5)
	(set-strategic-number sn-focus-player-number 0)
	(up-find-remote c: livestock-class c: 5)
	(up-set-target-point home-x)                    
	(up-remove-objects search-local 44 < 7)	;not sheep under tc
	
	(up-modify-goal gl-temp1 g:= gl-total-sheep-count)
	(up-modify-goal gl-temp1 c:mod 2)
)

(defrule
	(not(up-set-target-object search-remote c: 0))
	(up-timer-status t-sheep-claim == timer-running)
	(or (up-set-target-object search-local c: 1)			;two sheep nearby
		(and(false)			;(goal gl-temp1 0)	;doesn't work since sheep count isn't updated	;even number of sheep found
			(up-set-target-object search-local c: 0)))		;one sheep neaby
=>
; 	;;(chat-to-all "stop claiming sheep")
	(disable-timer t-sheep-claim)
)

;end of jump




;qwallsnewnewnew		<-- lol
;first section, assigning a point to each unique forest nearby the town

(defrule
	(true)
;	(or	(game-time < 5)
;		(or	(up-compare-goal forest5-x != -1)
;			(up-compare-goal gl-new-wall-progression >= forestsfound)))
=>
	(up-jump-rule 18)
)

(defrule
	(true)
=>
	(set-goal gl-half-square-side-length 25)
	(up-copy-point point1-x home-x)
	
	(up-copy-point point2-x point1-x)	
	(up-modify-goal point2-x g:+ gl-half-square-side-length)
	(up-modify-goal point2-y g:+ gl-half-square-side-length)	;checking point
	(up-copy-point point3-x point2-x)	;best point
	
	(up-modify-goal gl-temp1 g:= point1-x)
	(up-modify-goal gl-temp1 g:- gl-half-square-side-length)	;x limit
	(up-modify-goal gl-temp2 g:= point1-y)
	(up-modify-goal gl-temp2 g:- gl-half-square-side-length)	;y limit
	(set-goal gl-temp3 1000)	;current score, 1000 to ensure it isn't below 0
	(set-goal gl-temp4 0)	;best score
;	;(up-send-flare point1-x)
;	;(up-send-flare point2-x)
)

;start the checking process
;start both upjumps
(defrule
	(or	(and(up-compare-goal forest1-x != -1)
			(up-point-distance point2-x forest1-x < 10))
		(or	(and(up-compare-goal forest2-x != -1)
				(up-point-distance point2-x forest2-x < 10))
			(or	(and(up-compare-goal forest3-x != -1)
					(up-point-distance point2-x forest3-x < 10))
				(or	(and(up-compare-goal forest4-x != -1)
						(up-point-distance point2-x forest4-x < 10))
					(and(up-compare-goal forest5-x != -1)
						(up-point-distance point2-x forest5-x < 10))))))
=>
	(up-jump-rule 6)	;skip if its in a previous forest
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point point2-x)
	(up-filter-distance c: -1 c: 3)
	
	(set-goal gl-temp5 0)	;tree counter
)

(defrule
	(true)
=>
	(up-find-resource c: tree-class c: 1)
)

(defrule	;found a tree near the point, add one score and check for another. if none found, this will just leave and the score will be left (hopefully)
	(up-set-target-object search-remote c: 0)
=>
	(up-remove-objects search-remote -1 == 0)
	(up-modify-goal gl-temp5 c:+ 1)
	(up-jump-rule -2)
)

(defrule
	(up-compare-goal gl-temp5 < 10)
=>
	(up-jump-rule 2)	;if not enough trees found around the point, don't consider it as a potential forest
)

(defrule	;add found trees to the score
	(true)
=>
	(up-modify-goal gl-temp3 g:+ gl-temp5)
)

(defrule
	(up-compare-goal gl-temp3 g:> gl-temp4)
=>
	(up-modify-goal gl-temp4 g:= gl-temp3)
;	;;(up-chat-data-to-all "treecenter found new best tile(%d)" g: gl-temp3)
	(up-copy-point point3-x point2-x)
;	;(up-send-flare point3-x)
)
;end small jumps

(defrule	;move down the column
	(up-compare-goal point2-x g:> gl-temp1)	;if it is <=, time to reset 
=>
	(set-goal gl-temp3 1000)	;reset score
	(up-modify-goal point2-x c:- 1)
;	;(up-send-flare point2-x)
;	;;(chat-to-all "move point down column")
	(up-jump-rule -8)
)

(defrule	;move over a column
	(up-compare-goal point2-y g:> gl-temp2)	;if it is ==, done with scan
	(up-compare-goal point2-x g:<= gl-temp1)	;if it is <=, time to shift
=>
	(set-goal gl-temp3 0)	;reset score
	(up-modify-goal point2-x g:= point1-x)
	(up-modify-goal point2-x g:+ gl-half-square-side-length)	;get it back to the top
	(up-modify-goal point2-y c:- 1)	;shift it over one
;	;(up-send-flare point2-x)
;	;;(chat-to-all "reset column")
	(up-jump-rule -9)
)


;do it
(defrule
	(true)
=>
	;;(up-chat-data-to-all "print final score: %d" g: gl-temp4)
	(do-nothing)
)

(defrule
	(up-compare-goal gl-temp4 < 1010)
=>
	;;(chat-to-all "no more forests, exiting function")
	(set-goal gl-new-wall-progression forestsfound)
	(up-jump-rule 5)
)

(defrule
	(goal forest1-x -1)
=>
	(up-copy-point forest1-x point3-x)
	;;(chat-to-all "new forest found1")
	;(up-send-flare point3-x)
	(up-jump-rule 4)
)

(defrule
	(goal forest2-x -1)
=>
	(up-copy-point forest2-x point3-x)
	;;(chat-to-all "new forest found2")
	;(up-send-flare point3-x)
	(up-jump-rule 3)
)

(defrule
	(goal forest3-x -1)
=>
	(up-copy-point forest3-x point3-x)
	;;(chat-to-all "new forest found3")
	;(up-send-flare point3-x)
	(up-jump-rule 2)
)

(defrule
	(goal forest4-x -1)
=>
	(up-copy-point forest4-x point3-x)
	;;(chat-to-all "new forest found4")
	;(up-send-flare point3-x)
	(up-jump-rule 1)
)

(defrule
