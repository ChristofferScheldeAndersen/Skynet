	(or	(building-type-count castle < 3)
		(up-compare-goal gl-strategy-style != longbows))
	(or	(military-population < 15)
		(or	(unit-type-count villager < 90)
			(and(up-compare-goal gl-strategy-style != longbows)
				(and(goal gl-cancel-forward-castle 1)
					(goal gl-walling-building castle)))))
=>
	(up-get-point position-object point4-x)
