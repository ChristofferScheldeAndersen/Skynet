	(up-get-object-data object-data-hp gl-temp2)
	(up-modify-goal gl-temp2 g:/ gl-temp3)
	(up-modify-goal gl-temp2 c:max 1)
	(up-modify-goal gl-temp2 c:+ 1)
	(up-modify-goal gl-temp2 c:+ 1)
	(up-modify-goal gl-longbows-number-of-shots-to-kill-target2 g:= gl-temp2)
)

