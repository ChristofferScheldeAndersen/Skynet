)

(defrule
	(goal gl-walling-side -1)
	(up-compare-goal gl-temp1 < 40)
	(up-point-explored building-wall1-x != explored-no)
	(up-point-distance building-wall1-x wall-end1-x >= 3)
	(not(up-can-build-line 0 building-wall1-x g: gl-wall-building))
=>
	(up-lerp-tiles building-wall1-x wall-end1-x c: 1)
	;(up-send-flare building-wall1-x)
	(up-modify-goal gl-temp1 c:+ 1)
	(up-jump-rule -1)
)

(defrule
	(goal gl-walling-side 1)
	(up-compare-goal gl-temp1 < 40)
	(up-point-explored building-wall2-x != explored-no)
	(up-point-distance building-wall2-x wall-end2-x >= 3)
	(not(up-can-build-line 0 building-wall2-x g: gl-wall-building))
=>
	(up-lerp-tiles building-wall2-x wall-end2-x c: 1)
	;(up-send-flare building-wall2-x)
	(up-modify-goal gl-temp1 c:+ 1)
	(up-jump-rule -1)
)

(defrule
	(goal gl-walling-side -1)
	(up-can-build-line 0 building-wall1-x g: gl-wall-building)
=>
	(up-build-line building-wall1-x building-wall1-x g: gl-wall-building)
	(up-modify-goal gl-walling-side c:* -1)
	;(up-send-flare building-wall1-x)
;	;;(chat-to-all "place building 1")
	(set-goal gl-wall-building -1)
)	

(defrule
	(goal gl-walling-side 1)
	(up-can-build-line 0 building-wall2-x g: gl-wall-building)
=>
	(up-build-line building-wall2-x building-wall2-x g: gl-wall-building)
	(up-modify-goal gl-walling-side c:* -1)
	;(up-send-flare building-wall2-x)
;	;;(chat-to-all "place building 2")
	(set-goal gl-wall-building -1)
)

(defrule
	(up-compare-goal gl-wall-building != -1)
=>
	(up-build place-normal 0 g: gl-wall-building)
	(up-modify-goal gl-walling-side c:* -1)
	;;(chat-to-all "failsafe building")
	(set-goal gl-wall-building -1)
	
	(up-copy-point building-wall1-x point1-x)
	(up-copy-point building-wall2-x point2-x)	;reset the point to try again
	;(up-send-flare building-wall1-x)
	;(up-send-flare building-wall2-x)
)
	
;end jump


(defrule
	(false)
	(game-time > 5)
;	(building-type-count-total house >= 6)	;testing
	(building-type-count-total palisade-wall < 1)
	(or (up-compare-flag gl-misc-flag1 == fl-enemy-flushing)
		(up-research-status c: castle-age >= research-complete))
=>
	(up-assign-builders c: palisade-wall c: -1)
	;;(chat-to-all "add palisades")
	(set-goal gl-walling 0)
	(disable-self)
)

