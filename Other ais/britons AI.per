;	(false)
	(or	(military-population < 15)
		(unit-type-count villager < 90))
	(building-type-count wall-class >= 20)
	(up-set-target-object search-local c: 0)
	(up-point-distance point2-x home-x >= 17)
	(or	(goal gl-dropsite-to-build lc)
		(up-compare-flag gl-misc-flag2 == fl-dropsite-is-tc))
=>
	(up-get-point position-object point4-x)
	(up-get-point-distance point4-x home-x gl-temp10)
)

(defrule
;	(false)
	(or	(military-population < 15)
		(unit-type-count villager < 90))
	(building-type-count wall-class >= 20)
	(up-set-target-object search-local c: 0)
