(defrule
	(up-compare-goal gl-next-villager != -1)
	(up-compare-goal gl-villager-count-tracker g:< gl-temp1)
=>
	;;(chat-to-all "new villager")

	(up-gather-inside c: town-center c: 0)
	(up-modify-flag gl-misc-flag1 c:- 32768)
	(up-modify-goal gl-villager-count-tracker c:+ 1)
	
	(up-get-indirect-goal g: gl-next-villager gl-temp2)		;gl-next-villager will link to the corresponding goal of the villager that is next
	(up-modify-goal gl-temp2 c:+ 1)								;so if it is berry, and gl-desired-berry-vills is 5, it will store 5 in gl-temp1
	(up-set-indirect-goal g: gl-next-villager g: gl-temp2)
	(set-goal gl-next-villager -1)
)

(defrule
;	(false)
;	(goal gl-eco-switch -1)
	(or	(goal gl-switch-to-percentage-eco -1)
		(up-compare-flag gl-misc-flag2 == fl-use-default-eco))
=>
	(up-jump-rule 2)
)

(defrule
	(goal gl-thirty-turn 1)
=>
	(up-modify-goal gl-temp1 g:= gl-percent-food-gatherers)
	(up-modify-goal gl-temp1 g:+ gl-percent-wood-gatherers)
	(up-modify-goal gl-temp1 g:+ gl-percent-gold-gatherers)
	(up-modify-goal gl-temp1 g:+ gl-percent-stone-gatherers)
	;;(up-chat-data-to-all "percents total: %d" g: gl-temp1)
)
	
(defrule
	(true)
=>
	(up-get-fact unit-type-count villager gl-temp1)
	(up-modify-goal gl-desired-food-vills g:= gl-percent-food-gatherers)
	(up-modify-goal gl-desired-food-vills g:* gl-temp1)
	
	(up-modify-goal gl-desired-wood-vills g:= gl-percent-wood-gatherers)
	(up-modify-goal gl-desired-wood-vills g:* gl-temp1)

	(up-modify-goal gl-desired-gold-vills g:= gl-percent-gold-gatherers)
	(up-modify-goal gl-desired-gold-vills g:* gl-temp1)
	
	(up-modify-goal gl-desired-stone-vills g:= gl-percent-stone-gatherers)
	(up-modify-goal gl-desired-stone-vills g:* gl-temp1)	
;	;;(chat-to-all "eco switch done")
;	(set-goal gl-eco-switch -1)
)
















