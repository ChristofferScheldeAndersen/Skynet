;small jumps target
(defrule	;move down the column
	(up-compare-goal point2-x g:> gl-temp1)	;if it is <=, time to reset 
=>
	(set-goal gl-temp3 1000)	;reset score
	(up-modify-goal point2-x c:- 2)		;!!!!!!!!!!
;	;(up-send-flare point2-x)
;	;;(chat-to-all "move point")
	(up-jump-direct g: gl-rule-id1)
;	(up-jump-rule -23)
)

(defrule	;move over a column
	(up-compare-goal point2-y g:> gl-temp2)	;if it is <=, done with scan
	(up-compare-goal point2-x g:<= gl-temp1)	;if it is <=, time to shift
=>
	(set-goal gl-temp3 0)	;reset score
	(up-modify-goal point2-x g:= point1-x)
	(up-modify-goal point2-x g:+ gl-half-square-side-length)	;get it back to the top
	(up-modify-goal point2-y c:- 1)	;shift it over one
;	;(up-send-flare point2-x)
;	;;(chat-to-all "reset column")
	(up-jump-direct g: gl-rule-id1)
;	(up-jump-rule -24)
)

(defrule	;build it!
	(up-compare-goal gl-temp4 != 0)
	(goal gl-walling-building castle)
	(up-can-build-line 0 point3-x g: gl-walling-building)
=>
	(up-build-line point3-x point3-x g: gl-walling-building)
	;hi;(up-chat-data-to-all "build castle12(%d)" g: gl-temp12)
	(up-modify-goal gl-buildings-placed-this-pass c:+ 1)
	;hi;(up-chat-data-to-all "build castle4(%d)" g: gl-temp4)
	;hi;(up-chat-data-to-all "build castle3(%d)" g: gl-temp3)
	(set-goal gl-walling-building-size -1)
	(set-goal gl-walling-building -1)
	;(up-send-flare estimated-enemy-x)
	;(up-send-flare point5-x)
	;(up-send-flare center-x)
	
	(up-jump-rule 3)	;right for now
)

(defrule	;build it!
	(up-compare-goal gl-temp4 != 0)
	(up-can-build-line 0 point3-x g: gl-walling-building)
=>
	(up-build-line point3-x point3-x g: gl-walling-building);debug
;;(up-chat-data-to-all "build normal building(%d)" g: gl-walling-building)
	(set-goal gl-walling-building-size -1)
	(set-goal gl-walling-building -1)
									;	(up-copy-point point1-x point3-x)
									;	(up-modify-goal point1-x c:+ 1)
									;	(up-build-line point1-x point1-x c: palisade-wall)
									;	(up-copy-point point1-x point3-x)
									;	(up-modify-goal point1-x c:- 1)
									;	(up-build-line point1-x point1-x c: palisade-wall)
									;	(up-copy-point point1-x point3-x)
									;	(up-modify-goal point1-y c:+ 1)
									;	(up-build-line point1-x point1-x c: palisade-wall)
									;	(up-copy-point point1-x point3-x)
									;	(up-modify-goal point1-y c:- 1)
									;	(up-build-line point1-x point1-x c: palisade-wall)
									;	(enable-timer t-building-delay 3)
	(up-modify-goal gl-buildings-placed-this-pass c:+ 1)
	;hi;(up-chat-data-to-all "build normal12(%d)" g: gl-temp12)
	;hi;(up-chat-data-to-all "build normal4(%d)" g: gl-temp4)
	;hi;(up-chat-data-to-all "build normal3(%d)" g: gl-temp3)
	
	(up-jump-rule 2)	;right for now
)

(defrule	;debug
	(or	(up-compare-goal gl-temp4 == 0)
		(not(up-can-build-line 0 point3-x g: gl-walling-building)))
=>
	;(up-send-flare point3-x)
	(set-goal gl-walling-building-size -1)
	(set-goal gl-walling-building -1)
	(up-modify-goal gl-generalbuild-threshold c:+ 1);debug
;;(up-chat-data-to-all "general something went wrong(%d)" g: gl-generalbuild-threshold)
	(up-jump-rule 2)
)

(defrule	;debug
	(true)
=>
	;(up-send-flare point3-x)
	;(up-send-flare point4-x)
	(set-goal gl-walling-building-size -1)
	(set-goal gl-walling-building -1);debuggggg
;;(chat-to-all "general something went really wrong")
)


(defrule	;if the distance of the best tile is closer, go ahead and lower it. increase it by one though. it will never be lower, and it will never go up, except if no place is found.
;	(unit-type-count villager >
	(false)
	(up-compare-goal gl-walling-building != castle)
	(up-compare-goal gl-temp12 g:< gl-generalbuild-threshold)	
=>
	(up-modify-goal gl-generalbuild-threshold g:= gl-temp12)
	(up-modify-goal gl-generalbuild-threshold c:+ 1)
	;hi;(up-chat-data-to-all "reduce threshold(%d)" g: gl-generalbuild-threshold)
)

;end main jump


(defrule
	(true)
=>
	(set-goal gl-generalbuild-threshold 10)
	(disable-self)
)





















































;qforward buildings
(defrule	;test
	(goal gl-tenth-turn 1)
	(false)	
	(game-time >= 10)
	(can-build castle)
	(goal gl-forward-building -1)
;	(up-pending-objects c: castle < 1)
=>
	(set-goal gl-forward-building castle)
;	(disable-self)
)

(defrule
	(true)
	(or	(game-time < 6)
		(or	(up-compare-goal gl-buildings-placed-this-pass >= 1)
			(or	(goal gl-forward-building -1)
				(not(up-can-build 0 g: gl-forward-building)))))
=>
	(up-jump-rule 22)
)

(defconst temp-gl-x-limit gl-temp1id)
(defconst temp-gl-y-limit gl-temp2id)
(defconst temp-gl-current-tile-score gl-temp3id)
(defconst temp-gl-best-tile-score gl-temp4id)
(defconst temp-gl-half-square-side-length gl-temp7id)
(defconst temp-gl-closest-tc-distance gl-temp8id)
(defconst temp-gl-closest-lc-distance gl-temp9id)
(defconst temp-gl-closest-mc-distance gl-temp10id)

(defconst temp-scan-center-x point1-xid)
(defconst temp-scan-center-y point1-yid)
(defconst temp-current-scan-x point2-xid)
(defconst temp-current-scan-y point2-yid)
(defconst temp-best-tile-x point3-xid)
(defconst temp-best-tile-y point3-yid)

(defrule
	(true)
=>
	(set-goal temp-gl-x-limit -1)	;set below
	(set-goal temp-gl-y-limit -1)
	(set-goal temp-gl-current-tile-score 10000)
	(set-goal temp-gl-best-tile-score 0)
	(set-goal gl-temp5 -1)
	(set-goal gl-temp6 -1)
	(set-goal temp-gl-half-square-side-length 25)
	(set-goal temp-gl-closest-tc-distance 100)
	(set-goal temp-gl-closest-lc-distance 100)
	(set-goal temp-gl-closest-mc-distance 100)

	(set-goal point4-x -1)
	(set-goal point4-y -1)

	;hi;(up-chat-data-to-all "forwardbuild: %d" g: gl-forward-building)
	(up-copy-point temp-scan-center-x estimated-enemy-x)
	(up-lerp-tiles temp-scan-center-x home-x c: 20)
	
	(up-copy-point temp-current-scan-x temp-scan-center-x)	
	(up-modify-goal temp-current-scan-x g:+ temp-gl-half-square-side-length)
	(up-modify-goal temp-current-scan-y g:+ temp-gl-half-square-side-length)	;checking point
	(up-copy-point temp-best-tile-x temp-current-scan-x)	;best point
	
	(up-modify-goal temp-gl-x-limit g:= temp-scan-center-x)
	(up-modify-goal temp-gl-x-limit g:- temp-gl-half-square-side-length)	;x limit
	(up-modify-goal temp-gl-y-limit g:= temp-scan-center-y)
	(up-modify-goal temp-gl-y-limit g:- temp-gl-half-square-side-length)	;y limit
	;(up-send-flare temp-scan-center-x)
;	;(up-send-flare temp-current-scan-x)
)




(defrule		;;
	(true)
=>
	(up-get-rule-id gl-rule-id1)
)

(defrule
	(not(up-can-build-line 0 temp-current-scan-x g: gl-forward-building))
=>
	(up-jump-rule 14)
)

(defrule	;quickie
	(or	(up-point-distance temp-current-scan-x estimated-enemy-x < 20)	;for now
		(and(up-point-contains estimated-enemy-x c: town-center)	;more accurate
			(up-point-distance temp-current-scan-x estimated-enemy-x < 23)))
=>
	(up-jump-rule 13)
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point temp-current-scan-x)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)

	(up-filter-distance c: -1 c: 15)
	(up-find-remote c: castle c: 1)
	(up-filter-distance c: -1 c: 5)
	(up-find-remote c: tc c: 1)
		
	(up-filter-distance c: -1 c: 10)
	(up-find-local c: castle c: 1)
	(up-filter-status c: status-pending c: list-active)	;end
	(up-find-status-local c: castle c: 1)
)

(defrule
	(or	(up-set-target-object search-local c: 0)
		(up-set-target-object search-remote c: 0))
=>
	(up-jump-rule 11)
)

(defrule
	(building-type-count wall-class >= 20)	;arena type
=>
	(up-full-reset-search)
	(up-set-target-point temp-current-scan-x)
	(up-filter-distance c: -1 c: 25)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-find-remote c: wall-class c: 40)
	(up-clean-search search-remote 44 1)
)

(defrule
	(building-type-count wall-class >= 20)
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point4-x)
	(up-get-point-distance point4-x estimated-enemy-x gl-temp6)
)

(defrule
	(building-type-count wall-class >= 20)
	(up-set-target-object search-remote c: 0)
	(up-point-distance temp-current-scan-x estimated-enemy-x g:< gl-temp6)	;closer to inside the base
=>
	(up-jump-rule 8)
)

;============ scoring
;tc
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point temp-current-scan-x)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-find-remote c: tc c: 10)
	(up-clean-search search-remote 44 1)
)

(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point4-x)
	(up-get-point-distance point4-x temp-current-scan-x temp-gl-closest-tc-distance)
	(up-modify-goal temp-gl-closest-mc-distance c:max 5)
	(up-modify-goal temp-gl-closest-tc-distance c:min 15)	;15 and 30 are no different
)

;lc
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point temp-current-scan-x)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-find-remote c: lc c: 10)
	(up-clean-search search-remote 44 1)
)

(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point4-x)
	(up-get-point-distance point4-x temp-current-scan-x temp-gl-closest-lc-distance)
	(up-modify-goal temp-gl-closest-mc-distance c:max 5)
	(up-modify-goal temp-gl-closest-lc-distance c:min 15)
)

;mc
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point temp-current-scan-x)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-find-remote c: mc c: 10)
	(up-clean-search search-remote 44 1)
)

(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point4-x)
	(up-get-point-distance point4-x temp-current-scan-x temp-gl-closest-mc-distance)
	(up-modify-goal temp-gl-closest-mc-distance c:max 5)
	(up-modify-goal temp-gl-closest-mc-distance c:min 15)
)


;=====

(defrule
	(true)
=>
	(up-get-point-distance temp-current-scan-x estimated-enemy-x gl-temp5)
	(up-modify-goal gl-temp5 c:* 2)
	(up-modify-goal temp-gl-current-tile-score g:- gl-temp5)
	(up-get-point-distance temp-current-scan-x temp-scan-center-x gl-temp5)
	(up-modify-goal gl-temp5 c:* 2)
	(up-modify-goal temp-gl-current-tile-score g:- gl-temp5)
	(up-modify-goal temp-gl-closest-tc-distance c:* 3)
	(up-modify-goal temp-gl-current-tile-score g:- temp-gl-closest-tc-distance)
	(up-modify-goal temp-gl-closest-mc-distance c:* 1)
	(up-modify-goal temp-gl-current-tile-score g:- temp-gl-closest-mc-distance)
	(up-modify-goal temp-gl-closest-lc-distance c:* 1)
	(up-modify-goal temp-gl-current-tile-score g:- temp-gl-closest-lc-distance)

)

(defrule	;rule to skip
	(up-compare-goal temp-gl-current-tile-score g:> temp-gl-best-tile-score)
=>
	(up-modify-goal temp-gl-best-tile-score g:= temp-gl-current-tile-score)
	;hi;(up-chat-data-to-all "forward new best(%d)" g: temp-gl-current-tile-score)
	(up-copy-point temp-best-tile-x temp-current-scan-x)
	;(up-send-flare temp-best-tile-x)
)










(defrule
	(up-compare-goal temp-current-scan-x g:> temp-gl-x-limit)
=>
	(set-goal temp-gl-current-tile-score 10000)
	(up-modify-goal temp-current-scan-x c:- 2)	;1
	(up-jump-direct g: gl-rule-id1)
)

(defrule
	(up-compare-goal temp-current-scan-y g:> temp-gl-y-limit)
	(up-compare-goal temp-current-scan-x g:<= temp-gl-x-limit)
=>
	(set-goal temp-gl-current-tile-score 10000)
	(up-modify-goal temp-current-scan-x g:= temp-scan-center-x)
	(up-modify-goal temp-current-scan-x g:+ temp-gl-half-square-side-length)
	(up-modify-goal temp-current-scan-y c:- 1)	;shift it over one
	(up-jump-direct g: gl-rule-id1)
)

(defrule
	(up-compare-goal temp-gl-best-tile-score > 0)
	(up-can-build-line 0 temp-best-tile-x g: gl-forward-building)
=>
	(up-build-line temp-best-tile-x temp-best-tile-x g: gl-forward-building)
	;hi;(up-chat-data-to-all "forward build(%d)" g: temp-gl-best-tile-score)
	(up-modify-goal gl-buildings-placed-this-pass c:+ 1)
	(set-goal gl-forward-building -1)
	(up-jump-rule 2)
)

(defrule
	(or	(up-compare-goal temp-gl-best-tile-score == 0)
		(not(up-can-build-line 0 temp-best-tile-x g: gl-forward-building)))
=>
	;hi;(up-chat-data-to-all "forward debug(%d)" g: temp-gl-best-tile-score)
	(set-goal gl-forward-building -1)
	;(up-send-flare temp-best-tile-x)
	(up-jump-rule 1)
)

(defrule
	(true)
=>
	;hi;(up-chat-data-to-all "forward debug2(%d)" g: temp-gl-best-tile-score)
	(set-goal gl-forward-building -1)
	;(up-send-flare temp-best-tile-x)
)
