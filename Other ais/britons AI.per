;attack enemy scout
(defrule
	(or	(not(up-set-target-by-id g: gl-scout-id))
		(up-compare-goal gl-ageup-feudal-advantage != 1))
=>
	(up-jump-rule 2)
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point scout-x)
	(up-filter-distance c: -1 c: 20)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-find-remote c: scout-cavalry c: 1)
)

(defrule
	(up-set-target-object search-remote c: 0)
	(up-set-target-by-id g: gl-scout-id)
	(up-object-data object-data-action != actionid-attack)
=>
	(up-add-object-by-id search-local g: gl-scout-id)
	;hi;(chat-to-all "attack weak scout with scout")
	(up-target-objects 1 action-default -1 -1)
)
;;;;;






;archers group micro stuff.
(defrule
	(up-compare-goal gl-strategy != barbecue)
=>
	(up-jump-rule 3)
)

(defconst gltemp-archer-group-size gl-temp1id)

;first, find the first archer to add to the group. i'd say in general, first one would probably be front one like always
(defrule
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: archer-line c: 240)
	(up-remove-objects search-local object-data-group-flag == -2)
	(up-get-search-state lt)
	(up-modify-goal gltemp-archer-group-size g:= lt)
)

(defrule
	(up-compare-goal gltemp-archer-group-size < 1)
=>
	(up-full-reset-search)
	(up-find-local c: archer-line c: 240)
	(up-remove-objects search-local object-data-group-flag != -2)
	(up-set-target-point estimated-enemy-x)
	(up-clean-search search-local 44 1)
)

(defrule
	(up-set-target-object search-local c: 0)
	(up-compare-goal gltemp-archer-group-size < 1)
=>
	(up-remove-objects search-local -1 > 0)	
	;hi;(chat-to-all "add to archergroupone")
	(up-create-group 0 0 c: archergroupone)
	(up-modify-group-flag 1 c: archergroupone)
)
;;;;











;retreat scout under attack to home
(defrule
	(up-set-target-by-id g: gl-scout-id)
=>
	(up-full-reset-search)
	(up-set-target-point scout-x)
	(up-filter-distance c: -1 c: 6)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(up-find-remote c: all-units-class c: 40)
	(set-goal gl-loop-failsafe1 0)
)

(defrule	;;
	(false)
	(up-set-target-by-id g: gl-scout-id)	;
	(up-object-data object-data-move-x g:!= home-x)
	(up-object-target-data object-data-base-type != monk)
	(up-object-target-data object-data-base-type != monk-with-relic)
	(up-compare-goal gl-ageup-feudal-advantage != 1)	;not with the stronger scout
	(up-set-target-object search-remote c: 0)	;
	(up-object-data object-data-target-id g:== gl-scout-id)
	(or	(up-object-data object-data-class == cavalry-class)
		(up-object-data object-data-class == scout-cavalry-class))
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-scout-id)
	(up-target-point home-x action-move -1 no-attack)
	;(chat-to-all "run home with scout")
	(up-jump-rule 1)
)

(defrule
	(false)
	(up-set-target-by-id g: gl-scout-id)
	(up-compare-goal gl-loop-failsafe1 < 40)
	(up-set-target-object search-remote c: 1)
=>
	(up-remove-objects search-remote -1 == 0)
	(up-modify-goal gl-loop-failsafe1 c:+ 1)
	(up-jump-rule -2)
)






(defrule
	(false)
	(up-set-target-by-id g: gl-scout-id)
	(up-object-data object-data-move-x != home-x)
	(up-object-data object-data-under-attack == 1)
	(up-compare-goal gl-ageup-feudal-advantage != 1)
=>
	(up-get-object-data object-data-attacker-id gl-temp1)
)

(defrule
	(false)
	(up-set-target-by-id g: gl-scout-id)
	(up-object-data object-data-move-x != home-x)
	(up-compare-goal gl-ageup-feudal-advantage != 1)	;not with the stronger scout
	(up-set-target-by-id g: gl-temp1)	;
	(or	(up-object-data object-data-class == cavalry-class)
		(up-object-data object-data-class == scout-cavalry-class))
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-scout-id)
	(up-target-point home-x action-move -1 no-attack)
	;hi;(chat-to-all "run home with scout(false)")
)
