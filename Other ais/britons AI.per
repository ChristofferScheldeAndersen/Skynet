;set up looping through walling points (this only works because the goal defconsts are consecutive)
(defrule
	(true)
;	(or	(game-time < 3)
;		(up-research-status c: feudal-age < research-pending))
=>
	(up-jump-rule 20)
)

(defrule
	(up-compare-goal gl-walling-stage < startwalling)
	(up-compare-goal gl-x-looper > highest-wall-x-index)
=>
	;;(chat-to-all "move to next walling stage")
	(up-modify-goal gl-walling-stage c:+ 1)
)

;start upjump
(defrule
	(or	(goal gl-x-looper -1)
		(up-compare-goal gl-x-looper > highest-wall-x-index))
=>
	(set-goal gl-x-looper lowest-wall-x-index)
	(set-goal gl-y-looper lowest-wall-x-index)
;	;;(chat-to-all "general wall loop reset")
	(up-modify-goal gl-y-looper c:+ 1)
)

(defrule
	(true)
=>
	(up-get-indirect-goal g: gl-x-looper current-wall-point-x) ;get the value of goal id 103 indirectly into a goal using gl-temp1.
	(up-get-indirect-goal g: gl-y-looper current-wall-point-y)	
)

;clamp points to map edge
(defrule
	(up-compare-goal gl-walling-stage != clamptoedge)
=>	
	(up-jump-rule 5)
)

(defrule
	(true)
=>
	(up-modify-goal gl-temp3 g:= gl-max-coordinate-value)
	(up-modify-goal gl-temp3 c:- 7)
)

(defrule
	(up-compare-goal current-wall-point-x g:>= gl-temp3)
	(up-compare-goal current-wall-point-x g:< gl-max-coordinate-value)
=>
	(up-set-indirect-goal g: gl-x-looper g: gl-max-coordinate-value)
	(up-get-indirect-goal g: gl-x-looper point5-x)
	(up-get-indirect-goal g: gl-y-looper point5-y)
	;;(chat-to-all "max-clamp to map edge x")
	;(up-send-flare point5-x)
)

(defrule
	(up-compare-goal current-wall-point-y g:>= gl-temp3)
	(up-compare-goal current-wall-point-y g:< gl-max-coordinate-value)
=>
	(up-set-indirect-goal g: gl-y-looper g: gl-max-coordinate-value)
	(up-get-indirect-goal g: gl-x-looper point5-x)
	(up-get-indirect-goal g: gl-y-looper point5-y)
	;;(chat-to-all "max-clamp to map edge y")
	;(up-send-flare point5-x)
)

(defrule
	(up-compare-goal current-wall-point-x < 7)
	(up-compare-goal current-wall-point-x >= 1)
=>
	(up-get-indirect-goal g: gl-x-looper point5-x)
	(up-get-indirect-goal g: gl-y-looper point5-y)
	(up-set-indirect-goal g: gl-x-looper c: 0)
	;;(chat-to-all "min-clamp to map edge x")
	;(up-send-flare point5-x)
)

(defrule
	(up-compare-goal current-wall-point-y < 7)
	(up-compare-goal current-wall-point-y >= 1)
=>
	(up-get-indirect-goal g: gl-x-looper point5-x)
	(up-get-indirect-goal g: gl-y-looper point5-y)
	(up-set-indirect-goal g: gl-y-looper c: 0)
	;;(chat-to-all "min-clamp to map edge y")
	;(up-send-flare point5-x)
)
;end clamp jump

;find the closest vertex to the enemy
(defrule
	(up-compare-goal gl-walling-stage != findfrontvertex)
=>
	(up-jump-rule 3)
)

(defrule
	(true)
=>
	(set-goal gl-best-distance 1000)
	(disable-self)
)

(defrule
	(true)
=>
	(up-get-point-distance current-wall-point-x estimated-enemy-x gl-temp4)
)

(defrule
	(true)
	(up-compare-goal gl-temp4 g:< gl-best-distance)
=>
	(up-copy-point front-vertex-x current-wall-point-x)
	(up-modify-goal gl-front-vertex-x-index g:= gl-x-looper)	;save the goalid of the current goal
	(up-modify-goal gl-best-distance g:= gl-temp4)
	;;(chat-to-all "new best vertex found")
	;(up-send-flare front-vertex-x)
)
;end front vertex jump

;check around each vertex for trees and move toward them if there are
(defrule
	(up-compare-goal gl-walling-stage != adjustfortrees)
=>
	(up-jump-rule 5)
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point current-wall-point-x)
	(up-filter-distance c: -1 c: 5)
	(set-strategic-number sn-focus-player-number 0)
	(up-find-remote c: tree-class c: 40)			;standing trees
	(set-goal point1-x 0)
	(set-goal point1-y 0)
	(set-goal gl-temp1 0)
	(set-goal lt 0)
)

(defrule
	(not(up-set-target-object search-remote c: 4))	;skip if not enough trees
=>
	(up-jump-rule 3)
)

