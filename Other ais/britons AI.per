(defrule
	(goal gl-deer -1)
	(up-set-target-object search-remote c: 1)	;another deer to target
	(up-set-target-by-id g: gl-deer-id)
	(up-compare-flag gl-misc-flag1 == fl-deer-walking)
=>
	(up-remove-objects search-remote object-data-id g:== gl-deer-id)
	;hi;(chat-to-all "not walking deer")
)

(defrule
;	(game-time >= 5)
	(goal gl-deer -1)
	(game-time >= 180)	;for now
	(up-set-target-object search-remote c: 0)
	(or	(game-time >= 120)	;2 min
		(up-compare-goal gl-deer-distance < 15))
	(up-timer-status t-sheep-claim != timer-running)
	(or	(goal gl-deer-id -1)
		(up-compare-flag gl-misc-flag1 == fl-deer-walking))
	(or	(game-time >= 240)	;4 min
		(or	(and(goal gl-livestock-type cow)
				(up-compare-goal gl-total-sheep-count >= 5))
			(and(goal gl-livestock-type -1)
				(up-compare-goal gl-total-sheep-count >= 7))))
=>	
	(up-get-object-data object-data-precise-x deer-original-x-precise)
	(up-get-object-data object-data-precise-y deer-original-y-precise)
	(up-modify-flag gl-misc-flag1 c:- fl-deer-walking)
	(up-get-object-data object-data-id gl-deer-id)
	;hi;(chat-to-all "start luring deer")
	;hi;(up-chat-data-to-all "gl-total-sheep-count: %d" g: gl-total-sheep-count)
	;hi;(up-chat-data-to-all "gl-livestock-type: %d" g: gl-livestock-type)
	(set-goal gl-scouting 100)
	(set-goal gl-deer 0)
)

(defrule	;deer info
	(up-set-target-by-id g: gl-deer-id)
=>
	(up-get-object-data object-data-precise-x temp-precise-deer-x)
	(up-get-object-data object-data-precise-y temp-precise-deer-y)
	
	(up-copy-point temp-shooting-zone-precise-x home-x)		;forgot this part at first :'D
	(up-modify-goal temp-shooting-zone-precise-x c:- 1)		;point the deer gets shot in reference to
	(up-modify-goal temp-shooting-zone-precise-y c:+ 1)	;move it down
	(up-modify-goal temp-shooting-zone-precise-x c:* 100)
	(up-modify-goal temp-shooting-zone-precise-y c:* 100)
	
	(up-copy-point temp-lure-destination-precise-x home-x)		;this is the point the deer is getting pushed towards
	(up-modify-goal temp-lure-destination-precise-x c:- 1)
	(up-modify-goal temp-lure-destination-precise-y c:+ 0)
;	(up-build-line temp-lure-destination-precise-x temp-lure-destination-precise-x c: palisade-wall)
	(up-modify-goal temp-lure-destination-precise-x c:* 100)
	(up-modify-goal temp-lure-destination-precise-y c:* 100)
	(up-modify-goal temp-lure-destination-precise-x c:+ 50)
	(up-modify-goal temp-lure-destination-precise-y c:+ 50)	;get it into the exact center (not left corner of tile)
	
	(up-modify-goal temp-lure-destination-precise-y c:+ 50)	;lower it a bit
	(up-modify-goal temp-lure-destination-precise-x c:- 50)	
	
	(up-get-object-data 13 gl-temp1)
;	;;(up-chat-data-to-all "speed: %d" g: gl-temp1)
	(up-get-object-data object-data-precise-move-x point4-x)
	(up-get-object-data object-data-precise-move-y point4-y)
)

