	(true)
=>
	(do-nothing)
)















(defconst gltemp-plusone-projected-food-gatherers gl-temp6id)
(defconst gltemp-plusone-projected-wood-gatherers gl-temp7id)
(defconst gltemp-plusone-projected-gold-gatherers gl-temp8id)
(defconst gltemp-plusone-projected-stone-gatherers gl-temp9id)
(defconst gltemp-plusone-projected-berry-gatherers gl-temp10id)
(defconst gltemp-unassign-skip-this-pass gl-temp11id)

;qvillgroup qvilgroup


(defrule
	(taunt-detected me 23)
=>
	(up-modify-flag gl-misc-flag2 c:+ fl-use-default-eco)
	;hi;(chat-to-all "switch to default eco")
	(acknowledge-taunt me 23)
)

;clear all control groups
(defrule
	(up-compare-flag gl-misc-flag2 != fl-use-default-eco)
=>
	(up-jump-rule 1)
)

(defrule
	(goal gl-tenth-turn 1)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 240)

	(up-create-group 0 0 c: miscstonegroup)
	(up-modify-group-flag 0 c: miscstonegroup)

	(up-create-group 0 0 c: miscgoldgroup)
	(up-modify-group-flag 0 c: miscgoldgroup)

	(up-create-group 0 0 c: miscfoodgroup)
	(up-modify-group-flag 0 c: miscfoodgroup)
	
	(up-create-group 0 0 c: miscwoodgroup)
	(up-modify-group-flag 0 c: miscwoodgroup)
)


















;add villagers to control groups
