;qlongbowgroup
;control ability sn's
(defrule
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(set-difficulty-parameter ability-to-maintain-distance 100)
	(set-difficulty-parameter ability-to-dodge-missiles 100)
)

(defrule
	(up-compare-goal gl-longbow-group-size < 1)
=>
	(set-difficulty-parameter ability-to-maintain-distance 0)
	(set-difficulty-parameter ability-to-dodge-missiles 0)
)










(defrule
	(taunt-detected me 73)
=>
	(acknowledge-taunt me 72)
	(acknowledge-taunt me 73)
)

;disband the group
(defrule
	(taunt-detected me 72)
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-full-reset-search)
	(up-find-local c: longbowman-line c: 100)
	(up-remove-objects search-local object-data-group-flag != longbow1)
)

(defrule
	(taunt-detected me 72)
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-create-group 0 0 c: longbow1)
	(up-target-point home-x action-stop formation-stagger aggressive)
	(up-modify-group-flag 0 c: longbow1)
)

(defrule
	(unit-type-count longbowman-line >= 1)
=>
	(up-full-reset-search)
	(up-find-local c: longbowman-line c: 100)
	(up-remove-objects search-local object-data-group-flag != longbow1)
	(up-get-search-state lt)
	(up-modify-goal gl-longbow-group-size g:= lt)
)


;create new group
(defrule
	(not(taunt-detected me 72))
	(up-compare-goal gl-longbow-group-size < 1)
=>
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-find-local c: longbowman-line c: 100)
	(up-clean-search search-local 44 2)
)

(defrule
	(not(taunt-detected me 72))
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-longbow-group-size < 1)
=>
	(up-remove-objects search-local -1 > 0)	
	(up-create-group 0 0 c: longbow1)
	(up-modify-group-flag 1 c: longbow1)
)








;get the average position of the group
(defrule
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-full-reset-search)
	(up-find-local c: longbowman-line c: 100)
	(up-remove-objects search-local object-data-group-flag != longbow1)
	(set-goal point1-x 0)
	(set-goal point1-y 0)
	(set-goal gl-temp1 0)
	(set-goal gl-loop-failsafe1 0)
)

(defrule	;;
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-get-object-data object-data-point-x point2-x)
	(up-get-object-data object-data-point-y point2-y)
	(up-modify-goal point1-x g:+ point2-x)
	(up-modify-goal point1-y g:+ point2-y)
	(up-modify-goal gl-temp1 c:+ 1) 	;number of points checked
)

(defrule
	(up-compare-goal gl-loop-failsafe1 < 50)
	(up-set-target-object search-local c: 1)
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-remove-objects search-local -1 == 0)
	(up-modify-goal gl-loop-failsafe1 c:+ 1)
	(up-jump-rule -2)
)

(defrule
	(up-compare-goal gl-temp1 > 0)
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-modify-goal point1-x g:/ gl-temp1)
	(up-modify-goal point1-y g:/ gl-temp1)
	(up-copy-point longbow-group-x point1-x)
;	;(up-send-flare longbow-group-x)
)









;add any units nearby to the group
(defrule
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-full-reset-search)
	(up-set-target-point longbow-group-x)
	(up-filter-distance c: -1 c: 3)
	(up-find-local c: longbowman-line c: 100)
	(up-remove-objects search-local object-data-group-flag == longbow1)
)

(defrule
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-create-group 0 0 c: longbow1)
	(up-modify-group-flag 1 c: longbow1)
)



;remove any units too far from the group
(defrule
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-full-reset-search)
	(up-set-target-point longbow-group-x)
	(up-filter-distance c: 5 c: -1)
	(up-find-local c: longbowman-line c: 100)
	(up-remove-objects search-local object-data-group-flag != longbow1)
)

(defrule
	(up-set-target-object search-local c: 0)
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-create-group 0 0 c: longbow1)
	(up-modify-group-flag 0 c: longbow1)
)






;move all ungrouped units to the group

(defrule
	(up-compare-goal gl-longbow-group-size >= 1)
=>
	(up-full-reset-search)
	(up-find-local c: longbowman-line c: 100)
	(up-remove-objects search-local object-data-group-flag == longbow1)
	(up-target-point longbow-group-x action-move -1 no-attack)
)








