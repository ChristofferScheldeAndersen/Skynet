(defrule	;split 1
	(goal gl-deer 0)
	(up-timer-status t-deer != timer-running)
	(up-point-distance temp-precise-deer-x temp-shooting-zone-precise-x < 250)
	(or	(dropsite-min-distance live-boar == -1)
		(dropsite-min-distance live-boar >= 10))
	(or	(not(up-set-target-by-id g: gl-next-sheep-id))		;next sheep not alive, invalid, or low
		(and(up-set-target-by-id g: gl-next-sheep-id)
			(or	(up-object-data object-data-carry g:< gltemp-food-threshold-to-kill-deer)
				(up-object-data object-data-hitpoints >= 1))))
	(or	(not(up-set-target-by-id g: gl-current-sheep-id))	;same for current sheep
		(and(up-set-target-by-id g: gl-current-sheep-id)
			(or	(up-object-data object-data-carry g:< gltemp-food-threshold-to-kill-deer)
				(up-object-data object-data-hitpoints >= 1))))
				
	(up-set-target-by-id g: gl-deer-id)
=>
	(up-full-reset-search)
	(up-find-local c: villager-class c: 20)
	(up-remove-objects search-local object-data-dropsite == mining-camp)
	(up-remove-objects search-local object-data-target == tree-class)
	(up-remove-objects search-local object-data-target == forage-class)
	(up-remove-objects search-local object-data-action == actionid-build)(up-remove-objects search-local object-data-action == actionid-attack)
)

(defrule	;split 2
	(goal gl-deer 0)
	(up-timer-status t-deer != timer-running)
	(up-point-distance temp-precise-deer-x temp-shooting-zone-precise-x < 250)
	(or	(dropsite-min-distance live-boar == -1)
		(dropsite-min-distance live-boar >= 10))
	(or	(not(up-set-target-by-id g: gl-next-sheep-id))		;next sheep not alive, invalid, or low
		(and(up-set-target-by-id g: gl-next-sheep-id)
			(or	(up-object-data object-data-carry g:< gltemp-food-threshold-to-kill-deer)
				(up-object-data object-data-hitpoints >= 1))))
	(or	(not(up-set-target-by-id g: gl-current-sheep-id))	;same for current sheep
		(and(up-set-target-by-id g: gl-current-sheep-id)
			(or	(up-object-data object-data-carry g:< gltemp-food-threshold-to-kill-deer)
				(up-object-data object-data-hitpoints >= 1))))

	(up-set-target-by-id g: gl-deer-id)			;needs to be at the end
=>
	(up-set-target-point temp-precise-deer-x)
	(up-clean-search search-local 44 search-order-asc)
	(up-remove-objects search-local -1 > 3)
	(up-target-objects 1 action-default -1 -1);debuggggg
;;(chat-to-all "kill deer 2")
	(enable-timer t-deer 5)
)


