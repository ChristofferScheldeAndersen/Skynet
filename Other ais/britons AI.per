;	(false)
;	(or	(goal 509 0)
;		(game-time < 10);)
=>
	(up-jump-rule 6)
)

(defrule
	(game-time >= 5)
=>
	(up-full-reset-search)
	(up-filter-status c: status-resource c: list-active)
	(set-goal gl-main-loop-indexer 54)
	(set-goal gl-loop-failsafe1 0)
	(set-goal gl-loop-failsafe2 0)

	(set-goal gl-temp2 0)
	(set-goal gl-temp3 0)
	
	(up-modify-goal gl-temp4 g:= gl-main-loop-indexer)
	(up-modify-goal gl-temp4 c:/ 40)	;number of times to reset40
	;hi;(up-chat-data-to-all "div: %d" g: gl-temp4)

	(up-modify-goal gl-temp5 g:= gl-main-loop-indexer)
	(up-modify-goal gl-temp5 c:mod 40)	;number of objects to remove individually
	;hi;(up-chat-data-to-all "mod: %d" g: gl-temp5)	
)

(defrule
	(true)
=>
	(up-find-resource c: gold-mine-class c: 40)	
	(up-get-search-state lt)
	;hi;(up-chat-data-to-all "rt: %d" g: rt)
)

(defrule	;;
	(up-compare-goal gl-temp2 g:< gl-temp4)
	(up-compare-goal gl-loop-failsafe1 < 20)
=>
	(up-modify-goal gl-loop-failsafe1 c:+ 1)
	(up-modify-goal gl-temp2 c:+ 1)
	(up-reset-search 0 0 0 1)
	(up-jump-rule -2)
)

(defrule	;;
	(true)
=>
	(up-remove-objects search-remote -1 g:< gl-temp5)
)

(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point2-x)
	;(up-send-flare point2-x)
)

(defrule	
	(true)
;	(false)
=>
	(set-goal 509 0)
;	;(up-chat-data-to-all "-----------: %d" g: gl-main-loop-indexer)
;	;(up-chat-data-to-all "indexer1: %d" g: gl-main-loop-indexer)
;	;(up-chat-data-to-all "indexer2: %d" g: gl-temp3)
)
;;;











	







(defconst temp-gl-remote-loop-master-index gl-temp5id)
(defconst temp-gl-current-pile-id gl-temp2id)
(defconst temp-gl-other-pile-best-score-copy gl-temp3id)
(defconst temp-gl-other-pile-drop-distance gl-temp4id)
(defconst temp-gl-best-other-pile-id gl-temp6id)
(defconst temp-gl-current-vill-id gl-temp7id)
(defconst temp-gl-distance-vill-to-other-pile gl-temp8id)
(defconst temp-gl-other-pile-score gl-temp9id)
(defconst temp-gl-other-pile-best-score gl-temp10id)
(defconst temp-gl-current-pile-score gl-temp11id)


#load-if-defined USELATER
;retarget gold miners to better gold piles
(defrule
	(true)
;	(or	(game-time < 10)
;		(or	(and(unit-type-count gold-miner1 < 1)
;				(unit-type-count gold-miner2 < 1))
;			(and(building-type-count-total tc < 1)
;				(building-type-count-total mc < 1))))
=>
	(up-jump-rule 17)
)

(defrule
	(true)
=>
	(set-goal gl-temp1 -1)
	(set-goal temp-gl-current-pile-id -1)
	(set-goal temp-gl-other-pile-best-score-copy 0)
	(set-goal temp-gl-other-pile-drop-distance -1)
	(set-goal temp-gl-remote-loop-master-index -1)
	(set-goal temp-gl-best-other-pile-id -1)
	(set-goal temp-gl-current-vill-id -1)
	(set-goal temp-gl-distance-vill-to-other-pile -1)
	(set-goal temp-gl-other-pile-score 10000)
	(set-goal temp-gl-other-pile-best-score 0)
	(set-goal temp-gl-current-pile-score -1)
	;set-goal gl-temp12
	(set-goal gl-temp13 -1)
	(set-goal gl-temp14 -1)
	(set-goal gl-temp15 -1)

	(set-goal gl-rule-id1 0)
	(set-goal gl-rule-id2 0)
	(set-goal gl-loop-failsafe1 0)
	(set-goal gl-loop-failsafe2 0)
	(set-goal gl-main-loop-indexer 0)

	(set-goal point1-x -1)
	(set-goal point2-x -1)
	(set-goal point3-x -1)
	(set-goal point4-x -1)
	(set-goal point5-x -1)
)

(defrule	;;;
	(true)
=>
	(up-get-rule-id gl-rule-id2)
	
	(set-goal temp-gl-current-pile-id -1)
	(set-goal temp-gl-current-vill-id -1)
;
	(up-full-reset-search)
	(up-find-local c: gold-miner1 c: 40)
	(up-find-local c: gold-miner2 c: 40)
)

(defrule
	(not(up-set-target-object search-local g: gl-main-loop-indexer))
=>
;	;(chat-to-all "jump1")
	(up-jump-rule 14)	;exit
)

(defrule
	(up-set-target-object search-local g: gl-main-loop-indexer)
=>
	(up-get-point position-object point2-x)
	(up-get-object-data object-data-id temp-gl-current-vill-id)
	(up-get-object-data object-data-target-id temp-gl-current-pile-id)
;	;(up-send-flare point2-x)
)

(defrule
	(or	(not(up-set-target-by-id g: temp-gl-current-pile-id))
		(not(up-set-target-by-id g: temp-gl-current-vill-id)))
=>
	(up-jump-rule 11)	;next vill
)

(defrule
	(up-set-target-by-id g: temp-gl-current-pile-id)
	(up-object-data object-data-class != gold-mine-class)
=>
	(up-jump-rule 10)	;next vill
)

;next, set up a loop through all gold piles and check if there is a better one

(defrule
	(true)
=>
	(set-goal gl-loop-failsafe1 0)
	(set-goal temp-gl-best-other-pile-id -1)
	(set-goal temp-gl-other-pile-best-score 0)
	(set-goal temp-gl-other-pile-best-score-copy 0)
	(set-goal temp-gl-current-pile-score -1)
	
	(set-goal temp-gl-remote-loop-master-index 0)	;DONT RESET INSIDE LOOP
)

(defrule	;;
	(true)
=>
	(up-get-rule-id gl-rule-id1)
	
	(set-goal temp-gl-distance-vill-to-other-pile -1)
	(set-goal temp-gl-other-pile-drop-distance -1)
	(set-goal temp-gl-other-pile-score 10000)
	(set-goal gl-loop-failsafe3 0)
)

;within this loop, set up a quick loop to get to the right index if it goes beyond 40
(defrule	;;
	(true)
=>
	(up-full-reset-search)
	(up-filter-status c: status-resource c: list-active)

	(set-goal gl-temp13 0)
	
	(up-modify-goal gl-temp14 g:= temp-gl-remote-loop-master-index)
	(up-modify-goal gl-temp14 c:/ 40)	;number of times to reset40

	(up-modify-goal gl-temp15 g:= temp-gl-remote-loop-master-index)
	(up-modify-goal gl-temp15 c:mod 40)	;the index you want
)

(defrule	;;
	(true)
=>
	(up-find-resource c: gold-mine-class c: 40)	
)

(defrule
	(up-compare-goal gl-loop-failsafe3 < 20)
	(up-compare-goal gl-temp13 g:< gl-temp14)
=>
	(up-modify-goal gl-loop-failsafe3 c:+ 1)
	(up-modify-goal gl-temp13 c:+ 1)
	(up-reset-search 0 0 0 1)
	(up-jump-rule -2)
)

(defrule
	(true)
=>
	(up-remove-objects search-remote -1 g:< gl-temp15)	;remove objects in the remote list before the one we want
)

(defrule
	(not(up-set-target-object search-remote c: 0))	;if after removing there isn't one, you've reached the end of the list.
=>
	(up-jump-rule 3)	;wrong!!!
)

(defrule	
	(true)
	(false)
=>
;	;(up-chat-data-to-all "-----------: %d" g: temp-gl-remote-loop-master-index)
	(do-nothing)
)
;;;

(defrule
	(up-set-target-object search-remote c: 0)
=>
	(up-get-point position-object point4-x)
	;(up-send-flare point4-x)
	(up-set-target-point point4-x)
	(up-get-point-distance point4-x point2-x temp-gl-distance-vill-to-other-pile)
	
	(up-find-local c: tc c: 10)
	(up-find-local c: mc c: 10)
	(up-clean-search search-local 44 1)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: tc c: 10)
	(up-find-status-local c: mc c: 10)
)

(defrule
	(up-set-target-object search-local c: 0)	;;
=>
	(up-get-point position-object point5-x)
	(up-get-point-distance point5-x point4-x temp-gl-other-pile-drop-distance)
)

(defrule	;score it
	(up-compare-goal temp-gl-other-pile-drop-distance > -1)
=>
	(up-modify-goal gl-temp1 g:= temp-gl-other-pile-drop-distance)
	(up-modify-goal gl-temp1 c:* 3)	;more weight to drop distance??
	(up-modify-goal temp-gl-other-pile-score g:- gl-temp1)
	(up-modify-goal gl-temp1 g:= temp-gl-distance-vill-to-other-pile)
	(up-modify-goal temp-gl-other-pile-score g:- gl-temp1)
)	

(defrule
	(up-set-target-object search-remote c: 0)	;
	(up-compare-goal temp-gl-other-pile-drop-distance > -1)
	(up-compare-goal temp-gl-other-pile-score g:> temp-gl-other-pile-best-score)
=>
	(up-modify-goal temp-gl-other-pile-best-score g:= temp-gl-other-pile-score)
	(up-modify-goal temp-gl-other-pile-best-score-copy g:= temp-gl-other-pile-best-score)
	(up-modify-goal temp-gl-other-pile-best-score-copy c:- 5)
;	;(up-chat-data-to-all "new best pile found (%d)" g: temp-gl-other-pile-best-score)
	(up-get-object-data object-data-id temp-gl-best-other-pile-id)
	(up-get-point position-object point1-x)
)

(defrule
	(up-set-target-object search-remote c: 0)	;
	(up-object-data object-data-id g:== temp-gl-current-pile-id)
=>
	(up-modify-goal temp-gl-current-pile-score g:= temp-gl-other-pile-score)
;	;(up-chat-data-to-all "current pile score is %d" g: temp-gl-current-pile-score)
;	;(up-send-flare point4-x)
)

(defrule
	(up-compare-goal gl-loop-failsafe1 < 200)
=>
	(up-modify-goal temp-gl-remote-loop-master-index c:+ 1)
	(up-modify-goal gl-loop-failsafe1 c:+ 1)
	(up-jump-direct g: gl-rule-id1)
)

;now, we've found the best--actually, remove overworked piles
;now, we should have the best tile--actually, need to save the id of the pile
;ok. now. basically, if the id of the current tile != best tile, switch. then you can exit.
;if it is the same, just go on to the next vill and reset everything.

(defrule	;debug
	(false)
=>
	;hi;(up-chat-data-to-all "temp-gl-other-pile-best-score-copy: %d" g: temp-gl-other-pile-best-score-copy)
	;hi;(up-chat-data-to-all "current: %d" g: temp-gl-current-pile-score)
	;hi;(up-chat-data-to-all "best: %d" g: temp-gl-other-pile-best-score)
	(do-nothing)
)

(defrule
	(up-compare-goal temp-gl-current-pile-score > 0)
	(up-set-target-by-id g: temp-gl-current-vill-id)
	(up-set-target-by-id g: temp-gl-best-other-pile-id)
	(up-compare-goal temp-gl-other-pile-best-score-copy g:> temp-gl-current-pile-score)		;switch if it's still better
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: temp-gl-current-vill-id)
	(up-target-objects 1 action-default -1 -1)
;	;(chat-to-all "switch to better gold pile")
	;hi;(chat-to-all "--------------")
	;hi;(up-chat-data-to-all "current: %d" g: temp-gl-current-pile-score)
	;hi;(up-chat-data-to-all "best: %d" g: temp-gl-other-pile-best-score)
	;(up-send-flare point1-x)
	(up-jump-rule 1)	;exit
)

(defrule
	(false)
	(up-compare-goal gl-loop-failsafe2 < 20)
=>
	(up-modify-goal gl-main-loop-indexer c:+ 1)
	(up-modify-goal gl-loop-failsafe2 c:+ 1)
	(up-jump-direct g: gl-rule-id2)
)
;;;;;;
#end-if









(defrule
    (true)
=>
    (up-get-precise-time gl-start-time1 gl-elapsed-checkpoint3)
)











;attack siege with mangonels
(defrule
	(unit-type-count mangonel-line < 1)
=>
	(up-jump-rule 7)
)

(defrule
	(true)
=>
	(up-full-reset-search)
	(up-find-local c: mangonel-line c: 20)
	(up-modify-sn sn-focus-player-number s:= sn-target-player-number)
	(set-goal gl-temp1 -1)
	(set-goal gl-temp2 -1)
	(set-goal gl-temp3 -1)
	(set-goal gl-temp4 0)
	(set-goal gl-temp5 0)
)

(defrule	;;
	(not(up-set-target-object search-local c: 0))
=>		
	(up-jump-rule 5)	;exit, used after removing current mangos
)

(defrule
	(up-set-target-object search-local c: 0)
=>
	(up-get-object-data object-data-id gl-temp2)
	(up-get-object-data object-data-target-id gl-temp3)
	(up-get-point position-object point1-x)
	(up-set-target-point point1-x)
	(up-filter-distance c: -1 c: 15)
	(up-find-remote c: armored-elephant-line c: 10)
	(up-find-remote c: mangonel-line c: 10)
	(up-find-remote c: battering-ram-line c: 10)
	(up-find-remote c: packed-trebuchet-class c: 20)
	(up-find-remote c: unpacked-trebuchet-class c: 20)
	(up-find-remote c: scorpion-line c: 10)
	(up-clean-search search-remote 44 1)
)

(defrule
	(up-compare-goal gl-temp4 < 20)
	(not(up-set-target-object search-remote c: 0))	;no units nearby
=>		
	(up-reset-search 0 0 1 1)	;reset remote search
	(up-remove-objects search-local -1 == 0)	;remove current mangonel
	(up-modify-goal gl-temp4 c:+ 1)
	(up-jump-rule -3)	;check next
)

(defrule
	(up-set-target-object search-remote c: 0)
=>		
	(up-get-object-data object-data-id gl-temp1)
)

(defrule
	(up-compare-goal gl-temp5 < 20)
	(up-compare-goal gl-temp3 g:== gl-temp1)	;already targetting closest
=>		
	(up-reset-search 0 0 1 1)	;reset remote search
	(up-remove-objects search-local -1 == 0)	;remove current mangonel
	(up-modify-goal gl-temp5 c:+ 1)
	(up-jump-rule -5)	;check next
)

(defrule
	(up-compare-goal gl-temp3 g:!= gl-temp1)	;not targetting closest
	(up-set-target-object search-remote c: 0)
=>		
	(up-get-point position-object point1-x)
	;(up-send-flare point1-x)
	(up-remove-objects search-local -1 > 0)
	(up-target-objects 1 action-default -1 no-attack)
	;hi;(chat-to-all "attack siege with mangonel")
)

