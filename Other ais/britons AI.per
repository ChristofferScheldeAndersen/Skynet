;qbuilders
;walling
;get new builder if current builder is idle and too far from the next wall point (clockwise)
(defrule
	(up-set-target-by-id g: gl-clockwise-builder-id)
=>
	(up-get-point position-object point1-x)
)

(defrule
	(goal gl-clockwise-builder-idle 1)
	(up-set-target-by-id g: gl-clockwise-builder-id)
	(up-compare-goal gl-walling-stage >= pastfirstvertex)
	(or	(goal gl-walling-stage 100)
		(up-point-distance point1-x clockwise-walling-x >= 10))
=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-clockwise-builder-id)
	(up-target-point home-x action-stop -1 -1)
	(set-goal gl-clockwise-builder-idle -1)
	(set-goal gl-clockwise-builder-id -1)
	;;(chat-to-all "remove clockwise builder")
)

;detect idle builder (clockwise)
(defrule
	(goal gl-clockwise-builder-idle 1)
	(up-set-target-by-id g: gl-clockwise-builder-id)
	(up-object-data object-data-action == actionid-build)
=>
	(set-goal gl-clockwise-builder-idle -1)
	;;(chat-to-all "not idle")
)

(defrule
	(up-set-target-by-id g: gl-clockwise-builder-id)
;	(up-object-data object-data-action != actionid-build)
=>
	(up-full-reset-search)
	(up-filter-status c: status-pending c: list-active)
	(up-find-status-local c: palisade-wall c: 40)
	(up-find-status-local c: house c: 40)
	(up-remove-objects search-local object-data-group-flag != clockwisewallbuildinggroup)
	(up-find-status-local c: barracks c: 40)
	(up-find-status-local c: stable c: 40)
)

(defrule
	(not(up-set-target-object search-local c: 0))
	(up-set-target-by-id g: gl-clockwise-builder-id)
	(up-object-data object-data-action != actionid-build)
=>
	(set-goal gl-consecutive-palisades-built 0)
	(set-goal gl-clockwise-builder-idle 1)
	;;(chat-to-all "idle")
)

(defrule
;	(goal gl-fifth-turn 1)
	(goal gl-clockwise-builder-idle 1)
	(up-set-target-by-id g: gl-clockwise-builder-id)
=>
	(up-get-point position-object point1-x)
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-clockwise-builder-id)
	(up-target-point clockwise-walling-x action-move -1 -1)
	;hi;(chat-to-all "move clockwise builder")
	;(up-send-flare point1-x)
)

;get new builder if current builder is idle and too far from the next wall point (counterclockwise)
(defrule
	(up-set-target-by-id g: gl-counterclockwise-builder-id)
=>
	(up-get-point position-object point1-x)
)

(defrule
;	(goal gl-counterclockwise-builder-idle 1)
	(up-set-target-by-id g: gl-counterclockwise-builder-id)
;	(up-compare-goal gl-walling-stage >= pastfirstvertex)
	(building-type-count stable >= 1)
	
