)

(defrule
	(goal gl-sheep-scout-index 1)
	(up-compare-goal gl-temp5 < 1)
    (up-compare-flag gl-scouting-flag == SKIP-FLAG-1)
=>
    (up-modify-flag gl-scouting-flag c:- SKIP-FLAG-1)
;	;;(chat-to-all "remove treeskip 1")
)

;--------TWO
(defrule
	(goal gl-sheep-scout-index 2)
	(up-compare-goal gl-temp5 >= 4)
    (up-compare-flag gl-scouting-flag != SKIP-FLAG-2)
=>
	(up-add-object-by-id search-local g: gl-current-sheep-scout-id)
	(up-lerp-tiles point2-x point1-x c: -30)
	(up-bound-point point2-x point2-x)
	(up-target-point point2-x action-move -1 -1)
    (up-modify-flag gl-scouting-flag c:+ SKIP-FLAG-2)
;	;;(up-chat-data-to-all "treeskip move 2(%d)" g: gl-temp2)
;	;(up-send-flare point2-x)
)

