=>
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-counterclockwise-builder-id)
	(up-target-point home-x action-stop -1 -1)
	(set-goal gl-counterclockwise-builder-idle -1)
	(set-goal gl-counterclockwise-builder-id -1)
	;;(chat-to-all "remove counterclockwise builder")
)

