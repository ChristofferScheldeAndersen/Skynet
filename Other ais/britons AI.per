;general
;qbuilders2

(defrule	;count vills targetting stragglers
	(true)
=>
	(up-full-reset-search)
	(up-set-target-point home-x)
	(up-filter-distance c: -1 c: 15)
	(up-find-local c: villager-class c: 40)
