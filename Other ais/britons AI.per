(defrule
    (true)
=>
    (up-get-precise-time gl-start-time1 gl-elapsed-investigator10)
)

;move boar target away from boar if not far enough yet
(defrule
	(up-set-target-by-id g: gl-current-boar-target-id)
	(up-point-distance temp-boar-target-x temp-boar-destination-x >= 3)
	(or	(and(up-object-data object-data-action != actionid-move)	;
			(up-object-data object-data-action != actionid-hunt))	;
		(up-object-data object-data-move-x g:!= temp-boar-destination-x))
=>
	(up-get-point position-object point4-x)
;	;(up-send-flare point4-x)
	
	(up-get-object-data object-data-move-x point4-x)
	(up-get-object-data object-data-move-y point4-y)
	;(up-send-flare point4-x)
	
;	(up-get-object-data object-data-move-x gl-temp1);(up-chat-data-to-all "movex: %d" g: gl-temp1);(up-chat-data-to-all "dest: %d" g: temp-boar-destination-x)
;	(up-get-object-data object-data-action gl-temp1);(up-chat-data-to-all "retreat boar target: %d" g: gl-temp1)
;	(up-get-object-data object-data-hitpoints gl-temp1);(up-chat-data-to-all "hp: %d" g: gl-temp1)
;	(up-get-object-data object-data-target gl-temp1);(up-chat-data-to-all "target: %d" g: gl-temp1)
;	(up-get-object-target-data object-data-target-id gl-temp1);(up-chat-data-to-all "target id: %d" g: gl-temp1)

	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-current-boar-target-id)
	(up-target-point temp-boar-destination-x action-move -1 -1)
;	;(up-send-flare temp-boar-destination-x)
;	;(chat-to-all "retreat boar target")
)


;garrison boar target if low
(defrule
	(up-object-data object-data-hitpoints < 15)
	(up-set-target-by-id g: gl-current-boar-target-id)
=>
	(up-full-reset-search)
	(up-find-local c: town-center c: 10)
	(up-set-target-point temp-boar-x)
	(up-clean-search search-local 44 1)	
)

(defrule
	(up-object-data object-data-hitpoints < 10)
	(up-set-target-by-id g: gl-current-boar-target-id)
	(up-set-target-object search-local c: 0)	;
=>
	(up-add-object-by-id search-local g: gl-current-boar-target-id)
	(up-target-objects 1 action-garrison -1 -1)
	;hi2;(chat-to-all "garrison boar target")
)



;retreat lurer to tc (maybe redundant?)
(defrule
	(up-set-target-by-id g: gl-current-boar-id)
	(up-set-target-by-id g: gl-lurer-id)	;
=>
	(up-get-point position-object point1-x)
)

(defrule
	(false)
	(up-point-distance point1-x home-x >= 2)	;not under tc yet
	(up-set-target-by-id g: gl-lurer-id)
	(up-object-data object-data-action != actionid-move)
	(up-set-target-by-id g: gl-current-boar-id)		;
	(up-object-data object-data-target-id g:== gl-lurer-id)
=>
	;(chat-to-all "boar targetting lurer")
	(up-full-reset-search)
	(up-add-object-by-id search-local g: gl-lurer-id)
	(up-target-point temp-boar-destination-x action-move -1 -1)
)
;;;











;kill boar
(defrule
	(goal gl-boar 0)
	(up-set-target-by-id g: gl-current-boar-id)
=>
	(up-full-reset-search)
	(up-set-target-point temp-boar-destination-x)
	(up-filter-distance c: -1 c: 4)
	(set-strategic-number sn-focus-player-number 0)
)

(defrule
	(up-find-remote c: boar-class c: 1)
	(goal gl-boar 0)
	(up-set-target-by-id g: gl-current-boar-id)
=>
	(up-set-target-point home-x)
	(up-filter-distance c: -1 c: 10)
	(up-find-local c: villager-class c: 40)
	(up-remove-objects search-local object-data-dropsite == mining-camp)
	(up-remove-objects search-local object-data-target == tree-class)
	(up-remove-objects search-local object-data-group-flag == miscwoodgroup)
	(up-remove-objects search-local object-data-group-flag == berrygroup)
	(up-remove-objects search-local object-data-target == forage-class)
	(up-remove-objects search-local object-data-id g:== gl-current-boar-target-id)
	(up-remove-objects search-local object-data-action == actionid-build)(up-remove-objects search-local object-data-action == actionid-attack)
	(up-target-objects 1 action-default -1 -1)
	;hi2;(chat-to-all "kill boar")
	(set-goal gl-lurer-id -1)
	(set-goal gl-boar 1)
	(enable-timer t-boar 50)
	(up-modify-goal gl-killed-boar-count c:max 0)
	(up-modify-goal gl-killed-boar-count c:+ 1)
)

(defrule
	(goal gl-boar 1)
	(timer-triggered t-boar)
=>
	(disable-timer t-boar)
	(set-goal boar-original-x -1)
	(set-goal gl-boar -1)
	(set-goal gl-current-boar-id -1)
	(set-goal gl-current-boar-target-id -1)
)






(defrule
    (true)
=>
    (up-get-precise-time gl-start-time1 gl-elapsed-investigator4)
)






