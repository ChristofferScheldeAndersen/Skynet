(defrule
	(goal gl-temp1 2389234)
	(up-set-target-by-id g: gl-longbow-group-target1-id)
=>
	(up-get-point position-object point1-x)

	(up-full-reset-search)
	(up-find-local c: longbowman-line c: 100)
	(up-remove-objects search-local object-data-group-flag != longbow1)

	(up-set-target-point point1-x)
	(up-clean-search search-local 44 1)
	(up-remove-objects search-local -1 g:>= gl-longbows-number-of-shots-to-kill-target1)
	(up-target-objects 1 action-default -1 no-attack)
	(up-modify-goal gl-temp2 g:= gl-longbow-group-size)
	(up-modify-goal gl-temp2 g:- gl-longbows-number-of-shots-to-kill-target1)	;check if there are any left after this
)

(defrule		;fire at second target and only remove enough to kill first unit
	(goal gl-temp1 2389234)
	(up-compare-goal gl-temp2 >= 1)		;more than enough
	(up-set-target-by-id g: gl-longbow-group-target1-id)
	(up-set-target-by-id g: gl-longbow-group-target2-id)
=>
	(up-get-point position-object point2-x)
	(up-full-reset-search)
	(up-find-local c: longbowman-line c: 100)
	(up-remove-objects search-local object-data-group-flag != longbow1)
	(up-set-target-point point1-x)
	(up-clean-search search-local 44 1)
	(up-remove-objects search-local -1 g:< gl-longbows-number-of-shots-to-kill-target1)		;remove only the few closest to first target
	(up-set-target-point point2-x)
	(up-clean-search search-local 44 1)
	(up-remove-objects search-local -1 g:>= gl-longbows-number-of-shots-to-kill-target2)		;keep only ones to shoot second target now.	
	(up-target-objects 1 action-default -1 no-attack)
	(up-modify-goal gl-temp2 g:= gl-longbow-group-size)
	(up-modify-goal gl-temp2 g:- gl-longbows-number-of-shots-to-kill-target1)
	(up-modify-goal gl-temp2 g:- gl-longbows-number-of-shots-to-kill-target2)
)

