            (defconst gl-total-script-time__#051 1608)
            (defconst gl-script-time-avg-for-tick-group__#051 1609)
            (defconst gl-final-avg-script-time__#051 1610)
            (defconst gl-time-between-ticks-for-tick-group__#051 1611)
            (defconst gl-total-time-between-ticks__#051 1612)
            (defconst gl-time-between-ticks-avg-for-group__#051 1613)
            (defconst gl-final-avg-time-between-ticks__#051 1614)
            (defconst gl-time-since-last-full-script-read__#051 1615)
            (defconst gl-lowest-avg-tick-interval__#051 1616)
            (defconst gl-highest-avg-tick-interval__#051 1617)
            (defconst gl-lowest-avg-script-time__#051 1618)
            (defconst gl-highest-avg-script-time__#051 1619)
            (defconst gl-end-of-script-rule-for-real__#051 1620)

            (defconst gl-lowest-avg-script-time-stamp__#051 1621)
            (defconst gl-highest-avg-script-time-stamp__#051 1622)
            (defconst gl-lowest-avg-tick-interval-stamp__#051 1623)
            (defconst gl-highest-avg-tick-interval-stamp__#051 1624)
