            (defconst gl-last-wolf-id__#052 1709)

        ;
    ; Timers 
        ; #031 Lag detection
        (defconst lag-timer 1) ; Only reliable way to meassure time between ticks.

    ; Group flags

        ; Villager res groups
        (defconst food-group 1)
        (defconst wood-group 2)
        (defconst stone-group 3)
        (defconst gold-group 4)

        (defconst forward-villager-group 17)
        ;Animals
        (defconst scouted-animal-group 10)

    ; Search groups
        ; Global temp group names
        (defconst temp-group1 0)
        (defconst temp-group2 19)
        
        ; DUC eco #000- #010
        (defconst ungrouped-vills-group 0)
        (defconst to-dropsite-group 0)
        (defconst vill-candidate-group__#000 0) ; Note that ungrouped-vills and villacandidate-group are used in seperate code and thus won't conflict.
        (defconst dropsite-candidate-group__#000 19)
        (defconst target-candidate-group__#000 19) ; Note that dropsite and target group are used in seperate code and thus won't conflict.
        (defconst food-group 1)
        (defconst wood-group 2)
        (defconst stone-group 3)
        (defconst gold-group 4)
